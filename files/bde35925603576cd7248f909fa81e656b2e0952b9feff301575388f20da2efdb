        };
      }
    },
    {
      id: 'recoilads', fam: 'aim', ico: 'wave', n: 'Anti-recoil, aiming only',
      d: 'The same downward pull, but only when you are actually aiming down ' +
         'sights — so hip-fire and menus are left completely alone.',
      trig: { follow: 'rt+' },
