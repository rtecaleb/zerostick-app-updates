    { id: 'turbo', tune: 0, lab: 'Speed', unit: 'ms', quick: true, help: true,
      say: 'Hold fire and it taps for you. Lower is faster — too fast and some games drop shots.' },
    /* D280 (owner, 2026-10-10: "while holding X, whatever way you swipe your
       mouse, it stays going that speed"). Added on the tap like the two
