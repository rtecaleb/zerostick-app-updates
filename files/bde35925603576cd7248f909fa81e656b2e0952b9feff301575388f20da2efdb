      id: 'reloadmove', fam: 'access', ico: 'cycle', n: 'Reload and back off',
      d: 'One press reloads AND walks you backwards out of the open while it ' +
         'happens. The part that is easy to forget when your hands are already busy.',
      trig: { follow: 'west' },
      btns: [{ lab: 'Reload button', def: 'west' }],
      tunes: [
        { lab: 'How far you back off', val: 75, min: 20, max: 100, step: 5, unit: '%' },
        { lab: 'For how long', val: 900, min: 200, max: 3000, step: 50, unit: 'ms' }
      ],
      build: function (v, b) {
        return {
          name: 'Reload and back off', holdMode: 'once', cooldownMs: 400,
          maxDurationMs: clamp(v[1] + 900, DUR_MIN, DUR_MAX), maxRepeats: 1,
          steps: [{ k: 'tap', t: [b[0]], ms: 70 },
            { k: 'stick', stick: 'left', angle: 270, dist: v[0] / 100, ms: 0 },
