  /* Build one preset into a full action. The single place a template's shorthand
     becomes the editor's model, so the gallery and the tests cannot drift: the
     Node exporter and board/agent/tests/unit/test_preset_actions.py both come
     through here. */
  function buildTemplate(p, t, cfg) {
    var base = t.build(cfg.v.slice(), cfg.btns.slice(), { ads: adsGateOK(p) });
    /* a preset may override the trigger when it adapts to the rig */
    var trig = base.trigger
      ? { src: base.trigger.src || null, follow: base.trigger.follow || null,
          gesture: 'press', holdMs: 350, windowMs: 300 }
      : cfg.trig;
    var a = normAction({
      name: base.name, holdMode: base.holdMode, cooldownMs: base.cooldownMs,
      maxDurationMs: base.maxDurationMs, maxRepeats: base.maxRepeats,
      varianceMs: base.varianceMs, gate: base.gate, notes: base.notes,
      uninterruptible: base.uninterruptible,
      steps: base.steps, trigger: trig, category: 'Ready-made',
      /* stamped so the gallery can tell you it is already here. buildTemplate
         copies a CONSTANT name per template — turbo is always "Rapid fire" —
         which is what made two identical chips possible in the first place;
         the id is the thing that is actually stable and comparable. */
      fromTemplate: t.id,
      group: (FAM_BY_KEY[t.fam] || {}).n || ''
    });
    a.colour = (FAM_BY_KEY[t.fam] || {}).col || COLOURS[0];
    return a;
  }

  /* ── WHICH TEMPLATE AN ACTION CAME FROM, INCLUDING ONE OFF THE BOARD ──
     `fromTemplate` is stamped by buildTemplate and by nothing else, so an
     action that arrived through fromBoardAction — a fresh phone, cleared
     storage, a second device, anything the PC dashboard wrote — carried no
     stamp at all. The gallery then drew all 31 cards identically and the
     "already on R2" mark, which IS the second half of the duplicate fix,
     was blind in exactly the situation where a duplicate is easiest to
     make: you cannot see what is already there.

     Two channels, tried in order.
       1. THE FIELD. toBoard now writes it. schema.py's action validator
          type-checks only the keys it names and passes everything else
          through untouched (the same unknown-key forgiveness `follows` and
          `tapMs` ride on), so it round-trips and the engine never sees it.
       2. THE NAME, for everything written before that. buildTemplate copies
          ONE CONSTANT name per template — turbo is always "Rapid fire" —
          and the add path only ever appends " 2", so the base name plus
          category "Ready-made" is a real fingerprint of where a copy came
          from. It is a fallback, not a claim: rename an action and it stops
          matching, which is correct, because you have made it yours. */
  var TPL_BY_NAME = null;
  function tplByName() {
    if (TPL_BY_NAME) return TPL_BY_NAME;
    TPL_BY_NAME = {};
    TEMPLATES.forEach(function (t) {
      try {
        var cfg = templateCfg(t);
        var b = t.build(cfg.v.slice(), cfg.btns.slice(), { ads: null });
        if (b && typeof b.name === 'string' && b.name) TPL_BY_NAME[b.name] = t.id;
      } catch (e) {
        /* a template that will not build at its own defaults simply has no
           legacy fingerprint; channel 1 still finds every copy of it */
      }
    });
    return TPL_BY_NAME;
  }
  function tplIdOf(a) {
    if (!a) return '';
    if (a.fromTemplate) return a.fromTemplate;
    if (a.category !== 'Ready-made') return '';
    return tplByName()[String(a.name || '').replace(/\s+\d+$/, '')] || '';
  }

  /* how many copies of this template are already on this config */
  function templateCount(S, id) {
    var n = 0;
    arr(S && S.actions).forEach(function (o) { if (o && tplIdOf(o) === id) n++; });
    return n;
  }
  /* the button the first copy sits on, for the card's "already on R2" tag */
  function templateWhere(S, p, id) {
    var out = '';
    arr(S && S.actions).forEach(function (o) {
      if (out || !o || tplIdOf(o) !== id) return;
      out = triggerName(p, o);
    });
    return out;
  }

  function templateCfg(t) {
    return {
      v: (t.tunes || []).map(function (u) { return u.val; }),
      trig: { src: t.trig.src || null, follow: t.trig.follow || null,
              gesture: 'press', holdMs: 350, windowMs: 300 },
      btns: (t.btns || []).map(function (b) { return b.def; })
    };
  }

  /* one template card — shared by the Ready-made grid and by "Build your
     own"'s foot, so the two can never drift into two different cards */
  function tplCardHTML(t, ti, p, S, folded, isHero) {
    var f = FAM_BY_KEY[t.fam] || { col: 'var(--line)' };
    /* THE SECOND HALF OF THE DUPLICATE FIX. Nothing used to mark a
       template already on this config, so all 31 cards drew identically
       whether or not you added one thirty seconds ago. It does NOT block
       a second add — one button legitimately holds several sequences —
       it just stops one being accidental. */
    var where = S ? templateWhere(S, p, t.id) : '';
    return '<div class="card satpl' + (folded ? ' safold' : '') + '" data-tpl="' + ti +
      '" role="button" tabindex="0" style="cursor:pointer;border-left:3px solid ' +
      esc(f.col) + '">' +
      '<div class="ci">' + ico(t.ico, 24) + '</div>' +
      '<div class="cn">' + esc(fillNames(t.n, p)) +
      (where ? '<span class="satpon">already on ' + esc(where) + '</span>' : '') +
      /* THE CARD THE HERO IS ABOUT SAYS SO. The "Start here" panel promotes
         one template and the full library below still lists it, so the same
         name with the same paragraph appeared twice on one tab and read as
         two suggestions. Every one of the 31 stays drawn — the library is
         the library — but this one is marked as the one already offered at
         the top rather than pretending to be a second idea. */
      (isHero ? '<span class="satpon satphero">the one suggested above</span>' : '') +
      '</div>' +
      /* D255 (owner, 2026-10-09: "why the year-long explanation - just put
         the little question mark tooltip"): the card is its name; the full
         description is behind the "?" (D236), and the add sheet's too */
      (ZS.helpHTML ? '<div class="cdq">' + ZS.helpHTML('tpl-' + t.id, fillNames(t.n, p), esc(fillNames(t.d, p))) + '</div>'
                   : '<div class="cd">' + esc(tplLead(t, p)) + '</div>') + '</div>';
  }

  /* ── A BROWSE GRID GETS THE FIRST SENTENCE, NOT THE PARAGRAPH ──────────
     Owner, 2026-08-28: the app is "a clutterd confusing mess", and Ready-made
     was its longest surface — 2831px in a 677px viewport, four and a bit
     screenfuls, because all 31 cards carry their full two-to-four sentence
     description at browse rank, two columns wide, six to eight lines each.

     NOTHING IS LOST, and that is what makes this a trim rather than a cut:
     tapping a card opens the add sheet, which renders the SAME t.d in full
     as its first note (see the `#tp-wrap` builder). So the full text is one
     tap away on the screen where you are actually deciding — the visible
     full-detail path the truncation rule asks for — and the grid goes back
     to doing what a grid is for.

     THE FIRST SENTENCE IS THE RIGHT CUT because these descriptions are all
     written the same way: what it does, then why it matters. "Tap {east}
     once and you stay down, hands off, until the time is up." then "Nothing
     to hold, nothing to keep pressed while you are also aiming." The first
     half is the card; the second half is the argument. Deriving it rather
     than hand-writing 31 summaries means a template added later gets this
     for free instead of quietly regrowing the wall.

     Two guards. A sentence shorter than 30 characters takes the next one too
     (a lead like "One press and it stays down." is a fragment, not a
     summary), and a description with no sentence break is returned whole. */
  function tplLead(t, p) {
    var d = fillNames(t.d, p);
    var out = '', rest = d;
    /* split only on a full stop that is followed by a space and a capital or
       an opening quote — never on a decimal, an abbreviation or a "{name}" */
    for (var pass = 0; pass < 2; pass++) {
      var m = /^(.*?[.!?])\s+(?=[A-Z“"‘'])/.exec(rest);
      if (!m) { out += (out ? ' ' : '') + rest; rest = ''; break; }
      out += (out ? ' ' : '') + m[1];
      rest = rest.slice(m[0].length);
      if (out.length >= 30) break;
    }
    return out || d;
  }

  /* THE RECOMMENDATION IS THE LIBRARY'S OWN ORDER, NOT A NEW OPINION.
     TEMPLATES is hand-ordered — Movement & access leads because those are
     the ones that take physical effort out of playing rather than adding an
     edge (the sentence that used to say so on the screen died in the §5.5
     copy triage; the ORDER is the statement now, so this comment is where
     the reasoning lives). "Start here" is simply the first entry this config
     does not already have. Returns an index into TEMPLATES, or -1 once every
     one of them is on the config — in which case the screen says that
     instead of pretending there is more to add. */
  function heroTplIndex(S, p) {
    for (var i = 0; i < TEMPLATES.length; i++) {
      if (!templateWhere(S, p, TEMPLATES[i].id)) return i;
    }
    return -1;
  }

  /* How many cards of one family are drawn before the run is folded. Both
     numbers are whole rows of the two-up grid, so a cut run never reads as a
     card that failed to load. FOUR for the family the library leads with —
     Movement & access leads deliberately (see heroTplIndex's comment),
     so it gets two rows — and TWO for the rest, which is a taste plus a key
     that opens the whole thing. 31 → 10 drawn, and the screen goes from
     5409px (7.5 screenfuls) to about 2600 (3.5). */
  var FAM_PEEK = 4;
  var FAM_PEEK_REST = 2;

  function templatesHTML(S, p) {
    var fam = S.tplFam || 'all';
    var counts = { all: TEMPLATES.length };
    TEMPLATES.forEach(function (t) { counts[t.fam] = (counts[t.fam] || 0) + 1; });

    var chips = '<div class="safil" id="sa-fil" role="tablist" aria-label="filter by family">' +
      [{ k: 'all', n: 'All' }].concat(FAMILIES).map(function (f) {
        var on = fam === f.k;
        return '<button data-fam="' + esc(f.k) + '" role="tab" aria-selected="' +
          (on ? 'true' : 'false') + '"' + (on ? ' class="on"' : '') + '>' +
          esc(f.n) + ' <b>' + (counts[f.k] || 0) + '</b></button>';
      }).join('') + '</div>';

    /* ── FEATURED, above everything (replaces the "Start here" hero) ──── */
    var hi = -1;
    var hero = '<div class="safam safeat" style="--famc:var(--accent)">' +
      '<span class="safi">' + ico('star', 20) + '</span><b>Featured</b>' +
      '<i>The ones most people want, added in one tap.</i></div>' +
      '<div class="cards">' + FEATURED.map(function (f, fi) {
        var ti = tplIndexById(f.id), t = TEMPLATES[ti];
        if (!t) return '';
        var where = templateWhere(S, p, t.id);
        return '<div class="card satpl safeatc" data-feat="' + fi + '" role="button" tabindex="0" ' +
          'style="cursor:pointer;border-left:3px solid var(--accent)">' +
          '<div class="ci">' + ico(t.ico, 24) + '</div>' +
          '<div class="cn">' + esc(f.id === 'turbo' ? 'Rapid fire' : fillNames(t.n, p)) +
          (where ? '<span class="satpon">already on ' + esc(where) + '</span>' : '') + '</div>' +
          '<div class="cd">' + esc(f.cd || (f.lab + ' — one slider')) + '</div>' +
          /* D280: the template's description behind a "?" (D236) */
          /* D280/D285: the template's description behind a "?" (D236) */
          ((f.help && ZS.helpHTML) ? '<div class="cdq">' + ZS.helpHTML('feat-' + t.id, fillNames(t.n, p),
            esc(fillNames(t.d, p))) + '</div>' : '') + '</div>';
      }).join('') + '</div>';

    var body = '';
    FAMILIES.forEach(function (f, fi) {
      if (fam !== 'all' && fam !== f.k) return;
      var mine = [];
      TEMPLATES.forEach(function (t, i) { if (t.fam === f.k) mine.push([t, i]); });
      if (!mine.length) return;
      /* THE RUN IS CUT WHILE "ALL" IS SHOWING. Thirty-one cards is 5409px —
         7.5 screenfuls — and a card at 4800px is a card nobody has ever
         seen. Filtered to one family, the whole family is shown, because
         then that IS the screen you asked for. */
      var peek = (fi === 0) ? FAM_PEEK : FAM_PEEK_REST;
      var cut = (fam === 'all' && mine.length > peek);
      body += '<div class="safam" style="--famc:' + esc(f.col) + '">' +
        '<span class="safi">' + ico(f.ico, 20) + '</span>' +
        '<b>' + esc(f.n) + '</b><i>' + esc(f.d) + '</i></div>' +
        '<div class="cards">' + mine.map(function (pair, n) {
          /* EVERY ONE OF THE 31 IS STILL BUILT — the run past the peek is
             folded, not dropped, so the gallery is still the whole library
             (test-smart-actions.js counts .satpl and expects 31) and one tap
             on the family key unfolds it. */
          return tplCardHTML(pair[0], pair[1], p, S, cut && n >= peek, pair[1] === hi);
        }).join('') + '</div>' +
        (cut ? '<button class="samore" data-fam="' + esc(f.k) + '">Show all <b>' +
               mine.length + '</b> in ' + esc(f.n) + ' ›</button>' : '');
    });

    /* the curation note that told the user Movement & access was placed
       first deliberately DIED here (screen-map §5.5): the family order in
       the chips and the gallery IS the priority statement, and a sentence
       announcing an order the eye can already see is documentation, not
       feedback. (The §5.5 gate greps this file for the dead sentence, so it
       is paraphrased here rather than quoted.) */
    /* "Ready-made starting points." is the name of the tab you are standing
       on, printed again underneath itself. What is left is the only part a
       first-time reader does not already have: what tapping one costs them. */
    return '<p class="lead">Tap one, choose which button starts it — you can ' +
      'change anything about it afterwards.</p>' +
      hero +
      chips + body +
      btn('Nothing fits? Record your own', null, 'sa-create-go2');
  }

  function tplIndexById(id) {
    for (var i = 0; i < TEMPLATES.length; i++) if (TEMPLATES[i].id === id) return i;
    return -1;
  }

  /* A featured card's sheet: what it does in one line, ONE slider, Add.
     Nothing technical — the steps, the trigger and the other tunes are the
     template's own defaults, and the editor is still there afterwards for
     anyone who wants it (the button's Mappings row). */
  /* AUDIT m22: a Featured add is one tap (D256), so a tremor double-tap or
     a second visit made a second rapid fire on the same trigger, and the
     "copies + 1" name could repeat one already there. The same clash rule
     the editor uses (dupWhen) shows the one already on the button instead,
     and a new copy takes the first unused number. */
  function freeName(S, base) {
    var used = {};
    arr(S.actions).forEach(function (o) { if (o && o.name) used[o.name] = true; });
    if (!used[base]) return base;
    for (var n = 2; ; n++) if (!used[base + ' ' + n]) return base + ' ' + n;
  }
  function showClash(root, p, S, clash) {
    S.screen = 'index';
    S.flashAct = S.actions.indexOf(clash);
    draw(root || VIEW.lastRoot, p);
    ZS.toast('"' + (clash.name || 'A Script') + '" already does this on that button - here it is');
  }
  /* D280 (2026-10-13 audit): Featured's Turn assist only ever checked the
     clash rule, so on a config that already had one (every mouse config
     does: it comes with it, waiting on no key where X reloads) a tap added
     a SECOND copy on X, switched on, over the player's own reload. Now:
       ? the config has one: that one opens, on its key picker;
       ? X does something here (a binding, a chord, another Script:
         keyTaken, the seed's own rule): it is added on no key, switched
         off, and opens on its key picker;
       ? otherwise it is added on X as before (the caller's path).
     Returns true when it handled the tap. */
  function featuredTurnAssist(root, p, S, made) {
    var have = -1, src, doc;
    arr(S.actions).forEach(function (o, k) { if (have < 0 && o && tplIdOf(o) === 'turnassist') have = k; });
    if (have >= 0) {
      ZS.toast('"' + (S.actions[have].name || 'Turn assist') +
        '" is already in this config - pick the key that starts it');
      SEC.openOnKeyPicker(root, p, S, have);
      return true;
    }
    src = emitSource(p, made.trigger) || '';
    doc = { bindings: SEC.bindsOf(p), accessibilityActions: arr(S.actions).map(function (o) {
      return { trigger: { source: emitSource(p, o.trigger) || '', unbound: !!(o.trigger && o.trigger.unbound) } };
    }) };
    if (!src || !SEC.keyTaken || !SEC.keyTaken(doc, src)) return false;
    made.trigger.unbound = true;
    made.trigger.home = src;
    made.trigger.src = null;
    made.trigger.follow = null;
    made.enabled = false;
    made.name = freeName(S, made.name);
    S.actions.push(made);
    saveAll(p, S);
    ZS.toast(SEC.srcName(src) + ' already does something here - pick the key for "' + made.name + '"');
    SEC.openOnKeyPicker(root, p, S, S.actions.length - 1);
    return true;
  }
  function openFeatured(root, p, S, fi) {
    var f = FEATURED[fi], ti = tplIndexById(f && f.id), t = TEMPLATES[ti];
    if (!t) return;
    var cfg = templateCfg(t), u = t.tunes[f.tune];
    /* D256 (owner, 2026-10-09: "when I add the premade rapid fire don't give
       me the slider there - just add the script to the config and teleport
       me to Smart mappings to view it"): Rapid fire adds on the tap, at its
       default speed, and opens Smart mappings on its row - where its speed
       slider is (inputRowHTML's turbo row) */
    /* D270: the Aim assist booster the same way (owner, 2026-10-10: "when
       added, the row in Scripts shows the slider ... and the featured add
       drops it straight into the config and jumps to the row") */
    if (f.quick) {
      var made0 = buildTemplate(p, t, cfg);
      var nm0 = f.id === 'turbo' ? 'Rapid fire' : fillNames(t.n, p);
      if (hasErrors(made0, p, null)) { ZS.toast(nm0 + ' cannot be added here'); return; }
      if (t.id === 'turnassist' && featuredTurnAssist(root, p, S, made0)) return;
      var clash0 = dupWhen(S.actions, made0, p);
      if (clash0) { showClash(root, p, S, clash0); return; }
      made0.name = freeName(S, made0.name);
      S.actions.push(made0);
      var at = S.actions.length - 1;
      saveAll(p, S);
      S.screen = 'index';
      S.flashAct = at;
      draw(root || VIEW.lastRoot, p);
      ZS.toast('"' + made0.name + '" added - ' + (f.added ||
        ('slide its ' + (f.id === 'turbo' ? 'speed' : 'strength') + ' here')));
      return;
    }
    var title = f.id === 'turbo' ? 'Rapid fire' : fillNames(t.n, p);
    function hint(v) {
      if (f.id === 'turbo') return 'about ' + Math.max(1, Math.round(1000 / Math.max(1, v * 2))) + ' taps a second';
      return v <= 6 ? 'gentle' : v <= 10 ? 'medium' : 'strong';
    }
    var v0 = cfg.v[f.tune];
    var h = '<div id="tf-wrap">' + helpNote('featsay-' + f.id, title, esc(f.say)) +
      '<div class="fld col safeatfld"><div class="flab">' + esc(f.lab) +
      ' <b id="tf-val">' + v0 + ' ' + esc(f.unit) + '</b> <span class="safeath" id="tf-hint">' + esc(hint(v0)) + '</span></div>' +
      '<input class="rng" id="tf-rng" type="range" min="' + u.min + '" max="' + u.max + '" step="' + u.step +
      '" value="' + v0 + '" data-nosave="1" aria-label="' + esc(f.lab + ' in ' + f.unit) + '"></div>' +
      '<div class="safeatwho">Starts when you hold <b>' +
      esc(triggerName(p, buildTemplate(p, t, cfg))) + '</b></div>' +
      btnI('plus', 'Add to this config', 'primary', 'tf-add') + '</div>';
    var body = sheetPaint(title, h, function () {});
    var rng = body.querySelector('#tf-rng'), add = body.querySelector('#tf-add');
    rng.addEventListener('input', function () {
      cfg.v[f.tune] = clamp(Math.round(num(rng.value, v0)), u.min, u.max);
      body.querySelector('#tf-val').textContent = cfg.v[f.tune] + ' ' + f.unit;
      body.querySelector('#tf-hint').textContent = hint(cfg.v[f.tune]);
    });
    add.addEventListener('click', function () {
      /* one tap, one action (the same guard as #tp-add) */
      if (add.disabled) return;
      add.disabled = true;
      var made = buildTemplate(p, t, cfg);
      if (hasErrors(made, p, null)) { add.disabled = false; ZS.toast('That one cannot be added here'); return; }
      var clash = dupWhen(S.actions, made, p);
      if (clash) { ZS.sheetClose(); showClash(root, p, S, clash); return; }
      made.name = freeName(S, made.name);
      S.actions.push(made);
      saveAll(p, S);
      ZS.sheetClose();
      draw(root || VIEW.lastRoot, p);
      ZS.toast('"' + made.name + '" added');
    });
  }

  /* owner 2026-10-17: a gun page's Rapid fire / Aim assist / Anti-recoil
     tiles are dummy-proof - ONE slider, "Add to this config" or Cancel,
     nothing else. Once added, the Script shows in that gun's Scripts with
     the same slider on its row (16-buttons.js turbo / STRENGTH rows), so
     the strength can be turned up or down there. Rapid fire's slider is
     taps a second (what a player understands), written back as the
     template's half-period ms. */
  var QUICK_ADD = {
    turbo: { title: 'Rapid fire', lab: 'Speed', say: 'Hold fire and it taps for you. Too fast and some games drop shots.' },
    aimboost: { title: 'Aim assist', lab: 'Strength', say: 'Keeps the game’s aim assist switched on while you aim. Start low; if the reticle wobbles, it is too strong.' },
    recoil: { title: 'Anti-recoil', lab: 'Strength', say: 'Pulls your aim down while you aim and fire, so the gun stops climbing. Too strong and your shots go into the floor.' }
  };
  /* The one slider's scale, shared by openQuickAdd and the AI Scripts
     list's "Add quick scripts to guns" (gun-bulk.js, D405), so the two can
     never offer different ranges or defaults. `s` is what the player sees
     (taps a second, or %); `v` is the template's own first tune. */
  function quickRange(id) {
    var q = QUICK_ADD[id], t = TEMPLATES[tplIndexById(id)];
    if (!q || !t) return null;
    var u = t.tunes[0], taps = id === 'turbo';
    function toV(s) { return taps ? clamp(Math.round(1000 / (2 * s)), u.min, u.max) : clamp(s, u.min, u.max); }
    function fromV(v) { return taps ? Math.max(2, Math.min(33, Math.round(1000 / (2 * Math.max(1, v))))) : v; }
    var min = taps ? fromV(u.max) : u.min, max = taps ? fromV(u.min) : u.max;
    return {
      id: id, title: q.title, lab: q.lab, say: q.say, taps: taps,
      min: min, max: max, def: fromV(u.val), toV: toV, fromV: fromV,
      shown: function (s) { return taps ? s + ' taps a second' : s + '%'; },
      hint: function (s) {
        var f = (s - min) / Math.max(1, max - min);
        return taps ? (f < 0.34 ? 'steady' : f < 0.67 ? 'fast' : 'very fast') : (f < 0.34 ? 'gentle' : f < 0.67 ? 'medium' : 'strong');
      }
    };
  }
  /* the Script a quick tile adds, at strength `s`, as the room holds it */
  function quickBuild(p, id, s) {
    var r = quickRange(id), t = TEMPLATES[tplIndexById(id)];
    if (!r || !t) return null;
    var cfg = templateCfg(t);
    cfg.v[0] = r.toV(clamp(Math.round(+s || r.def), r.min, r.max));
    var made = buildTemplate(p, t, cfg);
    if (r.taps) made.name = 'Rapid fire';
    return made;
  }
  function openQuickAdd(root, p, S, id) {
    var q = QUICK_ADD[id], ti = tplIndexById(id), t = TEMPLATES[ti], R = quickRange(id);
    if (!q || !t || !R) return;
    var cfg = templateCfg(t);
    var taps = R.taps, toV = R.toV;
    var smin = R.min, smax = R.max;
    var s0 = R.fromV(cfg.v[0]);
    var shown = R.shown, hint = R.hint;
    var h = '<div id="tq-wrap">' + helpNote('quickadd-' + id, q.title, esc(q.say)) +
      '<div class="fld col safeatfld"><div class="flab">' + esc(q.lab) +
      ' <b id="tq-val">' + esc(shown(s0)) + '</b> <span class="safeath" id="tq-hint">' + esc(hint(s0)) + '</span></div>' +
      '<input class="rng" id="tq-rng" type="range" min="' + smin + '" max="' + smax + '" step="1" value="' + s0 +
      '" data-nosave="1" aria-label="' + esc(q.title + ' ' + q.lab.toLowerCase()) + '"></div>' +
      btnI('plus', 'Add to this config', 'primary', 'tq-add') +
      btn('Cancel', null, 'tq-cancel') + '</div>';
    var body = sheetPaint(q.title, h, function () {});
    var rng = body.querySelector('#tq-rng'), add = body.querySelector('#tq-add');
    rng.addEventListener('input', function () {
      var s = Math.round(num(rng.value, s0));
      cfg.v[0] = toV(s);
      body.querySelector('#tq-val').textContent = shown(s);
      body.querySelector('#tq-hint').textContent = hint(s);
    });
    body.querySelector('#tq-cancel').addEventListener('click', function () { ZS.sheetClose(); });
    add.addEventListener('click', function () {
      if (add.disabled) return;
      add.disabled = true;
      var made = buildTemplate(p, t, cfg);
      if (taps) made.name = 'Rapid fire';
      if (hasErrors(made, p, null)) { add.disabled = false; ZS.toast(q.title + ' cannot be added here'); return; }
      var clash = dupWhen(S.actions, made, p);
      if (clash) { ZS.sheetClose(); showClash(root, p, S, clash); return; }
      made.name = freeName(S, made.name);
      S.actions.push(made);
      S.flashAct = S.actions.length - 1;
      saveAll(p, S);
      ZS.sheetClose();
      draw(root || VIEW.lastRoot, p);
      ZS.toast('"' + made.name + '" added - slide its ' + q.lab.toLowerCase() + ' in Scripts');
    });
  }

  function openTemplate(root, p, S, ti) {
    var t = TEMPLATES[ti];
    var cfg = templateCfg(t);
    var first = true;

    function paint() {
      var a = buildTemplate(p, t, cfg);
      var s = sentence(a, p);
      var ps = problems(a, p, null);
      var bad = [];
      ps.forEach(function (x) { if (x.level === 'error') bad.push(x.msg); });

      /* D285: the description AND the step-by-step are the "?" fold; the
         sheet itself is the name, the button and the sliders */
      var desc = esc(fillNames(t.d, p));
      var pts = (ZS.helpPoints && ZS.helpPoints(desc)) || [desc];
      var h = '<div id="tp-wrap">' + helpNote('tpls-' + t.id, fillNames(t.n, p),
          '<ul class="qhlist">' + pts.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ul>' +
          /* the TAIL as well as the steps. The gallery used to print only
             the lead and the numbered steps, so everything that decides WHEN
             a preset runs — "only while you are aiming down sights", the
             cooldown, how many times it plays — was invisible until after
             you had added it and opened the editor. */
          '<div class="sapreview">' + s.leadHTML + '<ol>' +
          s.lines.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') +
          '</ol>' +
          s.tail.map(function (x) { return '<div class="satail">' + esc(x) + '</div>'; }).join('') +
          '</div>') +
        /* the adaptive ones say out loud what they changed and why, rather
           than silently building something other than what the card promised */
        (t.adaptive && adsGateOK(p) === false
          ? note('Nothing plugged in can aim down sights (L2 / LT, a right click or ' +
                 (adsBindingName(p) ? '<b>' + esc(adsBindingName(p)) + '</b>' : 'your Aim button') +
                 ') — so this one ' +
                 'starts from your <b>Aim</b> control instead, which comes to the ' +
                 'same thing. Set Aim / ADS on the Fire &amp; Aim screen if you would ' +
                 'rather have the real gate.', 'warn')
          : '') +
        sh('Which button should start it?') +
        helpNote('tp-trig', 'Which button should start it?',
                 'We have suggested the one most people use. Change it if you like.') +
        card(fld('Started by',
          '<button class="pbtn" id="tp-trig" aria-label="' +
          esc('trigger: ' + triggerName(p, a) + ' — change') + '">' +
          srcArt(emitSource(p, a.trigger)) + '<span class="plab">' +
          esc(triggerName(p, a)) + '</span><span class="pchev">▾</span></button>') +
          (t.btns || []).map(function (b, i) {
            return fld(b.lab, '<button class="pbtn" data-tb="' + i + '" aria-label="' +
              esc(b.lab + ': ' + tgtName(cfg.btns[i], p) + ' — change') + '">' +
              tgtSvg(cfg.btns[i], p) + '<span class="plab">' +
              esc(tgtName(cfg.btns[i], p)) + '</span><span class="pchev">▾</span></button>');
          }).join('') +
          (t.pick ? seg(t.pick.lab, t.pick.opts,
                        t.pick.vals.indexOf(cfg.v[t.pick.into || 0]), 'tp-pick',
                        'or set it exactly below') : '') +
          (t.tunes || []).map(function (u, i) {
            return stepper(u.lab, cfg.v[i], u.step, u.min, u.max, u.unit, u.sub || null,
                           'v' + i);
          }).join('')) +
        (t.id === 'turbo'
          ? note('That is about <b>' +
                 Math.max(1, Math.round(1000 / Math.max(1, cfg.v[0] * 2))) +
                 ' taps a second</b>.') : '') +
        (bad.length
          ? bad.map(function (m) { return note('<b>Fix this first:</b> ' + esc(m), 'warn'); }).join('')
          : '') +
        /* THE THIRD HALF. problems() has always detected this; it was only
           ever RENDERED inside the draft editor of one of the two, so the
           duplicate was created here and reported somewhere else. Same string,
           printed where the second one would actually be made. */
        (dupWhen(S.actions, a, p)
          ? note('<b>' + esc(triggerName(p, a)) + ' already has one:</b> ' + esc(DUP_WHEN_MSG), 'warn')
          : '') +
        btnI('plus', 'Add to this config', 'primary', 'tp-add') + '</div>';

      var body = sheetPaint(fillNames(t.n, p), h, first ? function () {} : undefined);
      first = false;
      var addBtn = body.querySelector('#tp-add');
      if (addBtn) addBtn.disabled = bad.length > 0;

      body.querySelector('#tp-wrap').addEventListener('zsstep', function (e) {
        var f = e.target && e.target.dataset && e.target.dataset.f;
        if (!f || f.charAt(0) !== 'v') return;
        var idx = +f.slice(1);
        if (!(idx >= 0 && idx < cfg.v.length)) return;
        cfg.v[idx] = Math.round(num(e.target.textContent, cfg.v[idx]));
        paint();
      });
      /* the three-way shortcut writes the slider it stands for, so both
         controls always agree and there is only ever one number */
      var pk = body.querySelector('#tp-pick');
      if (pk && t.pick) {
        var pbs = pk.querySelectorAll('button');
        for (var i = 0; i < pbs.length; i++) {
          (function (idx) {
            pbs[idx].addEventListener('click', function () {
              cfg.v[t.pick.into || 0] = t.pick.vals[idx];
              paint();
            });
          })(i);
        }
      }
      var tb = body.querySelector('#tp-trig');
      if (tb) tb.addEventListener('click', function () {
        pickTrigger(p).then(function (v) {
          if (v) { cfg.trig.src = v.src; cfg.trig.follow = v.follow; }
          paint();
        });
      });
      body.querySelectorAll('[data-tb]').forEach(function (b) {
        b.addEventListener('click', function () {
          var i = +b.dataset.tb;
          openTargetPane(p, function (code) { cfg.btns[i] = code; }, paint);
        });
      });
      if (addBtn) addBtn.addEventListener('click', function () {
        /* THE ROOT CAUSE OF THE DUPLICATE, and its whole fix.
           ZS.sheetClose() only removes the `open` class; ZSM.attachSheet then
           holds display:block for the ~260 ms spring-out, so #tp-add stays
           laid out and hit-testable that whole time. A second tap in that
           window — a double-tap, or the hand tremor this product exists to
           accommodate — ran this handler again, and buildTemplate → normAction
           mints a FRESH id, so the result was two byte-identical actions with
           different ids that nothing downstream could tell apart.
           One tap, one action. The same guard is on #sa-save and on the
           recorder's two Use buttons. */
        if (addBtn.disabled) return;
        addBtn.disabled = true;
        var made = buildTemplate(p, t, cfg);
        if (hasErrors(made, p, null)) {
          addBtn.disabled = false;
          ZS.toast('Fix the problem above first');
          return;
        }
        /* and give the name a fighting chance: a constant name per template is
           what made two identical labels possible at all */
        var already = templateCount(S, t.id);
        if (already) made.name = made.name + ' ' + (already + 1);
        S.actions.push(made);
        saveAll(p, S);
        ZS.sheetClose();
        /* Land ON the button it now belongs to, with the editor sheet open
           over it. The preset is not a thing floating in a list any more — it
           is what that button does, and the screen that says so is the one you
           arrive on. */
        var landed = rowFor(p, S, emitSource(p, made.trigger) || '');
        if (landed) {
          S.inputSrc = landed.source;
          S.screen = 'input'; S.mode = 'sequence';
          S.editIdx = S.actions.length - 1;
          S.draft = clone(made);
          S.unsaved = false; S.sel = null; S.page = 0;
        } else {
          S.screen = S.smartTab || 'index';
        }
        draw(root || VIEW.lastRoot, p);
        ZS.toast('"' + made.name + '" added — change anything you like');
      });
    }
    paint();
  }

  /* what the other parts use from this one */
  SEC.FAMILIES = FAMILIES;
  SEC.TEMPLATES = TEMPLATES;
