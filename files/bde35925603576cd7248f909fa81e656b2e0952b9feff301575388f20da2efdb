      pick: { lab: 'How hard', opts: ['Light', 'Medium', 'Heavy'],
              vals: [10, 20, 32], into: 0 },
      tunes: [{ lab: 'How hard it pulls down', val: 20, min: 3, max: 60, step: 1,
                unit: '%', sub: 'too much and your shots go into the floor' }],
      build: function (v, b, ctx) {
        return {
          name: 'Anti-recoil', holdMode: 'run_while_held', cooldownMs: 0,
          gate: (ctx && ctx.ads === false) ? 'always' : 'ads',
          maxDurationMs: 30000, maxRepeats: 3,
          steps: [{ k: 'stick', stick: 'right', angle: 270, dist: v[0] / 100,
