  var FAM_BY_KEY = {};
  FAMILIES.forEach(function (f) { FAM_BY_KEY[f.k] = f; });

  var TEMPLATES = [

    /* ── movement and access ─────────────────────────────────────── */
    {
      id: 'autosprint', fam: 'access', ico: 'shift', n: 'Auto sprint', runsFor: 0,
      d: 'Click sprint once and ZeroStick pushes the stick forward for you. ' +
         'You can take your thumb off the stick completely and keep running.',
