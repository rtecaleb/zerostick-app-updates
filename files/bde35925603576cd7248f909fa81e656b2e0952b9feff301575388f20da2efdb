        for (i = 0; i < 8; i++) {
          st.push({ k: 'stick', stick: 'right', angle: i * 45, dist: v[0] / 100,
                    ms: clamp(v[1], 1, STEP_MS_CAP) });
        }
        return {
          name: 'Aim assist booster', holdMode: 'repeat_while_held',
          cooldownMs: 0, maxDurationMs: 30000, maxRepeats: 1, varianceMs: 0,
          steps: st
        };
      }
    },
    {
      id: 'recoil', fam: 'aim', ico: 'wave', n: 'Anti-recoil',
      d: 'While you aim AND fire, the aim stick is pulled straight down so the ' +
         'gun stops climbing off the target. It ADDS to what you are already ' +
         'aiming, so you can still track upward — it just takes the climb out. ' +
         'Hip-fire and menus are left alone.',
      trig: { follow: 'rt+' },
