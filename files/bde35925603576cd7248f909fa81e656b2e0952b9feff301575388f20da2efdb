        var gated = ctx.ads !== false;
        return {
          name: gated ? 'Anti-recoil (aiming)' : 'Anti-recoil (while aiming)',
          holdMode: 'run_while_held', cooldownMs: 0,
          gate: gated ? 'ads' : 'always',
          trigger: gated ? null : { follow: 'lt+' },
          maxDurationMs: 30000, maxRepeats: 3,
          steps: [{ k: 'stick', stick: 'right', angle: 270, dist: v[0] / 100,
                    ms: STEP_MS_CAP }]
        };
      }
    },
    {
      id: 'recoilpat', fam: 'aim', ico: 'recoil', n: 'Recoil pattern',
      d: 'For a gun that always pulls the same way. Instead of dragging straight ' +
         'down, this walks the aim stick along a path while you fire — down, ' +
         'then a lean left, then back right. Get the shape roughly right first, ' +
         'then tune the strength.',
      trig: { follow: 'rt+' },
      tunes: [
        { lab: 'How hard', val: 22, min: 3, max: 60, step: 1, unit: '%' },
        { lab: 'How quickly it walks', val: 100, min: 40, max: 200, step: 10,
