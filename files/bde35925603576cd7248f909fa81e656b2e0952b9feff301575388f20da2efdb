    { k: 'fire', n: 'Firing', ico: 'burst', col: '#e3b341',
      d: 'One pull, many shots — and the shots you would otherwise miss.' },
    { k: 'qol', n: 'Quality of life', ico: 'grid', col: '#a371f7',
