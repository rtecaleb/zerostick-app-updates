         'ZeroStick keeps it down for as long as you say.',
      trig: { follow: 'lt+' },
      btns: [{ lab: 'Button to hold', def: 'lt+' }],
      tunes: [{ lab: 'Keep it down for', val: 5000, min: 1000, max: 29000,
                step: 500, unit: 'ms' }],
      build: function (v, b) {
        return {
