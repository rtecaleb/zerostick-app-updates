/* name-reader.js - the app sends the Core its game's WEAPON NAMES when the
 * Core has none. window.ZSNAMEREADER.
 *
 * ES5 ONLY, like every file phone.html loads (docs/DESIGN.md): no arrow
 * function, template literal, let/const or class.
 *
 * -- Why (the owner, 2026-10-02) ---------------------------------------------
 *
 * "The Core forgets its weapon-name reader every time it restarts." The
 * Core's name reader (D141/D142, firmware zs_textread_bench.h) reads the
 * gun's name with ONE blob: the game's HUD font, its weapon names, where the
 * name sits and how sure a read must be. Until now only a PC tool could send
 * it (firmware/lite-p4/tools/teach_bench.py name-push), so a Core with none
 * on it - a new Core, or one whose kept reader its firmware refused - showed
 * "Detection not set up" until somebody ran that tool.
 *
 * The firmware KEEPS a reader it has taken (NVS, zs_textread_keep.h) and
 * loads it again at every start, and its /status says "loaded":true from the
 * moment it loads, not from the first picture. So "weapon":{"loaded":false}
 * now means exactly one thing: this Core has no game's names. When it says
 * so, this file builds the blob from the same files the PC tool builds it
 * from (game-data/<pack>/recognition.json + catalog.json), byte for byte
 * what train_textread.bench_blob makes (dashboard/tools/test-name-reader.js
 * checks it against vectors that Python wrote), and POSTs it to
 * /vision/textread, once. The Core keeps it from then on.
 *
 * WHAT IT NEVER DOES: replace a reader the Core already has (a different
 * game's, or one pushed from the PC), push for a config whose game has no
 * reader (recognition.json), push on an EXO, or retry a blob the Core
 * refused. The player's own box (the Gun reader frame, gun-frame.js) is the
 * Core's and stands over the blob's suggested one, so pushing never moves it.
 */
(function (root) {
  'use strict';

  var PLANES = { luma: 0, ink: 1, plate: 2, luma2x: 3 };   /* luma2x: D411, BO7 / Warzone */
  var SPANS = { line: 0, words: 1 };
  var BUILT_IN_BOX = [0.60, 0.815, 0.33, 0.047];  /* train_textread's default */
  var VERSION = 1;                                /* ZS_TRB_VERSION */
  var BLOB_MAX = 16384;                           /* ZS_TRB_BLOB_MAX */

  /* ═════════════════════════════════════════════ the blob, in pure JS ══
     Each function is the Python one of the same name in
     firmware/lite-p4/components/zs_textread/tools/train_textread.py. */

  /* zs_tr_fold / train_textread.fold(s, keep_spaces=False): the typographer's
     apostrophes plain, o-slash to o, accents off, upper case, no spaces. */
  var COMBINING = /[̀-ͯ҃-҉֑-ֽ᪰-᫿᷀-᷿⃐-⃿︠-︯]/g;
  function fold(s) {
    s = String(s == null ? '' : s)
      .replace(/[’‘]/g, "'").replace(/ø/g, 'o').replace(/Ø/g, 'O');
    if (typeof s.normalize === 'function') { s = s.normalize('NFKD'); }
    return s.replace(COMBINING, '').toUpperCase().replace(/ /g, '');
  }

  /* catalog_items: every group's items, then each kind's groups and items. */
  function catalogItems(cat) {
    var groups = ((cat && cat.groups) || []).slice(), items = [], i;
    var kinds = (cat && cat.kinds) || [];
    for (i = 0; i < kinds.length; i++) {
      groups = groups.concat(kinds[i].groups || [], [{ items: kinds[i].items || [] }]);
    }
    for (i = 0; i < groups.length; i++) { items = items.concat(groups[i].items || []); }
    return items;
  }

  /* lex_names: every catalog name (its HUD spelling when it has one), then the
     decoys; folded; the first of each folded name kept. */
  function lexNames(items, hud, decoys) {
    var out = [], seen = {}, all = [], i, key;
    hud = hud || {};
    for (i = 0; i < items.length; i++) {
      var id = items[i].id;
      all.push(Object.prototype.hasOwnProperty.call(hud, id) ? hud[id] : items[i].name);
    }
    all = all.concat(decoys || []);
    for (i = 0; i < all.length; i++) {
      key = fold(all[i]);
      if (key && !Object.prototype.hasOwnProperty.call(seen, key)) {
        seen[key] = true;
        out.push(key);
      }
    }
    return out;
  }

  /* Python's round(): halves go to the even neighbour. */
  function roundHalfEven(x) {
    var f = Math.floor(x), d = x - f;
    if (d > 0.5) { return f + 1; }
    if (d < 0.5) { return f; }
    return (f % 2 === 0) ? f : f + 1;
  }
  function put16(b, v) { b.push(v & 0xff, (v >>> 8) & 0xff); }

  /* lex_pack: u16 count, then each name as a length byte and its ASCII, one
     '?' for every character that is not ASCII (encode("ascii", "replace")). */
  function lexPack(names) {
    var b = [], i, j;
    put16(b, names.length);
    for (i = 0; i < names.length; i++) {
      var raw = [], s = names[i];
      for (j = 0; j < s.length; j++) {
        var c = s.charCodeAt(j);
        if (c >= 0xd800 && c <= 0xdbff && j + 1 < s.length) {
          var n = s.charCodeAt(j + 1);
          if (n >= 0xdc00 && n <= 0xdfff) { j++; }    /* one code point, one '?' */
        }
        raw.push(c < 0x80 ? c : 0x3f);
      }
      if (raw.length > 255) { throw new Error('a name longer than 255 characters: ' + s); }
      b.push(raw.length);
      b = b.concat(raw);
    }
    return b;
  }

  /* bench_blob: zs_textread_bench.h's blob, byte for byte. */
  function benchBlob(font, names, plane, span, box, threshold, margin, streak, hold, shear, hunt) {
    var b = [0x5a, 0x42, VERSION], i, lx;
    if (!Object.prototype.hasOwnProperty.call(PLANES, plane)) { throw new Error('no such plane: ' + plane); }
    if (!Object.prototype.hasOwnProperty.call(SPANS, span)) { throw new Error('no such span: ' + span); }
    /* flags: bit 0 a blank read holds, bit 1 the gun hunt over the bottom
       quarter (zs_textread_hunt.h, 2026-10-19; an older firmware ignores it) */
    b.push(PLANES[plane], SPANS[span], streak == null ? 2 : streak,
           (hold ? 1 : 0) | (hunt ? 2 : 0), shear || 0);
    for (i = 0; i < 4; i++) {
      put16(b, roundHalfEven(Math.min(Math.max(box[i], 0.0), 1.0) * 65535));
    }
    put16(b, roundHalfEven(threshold * 1000));
    put16(b, roundHalfEven(margin * 1000));
    put16(b, font.length);
    for (i = 0; i < font.length; i++) { b.push(font[i]); }
    lx = lexPack(names);
    put16(b, lx.length);
    b = b.concat(lx);
    return new Uint8Array(b);
  }

  var B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
  function b64decode(s) {
    var out = [], acc = 0, bits = 0, i, v;
    s = String(s || '').replace(/[^A-Za-z0-9+/]/g, '');
    for (i = 0; i < s.length; i++) {
      v = B64.indexOf(s.charAt(i));
      acc = (acc << 6) | v; bits += 6;
      if (bits >= 8) { bits -= 8; out.push((acc >>> bits) & 0xff); }
    }
    return out;
  }
  function b64encode(bytes) {
    var out = '', i, n;
    for (i = 0; i < bytes.length; i += 3) {
      n = (bytes[i] << 16) | ((i + 1 < bytes.length ? bytes[i + 1] : 0) << 8) |
          (i + 2 < bytes.length ? bytes[i + 2] : 0);
      out += B64.charAt((n >>> 18) & 63) + B64.charAt((n >>> 12) & 63) +
        (i + 1 < bytes.length ? B64.charAt((n >>> 6) & 63) : '=') +
        (i + 2 < bytes.length ? B64.charAt(n & 63) : '=');
    }
    return out;
  }

  /* teach_bench.name_blob, from the two files' contents: {blob, names, box}.
     Throws with a sentence when the recognition file is not one it reads. */
  function blobOf(rec, cat, box) {
    if (!rec || rec.zerostickRecognition !== 1 || !rec.font || !rec.font.b64 ||
        !rec.text || !rec.read) {
      throw new Error('not a recognition file this app reads');
    }
    var names = lexNames(catalogItems(cat), (rec.names && rec.names.hud) || {},
                         (rec.names && rec.names.decoys) || []);
    var text = rec.text, read = rec.read;
    var b = box || (rec.box && rec.box.suggested) || BUILT_IN_BOX;
    var blob = benchBlob(b64decode(rec.font.b64), names, text.plane || 'luma',
                         text.span || 'line', b, read.threshold, read.margin,
                         read.streak == null ? 3 : read.streak, read.blank === 'hold',
                         text.shear64 || 0, read.hunt === true);
    if (blob.length > BLOB_MAX) { throw new Error('the blob is bigger than the Core takes'); }
    return { blob: blob, names: names, box: b };
  }

  /* ══════════════════════════════════════════ sending it, in the app ══ */

  var RETRY_MS = [5000, 15000, 60000];   /* a busy or lost push, tried again */
  var SETTLE_MS = 20000;                  /* after a push the Core took */
  /* "none loaded" must hold this long first: a Core just restarted answers
     for a few milliseconds before its capture task has loaded the reader it
     kept, and a push then would only write the same names to its flash. */
  var SURE_MS = 4000;
  var MAX_SENT = 2;      /* pushes the Core took that still left it with none */
  var S = {
    state: 'idle',      /* idle | sending | sent | refused | no-reader | gave-up */
    pack: '',           /* the game whose names were (or would be) sent */
    why: '',            /* the Core's or the app's sentence, for a refusal */
    tries: 0,           /* pushes tried since the last one the Core took */
    sent: 0,            /* pushes the Core took since it last said "loaded" */
    next: 0,            /* not before this Date.now() */
    noneSince: 0,       /* when "loaded":false was first seen, 0 = not now */
    noReader: {}        /* pack id -> true: that game has no recognition.json */
  };

  function Z() { return root.ZS || null; }
  function now() { return Date.now(); }

  /* The game of the config being played, when it has a reader. The Core's
     reader is one per device; the config is only how the app knows which
     game the player is in. null: no config document yet, or no game. */
  function activePack() {
    var z = Z(), full, p;
    if (!z || !z.live || !z.live.full) { return null; }
    full = z.live.full[z.activeId];
    if (!full) { return null; }
    p = (root.ZSPACKS && typeof root.ZSPACKS.ofConfig === 'function')
      ? root.ZSPACKS.ofConfig(full) : null;
    if (p && typeof p.id === 'string' && p.id) { return p.id; }
    if (full.gamePack && typeof full.gamePack.id === 'string' && full.gamePack.id) {
      return full.gamePack.id;
    }
    return null;
  }

  function getJSON(url) {
    return root.fetch(url).then(function (r) {
      if (!r || !r.ok) { throw new Error('missing'); }
      return r.json();
    });
  }

  /* A refusal is final; a busy Core, a lost line or a dead link is not. */
  function transient(err) {
    return /cannot take a blob|another push|did not take the blob|try again|unreachable|timed out|no answer|abort|offline/i
      .test(String(err || ''));
  }

  function send(pack) {
    var z = Z();
    S.state = 'sending'; S.pack = pack; S.why = ''; S.tries++;
    return Promise.all([
      getJSON('game-data/' + pack + '/recognition.json'),
      getJSON('game-data/' + pack + '/catalog.json')
    ]).then(function (got) {
      var b = blobOf(got[0], got[1], null);
      return z.api('/vision/textread', 'POST', { blob: b64encode(b.blob) });
    }, function () {
      S.noReader[pack] = true;
      S.state = 'no-reader';
      return null;
    }).then(function (j) {
      if (S.state === 'no-reader') { return S; }
      if (j && j.ok) {
        S.sent++; S.tries = 0; S.next = now() + SETTLE_MS;
        /* An older firmware said "loaded" only once a picture was read: it
           takes the names and still says none. Twice is enough. */
        S.state = S.sent >= MAX_SENT ? 'gave-up' : 'sent';
        if (S.state === 'gave-up') {
          S.why = 'The Core took the weapon names but still says none is loaded.';
        }
        return S;
      }
      var err = (j && j.error) ? String(j.error) : 'no answer';
      if (transient(err) && S.tries < RETRY_MS.length + 1) {
        S.state = 'idle';
        S.next = now() + RETRY_MS[Math.min(S.tries - 1, RETRY_MS.length - 1)];
      } else {
        S.state = transient(err) ? 'gave-up' : 'refused';
      }
      S.why = err;
      return S;
    })['catch'](function (e) {
      /* the files were there but not usable: the app's own fault, said once */
      S.state = 'refused'; S.why = String(e && e.message || e);
      return S;
    });
  }

  /* Called with every /status poll's weapon block (devbar.js publishes it as
     ZS.liveInput.weapon). Returns the promise of a push, or null. */
  function consider(weapon) {
    var z = Z(), pack;
    if (!z || typeof z.api !== 'function') { return null; }
    if (typeof z.productId !== 'function' || z.productId() !== 'core') { return null; }
    if (z.live && z.live.online === false) { return null; }
    if (!weapon || typeof weapon !== 'object') { return null; }
    if (weapon.loaded !== false) {
      /* the Core has a reader: nothing to send, and a later loss starts over */
      S.noneSince = 0; S.sent = 0;
      if (S.state === 'sent' || S.state === 'gave-up') { S.state = 'idle'; S.tries = 0; }
      return null;
    }
    if (!S.noneSince) { S.noneSince = now(); }
    if (now() - S.noneSince < SURE_MS) { return null; }
    if (S.state === 'sending' || S.state === 'refused' || S.state === 'gave-up') { return null; }
    if (now() < S.next) { return null; }
    pack = activePack();
    if (!pack || S.noReader[pack]) { return null; }
    return send(pack);
  }

  function state() {
    return { state: S.state, pack: S.pack, why: S.why, tries: S.tries, sent: S.sent };
  }

  /* tests only: forget everything */
  function reset() {
    S.state = 'idle'; S.pack = ''; S.why = ''; S.tries = 0; S.sent = 0; S.next = 0;
    S.noneSince = 0; S.noReader = {};
  }

  root.ZSNAMEREADER = {
    fold: fold, catalogItems: catalogItems, lexNames: lexNames, lexPack: lexPack,
    benchBlob: benchBlob, blobOf: blobOf, b64encode: b64encode, b64decode: b64decode,
    roundHalfEven: roundHalfEven, consider: consider, state: state, reset: reset,
    SURE_MS: SURE_MS, SETTLE_MS: SETTLE_MS, RETRY_MS: RETRY_MS
  };

  var z0 = Z();
  if (z0 && typeof z0.onLiveInput === 'function') {
    z0.onLiveInput(function (li) { consider(li && li.weapon); });
  }
})(typeof window !== 'undefined' ? window : this);
