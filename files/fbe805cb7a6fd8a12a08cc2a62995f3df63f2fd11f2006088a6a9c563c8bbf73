      var n = isNum(d.presses) && d.presses > 0 ? d.presses : DELAY_PRESSES;
      var done = isNum(d.done) ? Math.min(d.done, n) : 0;
      var say = d.state === 'quiet' ? 'Waiting for the picture to settle…'
