/* sections/23b-autogreen.js — NBA 2K Auto green on the Core (D406).
 *
 * R.autogreen: the screen behind the editor menu's "Auto green" row, which
 * is drawn ONLY for an NBA 2K config on a Core (shell/07-inputs.js
 * isNbaConfig + PRODUCTS.exo.lacks 'autogreen'). Owner, 2026-10-18: "If
 * auto green is on, gun detection isn't even a thing on 2K profiles", so an
 * NBA 2K config has this row and no AI Scripts row, and HOME has no weapon
 * card for it (shell/09-home.js).
 *
 * WHAT IT IS. The player holds shoot (Square on PlayStation, X on Xbox) as
 * always; the Core watches the shot meter through the capture and lets go
 * of the button for them when the meter reaches the green. It only ever
 * LETS GO of a button the player is holding; it never presses one, and a
 * real release wins on that tick (AGENTS.md rule 5).
 *
 * TOP TO BOTTOM:
 *   1. Auto green On/Off (autoGreen.enabled), its "?", and the LIVE status
 *      line from GET /shot (words, "Timing: meter|press" from `using`, or
 *      `why` when the Core says it is not running). Live, so never folded.
 *   2. Which meter (D447): "NBA 2K27 (white meter)" | "NBA 2K26 (purple
 *      arrow)", each with a small drawing of its meter, written to
 *      autoGreen.meterStyle ('white' | 'arrow'; the Core reads an absent
 *      field as 'arrow'). An absent field is SHOWN as 2K27 (the owner plays
 *      2K27, 2026-10-23) and 'white' is written with the first change made
 *      in this room (ensureStyle), never by only opening it. Its "?" says
 *      how the 2K27 meter is read. Under it the live meter card (#ag-seen):
 *      from the same GET /shot, in plain words, found / looking / where to
 *      find it, the last shot let go or not (the Core's own why), and a
 *      mini meter filled to the last shot's `fill`. Only what the Core says.
 *   3. Timing card: the nudge slider, Sooner ... Later, -150..150 ms in
 *      steps of 2 (autoGreen.nudgeMs, + lets go later), its "?" (which also
 *      explains the delay slider); then "Your delay", a slider 0..400 ms in
 *      steps of 5 (autoGreen.delayMs, set by hand) and "Measure my delay",
 *      a sheet that runs POST/GET /shot/delay and whose Apply writes the
 *      rounded median (and moves the slider).
 *   4. Last shot: what the Core did, in words ("Let go at 47% of the meter,
 *      604 ms after your press" / "Did not let go: <why>"), the meter's own
 *      read as a small hint (telemetry, never a verdict), and three big
 *      buttons Early / Perfect / Late (POST /shot/verdict {seq, kind}); the
 *      Core's answer under them; what it has learned (`learn`).
 *   5. "More" (a fold): Learn from the meter (autoGreen.learnFromMeter) and
 *      Timing mode Auto / Meter / Press (autoGreen.strategy), each with a
 *      "?", and Forget what it learned (POST /shot/forget).
 *   6. Developer only (ZS.coreDevMode()): Bench, POST /shot/bench {op:
 *      'start', frames: 120} and GET /shot/bench's phases; and Simulated
 *      shots (D407): POST /shot/sim {op: 'start'} (the Core's defaults: 12
 *      shots at each of 0 / 50 / 100 / 150 / 250 ms, calibrated) or {op:
 *      'stop'}, GET /shot/sim's rows (green / early / late per latency),
 *      the search and track costs and the verdict sentence.
 *
 * THE CONFIG. Every control is a normal bound field (B(), ZS.wire), so it
 * waits for Save like every other setting (D257). Nothing is written when
 * the screen only opens: an NBA 2K config made from the pack already
 * carries autoGreen (ZSPACKS.build), and an older one gets the block on its
 * first change here (the path write makes it; the encoder writes the
 * Core's defaults for every field the block leaves out, so a partial block
 * and a full one are the same bytes). Its presence is the SHOT section
 * (0x0070, zs-profile-encode.js writeShot), which also tells the Core "this
 * is a 2K config".
 *
 * Core routes:   GET /shot (every 250 ms, about 4 a second, ONLY while the
 *                room is open: the poll ends when it closes), POST
 *                /shot/verdict, POST /shot/forget, POST/GET /shot/delay,
 *                POST/GET /shot/bench and /shot/sim (developer). Shapes:
 *                the D406 and D407 contracts; GET /shot may also carry
 *                `meterStyle` (what the Core is reading now) and `picture`.
 * Profile:       autoGreen.{enabled, nudgeMs, strategy, learnFromMeter,
 *                delayMs, meterStyle}
 * Tests:         test-auto-green.js
 *
 * ONE OF THE APP'S SCREEN FILES: phone-sections.js is the loader and
 * explains the rules. ES5 only; everything into innerHTML through esc().
 */
ZS_SECTIONS.add('autogreen', function (SEC) {
  /* from the files before this one */
  var acc = SEC.acc, armConfirm = SEC.armConfirm, B = SEC.B, card = SEC.card, esc = SEC.esc,
      helpHTML = SEC.helpHTML, R = SEC.R, seg = SEC.seg, sh = SEC.sh, slider = SEC.slider,
      toggleFld = SEC.toggleFld, ZS = SEC.ZS;

  var POLL_MS = 250;          /* GET /shot about 4 times a second while open (D447) */
  var DELAY_POLL_MS = 300;
  var BENCH_POLL_MS = 500;
  var SIM_POLL_MS = 1000;
  var NUDGE_MIN = -150, NUDGE_MAX = 150, NUDGE_STEP = 2;
  var DELAY_MIN = 0, DELAY_MAX = 400, DELAY_STEP = 5;
  /* D447: which meter the Core reads. The labels ARE the binding's keys (the
     kit's seg writes a button's textContent through the map). */
  var STYLE_WHITE = 'NBA 2K27 (white meter)', STYLE_ARROW = 'NBA 2K26 (purple arrow)';
  var STYLE_MAP = {};
  STYLE_MAP[STYLE_WHITE] = 'white';
  STYLE_MAP[STYLE_ARROW] = 'arrow';
  var DELAY_PRESSES = 8, DELAY_GAP_MS = 800;
  var CSS_ID = 'zs-ag-css';
  var KINDS = ['early', 'perfect', 'late'];
  var KIND_WORD = { early: 'Early', perfect: 'Perfect', late: 'Late' };
  var STRATEGY_MAP = { Auto: 'auto', Meter: 'meter', Press: 'press' };

  /* the words, in one place (the tests read COPY) */
  var SUB = 'Lets go of shoot in the green';
  var OLD_FW = 'This Core’s firmware doesn’t have Auto green yet.';
  var WHAT_HELP = '<b>Shoot as usual.</b> Hold shoot and your Core lets go for you when the shot meter ' +
    'reaches the green. ' +
    '<b>You stay in charge.</b> It only ever lets go of a button you are holding; it never presses one. ' +
    'Let go yourself and your release wins, at once. ' +
    '<b>It needs the game’s picture.</b> Your Core watches the meter through its capture, so the console ' +
    'has to be connected through it.';
  var NUDGE_HELP = '<b>Timing: your shots land a little early?</b> Slide toward Later. ' +
    '<b>A little late?</b> Slide toward Sooner. ' +
    'Each step is 2 ms. The Early / Perfect / Late buttons under Last shot teach your Core too, so ' +
    'you rarely need this. ' +
    '<b>Your delay</b> is how long your TV and capture take to show a frame. Your Core lets go that ' +
    'much sooner to make up for it. Set it by hand in steps of 5 ms, or tap Measure my delay and ' +
    'your Core times it for you.';
  var METER_HELP = '<b>NBA 2K27:</b> the meter is a thin bar standing beside your player. ' +
    'Your Core finds it by its small green tip at the top. ' +
    'While you hold shoot, white fills the bar from the bottom; your Core reads the white, because ' +
    '2K27 does not let you change the meter’s colour. ' +
    'It lets go when the white reaches the top. ' +
    '<b>NBA 2K26:</b> your Core reads the purple arrow instead. ' +
    'Pick the game you play; the live card under this shows what your Core sees.';
  var LEARN_HELP = '<b>Off (the usual):</b> only your own Early / Perfect / Late buttons teach your Core. ' +
    '<b>On:</b> when you do not answer, the meter’s own read (where its purple stopped) teaches it too. ' +
    'The meter can misread a shot, which is why this stays off unless you switch it on.';
  var MODE_HELP = '<b>Meter:</b> your Core watches the meter fill and lets go at the right spot. ' +
    '<b>Press:</b> it lets go a learned time after you press shoot, the same every time. ' +
    '<b>Auto (the usual):</b> it picks for each shot, the meter when it can see it and the press timing ' +
    'when it cannot.';

  /* ═════════════════════════════════════════════════════ the state ══ */
  var S = {
    pid: '', p: null,
    status: null,        /* GET /shot's answer, or null */
    err: '', noRoute: false,
    timer: null, gen: 0,
    busy: false,         /* a verdict on its way */
    picked: {},          /* seq -> kind, the answer the player just gave */
    answer: null,        /* {seq, text}: what the Core said back */
    bench: null, benchErr: '', benchTimer: null, benchBusy: false,
    sim: null, simErr: '', simTimer: null, simBusy: false,
    html: {}             /* slot id -> what it holds, so a poll repaints nothing it need not */
  };
  /* the Measure my delay sheet */
  var DL = { state: 'closed', data: null, err: '', timer: null, gen: 0, pid: '', busy: false };
  var ROOT = null;

  function $(id) { return document.getElementById(id); }
  function online() { return !(ZS.live && ZS.live.online === false); }
  function isNum(v) { return typeof v === 'number' && isFinite(v); }
  function isObj(v) { return !!v && typeof v === 'object' && !(v instanceof Array); }
  function fullOf(pid) { return (ZS.live && ZS.live.full && ZS.live.full[pid]) || null; }
  function blockOf(pid) {
    var f = fullOf(pid);
    return (f && isObj(f.autoGreen)) ? f.autoGreen : {};
  }
  function detailOpen() {
    var d = $('detail');
    return !d || d.classList.contains('open');
  }
  function onScreen() { return !!ROOT && $('ag-room') === ROOT && detailOpen(); }
  function api(path, method, body) {
    if (!ZS.api) { return Promise.resolve({ ok: false, error: 'no answer' }); }
    return ZS.api(path, method, body).then(function (j) { return j || { ok: false, error: 'no answer' }; },
      function (e) { return { ok: false, error: String((e && e.message) || e || 'no answer') }; });
  }
  /* the Core answers {ok:true, data:{...}}; a bare object is taken as-is */
  function dataOf(j) {
    if (!j || j.ok === false) { return null; }
    return (j.data !== undefined && j.data !== null) ? j.data : j;
  }
  function noRoute(j) {
    return /not found|no such|unknown route|not implemented|\b404\b|\b501\b/i.test(String((j && j.error) || ''));
  }
  function dot(kind) { return '<span class="ag-dot' + (kind ? ' ' + kind : '') + '" aria-hidden="true"></span>'; }

  /* "shoot" in the player's own button: the config's autoGreen.button
     (default west) on the console it plays on */
  var PAD_WORD = { west: ['Square', 'X'], south: ['Cross', 'A'], east: ['Circle', 'B'], north: ['Triangle', 'Y'] };
  function shootName(p) {
    var f = fullOf(p && p.id) || {};
    var b = blockOf(p && p.id).button || 'west';
    var xbox = (p && p.platform === 'xbox') || f.console === 'xbox';
    var w = PAD_WORD[b];
    return w ? w[xbox ? 1 : 0] : 'shoot';
  }

  function injectCss() {
    if ($(CSS_ID) || !document.head) { return; }
    var s = document.createElement('style');
    s.id = CSS_ID;
    s.textContent =
      /* the kit's cards pad their .fld rows; these slots are not rows */
      '#ag-room .ag-pad{padding:12px 14px 14px}' +
      '#ag-room .ag-liverow{display:flex;align-items:center;gap:10px;padding:10px 10px 10px 14px}' +
      '#ag-room .ag-liverow .qhrow{margin:0;flex:none}' +
      '#ag-room .ag-live{flex:1 1 auto;min-width:0;display:flex;align-items:flex-start;gap:8px;font-size:14px;line-height:1.45;' +
        'font-variant-numeric:tabular-nums}' +
      '#ag-room .ag-folds .qhfold{margin:0 14px 12px}' +
      '#ag-room .ag-live .ag-using{color:var(--muted)}' +
      '#ag-room .ag-dot{flex:none;width:9px;height:9px;border-radius:50%;margin-top:6px;background:var(--muted);opacity:.7}' +
      '#ag-room .ag-dot.ok{background:var(--green);opacity:1}' +
      '#ag-room .ag-dot.warn{background:var(--amber);opacity:1}' +
      '#ag-room .ag-ends{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:var(--muted);margin:2px 0 0}' +
      '#ag-room .ag-ends .qhrow{margin:0}' +
      '#ag-room .ag-did{font-size:15.5px;font-weight:600;line-height:1.4;margin:2px 0 4px}' +
      '#ag-room .ag-meta,#ag-room .ag-none,#ag-room .ag-learn{font-size:13px;color:var(--muted);line-height:1.45;margin:0 0 8px}' +
      '#ag-room .ag-ask{font-size:13px;font-weight:600;margin:10px 0 6px}' +
      '#ag-room .ag-vs{display:flex;gap:8px;margin:0 0 8px}' +
      '#ag-room .ag-v{flex:1 1 0;min-width:0;min-height:52px;border-radius:12px;border:1px solid var(--line);' +
        'background:var(--panel2);color:var(--text);font:inherit;font-size:16px;font-weight:650;cursor:pointer}' +
      '#ag-room .ag-v[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}' +
      '#ag-room .ag-v:disabled{opacity:.55;cursor:default}' +
      '#ag-room .ag-answer{font-size:13.5px;line-height:1.45;margin:0 0 8px}' +
      '#ag-room .ag-kv{display:flex;align-items:baseline;justify-content:space-between;gap:12px}' +
      '#ag-room .ag-kv .k{font-size:15px;font-weight:600}' +
      '#ag-room .ag-kv .v{font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums;text-align:right}' +
      '#ag-room .ag-forget{margin:8px 0 2px}' +
      /* D447: the meter choice. Each button is a drawing of its game's meter
         beside two lines of words; the kit's seg2 still owns on / aria. */
      '#ag-room .ag-style .seg2 button{display:flex;align-items:center;gap:10px;text-align:left;min-height:64px;' +
        'padding:8px 12px;flex:1 1 140px}' +
      '#ag-room .ag-style .seg2 button svg{flex:none}' +
      '#ag-room .ag-style .ag-sg{display:block;font-size:15px;font-weight:650;color:inherit}' +
      '#ag-room .ag-style .ag-ss{display:block;font-size:12.5px;font-weight:500;color:inherit}' +
      '#ag-room .ag-style .flab{display:flex;align-items:center;gap:6px}' +
      '#ag-room .ag-style .flab .qhrow{margin:0 0 0 auto;flex:none}' +
      '#ag-room .ag-stylehelp .qhfold{margin:0 14px 12px}' +
      '#ag-room .ag-seen{display:flex;align-items:center;gap:14px;padding:12px 14px 14px;border-top:1px solid var(--line)}' +
      '#ag-room .ag-seen svg{flex:none}' +
      '#ag-room .ag-seenw{flex:1 1 auto;min-width:0;font-variant-numeric:tabular-nums}' +
      '#ag-room .ag-found{font-size:15px;font-weight:600;line-height:1.4;margin:0 0 3px}' +
      '#ag-room .ag-res{font-size:13px;color:var(--muted);line-height:1.45;margin:0}' +
      '#ag-room .ag-delayrow .fld{border-top:1px solid var(--line)}' +
      /* the mini meters draw the GAME's own colours (white fill, green tip,
         2K26's magenta arrow): a picture of the game, not app chrome */
      '#ag-room .ag-mtrack{fill:var(--panel2);stroke:var(--line);stroke-width:1}' +
      '#ag-room .ag-mwhite{fill:#fff}' +
      '#ag-room .ag-mtip{fill:#3fd16b}' +
      '#ag-room .ag-marrow{fill:#e040d0}' +
      '#ag-room .ag-bench table{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums;margin:8px 0}' +
      '#ag-room .ag-bench th,#ag-room .ag-bench td{text-align:right;padding:4px 3px;border-bottom:1px solid var(--line)}' +
      '#ag-room .ag-bench th:first-child,#ag-room .ag-bench td:first-child{text-align:left}' +
      '#ag-room .ag-bench th{color:var(--muted);font-weight:600}' +
      '.ag-sheet .ag-steps{margin:0 0 14px;padding-left:22px;font-size:15px;line-height:1.5}' +
      '.ag-sheet .ag-steps li{margin:0 0 8px}' +
      '.ag-sheet .ag-big{text-align:center;font-size:28px;font-weight:700;margin:8px 0 2px;font-variant-numeric:tabular-nums}' +
      '.ag-sheet .ag-small{text-align:center;font-size:13.5px;color:var(--muted);margin:0 0 14px;line-height:1.45}' +
      '.ag-sheet .ag-bar{height:8px;border-radius:4px;background:var(--panel2);overflow:hidden;margin:6px 0 14px}' +
      '.ag-sheet .ag-bar i{display:block;height:100%;background:var(--accent);border-radius:4px}' +
      '.ag-sheet .ag-keys{display:flex;gap:10px}' +
      '.ag-sheet .ag-keys .btn{flex:1 1 0}' +
      '.ag-sheet .ag-err{font-size:14px;line-height:1.45;margin:0 0 14px}';
    document.head.appendChild(s);
  }

  /* ══════════════════════════════════════════ which meter (D447) ══ */
  /* the style this room SHOWS: the config's, and 2K27's white when the field
     is absent (the owner plays 2K27; the Core itself reads absent as arrow
     until the first change here writes 'white') */
  function styleOf(pid) { return blockOf(pid).meterStyle === 'arrow' ? 'arrow' : 'white'; }
  /* the first change made in this room also writes the meter the room shows,
     so the Core reads what the screen says. Never on a bare open. */
  function ensureStyle(pid) {
    var f = fullOf(pid);
    if (!f || !isObj(f.autoGreen) || f.autoGreen.meterStyle === 'white' || f.autoGreen.meterStyle === 'arrow') { return; }
    var save = ZS.editProfile || ZS.putProfile;
    if (!save) { return; }
    save(pid, function (d) {
      if (!isObj(d.autoGreen)) { d.autoGreen = {}; }
      if (d.autoGreen.meterStyle !== 'arrow') { d.autoGreen.meterStyle = 'white'; }
    });
  }
  /* a tiny drawing of a meter, filled to `fill` (0..1). Pure shapes, no
     text: the meter buttons' textContent is their binding key. */
  function meterSVG(style, fill, big) {
    var f = isNum(fill) ? Math.max(0, Math.min(1, fill)) : 0, w, h, s;
    if (style === 'arrow') {
      w = big ? 64 : 40; h = big ? 20 : 14;
      var cy = h / 2, sh0 = Math.max(2, Math.round(h * 0.3)), head = Math.round(h * 0.45);
      var len = Math.max(head + 2, Math.round((w - 6) * (big ? f : 0.7)));
      s = '<rect class="ag-mtrack" x="1" y="' + (cy - sh0 / 2 - 1) + '" width="' + (w - 2) + '" height="' + (sh0 + 2) +
        '" rx="' + (sh0 / 2 + 1) + '"/>' +
        '<rect class="ag-mtip" x="' + (w - 5) + '" y="' + (cy - sh0 / 2) + '" width="3" height="' + sh0 + '" rx="1"/>' +
        (f > 0 || !big ? '<rect class="ag-marrow" x="2" y="' + (cy - sh0 / 2) + '" width="' + (len - head + 1) +
          '" height="' + sh0 + '"/><polygon class="ag-marrow" points="' + (len - head + 2) + ',' + (cy - head) + ' ' +
          (len + 2) + ',' + cy + ' ' + (len - head + 2) + ',' + (cy + head) + '"/>' : '');
    } else {
      w = big ? 20 : 14; h = big ? 64 : 44;
      var bw = big ? 9 : 7, x = (w - bw) / 2, tip = Math.round(h * 0.12);
      var room = h - 2 - tip - 1, fillH = Math.round(room * (big ? f : 0.6));
      s = '<rect class="ag-mtrack" x="' + x + '" y="1" width="' + bw + '" height="' + (h - 2) + '" rx="' + (bw / 2) + '"/>' +
        '<rect class="ag-mtip" x="' + x + '" y="1" width="' + bw + '" height="' + tip + '" rx="' + (bw / 2) + '"/>' +
        (fillH > 0 ? '<rect class="ag-mwhite" x="' + (x + 1) + '" y="' + (h - 1 - fillH) + '" width="' + (bw - 2) +
          '" height="' + fillH + '" rx="' + ((bw - 2) / 2) + '"/>' : '');
    }
    return '<svg width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '" aria-hidden="true" focusable="false">' +
      s + '</svg>';
  }
  /* the meter choice: the kit's bound seg, each button given its drawing and
     two lines of words (the spans' text adds up to the label exactly) */
  function styleSegHTML(idx) {
    var h = seg('Your game', [STYLE_WHITE, STYLE_ARROW], idx, false,
      B('autoGreen.meterStyle', 1, { t: 'str', map: STYLE_MAP }));
    function dress(label, style) {
      var cut = label.indexOf(' (');
      return '>' + meterSVG(style, 0, false) + '<span><span class="ag-sg">' + esc(label.slice(0, cut)) +
        '</span><span class="ag-ss">' + esc(label.slice(cut)) + '</span></span></button>';
    }
    return h.replace('>' + esc(STYLE_WHITE) + '</button>', dress(STYLE_WHITE, 'white'))
      .replace('>' + esc(STYLE_ARROW) + '</button>', dress(STYLE_ARROW, 'arrow'))
      .replace('<div class="seg2"', '<div class="seg2" role="group" aria-label="Which meter your Core reads" id="ag-style"');
  }
  /* the live meter card: what the Core says it sees, in words */
  function seenHTML() {
    var style = styleOf(S.pid), st = S.status, L = st && st.last;
    var found = '', res = '', fill = null;
    var where = 'Hold ' + shootName(S.p) + ' in the gym: the meter shows up beside your player';
    if (!online()) { found = 'Your Core is offline'; }
    else if (S.noRoute) { found = OLD_FW; }
    else if (!st) { found = 'Asking your Core…'; }
    else if (st.on === false) { found = 'Turn on Auto green and your Core looks for the meter'; }
    else if (st.picture === false) { found = 'No game picture: connect your console through your Core'; }
    else if (st.state === 'reading' || st.state === 'planned') { found = 'Meter found - reading it now'; }
    else if (st.state === 'armed') { found = 'Looking for the meter…'; }
    else if (isObj(L) && isNum(L.fill) && L.seenMs !== null && L.seenMs !== undefined) {
      fill = L.fill;
      found = 'Meter found - ' + Math.round(L.fill * 100) + '% full';
    } else if (isObj(L)) { found = 'No meter on your last shot. ' + where; }
    else { found = where; }
    if (online() && !S.noRoute && isObj(L)) {
      var went = isNum(L.holdMs) && L.holdMs > 0 && L.how !== 'none';
      res = went ?'Last shot: let go' + (L.how === 'press' ? ' by press timing' : L.how === 'meter' ? ' by the meter' : '')
        : 'Last shot: not let go' + (L.why ? ' - ' + L.why : '');
      if (fill === null && isNum(L.fill)) { fill = L.fill; }
    }
    /* the Core says which meter it reads now: say so when that is not the
       one this screen shows (a change not saved yet, or an older config) */
    if (st && (st.meterStyle === 'white' || st.meterStyle === 'arrow') && st.meterStyle !== style) {
      res += (res ? '. ' : '') + 'Your Core reads the ' + (st.meterStyle === 'white' ? '2K27 white meter' : '2K26 purple arrow') +
        ' until you Save';
    }
    return meterSVG(style, fill, true) + '<div class="ag-seenw"><p class="ag-found" id="ag-found">' + esc(found) + '</p>' +
      (res ? '<p class="ag-res" id="ag-res">' + esc(res) + '</p>' : '') + '</div>';
  }

  /* ═══════════════════════════════════════════════ the live parts ══ */
  function liveHTML() {
    if (!online()) { return dot('') + '<span>Your Core is offline</span>'; }
    if (S.noRoute) { return dot('') + '<span>' + esc(OLD_FW) + '</span>'; }
    var st = S.status;
    if (!st) { return dot('') + '<span>' + esc(S.err || 'Asking your Core…') + '</span>'; }
    if (st.on === false) { return dot('') + '<span>' + esc(st.why || st.words || 'Off') + '</span>'; }
    var using = st.using === 'meter' ? 'Timing: meter' : st.using === 'press' ? 'Timing: press' : '';
