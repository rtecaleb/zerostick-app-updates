  /* ═══════════════════════════════════════════════ talking to the Core ══ */
  function poll(gen) {
    S.timer = null;
    if (gen !== S.gen || !onScreen()) { return; }
    if (!online()) {
      paint();
      S.timer = setTimeout(function () { poll(gen); }, 1500);
      return;
    }
    api('/shot').then(function (j) {
      if (gen !== S.gen) { return; }
      var d = dataOf(j);
      if (d) { S.status = d; S.err = ''; S.noRoute = false; }
      else { S.noRoute = noRoute(j); S.err = String((j && j.error) || ''); }
      paint();
      if (gen === S.gen && onScreen()) { S.timer = setTimeout(function () { poll(gen); }, POLL_MS); }
    });
  }
  function verdict(seq, kind) {
    if (S.busy || KINDS.indexOf(kind) < 0 || !isNum(seq)) { return; }
    S.busy = true;
    S.picked[seq] = kind;
    S.answer = null;
    paint();
    api('/shot/verdict', 'POST', { seq: seq, kind: kind }).then(function (j) {
      S.busy = false;
      var d = dataOf(j);
      if (d) {
        S.answer = { seq: seq, text: String(d.why || (d.taught ? 'Thanks. Your Core learned from that shot.'
          : 'Thanks. Noted.')) };
        if (isObj(d.last) && S.status) { S.status.last = d.last; }
      } else {
        delete S.picked[seq];
        S.answer = { seq: seq, text: String((j && j.error) || 'Your Core did not take that answer.') };
      }
      paint();
    });
  }
  function forget() {
