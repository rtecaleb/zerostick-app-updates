      B('autoGreen.delayMs', 1, { mn: DELAY_MIN, mx: DELAY_MAX }))
      .replace('type="range"', 'type="range" step="' + DELAY_STEP + '" id="ag-delayr"');
    /* the meter's "?" rides the choice's own label row; its fold opens
       under the two buttons */
    var meterHelp = chipAndFold('ag-meter-help', 'Which meter', METER_HELP);
    var styleSeg = styleSegHTML(styleOf(pid) === 'arrow' ? 1 : 0)
      .replace('</div><div class="seg2"', meterHelp[0] + '</div><div class="seg2"');
    var dev = !!(ZS.coreDevMode && ZS.coreDevMode());
    var html = '<div id="ag-room">' +
      card(toggleFld('Auto green', !!ag.enabled, SUB, false, B('autoGreen.enabled', 1, { t: 'bool' })) +
        '<div class="ag-liverow"><div class="ag-live" id="ag-live" role="status" aria-live="polite"></div>' + what[0] + '</div>' +
        '<div class="ag-folds">' + what[1] + '</div>') +
      sh('Meter') +
      card('<div class="ag-style">' + styleSeg + '</div>' +
        '<div class="ag-stylehelp">' + meterHelp[1] + '</div>' +
        '<div class="ag-seen" id="ag-seen" role="status" aria-live="polite"></div>') +
      card(timing + '<div class="ag-folds">' + nud[1] + '</div>' +
        '<div class="ag-delayrow">' + delayRng + '</div>' +
        '<div class="ag-pad" id="ag-delay"></div>') +
      sh('Last shot') +
      card('<div class="ag-pad" id="ag-last"></div>') +
      acc('More', 'sliders',
        toggleFld('Learn from the meter', !!ag.learnFromMeter, '', false, B('autoGreen.learnFromMeter', 1, { t: 'bool' })) +
        helpHTML('ag-learn-help', 'Learn from the meter', LEARN_HELP) +
        seg('Timing mode', ['Auto', 'Meter', 'Press'], strat < 0 ? 0 : strat, false,
          B('autoGreen.strategy', 1, { t: 'str', map: STRATEGY_MAP })) +
        helpHTML('ag-mode-help', 'Timing mode', MODE_HELP) +
        '<button type="button" class="btn ag-forget" id="ag-forget">Forget what it learned</button>',
        false, 'ag-more') +
      (dev ? sh('Bench (developer)') + card('<div class="ag-bench ag-pad" id="ag-bench"></div>') +
        sh('Simulated shots (developer)') + card('<div class="ag-bench ag-pad" id="ag-sim"></div>') : '') +
      '</div>';
    return { html: html, after: function (body) {
      ROOT = body.querySelector('#ag-room');
      if (!ROOT) { return; }
      var f = ROOT.querySelector('#ag-forget');
      if (f && armConfirm) { armConfirm(f, forget); }
      /* D447: a change to any bound control here also writes the meter the
         room shows (the kit's own listeners on the control run first) */
      var after1 = function (e) {
        var t = e.target;
        if (!t || !t.closest) { return; }
        var row = t.closest('.fld.tapper');
        if (t.closest('[data-bind]') || (row && row.querySelector('[data-bind]'))) { ensureStyle(S.pid); }
      };
      ROOT.addEventListener('click', after1);
      ROOT.addEventListener('input', after1);
      S.gen++;
      if (S.timer) { clearTimeout(S.timer); S.timer = null; }
      if (S.benchTimer) { clearTimeout(S.benchTimer); S.benchTimer = null; }
      if (S.simTimer) { clearTimeout(S.simTimer); S.simTimer = null; }
      paint();
      /* after openDetail has finished: the panel is marked open only once
         this hook returns, and the poll stops on a closed panel */
      var gen = S.gen;
      S.timer = setTimeout(function () { poll(gen); }, 0);
      if (dev && online()) {
        S.benchTimer = setTimeout(function () { benchPoll(gen); }, 0);
        S.simTimer = setTimeout(function () { simPoll(gen); }, 0);
      }
    } };
  };

  /* for the tests and the menu row */
  window.ZSAUTOGREEN = {
    state: function () { return S; },
    delayState: function () { return DL; },
    openDelay: openDelay,
    didWords: didWords,
    meterSVG: meterSVG,
    COPY: { sub: SUB, oldFw: OLD_FW, what: WHAT_HELP, nudge: NUDGE_HELP, learn: LEARN_HELP, mode: MODE_HELP,
      meter: METER_HELP, white: STYLE_WHITE, arrow: STYLE_ARROW }
  };
});
