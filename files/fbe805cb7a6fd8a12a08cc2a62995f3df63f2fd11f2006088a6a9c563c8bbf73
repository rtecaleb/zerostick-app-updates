        '<p class="ag-small" id="agd-spread">' + (spread !== null ? 'Give or take ' + spread + ' ms' : '') +
        (isNum(d.misses) && d.misses > 0 ? (spread !== null ? '. ' : '') + d.misses + ' press' +
          (d.misses === 1 ? '' : 'es') + ' not seen' : '') + '</p>' +
