    return { html:'', after: function(root){
      var ns = root.dataset.ns || (p.id + '/psnlink');
      psnCss();

      function build(){
        var lead = helpHTML('psn-what', 'Adding an account', 'Adding an account is <b>two things</b>: telling this adapter which '+
                        'PlayStation account you are, then letting your PS5 hand it the key that '+
                        'lets it connect. Your password goes <b>to Sony and nowhere else</b> — '+
                        'this app never sees it and never asks for it.');
