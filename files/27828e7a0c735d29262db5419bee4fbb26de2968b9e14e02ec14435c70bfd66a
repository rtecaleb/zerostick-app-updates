/* sections/07-remote-play.js — which PlayStation account a config plays as, and adding one.
 *
 * The Remote Play account seam (rpApi probes the board's /ps5 or /psn route
 * family once; rpAccountsFetch, rpPairs, rpAcctPaint on Overview,
 * openRpAccountSheet) and the "Add a PlayStation account" screen (R.psnlink).
 * An A7S (EXO) feature: a Core cannot stream Remote Play yet. Its setup
 * steps (sign-in, account ID, PS5 code) are 07a-remote-play-setup.js (D286).
 *
 * Screens (window.RENDERERS):  R.psnlink
 * Core / board routes:        /account, /login-url, /register
 * Tests:                      test-psn-account.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('remote-play', function (SEC) {
  var helpHTML = SEC.helpHTML;   /* D285: every explanation behind a "?" (2026-10-31) */
  /* from the files before this one */
  var acc = SEC.acc, btn = SEC.btn, btnP = SEC.btnP, card = SEC.card, esc = SEC.esc,
      note = SEC.note, R = SEC.R, sh = SEC.sh, ZS = SEC.ZS;

  /* ── Remote Play: WHICH PlayStation account this config plays as ──────
     WHY THIS ROW EXISTS, precisely. The board's Remote Play backend picked
     the PSN account with `next(iter(profile))` and the console with
     `next(iter(hosts))` — whichever pair Python's dict order happened to hand
     it. The pyremoteplay profile file has ALWAYS been able to hold several
     accounts and several consoles per account, so a second account was not
     merely unsupported: it was silently unreachable, and which PSN user the
     board signed in as rode a JSON key order nobody controls. Connecting as
     the wrong PSN user is a failure you discover from inside somebody else's
     save file, so this row states the answer in words instead of implying it.

     THE CHOICE IS PER-CONFIG (output.remotePlay.account / .mac) because that
     is exactly what was asked for — "in remote play you should let people
     have two profiles for two different accounts". The ZeroStick config
     carries it, so switching config on HOME switches PSN user, with no second
     place to remember and nothing global to get out of step.

     NO CLUTTER WHEN THERE IS ONE ACCOUNT, and that is a rule here rather than
     a preference. With a single pairing linked, this is ONE line inside the
     card that already existed, it names the account and the console it plays
     on, and it hedges nothing: "the first one" and "the only one" are the same
     fact and only one of them is worth saying. The list of choices exists only
     inside the sheet, behind a tap. The net change to the screen is minus two
     buttons and minus one note, plus this row — it is smaller than it was.

     A PAIRING IS WHAT YOU PICK, NOT AN ACCOUNT. There were TWO next(iter())s.
     One PSN user with two consoles registered is two choices; offering only
     the user would leave the console lottery running and the feature would
     look finished while still being a coin toss. */

  /* WHICH ROUTE FAMILY THE BOARD SPEAKS — probed once, never assumed.
     The agent half of this feature is being written in parallel, and the two
     surveys that preceded it named two different homes for it: `/ps5/accounts`
     beside the POST /ps5/enabled that already exists, and `/psn/accounts`
     beside the dashboard's PSN wizard. Rather than guess and ship a screen
     that is dead against half the boards it could meet, the app asks the
     first, falls back to the second, and remembers which one answered.
     A board with NEITHER — which is every board today — answers both with
     {"ok":false,"error":"unknown route: …"}, and that is a third real state
     the screen renders as a sentence rather than as a spinner that never
     stops. */
  var RP_PREFIXES = ['/ps5', '/psn'];
  var RP_FAM   = null;    /* null = never probed · '' = no PSN routes at all */
  var RP_ACCTS = null;    /* the board's list, or null when it could not answer */
  var RP_AT    = 0;       /* when the answer above was learned — either way */
  var RP_KNOWN = false;   /* has ANY answer been learned yet? */
  /* The board's own finished sentence for "there is nothing to list" — a
     brand-new adapter with no pairing file is the ordinary state, not an
     error, and the agent already words it. Rendering the board's sentence
     rather than a second copy of the same idea is what stops the two drifting
     apart; the app's own wording is the fallback for an older agent that
     sends none. */
  var RP_PROBLEM = '';
  /* WHY THE LISTING FAILED, when it failed for a reason that is NOT "there is
     no such route". These are two different facts and the screen used to state
     the wrong one for both: any board whose GET <fam>/accounts answered
     {ok:false} — a pairing file it could not read, a momentary 500, a token
     the proxy refused — landed RP_FAM at '' and was told "your adapter's
     software cannot add accounts yet", with the whole form taken away and no
     way to ask again. That is a claim about the SOFTWARE made from evidence
     that only shows one call failed, on a board that may well add accounts
     perfectly. Capped, because it is a board string on its way into markup. */
  var RP_LAST_ERR = '';
  /* Clears the LIST, never the route family. The two answer different
     questions — "is this list current?" and "does this board speak PSN at
     all?" — and only the first goes stale when an account is added. */
  function rpAccountsInvalidate(){ RP_ACCTS = null; RP_AT = 0; RP_KNOWN = false; RP_PROBLEM = ''; }
  /* Every other PSN call rides the prefix the probe found. Callers only run
     from inside a screen that has already awaited rpAccountsFetch, so RP_FAM
     is decided by the time this is reached; the guard is for the board that
     answered nothing, where the honest result is a refusal and not a 404. */
  function rpApi(path, method, body){
    if(!RP_FAM) return Promise.resolve({ ok:false,
      error:'your board’s software has no PlayStation account routes yet' });
    return ZS.api(RP_FAM + path, method, body);
  }
  /* A BOARD CAN LIST ACCOUNTS AND STILL NOT BE ABLE TO ADD ONE, and on the
     day this shipped that was the exact state of the agent: GET /ps5/accounts
     existed, the sign-in and pairing routes did not. There is no cheap way to
     ask in advance — a GET cannot prove a POST route exists — so the Add
     screen finds out the first time it tries and then SAYS so, once, instead
     of leaving a form that answers "unknown route" to every press. Matches the
     agent's two shapes: the router's 404 ("unknown route: POST /ps5/account")
     and a handler's own 501 ("this board's agent cannot … yet — update it").

     ONE LATCH PER ROUTE, NOT ONE FOR THE SCREEN. This was a single boolean,
     and any route answering "unknown route" replaced the WHOLE screen with
     "your adapter cannot add accounts yet" — including the account the user
     had just successfully added one step earlier. The agent half is being
     written by another fleet right now and will arrive a route at a time, so
     a board that can add an account but not yet pair a console is not a
     hypothetical, it is the next state this screen will meet. Each half now
     says its own honest sentence and leaves the halves that work alone.
       account  POST <fam>/account   — add an account (the login-free path)
       link     GET  <fam>/login-url + POST <fam>/link — the sign-in fallback
       register POST <fam>/register  — exchange the 8-digit PIN with the PS5 */
  var RP_MISSING = { account:false, link:false, register:false };
  /* MATCH THE TWO SHAPES THAT MEAN "THIS ROUTE IS NOT HERE", AND NOTHING ELSE.
     The bare /cannot .* yet/ this used to carry was too wide by one sentence,
     and the sentence it swallowed matters: outputs/psn_link.OLD_HELPER says
     "This adapter's PlayStation helper is older than its software and cannot
     do this yet — update the adapter, then try again." That is a DEPLOY that
     got half-finished, not a feature that was never written, and it names the
     cure. Matching it threw that away and replaced it with "still being built
     — use the ZeroStick dashboard on a PC", which would fail in exactly the
     same way, because the PC wizard drives the very same helper.
       unknown route: …                     the router's 404
       this board's agent cannot … yet      api/server.py _NO_PSN, a 501
     Anything else is a board with an opinion, and its own words are shown. A
     future 501 worded differently misses this and shows the board's sentence
     verbatim — the safe way round to be wrong. */
  function rpMissing(j){
    return !!(j && j.ok === false &&
      /unknown route|not implemented|agent cannot .* yet/i.test(String(j.error || '')));
  }
  /* WHERE THE REDIRECT URL GOES, probed the same way the prefix is. The agent
     takes it at POST <fam>/link, and ALSO at POST <fam>/account, which
     forwards any body carrying `redirectUrl` to the same handler. Both are
     live in the same build, so this is belt over braces rather than a guess —
     but it costs one variable and one retry, and it is what makes the screen
     survive the two routes being split again later. */
  var RP_LINK_PATH = null;
  function rpAccountsFetch(cb){
    /* 60 s on a good answer is a courtesy, not a freshness policy: the list
       changes only when somebody finishes the Add screen, and that screen
       invalidates this cache itself. 20 s on a bad one stops a board that
       cannot answer being asked twice on every redraw — and redrawOpenScreen()
       fires whenever the connected pad changes family, which is an ordinary
       thing to do while setting this up. */
    var ttl = RP_ACCTS ? 60000 : 20000;
    if(RP_KNOWN && (Date.now() - RP_AT) < ttl){ cb(RP_ACCTS); return; }
    if(ZS.live.online === false){ cb(null); return; }
    var tries = RP_FAM ? [RP_FAM] : RP_PREFIXES.slice();
    var i = 0;
    RP_LAST_ERR = '';
    function land(pre, list, problem){
      RP_FAM = pre; RP_ACCTS = list; RP_AT = Date.now(); RP_KNOWN = true;
      RP_PROBLEM = rpCap(problem, 200).replace(/\s*[.。]\s*$/, '');
      cb(list);
    }
    function next(){
      if(i >= tries.length){ land(RP_FAM || '', null, ''); return; }
      var pre = tries[i++];
      ZS.api(pre + '/accounts').then(function(j){
        var d = (j && j.ok && j.data) || null;
        if(d && isArr(d.accounts)){ land(pre, d.accounts, d.problem); return; }
        /* A ROUTE THAT IS NOT THERE AND A ROUTE THAT FAILED ARE NOT THE SAME
           ANSWER. Only the first justifies "your adapter's software cannot do
           this yet"; the second is a board that could not answer this call,
           and saying so leaves the user a retry instead of a dead end. */
        if(j && j.ok === false && !rpMissing(j)) RP_LAST_ERR = rpCap(j.error, 200);
        next();
      });
    }
    next();
  }
  function isArr(v){ return Object.prototype.toString.call(v) === '[object Array]'; }

  /* `mac` is the seam's name for the console handle; `host` was the other
     proposal on the table while this was being designed. READ both so a config
     written by either half still resolves to the same console; WRITE only
     `mac`, so nothing this app saves can be ambiguous later. */
  function rpChoiceOf(full){
    var rp = ((full && full.output) || {}).remotePlay || {};
    return { account: String(rp.account || ''),
             mac:     String(rp.mac || rp.host || '') };
  }
  /* Flatten accounts × consoles into the pairs the board can actually connect
     with. An account with no console linked yet is still listed — it is a real
     half-finished state, and hiding it would make the Add screen's own result
     invisible between step one and step two. */
  /* THE SAME FOLD THE BOARD USES, and it has to be, or the two halves
     disagree about the same document. outputs/rp_profile.canonical_mac()
     strips ":-. _", upper-cases and truncates, and BOTH sides of every
     comparison over there go through it; profiles/schema.py's validate()
     folds the same way before bounding, and its comment says out loud that a
     hand-edited "28:40:DD:3D:7E:DC" is a legal value. This function existed
     only on the board, so the app compared the raw strings: a config the
     agent resolves perfectly to "Second_Acct on Front room" was shown here as
     "not linked to this adapter any more", with no tick in the picker — the
     app reporting a lottery the board was not running. Folding costs one
     regex and removes a whole class of "the app and the board disagree". */
  function rpFoldMac(v){
    return String(v == null ? '' : v).replace(/[:\-. _]/g, '').toUpperCase().slice(0, 48);
  }
  /* THE SAME 64 THE BOARD USES — rp_profile.RP_ACCOUNT_MAX_CHARS, and psn.py's
     PSN_NAME_MAX_CHARS beside it. Every string this screen takes from a board
     reply goes on to be markup, a toast, a screen-reader announcement and the
     `account` a config stores, and only the last of those is bounded by
     anything (profiles/schema.py). Bounding it here too costs one slice and
     means an agent that ever answers something absurd cannot turn one reply
     into a paragraph-long sentence — the 7357-character refusal a review
     measured on the board side is the same failure from the other end. */
  function rpCap(v, n){ return String(v == null ? '' : v).slice(0, n || 64); }
  function rpPairs(list){
    var out = [], i, k, a, hs;
    for(i = 0; i < (list || []).length; i++){
      a = list[i] || {};
      hs = a.consoles || [];
      if(!hs.length){ out.push({ acct:String(a.username || ''), mac:'', nick:'' }); continue; }
      for(k = 0; k < hs.length; k++){
        out.push({ acct: String(a.username || ''),
                   /* folded on the way IN, so the value the picker writes back
                      to the config is already in the pairing file's own form */
                   mac:  rpFoldMac(hs[k].mac || hs[k].id || ''),
                   nick: String(hs[k].nickname || hs[k].type || 'PS5') });
      }
    }
    return out;
  }
  /* -1 means "this config's choice is not on this board" — either it never
     chose, or what it chose is not here. Those are NOT the same state and
     they no longer share a sentence: an empty choice means the board falls
     back to whatever is first, and a choice that misses means the board
     REFUSES (rp_profile.keys_for raises, the backend re-raises it as
     BackendUnavailable, and engine._select_backend lands on `null` — the
     controller goes silent). rpWhy() below names which one this is. */
  function rpMatch(pairs, sel){
    var i, mac = rpFoldMac(sel.mac);
    if(!sel.account) return -1;
    for(i = 0; i < pairs.length; i++){
      if(pairs[i].acct === sel.account && (!mac || pairs[i].mac === mac)) return i;
    }
    return -1;
  }
  /* Is the ACCOUNT here at all, whatever console it names? The two misses read
     identically on screen before this and only one of them was ever true. */
  function rpHasAccount(pairs, account){
    var i;
    for(i = 0; i < pairs.length; i++) if(pairs[i].acct === account) return true;
    return false;
  }
  function rpSubEm(t){
    return '<em style="display:block;font-weight:400;font-style:normal;color:var(--muted);'+
           'font-size:11.5px;white-space:normal;line-height:1.4">'+esc(t)+'</em>';
  }
  /* ONE row, three states, zero new cards and zero new headers. `none` is the
     "nothing linked / cannot be named" face: amber, the app's colour for
     "not set up", never red — red is spent on the kill switch and stays spent
     (docs/DESIGN.md). The words say it too, so the hue is a second channel. */
  function rpRowHTML(body, sub, none){
    return '<div class="lrow tapper'+(none ? ' none' : '')+'" id="rp-acct" role="button" '+
      'tabindex="0" aria-label="'+esc('Play as '+body+'. '+sub+'. Tap to change which '+
      'PlayStation account this config uses.')+'">'+
      '<span class="src">Play as <b>'+esc(body)+'</b>'+rpSubEm(sub)+'</span>'+
      '<span class="rt"><span class="arrow">›</span></span></div>';
  }

  function rpAcctPaint(root, p, full, ns){
    var host = root.querySelector('#ov-rpacct');
    if(!host) return;
    function alive(){ return root.dataset.ns === ns; }
    if(ZS.live.online === false){
      /* The accounts live on the board. Offline there is nothing to name and
         nothing a tap could change — say that, rather than draw a dead row
         that opens a sheet with nothing in it. */
      host.innerHTML = '<div class="stat"><span>Play as</span><b>— board offline</b></div>';
      return;
    }
    host.innerHTML = '<div class="stat"><span>Play as</span><b>asking your board…</b></div>';
    rpAccountsFetch(function(list){
      if(!alive()) return;
      var pairs = rpPairs(list), sel = rpChoiceOf(full), at = rpMatch(pairs, sel);
      var body, sub, none = false;
      if(list === null){
        none = true;
        body = 'whichever account is first on your board';
        sub  = 'your board’s software cannot name it yet — tap to see how to add an account';
      } else if(!pairs.length){
        none = true;
        body = 'nobody yet';
        /* The board's own sentence when it sent one — it knows WHY the list is
           empty (no pairing file, an unreadable one) and the app does not. */
        sub  = (RP_PROBLEM || 'no PlayStation account is linked to this adapter')+
               ' — tap to link one';
      } else if(at >= 0){
        body = pairs[at].acct;
        sub  = pairs[at].nick ? 'on “'+pairs[at].nick+'”' : 'no console linked to it yet';
      } else if(sel.account){
        /* THE CONFIG NAMES SOMETHING THIS BOARD DOES NOT HAVE, and this row
           used to answer it with "using this one instead" over the name of a
           DIFFERENT PSN account, in plain ink. That was the one sentence in
           this feature that had to be true and it was the opposite of true:
           rp_profile.keys_for() refuses by name rather than substituting,
           remoteplay_backend re-raises the refusal as BackendUnavailable, and
           engine._select_backend catches it and lands on the `null` backend —
           so the board does not play as somebody else, it stops sending
           anything at all. Telling the player "we quietly swapped in another
           account" is exactly the silent-wrong-account behaviour this whole
           change exists to delete, and printing it while the controller is
           dead sends them looking in the wrong place.

           So: name the account THE CONFIG asks for, say the board will not
           connect, and wear the amber "not set up" face — this is a broken
           config, not a hedge. */
        none = true;
        body = sel.account;
        sub  = (rpHasAccount(pairs, sel.account)
                 ? 'the console this config names is not paired to “'+sel.account+'” any more'
                 : '“'+sel.account+'” is not linked to this adapter')+
               ' — your board will not connect until you pick one below';
      } else if(pairs.length === 1){
        /* THE ONE-ACCOUNT CASE, and the reason there is no hedge in it. With a
           single pairing on the board, "the first one" and "the only one" are
           the same account; saying "nothing chosen, falling back" would be
           true, useless, and exactly the clutter this row was asked not to
           add. It names the account and the console and stops. */
        body = pairs[0].acct;
        sub  = pairs[0].nick ? 'on “'+pairs[0].nick+'”' : 'no console linked to it yet';
      } else if(list.length === 1){
        /* ONE account, SEVERAL consoles registered to it. The account is not
           in doubt; the console is — and that was the second next(iter()), so
           the hedge has to name the right half or it points at the wrong
           lottery. Counting `list` (accounts) rather than `pairs` (account ×
           console) is what keeps these two sentences honest. */
        body = pairs[0].acct;
        sub  = 'no console chosen — your board falls back to “'+pairs[0].nick+'”, one of the '+
               pairs.length+' linked to this account';
      } else {
        /* The row used to assert "Play as Assault_cK" in bold and then say
           "nothing chosen" underneath it — one row contradicting itself in
           two lines. Both halves were true; only the first one sounded like
           a decision. Name the account the board WILL use and say that is
           what it is. */
        body = pairs[0].acct;
        sub  = 'not picked yet — your board will use this one, the first of '+
               list.length+' it holds';
      }
      /* THE BOARD'S OWN ANSWER OUTRANKS THE CONFIG'S TEXT, for the config that
         is actually running. Written as "if the field is present" rather than
         "if it differs from what I expect", so it stays inert until the Remote
         Play backend starts publishing `account` in its stats — and is correct
         the day it does, with no second request and no version check. */
      var bst = ((ZS.live.status || {}).outputBackend || {}).stats || {};
      if(bst.account && p.id === ZS.activeId && String(bst.account) !== body)
        sub += ' — but your board is connected as “'+bst.account+'” right now';

      host.innerHTML = rpRowHTML(body, sub, none);
      var r = host.querySelector('#rp-acct');
      if(!r) return;
      function go(){ openRpAccountSheet(p, pairs, at, list, sel); }
      r.addEventListener('click', go);
      r.addEventListener('keydown', function(e){
        if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); go(); }
      });
    });
  }

  /* ── the picker ────────────────────────────────────────────────────
     radiogroup/radio, not a row of buttons: this is one choice out of N and
     the accessibility tree should say so. The tick is ALSO a word — "chosen" —
     because a check glyph in the accent is a colour signal, and DESIGN.md does
     not allow that to be the only one. */
  function openRpAccountSheet(p, pairs, at, list, sel){
    sel = sel || { account:'', mac:'' };
    var body = note('Which <b>PlayStation account</b> this config signs in as. Every ZeroStick '+
                    'config remembers its own, so switching config on the home screen switches '+
                    'PSN user.');
    var rows = '', i, q;
    if(list === null){
      body += note('Your board did not answer with a list of accounts, so there is nothing to '+
                   'choose from here yet. It still plays as whichever account happens to be '+
                   'first in its own file — which is exactly the guesswork this screen exists '+
                   'to end.','warn');
    } else if(!pairs.length){
      body += note((RP_PROBLEM ? esc(RP_PROBLEM)+'. ' : '')+
                   'No PlayStation account is linked to this adapter yet, so there is nothing '+
                   'to choose from. Add one below and this list fills in.','warn');
    } else {
      for(i = 0; i < pairs.length; i++){
        q = pairs[i];
        rows += '<div class="lrow tapper" data-rpi="'+i+'" role="radio" tabindex="0" '+
          'aria-checked="'+(i === at ? 'true' : 'false')+'" '+
          'aria-label="'+esc('Play as '+q.acct+(q.nick ? ' on '+q.nick : ''))+'">'+
          '<span class="src">'+esc(q.acct)+
            rpSubEm(q.nick ? 'on “'+q.nick+'”' : 'no console linked to it yet')+'</span>'+
          '<span class="rt">'+(i === at ? '<b class="ok">✓ chosen</b>' : '')+'</span></div>';
      }
      body += '<div class="grp-card" role="radiogroup" aria-label="PlayStation account">'+rows+'</div>';
      /* Only worth saying when there is a real alternative. On a board with one
         pairing the fallback IS the choice, and printing a warning about it
         would be noise about nothing. */
      /* TWO DIFFERENT MISSES, and only one of them is a fallback. An empty
         choice really does land on "whichever is first in the file". A choice
         that names something the board does not hold does NOT — keys_for()
         raises, the backend re-raises, and the engine drops to the null
         backend — so telling somebody their board "falls back to the first
         one" here would send them off to play on a controller that is sending
         nothing. Said whatever the count is, because a board with a single
         pairing and a config naming a third account is just as broken. */
      if(at < 0 && sel.account)
        body += note('This config asks for <b>'+esc(sel.account)+'</b>'+
                     (sel.mac ? ' on <b>'+esc(rpFoldMac(sel.mac))+'</b>' : '')+
                     ', which this adapter does not have. Your board will not connect until '+
                     'you pick one of these.','warn');
      else if(at < 0 && pairs.length > 1)
        body += note('None of these is chosen on this config, so your board falls back to the '+
                     'first one in its own file. Tap one to make it a decision.');
    }
    body += btnP('plus','Add another PlayStation account','primary','rp-add');
    /* THE PROMISE, on the screen where somebody might expect to be asked.
       There is no password field anywhere in this flow and there must never
       be one — see R.psnlink. */
    body += note('Signing in happens <b>at Sony, in your own browser</b>. ZeroStick never sees '+
                 'your password and will never ask you for one.');
    if(pairs.length > 1)
      body += note('Changing this while the config is <b>live</b> drops the Remote Play session '+
                   'and reconnects as the new account — a second or two of nothing.');

    var sb = ZS.sheetOpen('Play as', body, null);

    sb.querySelectorAll('[data-rpi]').forEach(function(r){
      function pick(){
        var q = pairs[parseInt(r.getAttribute('data-rpi'), 10)];
        if(!q) return;
        if(ZS.live.online === false || !ZS.live.full[p.id]){
          ZS.toast('Your board is offline — this has not reached it yet');
          return;
        }
        /* Land any debounced edit of THIS config first: the board is about to
           be handed the same document, and a queued write that cloned the
           profile before this one would put the old account straight back
           (cpPicker's reasoning, same hazard, same channel). */
        ZS.flushProfileWrites(p.id).then(function(){
          return ZS.putProfile(p.id, function(f){
            if(!f.output) f.output = {};
            /* BOTH halves, always. Writing the account alone would leave the
               console lottery running — that was the second next(iter()). */
            f.output.remotePlay = { account: q.acct, mac: q.mac };
          });
        }).then(function(j){
          if(!(j && j.ok)) return;    /* putProfile already toasted the refusal */
          ZS.sheetClose();
          ZS.announce('This config now plays as ' + q.acct);
          ZS.toast('Playing as ' + q.acct + (q.nick ? ' on “' + q.nick + '”' : ''));
          ZS.redrawOpenScreen();
        });
      }
      r.addEventListener('click', pick);
      r.addEventListener('keydown', function(e){
        if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); pick(); }
      });
    });
