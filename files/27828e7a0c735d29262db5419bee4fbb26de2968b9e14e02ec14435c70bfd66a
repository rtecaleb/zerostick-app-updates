  /* ── Add a PlayStation account ─────────────────────────────────────
     THE APP'S JOB HERE IS TO EXPLAIN, NOT TO AUTHENTICATE, and the honest
     limit is worth writing down in the file: Sony's login is a web page in the
     user's OWN browser. The board only ever sees the address that page lands
     on, reads the one-time code out of it, exchanges it for an 8-byte account
     id and throws the rest away.

     THERE IS NO PASSWORD FIELD ON THIS SCREEN AND THERE MUST NEVER BE ONE. If
     a future revision appears to need one, the revision is wrong. tools/
     test-psn-account.js asserts it by scanning the rendered markup, so this is
     a promise the build keeps rather than one a reviewer has to remember.

     THE LOGIN-FREE PATH LEADS, and that is a protocol fact rather than a
     shortcut. pyremoteplay's RPDevice.register() reads exactly ONE field out
     of an account record — `profile.id`, the 8-byte base64 account id — and
     libchiaki's ChiakiRegistInfo agrees (psn_account_id[8] + pin; the online
     id "may be null"). The whole PSN sign-in exists to LEARN those 8 bytes.
     Anyone who already has them can add an account without signing in at all,
     so that is the first field on the screen and the browser login is folded
     into an accordion behind it for people who do not know their id.

     WHAT THE USER STILL HAS TO DO BY HAND, and it cannot be automated away:
     read the 8-digit Link Device code off their own TV and type it in before
     it expires. The RegistKey and RP-Key that make Remote Play work exist
     nowhere until that code is exchanged with the console.

     THE BOARD'S OWN LIST IS THE RECEIPT. Every step here ends by throwing the
     cached listing away and re-reading GET <fam>/accounts, and the "What this
     adapter holds" card at the foot of the screen renders THAT — not what
     this screen believes happened. A POST answering {ok:true} is a claim; the
     listing is the adapter agreeing with it, and the two can differ (a write
     that did not reach the pairing file, a second account added from the PC
     wizard meanwhile). When they differ the screen says so rather than
     reporting success over a board that holds nothing. It is also where the
     console's MAC comes from: the register reply carries one too, but what the
     CONSOLE said and what the adapter's pairing file now holds are different
     facts, and the file is what the backend reads — so the listing's MAC is
     preferred and the console's is the fallback for a board that will not
     list. Before the read-back, step three could only ever write a half-choice.

     THE PIN IS A KEYPAD, NOT A TEXT BOX, and that is the accessibility
     premise of the whole product rather than a flourish. Eight digits typed
     against a countdown, one-handed, is precisely where a 16px text field and
     a popped-up OS keyboard hurt: the keyboard covers the instructions, the
     keys are 7 mm, and a mis-tap costs the code. The pad is twelve 64 px
     targets that never move, the value lives in module state so a repaint
     cannot eat a half-typed code, and the digits stay on screen above it.

     PSN IS MODULE-LEVEL STATE, the same reason P_ORDER is: devbar.js calls
     ZS.redrawOpenScreen() whenever the connected pad changes family, which
     re-enters this renderer — a closure would wipe a half-typed PIN, and
     plugging in the pad you are setting this up for is an ordinary thing to
     do mid-flow. */
  var PSN = null;
  var PSN_CSS_ID = 'zs-psnpad-css';
  function psnCss(){
    if(document.getElementById(PSN_CSS_ID)) return;
    var s = document.createElement('style');
    s.id = PSN_CSS_ID;
    s.appendChild(document.createTextNode(
      /* THE DISPLAY. Eight slots, always eight, so the code's length is a
         SHAPE you can see filling rather than a number you have to count —
         and an empty slot differs from a filled one by having a character in
         it, not only by its border colour (docs/DESIGN.md: never signal with
         colour alone). tabular-nums so a digit landing never reflows the row. */
      '.pindisp{display:grid;grid-template-columns:repeat(8,1fr);gap:4px}'+
      '.pslot{height:46px;display:flex;align-items:center;justify-content:center;'+
        'font-size:19px;font-weight:600;font-variant-numeric:tabular-nums;'+
        'background:var(--bg);border:1px solid var(--line);border-radius:var(--r-chip);'+
        'color:var(--text);min-width:0}'+
      '.pslot.on{border-color:var(--accent);color:var(--accent)}'+
      /* THE PAD. 64px is well over the 44px touch floor because this is the
         one control on the product that is used against a clock by somebody
         whose hands do not do small: --btn-min is the floor, not the target. */
      '.pinpad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}'+
      '.pinpad button{min-height:64px;font-size:26px;font-weight:600;'+
        'font-variant-numeric:tabular-nums;background:var(--btn-2-bg);'+
        'color:var(--btn-2-ink);border:1px solid var(--line);border-radius:var(--r-ctl);'+
        'box-shadow:var(--btn-wall),var(--btn-lit);touch-action:manipulation;'+
        '-webkit-tap-highlight-color:transparent}'+
      '.pinpad button.wide{font-size:15px;color:var(--muted);letter-spacing:.02em}'+
      /* Feedback on pointer-DOWN. .zs-pressing is zs-motion's class and wins
         where it is attached; :active is the floor for everywhere else. */
      '.pinpad button:active,.pinpad button.zs-pressing{transform:translateY(2px);'+
        'box-shadow:var(--btn-sunk)}'+
      '@media (prefers-reduced-motion:reduce){.pinpad button:active,'+
        '.pinpad button.zs-pressing{transform:none;box-shadow:var(--btn-sunk)}}'+
      'body.a11y-big .pinpad button{min-height:76px;font-size:29px}'+
      'body.a11y-big .pslot{height:54px;font-size:21px}'));
    (document.head || document.documentElement).appendChild(s);
  }

  R.psnlink = function(p){
    /* WHAT IS IN HERE AND WHY EACH OF IT IS, because a field added carelessly
       here is a half-typed thing thrown away.

       nm / aid / redir  — THE TYPED FIELDS, for exactly the reason `pin` is.
         Every press in this flow ends in draw(), which rebuilds the markup,
         and these inputs carry data-nosave="1" so ZS.wire deliberately neither
         saves nor restores them (an account ID has no business in
         localStorage). The consequence was that the ONE refusal a user is
         likeliest to hit — "give this account a name" — wiped the 19-digit ID
         they had just pasted, and devbar's redrawOpenScreen() wiped whatever
         was half-typed when the pad they are setting this up for was plugged
         in. Worst of the three is `redir`: the redirect URL carries a
         single-use `code=`, so losing it means a fresh trip to Sony's sign-in
         page. They live here, in memory, and are cleared the moment they are
         spent.
       nick    — what the CONSOLE said it linked. Only the register reply
                 writes it.
       listNick / mac — what the ADAPTER'S OWN LIST says. Both are re-derived
                 from scratch on every read-back and never carried forward:
                 keeping a stale `mac` is how the screen went on asserting
                 "your adapter's own list shows that pair" over a read-back
                 that showed the account gone. */
    var st = PSN || (PSN = { acct:'', nick:'', listNick:'', mac:'', url:'', pin:'',
                             nm:'', aid:'', redir:'',
                             m1:'', m1bad:false, m2:'', m2bad:false,
                             accOpen:false, replyMac:'', pairs:null, checking:false,
                             said:'' });

    /* The three things a PS5 asks of the person standing in front of it. Kept
       as one function because both the working screen and the "your board
       cannot do this yet" screen have to say exactly the same words — a user
       who follows the manual route on a PC must not be given different
       instructions from the one who does it here. */
    function ps5Steps(){
      return note('On your PS5: <b>Settings › System › Remote Play › Link Device</b>.')+
             helpHTML('psn-console', 'On your PS5', 'On your PS5: <b>Settings › System › Remote Play › Link Device</b>. An '+
                  '<b>8-digit code</b> appears on the TV. It expires after a few minutes, so '+
                  'use it soon. The PS5 must be <b>on</b> and on the same network as your '+
                  'adapter.')+
             /* HONEST ABOUT WHAT WE HAVE NOT TESTED. Whether a PS5 will show a
                Link Device code for an account that is not the one signed in
                on the console is console behaviour, not code, and it was never
                confirmed. Saying "we believe" costs one word and stops the
                screen asserting something it does not know. */
             note('We believe the PS5 only offers a code for the account that is <b>signed in on '+
                  'the console</b>. If no code appears, switch users on the PS5 first.','warn');
    }
    function msg(t, bad){ return t ? note(esc(t), bad ? 'warn' : null) : ''; }

    /* ── the PIN pad ────────────────────────────────────────────────
       The value is `st.pin`. `#psn-pin` is a hidden mirror of it, so val()
       reads one place whatever put the digits there and a repaint restores
       what was typed. Digits only, capped at 8 by construction — a keypad
       cannot paste, and the container's keydown filter is the only other way
       in. */
    function pinSlots(v){
      var s = '', i;
      for(i = 0; i < 8; i++)
        s += '<span class="pslot'+(i < v.length ? ' on' : '')+'">'+
             (i < v.length ? esc(v.charAt(i)) : '')+'</span>';
      return s;
    }
    function pinSays(v){
      return v.length ? v.length+' of 8 digits entered: '+v.split('').join(' ')
                      : 'no digits entered yet, 8 needed';
    }
    function pinKey(k, lab, aria, wide){
      return '<button type="button" data-k="'+esc(k)+'"'+(wide ? ' class="wide"' : '')+
             ' aria-label="'+esc(aria)+'">'+esc(lab)+'</button>';
    }
    function pinPadHTML(){
      var v = st.pin, h = '', i;
      h += '<div class="grp-card">'+
             '<div class="flab">The 8-digit code on your TV</div>'+
             /* role="img" + a written label, so a screen reader gets the whole
                code as one sentence instead of eight unlabelled boxes. */
             '<div class="pindisp" id="psn-disp" role="img" style="margin-top:10px" '+
               'aria-label="'+esc(pinSays(v))+'">'+pinSlots(v)+'</div>'+
             '<div class="visually-hidden" id="psn-count" aria-live="polite" role="status">'+
