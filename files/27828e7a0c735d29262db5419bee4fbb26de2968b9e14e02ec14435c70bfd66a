    }

    /* ── the receipt ───────────────────────────────────────────────
       The adapter's own answer, drawn from RP_ACCTS and nothing else. This is
       the difference between "we told you it worked" and "here it is". */
    function heldHTML(){
      var h = sh('What this adapter holds'), i, q, isNew;
      if(st.checking) return h + card('<div class="stat"><span>Reading it back</span><b>asking…</b></div>');
      if(st.pairs === null)
        /* SAY WHY WHEN THE BOARD SAID WHY. "did not answer" and "could not
           read the pairing file" are different problems with different cures,
           and the board words the second one itself. */
        return h + note('Your adapter did not answer with a list'+
                        (RP_LAST_ERR ? ' (“'+esc(RP_LAST_ERR)+'”)' : '')+
                        ', so this screen cannot show you what it holds. Nothing above is '+
                        'confirmed by the adapter itself.','warn')+
                   btn('Check again', null, 'psn-recheck');
