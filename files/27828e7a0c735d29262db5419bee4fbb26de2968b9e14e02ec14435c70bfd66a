                     (st.url
                       ? card('<div class="fld col"><div class="flab">If the page did not open, copy '+
                              'this link</div><input class="txt" id="psn-url" data-nosave="1" readonly '+
                              'style="margin-top:10px" value="'+esc(st.url)+'"></div>')+
