                    that is not only "the quick way is gone". Every press in
                    this flow ends in draw(), which rebuilds the markup — so an
                    accordion the user opened by hand SNAPS SHUT on the next
                    redraw and takes the copyable sign-in link, the paste box
                    and any refusal message down with it. st.accOpen remembers
                    that they opened it; the two RP_MISSING flags force it for
                    a message they never asked to see. */
                 st.accOpen || RP_MISSING.account || RP_MISSING.link || !!st.url,
                 null, false);
        }
        h += msg(st.m1, st.m1bad);

        h += sh('2 · Link your PS5 to it');
        if(!st.acct){
          h += note('Finish step 1 first — a console is linked to an <i>account</i>, so there '+
                    'has to be an account for it to link to.');
        } else if(st.nick || st.mac){
          /* TWO SENTENCES, AND ONLY THE CONFIRMED ONE MAY ASSERT. This branch
             used to say "that is the pair this adapter can connect with"
             unconditionally, directly above a read-back saying the adapter's
             own list showed no such console — the screen contradicting itself
             in consecutive paragraphs, with the reassuring half first. What
             the console replied and what the adapter holds are different
             facts; the claim is only made when they agree.

             AND THE CONFIRMATION HAS TO BE THE CURRENT ONE. st.mac was set by
             a read-back and never cleared by a later one, so pressing "Check
             again" after the adapter lost the pairing left this paragraph
             still saying "your adapter's own list shows that pair" over a
             receipt card listing no such account — and with step three's
             button correctly withheld, so the screen asserted a working pair
             and refused to use it in the same breath. reread() now re-derives
             mac and listNick from scratch every time, so this sentence can
             only survive as long as the list does. */
          h += st.mac
            ? note('Linked to <b>'+esc(st.listNick || st.nick)+'</b>, and your adapter’s own '+
                   'list shows that pair. That is what it can connect with.')
            : note('Your PS5 says it linked <b>'+esc(st.nick)+'</b>.');
        } else if(RP_MISSING.register){
          h += note('<b>This adapter cannot exchange the pairing code yet</b> — that part of its '+
                    'software is still being built, so there is no point typing the code in '+
                    'here. The account above is saved and will be waiting.','warn')+
               note('Use the <b>ZeroStick dashboard on a PC</b> to do the 8-digit pairing, then '+
                    'come back and pick the account on any config.')+
               sh('The console half, either way')+
               ps5Steps();
        } else {
          h += ps5Steps()+
               pinPadHTML()+
               btn('Link this PS5','primary','psn-link');
        }
        h += msg(st.m2, st.m2bad);

        /* STEP THREE IS A LOADED GUN WHEN THE ACCOUNT IS NOT REALLY THERE.
           A config naming an account the adapter does not hold does not fall
           back to another one: rp_profile.keys_for() raises, the backend
           re-raises, and the engine drops to the null backend — the pad goes
           SILENT. So the button is only offered when the adapter's own list
           agrees the account exists, or when there is no list to disagree
           with; the third case gets the sentence instead. */
        if(st.acct && (st.nick || st.mac)){
          var known = st.pairs === null || rpHasAccount(st.pairs, st.acct);
          h += sh('3 · Use it here');
          if(known){
            h += btn('Play “'+((p && p.name) || 'this config')+'” as '+st.acct,'primary','psn-use')+
                 note('This changes <b>this config only</b>. Your other configs keep the account '+
                      'they already had — which is the whole point of having two.')+
                 (st.pairs === null
                   ? note('Your adapter would not list its accounts back, so this screen could '+
                          'not check that it really holds this one.','warn')
                   : '');
          } else {
            h += note('Your adapter’s own list does not hold <b>'+esc(st.acct)+'</b>, so this '+
                      'config must not be pointed at it yet: a config naming an account the '+
                      'adapter does not have does not fall back to another one — it stops '+
                      'sending anything at all. Finish the steps above, then come back.','warn');
          }
        }

        h += heldHTML();
        return h;
      }

      function draw(){
        /* KEEP WHAT IS TYPED BEFORE THE MARKUP HOLDING IT IS DESTROYED. Every
           caller of draw() is some step of this flow finishing, and several of
           them (a refusal, a redrawOpenScreen from devbar) happen with a field
           half-filled. Harvesting here rather than in each handler means a
           draw() added later cannot forget to. */
        keep();
        root.innerHTML = build();
        ZS.wire(root, ns);
        wire();
        /* SAY THE OUTCOME, do not only draw it. draw() replaces the whole
           screen, so a refusal or a confirmation rendered into brand-new
           markup is silent to a screen reader — and this is the one flow in
           the product where a user is following instructions against a code
           that expires. ZS.announce is the app's single persistent live
           region; announcing only on CHANGE keeps the several draws inside one
           step from repeating themselves. */
        var say = [st.m1, st.m2].filter(function(t){ return !!t; }).join('. ');
        if(say && say !== st.said){ st.said = say; ZS.announce(say); }
        if(!say) st.said = '';
      }
      /* The three typed fields into module state. Called before every repaint
         and on every keystroke, so neither route loses them. */
      function keep(){
        var el = root.querySelector('#psn-name'); if(el) st.nm = rpCap(el.value, 64);
        el = root.querySelector('#psn-id');       if(el) st.aid = rpCap(el.value, 64);
        el = root.querySelector('#psn-redir');    if(el) st.redir = rpCap(el.value, 2048);
      }
      /* AND THE MARKUP, IN THAT ORDER. keep() harvests the live fields before
         draw() replaces them, so a success path that cleared only the state
         would have the very next repaint put the account ID — and the spent
         one-time `code=` — straight back out of the DOM it had not blanked
         yet. Both halves, or neither is forgotten. */
      function forget(){
        ['psn-name','psn-id','psn-redir'].forEach(function(id){
          var el = root.querySelector('#'+id);
          if(el) el.value = '';
        });
        st.nm = ''; st.aid = ''; st.redir = '';
      }

      /* Re-read the board's listing and land whatever it says in `st`. Called
         after every write, because a POST answering {ok:true} is a claim and
         this is the adapter agreeing with it. Also where the MAC step three
         writes comes from: the register reply carries one too, but what the
         CONSOLE said and what the adapter's pairing file now holds are
         different facts, and the file is what remoteplay_backend reads. */
      function reread(then){
        st.checking = true;
        draw();                         /* "asking…" while it is in flight */
        rpAccountsInvalidate();
        rpAccountsFetch(function(list){
          var i;
          st.checking = false;
          st.pairs = list === null ? null : rpPairs(list);
          /* FROM SCRATCH, EVERY TIME. These two are the LIST's answer, and a
             list that no longer holds the pairing has to be able to take the
             answer back — otherwise "your adapter's own list shows that pair"
             outlives the list that showed it, which is the same class of
             self-contradiction the read-back was added to end. A list that
             cannot be read (st.pairs === null) is not an answer either way, so
             it clears them too: the screen then says only what the CONSOLE
             said, and step three falls back to the register reply's own MAC. */
          st.mac = '';
          st.listNick = '';
          if(st.pairs && st.acct)
            for(i = 0; i < st.pairs.length; i++)
              if(st.pairs[i].acct === st.acct && st.pairs[i].mac){
                st.mac = st.pairs[i].mac;
                st.listNick = rpCap(st.pairs[i].nick);
                break;
              }
          if(then) then();
          draw();
        });
      }

      function val(id){
        var el = root.querySelector('#'+id);
        return String((el && el.value) || '').replace(/^\s+|\s+$/g, '');
      }
      function working(b, word){ if(b){ b.disabled = true; b.textContent = word; } }

      /* The pad edits in PLACE. A full draw() per digit would rebuild the
         screen and throw away the scroll position eight times while somebody
         is racing an expiring code. */
      function pinPaint(){
        var d = root.querySelector('#psn-disp'),
            c = root.querySelector('#psn-count'),
            i = root.querySelector('#psn-pin');
        if(d){ d.innerHTML = pinSlots(st.pin); d.setAttribute('aria-label', pinSays(st.pin)); }
        if(c) c.textContent = pinSays(st.pin);
        if(i) i.value = st.pin;
      }
      function pinPush(k){
        if(k === 'del') st.pin = st.pin.slice(0, -1);
        else if(k === 'clear') st.pin = '';
        else if(/^[0-9]$/.test(k) && st.pin.length < 8) st.pin += k;
        else return;
        pinPaint();
      }

      function wire(){
        var b, pad, ac;

        /* EVERY KEYSTROKE INTO MODULE STATE. draw()'s own keep() covers the
           repaints this screen starts, but not the one it does not: devbar.js
           calls ZS.redrawOpenScreen() when the connected pad changes family,
           and openDetail() writes over #dbody's markup BEFORE the renderer
           runs — so by the time anything here could look, the half-typed field
           is already gone. Plugging in the pad you are setting this up for is
           an ordinary thing to do mid-flow; it is the same event the PIN is
           held in state for. */
        ['psn-name','psn-id','psn-redir'].forEach(function(id){
          var el = root.querySelector('#'+id);
          if(el) el.addEventListener('input', keep);
        });

        /* WHICH WAY THE DISCLOSURE IS FACING SURVIVES THE REDRAW. ZS.wire
           attached first, so by the time this listener runs the generic
           handler has already toggled the class — read it rather than
           second-guess it, and the module remembers. Without this, opening the
           sign-in fallback and pressing anything inside it closed the very box
           the answer was about to be rendered into. */
        ac = root.querySelector('.acc');
        if(ac){
          var ah = ac.querySelector('.ah');
          if(ah) ah.addEventListener('click', function(){
            st.accOpen = ac.classList.contains('open');
          });
        }

        pad = root.querySelector('#psn-pad');
        if(pad){
          pad.querySelectorAll('button').forEach(function(k){
            k.addEventListener('click', function(){ pinPush(k.getAttribute('data-k')); });
          });
          /* A hardware or Bluetooth keyboard still works: the keys bubble to
             here from whichever pad button has focus. Nothing else on the
             screen listens, so no digit can be swallowed by a text field. */
          pad.addEventListener('keydown', function(e){
            var key = e.key;
            if(/^[0-9]$/.test(key)){ pinPush(key); e.preventDefault(); }
            else if(key === 'Backspace'){ pinPush('del'); e.preventDefault(); }
          });
        }

        b = root.querySelector('#psn-recheck');
        if(b) b.addEventListener('click', function(){
          working(b, 'Reading it back…');
          reread(null);
        });

        b = root.querySelector('#psn-add');
        if(b) b.addEventListener('click', function(){
          var name = val('psn-name'), id = val('psn-id');
          if(!name){ st.m1 = 'Give this account a name first — it is how it will be listed.';
                     st.m1bad = true; draw(); return; }
          if(!id){ st.m1 = 'Paste the account ID, or open “I don’t know my account ID” below.';
                   st.m1bad = true; draw(); return; }
          working(b, 'Adding…');
          /* accountId AND name, because the login-free path has no other way
             to key the record: pyremoteplay's profile file is keyed by the PSN
             online id, and nothing in the 8 bytes carries a name. The agent
             reads exactly these two keys off the body (api/server.py
             _h_ps5_account_add), so this is the contract and not a guess. */
          rpApi('/account','POST',{ name:name, accountId:id }).then(function(j){
            /* The route is not there. Say the honest thing once, and only
               about the half that is missing — the sign-in below may still
               work, and blanking the whole screen for it once threw away an
               account the user had already added. */
            if(rpMissing(j)){ RP_MISSING.account = true; draw(); return; }
            var d = (j && j.ok && j.data) || null;
            if(d){
              st.acct = rpCap(d.username || d.account || name);
              /* SPENT. The ID identifies a real person's PSN account, so it is
                 dropped the moment it has been accepted rather than left in
                 memory for the rest of the session. */
              forget();
              st.m1bad = false;
              st.m1 = 'Added ' + st.acct + '. Reading it back from your adapter…';
              draw();
              /* THE ADAPTER'S OWN LIST IS THE ANSWER, not the reply above. */
              reread(function(){
                var held = st.pairs && rpHasAccount(st.pairs, st.acct);
                if(st.pairs === null){
                  st.m1 = 'Added ' + st.acct + ' — but your adapter would not list its accounts '+
                          'back, so this screen cannot confirm it stuck.';
                  st.m1bad = true;
                } else if(held){
                  st.m1 = 'Your adapter now lists ' + st.acct + '.';
                  st.m1bad = false;
                } else {
                  st.m1 = 'Your adapter said it added ' + st.acct + ', but its own list does not '+
                          'show it. Treat that step as unfinished.';
                  st.m1bad = true;
                }
              });
            } else {
              st.m1 = String((j && j.error) ||
                'Your board would not take that account ID. Check it for stray spaces and try '+
                'again, or use the sign-in below.');
              st.m1bad = true;
              draw();
            }
          });
        });

        b = root.querySelector('#psn-open');
        if(b) b.addEventListener('click', function(){
          st.accOpen = true;             /* every answer lands inside this box */
          rpApi('/login-url').then(function(j){
            if(rpMissing(j)){ RP_MISSING.link = true; draw(); return; }
            var d = (j && j.ok && j.data) || null;
            if(!d || !d.url){
              st.m1 = String((j && j.error) ||
                'Your board could not produce a sign-in link.'); st.m1bad = true;
              draw(); return;
            }
            st.url = String(d.url);
            /* window.open, never a navigation: leaving the page kills the app
               and the user comes back to a blank slate mid-flow. If the webview
               blocks the popup — and over Bluetooth it may — the copyable link
               below is the way through, which is why it is rendered either way
               rather than only after a failure the app cannot detect. */
            /* m7 (audit 2026-10-10): only an https link is opened. The app
               runs in shells (Capacitor, the Edge app window) where another
               scheme can launch a handler; anything else is still shown
               below as text to copy. */
            if(/^https:\/\//i.test(st.url)){
              try{ window.open(st.url, '_blank', 'noopener'); }catch(e){}
            }
            draw();
          });
        });

        b = root.querySelector('#psn-copy');
        if(b) b.addEventListener('click', function(){
          var i = root.querySelector('#psn-url');
          if(!i) return;
          try{ i.select(); document.execCommand('copy'); ZS.toast('Sign-in link copied'); }
          catch(e){ ZS.toast('Copy it by hand — long-press the box above'); }
        });

        b = root.querySelector('#psn-save');
        if(b) b.addEventListener('click', function(){
          st.accOpen = true;
          var v = val('psn-redir');
          if(!v){ st.m1 = 'Paste the whole web address from that page first.';
                  st.m1bad = true; draw(); return; }
          working(b, 'Asking Sony…');
          /* The redirect URL carries a single-use `code=` — a short-lived
             bearer credential. It goes in the request BODY and is never
             logged, echoed back, or put in a query string. */
          function attempt(path, andThen){
            rpApi(path,'POST',{ redirectUrl:v }).then(function(j){
              if(rpMissing(j)){ andThen(); return; }
              RP_LINK_PATH = path;
              var d = (j && j.ok && j.data) || null;
              if(d && (d.username || d.account)){
                st.acct = rpCap(d.username || d.account);
                /* SPENT, and this one is a live credential until it is: the
                   redirect carries a single-use `code=`. It is held only long
                   enough to survive a refusal and dropped the moment the board
                   has exchanged it. */
                forget();
                st.m1bad = false;
                st.m1 = 'Signed in as ' + st.acct + '. Reading it back from your adapter…';
                draw();
                reread(function(){
                  if(st.pairs === null){
                    st.m1 = 'Signed in as ' + st.acct + ' — but your adapter would not list its '+
                            'accounts back, so this screen cannot confirm it stuck.';
                    st.m1bad = true;
                  } else if(rpHasAccount(st.pairs, st.acct)){
                    st.m1 = 'Your adapter now lists ' + st.acct + '.';
                    st.m1bad = false;
                  } else {
                    st.m1 = 'Your adapter said it signed in as ' + st.acct + ', but its own list '+
                            'does not show it. Treat that step as unfinished.';
                    st.m1bad = true;
                  }
                });
              } else {
                st.m1 = String((j && j.error) ||
                  'That link did not carry a working code. They expire — get a fresh sign-in link '+
                  'and try again.');
                st.m1bad = true;
                draw();
              }
            });
          }
          if(RP_LINK_PATH) attempt(RP_LINK_PATH, function(){ RP_MISSING.link = true; draw(); });
          else attempt('/link', function(){
            attempt('/account', function(){ RP_MISSING.link = true; draw(); });
          });
        });

        b = root.querySelector('#psn-link');
        if(b) b.addEventListener('click', function(){
          var pin = val('psn-pin').replace(/\D/g, '');
          if(pin.length !== 8){ st.m2 = 'The code is exactly 8 digits.'; st.m2bad = true;
                                draw(); return; }
          st.pin = pin;
          working(b, 'Talking to your PS5…');
          /* THE ACCOUNT NAME IS SENT, and it is not belt-and-braces: the
             board's own register helper picked users[0] — the same
             next(iter()) defect one layer down — so a second account paired
             without naming it would be registered onto the FIRST account, and
             nothing on screen could show that it had happened. */
          rpApi('/register','POST',{ account:st.acct, pin:pin }).then(function(j){
            if(rpMissing(j)){ RP_MISSING.register = true; draw(); return; }
            var d = (j && j.ok && j.data) || null;
            if(d && (d.console || d.nickname)){
              st.nick = rpCap(d.console || d.nickname);
              /* THE REPLY'S MAC IS KEPT SEPARATELY FROM THE LISTING'S, and the
                 two are not interchangeable. psn_link.cmd_register hands back
                 a canonical `mac`, but what the CONSOLE said and what the
                 adapter's pairing FILE now holds are different facts — and the
                 file is what remoteplay_backend reads. So the listing's MAC is
                 what step three writes; this one is the fallback for a board
                 that would not list at all, where there is nothing better and
                 an account-only choice would be the poorer answer. */
              st.replyMac = rpFoldMac(d.mac || '');
              st.pin = '';                     /* the code is spent */
              st.m2bad = false;
              st.m2 = 'Linked to ' + st.nick + '. Reading it back from your adapter…';
              draw();
              /* The register reply carries no MAC, so this pass is also where
                 step three learns WHICH console it just paired — without it
                 the config could only ever name half a pairing. */
              reread(function(){
                if(st.pairs === null){
                  st.m2 = 'Linked to ' + st.nick + ' — but your adapter would not list its '+
                          'accounts back, so this screen cannot confirm it stuck.';
                  st.m2bad = true;
                } else if(st.mac){
                  st.m2 = 'Your adapter now holds ' + st.acct + ' on ' + st.nick + '.';
                  st.m2bad = false;
                } else {
                  st.m2 = 'But your adapter’s own list shows no console against ' + st.acct +
                          ' yet, so that pairing has not landed.';
                  st.m2bad = true;
                }
              });
            } else {
              st.m2 = String((j && j.error) ||
                'Your PS5 did not accept that code. Codes expire after a few minutes — get a '+
                'fresh one on the console and try again.');
              st.m2bad = true;
              draw();
            }
          });
        });

        b = root.querySelector('#psn-use');
        if(b) b.addEventListener('click', function(){
          var acct = st.acct, nick = st.nick,
              /* the LISTING's MAC, or the console's own only when there is no
                 listing to prefer — never a MAC the pairing file contradicts */
              mac = st.mac || (st.pairs === null ? st.replyMac : '');
          if(ZS.live.online === false || !ZS.live.full[p.id]){
            ZS.toast('Your board is offline — this has not reached it yet');
            return;
          }
          ZS.flushProfileWrites(p.id).then(function(){
            return ZS.putProfile(p.id, function(f){
              if(!f.output) f.output = {};
              /* BOTH halves when the board's own list gave us the second one.
                 The register reply carries no MAC, so this used to write an
                 empty one and leave the console lottery running for anybody
                 who later added a second console to the same account; the
                 read-back above is what closed that. An empty `mac` is still
                 legal and still correct on a board that would not list — it
                 pins the account, which is the half that was actually broken. */
              f.output.remotePlay = { account: acct, mac: mac || '' };
            });
          }).then(function(j){
            if(!(j && j.ok)) return;
            PSN = null;                       /* the next entry starts clean */
            ZS.announce('This config now plays as ' + acct);
            ZS.toast('“' + ((p && p.name) || 'This config') + '” now plays as ' + acct +
                     (nick ? ' on “' + nick + '”' : ''));
            ZS.openDetail({ id:'overview', lab:'Device' }, p);
          });
        });
      }

      draw();
      /* One question to the board, for the same reason the row asks it: which
         route family this software speaks, and whether it speaks one at all —
         and, now, what it actually holds, which is what the foot of the screen
         renders. Cached, so re-entering the screen mid-flow costs nothing. */
      rpAccountsFetch(function(list){
        st.pairs = list === null ? null : rpPairs(list);
        draw();
      });
    }};
  };

  /* what the other screen files use from this one */
  SEC.rpAcctPaint = rpAcctPaint;
  /* the PIN pad's stylesheet, for the Core's Remote Play setup (07a, D286) */
  SEC.psnCss = psnCss;
});
