/* shell/05-tiles.js — a config's tile: the letter, the picture, the mark.
 *
 * gameInitial, artHTML (the photo, the game's art, or the family mark),
 * fitPic, markKey and wireArt: every config tile on HOME and in the lists.
 *
 * PART OF THE APP SHELL: phone.html's one inline script until 2026-10-02,
 * now these consecutive files, loaded where it was. They are CLASSIC
 * scripts, as it was: every top-level function and var is a global the
 * other files (and devbar.js, sections/, smart-actions/) call by name, and
 * nothing here may use, while loading, a name a LATER shell file declares
 * (calls made after the page has loaded are fine). phone.html lists them.
 */
  /* THE ONE LETTER ENGRAVED ON A CONFIG'S TILE. It used to be
     `game.charAt(0)`, which is the letter of the title and not the letter of
     the GAME: "The Finals" and "The Division" both engraved a T, so the one
     glyph that exists to tell two configs apart told them apart from nothing.
     Leading articles are dropped, then the first LETTER OR DIGIT is taken —
     a title starting with punctuation or a space ("  Warzone", "…Vault")
     would otherwise engrave a blank tile or a stray mark.
     Returns '' for a config with no game, which is the caller's own test for
     whether to draw the layer at all. */
  function gameInitial(g){
    var s = String(g==null?'':g).replace(/^\s+/,'');
    s = s.replace(/^(the|a|an)\s+/i, '');
    var m = /[A-Za-z0-9]/.exec(s);
    return m ? m[0].toUpperCase() : '';
  }

  function artHTML(p, size, opts){
    opts = opts || {};
    /* opts.force lets a caller ask for the no-photo tile even when the config
       HAS a photo — the photo sheet's "no photo" preview is the one place
       that needs it, and it was hand-rolling its own badge-only square that
       looked nothing like the tile the app actually draws. Otherwise the
       player's choice, kept with the picture in the app (photoKind, D120). */
    var kind = opts.force || photoKind(p.id);
    /* THE SLOT'S SHAPE (D121): 'wide' (the Configs list), 'tall' (HOME) or
       'square' (the More menu's door). A wide slot is `size` tall and as
       wide as Steam's 460 x 215 header, so a header fills it with nothing
       cut; the other two are the square box they always were (HOME's CSS
       then stretches its box over the whole picture area). The shape also
       picks WHICH of the game pack's pictures is drawn. */
    var shape = opts.shape || (size >= 200 ? 'tall' : 'square');
    var wide = (window.ZSPACKS && ZSPACKS.ASPECT) ? ZSPACKS.ASPECT.wide : 460/215;
    var bw = shape==='wide' ? Math.round(size*wide) : size;
    /* --cfg rides the tile even on the photo branch, so the offline swap
       (wireArt) lands on a tile that already knows its colour */
    var box = ' style="width:'+bw+'px;height:'+size+'px;--cfg:'+esc(p.color||'#4a5568')+'"';
    /* THE NO-PHOTO TILE IS COMPOSED, NOT BARE (owner, 2026-08-17: "the
       picture for configs needs to be better" — they were small dark
       squares). Three layers: the config's own colour as a real backdrop
       (.art.mkart in zs-kit.css §5.4 mixes --cfg into the panel), the
       family badge floating on it at 70% with a shadow, and — game-aware —
       a big engraved initial of the locked game behind the badge on tiles
       with room for it (the 96px hero; 64px is the cutoff so the 44px rows
       never gain clutter). All of it decorative: the idline TEXT beside
       the tile is what a screen reader gets, exactly as before.

       AND A FOURTH LAYER ON BOTH BRANCHES — the 4px --cfg stripe across the
       tile's foot (.art::after, the style block above). It is the only
       per-config channel that survives 44px, where the initial is suppressed
       and the badge is 31px, and it makes the tile carry the SAME colour as
       the row's left rail instead of the two being unrelated colour events. */
    /* THE MONOGRAM FALLS BACK TO THE CONFIG'S OWN NAME (owner, 2026-08-28:
       a config with no photo "looks empty/broken"). It did, and the reason
       was this line: the initial was drawn only for a config with a GAME
       locked, and the flagship "Call of Duty" config is Game = "None —
       general config". So the one layer that could have carried identity
       never fired, and 44% of HOME was a bare colour wash. A config always
       has a name, so the name is the floor: "Call of Duty" → C. gameInitial
       already strips a leading "The/A/An" and takes the first letter or
       digit, which is the same rule a name wants. */
    var gi = gameInitial(p.game) || gameInitial(p.name);
    /* ── THE PLATE, AND WHO GETS ONE ─────────────────────────────────────
       At a big enough tile the letter stops being a corner texture and
       becomes the SUBJECT of the picture: centred, inside the engraved
       reticle, with the family badge standing down (the identity line beside
       the tile already carries the family mark, and drawing it again 19px
       away is the duplicate this screen was just cleaned of). The treatment
       is `.art.mkart.plate` in zs-fixes.css.

       A caller may also ASK for one at any size — opts.plate — and the photo
       sheet does, because its preview answers "what does this config look
       like with no photo" and it was answering with a tile the app does not
       draw anywhere.

       THE FONT SIZE SPLITS ON WHETHER THE BOX IS KNOWN. The hero is
       full-bleed: `size` is a nominal 300 and the real box is whatever height
       HOME has left (326×396 on a 400px phone), so it is sized in the
       stylesheet against the viewport and nothing is written inline — an
       inline font-size would win over that rule and pin the letter to a
       number that was never true. Every other plate has the box it asked
       for, so it is sized here, at 44% of it. */
    var fluid = size >= 200;                 /* the hero: CSS owns the size */
    var plate = fluid || !!opts.plate;
    var mark = (window.ZSMARK
        ? '<span class="mkbadge">'+ZSMARK.badge(markKey(p), {size:size, decorative:true})+'</span>'
        : '')+
      (gi && size>=64
        ? '<i class="gm0'+(plate?' gm0-plate':'')+'" aria-hidden="true"'+
          (fluid?'':' style="font-size:'+Math.round(size*(plate?0.44:0.92))+'px"')+'>'+
          esc(gi)+'</i>'
        : '');
    var pc = plate ? ' plate' : '';
    /* THE GAME PACK'S PICTURE (D116) stands in for a photo the player has not
       taken. The player's own photo still wins, and opts.force (the photo
       sheet's "no photo" preview) still gets our own mark. ZSPACKS only hands
       out a picture that has already LOADED, so an empty art folder is the
       mark, never a broken image; the photo branch's onerror swap (wireArt)
       covers the rest, which is why the pack picture rides that branch. */
    var packArt = (!opts.force && !(kind==='photo' && hasPhoto(p.id)) && window.ZSPACKS)
      ? ZSPACKS.artFor(p, shape) : '';
    if(packArt){
      /* DRAWN WHOLE, NEVER CROPPED (D121). The picture is contained in the
         slot over a blurred copy of itself (fitPic, .art.fit), so a title
         at the edge of the art is never cut off; the right SHAPE makes the
         blurred margin small or nothing. No family badge in the corner any
         more: at HOME the console pill on the picture's foot already says
         it, and a badge there sat on the publisher's art. */
      return '<span class="art photo pack fit'+pc+'"'+box+' data-mark="'+esc(mark)+'">'+
        fitPic(packArt, (p.game||p.name)+', '+(CON[p.platform]||'')+' config', opts.eager)+'</span>';
    }
    /* A PHOTO IN A WIDE SLOT is drawn whole the same way: the app keeps
       photos square (zs-photos.js), and cropping a square to a 2.14:1 strip
       would keep less than half of it. Every other slot keeps the photo as
       it always was. */
    if(kind==='photo' && hasPhoto(p.id) && shape==='wide'){
      return '<span class="art photo fit'+pc+'"'+box+' data-mark="'+esc(mark)+'">'+
        fitPic(photoURL(p.id), p.name+' — '+(CON[p.platform]||'')+' config', opts.eager)+'</span>';
    }
    if(kind==='photo' && hasPhoto(p.id)){
      /* A PHOTO CARRIES NO FAMILY INFORMATION, so the hero gives it back in
         the corner — a small dark disc with the family mark, at tiles big
         enough to hold one (same 64px cutoff as the engraved initial). At
         44px it is skipped: the foot stripe is the per-config channel there,
         and a 13px badge would be clutter, not identity. Decorative, like
         every other layer — the idline text beside the tile is the identity a
         screen reader gets, and the <img>'s own alt already names the config
         and its console. */
      var corner = (window.ZSMARK && size>=64)
        ? '<span class="pmark" aria-hidden="true">'+
          ZSMARK.badge(markKey(p), {size:Math.round(size*0.3), decorative:true})+'</span>'
        : '';
      /* the onerror swap is wired after render (wireArt) — offline, the URL
         404s, and a row must NEVER show a broken-image icon */
      /* `pc` rides the photo branch too: offline the <img> 404s and wireArt
         swaps this span to the mark treatment in place, so the class that
         decides WHICH mark treatment has to already be on it. */
      return '<span class="art photo'+pc+'"'+box+' data-mark="'+esc(mark)+'">'+
        '<img src="'+esc(photoURL(p.id))+'" alt="'+esc(p.name)+' — '+
        esc(CON[p.platform]||'')+' config"'+
        (opts.eager?'':' loading="lazy"')+' decoding="async">'+corner+'</span>';
    }
    return '<span class="art mkart'+pc+'"'+box+'>'+mark+'</span>';
  }
  /* A PICTURE DRAWN WHOLE (D121): the picture itself, contained, over a
     blurred and darkened copy of itself that fills whatever the picture
     does not. The described picture comes FIRST, so anything that asks a
     tile for its image (a screen reader, a test) meets the real one; the
     copy is decorative. Both carry the same URL, so it is fetched once. */
  function fitPic(src, alt, eager){
    var lz = (eager?'':' loading="lazy"')+' decoding="async"';
    return '<img class="artfg" src="'+esc(src)+'" alt="'+esc(alt)+'"'+lz+'>'+
      '<img class="artbg" src="'+esc(src)+'" alt="" aria-hidden="true"'+lz+'>';
  }
  /* A config's default art is its CONSOLE — the owner's call (2026-08-15):
     "xbox show xbox logo, ps5 show ps5 logo". The tile answers "which machine
     is this for"; the input device is already written out on the idline text
     ("PlayStation 5 · Mouse + Keyboard"), so keying the tile by input meant a
     PS5 config wore the purple M&K badge and the list read as a wall of
     identical purple — the one question the tile exists to answer went
     unanswered.

     PC is the exception because it has no console identity: there the input
     IS the identity, so M&K configs keep the purple mark and controller
     configs get the generic pad. (ZSMARK aliases handle ps5→ps, xbox→xb;
     'gen' is the grey pad tile.)

     These are family SILHOUETTES from marks.js, deliberately not the real
     PlayStation/Xbox logos — those are trademarks, and shipping them in a
     sold product is a legal exposure marks.js documents. If that trade is
     ever re-decided, this function and marks.js are the whole surface. */
  function markKey(p){
    /* Asked as a question about the PAD — "does this config have one?" — and
       never as `input==='mnk'`. A Joystick + Mouse config has a real stick in
       a real hand, so on PC it wears the pad tile like any other pad config;
       the "+ mouse" half is in the words beside the mark, which idLine()
       always draws. A fourth input type would have to answer the same
       question rather than fall silently into the M&K arm. */
    if(p.platform==='pc') return inputShows(p.input, 'controller') ? 'gen' : 'mkb';
    return p.platform;
  }
  function wireArt(root){
    (root||document).querySelectorAll('.art.photo img').forEach(function(im){
      im.addEventListener('error', function(){
        var host = im.parentNode;
        if(!host) return;
        host.classList.remove('photo');
        host.classList.add('mkart');   /* the composed mark treatment, not a
                                          bare tile — same look as a config
                                          that never had a photo */
        host.innerHTML = host.getAttribute('data-mark') || '';
      });
    });
  }

  /* map an agent profile → the UI's shape */
  var PALETTE=['#58a6ff','#3fb950','#d29922','#a371f7','#f85149','#ec6cb9','#39c5cf','#e3b341'];
  /* schema.py's shipped lighting.color. A config still holding it has never
     had a colour CHOSEN, so the app keeps giving it a distinct palette entry
     rather than painting every row the same blue. */
  var LIGHT_DEFAULT = '0080ff';
  /* The row stripe is the colour the PAD GLOWS. lighting.color is a real
     validated field the engine applies on activation, down the USB interface
     it already holds — so picking a colour in this list changes the light bar,
     exactly as XIM's config colour drives the MATRIX's breathing light.
     STORE.vals['pcolor|…'] stays as the offline fallback only. */
  function profileColor(full, i){
    var lc = full && full.lighting && full.lighting.color;
    if(typeof lc==='string' && lc && lc.toLowerCase()!==LIGHT_DEFAULT)
      return '#'+lc.replace('#','');
    return STORE.vals['pcolor|'+full.id] || PALETTE[i%PALETTE.length];
  }
  function uiProfile(full, i){
    return { id: full.id, name: full.name||full.id,
      platform: full.console||'ps5', input: full.inputType||'mnk',
      /* the config's game identity (schema v9, one-way latch on the board).
         Carried on the small object too, or the field would die on every
         loadLive() wholesale PROFILES replacement below. */
      game: full.game || '',
      /* the game pack it was made from (D115): a pack id, 'scratch' for a
         config the player started from scratch, '' for one made before
         game packs. The last two look alike (no game) and are not: only
         the last is offered the one-time "Choose a game". */
      pack: (full.gamePack && typeof full.gamePack.id === 'string') ? full.gamePack.id : '',
      color: profileColor(full, i) };
  }
