      ['[', 'KEY_LEFTBRACE', 'left bracket key'], [']', 'KEY_RIGHTBRACE', 'right bracket key'],
      ['\\', 'KEY_BACKSLASH', 'backslash key'], ['/', 'KEY_SLASH', 'slash key']],
