      ['Del', 'KEY_DELETE', 'Delete key'], ['Pause', 'KEY_PAUSE'], ['Scrl', 'KEY_SCROLLLOCK', 'Scroll Lock key']],
     [['Prnt', 'KEY_SYSRQ', 'Print Screen key'], ['L Win', 'KEY_LEFTMETA', 'Left Windows key', 'L'],
      ['R Win', 'KEY_RIGHTMETA', 'Right Windows key', 'R'], ['Pg Up', 'KEY_PAGEUP', 'Page Up key'],
      ['Pg Dn', 'KEY_PAGEDOWN', 'Page Down key']]]
  ];
  function kbXimPageHTML(n, attr) {
    var rows = KB_XIM_PAGES[n] || [];
    return '<div class="sabkb saxkb">' + rows.map(function (r) {
      return kbRowHTML(r, 'x', 0, attr);
    }).join('') + '</div>';
  }

  /* THE MOUSE PAGE — drawn as a mouse. Wheel up/down are deliberately absent:
     srcClass would accept them but nothing else in the app offers them, and a
     control that silently does nothing is the class of bug this file exists
     to end. */
  /* the one piece of genuinely new mouse art: a side button drawn ON a mouse,
     where srcArt would otherwise hand back a KEYCAP saying "M4" */
  var MARK_MSIDE = mark('<rect x="15" y="7" width="19" height="34" rx="9.5"/>' +
    '<path d="M24 7v12"/><rect x="7" y="17" width="6" height="6" rx="2" fill="currentColor" stroke="none"/>' +
    '<rect x="7" y="27" width="6" height="6" rx="2" fill="currentColor" stroke="none"/>');

  function mousePageHTML(attr) {
    function m(code, label, say, cls) {
      /* keycaps.js draws every mouse button ON a mouse, side buttons
         included, so MARK_MSIDE is only the fallback now */
      var art = (window.ZSKEYS && ZSKEYS.svg(code)) ||
        ((code === 'BTN_SIDE' || code === 'BTN_EXTRA') ? MARK_MSIDE : srcArt(code));
      return keyHTML(attr || 'data-src', code, art, label, say, ' mnk' + (cls || ''));
    }
    /* XIM's two rows (D78): the three main buttons, then the two side
       buttons. Every tile is a mouse with that button lit (keycaps.js), so
       a row of three mice reads as three buttons; the caption keeps the
       word. The same picture on the trigger picker — one mouse everywhere. */
    return '<div class="sabmouse">' +
      '<div class="sabgrp" role="group" aria-label="mouse buttons"><div class="sabgrow">' +
      m('BTN_LEFT', 'Left', 'left mouse button') +
      m('BTN_MIDDLE', 'Wheel', 'middle mouse button', ' mid') +
      m('BTN_RIGHT', 'Right', 'right mouse button') + '</div></div>' +
      '<div class="sabgrp" role="group" aria-label="mouse side buttons"><div class="sabgrow">' +
      m('BTN_SIDE', 'M4', 'mouse button 4') +
      m('BTN_EXTRA', 'M5', 'mouse button 5') + '</div></div></div>';
  }

