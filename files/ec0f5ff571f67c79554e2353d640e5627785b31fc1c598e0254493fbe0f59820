/* zs-scripts.js — the Script Edition's 16-byte script, in plain words
 * (window.ZSScripts).
 *
 * ES5 ONLY, like the rest of the app.
 *
 * Format v1 (DSE Recoil Mod docs/STICK-LINK.md, "Script format"):
 *   0 version (1)        1 recoil down 0-100 %    2 drift -100..100 (signed)
 *   3 ramp x10 ms        4 decay %/s              5 aim type 0 none/1 jitter/2 circle
 *   6 aim size 0-100 %   7 aim rate 1-30 Hz       8 flags bit0 aim also while
 *   firing, bit1 invert Y                          9-15 reserved 0
 *
 * The dongle keeps the bytes (8 slots); the NAMES live only in the app,
 * per dongle, in localStorage.
 */
(function () {
  'use strict';

  var VERSION = 1;
  var FLAG_AIM_WHILE_FIRING = 1, FLAG_INVERT_Y = 2;

  function clamp(v, lo, hi) { v = Math.round(+v || 0); return v < lo ? lo : (v > hi ? hi : v); }

  /* The dongle's own out-of-the-box slot 0 (firmware scripts.c). */
  function defaults() {
    return { recoil: 18, drift: 0, ramp: 5, decay: 0,
             aimType: 0, aimSize: 0, aimRate: 0, aimWhileFiring: false, invertY: false };
  }

  function encode(s) {
    var b = new Uint8Array(16), drift = clamp(s.drift, -100, 100);
    b[0] = VERSION;
    b[1] = clamp(s.recoil, 0, 100);
    b[2] = drift < 0 ? 256 + drift : drift;
    b[3] = clamp(s.ramp, 0, 255);
    b[4] = clamp(s.decay, 0, 100);
    b[5] = clamp(s.aimType, 0, 2);
    b[6] = b[5] ? clamp(s.aimSize, 0, 100) : 0;
    b[7] = b[5] ? clamp(s.aimRate, 1, 30) : 0;
    b[8] = (s.aimWhileFiring ? FLAG_AIM_WHILE_FIRING : 0) | (s.invertY ? FLAG_INVERT_Y : 0);
    return b;
  }

  /* -> fields, or null for an empty / unknown slot (version byte not 1) */
  function decode(bytes) {
    var b = bytes || [];
    if (b.length < 9 || b[0] !== VERSION) { return null; }
    return {
      recoil: b[1], drift: b[2] > 127 ? b[2] - 256 : b[2], ramp: b[3], decay: b[4],
      aimType: b[5] > 2 ? 0 : b[5], aimSize: b[6], aimRate: b[7] || 12,
      aimWhileFiring: !!(b[8] & FLAG_AIM_WHILE_FIRING), invertY: !!(b[8] & FLAG_INVERT_Y)
    };
  }

  function copy(s) {
    var o = {}, k;
    for (k in s) { if (Object.prototype.hasOwnProperty.call(s, k)) { o[k] = s[k]; } }
    return o;
  }

  function same(a, b) {
    var x = encode(a), y = encode(b), i;
    for (i = 0; i < 16; i++) { if (x[i] !== y[i]) { return false; } }
    return true;
  }

  /* Presets only touch their own half: a recoil preset keeps your aim
     pattern and an aim preset keeps your recoil. */
  var PRESETS = [
    /* The stick flex can push about 29 % from centre (STICK-LINK.md, Zo 1 kOhm),
       so Strong sits just under that; more only clamps (LINK flags bit 2). */
    { id: 'gentle', group: 'recoil', name: 'Gentle', set: { recoil: 10, drift: 0, ramp: 5, decay: 0 } },
    { id: 'medium', group: 'recoil', name: 'Medium', set: { recoil: 18, drift: 0, ramp: 8, decay: 0 } },
    { id: 'strong', group: 'recoil', name: 'Strong', set: { recoil: 28, drift: 0, ramp: 10, decay: 0 } },
    { id: 'none',   group: 'aim', name: 'No aim', set: { aimType: 0, aimSize: 0, aimRate: 0, aimWhileFiring: false } },
    { id: 'jitter', group: 'aim', name: 'Light jitter', set: { aimType: 1, aimSize: 15, aimRate: 15 } },
    { id: 'circle', group: 'aim', name: 'Circle aim', set: { aimType: 2, aimSize: 20, aimRate: 10 } }
  ];

  function applyPreset(s, id) {
    var o = copy(s), i, k, p;
    for (i = 0; i < PRESETS.length; i++) {
      if (PRESETS[i].id !== id) { continue; }
      p = PRESETS[i].set;
      for (k in p) { if (Object.prototype.hasOwnProperty.call(p, k)) { o[k] = p[k]; } }
    }
    return o;
  }

  /* which preset of a group the script matches exactly, or '' */
  function matchPreset(s, group) {
    var i, k, p, ok;
    for (i = 0; i < PRESETS.length; i++) {
      if (PRESETS[i].group !== group) { continue; }
      p = PRESETS[i].set; ok = true;
      for (k in p) {
        if (!Object.prototype.hasOwnProperty.call(p, k)) { continue; }
        if (k === 'aimRate' || k === 'aimSize' || k === 'aimWhileFiring') { if (!s.aimType && !p.aimType) { continue; } }
        if (s[k] !== p[k]) { ok = false; break; }
      }
      if (ok) { return PRESETS[i].id; }
    }
    return '';
  }

  var AIM_NAMES = ['No aim pattern', 'Jitter aim', 'Circle aim'];

  /* one short line for the slot list */
  function summary(s) {
    if (!s) { return 'Empty'; }
    var parts = [];
    parts.push(s.recoil ? 'Recoil ' + s.recoil + '%' : 'No recoil');
    if (s.drift) { parts.push((s.drift < 0 ? 'left ' : 'right ') + Math.abs(s.drift)); }
    parts.push(AIM_NAMES[s.aimType] || AIM_NAMES[0]);
    return parts.join(' · ');
  }

  /* ── slot names, per dongle ─────────────────────────────────────────── */
  function namesKey(dongleId) { return 'zsdongle:zsDongleSlotNames:' + (dongleId || 'default'); }
  function getNames(dongleId) {
    var n = null;
    try { n = JSON.parse(localStorage.getItem(namesKey(dongleId)) || 'null'); } catch (e) { n = null; }
    var out = [], i;
    for (i = 0; i < 8; i++) { out.push((n && typeof n[i] === 'string' && n[i]) ? n[i] : ''); }
    return out;
  }
  function setName(dongleId, slot, name) {
    var n = getNames(dongleId);
    n[slot] = String(name || '').replace(/\s+/g, ' ').replace(/^ | $/g, '').slice(0, 24);
    try { localStorage.setItem(namesKey(dongleId), JSON.stringify(n)); } catch (e) { /* private mode */ }
    return n[slot];
  }
  function displayName(names, slot) { return names[slot] || ('Script ' + (slot + 1)); }

  window.ZSScripts = {
    VERSION: VERSION,
    SLOTS: 8,
    defaults: defaults,
    encode: encode,
    decode: decode,
    copy: copy,
    same: same,
    PRESETS: PRESETS,
    applyPreset: applyPreset,
    matchPreset: matchPreset,
    summary: summary,
    getNames: getNames,
    setName: setName,
    displayName: displayName
  };
})();
