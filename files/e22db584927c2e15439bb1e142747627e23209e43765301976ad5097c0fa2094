/* zs-fw.js — firmware updates for the ZeroStick Dongle and the stick flex
 * over Bluetooth (window.ZSFW).
 *
 * ES5 ONLY, like the rest of the app.
 *
 * The images ship INSIDE the app under www/fw/, exactly as the firmware's
 * release step writes them (DSE Recoil Mod firmware/release/, made by
 * firmware/tools/make_release.py; re-copy with `node tools/sync-dse-fw.js`):
 *
 *   { "format": 1, "made": "...",
 *     "signing_key": { "name": "dse-dev", "key_id": "59beec1102979b4c", "production": false },
 *     "images": [
 *       { "product": "dongle", "file": "zs_dongle_ota.signed.bin", "version": "0.9.0",
 *         "chip": "CH592F", "chip_id": "0x92", "size": 206024, "sha256": "...",
 *         "crc32": "d00aaa84", "phone_ops": "0x30-0x34" },
 *       { "product": "flex", "file": "zs_flex_ota.signed.bin", ..., "phone_ops": "0x38-0x3C" } ] }
 *
 * read() below is the ONE place that reads that format. With the simulated
 * dongle (?mock=1) the manifest is fw/mock/manifest.json, same format.
 *
 * The files are signed (Ed25519 trailer). The dongle and the flex check
 * CRC, signature and identity themselves; this app checks size, SHA-256
 * and CRC-32 against the manifest before sending a byte, and sends the file
 * exactly as it is.
 *
 * Protocol (docs/CALIBRATION-DONGLE.md "Firmware update"):
 *   dongle 0x30 BEGIN [size][crc32] -> [chunk][max]; 0x31 DATA [offset][bytes]
 *          -> [next]; 0x32 END -> version, the dongle resets; 0x34 STATUS
 *   flex   0x38-0x3A the same into the dongle, which then relays the image to
 *          the flex by itself; 0x3C STATUS shows that until phase 5 (done)
 */
(function () {
  'use strict';

  var B = window.ZSHIDBLE;

  var TARGETS = {
    dongle: { id: 'dongle', name: 'Dongle', relay: false,
              ops: { begin: 0x30, data: 0x31, end: 0x32, abort: 0x33, status: 0x34 } },
    flex:   { id: 'flex', name: 'Stick flex', relay: true,
              ops: { begin: 0x38, data: 0x39, end: 0x3A, abort: 0x3B, status: 0x3C } }
  };

  /* ── helpers ───────────────────────────────────────────────────────── */
  var CRC_TABLE = (function () {
    var t = [], c, n, k;
    for (n = 0; n < 256; n++) {
      c = n;
      for (k = 0; k < 8; k++) { c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1); }
      t[n] = c >>> 0;
    }
    return t;
  })();
  /* standard CRC-32 (zlib / IEEE) over the whole file */
  function crc32(bytes) {
    var c = 0xFFFFFFFF, i;
    for (i = 0; i < bytes.length; i++) { c = CRC_TABLE[(c ^ bytes[i]) & 255] ^ (c >>> 8); }
    return (c ^ 0xFFFFFFFF) >>> 0;
  }
  function hex(buf) {
    var b = new Uint8Array(buf), s = '', i, h;
    for (i = 0; i < b.length; i++) { h = b[i].toString(16); s += (h.length < 2 ? '0' : '') + h; }
    return s;
  }
  function sha256(bytes) {
    var subtle = window.crypto && window.crypto.subtle;
    if (!subtle) { return Promise.resolve(null); }      /* not a secure page: CRC still checked */
    return subtle.digest('SHA-256', bytes).then(hex);
  }
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function err(kind, msg) { var e = new Error(msg); e.zsKind = kind; return e; }

  /* "0.9.1" > "0.9.0"; also takes [0,9,1] or a plain number */
  function parts(v) {
    if (v instanceof Array) { return v; }
    return String(v == null ? '' : v).split('.').map(function (x) { return parseInt(x, 10) || 0; });
  }
  function newer(a, b) {
    var x = parts(a), y = parts(b), i, n = Math.max(x.length, y.length);
    for (i = 0; i < n; i++) {
      if ((x[i] || 0) !== (y[i] || 0)) { return (x[i] || 0) > (y[i] || 0); }
    }
    return false;
  }

  /* ── manifest: the firmware release format, read in one place ──────── */
  function read(m) {
    if (!m || !(m.images instanceof Array)) { throw err('manifest', 'bad manifest'); }
    var key = m.signing_key || {};
    return {
      made: m.made || '',
      key: { name: key.name || '', id: key.key_id || '', production: !!key.production },
      images: m.images.map(function (im) {
        return {
          product: im.product, file: im.file, version: String(im.version || ''),
          chip: im.chip || '', chipId: im.chip_id != null ? parseInt(im.chip_id, 16) : null,
          size: +im.size || 0, sha256: String(im.sha256 || '').toLowerCase(),
          crc32: im.crc32 != null ? (parseInt(im.crc32, 16) >>> 0) : null,
          notes: im.notes || ''
        };
      })
    };
  }
  var base = window.ZS_DONGLE_MOCK ? 'fw/mock/' : 'fw/';
  var manifestP = null;
  function loadManifest() {
    if (!manifestP) {
      manifestP = fetch(base + 'manifest.json', { cache: 'no-store' }).then(function (r) {
        if (!r.ok) { throw err('manifest', 'no manifest'); }
        return r.json();
      }).then(read).then(null, function (e) { manifestP = null; throw e; });
    }
    return manifestP;
  }
  /* the newest image for this product (+ chip id for the dongle), or null */
  function pick(m, product, chipCode) {
    var best = null;
    m.images.forEach(function (im) {
      if (im.product !== product) { return; }
      if (chipCode != null && im.chipId != null && im.chipId !== chipCode) { return; }
      if (!best || newer(im.version, best.version)) { best = im; }
    });
    return best;
  }
  /* -> {entry, key, available}. current = the device's full version
     (dongle: DEVINFO 1-3; flex: LINK bytes 1, 6, 7). chipCode = DEVINFO
     byte 4 / LINK byte 8 (0x92 = CH592F dongle / CH592D flex); null when the
     device doesn't say (a flex older than 1.0), then any chip matches. */
  function check(product, chipCode, current) {
    return loadManifest().then(function (m) {
      var e = pick(m, product, chipCode), avail = false;
      if (e && current) { avail = newer(e.version, current); }
      return { entry: e, key: m.key, available: avail };
    });
  }

  /* fetch the file and check it against the manifest -> {bytes, crc} */
  function fetchImage(entry) {
    return fetch(base + entry.file, { cache: 'no-store' }).then(function (r) {
      if (!r.ok) { throw err('image', 'The update file is missing from the app. Reinstall the ZeroStick app.'); }
      return r.arrayBuffer();
    }).then(function (buf) {
      var bytes = new Uint8Array(buf), crc = crc32(bytes);
      if (bytes.length !== entry.size) { throw err('image', 'The update file in the app is damaged (wrong size). Reinstall the ZeroStick app.'); }
      if (entry.crc32 != null && crc !== entry.crc32) { throw err('image', 'The update file in the app is damaged. Reinstall the ZeroStick app.'); }
      return sha256(bytes).then(function (h) {
        if (h && entry.sha256 && h !== entry.sha256) { throw err('image', 'The update file in the app is damaged. Reinstall the ZeroStick app.'); }
        return { bytes: bytes, crc: crc };
      });
    });
  }

  /* ── keep the screen on while updating ─────────────────────────────── */
  var lock = null, wantLock = false;
  function grabLock() {
    if (!wantLock || lock || !navigator.wakeLock || document.visibilityState !== 'visible') { return; }
    navigator.wakeLock.request('screen').then(function (l) {
      lock = l;
      l.addEventListener('release', function () { lock = null; });
    }, function () { /* not allowed here: the screen text asks to keep it open */ });
  }
  document.addEventListener('visibilitychange', grabLock);
  function keepAwake(on) {
    wantLock = on;
    if (on) { grabLock(); } else if (lock) { try { lock.release(); } catch (e) { /* gone */ } lock = null; }
  }

  /* ── the update ────────────────────────────────────────────────────── */
  /* o = {target 'dongle'|'flex', bytes, crc, onProgress(fraction), onStage(stage, detail)}
     stages: 'checking' 'sending' 'reconnecting' 'installing' 'restarting'
     (dongle) / 'staged' 'relaying' 'flexchecking' (flex)
     -> {promise -> new version, cancel()}. Call again after a failure: it resumes. */
  var SESSION = 'zsdongle:zsOtaSession:';
  function run(o) {
    var t = TARGETS[o.target], ops = t.ops, img = o.bytes, size = img.length, crc = o.crc;
    var chunk = 128, restarts = 0, same = 0, lastOffset = -1;
    var stage = o.onStage || function () {}, prog0 = o.onProgress || function () {};
    /* the flex's bar: first half = phone -> dongle, second half = dongle -> flex */
    var prog = t.relay ? function (f) { prog0(f * 0.5); } : prog0;
    var self = { cancelled: false };

    function remember() {
      try { localStorage.setItem(SESSION + t.id, JSON.stringify({ size: size, crc: crc, chunk: chunk })); } catch (e) { /* ok */ }
    }
    function memory() {
      try { return JSON.parse(localStorage.getItem(SESSION + t.id) || 'null'); } catch (e) { return null; }
    }
    function forget() { try { localStorage.removeItem(SESSION + t.id); } catch (e) { /* ok */ } }
    function status() { return t.relay ? B.ota.flexStatus(ops) : B.ota.status(ops); }

    function begin() {
      return B.ota.begin(ops, size, crc).then(function (r) {
        if (size > r.max) { throw err('image', 'The update is too big for this ' + t.name.toLowerCase() + '.'); }
        chunk = r.chunk || 128;
        remember();
        return 0;
      }, function (e) {
        /* 12: the dongle is still sending the flex an earlier update */
        if (e && e.status === 7 && e.data && e.data[0] === 12 && t.relay) { return -1; }
        throw e;
      });
    }
    /* carry on where the device is, or start. -1 = the upload is already
       done and the dongle is relaying it to the flex */
    function open() {
      stage('checking');
      return status().then(function (st) {
        var m = memory();
        if (t.relay && st.phase >= 2 && st.phase <= 4) { return -1; }
        if (st.open && st.size === size && m && m.crc === crc && m.size === size) {
          chunk = m.chunk || 128;
          return st.received;
        }
        return begin();
      });
    }
    function reconnect(ms) {
      var until = Date.now() + ms;
      function again() {
        if (self.cancelled) { return Promise.reject(err('cancelled', 'cancelled')); }
        return B.reconnect().then(null, function () {
          if (Date.now() > until) { throw err('lost', 'The dongle did not come back.'); }
          return wait(1500).then(again);
        });
      }
      return again();
    }
    function send(offset) {
      if (self.cancelled) { return Promise.reject(err('cancelled', 'cancelled')); }
      if (offset < 0) { return relay(); }
      if (offset >= size) { return finish(); }
      if (offset === lastOffset) { same++; } else { same = 0; lastOffset = offset; }
      if (same > 6) {
        return Promise.reject(err('stuck', 'The dongle stopped answering. Keep your phone close to it and tap Try again: it carries on from where it stopped.'));
      }
      stage('sending');
      prog(offset / size);
      var piece = img.subarray(offset, Math.min(size, offset + chunk));
      return B.ota.data(ops, offset, piece).then(function (next) {
        return send(next);
      }, function (e) { return trouble(e, offset); });
    }
    function trouble(e, offset) {
      var r = e && e.data ? e.data[0] : 0;
      if (e && e.status === 7) {
        var next = B.ota.u32(e.data, 1);
        if (r === 3 || r === 5) { return send(next); }                 /* carry on from where it is */
        if ((r === 1 || r === 6) && restarts++ < 2) { return begin().then(send); }
        throw e;                                                        /* 2, 4, 7-12: say why */
      }
      if (e && e.status === 6 && r === 0x81) {                          /* PS5 port sagging */
        stage('sending', 'power');
        return wait(1000).then(function () { return send(offset); });
      }
      if (e && e.zsKind === 'timeout') { return send(offset); }         /* resend the same chunk */
      if (e && e.zsKind === 'disconnected') {
        stage('reconnecting');
        return reconnect(90000).then(open).then(send);
      }
      throw e;
    }
    function finish() {
      prog(1);
      stage('installing');
      return B.ota.end(ops).then(function (ver) {
        return t.relay ? relay() : restarted(ver);
      }, function (e) {
        if (e && e.status === 7) { return trouble(e, size); }   /* missing bytes: send them, END again */
        if (!t.relay && e && (e.zsKind === 'disconnected' || e.zsKind === 'timeout')) {
          return restarted(null);                               /* the answer was lost to the reboot */
        }
        if (t.relay && e && e.zsKind === 'timeout') { return relay(); }
        throw e;
      });
    }
    /* dongle: it resets 300 ms after END, copies the image (~2 s), starts */
    function restarted(ver) {
      var t0 = Date.now();
      forget();
      stage('restarting', ver);
      function gone() {
        if (!B.isConnected() || Date.now() - t0 > 3000) { return B.disconnect(); }
        return wait(150).then(gone);
      }
      return gone().then(function () { return wait(2500); }).then(function () {
        return reconnect(45000);
      }).then(function () { return ver; });
    }
    /* flex: the dongle relays the staged image; follow 0x3C to the end */
    function relay() {
      forget();
      var lost = 0;
      function poll() {
        if (self.cancelled) { return Promise.reject(err('cancelled', 'cancelled')); }
        return B.ota.flexStatus(ops).then(function (st) {
          lost = 0;
          if (st.phase === 5) { prog0(1); return st.version; }
          if (st.phase === 6) {
            var e = err('flex', st.error === 0xFE ?
              'The stick flex stopped answering. Turn the controller on, keep it close to the dongle, and tap Try again.' :
              B.ota.reason(st.error));
            e.reason = st.error;
            throw e;
          }
          if (st.phase === 2) { stage('staged'); prog0(0.5); }
          if (st.phase === 3) { stage('relaying'); prog0(0.5 + st.percent / 200); }
          if (st.phase === 4) { stage('flexchecking'); prog0(0.99); }
          if (st.phase === 0) { throw err('flex', 'The dongle lost the update. Tap Try again.'); }
          return wait(500).then(poll);
        }, function (e) {
          if (e && (e.zsKind === 'disconnected' || e.zsKind === 'timeout') && lost++ < 3) {
            /* the dongle carries on by itself; just get back to it */
            stage('reconnecting');
            return (B.isConnected() ? wait(500) : reconnect(90000)).then(poll);
          }
          throw e;
        });
      }
      return poll();
    }

    self.promise = open().then(send);
    self.cancel = function () {
      self.cancelled = true;
      forget();
      return B.ota.abort(ops).then(null, function () {});
    };
    return self;
  }

  window.ZSFW = {
    TARGETS: TARGETS,
    loadManifest: loadManifest,
    read: read,
    pick: pick,
    check: check,
    newer: newer,
    fetchImage: fetchImage,
    crc32: crc32,
    keepAwake: keepAwake,
    run: run
  };
})();
