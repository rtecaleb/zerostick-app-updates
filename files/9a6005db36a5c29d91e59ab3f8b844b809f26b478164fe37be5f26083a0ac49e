/* sections/16-lighting-output.js — the config's lights and what the PC sees (EXO).
 *
 * R.lighting: lighting.* (the EXO's light: effect, rainbow, brightness) per
 * config. R.padlightEdge / R.padlightStd (D660): a DualSense Edge's light
 * bar, and every other PlayStation pad's (lighting.edge / lighting.pad).
 * R.pcout: the output identity the board presents to a PC (rebuilds the USB
 * gadget).
 *
 * Screens (window.RENDERERS):  R.lighting, R.padlightEdge, R.padlightStd, R.pcout
 * Core / board routes:        /lightbar, /output/identity
 * Tests:                      test-overview-xim.js, test-settings-icons.js, test-render.js,
 *                             test-exo-light.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('lighting-output', function (SEC) {
  var helpHTML = SEC.helpHTML;   /* D285: every explanation behind a "?" (2026-10-31) */
  /* from the files before this one */
  var card = SEC.card, esc = SEC.esc, ico = SEC.ico, lbName = SEC.lbName, note = SEC.note,
      R = SEC.R, seg = SEC.seg, sh = SEC.sh, wireDoors = SEC.wireDoors, ZS = SEC.ZS,
      LM = SEC.lightModel, brCarHTML = SEC.brCarHTML,
      wireBrCar = SEC.wireBrCar, colCarHTML = SEC.colCarHTML, wireColCar = SEC.wireColCar,
      ovLightD660 = SEC.ovLightD660, ovLightTargetsOK = SEC.ovLightTargetsOK,
      ovExoPreview = SEC.ovExoPreview, ovExoLg = SEC.ovExoLg;

  /* ── Game Roles — the two buttons that matter ─────────────────── */
  /* PC Output — what Windows sees when this config is active.
     Windows has no native "PlayStation pad" concept: virtually every PC game
     speaks XInput, which IS the Xbox 360 pad. So that's the default, and the
     alternatives are there for the games that don't. */
  /* Lighting lives per CONFIG, not globally: the colour should change when
     you switch config, so you can tell at a glance which one is live. */
  R.lighting = function(p){
    /* The board is the source of truth. profile.lighting is a real validated
       field now, so the colour genuinely follows the config: the engine
       applies it whenever a config is activated, down the same USB interface
       it already holds. Local storage is only the offline fallback.

       THE COLOUR IS NOT SET HERE (D84 follow-up, 2026-09-05). lighting.color
       has ONE control in the app: Overview's ‹ swatch › carousel, whose
       swatch is also the wheel. This screen READS the colour into one row
       that is a door back to Overview, and owns the rest of the block — the
       mode (one colour / rainbow / off), brightness, rainbow speed. Its
       push() sends the colour it was handed, unchanged, and never touches
       the list mark (p.color): screen map §12, one writer per field. The
       swatch strip and the wheel that stood here wrote the same field by the
       same route as Overview's carousel — two controls, one field. */
    var full = ZS.live.full[p.id] || {};
    var lg   = full.lighting || {};
    var mode   = lg.mode   || ZS.store.vals['lightbarMode|'+p.id] || 'solid';
    var col    = (lg.color || ZS.store.vals['lightbar|'+p.id] || '0080ff').replace('#','');
    var bright = lg.brightness;
    if(bright===undefined || bright===null) bright = ZS.store.vals['lightbarBright|'+p.id];
    if(bright===undefined || bright===null) bright = 100;
    var speed  = lg.speed;
    if(speed===undefined || speed===null) speed = ZS.store.vals['lightbarSpeed|'+p.id];
    if(speed===undefined || speed===null) speed = 20;
    if(mode!=='rainbow' && mode!=='off') mode = 'solid';

    /* the three values lighting.mode can hold, in the seg's order */
    var MODES  = ['One colour', 'Rainbow', 'Off'];
    var MODE_V = ['solid', 'rainbow', 'off'];
    function colName(){ var n = lbName(col); return n.charAt(0)==='#' ? 'Your colour' : n; }

    /* the colour, read-only: one row naming it in words, a door to the
       control that sets it. The dot is state, never a write. */
    function colRowHTML(){
      var nm = colName();
      return '<div class="grp-card"><div class="lrow tapper" role="button" tabindex="0" id="lb-colrow" '+
        'data-door="overview" data-doorlab="Device" '+
        'aria-label="'+esc('Colour: '+nm+' — set on Device, under the config’s name')+'">'+
        '<span aria-hidden="true" style="flex:none;width:22px;height:22px;border-radius:50%;'+
          'background:#'+esc(col)+';margin-right:10px;border:1px solid var(--line)"></span>'+
        '<span class="src">Colour · '+esc(nm)+
          '<em style="display:block;font-weight:400;font-style:normal;color:var(--muted);'+
          'font-size:11.5px;white-space:normal;line-height:1.4">set on Device, under the config’s name</em></span>'+
        '<span class="rt"><span class="arrow">›</span></span></div></div>';
    }
    /* ONE control over lighting.mode. It replaced an on/off switch plus a
       Rainbow swatch, which were two controls writing the one field. */
    function modeSegHTML(){
      var idx = MODE_V.indexOf(mode);
      /* D660: this is the EXO's light; "Off saves a little pad battery"
         belongs to the controller's light bar now (its screen's "?") */
      return '<div id="lb-mode">'+
        seg('EXO light', MODES, idx<0 ? 0 : idx, true, null,
            'Rainbow cycles while you play')+'</div>';
    }
    function noteHTML(){
      return note(mode==='rainbow'
        ? 'Cycling the spectrum. Runs <b>while you play</b> — it never interrupts your input.'
        : mode==='off'
          ? 'EXO light off.'
          : 'Now <b>'+esc(colName())+'</b>.');
    }

    var html =
      /* the intro paragraph died (screen-map §10) — the header and the live
         note at the foot carry the story */
      sh('EXO light')+
      colRowHTML()+
      card(modeSegHTML()+
           '<div class="fld col"><div class="flab">Brightness<span class="rv"></span></div>'+
             '<input class="rng lbbright" type="range" min="0" max="100" value="'+bright+'" data-unit="%" data-nosave="1"></div>'+
           '<div class="fld col lb-speed"'+(mode==='rainbow'?'':' style="display:none"')+'>'+
             '<div class="flab">Rainbow speed<span class="rv"></span></div>'+
             '<input class="rng lbspd" type="range" min="1" max="100" value="'+speed+'" data-unit="%" data-nosave="1"></div>')+
      '<div id="lb-note">'+noteHTML()+'</div>'+
      /* D660: an older config that gave the EXO its own colour (D262's
         lighting.exo) still shows it; say so, and how it goes */
      (LM && LM.exo(lg).legacy === 'own'
        ? helpHTML('lb-exo-own', 'Your EXO colour', 'This config gave the EXO a colour of its own in an earlier version '+
            '(<b>#'+esc(LM.exo(lg).color)+'</b>), and the EXO still shows it. Pick a colour on the Device page and that one replaces it.')
        : '')+
      helpHTML('lb-what', 'EXO light', 'This is the light on your <b>EXO</b>. Its colour is set on the Device page, under the config\u2019s name. '+
        '<b>Rainbow</b> cycles the spectrum while you play, and never interrupts your input. '+
        'Your controller\u2019s light bar follows this light unless you change it under <b>More</b> on the Device page. '+
        'The adapter\u2019s own warning lights (Navigate Mode, a config that could not be read) show whatever you choose here.');
      /* An "Adapter light" swatch row stood here, honestly labelled as reaching
         nothing ("the board has no LED wired up yet"). An honest label does not
         make it a control — it was still eight tappable colours over hardware
         that does not exist. It is gone until an LED is actually wired. */

    return { html: html, after: function(root){
      /* One place that sends. Everything below just changes state and calls
         it, so the POST and the saved profile can never drift apart. */
      function push(next, label){
        if(next.mode!==undefined) mode = next.mode;
        if(next.brightness!==undefined) bright = next.brightness;
        if(next.speed!==undefined) speed = next.speed;

        ZS.store.vals['lightbarMode|'+p.id]   = mode;
        ZS.store.vals['lightbarBright|'+p.id] = bright;
        ZS.store.vals['lightbarSpeed|'+p.id]  = speed;
        ZS.persistStore();

        /* remembered with the config — the colour rides along UNCHANGED:
           the document's own when it has one, else what this screen was
           handed. This screen never picks one; Overview's carousel does. */
        if(ZS.live.online!==false && ZS.live.full[p.id]){
          /* D660: every other key of the block stays (a controller's own
             choice, lighting.pad / .edge); a new brightness is the EXO's,
             and a controller that followed it keeps the one it had */
          var split = !!(ovLightTargetsOK && ovLightTargetsOK());
          var patch = { mode: mode, speed: speed };
          if(next.brightness!==undefined) patch.brightness = bright;
          ZS.putProfileDebounced(p.id, function(f){
            var have = f.lighting || {};
            var keep = (typeof have.color==='string' && /^[0-9a-fA-F]{6}$/.test(have.color)) ? have.color : col;
            if(LM){
              LM.setExo(f, patch, split);
              f.lighting.color = keep;
              f.lighting.brightness = Math.round(bright);
            } else {
              f.lighting = { mode:mode, color:keep,
                             brightness:Math.round(bright), speed:Math.round(speed) };
            }
          });
        }
        /* ...and applied right now, so you see it as you choose it, where
           the adapter has that live preview (a Core since D262: the
           controller's light bar, until Save or "exit without saving").
           On a Core only for the config that is RUNNING: a preview of
           another config would light the pad in a colour the game is not
           using, and only the running one's Save or discard ends it. */
        /* 2026-11-04: through the Device page's one EXO preview
           (SEC.ovExoPreview), so this screen, the colour carousel and the
           Device-page brightness light the EXO the same way: target "exo"
           where the Core reads the split, the old body where it does not */
        var shown = null;
        if(ovExoPreview && LM){
          var pv = { lighting: ovExoLg(p) };
          var pat = { mode: mode, speed: speed };
          if(next.brightness!==undefined) pat.brightness = bright;
          LM.setExo(pv, pat, false);
          pv.lighting.brightness = Math.round(bright);
          shown = ovExoPreview(p, pv.lighting);
        } else if(!((ZS.productHides && ZS.productHides('lightbarPreview')) ||
                    (ZS.productId && ZS.productId() === 'core' && p.id !== ZS.activeId))){
          shown = ZS.api('/lightbar','POST',{ mode:mode, color: mode==='solid'? col : null,
                                    brightness:Math.round(bright),
                                    speed:Math.round(speed),
                                    enabled: mode!=='off' });
        }
        /* no document: the words say why it is not on the board (offline,
           not on it, or not loaded yet), never "offline" with it plugged in */
        if(label && ZS.noDocWhy && ZS.noDocWhy(p.id)){
          ZS.noDocSay(p.id, label, 'saved on this device, your board is offline');
        } else if(!shown){
          if(label) ZS.toast(label);
        } else shown
          .then(function(j){
            if(label) ZS.toast(j && j.ok ? label : ((j && j.error) || 'Board did not take it'));
          })['catch'](function(){ if(label) ZS.toast(label); });

        var sp = root.querySelector('.lb-speed');
        if(sp) sp.style.display = (mode==='rainbow') ? '' : 'none';
        var nt = root.querySelector('#lb-note');
        if(nt) nt.innerHTML = noteHTML();
      }

      /* the mode seg — wire() lights the tapped button; this sends it */
      var ms = root.querySelector('#lb-mode');
      if(ms) ms.querySelectorAll('.seg2 button').forEach(function(b, i){
        b.addEventListener('click', function(){
          var v = MODE_V[i] || 'solid';
          push({mode:v}, v==='rainbow' ? 'Light bar → rainbow'
                        : v==='off' ? 'Light bar off' : 'Light bar → '+colName());
        });
      });

      var br = root.querySelector('.lbbright');
      if(br){
        br.addEventListener('input',  function(){ push({brightness:+br.value}); });
        br.addEventListener('change', function(){ push({brightness:+br.value}, 'Brightness → '+br.value+'%'); });
      }

      var spd = root.querySelector('.lbspd');
      if(spd){
        spd.addEventListener('input',  function(){ push({speed:+spd.value}); });
        spd.addEventListener('change', function(){ push({speed:+spd.value}, 'Rainbow speed → '+spd.value+'%'); });
      }

      /* the colour row is a door back to Overview */
      wireDoors(root, p);
    }};
  };

  /* ── D660: A CONTROLLER'S LIGHT BAR ────────────────────────────────
     The owner, 2026-11-04: "the More is where you can adjust a Sony light
     bar controller for an Edge controller and normal one". One screen, two
     doors: `kind` 'edge' (a DualSense Edge, 054C:0DF2) or 'std' (every other
     PlayStation pad: the DualSense 054C:0CE6, the DualShock 4 and the rest).
     Three choices, big keys: follow the EXO, its own colour (the Device
     page's own colour carousel, so it is learned once), or off; and its own
     brightness (the Device page's brightness carousel). Every explanation
     is behind a "?". Writes lighting.pad / lighting.edge through the model
     (sections/09-overview.js LM), previews on that kind of pad alone. */
  var PAD_MODES = [['same', 'Follow the EXO'], ['own', 'Own colour'], ['off', 'Off']];
  function padLightScreen(p, kind){
    var d660 = !!(ovLightD660 && ovLightD660());
    var title = kind === 'edge' ? 'DualSense Edge light bar'
      : (d660 ? 'DualSense light bar' : 'Controller light bar');
    var full = ZS.live.online!==false ? ZS.live.full[p.id] : null;
    if(!LM || (!full && ZS.live.online===false)){
      return { html: sh(title) + note('Your board is offline. The light bar settings are kept on the board, '+
        'so they can be changed when it is connected.'), after: function(){} };
    }
    /* 2026-11-04: the board is connected but has no copy of this config
       (the owner's app-only "NBA 2K27"; the screen used to call that
       "offline"). The page still works as a live preview on the controller
       (POST /lightbar target edge / std, which needs no config), from a
       working copy here; the banner at the top (ZS.noDocDress) says why it
       is not kept, and puts the config on the board in one tap. */
    var scratch = full ? null : { lighting: (ovExoLg ? ovExoLg(p) : {}) };
    function docNow(){ return ZS.live.full[p.id] || scratch; }
    var ID = 'pl-' + kind;

    function bodyHTML(){
      var lg = LM.lgOf(docNow());
      var t = LM.pad(lg, kind), shows = LM.padShows(lg, kind), e = LM.exo(lg);
      var segH = '<div class="fld col ovlrow"><div class="flab">Light bar</div>'+
        '<div class="seg2 ovlseg pl-seg" role="radiogroup" aria-label="'+esc(title)+'">'+
        PAD_MODES.map(function(m){
          var on = t.mode === m[0];
          return '<button type="button" role="radio" aria-checked="'+on+'" class="'+(on?'on':'')+'" '+
            'data-plmode="'+m[0]+'">'+esc(m[1])+'</button>';
        }).join('')+'</div></div>';
      var colH = t.mode !== 'own' ? '' :
        '<div class="fld col pl-col"><div class="flab">Colour</div>'+
          colCarHTML(ID+'-col', '#'+(t.color || e.color))+'</div>';
      var brH = t.mode === 'off' ? '' :
        '<div class="fld col pl-br"><div class="flab">Brightness</div>'+
          brCarHTML(ID+'-br', t.brightness, title+' brightness')+'</div>';
      var nowWords = t.mode === 'off' ? 'Light bar <b>off</b>.'
        : t.mode === 'own' ? 'Now <b>'+esc(lbName(shows.color).charAt(0)==='#' ? 'your colour' : lbName(shows.color))+'</b> at '+
            (shows.brightness <= 0 ? 'no light' : shows.brightness+'%')+'.'
        : 'Following the EXO'+(shows.mode==='rainbow' ? ' (rainbow)' : shows.mode==='off' ? ' (its light is off)' : ' (<b>'+esc(lbName(shows.color).charAt(0)==='#' ? 'your colour' : lbName(shows.color))+'</b>)')+
            ' at '+(shows.brightness <= 0 ? 'no light' : shows.brightness+'%')+'.';
      var which = kind === 'edge'
        ? 'This is for a <b>DualSense Edge</b>. A standard DualSense, a DualShock 4 and every other PlayStation pad have their own setting beside it, under More.'
        : (d660 ? 'This is for a <b>DualSense</b>, a <b>DualShock 4</b> and every other PlayStation pad. A DualSense Edge has its own setting beside it, under More.'
                : 'This is for every PlayStation controller plugged into the adapter.');
      var ps5 = (ZS.live.status && ZS.live.status.light && ZS.live.status.light.consoleLight === true)
        ? 'On a <b>PS5</b>, when the game sets the light bar itself (to show your player number, or your health), the console\u2019s colour shows instead of this one. '+
          'This colour comes back as soon as the console stops setting it.'
        : 'On a <b>PS5</b>, some games set the light bar themselves (to show your player number, or your health). '+
          'This adapter keeps the colour you choose here instead, so the light bar always shows your config.';
      return sh(title)+
        card(segH+colH+brH)+
        '<div class="pl-note">'+note(nowWords)+'</div>'+
        helpHTML(ID+'-what', title, which+' '+
          '<b>Follow the EXO</b> shows the EXO\u2019s colour and effect, the one on the Device page. '+
          '<b>Own colour</b> gives this controller a colour of its own. '+
          '<b>Off</b> keeps the light bar dark, and saves a little battery on a wireless pad. '+
          'The brightness here is this controller\u2019s own: dimming the EXO does not change it. '+
          /* one "?" for the whole screen (three stacked chips read as noise) */
          ps5+' '+
          'Navigate Mode and the adapter\u2019s warnings still show on the light bar whatever you choose here, '+
          'because each one means your controller is not doing what your config says. '+
          'With no config saved yet, the light bar shows the standard blue.');
    }

    return { html: '<div id="'+ID+'">'+bodyHTML()+'</div>', after: function(root){
      function preview(){
        if((ZS.productHides && ZS.productHides('lightbarPreview')) ||
           (ZS.productId && ZS.productId() === 'core' && p.id !== ZS.activeId)) return null;
        if(ZS.live.online===false) return null;
        var lg = LM.lgOf(docNow());
        return ZS.api('/lightbar', 'POST', LM.padPreview(lg, kind, d660));
      }
      function write(patch, words){
        /* the cached document moves with the staged write so the repaint
           shows the choice; the board copy goes on Save (D257) */
        var f = ZS.live.full[p.id];
        if(!f){
          /* no board copy: the working copy moves, the controller shows it,
             and the words say why it is not kept (and how to keep it) */
          LM.setPad(scratch, kind, patch);
          var shown = preview();
          if(ZS.noDocSay) ZS.noDocSay(p.id, words + (shown ? ' on your controller now' : ''));
          return;
        }
        if(window.ZS_AUTOSAVE) LM.setPad(f, kind, patch);
        ZS.putProfileDebounced(p.id, function(doc){ LM.setPad(doc, kind, patch); });
        var later = !window.ZS_AUTOSAVE ? ' \u2014 press Save to keep it' : '';
        var pv = preview();
        if(pv && pv.then) pv.then(function(j){ ZS.toast(j && j.ok ? words+later : ((j && j.error) || 'Board did not take it')); })
          ['catch'](function(){ ZS.toast(words+later); });
        else ZS.toast(words+later);
      }
      function draw(){
        var box = root.querySelector('#'+ID);
        if(!box) return;
        box.innerHTML = bodyHTML();
        wire(box);
      }
      /* the staged copy (ZS.live.full) is what the repaint reads; on a Core
         without autosave, putProfileDebounced moves it (D257) */
      function wire(box){
        box.querySelectorAll('[data-plmode]').forEach(function(b){
          b.addEventListener('click', function(){
            var m = b.getAttribute('data-plmode');
            write({ mode: m }, title+' \u2192 '+(m === 'same' ? 'follows the EXO' : m === 'own' ? 'its own colour' : 'off'));
            setTimeout(draw, 0);
          });
        });
        var cc = box.querySelector('#'+ID+'-col');
        if(cc){
          var t0 = LM.pad(LM.lgOf(docNow()), kind);
          wireColCar(cc, '#'+(t0.color || LM.exo(LM.lgOf(docNow())).color), function(c, commit){
            if(!commit) return;            /* the wheel settles before it writes */
            write({ mode: 'own', color: c.v }, title+' \u2192 '+c.t);
            setTimeout(draw, 0);
          });
        }
        var bc = box.querySelector('#'+ID+'-br');
        if(bc) wireBrCar(bc, LM.pad(LM.lgOf(docNow()), kind).brightness, function(v){
          write({ brightness: v }, title+' brightness \u2192 '+(v <= 0 ? 'off' : v+'%'));
          setTimeout(draw, 0);
        });
      }
      wire(root.querySelector('#'+ID) || root);
    }};
  }
  R.padlightEdge = function(p){ return padLightScreen(p, 'edge'); };
  R.padlightStd = function(p){ return padLightScreen(p, 'std'); };

  /* What the PC or console thinks is plugged in — a REAL choice now, not a
     stored preference. Picking one rebuilds the USB gadget on the board, so
     Windows genuinely re-enumerates it as that device. The board is asked what
     it can actually be, so this list never offers something we cannot deliver. */
  R.pcout = function(p){
    var WHY = {
      dualsense: 'The game sees a <b>PlayStation controller</b>. In-game prompts show '+
                 '✕ ○ □ △, and games that expect a PlayStation pad are happy. This is '+
                 'what your board is set to right now by default.<br><br>'+
                 'It is also the <b>only setting that gives you rumble</b>: the game\'s '+
                 'force feedback comes back down the cable and shakes the controller '+
                 'in your hands.',
      ds4:       'The game sees a <b>PlayStation 4 controller</b> — a DualShock 4, the pad '+
                 'before the DualSense. Prompts still show ✕ ○ □ △.<br><br>'+
                 '<b>Why you would pick this over the PlayStation controller above:</b> a '+
                 'lot of PC games were built when the DS4 was the current pad, and they '+
                 'check exactly which controller you have before switching on their '+
                 'controller aim assist or drawing the right button icons. Those games '+
                 'recognise a DS4 and do not always recognise a DualSense. If a game '+
                 'ignores your pad, or shows keyboard keys instead of buttons, try this '+
                 'one.<br><br>'+
                 'Two honest notes: it is for <b>PC only</b> — a real PlayStation 4 asks '+
                 'the controller to prove it is genuine, ZeroStick cannot answer that, '+
                 'and the console would drop it after a few minutes. And <b>rumble does '+
                 'not come back to your hands</b> on this setting; for rumble use the '+
                 'PlayStation controller above.',
      generic:   'A plain USB gamepad — Windows calls this <b>DirectInput</b>. Very widely '+
                 'supported, but a few modern games only look for an Xbox pad and will '+
                 'ignore it.<br><br><b>No rumble on this one</b>, and not just "not yet": '+
                 'this pretend controller does not describe any way for a game to send '+
                 'motor levels to it. For rumble use the PlayStation controller above.',
      xinput:    'The game sees an <b>Xbox 360 controller</b> — the format almost every PC '+
                 'game expects. In-game prompts show <b>A B X Y</b>, and the games that only '+
                 'look for an Xbox pad will finally find one. Windows loads its own Xbox '+
                 'driver for it.<br><br>Two honest notes: this reports Microsoft\'s controller '+
                 'ids (no Microsoft code is used, and nothing is unlocked that you have not '+
                 'paid for), and <b>rumble from the game does not reach your controller yet</b> '+
                 'on this setting — for rumble use the PlayStation controller above.'
    };

    var html =
      sh('The PC currently sees')+
      '<div id="pcout-now">'+card('<div class="stat"><span>Asking the board…</span><b>—</b></div>')+'</div>'+
      helpHTML('pco-what', 'What your PC sees',
           'Pick what your PC sees. This does <b>not</b> change the controller in your hands — '+
           'only the device ZeroStick pretends to be.')+
      sh('Change it to')+
      '<div id="pcout-opts"></div>'+
      '<div id="pcout-why"></div>'+
      note('<b>Switching takes a second or two</b> and looks to Windows like unplugging one '+
           'controller and plugging in another. <b>Close the game first.</b>', 'warn', true)+
      sh('Your input')+
      card(
        '<div class="stat"><span>Playing with</span><b>'+esc(ZS.INP[p.input]||p.input)+'</b></div>'+
        /* OVERVIEW, and no longer Aim. The selector is on Overview under
           Setup — part of what a config IS — and Aim only echoes it for the
           configs that have a pad; a mouse config's Aim screen is the Hip/ADS
           pager and carries no switch at all, so "change it in Aim" was a
           dead end for exactly the configs most likely to read this line. */
        '<div class="stat"><span>Change it in</span><b>Device</b></div>')+
      helpHTML('pco-input', 'Your input', ZS.inputShows(p.input,'mouse') && ZS.inputShows(p.input,'controller')
        ? 'You are playing with a <b>joystick and a mouse</b>. Both reach the console as the one '+
          'output above: stick and mouse both aim, and every bind on either is live.'
        : ZS.inputShows(p.input,'mouse')
          ? 'You are playing with <b>mouse and keyboard</b>. With a pad output selected, your WASD '+
            'becomes the left stick and your mouse the right stick.'
          : 'You are playing with a <b>controller</b>. ZeroStick passes it through as the output '+
            'above, applying your bindings, aim tuning and Scripts.');

    return { html: html, after: function(root){
      var busy = false;

      /* P3: the identity's family mark. PS blue for the two PlayStation
         identities, Xbox green for XInput/X360 — and a NEUTRAL muted pad for
         a generic DirectInput device, because a generic HID is not a family
         and a family colour there would be a lie (DESIGN.md: decoration
         never overwrites a signal). Pure function of the option id, so a
         poll repainting identical state emits identical bytes. */
      function pcFamArt(oid){
        var fam = (oid === 'dualsense' || oid === 'ds4') ? 'ps'
                : (oid === 'xinput' || oid === 'x360') ? 'xb' : '';
        if(fam && window.ZSMARK){
          return '<span class="gly-deco" aria-hidden="true" style="margin-right:8px">'+
            ZSMARK.badge(fam, {size:20, decorative:true})+'</span>';
        }
        return '<span class="gly-deco" aria-hidden="true" style="width:20px;height:20px;'+
          'color:var(--muted);margin-right:8px">'+ico('pad', 20)+'</span>';
      }

      function paint(data){
        var now = root.querySelector('#pcout-now');
        var opts = root.querySelector('#pcout-opts');
        var why = root.querySelector('#pcout-why');
        if(!now || !opts) return;

        var id = (data && data.identity) || 'unknown';
        var label = (data && data.label) || 'not set up yet';
        now.innerHTML = card('<div class="stat"><span>Windows sees</span><b>'+
          (data ? pcFamArt(id) : '')+esc(label)+'</b></div>');

        var list = (data && data.options) || [];
        if(!list.length){
          opts.innerHTML = card('<div class="stat"><span>Board offline</span><b style="color:var(--amber)">—</b></div>');
          return;
        }
        opts.innerHTML = card(list.map(function(o){
          return '<div class="lrow pcopt'+(o.id===id?' on':'')+'" data-id="'+esc(o.id)+'">'+
                 '<span class="src">'+pcFamArt(o.id)+esc(o.label)+'</span>'+
                 '<span class="rt">'+(o.id===id?'<b style="color:var(--green)">● in use</b>':'<button class="ib">use</button>')+'</span>'+
                 '</div>';
        }).join(''));
        if(why) why.innerHTML = WHY[id] ? helpHTML('pco-why', 'About this output', WHY[id]) : '';

        [].slice.call(opts.querySelectorAll('.pcopt')).forEach(function(row){
          row.addEventListener('click', function(){
            var want = row.dataset.id;
            if(busy || want === id) return;
            busy = true;
            ZS.toast('Switching… Windows will see it disconnect and come back');
            var wantLabel = (list.filter(function(o){ return o.id===want; })[0] || {}).label || want;
            ZS.api('/output/identity','POST',{identity:want}).then(function(j){
              busy = false;
              if(j && j.ok){ ZS.toast('Now showing as '+wantLabel); load(); }
              else { ZS.toast((j && j.error) || 'The board could not switch'); }
            })['catch'](function(){ busy=false; ZS.toast('Could not reach the board'); });
          });
        });
      }

      function load(){
        if(ZS.live.online===false){ paint(null); return; }
        ZS.api('/output/identity').then(function(j){
          paint(j && j.ok ? j.data : null);
        })['catch'](function(){ paint(null); });
      }
      load();
    }};
  };
});
