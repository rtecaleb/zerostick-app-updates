    { "id": "retic",  "name": "Crosshair",    "rect": [0.44, 0.42, 0.12, 0.16], "purpose": "reticle" }
  ],
  "assist": { "strength": 0.35, "activation": "ads", "maxCorrection": 0.25 }
}
