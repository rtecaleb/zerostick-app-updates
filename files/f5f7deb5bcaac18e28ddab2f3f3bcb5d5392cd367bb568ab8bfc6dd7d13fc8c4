      return '<div class="grp-card xcard xact" data-xact="1">'+
        '<div class="xacthdrow">'+
          '<button type="button" class="xacthd" data-xacttog="1" aria-expanded="'+(open?'true':'false')+'" aria-controls="xact-body">'+
            '<span class="xtitle">Activation</span>'+
            '<span class="xactsum">'+esc(actSummary(mt, aimName))+'</span>'+
            '<span class="xchev" aria-hidden="true">›</span>'+
          '</button>'+(q ? q.chip : '')+
        '</div>'+(q ? q.fold : '')+
        '<div class="xactbody" id="xact-body"'+(open ? '' : ' hidden')+'>'+
        /* D377: XIM's sentence first, then what raises aiming today */
        '<div class="xsub">Customize how Aim Down Sight gets activated.</div>'+
        '<div class="xsub">'+line+'</div>'+
        '<button class="xmore" data-door="roles" data-doorlab="Fire & Aim" aria-label="Activation — choose which button counts as aiming">•••</button>'+
        adsDelayHTML(mt)+
        (hasPad
          ? helpHTML('aim-stance-pad', 'ADS on a controller',
              '<b>What aiming means on a pad.</b> Your board raises “aiming” when you pull <b>L2</b>'+
              (aimName ? ', or hold <b>'+esc(aimName)+'</b>' : ' (or hold the button set here)')+
              ' — a hair trigger in Aim > Trigger Settings lowers that point. <b>ADS sensitivity</b> applies '+
              'only while that is true; inherited from hip, your hip Sensitivity applies whether you aim or '+
              'not. <b>Aim help</b> reads the same flag — Screen Assist ▸ “When it works” can be set to '+
              'fire only while you aim — and so does any Script set to “only while aiming”.')
          : '')+
        '</div></div>';
    }
    /* the closed Activation card's one line: the Core's delay ("Delay
       224 ms · smooth on", "No delay" when there is none: a bare "Off" read
       as if aiming itself were off); an EXO has no delay
       stage, so it names the aim button instead */
    function actSummary(mt, aimName){
      if(ZS.productHides && ZS.productHides('aimXim'))
        return aimName ? 'Hold '+aimName : (hasPad ? 'L2' : 'Choose a button');
      var act = (typeof mt.adsActivateMs === 'number' && mt.adsActivateMs > 0) ? mt.adsActivateMs : 0;
      var deact = (typeof mt.adsDeactivateMs === 'number' && mt.adsDeactivateMs > 0) ? mt.adsDeactivateMs : 0;
      return actSummaryOf(act, deact, mt.adsSmoothTransition === true);
    }
    function actSummaryOf(act, deact, smooth){
      if(!(act > 0) && !(deact > 0)) return 'No delay';
      var n = function(v){ return String(Math.round(v * 10) / 10); };
      return 'Delay '+n(act)+' ms'+(deact > 0 ? ' · '+n(deact)+' ms out' : '')+
        (smooth ? ' · smooth on' : '');
    }
    /* the summary follows the card's own controls (a step, a typed
       number, the switch) so it is right the moment the card closes */
    function wireActivation(root){
      var card = root.querySelector('[data-xact]');
      if(!card) return;
      var tog = card.querySelector('[data-xacttog]');
      var body = card.querySelector('.xactbody');
      var sum = card.querySelector('.xactsum');
      function paint(){
        if(!sum || (ZS.productHides && ZS.productHides('aimXim'))) return;
        var svs = card.querySelectorAll('.xdelay .stp .sv');
        var a = svs[0] ? parseFloat(svs[0].textContent) || 0 : 0;
        var d = svs[1] ? parseFloat(svs[1].textContent) || 0 : 0;
        var sw = card.querySelector('.xdelay .sw');
        sum.textContent = actSummaryOf(a, d, !!(sw && sw.classList.contains('on')));
      }
      card.addEventListener('zsstep', paint);
      card.addEventListener('click', function(){ setTimeout(paint, 0); });
      if(tog && body) tog.addEventListener('click', function(){
        var open = body.hasAttribute('hidden');
        if(open) body.removeAttribute('hidden'); else body.setAttribute('hidden', '');
        tog.setAttribute('aria-expanded', open ? 'true' : 'false');
        aimActSet(open);
        paint();
      });
    }
    /* the footer line under an ADS page: a button when a tap can flip the
       inheritance (the stick's adsGain), a plain line when the controls
       above already are the switch (the mouse's 0 / "Same as hip") */
    function footHTML(text, key){
      return key
        ? '<button class="xfoot" data-xinherit="'+key+'">'+text+'</button>'
        : '<div class="xfoot xfoot-static">'+text+'</div>';
    }
    /* The smoothing carousel's markup, in ONE place. data-noswipe is the
       shell's swipe refusal list (phone.html's CTRL selector does NOT match a
       bare <button>, which is what these arrows are), so a copy that forgot it
       would turn a preset drag into a stance swipe. Arrows disable at the
       ends; they never wrap. */
    function smcarHTML(attrs, preset, idx, n){
      return '<div class="smcar" data-noswipe="1"'+(attrs||'')+'>'+
        '<button class="arr" data-d="-1" aria-label="previous smoothing preset"'+(idx<=0?' disabled':'')+'>‹</button>'+
        '<span class="smval" role="status">'+esc(preset)+'</span>'+
        '<button class="arr" data-d="1" aria-label="next smoothing preset"'+(idx>=n-1?' disabled':'')+'>›</button>'+
      '</div>';
    }

    /* One mouse stance page. data-key scopes the local cache, so the two
       pages' identical labels cannot share a cached value. BOTH pages are
       always in the DOM — the stance tabs only flip .aimoff — so every
       control on both pages is wired on every render. data-stance="1" marks
       the pager's panes for showStance(); the stick page is an .aimpage too
       but not a stance of THIS pager. */
    /* FINE AIM on BOTH stance pages, in the card itself (the owner,
       2026-10-01: "fine aim should be in the aim tabs for hip and ads").
       Hip writes fineAim; ADS writes adsFineAim (absent = same as hip, so it
       shows hip's value until it is moved). */
    function fineAimHTML(ads){
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      var hip = +mt.fineAim || 0;
      var v = ads ? ((typeof mt.adsFineAim === 'number') ? mt.adsFineAim : hip) : hip;
      return labHelp(stepper('Fine aim', Math.round(v * 100), 5, 0, 100, '%',
        ads ? 'Makes small, slow mouse moves count for more while aiming down sights. 0 = off.'
            : 'Makes small, slow mouse moves count for more. Flicks stay the same. 0 = off.',
        B(ads ? 'mouseTranslation.adsFineAim' : 'mouseTranslation.fineAim', .01, {mn:0, mx:1})),
        'aim-fine-'+(ads ? 'ads' : 'hip'), 'Fine aim', ads ? AIM_HELP.fineAds : AIM_HELP.fine);
    }
    /* D376 amended (owner, 2026-10-14: "remove cm/360 wording and just use
       a speed on a 0-100 scale to not confuse users, but obviously it's
       still cm/360 in the back end; maybe show the cm/360 values in tiny
       writing"): SPEED is the card's one sensitivity control. The field is
       unchanged, mouseTranslation.cm360 / adsCm360 in cm of mouse per full
       turn, stored as 500 / Speed by the 'recip' bind (100 = 5 cm), so a
       config shows the same turn it always had. Under it, small and muted,
       the same number in cm/360 for XIM players: words only, never a second
       control. 0 keeps its meaning: Standard on Hip, Same as hip on ADS. */
    /* the words, from the two fields in cm (0 = unset). At 0 the stepper
       already says Standard / Same as hip, so the small print does not
       repeat it: it says there is no cm/360, or the one ADS borrows */
    /* D392 (audit item 1): EVERY config runs cm/360, so 0 always has a
       number. Hip at 0 is Standard, 34 cm/360 (ZSPROFILE.STANDARD_CM360);
       a config from before D392 that still says 0 keeps the speed it
       always turned (ZSPROFILE.legacyCm360) until its next save writes that
       number down. ADS at 0 is hip's speed, exactly (no hidden x0.55). */
    function hipCmNow(){
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      if(typeof mt.cm360 === 'number' && mt.cm360 > 0) return { cm: mt.cm360, why: '' };
      var Z = window.ZSPROFILE;
      var onCm = mt.adsSensitivityScale === 1;
      if(!Z || onCm) return { cm: (Z && Z.STANDARD_CM360) || 34, why: 'Standard' };
      return { cm: Z.legacyCm360(mt), why: 'your speed from before' };
    }
    function cmLineText(ads, cm, hipCm){
      var r = function(v){ return Math.round(v * 10) / 10; };
      if(cm > 0) return '≈ '+r(cm)+' cm/360°';
      var h = hipCmNow();
      if(!ads) return '≈ '+r(h.cm)+' cm/360° ('+h.why+')';
      return '≈ '+r(hipCm > 0 ? hipCm : h.cm)+' cm/360° (from hip)';
    }
    function cmField(v){ return (typeof v === 'number' && v > 0) ? v : 0; }
    function speedHTML(ads){
      var mode = ads ? 'ads' : 'hip';
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      var st = stepper('Speed', 0, 1, 0, 100, '',
          ads ? 'Higher is faster. 0 = same as hip.' : 'Higher is faster.',
          B(ads?'mouseTranslation.adsCm360':'mouseTranslation.cm360', 500, {t:'recip', mn:5, mx:200}),
          /* 0 is the switch; Speed 2.5 is 200 cm, so nothing between is a
             speed (the gap snaps); the first + from 0 lands on 14.5 */
          ' data-gapmin="2.5" data-suggest="14.5" data-speedcm="'+mode+'"'+
          /* D377: 0 says its word, not a number (wireZeroWord) */
          ' data-zeroword="'+(ads ? 'Same as hip' : 'Standard')+'"');
      /* the small print sits inside the setting, under its stepper */
      var end = st.lastIndexOf('</div>');
      st = st.slice(0, end)+
        '<div class="xcm" data-cmline="'+mode+'">'+
          esc(cmLineText(ads, cmField(ads ? mt.adsCm360 : mt.cm360), cmField(mt.cm360)))+'</div>'+
        st.slice(end);
      return labHelp(st, 'aim-speed-'+mode, 'Speed', ads ? AIM_HELP.speedAds : AIM_HELP.speed);
    }
    /* D377: every stepper with a data-zeroword shows that word while it
       holds 0 (CSS .svzero), repainted on each step and typed value */
    function wireZeroWord(root){
      if(!root || !root.querySelectorAll) return;
      function paintAll(){
        root.querySelectorAll('.sv[data-zeroword]').forEach(function(sv){
          var zero = parseFloat(sv.textContent) === 0;
          sv.classList.toggle('svzero', zero);
          if(zero) sv.setAttribute('title', sv.getAttribute('data-zeroword'));
          else sv.removeAttribute('title');
        });
      }
      paintAll();
      /* zsstep bubbles from every stepper to the root */
      if(!root.__zsZeroWord){
        root.__zsZeroWord = true;
        root.addEventListener('zsstep', paintAll);
      }
    }
    /* the small cm/360 print follows its Speed (a step, a hold-repeat, a
       typed number all say 'zsstep'), and ADS's "Same as hip" line follows
       Hip's Speed too */
    function wireSpeedCm(root){
      if(!root || !root.querySelectorAll) return;
      /* after a step the stepper's Speed is the truth (cm = 500 / Speed);
         the stored field is drawn by speedHTML, exact, until then */
      function cm(m){
        var sv = root.querySelector('.sv[data-speedcm="'+m+'"]');
        var v = sv ? parseFloat(sv.textContent) : 0;
        return isFinite(v) && v > 0 ? 500 / v : 0;
      }
      function paint(){
        var hip = cm('hip');
        root.querySelectorAll('[data-cmline]').forEach(function(l){
          var ads = l.getAttribute('data-cmline') === 'ads';
          l.textContent = cmLineText(ads, ads ? cm('ads') : hip, hip);
        });
      }
      if(!root.__zsSpeedCm){
        root.__zsSpeedCm = true;
        root.addEventListener('zsstep', paint);
      }
    }
    function aimPageHTML(mode){
      var ads = mode==='ads';
      var hidden = ads !== (pagerPage===1);   /* the stance the tabs are NOT on */
      var opts = smOptionsOf(mode);
      var preset = smPresetOf(mode);
      var idx = opts.indexOf(preset);
      if(idx<0){ idx = 0; preset = opts[0]; }   /* a stale stored name must not blank the carousel */
      var body =
        /* the same stepper semantics cm360 always had: 0 is a switch, not a
           size (legacy speed on hip, inherit on ADS), and the first + lands
           on the comfortable 34 */
        /* SPEED (D164, the owner: no "cm/360" anywhere a player looks).
           Higher is faster; the field underneath is still cm of mouse travel
           per full turn, the portable number the translator needs, stored as
           1000 / Speed by the 'recip' bind (phone.html bindCoerce). 0 keeps
           its old meaning: the standard speed on hip, same as hip on ADS.
           The first + from 0 lands on 29, which is the old suggested 34. */
        /* SPEED 0-100, TWICE AS FAST as before (the owner, 2026-10-01: "keep
           0-100 but make it faster, 100 should feel like 50"): cm360 = 500 /
           Speed, so 100 = 5 cm of mouse per full turn (the old 100 was 10 cm
           = 50 now). Tenths are allowed (type 4.1). The first + from 0 lands
           on 14.5, the old suggested 34 cm. */
        /* D376: XIM's face, then Smoothing. D376 amended (owner,
           2026-10-14): the face is SPEED 0-100 with its cm/360 in small
           print under it (speedHTML); Fine aim moved to the Advanced
           section at the bottom of the page (advSectionHTML). */
        speedHTML(ads)+
        '<div class="smblk">'+
          labHelp('<div class="smtitle">Smoothing</div>', 'aim-smooth-'+mode, 'Smoothing', smHelpText(ads))+
          smcarHTML(' data-mode="'+mode+'"', preset, idx, opts.length)+
          /* D376: XIM's one line under Disabled, said on the card because
             it is a warning about the choice, not an explanation */
          (preset==='Disabled' ? '<div class="xsub smdis">Mouse movement will be unprocessed and may result in aim jitter.</div>' : '')+
          (preset==='Custom' ? smCustomHTML(mode) : '')+
        '</div>';
