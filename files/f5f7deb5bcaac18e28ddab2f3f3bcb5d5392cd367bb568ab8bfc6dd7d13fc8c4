      if(ads){
        var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
        var cmIn = !(typeof mt.adsCm360==='number' && mt.adsCm360>0);
        var smIn = smInherits(mt);
        foot = footHTML(cmIn && smIn ? 'Speed and Smoothing are inherited from Hip.'
                      : cmIn ? 'Speed is inherited from Hip.'
                      : smIn ? 'Smoothing is inherited from Hip.'
                      : 'No settings are inherited from Hip.');
      }
      return '<section class="aimpage'+(hidden?' aimoff':'')+'" data-stance="1" data-key="'+mode+'" aria-label="'+(ads?'ADS Aim':'Hip Aim')+'">'+
        bannerHTML(ads)+
        xcardHTML(mode, 'Mouse', mouseSVG(), body, mouseMechHTML(mode, preset))+
        (ads ? activationHTML()+foot : '')+
        /* D376 amended (owner: "when you click Advanced it should open
           below everything, not like scramble the menus"): every Advanced
           setting is one card at the very bottom of the stance page, so
           turning Advanced on or off never moves a simple setting */
        advSectionHTML(mode)+
        '</section>';
    }

    /* A preset tap writes the whole trio. Custom writes nothing on hip (your
       numbers stay and the dials open on them); on ADS it first copies hip's
       values in, so the dials edit fields that exist. "Same as hip" hands
       the three ADS fields back to inherit (null). Offline the pick is kept
       locally, exactly like the curve preset. */
    function smApply(mode, name, root){
      smSel[mode] = name;
      ZS.store.vals[baseNs+'|sm-'+mode] = name; ZS.persistStore();
      {
        smWrite(function(f){
          if(!f.mouseTranslation) f.mouseTranslation={};
          var mt = f.mouseTranslation, pr = null, cp = smClassicPreset(name), i;
          for(i=0;i<SM_PRESETS.length;i++){ if(SM_PRESETS[i][0]===name) pr = SM_PRESETS[i]; }
          if(mode==='hip'){
            if(pr){
              mt.smoothing=pr[1]; mt.oneEuroBeta=pr[2]; mt.smoothingEasing=pr[3];
              /* D191: a Standard preset is Standard. A config that never
                 named a style keeps not naming one (its bytes unchanged). */
              if(mt.smoothingStyle!=null){ smPinAds(mt); mt.smoothingStyle='standard'; }
            } else if(cp){
              smPinAds(mt);
              mt.smoothingStyle='classic';
              mt.classicSmooth=cp[1]; mt.classicDecay=cp[2]; mt.classicSynch=cp[3];
            } else if(mt.smoothingStyle!=='classic' && typeof mt.smoothingEasing!=='number'){
              mt.smoothingEasing=0.35; /* Custom must edit a real field */
            }
          } else if(name==='Same as hip'){
            SM_ADS_KEYS.forEach(function(k){ mt[k]=null; });
          } else if(pr){
            mt.adsSmoothing=pr[1]; mt.adsOneEuroBeta=pr[2]; mt.adsSmoothingEasing=pr[3];
            /* named outright, so a later Classic hip cannot change ADS */
            if(mt.smoothingStyle!=null || mt.adsSmoothingStyle!=null) mt.adsSmoothingStyle='standard';
          } else if(cp){
            mt.adsSmoothingStyle='classic';
            mt.adsClassicSmooth=cp[1]; mt.adsClassicDecay=cp[2]; mt.adsClassicSynch=cp[3];
          } else {
            /* Custom on ADS: hip's effective values copied in, so the dials
               edit fields that exist and start where ADS already was */
            var e = smEffective(mt, 'ads');
            if(mt.adsSmoothing==null)       mt.adsSmoothing       = typeof mt.smoothing==='number' ? mt.smoothing : 0;
            if(mt.adsOneEuroBeta==null)     mt.adsOneEuroBeta     = typeof mt.oneEuroBeta==='number' ? mt.oneEuroBeta : 1.0;
            if(mt.adsSmoothingEasing==null) mt.adsSmoothingEasing = typeof mt.smoothingEasing==='number' ? mt.smoothingEasing : 0.35;
            if(e.style==='classic'){
              mt.adsSmoothingStyle='classic';
              if(mt.adsClassicSmooth==null) mt.adsClassicSmooth = typeof e.cs==='number' ? e.cs : MOUSE_CLASSIC_SEED[0];
              if(mt.adsClassicDecay==null)  mt.adsClassicDecay  = typeof e.cd==='number' ? e.cd : MOUSE_CLASSIC_SEED[1];
              if(mt.adsClassicSynch==null)  mt.adsClassicSynch  = typeof e.cy==='number' ? e.cy : MOUSE_CLASSIC_SEED[2];
            } else if(mt.smoothingStyle!=null){
              mt.adsSmoothingStyle='standard';
            }
          }
        });
      }
      render(root);
    }

    /* ── THE STICK MODE: D184's three choices, ONE control (D186) ─────
       Per stick, three choices, Native by default:
         Native      the stick passes through untouched, the game's own feel:
                     the rest cut and Sensitivity, nothing else
         EXO Linear  the Core pre-compensates the game's MEASURED stick law
                     (the config's game translator: its dead zone and curve,
                     hip and aiming) so every bit of stick turns the camera
                     the same amount
         Custom      the player's own shaping. On a measured game: EXO
                     Linear plus their curve, drawn on the grid editor
                     (zs-curve-grid.js). Without one: the old Tuned stick
                     (the Core's curve, deadzones and smoothing on top of
                     the game), so it always works. Smoothing (steadying for
                     a shaky hand) and the deadzones are Custom's either way.
       Stored as stick.mode plus stick.right / stick.left = { mode, grid,
       points, adsGrid, adsPoints }, always written together by
       stickChoiceWrite (module scope, which says how each choice writes
       both). `points` (15-16 samples) is what the Core reads (the STICKFEEL
       section), `grid` the editor's handles (seven numbers, or the editor's
       {v:2, h, s} once handles move across or a segment is straight; see
       zs-curve-grid.js). EXO Linear needs a game
       translator: without one its button says "Calibrate this game first".
       The right stick lives in the hip page's ONE card (it is the look
       stick, the main one); the left stick's mode is in the fold beside
       Movement speed; aiming's own curve is on the ADS page's card (D77:
       banner, one card, the ••• fold, nothing more). An EXO's agent has no
       stick-mode stage, so there the control is Native | Custom over
       stick.mode alone, on the aim stick, for both sticks. */
    function feelFull(){ return ZS.live.online!==false ? ZS.live.full[p.id] : null; }
    /* the D184 half: a Core feature (stickModesCore, module scope) */
    function feelShown(){ return stickModesCore(); }
    function feelSpec(side){
      var f = feelFull(), st = f && f.stick && f.stick[side];
      return (st && typeof st === 'object') ? st : {};
    }
    function feelOf(side){
      if(!feelShown() && side==='left') side = 'right';    /* one switch, both sticks */
      return stickChoiceOf(ZS.live.full[p.id] || boardFull, side);
    }
    function feelGrid(side, ads){
      var st = feelSpec(side);
      var g = window.ZSCURVE ? ZSCURVE.gridOf(ads ? st.adsGrid : st.grid) : null;
      return g || (ads ? null : (window.ZSCURVE ? ZSCURVE.straight() : []));
    }
    /* a game translator is running: the Core has a model it can invert */
    function feelReady(){
      var mt = (feelFull() || {}).mouseTranslation || {};
      var r = mt.resolvedAimModel;
      return !!(r && typeof r === 'object' && r.generic !== true && r.hip && r.ads);
    }
    /* the drawn curve is what the Core runs: a measured game AND this stick
       written as Custom by name. An old Tuned config reads as Custom but
       names no mode, so the Core still runs its old curve (D186); one tap
       on "Draw my curve" names it. */
    function feelGridLive(side){
      return feelShown() && feelReady() && feelOf(side)==='custom' && feelSpec(side).mode==='custom';
    }
    /* XIM's Curve Editor (zs-curve-grid.js): title "Curve Editor -
       <stick> : <stance>", handles, straight segments, zoom, COPY / PASTE
       (one clipboard for every curve in the app); a paste saves through
       onCommit like any other change (feelCurveSave) */
    function feelCurveHTML(id, ys, label, presets, title){
      if(!window.ZSCURVE) return '';
      return ZSCURVE.html({ id: id, ys: ys, label: label, presets: presets, title: title,
        xName: 'Stick push', yName: 'Camera speed',
        help: 'Across: how far you push the stick, 0–100%. Up: how fast the reticle turns, 0–100%. '+
          'Drag a circle to move it; tap a dot to straighten that part. Applied after the Core takes out '+
          'this game’s own stick curve, so the two are never stacked.' });
    }
    /* The writes. Each goes into the cached config too (adsSet's reasoning:
       the redraw must show what the queued write is about to make true). */
    function feelWrite(fn){
      if(ZS.live.full[p.id]) ZS.editProfile(p.id, fn);     /* M8, as smWrite */
      else ZS.putProfileDebounced(p.id, fn);
    }
    function feelSide(f, side){
      if(!f.stick || typeof f.stick !== 'object') f.stick = {};
      if(!f.stick[side] || typeof f.stick[side] !== 'object') f.stick[side] = {};
      return f.stick[side];
    }
    function feelSet(side, mode, root){
      if(ZS.live.online===false || !ZS.live.full[p.id]){
        ZS.toast('Your board is offline \u2014 this switch has not reached it yet');
        render(root);
        return;
      }
      if(mode==='exoLinear' && !feelReady()){
        ZS.toast('Calibrate this game first \u2014 EXO Linear needs its measured stick');
        render(root);
        return;
      }
      var res = null;
      feelWrite(function(f){
        var r = stickChoiceWrite(f, side, mode);
        if(!res) res = r;
      });
      if(res && res.reset.length){
        ZS.toast('Native \u2014 your controller, untouched. '+res.reset.join(' and ')+
          (res.reset.length>1 ? ' are' : ' is')+' back to 100%.');
      }
      render(root);
    }
    function feelCurveSave(side, ads, ys){
      feelWrite(function(f){
        var st = feelSide(f, side);
        if(ads){ st.adsGrid = ys; st.adsPoints = ZSCURVE.sample(ys); }
        else { st.grid = ys; st.points = ZSCURVE.sample(ys); }
      });
    }
    function feelWire(root){
      root.querySelectorAll('[data-feelmode]').forEach(function(b){
        b.addEventListener('click', function(){
          var side = b.getAttribute('data-feelside'), mode = b.getAttribute('data-feelmode');
          /* the one already on: nothing to write */
          if(mode===feelOf(side)) return;
          feelSet(side, mode, root);
        });
      });
      root.querySelectorAll('[data-feelmat]').forEach(function(b){
        b.addEventListener('click', function(){ feelSet(b.getAttribute('data-feelmat'), 'custom', root); });
      });
      if(window.ZSCURVE){
        [['right', false, 'feel-right'], ['left', false, 'feel-left'], ['right', true, 'feel-right-ads']]
          .forEach(function(c){
            var wrap = root.querySelector('[data-cgwrap="'+c[2]+'"]');
            /* every change lands here: a drag, a key, Add / Remove /
               Straighten, a preset, a PASTE. ys is the stored shape (seven
               numbers, or {v:2,h,s}); the Core gets ZSCURVE.sample(ys) */
            if(wrap) ZSCURVE.wire(wrap, { ys: feelGrid(c[0], c[1]),
              onCommit: function(ys){ feelCurveSave(c[0], c[1], ys); } });
          });
      }
      var draw = root.querySelector('[data-feeladsdraw]');
      if(draw) draw.addEventListener('click', function(){
        var g = feelGrid('right', false);
        feelCurveSave('right', true, g);
        render(root);
      });
      var clr = root.querySelector('[data-feeladsclear]');
      if(clr) clr.addEventListener('click', function(){
        feelWrite(function(f){
          var st = feelSide(f, 'right');
          delete st.adsGrid;
          delete st.adsPoints;
        });
        render(root);
      });
      var use = root.querySelector('[data-feeluse]');
      if(use) use.addEventListener('click', function(){
        var found = trModelOf(p);
        if(!found || ZS.live.online===false || !ZS.live.full[p.id]){
          ZS.toast('Your board is offline \u2014 this has not reached it yet');
          return;
        }
        use.disabled = true;
        feelWrite(function(f){
          if(!f.mouseTranslation) f.mouseTranslation = {};
          var rm = ZSAIMMODEL.resolve(found.model, f.mouseTranslation, p.platform);
          if(rm) f.mouseTranslation.resolvedAimModel = rm;
        });
        ZS.toast(found.pack.name+'\u2019s measured stick is on \u2014 EXO Linear is ready');
        render(root);
      });
    }

    /* ── the CONTROLLER page (D245) ─────────────────────────────────
       Owner, 2026-10-09: "it should literally be just like the 8K pad, but
       have the option in the aim curves to disable it and use the native game
       aim curve ... literally take the app and make it fit into my mobile
       area". The stick pages (the Hip/ADS pager, the Thumbstick card and its
       ••• fold) are gone: the controller Aim screen IS the ZS8K
       Configurator's Sticks and Triggers tabs (zk-pad.js) on this config's
       fields. Each stick's curve row starts with Native, which turns the
       curve off; a curve on a Native stick makes it Custom with that curve.
       What the 8K app has no card for and the Core does - Sensitivity, the
       ADS sensitivity, Smoothing, Movement speed - is one more card in the
       same look (Speed), shown only while a stick is on a curve (D241:
       Native has nothing to set). */
    var ZKTAB = window.ZS_ZKTAB || (window.ZS_ZKTAB = {});
    var ZKSEL = window.ZS_ZKSEL || (window.ZS_ZKSEL = {});   /* D249: the stick on screen */
    function zkOpt(root){
      var ready = feelShown() && feelReady();
      var slot = {}, after = {}, mode = {}, drawn = {};
      ['left','right'].forEach(function(sd){
        mode[sd] = feelOf(sd);
        drawn[sd] = ready;          /* a measured game: Native | EXO Linear | Custom */
        if(mode[sd]!=='custom') return;
        if(feelGridLive(sd)){
          slot[sd] = feelCurveHTML('feel-'+sd, feelGrid(sd, false),
            sd==='right' ? 'Aim stick curve' : 'Movement stick curve', true,
            'Curve Editor - '+(sd==='right' ? 'Right' : 'Left')+' stick : Hip');

        } else if(ready){
          /* an old Tuned config names no mode: one tap names it, and the
             drawn curve takes over from the Core's */
          slot[sd] = '<button class="btn ghost" data-feelmat="'+sd+'" style="margin-top:8px">'+
            'Draw my curve on this game\u2019s measured stick</button>';
        }
      });
      /* not measured yet: EXO Linear waits for Calibrate, and a game whose
         pack already carries its measured stick is one tap away */
      var foot = '';
      if(feelShown() && !feelReady()){
        var found = trModelOf(p);
        foot = '<div class="zkmuted"><b>Calibrate this game first</b> for EXO Linear.</div>'+
          helpHTML('zk-linear', 'EXO Linear', 'It uses this '+
          'game\u2019s measured stick, from Translation \u25b8 Calibrate.')+
          ((found && found.model && found.model.needsCalibration === false)
            ? '<button class="btn primary" data-feeluse="1" style="margin-top:8px">Use '+
                esc(found.pack.name)+'\u2019s measured stick</button>' : '')+
          '<button class="btn ghost" data-door="translation" data-doorlab="Translation" style="margin-top:8px">Open Translation</button>';
      }
      return {
        mode: mode, exo: feelShown(), exoReady: feelReady(), drawn: drawn, curveFoot: foot,
        anti: zkAntiFw(),           /* D261: the Anti slider, only on a Core that reads it */
        slot: slot, after: after,
        dzExtra: seg('Deadzone shape', ['Round','Per-axis'], 0, false,
          B('deadZones.mode', 1, {t:'str', map:{'Round':'radial','Per-axis':'axial'}})),
        sel: ZKSEL[p.id] || 'right',
        onSel: function(s){ ZKSEL[p.id] = s; if(root) render(root); },
        onTab: function(t){ ZKTAB[p.id] = t; },
        /* D246: Copy L -> R / R -> L - the stick's mode, its curve and its
           deadzones (D261: its anti-deadzone too); the other stick's own
           speeds stay its own */
        onCopy: function(from){
          if(ZS.live.online===false || !ZS.live.full[p.id]){
            ZS.toast('Your board is offline \u2014 this has not reached it yet');
            return;
          }
          var to = from==='left' ? 'right' : 'left';
          feelWrite(function(f){
            stickChoiceWrite(f, to, stickChoiceOf(f, from));
            if(!f.curves) f.curves = {};
            var src = f.curves[from+'Stick'] || {};
            var dst = f.curves[to+'Stick'] || (f.curves[to+'Stick'] = {});
            dst.type = src.type || 'linear';
            dst.strength = (typeof src.strength==='number') ? src.strength : 1.0;
            dst.points = Array.isArray(src.points) ? JSON.parse(JSON.stringify(src.points)) : [];
            if(!f.deadZones) f.deadZones = {};
            ['Inner','Outer','Anti'].forEach(function(k){
              if(typeof f.deadZones[from+k]==='number') f.deadZones[to+k] = f.deadZones[from+k];
              else if(k==='Anti') delete f.deadZones[to+k];   /* D261: none is none */
            });
          });
          ZS.toast((from==='left' ? 'Left' : 'Right')+' stick copied to the '+to+' stick');
          if(root) render(root);
        },
        onMode: function(side, m, fn){
          if(ZS.live.online===false || !ZS.live.full[p.id]){
            ZS.toast('Your board is offline \u2014 this has not reached it yet');
            return;
          }
          if(side==='ads'){                 /* D254: the aiming curve has no mode */
            if(fn) feelWrite(fn);
            if(root) render(root);
            return;
          }
          if(m==='exoLinear' && !feelReady()){
            ZS.toast('Calibrate this game first \u2014 EXO Linear needs its measured stick');
            return;
          }
          var res = null;
          feelWrite(function(f){
            var r = stickChoiceWrite(f, side, m);
            if(!res) res = r;
            if(fn) fn(f);
          });
          if(res && res.reset.length){
            ZS.toast('Native \u2014 your controller, untouched. '+res.reset.join(' and ')+
              (res.reset.length>1 ? ' are' : ' is')+' back to 100%.');
          }
          if(root) render(root);
        }
      };
    }
    /* aiming's own drawn curve (D184), under the hip one on a measured game */
    function zkAdsCurveHTML(){
      var g = feelGrid('right', true);
      return '<div class="fld col feelfld" data-feel="right-ads"><div class="flab">Aiming curve'+
          '<em>'+(g ? 'Your own curve while you aim.' : 'While you aim, your hip curve is used, on this game\u2019s aiming numbers.')+'</em></div>'+
        (g ? feelCurveHTML('feel-right-ads', g, 'Aiming curve', true, 'Curve Editor - Right stick : ADS')+
             '<button class="btn ghost" data-feeladsclear="1" style="margin-top:8px">Use the hip curve while aiming</button>'
           : '<button class="btn ghost" data-feeladsdraw="1" style="margin-top:8px">Draw an aiming curve</button>')+
      '</div>';
    }
    /* the Speed card: the Core's own stick speeds, in the Configurator's look */
    /* D248 (owner, 2026-10-09: "put sensitivity at the top, and for
       controller do a 0-100 scale, 100 being the native pass-through turn
       rate the console would expect"): curves.<side>Stick.gain as 0..100,
       100 = gain 1.0 = the stick exactly as the console expects it. The
       Core refuses a gain under 0.1, so the lowest step is 10. Shown on a
       Native stick too - Native honours gain, and 100 is Native exactly. */
    function zkSpeedHTML(){
      var sel = ZKSEL[p.id] || 'right';
      var rc = feelOf('right')==='custom';
      var full = ZS.live.full[p.id] || boardFull || {};
      function pct(side, k){
        var c = (full.curves || {})[side+'Stick'] || {};
        var g = (typeof c[k]==='number' && isFinite(c[k])) ? c[k] : 1;
        return Math.max(10, Math.min(100, Math.round(g*100)));
      }
      if(sel==='left'){
        return ZSZK.cardHTML('speed', '#3ddc84', 'Speed',
          slider('Movement speed', 10, 100, pct('left', 'gain'), '',
            B('curves.leftStick.gain', .01, {mn:0.1, mx:1}))+
          helpHTML('zk-speed-l', 'Speed', '<b>Movement speed</b> is how fast the stick you walk with moves, '+
            'on a 0\u2013100 scale: <b>100</b> is the stick exactly as the console expects it; lower is '+
            'slower, down to 10.'), ' data-zkcard="speed"');
      }
      var body = slider('Sensitivity', 10, 100, pct('right', 'gain'), '',
        B('curves.rightStick.gain', .01, {mn:0.1, mx:1}));

      /* Smoothing only where it runs: a Native stick passes 0.0 literally */
      if(rc){
        var opts = smStickOptions(), preset = smStickPreset(), idx = opts.indexOf(preset);
        if(idx<0){ idx = 0; preset = opts[0]; }
        body += '<div class="smblk"><div class="smtitle">Smoothing</div>'+
            smcarHTML(' data-smset="stick"', preset, idx, opts.length)+
            '<div class="smcap">'+esc(smStickCaption(preset))+'</div>'+
          '</div>'+(preset==='Custom' ? smStickCustomHTML() : '');
      }
      return ZSZK.cardHTML('speed', '#3ddc84', 'Speed', body+
        helpHTML('zk-speed', 'Speed', '<b>Sensitivity</b> is how fast the aim stick turns, on a 0\u2013100 scale: '+
          '<b>100</b> is the stick exactly as the console expects it (the native turn rate); lower is slower, '+
          'down to 10. The <b>ADS</b> tab sets it while you aim down sights. <b>Smoothing</b> '+
          'steadies a shaky hand for a few '+
          'milliseconds of settling time (a stick on a curve only).'), ' data-zkcard="speed"');
    }
    /* D253 (owner, 2026-10-09: "you can just click a slider at the top to
       inherit the settings between the two if you don't want them separate -
       when enabled it copies it over, and when disabled doesn't delete but
       stops copying"). The ADS tab: the Same as Hip switch first. ON =
       curves.rightStick.adsGain null, so the Core uses the hip numbers -
       copying for ever. OFF = adsGain seeded with the hip number (adsSet), so
       the copy stays and is ADS's own from then on.
       What the Core holds ONE copy of - deadzones, the curve, Smoothing,
       the triggers - applies in both stances; the page says so rather than
       draw a second set of sliders that would write the same fields. */
    function zkAdsHTML(){
      var g = adsGainOf(), same = g===null;
      var full = ZS.live.full[p.id] || boardFull || {};
      var rs = (full.curves || {}).rightStick || {};
      var pctA = Math.max(10, Math.min(100, Math.round(((same ? rs.gain : g) || 1)*100)));
      var h = '<div class="zkcard zkinherit" data-zkcard="inherit">'+
        '<button type="button" class="zkswrow" data-xinherit="stick" role="switch" aria-checked="'+(same ? 'true' : 'false')+'">'+
          '<span class="zkswtxt"><b>Same as Hip</b><em>'+(same
            ? 'ADS uses your Hip settings, and keeps following them.'
            : 'ADS has its own settings. Switch on to copy Hip again.')+'</em></span>'+
          '<span class="zksw'+(same ? ' on' : '')+'" aria-hidden="true"><i></i></span></button></div>';
      /* D254 (owner, 2026-10-09: "all the options inside the sticks tab
         should be in the aiming one, except triggers and deadzones - the
         curves should be there - and if someone disables the copy, it reveals
         the curve stuff"): Same as Hip ON shows the switch and the aiming
         door only; OFF reveals ADS's own Speed (Sensitivity, Smoothing) and
         its own Response Curve. */
      var rc = feelOf('right')==='custom';
      var helpTxt = '<b>ADS</b> is while you aim down sights: pulling <b>L2</b>, or holding the button set '+
        'under <b>Choose what counts as aiming</b>. <b>Same as Hip</b> on: ADS copies your Hip Sensitivity, '+
        'Smoothing and curve, and keeps copying them. Off: the copy stays, and from then on ADS has its own. '+
        'Deadzones and triggers are the same in both.';
      var door = '<button class="btn ghost" data-door="roles" data-doorlab="Fire & Aim" style="margin-top:8px">'+
        'Choose what counts as aiming</button>';
      if(same){
        h += ZSZK.cardHTML('speed', '#3ddc84', 'ADS', door+helpHTML('zk-ads', 'ADS', helpTxt), ' data-zkcard="adsspeed"');
        return h;
      }
      var sm = (full.smoothing || {});
      var smA = (typeof sm.rightStickAds==='number') ? sm.rightStickAds : (sm.rightStick || 0);
      var body = slider('Sensitivity', 10, 100, pctA, '', B('curves.rightStick.adsGain', .01, {mn:0.1, mx:1}));
      if(rc){
        /* the same four steps as HIP's Smoothing ladder, on smoothing.rightStickAds */
        body += '<div class="smblk"><div class="smtitle">Smoothing</div>'+
          '<div class="zkseg" role="group" aria-label="ADS smoothing">'+
          SM_STICK.map(function(r){
            var on = Math.abs(smA - r[1]) < 0.005;
            return '<button type="button" data-zkadssm="'+r[1]+'"'+(on ? ' class="on" aria-pressed="true"' : ' aria-pressed="false"')+
              '>'+esc(r[0])+'</button>';
          }).join('')+'</div></div>';
      }
      body += door;
      h += ZSZK.cardHTML('speed', '#3ddc84', 'ADS Speed', body+helpHTML('zk-ads', 'ADS', helpTxt), ' data-zkcard="adsspeed"');
      if(feelGridLive('right')){
        h += ZSZK.cardHTML('curve', '#bb9af7', 'ADS Curve', zkAdsCurveHTML(), ' data-zkcard="adscurve"');
      } else if(rc){
        h += ZSZK.adsCurveHTML(full);
      } else {
        h += '<div class="zkmuted zkshared">Your right stick is <b>Native</b> on HIP: give it a curve there and '+
          'ADS can have its own curve and Smoothing too.</div>';
      }
      if(!zkAdsFw()){
        h += warnHTML('Your Core needs its next update for ADS\u2019s own curve and Smoothing. Until then '+
          'ADS uses the Hip curve and Smoothing (ADS Sensitivity already works).', 'zk-adsfw');
      }
      return h;
    }
    /* D254: does the Core apply ADS's own curve and Smoothing yet? (a Core
       built before D254 reads past the section and uses Hip's) */
    function zkAdsFw(){
      /* the Core's own list of the settings blocks it reads (/status
         profileFormat.sections); STICKADS is 0x0033 = 51 */
      var st = ZS.live && ZS.live.status;
      var secs = st && st.profileFormat && st.profileFormat.sections;
      return Array.isArray(secs) && secs.some(function(v){ return +v === 51 || String(v).toLowerCase() === '0x0033'; });
    }
    /* D261: does the Core apply each stick's anti-deadzone? STICKANTI is
       0x0034 = 52 in /status profileFormat.sections (a Core built before
       D261 skips the section, so the slider would write nothing) */
    function zkAntiFw(){
      var st = ZS.live && ZS.live.status;
      var secs = st && st.profileFormat && st.profileFormat.sections;
      return Array.isArray(secs) && secs.some(function(v){ return +v === 52 || String(v).toLowerCase() === '0x0034'; });
    }
    function zkPadPageHTML(){
      if(!window.ZSZK) return '';
      /* D246: no Controller Feel door - its limits are on the Deadzones and
         Trigger Settings cards, its stick response is the curves + Smoothing */
      return ZSZK.pageHTML(ZS.live.full[p.id] || boardFull, zkOpt(null), ZKTAB[p.id] || 'hip',
        { speed: zkSpeedHTML(), ads: zkAdsHTML() });
    }
    /* curves.rightStick.adsGain as the ENGINE reads it: a finite positive
       number, or null. Read from the live cache rather than boardFull —
       boardFull is the object R.aim was handed, and putProfile replaces
       ZS.live.full[p.id] with a new one on every landed write, so after one
       switch flip the captured reference is a generation behind. The
       stage's own _ads_cfg treats anything that is not a positive finite
       number as off, and so does this. */
    function adsGainOf(){
      var full = ZS.live.online!==false ? ZS.live.full[p.id] : null;
      var rs = full && full.curves && full.curves.rightStick;
      var g = rs ? rs.adsGain : null;
      return (typeof g==='number' && isFinite(g) && g>0) ? g : null;
    }
    /* The switch's one write. ON seeds the hip gain (a number the schema has
       already accepted, so the board cannot refuse it) or 1.0; OFF writes
       null, which is the engine's off. The seed goes into the CACHED config
       as well as the queued write, and not for optimism's sake: bindRead
       prefers the board's copy and hands back undefined for null, so until
       the debounced write lands the new stepper would open on whatever the
       local cache last held for this label — the 60% from a session since
       switched off, say — over a board about to hold the hip gain. Writing
       the value the queued mutation is about to make true, where the one
       reader that wins looks for it, is how the dial and the wire agree
       from the first frame. putProfile clones from a fresh GET and replaces
       the cache on success, so nothing here outlives the write. */
    function adsSet(on, root){
      if(ZS.live.online===false || !ZS.live.full[p.id]){
        ZS.toast('Your board is offline — this switch has not reached it yet');
        render(root);                 /* the switch goes back where the board has it */
        return;
      }
      var full = ZS.live.full[p.id];
      var hip = (full.curves && full.curves.rightStick) ? full.curves.rightStick.gain : null;
      var seed = on ? ((typeof hip==='number' && hip>=0.1 && hip<=3) ? hip : 1.0) : null;
      /* D254: ADS's own curve and Smoothing go the same way - OFF (own)
         copies Hip's as they are now, ON (Same as Hip) clears them so the
         Core follows Hip again. Nothing else is touched. */
      var hrs = (full.curves && full.curves.rightStick) || {};
      var curveSeed = on ? {
        type: hrs.type || 'linear',
        strength: (typeof hrs.strength==='number' && hrs.strength>=0.1) ? hrs.strength : 1.0,
        points: Array.isArray(hrs.points) ? JSON.parse(JSON.stringify(hrs.points)) : []
      } : null;
      var hsm = (full.smoothing && typeof full.smoothing.rightStick==='number') ? full.smoothing.rightStick : 0;
      var smSeed = on ? hsm : null;
      function put(f){
        if(!f.curves) f.curves = {};
        if(!f.curves.rightStick) f.curves.rightStick = {};
        f.curves.rightStick.adsGain = seed;
        f.curves.rightStick.adsCurve = curveSeed ? JSON.parse(JSON.stringify(curveSeed)) : null;
        if(!f.smoothing) f.smoothing = {};
        f.smoothing.rightStickAds = smSeed;
      }
      ZS.editProfile(p.id, put);      /* M8: onto a clone, never in place */
      render(root);   /* the stepper appears and disappears with the switch */
      /* render() replaced the very switch that was tapped. Put the focus
         back on its twin, or a keyboard or switch user pays a hunt per flip. */
      var sw = root.querySelector('[data-xinherit="stick"]');
      if(sw && sw.focus){ try{ sw.focus(); }catch(e){} }
    }

    /* Which preset the stick shows. The tap the user just made wins, then the
       board's stored number, then what was last picked here — never a name the
       value denies. A local 'Custom' beats an exact match, for the same reason
       the mouse's does: a number that happens to equal a preset may still be
       one the user dialled, and having the Custom dial vanish out from under a
       thumb mid-tune is worse than a stale word on the carousel. */
    function smStickStyle(sm){
      return (sm && sm.rightStickStyle==='classic' && classicShown()) ? 'classic' : 'standard';
    }
    function smStickOptions(){
      return SM_STICK.map(function(r){ return r[0]; })
        .concat(classicShown() ? SM_CLASSIC_PRESETS.map(function(r){ return r[0]; }) : [])
        .concat(['Custom']);
    }
    function smStickCustomHTML(){
      var sm = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).smoothing || {};
      var style = smStickStyle(sm);
      var h = '<div class="smcustom" data-smcustom="stick">';
      if(classicShown()) h += smStyleSeg(' data-smstylefor="stick"', style)+smStyleHelp('stick');
      if(style==='classic'){
        h += classicSteppers(['smoothing.rightStickClassicSmooth','smoothing.rightStickClassicDecay','smoothing.rightStickClassicSynch'],
          [typeof sm.rightStickClassicSmooth==='number' ? sm.rightStickClassicSmooth : 0,
           typeof sm.rightStickClassicDecay==='number' ? sm.rightStickClassicDecay : 9,
           typeof sm.rightStickClassicSynch==='number' ? sm.rightStickClassicSynch : 0], 'stick');
      } else {
        h += labHelp(stepper('Steadiness', 35, 5, 0, 95, '%',
              'how hard the stick is steadied',
              B('smoothing.rightStick', .01, {mn:0, mx:0.95})), 'aim-steady-stick', 'Steadiness', AIM_HELP.steady);
      }
      return h+'</div>';
    }
    function smStickStyleSet(style, root){
      smSel.stick = 'Custom';
      {
        smWrite(function(f){
          if(!f.smoothing) f.smoothing = {};
          var sm = f.smoothing;
          sm.rightStickStyle = style;
          if(style==='classic'){
            ['Smooth','Decay','Synch'].forEach(function(n, i){
              if(typeof sm['rightStickClassic'+n]!=='number') sm['rightStickClassic'+n] = CLASSIC_SEED[i];
            });
          }
        });
      }
      render(root);
    }
    function smStickPreset(){
      if(smSel.stick) return smSel.stick;
      var local = ZS.store.vals[baseNs+'|sm-stick'];
      var full = ZS.live.online!==false ? ZS.live.full[p.id] : null;
      if(!full) return local || 'Disabled';
      if(local==='Custom') return 'Custom';
      if(smStickStyle(full.smoothing)==='classic'){
        var fs = full.smoothing;
        return smClassicFromValues(fs.rightStickClassicSmooth, fs.rightStickClassicDecay,
                                   fs.rightStickClassicSynch) || 'Custom';
      }
      var v = (full.smoothing||{}).rightStick;
      var s = typeof v==='number' ? v : 0;          /* the engine's own default */
      for(var i=0;i<SM_STICK.length;i++){
        if(Math.abs(s-SM_STICK[i][1])<0.005) return SM_STICK[i][0];
      }
      return 'Custom';
    }
    /* One tap, one field. Custom writes NOTHING: the number already on the
       board IS the custom value and the dial below opens on it — the same rule
       the mouse's hip Custom follows, and unlike the mouse it needs no seed
       because smoothing.rightStick always exists (schema default 0.0). Offline
       the pick is kept locally, exactly like the curve preset. */
    function smStickApply(name, root, d){
      smSel.stick = name;
      ZS.store.vals[baseNs+'|sm-stick'] = name; ZS.persistStore();
      var pr = null, cp = smClassicPreset(name), i;
      for(i=0;i<SM_STICK.length;i++){ if(SM_STICK[i][0]===name) pr = SM_STICK[i]; }
      if(pr || cp){
        smWrite(function(f){
          if(!f.smoothing) f.smoothing = {};
          if(pr){
            f.smoothing.rightStick = pr[1];
            /* D191: a Standard preset is Standard; never-named stays unnamed */
            if(f.smoothing.rightStickStyle!=null) f.smoothing.rightStickStyle = 'standard';
          } else {
            f.smoothing.rightStickStyle = 'classic';
            f.smoothing.rightStickClassicSmooth = cp[1];
            f.smoothing.rightStickClassicDecay = cp[2];
            f.smoothing.rightStickClassicSynch = cp[3];
          }
        });
      }
      render(root);   /* the Custom dial appears and disappears with the name */
      /* render() replaced the very arrow that was pressed. Put the focus back
         on its twin, or stepping Disabled -> Light -> Balanced costs a
         keyboard or switch user three hunts for the same control. */
      var a = root.querySelector('.smcar[data-smset="stick"] .arr[data-d="'+(d<0?'-1':'1')+'"]');
      if(a && !a.disabled && a.focus){ try{ a.focus(); }catch(e){} }
    }

    /* D184/D275: the mouse's hip curve is the shared curve editor
       (zs-curve-grid.js, ZSCURVE, XIM's Curve Editor): handles, straight
       segments, zoom, the presets and COPY / PASTE, a smooth rising curve
       sent to the Core as 15-16 samples in curvePoints, the handles kept in
       curveGrid for the editor (seven numbers, or {v:2, h, s}). An old
       three-dot curve or a power curve (the old Gentle / Aggressive) opens
       as the curve it already is; nothing is written until a point moves.
       Linear writes the plain linear curve (no points). */
    function mouseCurveYs(mt){
      if(!window.ZSCURVE) return [];
      var g = mt.curve === 'piecewise' ? ZSCURVE.gridOf(mt.curveGrid) : null;
      return g || ZSCURVE.fromCurve(mt.curve, mt.curveStrength, mt.curvePoints);
    }
    function mouseCurveHTML(ys){
      if(!window.ZSCURVE) return '';
      return ZSCURVE.html({ id: 'mk-curve', ys: ys, label: 'Hip curve', presets: true,
        title: 'Curve Editor - Mouse : Hip', xName: 'Hand speed', yName: 'Turn speed',
        help: 'Across: how fast your hand moves. Up: how fast the reticle turns. '+
          'Drag a circle to move it; tap a dot to straighten that part. Applied after the Core takes out '+
          'the game\u2019s own curve, so the two are never stacked.' });
    }
    function wireMouseCurve(root){
      var wrap = root.querySelector('[data-cgwrap="mk-curve"]');
      if(!wrap || !window.ZSCURVE) return;
      var full = (ZS.live.full[p.id] || {});
      /* every change (a drag, a key, Add / Remove / Straighten, a preset
         other than Linear, a PASTE) saves the drawn curve */
      function save(ys){
        ZS.putProfileDebounced(p.id, function(f){
          if(!f.mouseTranslation) f.mouseTranslation = {};
          f.mouseTranslation.curve = 'piecewise';
          f.mouseTranslation.curvePoints = ZSCURVE.sample(ys);
          f.mouseTranslation.curveGrid = ys;
        });
        stM.curve = 'Custom'; saveSt();
      }
      /* Linear is the plain linear curve, nothing left behind */
      function linear(){
        ZS.putProfileDebounced(p.id, function(f){
          if(!f.mouseTranslation) f.mouseTranslation = {};
          f.mouseTranslation.curve = 'linear';
          delete f.mouseTranslation.curvePoints;
          delete f.mouseTranslation.curveGrid;
        });
        stM.curve = 'Even'; saveSt();
      }
      ZSCURVE.wire(wrap, {
        ys: mouseCurveYs(full.mouseTranslation || {}),
        onCommit: save,
        onPreset: function(id, ys){ if(id==='linear') linear(); else save(ys); },
        onStraight: linear
      });
    }

    /* ── the mouse card's ••• fold ───────────────────────────────────
       What the Mechanics sheet used to hold, drawn INSIDE the card under the
       •••: the per-stance curve, the Custom smoothing dials, this stance's
       calibration line; and on HIP only, the engine's single yxRatio /
       noiseThreshold / invert pair / dpi / feel, Aim Speed Match and
       Keyboard Movement. ADS's fold names those as shared instead of
       drawing them a second time — the engine has ONE of each, and
       test-aim-stance §1 counts controls per field across the screen. */
    function mouseMechHTML(mode, preset){
      var ads = mode==='ads';
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      var h = '<div class="xsec">Mechanics</div>';
      if(ads){
        /* Which preset is lit. ADS reads its own ads* fields. -1 means Custom
           or something no preset names — light nothing rather than lie. */
        var aci = 0, ac = mt.adsCurve;
        if(ac==null) aci = 0;
        else if(ac==='linear') aci = 1;
        else if(ac==='power') aci = (+mt.adsCurveStrength>=1) ? 2 : 3;
        else aci = -1;
        h += '<div data-xcurve="ads">'+
          labHelp(seg('ADS curve', ['Same as hip','Even','Gentle','Aggressive'], aci, true, null,
              'the curve while you hold aim — Same as hip keeps one curve for both'),
            'aim-adscurve', 'ADS curve', AIM_HELP.adsCurve)+'</div>';
      } else {
        /* D275: the hip curve is the grid Curve Editor (D184) that stood in
           Translation's "More translation settings" as "Speed curve". It and
           the three Even / Gentle / Aggressive buttons that stood here wrote
           the SAME mouseTranslation.curve fields from two screens, so the
           editor (its four presets cover the three buttons) is the one home:
           an old three-button curve opens as the curve it already is. */
        h += labHelp('<div class="fld col" data-xcurvegrid="hip"><div class="flab">Hip curve</div>'+
          mouseCurveHTML(mouseCurveYs(mt))+'</div>', 'aim-hipcurve', 'Hip curve', AIM_HELP.hipCurve, true);
      }
      /* D191: Custom's dials moved OUT of this fold to right under the
         Smoothing carousel, with XIM's Standard | Classic mode button
         (smCustomHTML); one control per field, so they are not drawn here. */
      /* D189: QUANTIZATION, XIM's "advanced" pair, per stance, off (0) by
         default. Snaps the camera speed the Core asks the game for: Magnitude
         to speed steps (the step grows the faster you aim), Angle to a set of
         directions (whatever the speed). Some games' aim assist reads a
         stepped input as a controller's and helps more. ADS left unset uses
         hip's numbers. */
      /* D376 (owner, 2026-10-14, with XIM's screenshots: "look how much
         simpler their Aim and ADS tabs are ... just simple, like my
         photos show"): the fold is XIM's, in XIM's order - Mechanics (the
         curve), Y Scale, Quantization (a button that opens its two), Invert
         - and every other setting of the fold sits behind the card's
         Advanced button, in the Advanced section at the bottom of the page
         (advSectionHTML, D376 amended), nothing deleted. Y Scale and Invert are one field for both stances (the
         Core has no ADS copy of either), so ADS's fold says so. */
      var quantOn = !(ZS.productHides && ZS.productHides('aimXim'));
      if(ads){
        if(quantOn) h += quantHTML(ads, mt);
        h += '<div class="xsub xshared">Y Scale and Invert are shared with Hip aim — set them there. Mouse DPI is on Device.</div>';
        return h;
      }
      h += labHelp(stepper('Y Scale', 100, 5, 30, 200, '%',
          '100 = up-down exactly matches left-right',
          B('mouseTranslation.yxRatio', .01, {mn:0.3, mx:2}),
          ' data-detent="100" data-detentsnap="2.5"'), 'aim-yscale', 'Y Scale', AIM_HELP.yscale)+
        (quantOn ? quantHTML(ads, mt) : '')+
        labHelp('<div class="fld"><div class="flab">Invert'+
          '<em>flip aim direction — Vertical is the classic push-away-to-look-down</em></div>'+
          '<div class="smcar" id="mech-inv" data-noswipe="1" style="padding:0">'+
            '<button class="arr" data-d="-1" aria-label="previous invert option">‹</button>'+
            '<span class="smval" role="status" style="min-width:96px">'+esc(invNameOf(mt))+'</span>'+
            '<button class="arr" data-d="1" aria-label="next invert option">›</button>'+
          '</div></div>', 'aim-invert', 'Invert', AIM_HELP.invert);
      return h;
    }
    /* D376 amended (owner, 2026-10-14: "when you click Advanced it should
       open below everything, not like scramble the menus"): ADVANCED is
       one card at the very bottom of each stance page, under the Mouse
       card and its ••• fold (and under Activation on ADS), so the simple
       settings never move when it opens or closes. It holds every setting
       D376 kept off the simple face: Fine aim and the calibration line on
       both stances; on Hip, the engine's one each of up/down balance,
       Ignore tiny movement, the read-only Mouse DPI line (D375), Feel,
       Start-up feel and Aim Speed Match. Drawn, bound and wired either
       way, only `hidden` while Advanced is off. */
    function advSectionHTML(mode){
      var ads = mode==='ads';
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      var inner = fineAimHTML(ads) + calChipHTML(ads);
      if(!ads) inner +=
        vhBalanceHTML(p)+
        /* D189: this was "Quantization", which is XIM's name for the snap
           in the fold; the field is the noise gate, so it says what it does */
        /* D392: in HAND SPEED, millimetres a second. The field is counts
           per 250 Hz tick at 1000 DPI (zs_mouse noise_threshold), so one
           unit is 250 counts/s = 0.25 in/s = 6.35 mm/s, on any mouse (the
           counts are DPI-normalised before the gate) */
        labHelp(stepper('Ignore tiny movement', 0, 1, 0, 300, ' mm/s',
          'hand movement slower than this is ignored — 0 = off',
          B('mouseTranslation.noiseThreshold', 1/6.35, {mn:0, mx:50, dp:0})), 'aim-noise', 'Ignore tiny movement', AIM_HELP.noise)+
        /* D375: the DPI's one home is Device; Speed is measured against
           it, so one read-only line says it and opens the card */
        aimDpiLine(mt)+
        /* Feel — the stop/micro-movement character (docs/MOUSE-FEEL.md). The
           engine treats an absent key as snappy and degrades garbage to
           snappy, so the default index mirrors that. */
        labHelp(seg('Feel', ['Snappy','Balanced','Smooth'],
            ({snappy:0, balanced:1, smooth:2})[String(mt.feel||'snappy')] || 0,
            false,
            B('mouseTranslation.feel', 1, {t:'str',
              map:{'Snappy':'snappy','Balanced':'balanced','Smooth':'smooth'}}),
            'Snappy stops the instant your hand does — recommended'), 'aim-feel', 'Feel', AIM_HELP.feel)+
        /* D275: START-UP FEEL (D164 start from rest, restEaseMs), beside
           Feel, its stop. The Core takes 0..200 ms (zs_mouse rest_ease_s). */
        labHelp(stepper('Start-up feel', Math.round(+mt.restEaseMs || 0), 5, 0, 200, ' ms',
          'how gently a movement starts after your hand was still — 0 = instant',
          B('mouseTranslation.restEaseMs', 1, {mn:0, mx:200})), 'aim-startup', 'Start-up feel', AIM_HELP.startup)+
        /* Aim Speed Match measures mouseTranslation.maxVelocity — the
           fastest-swipe ceiling; a door (wireDoors). D375: the Keyboard
           Movement door left for Translation (trKbHTML). */
        door('velocity', 'Aim Speed Match', 'Aim Speed Match',
             'measure your fastest swipe so the ceiling matches your hands');
      return '<div class="grp-card xcard xadvsec advonly" data-xadvsec="'+mode+'"'+(aimAdvOn() ? '' : ' hidden')+'>'+
        '<div class="xtitle">Advanced</div>'+
        '<div class="xsub xadvlead">'+(ads ? 'More settings for aiming down sights.' : 'More settings for fine-tuning your aim.')+'</div>'+
        inner+
        '</div>';
    }
    /* D401's XIM-format curve row (Paste / Reset to straight line / Turn
       off) was taken out of the app on 2026-10-16 (D402: no XIM wording in
       the app). The Core still runs mouseTranslation.ximCurve / adsXimCurve
       (zs_bezier.h, AIMCURVE 0x0029) and the encoder still writes them; only
       the screen is gone. */
    /* D375: the Mouse DPI, read-only, and the way to change it. One line
       under Invert where the stepper stood: the number the translator
       measures Speed and cm/360 against (unset = the engine's 1000), and a
       tap opens Device scrolled to its Mouse DPI card (D340's deep link to
       the Update Rate card, ovSetTab, with 'Dpi'). Never a control here, so
       the two screens cannot disagree. */
    function aimDpiLine(mt){
      var v = window.ZS_DPI && ZS_DPI.validDpi ? ZS_DPI.validDpi(mt.dpi) : (+mt.dpi || 0);
      var shown = v ? Number(v).toLocaleString('en-US') : '1,000 (not set)';
      return '<div class="fld" id="aim-dpiline"><button type="button" data-aimdpi="1" '+
        'aria-label="Mouse DPI '+esc(shown)+'. Change it on Device" '+
        'style="display:flex;width:100%;align-items:center;justify-content:space-between;gap:10px;'+
        'background:none;border:0;padding:2px 0;margin:0;font:inherit;text-align:left;cursor:pointer;'+
        'color:var(--muted);font-size:13px;min-height:44px">'+
        '<span>Mouse DPI: <b style="color:var(--text)">'+esc(shown)+'</b></span>'+
        '<span style="color:var(--accent);font-weight:600;white-space:nowrap">Change in Device ›</span>'+
        '</button></div>';
    }
    /* D376: ADVANCED. The owner: "add something that says 'Advanced' next
       to the ••• that opens all my advanced options ... too confusing and
       cluttered for a new user". A new install sees XIM's simple pages;
       Advanced shows every other setting the page has (Fine aim, the
       calibration line, up/down balance, Ignore tiny movement, Mouse DPI,
       Feel, Start-up feel, Aim Speed Match; Speed is on the face since
       D376 amended) in its own card at the bottom. Nothing is deleted: the
       settings are drawn, bound and wired either way, only `hidden`. The
       choice is per install (localStorage, which may be missing or throw:
       then it is simply off). A hidden setting that is not at its default
       puts "Advanced settings in use" beside the button. */
    function advInUse(){
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      return (+mt.fineAim > 0) || (typeof mt.adsFineAim === 'number') || (+mt.noiseThreshold > 0) ||
        (mt.feel != null && mt.feel !== 'snappy') || (+mt.restEaseMs > 0);
    }
    function advBtnHTML(){
      var on = aimAdvOn();
      return '<button type="button" class="xadv" data-xadv="1" aria-pressed="'+(on?'true':'false')+'">Advanced</button>'+
        '<span class="xadvhint"'+(!on && advInUse() ? '' : ' hidden')+'>Advanced settings in use</span>'+
        /* D376 amended: the section opens at the bottom of the page, so
           the button says where it went */
        '<span class="xadvwhere"'+(on ? '' : ' hidden')+'>Advanced settings are at the bottom of this page.</span>';
    }
    /* D189: the two quantization steppers and XIM's starting tip. ADS shows
       hip's number until it is given its own. */
    function quantHTML(ads, mt){
      var hm = typeof mt.quantMagnitude==='number' ? mt.quantMagnitude : 0;
      var ha = typeof mt.quantAngle==='number' ? mt.quantAngle : 0;
      var m = ads && typeof mt.adsQuantMagnitude==='number' ? mt.adsQuantMagnitude : hm;
      var a = ads && typeof mt.adsQuantAngle==='number' ? mt.adsQuantAngle : ha;
      var st = ads ? 'ads' : 'hip';
      /* D285: XIM's starting tip is help, not a line on the card; since the
         Aim screen's "?" pass (2026-10-14) it sits beside the Quantization
         heading, word for word, and each of the two has its own "?" */
      /* D376: XIM's "Quantization" is a BUTTON that opens its two; here it
         opens them in place (aria-expanded), open by itself when either is
         already set so a config's snap is never out of sight. The "?" sits
         beside the button. */
      var qOpen = !!XQUANT_OPEN[p.id+'|'+st] || m > 0 || a > 0;
      var q = qhParts('mk-quant-'+st, 'Quantization',
          'To start, set Magnitude to 25 and Angle to 25. Adjust one at a time.');
      return '<div class="xsec xquanthd" data-quant="'+st+'">'+
          '<button type="button" class="xquantbtn" data-xquant="'+st+'" aria-expanded="'+(qOpen?'true':'false')+'" '+
            'aria-controls="xquant-'+st+'">Quantization</button>'+q.chip+'</div>'+q.fold+
        '<div class="xquant" id="xquant-'+st+'"'+(qOpen?'':' hidden')+'>'+
        labHelp(stepper('Magnitude', Math.round(m*100), 5, 0, 100, '%',
          'snaps your aim speed to steps — the steps grow the faster you aim. 0 = off',
          B(ads?'mouseTranslation.adsQuantMagnitude':'mouseTranslation.quantMagnitude', .01, {mn:0, mx:1})),
          'aim-qmag-'+st, 'Magnitude', AIM_HELP.magnitude+(ads ? '<br>Until you change it here, ADS uses Hip\u2019s number.' : ''))+
        labHelp(stepper('Angle', Math.round(a*100), 5, 0, 100, '%',
          'snaps your aim direction to set angles, at any speed. 0 = off',
          B(ads?'mouseTranslation.adsQuantAngle':'mouseTranslation.quantAngle', .01, {mn:0, mx:1})),
          'aim-qang-'+st, 'Angle', AIM_HELP.angle+(ads ? '<br>Until you change it here, ADS uses Hip\u2019s number.' : ''))+
        '</div>';
    }
    /* the fold's hand-wired controls — the curve segs (per stance), the
       up/down fix button and the invert carousel; everything else in the
       fold carries a data-bind and is ZS.wire's */
    function wireMouseMech(root){
      wireMouseCurve(root);
      root.querySelectorAll('[data-xcurve]').forEach(function(box){
        var ads = box.getAttribute('data-xcurve')==='ads';
        box.querySelectorAll('.seg2 button').forEach(function(b){
          b.addEventListener('click', function(){
            if(ZS.live.online===false || !ZS.live.full[p.id]){ ZS.toast('Your board is offline'); return; }
            var cv = b.textContent;
            ZS.putProfileDebounced(p.id, function(f){
              if(!f.mouseTranslation) f.mouseTranslation={};
              var m = f.mouseTranslation;
              if(ads){
                if(cv==='Same as hip'){ m.adsCurve=null; m.adsCurveStrength=null; m.adsCurvePoints=null; }
                else { var cm=CURVE_MAP[cv]; m.adsCurve=cm.curve; m.adsCurveStrength=cm.curveStrength; m.adsCurvePoints=[]; }
              } else {
                var cmh=CURVE_MAP[cv]; m.curve=cmh.curve; m.curveStrength=cmh.curveStrength; m.curvePoints=[];
              }
            });
            if(!ads){ stM.curve = cv; saveSt(); }
          });
        });
      });
      /* D392: no "Match up/down" button any more (it was a second way to
         set Y Scale to 100): Y Scale, with its detent at 100, is the one
         control for mouseTranslation.yxRatio */
      var inv = root.querySelector('#mech-inv');
      if(inv){
        var ivArrows = inv.querySelectorAll('button');
        var ivVal = inv.querySelector('.smval');
        function ivPaint(i){
          for(var a=0;a<ivArrows.length;a++){
            var dec = parseFloat(ivArrows[a].getAttribute('data-d')||'1')<0;
            ivArrows[a].disabled = dec ? i<=0 : i>=INV_OPTS.length-1;
          }
        }
        function ivIdx(){
          var t = ivVal ? ivVal.textContent : 'Off';
          for(var i=0;i<INV_OPTS.length;i++){ if(INV_OPTS[i][0]===t) return i; }
          return 0;
        }
        ivPaint(ivIdx());
        for(var ia=0; ia<ivArrows.length; ia++) (function(b){
          b.addEventListener('click', function(){
            if(ZS.live.online===false || !ZS.live.full[p.id]){ ZS.toast('Your board is offline'); return; }
            var nx = ivIdx() + (parseFloat(b.getAttribute('data-d')||'1')<0 ? -1 : 1);
            if(nx<0 || nx>=INV_OPTS.length) return;
            var o = INV_OPTS[nx];
            if(ivVal) ivVal.textContent = o[0];
            ivPaint(nx);
            ZS.putProfileDebounced(p.id, function(f){
              if(!f.mouseTranslation) f.mouseTranslation={};
              f.mouseTranslation.invertX = o[1];
              f.mouseTranslation.invertY = o[2];
            });
          });
        })(ivArrows[ia]);
      }
    }

    /* The STICK's deadzones sheet (openStickMech) is gone (D242): each Custom
       stick's inner and outer deadzone and its curve are the ZS8K
       Configurator's cards on the page (zk-pad.js), and the deadzone shape
       is in the hip card's fold. */

    function render(root){
      /* three namespaces, because three different sets of controls live here */
      var ns = baseNs+'/'+(hasMouse ? (hasPad ? 'both' : 'mnk') : 'pad');
      /* THE SKELETON (screen-map §3, reordered 2026-09-04 on the owner's
         instruction — "Aim feel and everything should be at the top; the
         live stick view and the warning and the game preset at the bottom"):
         the Hip/ADS pager(s) → the mouse-shared card → the stick block,
         THEN the live pad → the warnings block → ONE Match Your Game door.
         The controls a player came to turn are the first thing under the
         title; the instrument, the board's complaints and the preset that
         would overwrite those controls sit under them. The input-type
         switch is GONE from this screen entirely (Overview's Setup card is
         its one home — rule 2, and the owner's named complaint); the
         drift/suppression warnings merge into one block; the game door is
         emitted ONCE, unconditionally, instead of the old three-site
         both?'':door() dance. */
      var h = '';
      /* THE SKELETON (owner, 2026-09-05: "this is all I want on these aim
         tabs, nothing more AT ALL"): per half, the stance strip and its two
         pages — banner, one card, ••• fold; on ADS the Activation card and
         the inheritance line — then the warning chips. The section headers,
         the shared card, the doors on the page and the live aim pad are
         gone from this screen; every control they held is in a fold.
         The stance switch is the kit's .subtabs — the same strip Smart
         Actions and Global Settings use — and the shell's swipe steps the
         FIRST .subtabs on the open screen: pad-only → #stickTabs swipes;
         Joystick + Mouse → #aimtabs keeps the swipe (first in document
         order, test-aim-stance §4 pins it) and #stickTabs is tap-only. */
      if(hasMouse){
        h += '<div class="subtabs" id="aimtabs" aria-label="Aim stance">'+
            '<button data-pg="0"'+(pagerPage===1?'':' class="on"')+'>Hip aim</button>'+
            '<button data-pg="1"'+(pagerPage===1?' class="on"':'')+'>ADS aim</button>'+
          '</div>'+
          aimPageHTML('hip')+aimPageHTML('ads');
      }
      /* NOT `else`. A Joystick + Mouse config is BOTH, so it gets both halves,
         one after the other. */
      if(hasPad) h += zkPadPageHTML();     /* D245: the ZS8K Configurator */

      var full = ZS.live.full[p.id];
      var liveOn = ZS.live.online!==false && !!full;
      /* the board runs ONE config at a time — the live picture is that config's
         output, so it is only honest to show it while editing that config */
      var isActive = p.id===ZS.activeId;
      if(liveOn){
        /* ONE WARNINGS BLOCK (screen-map §3.2): the drift warning + its fix
           button, the board's suppression sentences, and the stick/mouse
           warnings all merge here — BELOW the controls that answer them
           since the owner's reorder (2026-09-04), and still never folded:
           live feedback is rule 4's explicit exemption. */
        var wr = '';
        /* The reported "my aim drifts on its own" bug. The old Inner
           deadzone slider ran 0..40 with no floor, so one drag to zero let
           the pad's own resting offset through forever — and because the
           slider's minimum is 3 now, a config already at 0 would otherwise
           SHOW 3 while the board held 0. Say so, and offer the one tap. */
        var dz0 = (full || {}).deadZones || {};
        if(hasPad && feelOf('right')==='custom' &&
           dz0.rightInner!=null && dz0.rightInner < 0.03){
          /* "The slider below" was true when Inner deadzone sat on this
             screen. It is in the sheet now, so the sentence gives the route
             instead of pointing at nothing. The one-tap fix below still
             writes deadZones.rightInner = 0.08 either way. */
          /* D260: 0 is allowed again (the owner asked), so this is a
             warning chip, not a floor */
          wr += note('<b>Your aim may drift.</b> This config’s inner deadzone is '+
                    Math.round(dz0.rightInner*100)+'%. Most sticks rest a little off centre, '+
                    'so under about 3% a resting stick can reach the game as a slow push. '+
                    'If your aim moves on its own, raise Inner on the <b>Deadzones</b> card.','warn')+
               btn('Stop my aim drifting','primary','aim-fixdrift');
        }
        wr += suppressionNote();
        /* THE SAME LIST OVERVIEW USES, filtered to what belongs on an aim
           screen. This was a second, uncapped `st.warnings.forEach` that knew
           nothing about warnNotes() — five byte-identical cards, 617px of a
           685px viewport, before a single control. warnList() de-duplicates
           and rewrites once for the whole app, and the cap of three keeps a
           bad board from burying the aim settings it is complaining about. */
        if(isActive){
          var stW = warnList(ZS.live.status).filter(function(w){
            return /stick|mouse|dead ?zone|drift|aim help/i.test(w);
          });
          stW.slice(0,3).forEach(function(w){ wr += note('⚠ '+esc(w), 'warn'); });
          if(stW.length>3) wr += note('…and '+(stW.length-3)+' more — open Your board for the full list','warn');
        }
        /* The live aim pad is a PAD-mode instrument now: it draws two sticks,
           so a config that HAS a pad gets it — Joystick + Mouse included — and
           a mouse-only config does not, because there the two aim cards own
           the whole screen and there are no sticks to draw. */
        /* the live aim pad is OFF this screen (owner, 2026-09-05); the
           warning chips stay — live feedback is rule 4's explicit exemption,
           and a chip that is not needed draws nothing */
        h += wr;
      }
      /* D410 (owner, 2026-10-19: "In Controller Aim, at the bottom, a button
         you click - 'Calibration'"): the pad half's last thing, under both
         stance tabs, after the warnings. It opens the Calibration screen
         (pad-cal.js), which lends the pad on the Core to the calibration. */
      if(hasPad && window.ZSPADCAL) h += ZSPADCAL.buttonHTML();
      /* NO "Match Your Game" door here any more (owner, 2026-09-04: "remove
         start from a preset from the Aim tab — that's the whole point of
         when you make a profile, it asks you what game, and the presets are
         there"). R.game itself stays: the new-config flow is its home. */
       /* D238: the key back to the two halves */
       if (aimBoth && aimView) {
         /* D290: the Mouse & Keyboard half wears the owner's two pictures */
         h = '<button type="button" class="aimswitch" id="aim-switch">'+
           (aimView === 'pad' ? '' : '<i class="mkbhead" aria-hidden="true">'+'<img class="mkbpic" src="brand/devices/mouse-256.webp" alt="" aria-hidden="true">'+'<img class="mkbpic" src="brand/devices/keyboard-256.webp" alt="" aria-hidden="true">'+'</i>')+'Showing <b>'+
           (aimView === 'pad' ? 'Controller' : 'Mouse &amp; Keyboard')+'</b><span>Switch ›</span></button>'+h;
       }
       root.innerHTML = h; ZS.wire(root, ns);
       /* D243/D247: every Aim view wears the ZS8K Configurator's look - the
          controller page, and the mouse & keyboard one too (owner: "the same
          idea, colour theme and concept for the mouse and keyboard aim tabs
          and Mappings") */
       root.classList.add('zkaim');
       var asw = root.querySelector('#aim-switch');
       if (asw) asw.addEventListener('click', function(){ delete AIMV[p.id]; ZS.redrawOpenScreen(); });
      /* the doors this screen's copy names — each target keeps its own ns */
      wireDoors(root, p);
      /* D375: the read-only Mouse DPI line opens Device on its card */
      var dpiGo = root.querySelector('[data-aimdpi]');
      if (dpiGo) dpiGo.addEventListener('click', function(){
        if (ovSetTab) ovSetTab('Dpi');
        ZS.openDetail({ id:'overview', lab:'Device' }, p);
      });

      /* ── the stance tabs ──
         A tab tap flips which page is visible and nothing else: both pages
         are already rendered and wired, so there is no re-render to pay for
         and nothing the ~8s poll could ever replay. pagerPage survives the
         re-renders a preset tap DOES cause, exactly as it survived them when
         it was a scroll position. */
      var atabs = root.querySelector('#aimtabs');
      if(atabs){
        var tabBtns = atabs.querySelectorAll('button');
        var showStance = function(pg){
          pagerPage = pg;
          tabBtns.forEach(function(b){
            var on = (b.getAttribute('data-pg')==='1' ? 1 : 0) === pg;
            b.classList.toggle('on', on);
            b.setAttribute('aria-pressed', on?'true':'false');
          });
          /* [data-stance] — the pager's two panes and nothing else. The stick
             page is an .aimpage too, and the bare selector's
             `data-key==='ads' ? 1 : 0` would read its key as 0 and hide the
             whole stick card the moment a Joystick + Mouse player tapped ADS
             aim. Tabs hide stances, not pages. */
          root.querySelectorAll('.aimpage[data-stance]').forEach(function(sec){
            sec.classList.toggle('aimoff',
              (sec.getAttribute('data-key')==='ads' ? 1 : 0) !== pg);
          });
        };
        tabBtns.forEach(function(b){
          b.addEventListener('click', function(){
            showStance(b.getAttribute('data-pg')==='1' ? 1 : 0);
          });
        });
      }
      /* the ADS sensitivity switch. wire() has already given the .sw its
         flip (nosave, so no saveV); this listener is the write. It asks the
         board's copy what the switch WAS rather than reading the class after
         the flip, so it cannot depend on listener order. */
      /* the stick ADS page's inheritance line (the old switch): one tap
         flips adsGain between null and a seeded number through adsSet */
      root.querySelectorAll('[data-zkadssm]').forEach(function(b){
        b.addEventListener('click', function(){
          if(ZS.live.online===false || !ZS.live.full[p.id]){ ZS.toast('Your board is offline'); return; }
          var v = parseFloat(b.getAttribute('data-zkadssm')) || 0;
          feelWrite(function(f){ if(!f.smoothing) f.smoothing = {}; f.smoothing.rightStickAds = v; });
          render(root);
        });
      });
      var inh = root.querySelector('[data-xinherit="stick"]');
      if(inh) inh.addEventListener('click', function(){
        adsSet(adsGainOf()===null, root);
      });
      root.querySelectorAll('.smcar[data-mode]').forEach(function(car){
        var mode = car.getAttribute('data-mode')==='ads' ? 'ads' : 'hip';
        car.querySelectorAll('button').forEach(function(b){
          b.addEventListener('click', function(){
            var opts = smOptionsOf(mode);
            var i = opts.indexOf(smPresetOf(mode)) +
                    (parseFloat(b.getAttribute('data-d')||'1')<0 ? -1 : 1);
            if(i<0 || i>=opts.length) return;
            smApply(mode, opts[i], root);
          });
        });
      });
      /* D191: XIM's Custom mode button (Standard | Classic), mouse stances and
         the aim stick alike, and Classic's "adds about N ms" line, which
         follows the three steppers as they move. */
      root.querySelectorAll('.smstyle[data-smstylefor]').forEach(function(seg){
        var who = seg.getAttribute('data-smstylefor');
        seg.querySelectorAll('button[data-smstyle]').forEach(function(b){
          b.addEventListener('click', function(){
            /* the style the page was drawn on, not the .on class (the kit's
               seg2 wiring may already have moved it to this button) */
            var style = b.getAttribute('data-smstyle');
            if(style === seg.getAttribute('data-smcur')) return;
            if(who==='stick') smStickStyleSet(style, root);
            else smStyleSet(who==='ads' ? 'ads' : 'hip', style, root);
          });
        });
      });
      /* D392: "Use Sync to game": the stance's Synch (both stances', so
         nothing is left stacked) moves to mouseTranslation.syncHz, the one
         frame-sync control, unless that is already on */
      root.querySelectorAll('[data-synchmove]').forEach(function(b){
        b.addEventListener('click', function(){
          if(ZS.live.online===false || !ZS.live.full[p.id]){ ZS.toast('Your board is offline'); return; }
          var ms = parseFloat(b.getAttribute('data-synchmove')) || 0;
          smWrite(function(f){
            if(!f.mouseTranslation) f.mouseTranslation={};
            var mt = f.mouseTranslation;
            if(!(+mt.syncHz > 0)) mt.syncHz = ms <= 12 ? 120 : 60;
            if(typeof mt.classicSynch==='number') mt.classicSynch = 0;
            if(typeof mt.adsClassicSynch==='number') mt.adsClassicSynch = 0;
          });
          ZS.toast('Sync to game is on (Translation page)');
          render(root);
        });
      });
      root.querySelectorAll('.smcustom').forEach(function(box){
        var lag = box.querySelector('.smlag');
        if(!lag) return;
        box.addEventListener('zsstep', function(){
          var v = [].map.call(box.querySelectorAll('.stp .sv'), function(sv){ return parseFloat(sv.textContent||'0'); });
          /* D392: the mouse's Classic shows two steppers (no Synch); a Synch
             still stored counts until it is moved to Sync to game */
          var mv = box.querySelector('[data-synchmove]');
          var sy = v.length >= 3 ? v[2] : (mv ? parseFloat(mv.getAttribute('data-synchmove')) || 0 : 0);
          if(v.length >= 2) lag.textContent = 'Adds about '+(Math.round(classicLagMs(v[0], v[1], sy)*10)/10)+' ms of delay.';
        });
      });
      /* A SEPARATE loop from the pager's .smcar[data-mode] one above, not a
         branch inside it. That one hands `mode` to smOptionsOf / smPresetOf /
         smApply — the mouse trio's three functions, one of which has a
         "Same as hip" inherit branch a stick has no concept of. Keeping the
         two paths apart means nothing here can regress the shipped pager. */
      root.querySelectorAll('.smcar[data-smset="stick"]').forEach(function(car){
        car.querySelectorAll('button').forEach(function(b){
          b.addEventListener('click', function(){
            var opts = smStickOptions();
            var d = parseFloat(b.getAttribute('data-d')||'1')<0 ? -1 : 1;
            var i = opts.indexOf(smStickPreset()) + d;
            if(i<0 || i>=opts.length) return;
            smStickApply(opts[i], root, d);
          });
        });
      });
      /* ── the ••• folds ──
         A tap flips the fold's `hidden` and nothing else — the fold is
         already rendered and wired — and remembers itself in XMECH_OPEN so
         the re-render a preset tap causes opens it again. */
      root.querySelectorAll('[data-xmore]').forEach(function(bt){
        bt.addEventListener('click', function(){
          var key = bt.getAttribute('data-xmore');
          var fold = root.querySelector('.xmech[data-xmech="'+key+'"]');
          if(!fold) return;
          var open = fold.hasAttribute('hidden');
          if(open) fold.removeAttribute('hidden'); else fold.setAttribute('hidden', '');
          bt.setAttribute('aria-expanded', open ? 'true' : 'false');
          XMECH_OPEN[p.id+'|'+key] = open;
        });
      });
      /* D376: Advanced, for the whole screen at once (both stances' cards
         carry the button); the quantization buttons open their two */
      root.querySelectorAll('[data-xadv]').forEach(function(bt){
        bt.addEventListener('click', function(){
          var on = !aimAdvOn();
          aimAdvSet(on);
          /* the section is below everything, so nothing above it moves;
             the scroller's position is put back anyway, so turning it off
             at the bottom of a long page never jumps the view */
          var sc = bt, top = null;
          while(sc && sc.parentElement && !(sc.scrollHeight > sc.clientHeight + 4 &&
                /auto|scroll/.test((window.getComputedStyle ? getComputedStyle(sc).overflowY : '') || ''))) sc = sc.parentElement;
          var y0 = bt.getBoundingClientRect ? bt.getBoundingClientRect().top : 0;
          if(sc && sc !== bt) top = sc.scrollTop;
          root.querySelectorAll('.advonly').forEach(function(d){
            if(on) d.removeAttribute('hidden'); else d.setAttribute('hidden', '');
          });
          root.querySelectorAll('.xadvwhere').forEach(function(w){
            if(on) w.removeAttribute('hidden'); else w.setAttribute('hidden', '');
          });
          if(top !== null && bt.getBoundingClientRect){
            var dy = bt.getBoundingClientRect().top - y0;
            if(dy) sc.scrollTop = top + dy;
          }
          var inUse = advInUse();
          root.querySelectorAll('[data-xadv]').forEach(function(b){ b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
          root.querySelectorAll('.xadvhint').forEach(function(t){
            if(!on && inUse) t.removeAttribute('hidden'); else t.setAttribute('hidden', '');
          });
        });
      });
      root.querySelectorAll('[data-xquant]').forEach(function(bt){
        bt.addEventListener('click', function(){
          var st = bt.getAttribute('data-xquant');
          var box = root.querySelector('#xquant-'+st);
          if(!box) return;
          var open = box.hasAttribute('hidden');
          if(open) box.removeAttribute('hidden'); else box.setAttribute('hidden', '');
          bt.setAttribute('aria-expanded', open ? 'true' : 'false');
          XQUANT_OPEN[p.id+'|'+st] = open;
        });
      });
      wireMouseMech(root);
      wireSpeedCm(root);                 /* D376 amended: Speed's cm/360 small print */
      wireActivation(root);              /* D376 amended: Activation opens and closes */
      wireZeroWord(root);                /* D377: 0 says Standard / Same as hip */
      feelWire(root);                    /* D184 / D186: the stick mode */
      if(hasPad && window.ZSZK) ZSZK.wire(root, p, zkOpt(root));   /* D245 */
      if(hasPad && window.ZSPADCAL) ZSPADCAL.wire(root, p);         /* D410 */

      /* no live pad on this screen any more (owner, 2026-09-05: "nothing
         more AT ALL"); liveResponsePad() and aimPadHTML() stay in the file
         for a future home. */

      var fixd = root.querySelector('#aim-fixdrift');
      if(fixd) fixd.addEventListener('click', function(){
        if(!liveOn){ ZS.toast('Your board is offline'); return; }
        /* m13: staged like every setting (D257), and the toast and the
           redraw follow the answer: a refused write used to say it was set */
        ZS.editProfile(p.id, function(f){
          if(!f.deadZones) f.deadZones={};
          f.deadZones.rightInner = 0.08;
        }).then(function(j){
          if(j && j.ok === false){ ZS.toast('Not set: '+(j.error || 'the board would not take it')); return; }
          ZS.toast('Inner deadzone set to 8% — take your hands off and check the dot sits centre');
          /* the whole screen, not render(): boardFull was read when R.aim
             was called, so only a full re-open sees the value just written */
          ZS.redrawOpenScreen();
        });
      });

      /* THE .seg2 SWEEP IS GONE, all four branches of it. Two of them wired
         controls that moved into the stick's Mechanics sheet (the old
         Native|Tuned switch, merged into Stick mode by D186, and the curve
         preset) and are hand-wired there now, next to the
         markup they belong to. The other two were already ghosts of exactly
         the kind the comment that used to stand here forbade: the update-rate
         seg lives in another renderer with its own wiring, the game seg is
         not emitted by R.aim at all, and that branch's `gameSel = ...` was an
         assignment to a name declared nowhere in the file. Nothing this
         screen emits needs hand-wiring any more — the shared Feel seg and the
         sheet's Deadzone shape both carry data-binds and are ZS.wire's. */

    }

    return { html:'', after:function(root){
      /* D238: which half? */
      if (aimBoth && !aimView) {
        var padPic = (ZS.devicePicFor && ZS.userDevices)
          ? (ZS.userDevices(ZS.devices).filter(function(d){ return d.kind === 'gamepad'; }).map(ZS.devicePicFor)[0] || '') : '';
        root.classList.add('zkaim');     /* D247: the chooser too */
        root.innerHTML = '<div class="aimchoose" role="group" aria-label="which aim settings to tune">'+
          '<button type="button" class="aimch" data-aimview="pad">'+
            (padPic ? '<img src="'+esc(padPic)+'" alt="" aria-hidden="true">' : '')+
            '<b>Controller</b><span>stick aim</span></button>'+
          /* D290: the owner's own mouse and keyboard, side by side, as
             Mappings' chooser wears them */
          '<button type="button" class="aimch" data-aimview="kbm">'+
            '<span class="aimch2">'+
              '<img class="mkbpic" src="brand/devices/mouse-256.webp" alt="" aria-hidden="true">'+
              '<img class="mkbpic" src="brand/devices/keyboard-512.webp" alt="" aria-hidden="true">'+
            '</span>'+
            '<b>Mouse &amp; Keyboard</b><span>mouse aim</span></button></div>';
        root.querySelectorAll('[data-aimview]').forEach(function(b){
          b.addEventListener('click', function(){ AIMV[p.id] = b.dataset.aimview; ZS.redrawOpenScreen(); });
        });
        return;
      }
      render(root);
    } };
  };
});
