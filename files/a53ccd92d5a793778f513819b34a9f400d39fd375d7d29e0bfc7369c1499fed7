/* smart-actions/03-strip.js — the step strip and its pictures.
 *
 * The row of step tiles under an action, the icon set (D82, pictures since
 * D91) and the arrow composites for a stick step.
 *
 * Tests: test-icons3d.js, test-smart-actions.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('strip', function (SEC) {
  'use strict';
  /* from the parts before this one */
  var conFam = SEC.conFam, dpsWord = SEC.dpsWord, esc = SEC.esc,
      isKeyTarget = SEC.isKeyTarget, num = SEC.num, srcArt = SEC.srcArt,
      tgtShort = SEC.tgtShort, ZS = SEC.ZS, dur = SEC.dur, stepLine = SEC.stepLine,
      totalTime = SEC.totalTime, clamp = SEC.clamp;

  /* ══ the strip ════════════════════════════════════════════════════
     XIM MATRIX draws an action as a horizontal row of square tiles — button
     art with the step's parameter burned in as a badge across the bottom — and
     it is the one thing in their UI worth copying wholesale: you recognise a
     whole sequence at a glance, without reading a word.

     What is NOT worth copying is what theirs becomes at thirteen steps: a
     wrapping grid of thirteen wordless tiles carrying numbers in three
     different units, with no total duration anywhere. That is an enthusiast
     tool's density cliff, and it would be hostile to a beginner.

     So here the strip is an ADDITION and never a replacement. The plain-English
     sentence still says what the action DOES; the strip only helps you spot
     which action it IS. Three deliberate departures from XIM:

       · it WRAPS instead of scrolling off the edge — nothing hides off-screen;
       · it carries a TOTAL DURATION, the single most useful number for a timed
         sequence and the one XIM has nowhere;
       · past ten steps the LIST collapses its middle into "+N more". The
         EDITOR never collapses — that is where you go to change a step, and a
         step you cannot reach is worse than a long strip.

     Presentation only. Nothing here reads or writes a step; the board's JSON is
     untouched by every function below. */

  /* the badge has about seven characters of room, so ms are spelled tight here
     rather than through dur(), which is written for a sentence */
  function msShort(ms) {
    ms = Math.round(num(ms, 0));
    if (ms < 1000) return ms + 'ms';
    return (Math.round(ms / 100) / 10) + 's';
  }

  /* mark(): one hand-drawn stroke mark in the same 48×48 box ZSART draws a
     control in. Since D82 it draws only what the icon set has no picture
     for (the mouse side-button fallback, MARK_MSIDE); every step KIND and
     every editor control is a real icon from the set below. */
  function mark(inner, extra) {
    return '<svg viewBox="0 0 48 48" width="30" height="30" class="satmark" aria-hidden="true" ' +
      'focusable="false" fill="none" stroke="currentColor" stroke-width="2.6" ' +
      'stroke-linecap="round" stroke-linejoin="round"' + (extra || '') + '>' + inner + '</svg>';
  }

  /* ── THE ICON SET (D82; pictures since D91) ──
     Owner (2026-09-05): "the smart action wait, hold, aim nudge, aim speed,
     swap sticks, switch config and everything all is basic — find ones
     that fit these that look right, like real professional free ones";
     and (2026-09-06) "get real pngs, don't draw them yourself, find ones
     on the internet for every icon on everything." So every step kind and
     every editor control is a real rendered PICTURE from icons3d/
     (Microsoft Fluent Emoji, 3D style, MIT — the notice travels in
     icons3d/LICENSE), drawn by ZS.sicon (phone.html) as
     <img class="sicon si-<name>" alt="" aria-hidden> with the classes the
     CSS below and the tests know, so the D82 rules still hold: ONE set
     everywhere a kind or a control is drawn (the option tiles, the box,
     the Mappings rows, the Smart Actions cards, the once/repeat badge, the
     nav, the foot); never colour alone, because every tile keeps its word
     and every icon-only control keeps its aria-label. 'more' stays the
     kit's three dots (no ellipsis picture exists in any licensed set). The
     flat Phosphor set (stepicons.js) is retired. sicon() degrades to the
     kind's short word if the set has no picture for a name, so a tile
     never goes blank. */
  function sicon(name, word, px) {
    var h = '';
    if (ZS.sicon) { try { h = ZS.sicon(name, px); } catch (e) { h = ''; } }
    return h || (word ? '<span class="sattext">' + esc(word) + '</span>' : '');
  }
  var MARK_WAIT = sicon('wait', 'wait');
  var MARK_AIM = sicon('aim', 'aim');
  var MARK_SENS = sicon('aimspeed', 'speed');
  var MARK_SWAP = sicon('swap', 'swap');
  var MARK_CONFIG = sicon('config', 'config');
  var MARK_UNKNOWN = sicon('warn', '?');
  /* the Smart Actions Editor door (D78/D79): the set's target, not the
     logo's reticle, which is the spinner and the locked-on state */
  var MARK_TARGET = sicon('editor', 'editor');
  /* The aim tile is the crosshair, and WHERE the stick goes rides its corner
     as a small arrow turned to the angle — the same corner chip the press ↓
     / let go ↑ arrows ride on a button tile (arrOvr below) — so a direction
     step and a magnitude step never look the same, which is the one thing
     XIM's static reticle gets wrong. The board's angle grows counter-
     clockwise with 90° = up and SVG rotate() turns clockwise, so the angle
     is negated: the same inversion the direction dial makes. */
  function dirOvr(angle) {
    var deg = -((((num(angle, 0)) % 360) + 360) % 360);
    return arrOvr('dir', '<g transform="rotate(' + (Math.round(deg * 10) / 10) + ' 10 10)">' +
      '<path d="M4 10h11"/><path d="M10.5 5.5l4.5 4.5-4.5 4.5"/></g>');
  }

  /* The step targets are OUTPUT — what the console receives — so their art
     follows the console this config targets, exactly as tgtName() does. The
     INPUT art on a row (the trigger under your thumb) keeps going through
     srcArt/ZSG, which reads the pad actually plugged in. Getting those two
     backwards is the bug this file was written to end, and the strip does not
     get to reintroduce it. */
  /* THE REAL BUTTON, NOT A LIT ONE (owner, 2026-10-07: "when someone clicks
     a button like LT RT X Y currently you make all the images green, idk why
     you aren't using the real images of the buttons you already have").
     The tile used to be controller-art.js's button with `on: true` — the
     LIVE-INPUT highlight, which floods the whole drawing in the family's lit
     colour (Xbox #2fd074 green, PS blue): X lost its blue, Y its yellow, and
     every pressed step in a strip was the same green dome. A step is not a
     live press. It now draws exactly the picture the deck it was tapped
     from draws (tgtSvg: padcaps.js, the Kenney pack, D80 — the same art as
     Mappings), so the tile and the key under your thumb match. What KIND of
     step it is (press, hold, let go) rides the corner arrow, not the art's
     colour, so `lit` is kept only as a name for the caller's intent. */
  function tileArt(code, p, lit) {
    /* D128: a key or a click a step presses is drawn as the keycap or the
       mouse it is (keycaps.js), never as a pad button's pill spelling
       "btn_left" */
    if (isKeyTarget(code)) return srcArt(code);
    var Z = window.ZSG, real = Z && typeof Z.outGlyph === 'function' ? Z.outGlyph(code, conFam(p)) : '';
    if (real) return real;
    /* no padcaps drawing for this code (the guide's trademark, an odd
       code): controller-art.js's own UNLIT drawing — never the lit one */
    var A = window.ZSART;
    if (A && typeof A.button === 'function') {
      try { return A.button(code, conFam(p), { width: 30, on: false }); } catch (e) {}
    }
    /* No art loaded (or a code it will not draw): the tile still has to say
       which control it is, so it degrades to the short name rather than to an
       empty square. */
    return '<span class="sattext">' + esc(tgtShort(code, p)) + '</span>';
  }
  function textTile(t) { return '<span class="sattext">' + esc(t) + '</span>'; }

  /* D232 (owner, 2026-10-07: "change the logo to an actual stick and make it
     animated, pushed in whatever direction they set it to on the image").
     A thumbstick seen from above: the base, the well, and the cap pushed
     `dist` (0..1) of the way toward `angle` (degrees, 0 = right, 90 = up,
     the compass the aim step uses). `anim` makes the cap travel from centre
     to that push and back, on a loop (the Sticks page; off under reduced
     motion); a tile draws it still. The plastic is a fixed dark grey in
     both themes - it is a picture of a real stick. */
  function stickSvg(angle, dist, anim) {
    var a = num(angle, 0) * Math.PI / 180, d = clamp(num(dist, 0), 0, 1);
    var dx = Math.round(Math.cos(a) * d * 22 * 10) / 10, dy = Math.round(-Math.sin(a) * d * 22 * 10) / 10;
    var cap = '<g class="stkcap' + (anim ? ' stkanim' : '') + '" style="--dx:' + dx + 'px;--dy:' + dy + 'px"' +
      (anim ? '' : ' transform="translate(' + dx + ' ' + dy + ')"') + '>' +
      '<circle cx="50" cy="53" r="22" fill="#000" opacity=".35"/>' +
      '<circle cx="50" cy="50" r="22" fill="url(#stkg)" stroke="#0d0f13" stroke-width="1.5"/>' +
      '<circle cx="50" cy="50" r="15" fill="none" stroke="#5b6270" stroke-width="2.4" opacity=".9"/>' +
      '<circle cx="50" cy="50" r="7" fill="#2b3038"/></g>';
    return '<svg class="stksvg" viewBox="0 0 100 100" aria-hidden="true">' +
      '<defs><radialGradient id="stkg" cx="42%" cy="36%" r="70%"><stop offset="0" stop-color="#6c7482"/>' +
      '<stop offset=".55" stop-color="#3a404b"/><stop offset="1" stop-color="#1c2027"/></radialGradient></defs>' +
      '<circle cx="50" cy="50" r="47" fill="#1a1d23" stroke="#3c4250" stroke-width="2"/>' +
      '<circle cx="50" cy="50" r="38" fill="#0c0e12"/>' +
      (d > 0 ? '<line class="stkdir" x1="50" y1="50" x2="' + (50 + dx * 1.7) + '" y2="' + (50 + dy * 1.7) +
        '" stroke="var(--accent,#6f9bff)" stroke-width="3" stroke-linecap="round" opacity=".55"/>' : '') +
      cap + '</svg>';
  }

  /* ── THE ARROW COMPOSITES (screen-map §5.1 / P3) ──
     XIM draws a step's KIND on the tile itself: press = the button with a
     down-arrow, release = the button with an up-arrow, tap = both. Ours used
     to spell the kind as a word in the badge ("hold" / "let go"), which
     meant the badge — seven characters of room — was spent on the kind
     instead of the number, and a strip of five steps read as a row of words.
     The arrow rides the tile's corner exactly the way the .satplus combo
     count does, and the badge shrinks to the ms figure alone (nothing, when
     the step has no length). The kind is never glyph-only to a screen
     reader: every tile's title/aria-label already says the whole step in
     words via stepLine(), and that sentence is unchanged. */
  function arrOvr(kind, inner) {
    return '<i class="satarr satarr-' + kind + '" aria-hidden="true">' +
      '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" ' +
      'stroke-linecap="round" stroke-linejoin="round">' + inner + '</svg></i>';
  }
  var ARROW_OVR = {
    /* geometry echoes MARK_HOLDSTEP / MARK_RELEASE, minus the button rect —
       the tile's own art IS the button here */
    down: arrOvr('down', '<path d="M10 3.5v9"/><path d="M5.5 8.5l4.5 4.5 4.5-4.5"/>'),
    up: arrOvr('up', '<path d="M10 16.5v-9"/><path d="M5.5 11.5l4.5-4.5 4.5 4.5"/>'),
    /* tap = down-then-up, read left to right: a press that lets itself go */
    tap: arrOvr('tap', '<path d="M6 3.5v8"/><path d="M2.9 8.3l3.1 3.2 3.1-3.2"/>' +
      '<path d="M14 16.5v-8"/><path d="M10.9 11.7l3.1-3.2 3.1 3.2"/>')
  };

  /* {art, badge, extra, arr} for one step. `extra` is the corner count on a
     combo: a step that presses three buttons at once is still ONE tile, so
     the tile has to admit the other two exist. `arr` is the arrow composite
     above — the step KIND drawn instead of spelled. */
  function stepTile(s, p) {
    var c = (s.t && s.t.length) ? s.t[0] : null;
    var extra = (s.t && s.t.length > 1) ? '+' + (s.t.length - 1) : '';
    if (s.k === 'tap') return { art: c ? tileArt(c, p, true) : textTile('?'), badge: msShort(s.ms), extra: extra, arr: 'tap' };
    if (s.k === 'hold') return { art: c ? tileArt(c, p, true) : textTile('?'), badge: '', extra: extra, arr: 'down' };
    /* a release is drawn UNLIT on purpose — the art carries the difference
       between holding a button and letting it go, and the up-arrow says it
       twice */
    /* D270: a stick let go back to the centre (a recording's): the stick at
       rest, which side on the badge */
    if (s.k === 'release' && SEC.stickLetGo(s)) return { art: stickSvg(0, 0, false),
      badge: (SEC.stickLetGo(s) === 'left' ? 'L' : 'R') + ' centre', extra: '', arr: 'up' };
    if (s.k === 'release') return { art: c ? tileArt(c, p, false) : textTile('?'), badge: '', extra: extra, arr: 'up' };
    if (s.k === 'trig') return { art: c ? tileArt(c, p, true) : textTile('?'), badge: s.keep ? '' : msShort(s.ms), extra: '', arr: s.keep ? 'down' : 'tap' };
    if (s.k === 'wait') return { art: MARK_WAIT, badge: msShort(s.ms), extra: '' };
    /* the crosshair, the distance burned in, the direction on the corner */
    /* D232: the stick itself, pushed the way the step pushes it */
    if (s.k === 'stick') return { art: stickSvg(s.angle, num(s.dps, 0) > 0 ? 0.8 : s.dist, false),
      badge: (s.stick === 'left' ? 'L ' : 'R ') + (num(s.dps, 0) > 0 ? dpsWord(s.dps) : Math.round(num(s.dist, 0) * 100) + '%'),
      extra: '' };
    if (s.k === 'sens') return { art: MARK_SENS, badge: '×' + (Math.round(num(s.scale, 1) * 100) / 100), extra: '' };
    if (s.k === 'swap') return { art: MARK_SWAP, badge: 'swap', extra: '' };
    /* D170: the crosshair, its length burned in, the pull's direction on
       the corner (the compass the aim tile uses: 0 right, 90 up) */
    if (s.k === 'move') return {
      art: MARK_AIM, badge: msShort(s.ms), extra: '',
      dir: Math.round(((Math.atan2(-num(s.dy, 0), num(s.dx, 0)) * 180 / Math.PI) + 360) % 360)
    };
    /* D280: the crosshair, turning */
    if (s.k === 'tassist') return { art: MARK_AIM, badge: 'turn', extra: '' };
    if (s.k === 'config') return {
      art: MARK_CONFIG,
      badge: s.to === 'next' ? 'next' : s.to === 'prev' ? 'prev' : '#' + s.to, extra: ''
    };
    return { art: MARK_UNKNOWN, badge: '?', extra: '' };
  }

  function tileBody(t) {
    /* the badge span is kept even when empty so every tile in a strip keeps
       the same three-band height — art over badge — and the row never
       staggers */
    return '<span class="satart">' + t.art +
      (t.extra ? '<i class="satplus">' + esc(t.extra) + '</i>' : '') +
      (t.arr && ARROW_OVR[t.arr] ? ARROW_OVR[t.arr] : '') +
      (t.dir != null ? dirOvr(t.dir) : '') + '</span>' +
      '<span class="satbadge">' + esc(t.badge) + '</span>';
  }

  function tileHTML(s, i, steps, p, o) {
    var t = stepTile(s, p);
    var say = 'Step ' + (i + 1) + ': ' + stepLine(s, i, steps, p);
    var cls = 'satile' + (o.sel === i ? ' sel' : '') + (o.now === i ? ' now' : '');
    if (!o.tap) {
      /* Read-only in the list, and hidden from a screen reader on purpose: the
         row already reads out the whole action as one plain sentence, and ten
         more announcements of the same thing in tile form would bury it. The
         strip is a recognition aid for the eye. */
      return '<span class="' + cls + '" title="' + esc(say) + '" aria-hidden="true">' + tileBody(t) + '</span>';
    }
    return '<button type="button" class="' + cls + '" data-tile="' + i + '" title="' + esc(say) +
      '" aria-pressed="' + (o.sel === i ? 'true' : 'false') +
      '" aria-label="' + esc(say + ' — go to this step') + '">' + tileBody(t) + '</button>';
  }

  /* THE ACTIVATION'S OWN JOB, FIRST IN THE BOX (owner, 2026-10-07: "if I
     bind LT as the activation ... it should say LT with an unlimited
     hourglass, held down until I let go" - LT still aims while an aim-assist
     script runs). This is a PICTURE of what the engine already does, never a
     step: set_takeover consumes the activation's output only when a step
     drives that same output, so with no such step the button keeps sending
     its own binding for exactly as long as it is held. A real "hold LT" step
     would be wrong twice: it would take LT over, and LT would drop the
     moment a once-mode script finished while the trigger was still down.
     So the tile shows only while no step drives the target, and it is not
     tappable, selectable or counted. */
  function stepDrives(steps, target) {
    for (var i = 0; i < steps.length; i++) {
      var t = steps[i] && steps[i].t;
      if (t && t.indexOf && t.indexOf(target) >= 0) return true;
    }
    return false;
  }
  function passTileHTML(a, p, target) {
    if (!target || stepDrives(a.steps || [], target)) return '';
    var name = tgtShort(target, p);
    var say = name + ' keeps working - held for as long as you hold it';
    return '<span class="satile pass" role="img" aria-label="' + esc(say) + '" title="' + esc(say) + '">' +
      tileBody({ art: tileArt(target, p, false), badge: '∞', extra: '', arr: 'down' }) + '</span>';
  }

  /* XIM shows no total anywhere, and for a thing built out of milliseconds it
     is the number you actually want. "0.4 s over and over" is a different
     animal from "0.4 s", so the loop and the repeat count ride along with it. */
  function totalChip(a) {
    var ms = totalTime(a);
    var txt = ms > 0 ? 'about ' + msShort(ms) : 'no time';
    var say = ms > 0 ? 'the whole thing takes about ' + dur(ms) : 'this takes no time at all';
    var rep = '';
    /* the hourglass says "how long"; the loop mark after it says "and again" */
    if (a.holdMode === 'repeat_while_held') { rep = sicon('repeat'); say += ', repeating for as long as you hold it'; }
    else if (a.maxRepeats > 1) { txt += ' ×' + a.maxRepeats; say += ', played ' + a.maxRepeats + ' times'; }
    return '<span class="satot" role="img" aria-label="' + esc(say) + '" title="' + esc(say) +
      '">' + sicon('duration') + esc(txt) + rep + '</span>';
  }

  /* the same sentence in words, appended to the row's aria-label so the total
     is not sighted-only */
  /* the row's spoken identity, punctuated once */
  function rowSay(a, line, dead) {
    var say = (a.name || 'Untitled action') + ' — ' + line + totalSay(a);
    return dead ? say.replace(/\s*\.?\s*$/, '') + '. Will not fire.' : say;
  }

  function totalSay(a) {
    var ms = totalTime(a);
    return (a.steps.length && ms > 0) ? ' It takes about ' + dur(ms) + '.' : '';
  }

  /* past this many steps the LIST collapses its middle. Six at the front and
     three at the back keeps both ends of a sequence — the shape you actually
     recognise it by — inside ten tiles. */
  var LIST_TILE_CAP = 10, LIST_HEAD = 6, LIST_TAIL = 3;

  function stripHTML(a, p, o) {
    o = o || {};
    var steps = a.steps, i, body = '';
    if (!steps.length) return '';
    var hidden = (!o.tap && steps.length > LIST_TILE_CAP) ? steps.length - LIST_HEAD - LIST_TAIL : 0;
    if (o.pass) body += o.pass;
    for (i = 0; i < steps.length; i++) {
      if (hidden && i === LIST_HEAD) {
        body += '<span class="satile more" aria-hidden="true" title="' +
          esc(hidden + ' more steps — open the action to see them all') + '">' +
          '<span class="satart"><b>+' + hidden + '</b></span>' +
          '<span class="satbadge">more</span></span>';
      }
      if (hidden && i >= LIST_HEAD && i < LIST_HEAD + hidden) continue;
      body += tileHTML(steps[i], i, steps, p, o);
    }
    if (o.plus) {
      body += '<button type="button" class="satile" id="sa-addstep" ' +
        'aria-label="add another step — pick one from the palette below">' +
        '<span class="satart">' + (sicon('plus') || '<b>＋</b>') + '</span><span class="satbadge">add</span></button>';
    }
    return '<span class="sastrip' + (o.tap ? '' : ' mini') + '"' +
      (o.tap ? ' role="group" aria-label="the sequence, step by step"' : ' aria-hidden="true"') +
      '>' + body + totalChip(a) + '</span>';
  }

  /* the editor's copy: every step, always, with the one being edited lit.
     The "Tap a tile to jump to that step" note is GONE — the nav triple
     under it says the same thing by being there, and prose has no place on
     an authoring surface. The trailing dashed ＋ is what makes the
     relationship between the palette and the strip visible rather than
     inferred. */
  function stripBoxHTML(a, p, S, running, sel, passTarget) {
    var pass = passTileHTML(a, p, passTarget);
    return '<div class="sastripbox" id="sa-strip">' +
      (a.steps.length
        ? stripHTML(a, p, { tap: true, sel: sel, now: running, plus: true, pass: pass })
        : '<span class="sastrip" role="group" aria-label="the sequence, step by step">' + pass +
          '<button type="button" class="satile" id="sa-addstep" aria-label="add the first step">' +
          '<span class="satart">' + (sicon('plus') || '<b>＋</b>') + '</span><span class="satbadge">add</span></button></span>') +
      '</div>';
  }

  /* what the other parts use from this one */
  SEC.MARK_AIM = MARK_AIM;
  SEC.MARK_CONFIG = MARK_CONFIG;
  SEC.MARK_SENS = MARK_SENS;
  SEC.MARK_SWAP = MARK_SWAP;
  SEC.MARK_TARGET = MARK_TARGET;
  SEC.MARK_WAIT = MARK_WAIT;
  SEC.mark = mark;
  SEC.msShort = msShort;
  SEC.passTileHTML = passTileHTML;
  SEC.sicon = sicon;
  SEC.stepTile = stepTile;
  SEC.stickSvg = stickSvg;
  SEC.stripBoxHTML = stripBoxHTML;
  SEC.stripHTML = stripHTML;
  SEC.tileBody = tileBody;
  SEC.tileHTML = tileHTML;
  SEC.totalChip = totalChip;
  SEC.totalSay = totalSay;
});
