/* smart-actions/04-styling.js — the editor's stylesheet (injectCSS, #zs-smart-css).
 *
 * Every rule the Scripts and Mappings screens draw with, injected once. The
 * swipe deck it styles is 15-pager.js (which also publishes ZS.deck).
 *
 * Tests: test-theme.js (literal colours), test-render.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('styling', function (SEC) {
  'use strict';

  /* ══ styling ══════════════════════════════════════════════════════
     Injected from here rather than added to phone.html's <style>, so this
     screen is one self-contained file. Everything reuses the app's CSS
     variables, so Ease of Access and the theme keep working. */
  var CSS =
    '.salab{flex:1;font-size:14px;min-width:0}' +
    '.salab em{display:block;color:var(--muted);font-size:12px;font-style:normal;margin-top:2px}' +
    '.lrow .src em{display:block;color:var(--muted);font-size:11.5px;font-style:normal;font-weight:400;margin-top:3px;line-height:1.4;white-space:normal}' +
    '.lrow.saitem{align-items:flex-start}' +
    '.lrow.saitem .src{white-space:normal;overflow:visible;text-overflow:clip}' +
    '.lrow.saitem .rt{align-items:center}' +
    '.sadot{width:10px;height:10px;border-radius:50%;flex:none;margin-top:5px}' +
    '.sasync{font-size:10px;margin-left:6px}' +
    /* --red is a FILL/RAIL colour: it measures 4.54:1 on a card but only
       3.36:1 on a control face, so every RED WORD in this file uses
       --red-ink (#ff8078, 5.39:1 on a control) and every red RAIL keeps the
       base. That split is phone.html §3's own rule, not a local preference. */
    '.sasync.live{color:var(--green)}.sasync.off{color:var(--muted)}.sasync.bad{color:var(--red-ink)}' +
    /* A dead action has to be loud. It reads exactly like a working one
       otherwise — same row, same green dot — which is how "I set it up and
       nothing happens" survives for weeks. */
    '.sadead{display:block;color:var(--red-ink);font-size:11.5px;line-height:1.35;margin-top:3px}' +
    '.sadead b{font-weight:700;text-decoration:underline}' +
    '.sadead b[data-fadoor],.sadead b[data-fix]{cursor:pointer}' +
    /* ── THE INDEX ROW'S LEFT EDGE ──
       "Everything you have" was a single card of identical grey slabs: an
       action that RUNS, one that is switched OFF and one that CANNOT FIRE
       all drew the same rectangle, and the only difference was a 10px dot
       whose colour is user data. The rail is the state, three ways at once —
       the room's own hue when it is live, a muted groove when it is off, red
       when it is broken — and every one of them still says so in words on
       the row. Colour encodes; it is never the only signal. */
    '.lrow.saitem{border-left:3px solid var(--tint,var(--accent));padding-left:13px}' +
    '.lrow.saitem.saoffrow{border-left-color:var(--zs-edge,var(--line));opacity:.72}' +
    '.lrow.sabroken{border-left:3px solid var(--red);padding-left:9px}' +
    /* two class names deep, so "broken" beats "off" whatever order they are
       written in — a row that is both is a row you must fix, not one you
       chose to silence */
    '.lrow.saitem.sabroken{border-left-color:var(--red);opacity:1}' +
    /* "already on R2" — the smallest possible mark that a template is not a
       fresh idea. Muted, inline with the name, and it never blocks the add. */
    '.satpon{display:inline-block;margin-left:6px;padding:1px 6px;border-radius:999px;' +
      'background:var(--panel2);border:1px solid var(--line);color:var(--muted);' +
      'font-size:10.5px;font-weight:700;vertical-align:middle}' +
    /* THE PLAYSTATION WASH, GONE. This was rgba(88,166,255,…) — #58a6ff is
       --blue, and --blue MEANS PlayStation (DESIGN.md, "device families keep
       their meanings"). Spending a family colour on a generic "here is what
       it will do" panel is the one thing that palette forbids outright, and
       it drew that way on Xbox configs too. It is now the ion rule, which is
       also what zs-kit.css §15 reconciled it to — so whichever stylesheet
       wins the cascade, the two AGREE instead of fighting. */
    '.sapreview{background:none;border:0;border-left:2px solid var(--accent);' +
      'border-radius:0;padding:2px 0 2px 14px;margin-top:12px;font-size:13.5px;' +
      'line-height:1.65;color:var(--muted)}' +
    '.sapreview b{color:var(--text)}' +
    '.sapreview ol{margin:8px 0 0;padding-left:22px}' +
    '.sapreview ol li{margin:3px 0;color:var(--text)}' +
    '.sapreview .satail{color:var(--muted);font-size:12.5px;margin-top:9px}' +
    '.saerr{margin-top:10px}' +
    '.hmrow{display:flex;align-items:flex-start;gap:12px;padding:12px 14px;cursor:pointer;border-bottom:1px solid var(--line)}' +
    '.hmrow:last-child{border-bottom:none}' +
    '.hmrow .hmdot{width:20px;height:20px;border-radius:50%;border:2px solid var(--line);flex:none;margin-top:1px}' +
    '.hmrow.on .hmdot{border-color:var(--accent);box-shadow:inset 0 0 0 4px var(--accent)}' +
    '.hmrow .hmt{font-size:14px}' +
    '.hmrow .hmt em{display:block;color:var(--muted);font-size:12px;font-style:normal;margin-top:2px}' +
    '.seg2 button[aria-disabled="true"]{opacity:.4;pointer-events:none}' +
    /* nothing else in the app disables a .btn, so a blocked Save would look
       exactly like a live one without this */
    '.btn:disabled{opacity:.45;cursor:not-allowed;filter:none}' +
    '.sadial{width:190px;max-width:70%;height:auto;touch-action:none;cursor:pointer}' +
    '.sacols{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}' +
    '.sacol{width:30px;height:30px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0}' +
    '.sacol.on{border-color:var(--text)}' +
    /* ── the strip ──
       It WRAPS. XIM's scrolls, and a step that has scrolled out of sight might
       as well not exist to someone who cannot easily swipe. */
    /* 8px, not 6. The strip wraps rather than scrolls, so two tiles that a
       tremor could confuse are ADJACENT by construction — the one place the
       gap is load-bearing. 8px is this product's floor everywhere. */
    '.sastrip{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:9px}' +
    '.lrow.saitem{flex-wrap:wrap}' +
    /* ── THE TEXT COLUMN WAS COLLAPSING TO A THIRD OF THE ROW ────────────
       Measured 2026-08-28 on "Anti-recoil (aiming)" at a 400px phone: the
       card is 322px wide; .src got 111.6px and ran 266px TALL, wrapping the
       title over two lines and its sentence over eight, while .rt took 146px
       and was only 60px of it — so 146×206px of the card was empty air
       beside a crushed ribbon of text. .rt is a fixed cluster (the bind tile
       plus the on/off switch) and cannot shrink, and .src had no basis of its
       own, so the row split the space by content and the sentence lost.
       A 200px basis on the text makes the row's arithmetic explicit: dot +
       200 + cluster overflows a phone, so the CLUSTER wraps to the next line
       — where margin-left:auto parks it on the right, over the strip's own
       full-width line — and the sentence gets the whole width. On a tablet,
       where all three do fit, nothing wraps and the row is unchanged. */
    '.lrow.saitem>.src{flex:1 1 200px;min-width:0}' +
    '.lrow.saitem>.rt{flex:0 0 auto;margin-left:auto}' +
    /* indented to the sentence above it, not to the coloured dot */
    '.lrow.saitem>.sastrip{flex:1 1 100%;padding-left:20px;margin-top:7px}' +
    '.satile{position:relative;box-sizing:border-box;width:52px;height:52px;flex:none;padding:0;' +
      'display:flex;flex-direction:column;align-items:center;justify-content:space-between;' +
      /* A PRESSABLE thing is bounded at 3:1 (WCAG 1.4.11); --line is the
         decorative grouping edge and measures 1.46:1 against this face, so
         every control in this file wears --btn-2-edge and every non-pressable
         boundary keeps --line. background-COLOR, not the `background`
         shorthand: the shorthand silently erased zs-kit.css's key gradient on
         this exact selector, which is why the editor's tiles were flat while
         the rest of the app's were not. */
      'overflow:hidden;border:1px solid var(--btn-2-edge);border-radius:var(--r-ctl);' +
      'background-color:var(--btn-2-bg);color:var(--muted)}' +
    '.sastrip.mini .satile{width:44px;height:44px}' +
    '.satile .satart{flex:1;display:flex;align-items:center;justify-content:center;width:100%;min-height:0}' +
    /* the width here beats ZSART's own width attribute (a stylesheet rule
       always outranks a presentation attribute), so one drawing serves both
       sizes without being rebuilt */
    '.satile .satart svg{display:block;width:28px;height:28px}' +
    '.sastrip.mini .satile .satart svg{width:24px;height:24px}' +
    '.satile .satart b{font-size:13px;font-weight:800;color:var(--text)}' +
    '.sattext{font-size:10.5px;font-weight:800;color:var(--text);text-align:center;padding:0 2px;' +
      'overflow:hidden;line-height:1.15}' +
    '.satmark{color:var(--accent)}' +
    /* the value, burned in across the bottom — XIM's idiom exactly */
    /* the black is a SCRIM, not a palette hue — it darkens whatever face the
       tile is wearing so the burned-in value stays legible on every theme,
       and the palette has no token for a translucent scrim (nor should it) */
    '.satbadge{display:block;width:100%;box-sizing:border-box;padding:0 2px;font-size:9px;line-height:13px;' +
      'font-weight:700;text-align:center;color:var(--text);background:rgba(0,0,0,.36);' +
      'border-top:1px solid var(--line);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}' +
    '.sastrip.mini .satbadge{font-size:8.5px;line-height:12px}' +
    /* a combo is still one tile, so the other buttons in it get a corner count */
    '.satplus{position:absolute;top:2px;right:2px;font-style:normal;font-weight:800;font-size:8.5px;' +
      'line-height:12px;padding:0 3px;border-radius:var(--r-chip);background:var(--accent);' +
      'color:var(--accent-ink)}' +
    /* the step-kind arrow (press ↓ / let go ↑ / tap ↓↑) rides the OPPOSITE
       corner from .satplus so a combo hold can wear both. Same translucent
       scrim as the badge — it darkens whatever art the tile carries so the
       arrow stays legible on a lit face, and the scrim black is not a
       palette hue (the .satbadge rule above says why). */
    '.satarr{position:absolute;top:2px;left:2px;width:15px;height:15px;display:flex;' +
      'align-items:center;justify-content:center;border-radius:var(--r-chip);' +
      'background:rgba(0,0,0,.36);color:var(--text)}' +
    /* the base `.satile .satart svg` rule above sizes ALL descendant svg to
       28px (and the mini strip to 24px) — the arrow must win both, so both
       selectors are spelled out at higher specificity */
    '.satile .satart .satarr svg,.sastrip.mini .satile .satart .satarr svg{width:12px;height:12px}' +
    'button.satile{cursor:pointer}' +
    'button.satile:hover{border-color:var(--accent)}' +
    /* SELECTED was a PlayStation-blue halo (rgba(88,166,255,.35)) around an
       ion border — the family colour again, on every config including Xbox.
       Ion, and the border WIDTH changes with it so the state is never
       colour alone. Same two declarations zs-kit.css §15 already reached
       for, so the two stylesheets now agree rather than overwrite. */
    '.satile.sel{border-color:var(--accent);border-width:2px;box-shadow:inset 0 2px 0 var(--accent)}' +
    /* RUNNING keeps green (--green is "live" as well as Xbox, and the row
       says "step 2 of 4" in words beside it), and gains the same shape
       channel so the two states differ by more than hue. */
    '.satile.now{border-color:var(--green);border-width:2px;box-shadow:inset 0 2px 0 var(--green)}' +
    '.satile.more .satbadge{color:var(--muted)}' +
    '.satile.pass{border-style:dashed;border-color:var(--line);background-color:transparent}' +
    '.satile.pass .satbadge{font-size:14px;color:var(--text)}' +
    /* the number XIM has nowhere */
    '.satot{display:inline-flex;align-items:center;font-size:11.5px;font-weight:700;color:var(--muted);' +
      'white-space:nowrap;margin-left:2px}' +
    '.sastripbox{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-card);' +
      'padding:11px 13px 12px;margin-top:8px}' +
    '.sastripbox .sastrip{margin-top:0}' +
    /* ── the ready-made library ──
       Thirty-one cards is past the point where one flat grid is usable, so
       they are grouped by family and the chips narrow it down. Chips rather
       than a second row of tabs: the tab strip above already means "which
       screen", and two rows of the same control would read as the same thing. */
    '.safil{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 4px}' +
    '.safil button{border:1px solid var(--btn-2-edge);background-color:var(--btn-2-bg);color:var(--muted);' +
      'border-radius:999px;padding:8px 13px;font-size:12.5px;cursor:pointer;line-height:1.1}' +
    '.safil button b{font-weight:700;opacity:.65;margin-left:3px}' +
    /* #04121f was a near-miss for the ink that rides every bright fill in
       this app. There is exactly one, and it is --accent-ink (#04120f,
       10.87:1 on ion). Never #fff here — that measures 1.95:1.

       …AND THE FILL IS THE ROOM'S, NOT ION'S. Measured 2026-08-18 on the
       running app: the selected chip ("All 31") was the ONLY solid fill on a
       5409px screen, and it was ion — inside a room whose header wash, tab
       rail and back button are all bolt-orange. So the loudest painted thing
       on Smart Actions / Ready-made was a filter chip wearing another room's
       colour: a chip out-colouring its room. --tint resolves from
       #dbody[data-tint="smart"] (zs-kit.css §17) to the rose #f47fa4 here
       (bolt orange #ff9457 until D127) and to
       #a371f7 on the Buttons screen, and falls back to ion where this file
       is used outside a tinted subtree — so the chip can never again be a
       different colour from the screen it sits on.
         --accent-ink #04120f measures 7.66:1 on #f47fa4 and 5.70:1 on
         #a371f7, AA on both, AAA on the rose. */
    /* THE SELECTOR IS THE FIX, AND THE MEASUREMENT SAYS WHY.
       zs-kit.css §15 ships `body .safil button.on` — (0,2,1) — which repaints
       the selected chip var(--panel) with `inset 0 -3px 0 var(--accent)`. So
       "All 31" drew as a grey chip with an ION rail, inside a room whose
       header, tab and back button are bolt-orange: a chip out-colouring its
       room, and the loudest painted thing on a 5409px screen.

       A plain `.safil button.on` here is (0,2,0) and loses — and so does a
       `body`-prefixed one, because THIS STYLESHEET IS NOT LAST. Verified in
       the running browser: document.styleSheets is
       [inline, zs-brand, inline, zs-smart-css, zs-anim, zs-micro, zs-kit,
       zs-fixes] — the kit and the fixes are appended AFTER injectCSS() has
       already run, so an equal-specificity rule here loses the tie on order.
       That is the exact mechanism behind "five passes of adding colour
       changed nothing", and re-ordering the sheet is not the answer: zs-kit's
       base `.safil button` rule is what raises these chips to a legal 44px
       target, and winning globally would take that with it. So the two rules
       that must land are raised by ONE id / one class instead, and everything
       else this file ships keeps deferring to the kit.
       background-image:none is not decoration either: the base rule paints a
       control gradient, and a background-COLOR alone leaves it on top.
         --accent-ink #04120f measures 7.66:1 on #f47fa4, 5.70:1 on #a371f7. */
    '#dbody .safil button.on,.sheet .safil button.on{background-image:none;' +
      'background-color:var(--tint,var(--accent));color:var(--accent-ink);' +
      'border-color:var(--tint,var(--accent));font-weight:700;' +
      /* the kit's own lit-edge token, not a hand-mixed white: it also
         REPLACES zs-kit's `inset 0 -3px 0 var(--accent)`, which is the ion
         rail that was surviving underneath the fill */
      'box-shadow:var(--zs2-lit,var(--edge-lit))}' +
    '#dbody .safil button.on b,.sheet .safil button.on b{opacity:.75}' +
    '.safil button:active{filter:brightness(1.25)}' +
    'body.a11y-big .safil button{padding:11px 15px;font-size:14px}' +
    /* THE FAMILY HEADER IS A GROUP, NOT A CAPTION. Thirty-one cards in four
       runs read as one undifferentiated wall because the only thing between
       runs was a 13.5px bold word. It now carries the room's rail on its
       left edge (so the run is bounded) and the FAMILY's own colour on its
       icon chip (so the run is named twice — position and hue). Room outside,
       family inside: the room can never lose to one of its own groups. */
    '.safam{display:flex;align-items:baseline;gap:9px;margin:22px 0 9px;flex-wrap:wrap;' +
      'padding:7px 0 7px 11px;border-left:3px solid var(--tint,var(--accent))}' +
    /* raised for the same reason as the chip: zs-kit.css §15 ships
       `.sacat .saci, .safam .safi { color: var(--accent) }` and loads after
       this file, so the family icons were ion too. */
    '#dbody .safam .safi{display:flex;flex:none;align-self:center;width:26px;height:26px;' +
      'align-items:center;justify-content:center;border-radius:var(--r-chip);' +
      'color:var(--famc,var(--tint,var(--accent)));' +
      'background:var(--panel2);border:1px solid var(--line)}' +
    '.safam .safi svg{width:16px;height:16px}' +
    '.safam b{font-size:13.5px;font-weight:700}' +
    '.safam i{font-style:normal;color:var(--muted);font-size:12px;flex:1 1 100%;' +
      'padding-left:35px;line-height:1.4}' +
    /* the family colour on the card edge, so a filtered view and the full one
       read as the same set rather than two different screens */
    '.card.satpl{padding-left:11px}' +
    /* ── THE START-HERE HERO ──
       Rule: every screen gets one obvious first move, as a solid primary,
       above the fold. Ready-made had none — 5409px (7.5 screenfuls) of cards
       and not one solid fill anywhere in the scroll extent. The library is
       hand-ordered and the screen SAYS SO ("Movement & access comes first on
       purpose"), so the recommendation is not invented: it is the first
       template, in library order, that this config does not already have. */
    /* .grp-card carries NO padding of its own in this app — its children do
       (zs-kit `.grp-card > .stat, > .lrow`), so a card of bare spans sits
       flush against its own border. 15px + the 3px rail = the 18px the rows
       elsewhere land on. */
    /* #dbody again: .sahero IS a .grp-card, and zs-kit's `.grp-card, .acc
       { border: 1px solid var(--line) }` is (0,2,0) and loads later — the
       shorthand would put the rail back to the hairline. */
    '#dbody .sahero{border-left:3px solid var(--tint,var(--accent));margin-top:12px;' +
      'padding:14px 15px 15px}' +
    '.saherok{display:block;font-size:10.5px;font-weight:800;letter-spacing:var(--tr-label,.085em);' +
      'text-transform:uppercase;color:var(--tint,var(--accent));margin-bottom:5px}' +
    '.saheron{display:block;font-size:17px;font-weight:700;color:var(--text);line-height:1.25}' +
    '.saherod{display:block;color:var(--muted);font-size:12.5px;line-height:1.45;margin:5px 0 12px}' +
    '.sahero .btn{margin-top:0}' +
    /* Featured (2026-10-07): one slider, its value large, a plain hint */
    '.safeat{margin-top:12px}' +
    '.safeatfld .flab b{font-size:17px;color:var(--text);margin-left:6px}' +
    '.safeath{color:var(--muted);font-size:12.5px;margin-left:6px}' +
    '.safeatwho{color:var(--muted);font-size:12.5px;margin:4px 0 12px}' +
    /* ── "show the rest of this family" ──
       A run of nine cards below the fold is a run nobody reaches. Four are
       shown; the rest arrive on one tap, which is also the family filter, so
       the control teaches the chips above it. */
    '.samore{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;' +
      'min-height:44px;margin-top:10px;padding:0 14px;cursor:pointer;' +
      'border:1px solid var(--btn-2-edge);border-left:3px solid var(--tint,var(--accent));' +
      'border-radius:var(--r-ctl);background-color:var(--btn-2-bg);color:var(--btn-2-ink);' +
      'font-size:13px;font-weight:600;font-family:inherit;line-height:1.2}' +
    '.samore:active{filter:brightness(1.25)}' +
    '.samore b{color:var(--tint,var(--accent));font-weight:800}' +
    /* FOLDED, NOT DROPPED. display:none takes the card out of the layout AND
       out of the accessibility tree, so a folded card is inert for a screen
       reader exactly as it is for a thumb — while the gallery still BUILDS
       all 31, which is what makes "the library is complete" true rather than
       a claim (test-smart-actions.js counts .satpl). */
    '.card.satpl.safold{display:none}' +
    /* the worked example that filled "Build your own"'s foot went with the
       Build tab (D85): every Smart mappings row is a worked example now */
    /* ── the Buttons list ──
       An input row is IDENTITY (art → what it sends); the sequence lines
       under it are that input's JOBS. Indented, marked ▸▸, and each one a
       row in its own right. */
    '.lrow.inrow .glyimg{flex:none}' +
    '.lrow.inrow .arrow{color:var(--muted);flex:none;margin:0 2px}' +
    '.lrow.inrow .src{display:flex;align-items:center;gap:8px;flex-wrap:wrap}' +
    '.lrow.inrow .intn{font-size:13.5px}' +
    '.lrow.inrow .src em{flex:1 1 100%}' +
    '.lrow.seqline{padding-left:20px;border-left:2px solid var(--line);margin-left:14px}' +
    '.lrow.seqline.sabroken{border-left-color:var(--red)}' +
    '.sarep{display:inline-block;margin-left:6px;font-size:11px;color:var(--muted);font-weight:700}' +
    /* ── the input screen header ──
       XIM puts four pills around the input art and they are right about the
       placement: always visible, always one tap, never three accordions down
       a long screen. */
    '.sahead{display:flex;flex-direction:column;align-items:center;gap:8px;padding:12px 0 4px}' +
    '.sahart{position:relative;display:flex;align-items:center;justify-content:center}' +
    '.sahart svg{width:74px;height:74px}' +
    /* the key image doubles as "move this job to another key" (owner ask:
       the control lives ON the key, not at the bottom of the screen) */
    'button.sahart.saswap{background:none;border:0;padding:0;cursor:pointer;color:inherit}' +
    '.saswapchip{position:absolute;right:-16px;bottom:-2px;font-size:13px;' +
      'color:var(--muted);background:var(--panel2);border:1px solid var(--line);' +
      'border-radius:8px;padding:0 4px;line-height:1.35}' +
    '.sahcap{color:var(--muted);font-size:12.5px;text-align:center}' +
