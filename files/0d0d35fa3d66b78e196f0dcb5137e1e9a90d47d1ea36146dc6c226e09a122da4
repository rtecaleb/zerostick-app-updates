/* devbar — the always-on strip pinned to the bottom of every screen.
 *
 * Two rows:
 *   1. what's plugged in       (GET /devices, slow poll)
 *   2. what you're doing NOW   (GET /output/live + /input/live, fast poll)
 *
 * Everything here is REAL board data. When the board is offline the bar says
 * so rather than inventing activity — a fake "connected" chip on a dead link
 * is worse than no chip at all.
 *
 * Row 2 shows raw input events (so a keyboard 'W' reads as W, not as the stick
 * it maps to) plus the final stick/trigger state, so you can see both what you
 * pressed and what the console is being told.
 */
(function () {
  'use strict';
  if (!window.ZS) return;

  var DEVICE_POLL_MS = 2500;   // plug/unplug is rare
  var LIVE_POLL_MS   = 120;    // ~8 Hz: responsive without hammering the agent
  var NAV_POLL_MS    = 400;    // Passthrough Mode: must feel instant, but it is
                               // a mode change, not a per-frame value
  var KEY_HOLD_MS    = 700;    // how long a tap stays visible after release
  var MAX_CHIPS      = 10;

  var el = {};
  var devices = [];
  var famSubs = [];        /* every screen that wants to know the pad changed */
  var devSubs = [];        /* ...and every screen that cares WHAT is plugged in */
  /* Subscribe rather than assigning ZS.onPadFamilyChange, which only holds one. */
  ZS.onFamilyChange = function (cb) {
    if (typeof cb === 'function') famSubs.push(cb);
  };
  /* The device list itself, not just the pad family. Smart Actions needs it to
     answer "can this trigger ever fire?" — an action bound to a keyboard key
     on a rig with no keyboard is dead, and the app has to say so rather than
     let the board discover it silently. null until the first poll answers, so
     callers can tell "no keyboard" from "we have not asked yet". */
  ZS.devices = null;
  /* PRETEND A MOUSE AND KEYBOARD ARE PLUGGED IN (owner, 2026-10-13: "act
     like a mouse and keyboard are plugged into my Core on the PC so I can see
     the tabs and make changes to them"). A developer switch (Settings >
     Developer); off unless set. Only what the APP is shown changes: the
     Core's own list is untouched, and nothing is sent to the Core because of
     it, so settings edited here save to the real config as usual. */
  var SIM_MNK_KEY = 'zs-sim-mnk';
  function simMnkOn() {
    /* on by default in the owner's own builds (he asked for it), off in a
       customer build; the switch stores '1' or '0' */
    var v = null;
    try { v = localStorage.getItem(SIM_MNK_KEY); } catch (e) { v = null; }
    if (v === '1') return true;
    if (v === '0') return false;
    return !!(window.ZS_BUILD && window.ZS_BUILD.dev === true);
  }
  function pretendMnk(list) {
    if (!simMnkOn() || !Array.isArray(list)) return list;
    var out = list.slice();
    function has(kind) {
      return out.some(function (d) { return d && d.kind === kind && d.connected !== false; });
    }
    function add(kind, name) {
      out.push({ ident: 'sim:' + kind, name: name, path: '', vendorId: '0000', productId: '0000',
                 serial: '', phys: '', kind: kind, role: 'auto', connected: true, opened: true,
                 family: 'generic', quirk: '', emits: [], effectiveRole: kind, source: 'sim',
                 suppressed: false, suppressedReason: '', suppressedEvents: 0, pretend: true });
    }
    if (!has('keyboard')) add('keyboard', 'Keyboard (pretend)');
    if (!has('mouse')) add('mouse', 'Mouse (pretend)');
    return out;
  }
  ZS.simMnk = { key: SIM_MNK_KEY, on: simMnkOn };
  ZS.onDevicesChange = function (cb) {
    if (typeof cb === 'function') devSubs.push(cb);
  };
  /* WHAT THE CONSOLE IS BEING TOLD, PUBLISHED - because HOME draws the pad
     you are holding with the buttons lit, and it must not open a second poll
     loop to do it. This file already asks the agent every LIVE_POLL_MS; a
     second asker would double the traffic to produce the same answer, and
     the two would disagree for one interval every time. One poller, many
     readers, exactly as devSubs does for the device list. */
  ZS.liveInput = { buttons: [], sticks: { lx:0, ly:0, rx:0, ry:0, lt:0, rt:0 }, at: 0 };
  var liveSubs = [];
  ZS.onLiveInput = function (cb) {
    if (typeof cb === 'function') liveSubs.push(cb);
  };
  /* evdev number -> name, built once from zs-profile-encode.js's CODES.
     Aliases share a number (BTN_MOUSE and BTN_LEFT are both 0x110), so a
     name with a keycap picture wins, then the first in the kernel's order. */
  var codeNames = null;
  function codeName(n) {
    if (!codeNames) {
      codeNames = {};
      var C = (window.ZSPROFILE && ZSPROFILE.CODES) || {};
      Object.keys(C).forEach(function (k) {
        if (!/^(KEY|BTN)_/.test(k) || k === 'KEY_MIN_INTERESTING') return;
        var v = C[k], cur = codeNames[v];
        var pic = window.ZSKEYS && ZSKEYS.has(k);
        if (!cur || (pic && !(window.ZSKEYS && ZSKEYS.has(cur)))) codeNames[v] = k;
      });
    }
    return codeNames[n] || null;
  }
  function heldNames(list) {
    var out = [];
    if (!Array.isArray(list)) return out;
    for (var i = 0; i < list.length; i++) {
      var s = list[i];
      if (!s || +s.kind !== 0) continue;     /* 0 = an evdev code; triggers/regions are not keys */
      var nm = codeName(+s.code);
      if (nm && out.indexOf(nm) < 0) out.push(nm);
    }
    return out;
  }
  ZS.liveHeld = { codes: [], sig: '', at: 0 };
  function fireLive() {
    for (var i = 0; i < liveSubs.length; i++) {
      /* one bad subscriber must not stop the rest, and must never take the
         poll loop down with it - the device bar is the thing that says the
         board is alive. */
      try { liveSubs[i](ZS.liveInput); } catch (e) {}
    }
  }
  /* The family of the last pad ever seen, surviving reloads. With the board
     offline or the pad unplugged there is no plastic to follow; the pad the
     user OWNS is a better guess than a blanket default. glyphs.js consumes
     this as the step before its final Xbox fallback. */
  ZS.lastPadFamily = null;
  try { ZS.lastPadFamily = localStorage.getItem('zs-last-padfam') || null; }
  catch (e) { /* storage can be walled off in a webview; run without memory */ }
  /* Which classes of device are attached right now, or null while unknown.
     NOT-A-SINGLE-ONE counts as unknown, deliberately: an empty list means
     "still enumerating" as often as it means "nothing plugged in", and it is
     also what simulation looks like (the sim source reports kind "other"
     while delivering key events perfectly well). Painting every action red on
     a board that is still booting is a lie the user cannot act on. The board
     applies the identical rule in actions/sequences.set_attached_devices. */
  /* OPENED, NOT JUST CONNECTED (D217). The Core lists an interface it chose
     not to open (a keyboard's NKRO path, its built-in mouse beside a real
     one, one there was no USB channel left for) as a row of its own with
     "connected":true (the DEVICE is plugged in) and "opened":false. Such a
     row is not a thing anybody plugged in and it sends nothing, so it is
     never counted, drawn as a chip or a pill, or used to guess a pad's
     family; it is shown only as a quiet "not opened" note (notOpened). An
     older Core and the A7S leave the field out, which reads as opened. */
  function isOpened(d) {
    return !!d && d.connected !== false && d.opened !== false;
  }
  ZS.isOpened = isOpened;
  function notOpened(list) {
    var out = [];
    (list || []).forEach(function (d) {
      if (d && d.connected !== false && d.opened === false) out.push(d);
    });
    return out;
  }
  ZS.notOpened = notOpened;
  /* "0416:0123 interface 1 (mouse): not opened: a mouse is plugged in" ->
     "0416:0123 interface 1 (mouse): a mouse is plugged in", the Core's own
     words with the part the heading already says taken out */
  function notOpenedWords(d) {
    var s = String((d && (d.suppressedReason || d.ident || d.name)) || 'an interface');
    return s.replace(/:\s*not opened:\s*/, ': ');
  }
  ZS.notOpenedWords = notOpenedWords;

  ZS.deviceClasses = function () {
    if (!ZS.devices) return null;
    var out = {}, any = false;
    for (var i = 0; i < ZS.devices.length; i++) {
      var d = ZS.devices[i];
      if (!isOpened(d)) continue;
      var k = String(d.kind || '');
      if (k === 'gamepad') { out.controller = true; any = true; }
      else if (k === 'mouse' || k === 'keyboard') { out[k] = true; any = true; }
    }
    return any ? out : null;
  };
  /* Every source code the attached devices can actually emit, or null when the
     board did not enumerate them (an older agent). The board reports this per
     device as `emits`; see inputs/evdev_source.emitted_sources. */
  ZS.deviceEmits = function () {
    if (!ZS.devices) return null;
    var out = {}, any = false;
    for (var i = 0; i < ZS.devices.length; i++) {
      var d = ZS.devices[i];
      if (!isOpened(d) || !d.emits || !d.emits.length) continue;
      any = true;
      for (var j = 0; j < d.emits.length; j++) out[String(d.emits[j])] = true;
    }
    return any ? out : null;
  };
  var recent = [];             // [{label, kind, t}] newest last
  var sticks = { lx:0, ly:0, rx:0, ry:0, lt:0, rt:0 };
  var buttons = [];
  var timers = { dev:null, live:null };
  var started = false;

  function esc(s){ return ZS.esc ? ZS.esc(s) : String(s); }

  /* ── device chips ─────────────────────────────────────────────── */

  /* Map a device to the art we already ship. Prefer vendor id — a DualSense
     Edge and a standard DualSense have different product ids but both are
     Sony, and both should read as "PlayStation pad". */
  /* Third-party pads are the norm, not the exception, and almost none of them
     use Microsoft's or Sony's vendor id. A PowerA or PDP pad is an Xbox pad as
     far as your thumbs are concerned, so it has to show Xbox buttons. xpad
     names most of them "... X-Box 360 pad" / "Generic X-Box pad", which is a
     more reliable signal than the vendor id. */
  var XB_VIDS = { '045e':1,   /* Microsoft            */
                  '0e6f':1,   /* PDP                  */
                  '24c6':1,   /* PowerA / BDA         */
                  '0f0d':1,   /* Hori                 */
                  '1532':1,   /* Razer                */
                  '0079':1,   /* DragonRise            */
                  '2dc8':1,   /* 8BitDo (xinput mode) */
                  '1bad':1 }; /* Harmonix / Mad Catz  */
  var PS_VIDS = { '054c':1,   /* Sony                 */
                  '0f0d0':0 };
  var NIN_VIDS = { '057e':1 };  /* Nintendo            */

  function famOf(d) {
    /* The board already classified this device at driver/quirk-selection time
       (inputs/evdev_source.pad_family: vendor + xpad-name + driver evidence,
       which catches the PowerA/PDP/Hori pads the tables below miss). Its
       answer wins; the heuristics only cover an older agent or "generic". */
    var bf = String(d.family || '').toLowerCase();
    if (bf === 'playstation') return 'ps';
    if (bf === 'xbox') return 'xb';
    if (bf === 'nintendo') return 'nin';
    var vid = String(d.vendorId || '').toLowerCase();
    var name = String(d.name || '').toLowerCase();
    if (PS_VIDS[vid] || /dualsense|dualshock|playstation|wireless controller/.test(name))
      return 'ps';
    if (NIN_VIDS[vid] || /nintendo|switch pro|joy-con/.test(name)) return 'nin';
    if (XB_VIDS[vid] || /x-box|xbox|xinput/.test(name)) return 'xb';
    return null;
  }

  function deviceLook(d) {
    var vid = String(d.vendorId || '').toLowerCase();
    var kind = String(d.kind || '').toLowerCase();
    var name = String(d.name || '').toLowerCase();
    if (kind === 'keyboard') return { art:'mnk', tag:'KB',  cls:'kb' };
    if (kind === 'mouse')    return { art:'mnk', tag:'M',   cls:'ms' };
    if (vid === '2b81' || /p5general|activtor/.test(name))
      return { art:'ps5',  tag:'AUTH', cls:'auth' };
    var fam = famOf(d);
    if (fam === 'ps')  return { art:'ps5',  tag:'PS',  cls:'ps' };
    if (fam === 'xb')  return { art:'xbox', tag:'XB',  cls:'xb' };
    if (fam === 'nin') return { art:'controller', tag:'NIN', cls:'nin' };
    if (kind === 'gamepad')  return { art:'controller', tag:'PAD', cls:'pad' };
    return { art:'controller', tag:'?', cls:'other' };
  }

  /* D233: the device pictures (brand/devices/, from the owner's pictures) */
  var DEV_PIC = 'brand/devices/';
  function devicePic(d, look, fam) {
    if (look.cls === 'auth') return '';
    var kind = String(d.kind || '').toLowerCase();
    /* D290: the owner's own mouse and keyboard (the small file: every
       slot that asks here is under 128 CSS px) */
    if (kind === 'keyboard') return DEV_PIC + 'keyboard-256.webp';
    if (kind === 'mouse') return DEV_PIC + 'mouse-256.webp';
    if (fam === 'ps') return DEV_PIC + 'dev-ps5.png';
    /* owner, 2026-10-07: "an Xbox controller if it is anything that isn't
       Sony" - every other pad wears the Xbox picture */
    if (fam || kind === 'gamepad') return DEV_PIC + 'dev-xbox.png';
    return DEV_PIC + 'dev-unknown.png';
  }
  /* the picture for one device, for HOME's pills too (one rule, one place) */
  ZS.devicePicFor = function (d) { return d ? devicePic(d, deviceLook(d), famOf(d)) : ''; };
  /* D233: which picture heads Mappings, from what is plugged in. ONE pad and
     nothing else: its own (DualSense / Xbox One). A keyboard and/or mouse
     and no pad: the keyboard. Anything else - nothing known, a pad nobody
     can name, two of anything, a pad AND a keyboard - the Xbox 360 one, the
     owner's default. The auth donor and the test-only simulated input
     (kind "other") are not things you play with, so they do not count. */
  ZS.mappingsArt = function () {
    var list = (ZS.devices || []).filter(function (d) {
      return isUserDevice(d) && isOpened(d) && deviceLook(d).cls !== 'auth';
    });
    var pads = [], kbm = false, other = false;
    list.forEach(function (d) {
      var k = String(d.kind || '').toLowerCase();
      if (k === 'gamepad') pads.push(famOf(d));
      else if (k === 'keyboard' || k === 'mouse') kbm = true;
      else if (k && k !== 'other') other = true;
    });
    /* one physical pad can arrive as several nodes (touchpad, motion): the
       same family counted once per family */
    var fams = {}; pads.forEach(function (f) { fams[f || '?'] = true; });
    var famList = Object.keys(fams);
    /* 2026-10-23 (owner): "use that universal one if you detect a mouse and
       keyboard; if you don't, and you detect a PS5 controller, use the PS5
       one; a controller that isn't PS5, the Xbox 360 image". Nothing
       plugged in wears the universal one too (a key and a button swapping,
       brand/zs-mappings-door.jpg, in Mappings' green). */
    var UNI = 'brand/zs-mappings-door.jpg';
    if (kbm || !famList.length) return { key: 'universal', src: UNI };
    var allPs = famList.every(function (f) { return f === 'ps'; });
    var art = allPs ? 'ps5' : 'x360';
    return { key: art, src: DEV_PIC + 'map-' + art + '.jpg' };
  };

  function shortName(d) {
    var n = String(d.name || 'Device');
    /* kernel names are long and repetitive: "Sony Interactive Entertainment
       DualSense Wireless Controller" → "DualSense Wireless Controller" */
    n = n.replace(/^(Sony Interactive Entertainment|Microsoft|Activtor)\s+/i, '');
    /* …and the tail is boilerplate too. "DualSense Wireless Controller" is 29
       characters, so the 22-char clip printed "DualSense Wireless Co…" — the
       one word that identifies the pad survived, and then three words that
       identify nothing pushed it into an ellipsis. In a strip of chips that
       are ALREADY drawings of controllers, "Wireless Controller" is the part
       the picture is saying. Only dropped when a name is left standing. */
    var trimmed = n.replace(/\s+(Wireless\s+)?(Controller|Gamepad|Pad)$/i, '').trim();
    if (trimmed.length >= 3) n = trimmed;
    return n.length > 22 ? n.slice(0, 21) + '…' : n;
  }

  /* Which button family is physically plugged in, so the rest of the app can
     draw the glyphs of the pad you are ACTUALLY holding rather than the ones
     implied by the config's platform. null = nothing conclusive. */
  function detectFamily(list) {
    for (var i = 0; i < list.length; i++) {
      var d = list[i];
      if (String(d.kind || '') !== 'gamepad') continue;
      var fam = famOf(d);
      if (fam) return fam;
    }
    return null;
  }

  /* ── WHAT A PERSON PLUGGED IN, NOT WHAT LINUX ENUMERATED ────────────────
     /devices returns every evdev node the kernel offers, and on a Cubie A7S
     most of them are the BOARD ITSELF: sunxi-gpadc0/channel0..3 are the
     A733's own general-purpose ADC lines and axp8191-pek is the AXP PMIC's
     power button. The bar was showing six chips of which five were those, so
     a first-time user read "six things are plugged into my adapter" and the
     strip needed 1009px of horizontal scroll in a 317px row to say it.
     None of them can ever send a game input, so none of them is a device in
     the sense this bar means. Matched on the kernel path/name, which is what
     the board reports them as — a real pad never looks like this. */
  var SOC_NODE = /(^|[^a-z0-9])(sunxi-|axp\d*-pek|axp\d*-supply|sun\d+i-|rtc|thermal|vibrator|gpio-keys|hdmi|sndcodec|allwinner)/i;
  function isUserDevice(d) {
    if (!d) return false;
    var s = String(d.path || '') + ' ' + String(d.ident || '') + ' ' + String(d.name || '');
    return !SOC_NODE.test(s);
  }
  ZS.isUserDevice = isUserDevice;

  /* ── ONE CHIP PER THING YOU PLUGGED IN ─────────────────────────────────
     Reviewer, 2026-08-28. Filtering the SoC's own nodes out was right and
     stopped there, which left the opposite half of the same bug: the kernel
     splits ONE physical pad across several evdev nodes, so a single DualSense
     arrives as three devices —

       054c:0ce6:e8:47:…            "…DualSense Wireless Controller"
       054c:0ce6:e8:47:…#dbd6       "…DualSense Wireless Controller Motion Sensors"
       054c:0ce6:e8:47:…#db56       "…DualSense Wireless Controller Touchpad"

     and shortName() clips all three to the same 22 characters, so the bar
     read "DualSense Wireless Co…" THREE TIMES IDENTICALLY and the board sheet
     said "4 —" and then listed the same controller three times. A person with
     one pad plugged in was being told they had three.

     The board already says which nodes belong together: everything before the
     "#" in `ident` is vendor:product:serial, the physical unit. Group on that
     and keep the node that can actually send a game input — the gamepad node,
     else the one with the most inputs — because that is the one whose family,
     role and art the chip is drawing. The motion and touchpad nodes are the
     same object in your hands; there is nothing for a second chip to say.
     Falls back to the whole ident (then the name) when there is no "#", so a
     board that reports one node per device is unchanged. */
  function physicalKey(d) {
    var id = String(d.ident || '');
    if (id) return id.split('#')[0];
    return String(d.name || d.path || '');
  }
  function nodeRank(d) {
    if (String(d.kind || '') === 'gamepad') return 3;
    if (d.effectiveRole && d.effectiveRole !== 'aux') return 2;
    return (d.emits && d.emits.length) ? 1 : 0;
  }
  /* filter + collapse, in one place, so the bar and the sheet cannot drift */
  function userDevices(list) {
    var seen = {}, out = [], firstKind = {};
    (list || []).forEach(function (d) {
      if (!isOpened(d) || !isUserDevice(d)) return;
      /* D233 (owner, 2026-10-07: "it's detecting a keyboard when one isn't
         even in"): a gaming mouse's macro-key interface is a keyboard on the
         wire, opened when the bus has room. The Core lists a device's
         interfaces in claim order, so a keyboard row whose vendor:product
         FIRST appeared as a mouse is that mouse, not a keyboard. A combo
         receiver opens its keyboard first and keeps both. */
      var vp = String(d.vendorId || '') + ':' + String(d.productId || '');
      var kd = String(d.kind || '');
      if (vp !== ':' && vp !== '0000:0000') {
        if (!(vp in firstKind)) firstKind[vp] = kd;
        else if (firstKind[vp] === 'mouse' && kd === 'keyboard') return;
      }
      var k = physicalKey(d);
      if (!(k in seen)) { seen[k] = out.length; out.push(d); return; }
      var i = seen[k];
      if (nodeRank(d) > nodeRank(out[i])) out[i] = d;   /* keep the real one */
    });
    return out;
  }
  ZS.userDevices = userDevices;

  function renderDevices() {
    if (!el.devs) return;
    if (ZS.live && ZS.live.online === false) {
      el.devs.innerHTML = '<span class="dvb-empty">no device info while offline</span>';
      return;
    }
    var list = userDevices(devices);
    /* D217: what the Core did not open, said quietly after the chips and
       never drawn as one */
    var skipped = notOpened(devices);
    var skipNote = skipped.length
      ? '<span class="dvb-idle" title="' + esc(skipped.map(notOpenedWords).join('; ')) + '">' +
        skipped.length + ' not opened</span>'
      : '';
    if (!list.length) {
      el.devs.innerHTML = '<span class="dvb-empty dvb-none">no device plugged into the adapter</span>' + skipNote;
      return;
    }
    el.devs.innerHTML = list.slice(0, MAX_CHIPS).map(function (d) {
      var look = deviceLook(d);
      /* A real drawing of the pad in your hand beats a generic outline: you can
         tell at a glance which of two controllers a chip is talking about.
         Falls back to the old flat art if controller-art.js is not loaded. */
      var fam = famOf(d);
      /* D233 (owner, 2026-10-07): the chip is a PICTURE of the thing - the
         DualSense, the Xbox pad, the keyboard, the mouse - and a question
         mark for anything it cannot name. The auth donor keeps its badge. */
      var pic = devicePic(d, look, fam);
      var art = pic
        ? '<img class="dvb-pic" src="' + pic + '" alt="" aria-hidden="true">'
        : (window.ZSMARK ? ZSMARK.badge(look.art, { size: 26, decorative: true }) : '');
      var role = d.role && d.role !== 'auto' ? d.role : look.cls === 'auth' ? 'auth donor' : '';
      return '<span class="dvb-chip ' + look.cls + '" title="' + esc(d.name || '') +
             (d.path ? ' — ' + esc(d.path) : '') + '">' +
             '<span class="dvb-art">' + art + '</span>' +
             '<span class="dvb-meta"><b>' + esc(shortName(d)) + '</b>' +
             (role ? '<i>' + esc(role) + '</i>' : '') + '</span></span>';
    }).join('') + skipNote;
  }

  /* ── live activity ────────────────────────────────────────────── */

  /* Raw evdev codes → something a person recognises. Anything unmapped falls
     through as its own text, which is what makes arbitrary keyboard keys work. */
  function prettyCode(code) {
    var c = String(code || '');
    var m = /^KEY_(.+)$/.exec(c);
    if (m) {
      var k = m[1];
      var NICE = { SPACE:'Space', LEFTSHIFT:'Shift', RIGHTSHIFT:'Shift', LEFTCTRL:'Ctrl',
        RIGHTCTRL:'Ctrl', LEFTALT:'Alt', RIGHTALT:'Alt', ENTER:'Enter', ESC:'Esc',
        TAB:'Tab', BACKSPACE:'Bksp', CAPSLOCK:'Caps', UP:'↑', DOWN:'↓', LEFT:'←', RIGHT:'→' };
      return NICE[k] || (k.length === 1 ? k : k.charAt(0) + k.slice(1).toLowerCase());
    }
    m = /^BTN_(.+)$/.exec(c);
    if (m) {
      /* pad buttons wear the connected pad's family, same as every picker;
         ZSG hands mouse buttons back as M1-M3 and unknowns as themselves */
      if (window.ZSG) {
        var s = window.ZSG.short(c);
        if (s !== c) return s;
      }
      var B = { SOUTH:'✕', EAST:'○', NORTH:'△', WEST:'□', A:'A', B:'B', X:'X', Y:'Y',
        TL:'L1', TR:'R1', TL2:'L2', TR2:'R2', THUMBL:'L3', THUMBR:'R3',
        SELECT:'Select', START:'Start', MODE:'Home',
        LEFT:'M1', RIGHT:'M2', MIDDLE:'M3' };
      return B[m[1]] || m[1];
    }
    return c.replace(/^ABS_|^REL_/, '');
