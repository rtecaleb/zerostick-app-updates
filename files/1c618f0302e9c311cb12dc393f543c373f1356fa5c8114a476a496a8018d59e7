  grid-template-columns: 1fr auto 1fr;
  grid-template-rows: auto 1fr auto;
  grid-template-areas: ". top ." "left center right" ". bottom .";
  justify-items: center;
  align-items: center;
  width: 100%;
  margin: 0 auto;
  max-width: fit-content;
}

