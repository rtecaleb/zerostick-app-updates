    if (!errors.outerDz && !errors.innerDz && inner !== null && outer !== null && outer <= inner) {
      errors.outerDz = 'The outer dead zone has to be bigger than the inner one.';
      n++;
    }
    return { ok: n === 0, count: n, errors: errors };
  }

  /* ── describing a value of OURS, for the preview ───────────────────── */
  function speedOf(cm) { return rnd(500 / cm, 1); }   /* the Aim page's Speed (phone-sections.js) */
  function pct(v, dp) { return trimNum(v * 100, dp === undefined ? 0 : dp) + '%'; }
