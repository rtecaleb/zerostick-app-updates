     Aim page's Custom smoothing shows them since D191 (XIM's own example is
     67.5 / 55.0 / 42.5). Stability stays 0-100, unconfirmed against XIM's
     app. */
  var R = {
    cm360:     { min: 5,   max: 200, step: 1,    dp: 2, unit: 'cm/360',
