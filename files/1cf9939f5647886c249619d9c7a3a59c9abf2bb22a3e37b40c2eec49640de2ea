  }
  /* The ADS fields that say "Aim down sight has something of its own"
     besides its speed: the smoothing (D191's seven), the curve and the
     quantization (D189). All null = XIM's Inherit All / Sensitivity Only. */
  var ADS_SMOOTH_KEYS = ['adsSmoothing', 'adsOneEuroBeta', 'adsSmoothingEasing',
    'adsSmoothingStyle', 'adsClassicSmooth', 'adsClassicDecay', 'adsClassicSynch'];
  var ADS_OWN_KEYS = ADS_SMOOTH_KEYS.concat(['adsCurve', 'adsQuantMagnitude', 'adsQuantAngle']);

  /* XIM APEX's smoothing IS Classic (XIM's guide: Classic's "values match
     XIM APEX behavior"); MATRIX and NEXUS start on Standard. */
  function setDevice(form, id) {
    var ok = false, i;
    for (i = 0; i < DEVICES.length; i++) { if (DEVICES[i].id === id) { ok = true; } }
    if (!ok) { return form; }
    form.device = id;
    var mode = id === 'apex' ? 'classic' : 'standard';
    form.hip.smoothing = mode;
    form.ads.smoothing = mode;
    return form;
  }

  /* ── validation ────────────────────────────────────────────────────── */
  /* The fields a form shows, as [errorKey, value, rangeKey]. A field the
     form hides (ADS under Inherit All, Classic's three under Standard) is
     not checked: it is not shown and will not be copied. */
  function visible(form) {
    var out = [];
    function stance(s, name, own) {
      if (own.sens) { out.push([name + '.cm360', s.cm360, 'cm360']); }
      if (!own.smooth) { return; }
      if (s.smoothing === 'classic') {
        out.push([name + '.smooth', s.smooth, 'smooth'], [name + '.decay', s.decay, 'decay'],
                 [name + '.synch', s.synch, 'synch']);
      } else {
        out.push([name + '.precision', s.precision, 'precision'], [name + '.response', s.response, 'response'],
                 [name + '.easing', s.easing, 'easing'], [name + '.stability', s.stability, 'stability']);
      }
      if (s.quant && s.quant.on) {
        out.push([name + '.quant.magnitude', s.quant.magnitude, 'quantMag'], [name + '.quant.angle', s.quant.angle, 'quantAngle']);
      }
    }
    stance(form.hip, 'hip', { sens: true, smooth: true });
    stance(form.ads, 'ads', { sens: form.inherit !== 'all', smooth: form.inherit === 'none' });
    out.push(['yScale', form.yScale, 'yScale'], ['innerDz', form.innerDz, 'innerDz'],
             ['outerDz', form.outerDz, 'outerDz'], ['axialDz', form.axialDz, 'axialDz']);
    return out;
  }
  function validate(form) {
    var errors = {}, n = 0;
    visible(form).forEach(function (f) {
      var key = f[0], r = R[f[2]], v;
      if (f[2] === 'yScale') {
        var y = readYScale(f[1]);
