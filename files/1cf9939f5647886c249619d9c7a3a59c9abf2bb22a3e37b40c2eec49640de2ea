     defaults; smClassicFromValues in phone-sections.js reads them the same) */
  var CLASSIC_CORE = { smooth: 0, decay: 9, synch: 0 };

  var DEVICES = [
    { id: 'matrix', name: 'XIM MATRIX' },
    { id: 'apex', name: 'XIM APEX' },
    { id: 'nexus', name: 'XIM NEXUS' }
  ];
  /* XIM's own three choices, in XIM's own words (guide, "Aim Settings
     Inheritance"): Inherit All is XIM's default */
  var INHERIT = [
    { id: 'all', name: 'Inherit All', line: 'Aim down sight uses everything from Hip.' },
    { id: 'sens', name: 'Sensitivity Only', line: 'Aim down sight has its own sensitivity. Everything else comes from Hip.' },
    { id: 'none', name: 'Inherit Nothing', line: 'Aim down sight has its own sensitivity, smoothing and curve.' }
  ];
  var LABELS = { same: 'Same', close: 'Close', none: 'Not available' };
  /* said when a code is pasted but this build has no reader (ZSXIMCODE) */
  var SHARE_CODE_MESSAGE = 'That looks like an XIM share code, but this app can’t read share codes. ' +
    'Please type the numbers from your XIM app into this screen instead. Nothing from the code was kept.';
  var APPROX = 'Feel is approximate for this game.';

  /* ── small helpers ─────────────────────────────────────────────────── */
  function isNum(v) { return typeof v === 'number' && isFinite(v); }
  function isObj(v) { return !!v && typeof v === 'object' && Object.prototype.toString.call(v) !== '[object Array]'; }
  function isArr(v) { return Object.prototype.toString.call(v) === '[object Array]'; }
  function rnd(v, dp) { var f = Math.pow(10, dp); return Math.round(v * f) / f; }
  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
  function clone(v) { return v === undefined ? undefined : JSON.parse(JSON.stringify(v)); }
  function curveLib() { return root.ZSCURVE || null; }
  function trimNum(v, dp) {
    var s = String(rnd(v, dp === undefined ? 2 : dp));
    return s;
  }

  /* A typed number: "34", "34.5", "34,5" (a decimal comma), with spaces.
     Returns the number, or null when it is not one. */
  function parseNum(v) {
    if (isNum(v)) { return v; }
    if (typeof v !== 'string') { return null; }
    var s = v.replace(/\s+/g, '').replace(/%$/, '');
    if (/^-?\d+,\d+$/.test(s)) { s = s.replace(',', '.'); }
    if (!/^-?(\d+\.?\d*|\.\d+)$/.test(s)) { return null; }
    var n = parseFloat(s);
    return isFinite(n) ? n : null;
  }
  /* Y Scale may be typed as a multiplier (1.00) or, if someone reads it as a
     percent, as 100. Over 10 is read as a percent and said so; between 5 and
     10 is neither and is refused. */
  function readYScale(v) {
    var n = parseNum(v);
    if (n === null) { return { value: null }; }
    if (n > 10 && n <= 500) { return { value: rnd(n / 100, 4), percent: true }; }
    return { value: n };
  }

  function rangeError(key) {
    var r = R[key];
    return 'Type a number from ' + trimNum(r.min) + ' to ' + trimNum(r.max) + '.' + (r.why ? ' ' + r.why : '');
  }

  /* Classic's MEAN LAG in ms: the closed form of docs/SMOOTHING.md, the same
     one the Aim page shows under Classic (phone-sections.js classicLagMs) and
     the Core computes (zs_classic_mean_lag_s). */
  function classicLagMs(sm, dc, sy) {
    var t = 2 * clamp(+sm || 0, 0, 100);
    var d = clamp(isNum(dc) ? dc : 9, 0, 20);
    var y = clamp(+sy || 0, 0, 64);
    var lag = d < 1e-3 ? t / 2 : t * (1 / d - Math.exp(-d) / (1 - Math.exp(-d)));
    return lag + y / 2;
  }

  /* ── the form ──────────────────────────────────────────────────────── */
  /* A config with no Speed starts on 35 cm/360: what an untouched XIM MATRIX
     config holds (7 of the 38 readable public codes carry it with XIM's
     untouched smoothing, docs/XIM-PUBLIC-CONFIGS.md). */
  var FRESH_CM360 = 35;
  function stanceDefaults() {
    return { cm360: FRESH_CM360, smoothing: 'standard', precision: 0, response: 10, easing: 30, stability: 0,
             smooth: CLASSIC_SEED.smooth, decay: CLASSIC_SEED.decay, synch: CLASSIC_SEED.synch,
             curve: 'linear', grid: null, curveFromConfig: false,
             quant: { on: false, magnitude: 25, angle: 25 } };
  }
  function said(v) { return v !== undefined && v !== null; }
  /* a stored quantization pair (0..1 each) as the form's { on, magnitude, angle } */
  function quantOf(mag, ang) {
    var m = isNum(mag) ? mag : 0, a = isNum(ang) ? ang : 0;
    if (m <= 0 && a <= 0) { return { on: false, magnitude: 25, angle: 25 }; }
    return { on: true, magnitude: rnd(clamp(m * 100, 0, 100), 1), angle: rnd(clamp(a * 100, 0, 100), 1) };
  }

  /* This config's curve as the form shows it: 'linear', or a drawn grid. */
  function curveOf(kind, strength, points, grid) {
    var C = curveLib();
    if (kind === 'linear' || !C) { return { curve: 'linear', grid: null }; }
    var g = (kind === 'piecewise' && C.gridOf(grid)) || C.fromCurve(kind, strength, points);
    if (C.presetOf(g) === 'linear') { return { curve: 'linear', grid: null }; }
    return { curve: 'custom', grid: g };
  }

  /* THE PREFILL. Every field that has an exact way back from this config
     starts on this config's own number, so a field the player leaves alone
     changes nothing. Where there is no way back, XIM's own published
     starting values: Inherit All, Synch 8, Quantization off at 25 / 25.
     Sensitivity with none set here starts on 35 cm/360, the number an
     untouched XIM MATRIX config carries (FRESH_CM360). */
  function defaults(mt) {
    mt = isObj(mt) ? mt : {};
    var hip = stanceDefaults(), ads = stanceDefaults();
    if (isNum(mt.cm360) && mt.cm360 > 0) { hip.cm360 = rnd(clamp(mt.cm360, R.cm360.min, R.cm360.max), 2); }
    ads.cm360 = (isNum(mt.adsCm360) && mt.adsCm360 > 0) ? rnd(clamp(mt.adsCm360, R.cm360.min, R.cm360.max), 2) : hip.cm360;
    /* D191's scale: Precision % = smoothing / 0.95 */
    if (isNum(mt.smoothing)) { hip.precision = rnd(clamp(mt.smoothing / PRECISION_UNIT, 0, 100), 1); }
    if (isNum(mt.oneEuroBeta)) { hip.response = rnd(clamp(mt.oneEuroBeta * 10, 0, 100), 1); }
    if (isNum(mt.smoothingEasing)) { hip.easing = rnd(clamp(mt.smoothingEasing * 100, 0, 100), 1); }
    if (isNum(mt.steadyAim)) { hip.stability = rnd(clamp(mt.steadyAim * 1000, 0, 100), 1); }
    ads.precision = said(mt.adsSmoothing) ? rnd(clamp(mt.adsSmoothing / PRECISION_UNIT, 0, 100), 1) : hip.precision;
    ads.response = said(mt.adsOneEuroBeta) ? rnd(clamp(mt.adsOneEuroBeta * 10, 0, 100), 1) : hip.response;
    ads.easing = said(mt.adsSmoothingEasing) ? rnd(clamp(mt.adsSmoothingEasing * 100, 0, 100), 1) : hip.easing;
    ads.stability = hip.stability;
    /* D191: the style each stance runs (ADS's own, else hip's, as the Core
       resolves it) and Classic's three numbers, else the Aim page's seed */
    hip.smoothing = mt.smoothingStyle === 'classic' ? 'classic' : 'standard';
    ads.smoothing = said(mt.adsSmoothingStyle) ? (mt.adsSmoothingStyle === 'classic' ? 'classic' : 'standard') : hip.smoothing;
    /* A stance that RUNS Classic reads a missing number as the Core's
       default (Smooth 0, Decay 9, Synch 0), because that is what it runs; a
       Standard stance shows the seed, ready for a switch to Classic. */
    ['Smooth', 'Decay', 'Synch'].forEach(function (n) {
      var k = n.toLowerCase(), r = R[k];
      var hipNow = isNum(mt['classic' + n]) ? mt['classic' + n] : null;
      if (hipNow !== null) { hip[k] = rnd(clamp(hipNow, r.min, r.max), r.dp); }
      else if (hip.smoothing === 'classic') { hip[k] = CLASSIC_CORE[k]; }
      var adsNow = isNum(mt['adsClassic' + n]) ? mt['adsClassic' + n] : hipNow;
      if (adsNow !== null) { ads[k] = rnd(clamp(adsNow, r.min, r.max), r.dp); }
      else { ads[k] = ads.smoothing === 'classic' ? CLASSIC_CORE[k] : CLASSIC_SEED[k]; }
    });
    /* D392: frame sync lives in Sync to game now; with no Classic Synch of
       its own, a stance reads Sync to game's back as XIM's ms (120 = 8,
       60 = 16), so a form left alone writes nothing */
    if (isNum(mt.syncHz) && mt.syncHz > 0) {
      var syMs = mt.syncHz >= 100 ? 8 : 16;
      if (!(isNum(mt.classicSynch) && mt.classicSynch > 0)) { hip.synch = syMs; }
      if (!(isNum(mt.adsClassicSynch) && mt.adsClassicSynch > 0) &&
          !(isNum(mt.classicSynch) && mt.classicSynch > 0)) { ads.synch = syMs; }
    }
    /* D189: Quantization, per stance; an ADS pair that is null is hip's */
    hip.quant = quantOf(mt.quantMagnitude, mt.quantAngle);
    ads.quant = (said(mt.adsQuantMagnitude) || said(mt.adsQuantAngle))
      ? quantOf(said(mt.adsQuantMagnitude) ? mt.adsQuantMagnitude : mt.quantMagnitude,
                said(mt.adsQuantAngle) ? mt.adsQuantAngle : mt.quantAngle)
      : clone(hip.quant);
    var hc = curveOf(mt.curve || 'linear', mt.curveStrength, mt.curvePoints, mt.curveGrid);
    hip.curve = hc.curve; hip.grid = hc.grid; hip.curveFromConfig = true;
    if (said(mt.adsCurve)) {
      var ac = curveOf(mt.adsCurve, said(mt.adsCurveStrength) ? mt.adsCurveStrength : 1, mt.adsCurvePoints, null);
      ads.curve = ac.curve; ads.grid = ac.grid; ads.curveFromConfig = true;
    } else {
      /* ADS rides hip's curve (null). Untouched, it stays that way: the
         curve row says "kept as it is" and writes nothing */
      ads.curve = hip.curve; ads.grid = hip.grid ? clone(hip.grid) : null; ads.curveFromConfig = true;
    }
    var ownSmooth = ADS_OWN_KEYS.some(function (k) { return said(mt[k]); });
    var inherit = ownSmooth ? 'none' : ((isNum(mt.adsCm360) && mt.adsCm360 > 0) ? 'sens' : 'all');
    var inner = isNum(mt.innerDeadzone) ? rnd(clamp(mt.innerDeadzone * 100, 0, 90), 1) : 0;
    return {
      device: 'matrix',
      inherit: inherit,
      hip: hip,
      ads: ads,
      yScale: isNum(mt.yxRatio) ? rnd(clamp(mt.yxRatio, R.yScale.min, R.yScale.max), 2) : 1,
      innerDz: inner,
      outerDz: isNum(mt.outerDeadzone) ? rnd(clamp(mt.outerDeadzone * 100, 10, 100), 1) : 100,
      /* there is no axial SIZE here, only the shape; an axial config reads
         back as its inner size along the axes */
      axialDz: mt.deadzoneMode === 'axial' ? inner : 0
