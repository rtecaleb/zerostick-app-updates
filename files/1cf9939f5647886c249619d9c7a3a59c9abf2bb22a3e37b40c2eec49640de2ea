    var key = path.replace(/^mouseTranslation\./, '');
    if (v === undefined) { return 'not set yet'; }
    if (v === null) { return 'same as hip'; }
    switch (key) {
      case 'cm360':
      case 'adsCm360':
        if (!isNum(v) || v <= 0) { return key === 'adsCm360' ? 'same as hip' : 'standard speed'; }
        return 'Speed ' + speedOf(v) + ' (' + trimNum(v, 2) + ' cm per full turn)';
      case 'yxRatio': return pct(v);
      case 'smoothing': case 'adsSmoothing': return 'Precision ' + trimNum(v / PRECISION_UNIT, 1) + '%';
      case 'smoothingStyle': case 'adsSmoothingStyle':
        return v === 'classic' ? 'Classic smoothing' : 'Standard smoothing';
      case 'classicSmooth': case 'adsClassicSmooth': return 'Smooth ' + trimNum(v, 1);
      case 'classicDecay': case 'adsClassicDecay': return 'Decay ' + trimNum(v, 1);
      case 'classicSynch': case 'adsClassicSynch': return 'Synch ' + trimNum(v, 0) + ' ms';
      case 'syncHz': return isNum(v) && v > 0 ? 'Sync to game ' + trimNum(v, 0) : 'Sync to game Off';
      case 'quantMagnitude': case 'adsQuantMagnitude': return 'Magnitude ' + pct(v, 1);
      case 'quantAngle': case 'adsQuantAngle': return 'Angle ' + pct(v, 1);
      case 'oneEuroBeta': case 'adsOneEuroBeta': return 'Response ' + trimNum(v * 10, 1) + '%';
      case 'smoothingEasing': case 'adsSmoothingEasing': return 'Easing ' + pct(v);
      case 'smoothingMode': return v === 'ema' ? 'the old steady filter' : 'the steadying filter (1€)';
      case 'steadyAim': return v > 0 ? 'Steady Aim ' + pct(v, 1) + ' of full speed' : 'Steady Aim off';
      case 'innerDeadzone': return pct(v, 1);
      case 'outerDeadzone': return pct(v, 1);
      case 'deadzoneMode': return v === 'axial' ? 'along the axes' : 'round';
      case 'curve': case 'adsCurve':
        return v === 'linear' ? 'straight' : v === 'piecewise' ? 'your own curve' : v;
      default: return isNum(v) ? trimNum(v, 3) : String(v);
    }
  }

  function same(a, b) {
    if (isNum(a) && isNum(b)) { return Math.abs(a - b) <= 1e-6; }
    /* null and absent both mean "inherit hip" (schema v6) / "not set" */
    if (a === undefined || a === null || b === undefined || b === null) {
      return (a === undefined || a === null) && (b === undefined || b === null);
    }
    return JSON.stringify(a) === JSON.stringify(b);
  }
  function getPath(doc, path) {
    var parts = path.split('.'), o = doc, i;
    for (i = 0; i < parts.length; i++) {
      if (!isObj(o) || !Object.prototype.hasOwnProperty.call(o, parts[i])) { return undefined; }
      o = o[parts[i]];
    }
    return o;
  }

  /* ── THE MAPPING (assessment section 2.4) ──────────────────────────── */
  /* A config runs a MEASURED game translator: one Calibrate (or a pack's
     measured model) wrote, so a cm/360 here turns the game the distance it
     says. Anything else is the standard map or a model from published
     settings, and the feel is approximate. */
  function isMeasured(mt) {
    var r = isObj(mt) ? mt.resolvedAimModel : null;
    return !!(isObj(r) && r.generic !== true && r.needsCalibration === false && isObj(r.hip));
  }

  var MT = 'mouseTranslation.';
  /* AIM-section floats whose absent value is 0 on the wire AND whose 0 is
     their own default ("off" / "inherit"): cm360, adsCm360, steadyAim,
     smoothing, innerDeadzone; and D189's quantization pair (absent = off) */
  var ZERO_WHEN_ABSENT = { cm360: 1, adsCm360: 1, steadyAim: 1, smoothing: 1, innerDeadzone: 1,
                           quantMagnitude: 1, quantAngle: 1 };
  /* D191: a hip style never named is Standard (the filter every config ran
     before), so naming it 'standard' would be a change for nothing */
  var DEFAULT_WHEN_ABSENT = { smoothingStyle: 'standard',
    /* and Classic's three, as the Core runs them when they are not stored */
    classicSmooth: CLASSIC_CORE.smooth, classicDecay: CLASSIC_CORE.decay, classicSynch: CLASSIC_CORE.synch };
  function W(field, value) { return { path: MT + field, value: value }; }

  function curveWrites(s, ads, mt) {
    var C = curveLib();
    /* the editor hands back its STORED shape: seven numbers, or since D189
       { v: 2, h: [[x, y]...], s: [...] } once a handle was added, removed,
       moved across or a segment straightened. gridOf() takes both. */
    var g = (C && s.grid) ? C.gridOf(s.grid) : null;
    var straight = s.curve !== 'custom' || !C || !g || C.presetOf(g) === 'linear';
    if (ads) {
      return straight
        ? [W('adsCurve', 'linear'), W('adsCurveStrength', 1), W('adsCurvePoints', [])]
        : [W('adsCurve', 'piecewise'), W('adsCurveStrength', 1), W('adsCurvePoints', C.sample(g))];
    }
    /* the hip curve is written exactly as the Translation tab's Speed curve
       writes it: piecewise + the sampled points + the editor's own stored
       shape in curveGrid, or linear with both removed */
    if (!straight) {
      return [W('curve', 'piecewise'), W('curvePoints', C.sample(g)), W('curveGrid', g)];
    }
    /* straight: a linear curve ignores its points, so they are only
       cleared when there are some (an empty list and none are the same
       curve, and rewriting one as the other would be a change for nothing) */
    var out = [W('curve', 'linear')];
    if (isArr(mt.curvePoints) && mt.curvePoints.length) { out.push(W('curvePoints', undefined)); }
    if (mt.curveGrid !== undefined) { out.push(W('curveGrid', undefined)); }
    return out;
  }
  /* how many handles a drawn curve has, ends included (for the row's words) */
  function handleCount(grid) {
    var C = curveLib(), m = (C && grid && C.handlesOf) ? C.handlesOf(C.gridOf(grid)) : null;
    return m ? m.h.length : 0;
  }

  function preview(form, ctx) {
    ctx = ctx || {};
    var v = validate(form);
    if (!v.ok) { return { ok: false, errors: v.errors, count: v.count }; }
    var mt = isObj(ctx.mt) ? ctx.mt : {};
    var cur = { mouseTranslation: mt };
    /* What this adapter can run. The Core runs everything; an EXO (the A7S
       agent) lacks D191's Classic filter and D189's quantization
       (PRODUCTS.exo.lacks), and is told so instead of being written to. */
    function hides(name) { return typeof ctx.hides === 'function' ? !!ctx.hides(name) : false; }
    var classicOK = !hides('classicSmoothing');
    var quantOK = !hides('aimXim');
    /* what a field holds now. An absent number the encoders send as 0
       (zs-profile-encode.js writeAim) IS 0, so writing 0 there is no change */
    function nowOf(path) {
      var key = path.replace(/^mouseTranslation\./, '');
      var v = getPath(cur, path);
      if (v === undefined && ZERO_WHEN_ABSENT[key]) { return 0; }
      if (v === undefined && DEFAULT_WHEN_ABSENT[key] !== undefined) { return DEFAULT_WHEN_ABSENT[key]; }
      return v;
    }
    /* An ADS field whose null means "hip's" (D189 / D191): when the config
       has none of its own and the value IS what hip is being given, it is
       left absent rather than written as a copy of hip's. */
    function adsW(field, value, hipValue) {
      var had = getPath(cur, MT + field);
      if ((had === undefined || had === null) && same(value, hipValue)) { return W(field, undefined); }
      return W(field, value);
    }
    var measured = isMeasured(mt);
    var rows = [];
    var num = parseNum;
    var feelLabel = measured ? 'same' : 'close';
    var feelNote = measured ? '' : ' ' + APPROX;

    /* One XIM field. `writes` are what it becomes here; a write that would
       leave the config as it is is dropped, so Apply sends exactly the
       changes this row shows, and a row with none says "no change".
       `ours` / `nowText` override the words drawn from the first write. */
    function row(group, xim, given, label, note, writes, ours, nowText) {
      writes = writes || [];
      var head = writes[0];
      var changes = writes.filter(function (w) { return !same(nowOf(w.path), w.value); });
      var r = {
        group: group, xim: xim, given: given, label: label, labelText: LABELS[label],
        note: note || '', writes: changes, changed: changes.length > 0,
        ours: ours || (head ? describe(head.path, head.value) : ''),
        now: nowText || (head ? describe(head.path, nowOf(head.path)) : '')
      };
      rows.push(r);
      return r;
    }

    /* Sensitivity */
    var hipCm = rnd(num(form.hip.cm360), 2);
    row('Hip Aim', 'Sensitivity', trimNum(hipCm, 2) + ' cm/360', feelLabel,
      'Same unit: centimetres of mouse travel for one full turn. Shown here as Speed.' + feelNote,
      [W('cm360', hipCm)]);

    /* the smoothing of one stance (D191: Standard | Classic) */
    var hipStyle = (form.hip.smoothing === 'classic' && classicOK) ? 'classic' : 'standard';
    /* hip's Classic number after Apply: the form's when hip is Classic (it
       is written), else what hip holds now */
    /* Standard's three: XIM's % to our field (D191), keeping the stored
       value when it already reads as the typed number */
    var STD = { smoothing: [PRECISION_UNIT, 5], oneEuroBeta: [0.1, 4], smoothingEasing: [0.01, 4] };
    function stdOf(field, typed, stored) {
      if (isNum(stored) && Math.abs(stored / STD[field][0] - typed) < 0.05) { return stored; }
      return rnd(typed * STD[field][0], STD[field][1]);
    }
    /* hip's Standard number after Apply: the form's when hip is Standard
       (it is written), else what hip holds now */
    function hipStd(field) {
      var typed = { smoothing: form.hip.precision, oneEuroBeta: form.hip.response, smoothingEasing: form.hip.easing }[field];
      if (hipStyle === 'standard') { return stdOf(field, num(typed), nowOf(MT + field)); }
      return nowOf(MT + field);
    }
    function hipClassic(n) {
      if (hipStyle === 'classic') {
        var v = num(form.hip[n.toLowerCase()]);
        return n === 'Synch' ? Math.round(v) : rnd(v, 2);
      }
      return nowOf(MT + 'classic' + n);
    }
    /* D392: XIM's Synch (ms) as Sync to game's choices: 0 is Off, up to
       12 ms is 120 a second (XIM's Default 8), longer is 60 (its 16 and 32;
       the Translation page offers no slower one) */
    function syncHzOf(ms) { return !(ms > 0) ? 0 : (ms <= 12 ? 120 : 60); }
    function nowSyncHz() { var v = nowOf(MT + 'syncHz'); return isNum(v) && v > 0 ? v : 0; }
    function smoothingRows(s, ads) {
      var g = ads ? 'Aim Down Sight' : 'Hip Aim';
      var pre = ads ? 'ads' : '';
      function f(name) { return pre ? pre + name.charAt(0).toUpperCase() + name.slice(1) : name; }
      if (s.smoothing === 'classic' && !classicOK) {
        ['Smooth', 'Decay', 'Synch'].forEach(function (n) {
          row(g, 'Classic smoothing: ' + n, trimNum(num(s[n.toLowerCase()]), 2), 'none',
            'This adapter has no Classic smoothing (the ZeroStick Core has it). ' +
            (ads ? 'Aim down sight smoothing' : 'Your smoothing') + ' here stays as it is.', [], 'nothing copied');
        });
        return;
      }
      var style = s.smoothing === 'classic' ? 'classic' : 'standard';
      /* One of Standard's three, typed as XIM's 0-100%. The form shows one
         decimal, so a number that still READS as what is stored (15.8 for a
         stored 0.15) keeps the stored value: a field left alone changes
         nothing. An ADS number left absent follows hip's (the Core overlays
         ADS on hip), so it is only written when it differs from hip's. */
      function sw(field, typed) {
        var path = ads ? f(field) : field;
        var stored = nowOf(MT + path);
        if (ads && !isNum(stored)) { stored = hipStd(field); }   /* what ADS runs now: hip's */
        var v = stdOf(field, typed, stored);
        if (!ads) { return W(field, v); }
        return adsW(path, v, hipStd(field));
      }
      var styleW = ads ? adsW('adsSmoothingStyle', style, hipStyle) : W('smoothingStyle', style);
      /* the style this stance runs now: ADS's own, else hip's (as the Core resolves it) */
      var nowStyle = describe(MT + 'smoothingStyle', (ads && said(mt.adsSmoothingStyle)) ? mt.adsSmoothingStyle : nowOf(MT + 'smoothingStyle'));
      if (style === 'classic') {
        var sm = num(s.smooth), dc = num(s.decay), sy = num(s.synch);
        var lag = rnd(classicLagMs(sm, dc, sy), 1);
        row(g, 'Smoothing: Classic', 'Classic', 'close',
          'Our Classic smoothing (D191): a static weighted average and then a frame sync, the structure XIM describes for APEX. ' +
          'XIM has not published its formula, so it is close, not the same.',
          [styleW], 'Classic smoothing, adds about ' + trimNum(lag, 1) + ' ms of delay', nowStyle);
        /* an ADS number left absent follows hip's (the Core overlays ADS
           on hip), so it is only written when it differs from hip's */
        function cw(n, value) {
          return ads ? adsW('adsClassic' + n, value, hipClassic(n)) : W('classic' + n, value);
        }
        row(g, 'Classic smoothing: Smooth', trimNum(sm, 1), 'close',
          'The size of the window. Our scale is 2 ms of window a point, which XIM has not published: ' +
          'start from your APEX number and adjust by feel.',
          [cw('Smooth', rnd(sm, 2))], 'Smooth ' + trimNum(sm, 1));
        row(g, 'Classic smoothing: Decay', trimNum(dc, 1), 'close',
          'XIM’s meaning: higher, and older movement counts less. XIM APEX’s 9.0 is 9.0 here.',
          [cw('Decay', rnd(dc, 2))], 'Decay ' + trimNum(dc, 1));
        /* D392: frame sync is ONE setting here, for both stances: Sync to
           game (mouseTranslation.syncHz, Off / 60 / 120 a second). Hip's
           Synch becomes it, and a Classic Synch the config still holds is
           turned off so the two never stack. ADS cannot have its own. */
        var hz = syncHzOf(sy);
        if (!ads) {
          var oldSy = nowOf(MT + 'classicSynch');
          /* the number the form opened on (an older config's own Synch, or
             Sync to game's read back): left alone, nothing is written */
          var opened = (isNum(oldSy) && oldSy > 0) ? Math.round(oldSy)
            : (nowSyncHz() ? (nowSyncHz() >= 100 ? 8 : 16) : null);
          var untouched = opened !== null && Math.round(sy) === opened;
          row(g, 'Classic smoothing: Synch', trimNum(sy, 0) + ' ms', 'close',
            'Here frame sync is one setting for both stances, Sync to game on the Translation page. ' +
            'XIM’s 8 / 16 / 32 / 0 become 120 / 60 / 60 / Off.',
            untouched ? [] : [W('syncHz', hz)].concat(isNum(oldSy) && oldSy !== 0 ? [W('classicSynch', 0)] : []),
            hz ? 'Sync to game ' + hz : 'Sync to game Off',
            untouched ? (hz ? 'Sync to game ' + hz : 'Sync to game Off') : undefined);
        } else {
          var hipHz = hipStyle === 'classic' ? syncHzOf(num(form.hip.synch)) : nowSyncHz();
          if (hz === hipHz) {
            row(g, 'Classic smoothing: Synch', trimNum(sy, 0) + ' ms', 'same',
              'Frame sync is one setting for both stances here (Sync to game), and this is the same as Hip’s.',
              [], hz ? 'Sync to game ' + hz : 'Sync to game Off', hz ? 'Sync to game ' + hz : 'Sync to game Off');
          } else {
            row(g, 'Classic smoothing: Synch', trimNum(sy, 0) + ' ms', 'none',
              'Frame sync is one setting for both stances here (Sync to game), so Aim down sight uses Hip’s.',
              [], 'nothing copied');
          }
        }
        return;
      }
      row(g, 'Smoothing: Standard', 'Standard', 'close',
        'Our steadying filter, with XIM’s names and XIM’s 0 to 100% (D191). The same idea, not the same maths.',
        (ads ? [styleW] : [styleW, W('smoothingMode', 'oneEuro')]), 'Standard smoothing', nowStyle);
      var p = num(s.precision);
      row(g, 'Precision', trimNum(p, 1) + '%', 'close',
        'Steadies slow aim. The same 0 to 100% as our Custom smoothing; the filter underneath is ours.',
        [sw('smoothing', p)], 'Precision ' + trimNum(p, 1) + '%');
      row(g, 'Response', trimNum(num(s.response), 1) + '%', 'close',
        'Lets fast moves cut through the steadying. The same idea, not the same maths.',
        [sw('oneEuroBeta', num(s.response))], 'Response ' + trimNum(num(s.response), 1) + '%');
      row(g, 'Easing', trimNum(num(s.easing), 1) + '%', 'close',
        'How gently aim starts from rest. The same idea, not the same maths.',
        [sw('smoothingEasing', num(s.easing))], 'Easing ' + trimNum(num(s.easing), 1) + '%');
      if (!ads) {
        var st = num(s.stability);
        /* Steady Aim: one field for both stances, 0..0.5 of full speed in
           the schema. XIM's Stability is for motion (gyro) aim only, and the
           maths differ, so the scale is deliberately gentle: 100 = 10% of
           full speed. A guess, said in docs/XIM-IMPORT.md. */
        row(g, 'Stability', trimNum(st, 1), 'close',
          'Similar idea, different maths. XIM uses Stability for motion aim. Here it ignores very slow hand movement, ' +
          'so above 0 the smallest moves do nothing.',
          [W('steadyAim', rnd(Math.min(st, 100) / 1000, 4))]);
      } else {
        row(g, 'Stability', trimNum(num(s.stability), 1), 'none',
          'Steady Aim is one setting for both stances here, so Hip Aim’s is used.', [], 'uses Hip Aim’s');
      }
    }

    function curveRow(s, ads) {
      var g = ads ? 'Aim Down Sight' : 'Hip Aim';
      var drawn = s.curve === 'custom';
      if (s.curveFromConfig) {
        row(g, 'Aim curve', s.curve === 'custom' ? 'custom' : 'linear', 'close',
          'You did not change the curve, so this config’s curve stays as it is.', [], 'kept as it is');
        return;
      }
      var w = curveWrites(s, ads, mt);
      var label = (!drawn && measured) ? 'same' : 'close';
      var n = drawn ? handleCount(s.grid) : 0;
      row(g, 'Aim curve', drawn ? 'custom' + (n ? ', ' + n + ' handles' : '') : 'linear', label,
        (drawn
          ? 'Our curve editor is XIM’s kind (D189): the handles copy across where you put them, 0 to 100% in and out. ' +
            'Between the handles our line is drawn its own smooth way, so the shape is close, not exact. '
          : 'XIM’s straight curve is our straight curve. ') +
        'It only feels the same once this game is measured.' + (measured ? '' : ' ' + APPROX), w);
    }

    /* Quantization (D189): Magnitude and Angle per stance, 0..100% in XIM
       and 0..1 here; off is 0 and 0. Our "Ignore tiny movement" control
       (noiseThreshold, once labelled "Quantization") is a noise gate and is
       NEVER written from XIM's. */
    function quantRow(s, ads) {
      var g = ads ? 'Aim Down Sight' : 'Hip Aim';
      var q = s.quant || { on: false, magnitude: 25, angle: 25 };
      var given = q.on ? 'on (Magnitude ' + trimNum(num(q.magnitude), 1) + ', Angle ' + trimNum(num(q.angle), 1) + ')' : 'off';
      if (!quantOK) {
        row(g, 'Quantization', given, 'none',
          'This adapter has no Quantization (the ZeroStick Core has it). “Ignore tiny movement” is something else, so it is not changed.',
          [], 'nothing copied');
        return;
      }
      var m = q.on ? rnd(num(q.magnitude) / 100, 4) : 0, a = q.on ? rnd(num(q.angle) / 100, 4) : 0;
      var hq = form.hip.quant || {};
      var hm = hq.on ? rnd(num(hq.magnitude) / 100, 4) : 0, ha = hq.on ? rnd(num(hq.angle) / 100, 4) : 0;
      var ws = ads ? [adsW('adsQuantMagnitude', m, hm), adsW('adsQuantAngle', a, ha)]
                   : [W('quantMagnitude', m), W('quantAngle', a)];
      function words(mm, aa) { return (mm > 0 || aa > 0) ? 'Magnitude ' + pct(mm, 1) + ', Angle ' + pct(aa, 1) : 'off'; }
      var nm = ads ? (said(mt.adsQuantMagnitude) ? mt.adsQuantMagnitude : nowOf(MT + 'quantMagnitude')) : nowOf(MT + 'quantMagnitude');
      var na = ads ? (said(mt.adsQuantAngle) ? mt.adsQuantAngle : nowOf(MT + 'quantAngle')) : nowOf(MT + 'quantAngle');
      row(g, 'Quantization', given, 'close',
        'Our Quantization (D189): Magnitude snaps aim speed to steps, Angle snaps direction to even angles, the same two ' +
        'controls with XIM’s 0 to 100%. XIM has not published its maths, so it is close, not the same. ' +
        '“Ignore tiny movement” is a different control and is not changed.',
        ws, words(m, a), words(+nm || 0, +na || 0));
    }

    smoothingRows(form.hip, false);
    curveRow(form.hip, false);
    quantRow(form.hip, false);

    /* Aim down sight: XIM's inheritance, mapped onto ours exactly */
    var inh = form.inherit;
    var inhName = '';
    INHERIT.forEach(function (x) { if (x.id === inh) { inhName = x.name; } });
    /* everything ADS can have of its own besides its speed, back to hip's */
    function inheritWrites() {
      return ADS_SMOOTH_KEYS.concat(['adsCurve', 'adsCurveStrength', 'adsCurvePoints', 'adsQuantMagnitude', 'adsQuantAngle'])
        .map(function (k) { return W(k, null); });
    }
    if (inh === 'all') {
      row('Aim Down Sight', 'Settings inheritance', inhName, 'same',
        'Aim down sight follows Hip Aim’s sensitivity, smoothing, curve and quantization.',
        [W('adsCm360', 0)].concat(inheritWrites()),
        'same as hip, for everything');
    } else {
      var adsCm = rnd(num(form.ads.cm360), 2);
      /* adsCm360 0 is "hip's speed": a config that follows hip and an ADS
         speed typed equal to hip's stay that way */
      var adsCmW = (nowOf(MT + 'adsCm360') === 0 && adsCm === hipCm) ? W('adsCm360', 0) : W('adsCm360', adsCm);
      row('Aim Down Sight', 'Sensitivity', trimNum(adsCm, 2) + ' cm/360', feelLabel,
        'Same unit: centimetres of mouse travel for one full turn.' + feelNote, [adsCmW],
        describe(MT + 'adsCm360', adsCm));
      if (inh === 'sens') {
        row('Aim Down Sight', 'Settings inheritance', inhName, 'same',
          'Smoothing, curve and quantization follow Hip Aim’s.',
          inheritWrites(),
          'smoothing, curve and quantization same as hip');
      } else {
        smoothingRows(form.ads, true);
        curveRow(form.ads, true);
        quantRow(form.ads, true);
      }
    }

    /* Both stances */
    var y = readYScale(form.yScale);
    row('Both', 'Y Scale', trimNum(y.value, 2) + (y.percent ? ' (read as ' + trimNum(num(form.yScale), 1) + '%)' : ''), 'same',
      'Up-and-down speed compared with left-and-right, the same meaning as XIM’s.',
      [W('yxRatio', rnd(y.value, 4))]);
    /* D392: the dead zones are NOT copied. Here they would act on the stick
       AFTER the game's own curve is inverted, so every one of them only
       breaks cm/360 (an inner zone of 5 % made a slow move 82 % short; an
       outer zone of 50 % doubled the speed: docs/MOUSE-AUDIT.md). The game's
       own dead zone is already handled by the game translator. A config
       that has them keeps them; this screen just stops writing them. */
    var inner = num(form.innerDz), outer = num(form.outerDz), axial = num(form.axialDz);
    var DZ_NOTE = 'Not copied. Here the game’s own dead zone is already handled for you, and a ' +
      'dead zone added on top only makes slow moves short and breaks Speed (cm/360).';
    row('Both', 'Inner dead zone', trimNum(inner, 1) + '%', 'none', DZ_NOTE, [], 'nothing copied');
    row('Both', 'Outer dead zone', trimNum(outer, 1) + '%', 'none', DZ_NOTE, [], 'nothing copied');
    row('Both', 'Axial dead zone', trimNum(axial, 1) + '%', 'none', DZ_NOTE, [], 'nothing copied');

    var writes = [];
    rows.forEach(function (r) { r.writes.forEach(function (w) { writes.push(w); }); });
    var changed = rows.filter(function (r) { return r.changed; }).length;
    return { ok: true, rows: rows, writes: writes, changed: changed, measured: measured,
             approx: !measured, approxText: APPROX };
  }

  /* ── applying, and undoing ─────────────────────────────────────────── */
  /* Make `writes` on `doc` (a whole config document). A value of undefined
     removes the key. Returns what each path held before, for undo(). */
  function applyWrites(doc, writes) {
    var undoList = [];
    (writes || []).forEach(function (w) {
      var parts = w.path.split('.'), o = doc, i;
      for (i = 0; i < parts.length - 1; i++) {
        if (!isObj(o[parts[i]])) { o[parts[i]] = {}; }
        o = o[parts[i]];
      }
      var k = parts[parts.length - 1];
      var had = Object.prototype.hasOwnProperty.call(o, k);
      undoList.push({ path: w.path, had: had, value: had ? clone(o[k]) : undefined });
      if (w.value === undefined) { delete o[k]; } else { o[k] = clone(w.value); }
    });
    return undoList;
  }
  function undo(doc, list) {
    var i;
    for (i = (list || []).length - 1; i >= 0; i--) {
      var u = list[i], parts = u.path.split('.'), o = doc, j, gone = false;
      for (j = 0; j < parts.length - 1; j++) {
        if (!isObj(o[parts[j]])) { if (!u.had) { gone = true; break; } o[parts[j]] = {}; }
        o = o[parts[j]];
      }
      if (gone) { continue; }
      var k = parts[parts.length - 1];
      if (u.had) { o[k] = clone(u.value); } else { delete o[k]; }
    }
    return doc;
  }

  /* ── share codes ───────────────────────────────────────────────────── */
  /* XIM MATRIX's Copy button wraps a config in public markers (XIM's guide,
     "Identity"): ">>> XIM MATRIX [Game] START COPY >>>", then "XMC:" + a
     string + ":XMC", then "<<< XIM MATRIX END COPY <<<". This only asks
     whether a marker is present; reading the code is fromShareCode()'s. */
  function looksLikeShareCode(text) {
    if (typeof text !== 'string' || !text) { return false; }
    return /(^|[^A-Za-z0-9])XMC:/.test(text) || /:XMC([^A-Za-z0-9]|$)/.test(text) ||
      /(>>>|<<<)\s*XIM\s+MATRIX/i.test(text);
  }

  /* A pasted share code INTO THE FORM (docs/XIM-SHARE-CODE.md). The code is
     read by xim-share-code.js (ZSXIMCODE.read: the few mouse-aim fields the
     public samples confirm) and its numbers are put into the same form the
     player types into, on top of this config's own numbers. Nothing is
     applied: the screen shows the form, then the preview with its labels,
     and the player taps Apply.

     NEVER GUESSED: a number this app cannot hold is left as the config has
     it and listed in `notCopied` with why; what the code does not carry (or
     we do not read) is listed in `notRead`. The text itself is not kept.

     Returns { ok: true, form, report: { name, gameId, game, check,
     inheritFrom, filled: [words], notCopied: [{ what, given, why }],
     notRead: [words] } } or { ok: false, kind, message }. */
  var LINEAR_EPS = 0.002;
  function codeCurve(pts) {
    /* the code's handles as the editor's v2 shape, or the reason it cannot be */
    var C = curveLib();
    if (!pts) { return { why: 'the curve in the code could not be read' }; }
