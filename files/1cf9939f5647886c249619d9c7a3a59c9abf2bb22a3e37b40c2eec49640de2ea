    yScale:    { min: 0.1, max: 5,   step: 0.05, dp: 2, unit: '',
                 why: '1.00 means up and down match left and right.' },
    precision: { min: 0, max: 100, step: 0.5, dp: 1, unit: '%' },
    response:  { min: 0, max: 100, step: 0.5, dp: 1, unit: '%' },
    easing:    { min: 0, max: 100, step: 0.5, dp: 1, unit: '%' },
    stability: { min: 0, max: 100, step: 5, dp: 1, unit: '' },
    /* XIM stores Smooth and Synch as whole numbers and Decay in tenths
       (docs/XIM-SHARE-CODE.md); public configs use Smooth 0-50, Decay 0-9.0
       and Synch 0-50 (docs/XIM-PUBLIC-CONFIGS.md), so the steps are 1 / 0.5
       / 1 and every value seen is reachable with the keys */
    smooth:    { min: 0, max: 100, step: 1, dp: 1, unit: '' },
    decay:     { min: 0, max: 20,  step: 0.5, dp: 1, unit: '',
                 why: 'XIM APEX uses 9.0.' },
    synch:     { min: 0, max: 64,  step: 1, dp: 0, unit: 'ms',
                 why: 'XIM: 8 = default, 16 = common, 32 = slow, 0 = off.' },
    innerDz:   { min: 0, max: 90,  step: 1, dp: 1, unit: '%' },
    outerDz:   { min: 10, max: 100, step: 1, dp: 1, unit: '%' },
    axialDz:   { min: 0, max: 90,  step: 1, dp: 1, unit: '%' },
    quantMag:  { min: 0, max: 100, step: 5, dp: 1, unit: '%' },
    quantAngle:{ min: 0, max: 100, step: 5, dp: 1, unit: '%' }
  };
