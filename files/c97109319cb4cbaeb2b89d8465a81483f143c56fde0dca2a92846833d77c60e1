/* sections/05-game-identity.js — a config's GAME: born from a game pack (D115).
 *
 * Which pack a config came from (packOfConfig, isScratchConfig, normGame), the
 * game picker grid shared by the wizard and Overview's one-time adopt
 * (gamePickerHtml, wireGamePicker, openGameAdopt), a pack's turn at a new
 * config's document (packPrepare, packTranslate: D164 translator + DPI), and
 * devRoleIco. Reads game-packs.js (ZSPACKS). Profile: game, gamePack.
 *
 * Also offers on ZS:          ZS.normGame, ZS.packTranslate, ZS.packPrepare,
 *                             ZS.gameSoon, ZS.gameComingSoon, ZS.configComingSoon,
 *                             ZS.configLocked, ZS.configGate, ZS.configSoonBadge (D300)
 * Tests:                      test-game-packs.js, test-game-lock.js, test-wizard-search.js, test-games-soon.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('game-identity', function (SEC) {
  /* from the files before this one */
  var esc = SEC.esc, ico = SEC.ico, note = SEC.note, ZS = SEC.ZS;
  /* from files after this one, bound once every file has run (never used
     while this file is loading) */
  var findKeyOf, packFindParts;
  ZS_SECTIONS.after(function () {
    findKeyOf = SEC.findKeyOf;
    packFindParts = SEC.packFindParts;
  });

  /* ── little images: shared helpers ─────────────────────────────────
     devRoleIco — P6's one map, used by the Pairing screen AND Overview's
     plugged-in-devices card so the two can never disagree. Pure function of
     the role string alone (no ids, no timestamps): both surfaces repaint on
     polls through byte-compare caches, and identical state must produce
     identical HTML. An unrecognised role gets NO icon — a wrong picture is
     worse than no picture. */
  function devRoleIco(role){
    var r = String(role || '').toLowerCase();
    var name = (r === 'pad' || r === 'gamepad' || r === 'controller') ? 'pad'
             : r === 'keyboard' ? 'keycap'
             : r === 'mouse' ? 'mouse' : '';
    if(!name) return '';
    return '<span class="gly-deco" aria-hidden="true" style="width:18px;height:18px;'+
      'color:var(--muted);margin-right:7px">'+ico(name, 18)+'</span>';
  }

  /* ── the config's GAME identity: born from a game pack (D115) ──────
     The owner, 2026-09-22: every config is made from a GAME PACK (a
     ready-made config for one game, its Smart Actions and its aim settings
     tuned for it) or from "Start from scratch" when the game is not on the
     list, and once chosen the pack is fixed for the life of that config.

     The list is CURATED: the packs in game-packs/ (window.ZSPACKS) and one
     scratch door, nothing else. The free-text "Something else…" and the
     games borrowed from installed vision packs were retired with this,
     because a game typed in by hand has no pack behind it, which is the one
     thing a config is now born from.

     The config's `game` is the pack's name and stays one bounded string the
     BOARDS latch (the A7S since schema v9, the Core's store since D115);
     `gamePack` records {id, version} and is the app's provenance, which is
     how a scratch config ({id:'scratch'}) is told from one made before game
     packs (no gamePack at all): only the second is offered the one-time
     "Choose a game". Matching names below is normalised and COSMETIC ONLY. */
  function normGame(s){
    return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
  }
  ZS.normGame = normGame;

  /* COMING SOON (D300, owner 2026-10-14): Call of Duty: Black Ops II is the
     one game a config can be MADE for; every other pack is listed, with its
     art, greyed and badged "Coming soon", and cannot be chosen. A config
     that already has another game is badged and shut too (configGate below,
     D300 amended), but it still plays on the device.
     The lock opens only in a DEVELOPER BUILD with DEVELOPER MODE on (the
     Debug box's 2200, localStorage 'zs-dev-mode'). A release build never
     opens it, whatever the storage says. */
  /* owner 2026-10-21: Warzone is done (gun detection + Recoil Lab) */
  var GAMES_OPEN = { 'cod-bo2': true, 'cod-warzone': true };
  var OPEN_WORDS = 'Black Ops II and Warzone are';
  function gamesUnlocked(){
    return !!(ZS.devBuild && ZS.devBuild()) && !!(ZS.devMode && ZS.devMode());
  }
  function gameSoon(id){ return !GAMES_OPEN[id] && !gamesUnlocked(); }
  ZS.gameSoon = gameSoon;
  /* D300 amended (owner, 2026-10-14: "I don't see the Coming soon"): the
     BADGE is not the lock. Every unfinished game wears "Coming soon" in
     every build and every mode; developer mode only decides whether it can
     be picked (gameSoon above). */
  function gameComingSoon(id){ return !GAMES_OPEN[id]; }
  ZS.gameComingSoon = gameComingSoon;
  /* D394 (owner, 2026-10-15): THREE STATUSES, the picker's three sections,
     from the pack's own `status` (game-packs.js statusOf: a measured
     translator, and the AI scripts):
       ready       "Ready to use"                           (Black Ops II)
       calibrated  "Calibration done · AI scripts waiting"
       notStarted  "Not started"
     The LOCK is still D300's one list, GAMES_OPEN, and nothing else: a game
     that is not in it is greyed, bannered and (outside developer mode in a
     developer build) never picked, whatever its status says. */
  var STATUS_WORDS = { ready: 'Ready to use', calibrated: 'Calibration done · AI scripts waiting',
                       notStarted: 'Not started' };
  /* the banner across a greyed tile's art: short, the section header says the rest */
  var STATUS_BANNER = { calibrated: 'AI scripts waiting', notStarted: 'Not started', ready: 'Ready to use' };
  function gameStatus(id){
    if(GAMES_OPEN[id]) return 'ready';
    var pk = packGet(id);
    var st = pk ? (pk.status || (window.ZSPACKS && ZSPACKS.statusOf ? ZSPACKS.statusOf(pk) : 'notStarted'))
                : 'notStarted';
    /* only GAMES_OPEN is ready to a player: a pack that says ready but is
       not open yet reads as calibrated */
    return st === 'ready' ? 'calibrated' : (STATUS_WORDS[st] ? st : 'notStarted');
  }
  ZS.gameStatus = gameStatus;
  ZS.gameStatusWords = function(id){ return STATUS_WORDS[gameStatus(id)]; };
  ZS.gamesUnlocked = gamesUnlocked;

  /* A CONFIG FOR AN UNFINISHED GAME (D300 amended). The same one list,
     GAMES_OPEN: a config whose game is not Black Ops II wears the badge
     wherever a config is drawn, and without developer mode a tap neither
     opens its editor nor makes it active (configGate). Nothing is changed
     on the config and nothing is sent to the Core: one already playing
     there keeps playing. A config with NO game (scratch, or made before
     game packs, or `default`) is not for an unfinished game, so it is never
     locked. The game is the pack id the config records; failing that its
     game name through the pack list, and while that list has not loaded a
     name-only config stays open (the list repaints when it lands). */
  function configGameId(p){
    if(!p) return '';
    var pid = (typeof p.pack === 'string' && p.pack) ? p.pack
            : (p.gamePack && typeof p.gamePack.id === 'string') ? p.gamePack.id : '';
    if(pid) return pid === 'scratch' ? '' : pid;
    var g = String(p.game || '');
    if(!normGame(g)) return '';
    var pk = window.ZSPACKS ? ZSPACKS.forGame(g) : null;
    if(pk) return pk.id;
    return packsState() === 'ready' ? '?'+normGame(g) : '';
  }
  function configComingSoon(p){
    var id = configGameId(p);
    return !!id && gameComingSoon(id);
  }
  function configLocked(p){ return configComingSoon(p) && !gamesUnlocked(); }
  /* the one badge, the picker's own look (flat: an outline, no fill). D394:
     it says the game's status words, not "Coming soon" */
  function soonBadge(extraStyle, words){
    return '<span class="gsoon-b" style="display:inline-block;padding:1px 7px;'+
      'border:1px solid var(--line);border-radius:999px;font-size:11px;font-weight:600;'+
      'line-height:16px;white-space:nowrap;color:var(--muted)'+(extraStyle ? ';'+extraStyle : '')+
      '">'+esc(words || STATUS_WORDS.notStarted)+'</span>';
  }
  /* "dev": said beside the badge while developer mode has it open */
  function devNote(){
    return '<span class="gsoon-dev" style="margin-left:6px;font-size:11px;'+
      'color:var(--muted)">dev</span>';
  }
  /* true = the tap was refused (and said so); the caller does nothing else */
  function configGate(p){
    if(!configLocked(p)) return false;
    if(ZS.toast) ZS.toast(STATUS_WORDS[gameStatus(configGameId(p))]+': only '+OPEN_WORDS+' ready to use');
    return true;
  }
  ZS.configComingSoon = configComingSoon;
  ZS.configLocked = configLocked;
  ZS.configGate = configGate;
  /* the badge for a config, '' when it has none; `dev` adds the dev note
     while developer mode has it open */
  ZS.configSoonBadge = function(p, extraStyle){
    if(!configComingSoon(p)) return '';
    return soonBadge(extraStyle, STATUS_WORDS[gameStatus(configGameId(p))])+(gamesUnlocked() ? devNote() : '');
  };
  /* D394: the config's game's status words ('' with no game) */
  ZS.configStatusWords = function(p){
    var id = configGameId(p);
    return id ? STATUS_WORDS[gameStatus(id)] : '';
  };
  function packsNow(){ return window.ZSPACKS ? ZSPACKS.list() : []; }
  function packsState(){ return window.ZSPACKS ? ZSPACKS.state() : 'failed'; }
  function packGet(id){ return (window.ZSPACKS && id) ? ZSPACKS.get(id) : null; }
  /* the pack a config came from, or null (scratch, legacy, or not loaded) */
  function packOfConfig(p, full){
    if(!window.ZSPACKS) return null;
    return ZSPACKS.ofConfig({ pack: p.pack || ZSPACKS.packIdOf(full),
                              game: ovGameOf(p, full) });
  }
  /* a config the player deliberately started from scratch: it has made its
     choice, so it is never offered the adopt */
  function isScratchConfig(p, full){
    return p.pack === 'scratch' ||
      !!(full && full.gamePack && full.gamePack.id === 'scratch');
  }

  /* One line under a pack's name, and it says plainly how much of the pack
     is really tuned. The wizard is where a player decides, so this is where
     an uncalibrated pack must not pass for a calibrated one. */
  function packSub(pk){
    var tuned = [];
    /* D394: a game whose translator is measured says so first */
    if(pk.aimModel && pk.aimModel.needsCalibration === false) tuned.push('mouse aim');
    ZS.INPUT_TYPES.forEach(function(k){
      var b = pk.inputs && pk.inputs[k];
      if(b && b.calibrated === true) tuned.push(ZS.INP[k]);
    });
    var n = (pk.smartActions || []).length;
    return (tuned.length ? 'Tuned for '+tuned.join(', ') : 'Starting settings, not tuned yet')+
      (n ? ' · '+n+' Script'+(n===1?'':'s') : '');
  }

  /* EVERY TILE IS WORDS FIRST, and since D121 a game's own wide picture
     rides on top of its words once that picture has loaded. D116 kept this
     list text-only so it would read the same with the art folder empty; it
     still does, because the picture is only ever added to the words, never
     instead of them, and a pack with no picture here is the same tile it
     always was. The picture is the wide one, whole (ZS.fitPic), and it is
     decorative: the tile's name is what a screen reader reads. `mode` is
     'create' (the wizard: the last tile is Start from scratch) or 'adopt'
     (the one-time sheet: the last tile is Not now). */
  /* TWO SECTIONS (D300 amended, owner 2026-10-14: "separate the games in a
     category 'Games', then below, all Coming soon, but greyed them all out
     with banners saying Coming soon"). "Games" holds the finished ones
     (GAMES_OPEN) at full strength; "Coming soon" holds every other pack,
     in the pack list's own order, greyed, each with a "Coming soon" banner
     across its art. Developer mode makes those pickable (with the small
     "dev" note) but they stay in the second section with their banner.
     Each section is a .wz-gsec around its own .wz-glist grid, so the
     search can hide a whole section (header and all) when nothing in it
     matches (syncGameSections). */
  function gameTileHtml(pk, sel){
    var on = !!sel && sel === pk.id,
        soon = gameSoon(pk.id),         /* locked: not pickable */
        badge = gameComingSoon(pk.id),  /* unfinished: greyed + banner, always */
        art = (window.ZSPACKS && ZS.fitPic) ? ZSPACKS.artOfPack(pk.id, 'wide') : '',
        ban = '<span class="gsoon-ban">'+esc(STATUS_BANNER[gameStatus(pk.id)])+'</span>';
    /* data-find is what the wizard's search matches (D125): the pack's
       name and its aliases, the words the Configs search uses for it.
       A COMING SOON tile keeps its art and its words, greyed (the
       picture grey and faded, the words faded), with a flat "Coming soon"
       banner across the picture at full strength (.gsoon-ban, inside the
       picture's own span, zs-fixes.css; above the name when a game has
       no picture, and kept there if the picture fails later). The
       banner is read aloud before the name, so a screen reader hears
       "Coming soon, Fortnite"; the picture itself stays decorative
       (alt=""). */
    return '<div class="tile'+(on?' on':'')+(badge?' gsoon-t':'')+(soon?' gsoon':'')+'" data-g="'+esc(pk.id)+'" '+
        (soon ? 'aria-disabled="true" ' : '')+
        'data-find="'+esc(findKeyOf(packFindParts(pk)))+'">'+
      (art ? '<span class="art photo pack fit gpic"'+(badge ? '' : ' aria-hidden="true"')+'>'+
               ZS.fitPic(art, '', false)+(badge ? ban : '')+'</span>'
           : (badge ? ban : ''))+
      '<div class="gname" style="font-weight:600">'+esc(pk.name)+(badge && !soon ? devNote() : '')+'</div>'+
      '<div class="gsub" style="color:var(--muted);font-size:12px;margin-top:2px">'+esc(packSub(pk))+'</div></div>';
  }
  function gameSectionHtml(key, title, tiles){
    if(!tiles) return '';
    return '<section class="wz-gsec" data-gsec="'+key+'" aria-label="'+esc(title)+'">'+
      '<div class="sh wz-gsh" role="heading" aria-level="3">'+esc(title)+'</div>'+
      '<div class="wz-glist" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'+
      tiles+'</div></section>';
  }
  /* hide a section whose every tile the search hid; show it again when one
     matches. Run after the filter (findWire's `after`) and after a repaint. */
  function syncGameSections(root){
    if(!root || !root.querySelectorAll) return;
    root.querySelectorAll('.wz-gsec').forEach(function(sec){
      var any = false;
      sec.querySelectorAll('.tile[data-g]').forEach(function(t){
        if(!t.hasAttribute('hidden')) any = true;
      });
      if(any){ sec.removeAttribute('hidden'); sec.style.display = ''; }
      else { sec.setAttribute('hidden', ''); sec.style.display = 'none'; }
    });
  }
  function gameGridHtml(sel, mode){
    var list = packsNow(), st = packsState(), h = '', i, open = '', cal = '', soon = '';
    for(i=0;i<list.length;i++){
      if(!gameComingSoon(list[i].id)) open += gameTileHtml(list[i], sel);
      else if(gameStatus(list[i].id) === 'calibrated') cal += gameTileHtml(list[i], sel);
      else soon += gameTileHtml(list[i], sel);
    }
    /* D394: three sections, in this order; an empty one is not drawn and
       the search hides one it emptied (syncGameSections) */
    h += gameSectionHtml('open', STATUS_WORDS.ready, open);
    h += gameSectionHtml('cal', STATUS_WORDS.calibrated, cal);
    h += gameSectionHtml('soon', STATUS_WORDS.notStarted, soon);
    /* the loading line and the one other door, in a grid of their own
       under both sections (no data-g: the search never hides them) */
    h += '<div class="wz-glist wz-gdoor" style="display:grid;grid-template-columns:1fr 1fr;'+
         'gap:10px;margin-top:14px">';
    if(st==='idle' || st==='loading'){
      h += '<div class="tile" aria-busy="true" style="grid-column:1 / -1;opacity:.7">'+
        '<div style="font-weight:600">Loading the games…</div></div>';
    }
    /* THE ONE OTHER DOOR, worded for the player whose game is missing, and
       set apart across both columns so it never reads as one more game */
    if(mode === 'adopt'){
      h += '<div class="tile" data-gnone="1" style="grid-column:1 / -1">'+
        '<div style="font-weight:600">Not now</div>'+
        '<div style="color:var(--muted);font-size:12px;margin-top:2px">it stays a general '+
        'config, and you can choose its game once, any time</div></div>';
    } else {
      h += '<div class="tile'+(sel==='scratch'?' on':'')+'" data-gnone="1" style="grid-column:1 / -1">'+
        '<div style="font-weight:600">My game isn’t here: start from scratch</div>'+
        '<div style="color:var(--muted);font-size:12px;margin-top:2px">a general config on '+
        'ZeroStick’s starting settings, with no game. It stays that way.</div></div>';
    }
    h += '</div>';
    if(st==='failed' && !list.length){
      h += note('The game list could not be loaded, so only the scratch door is here right '+
                'now. Go back and open this again to retry.', 'warn');
    }
    return h;
  }
  function gamePickerHtml(sel, mode){
    /* .wz-gpick is the picker's OWN root: wireGamePicker delegates from it,
       so the listener's life is the markup's life (see wireGamePicker) */
    return '<div class="wz-gpick">'+gameGridHtml(sel, mode)+'</div>';
  }
  /* One implementation for the wizard's game step AND the Overview's adopt
     sheet. onPick(pack) — null means the last tile (scratch, or Not now).
     afterPaint(), when given, runs after the grid is repainted under the
     caller (the list or a picture landing late), which is how the wizard's
     search filters the new tiles too (D125). */
  function wireGamePicker(container, mode, sel, onPick, afterPaint){
    /* Delegate from .wz-gpick, the wrapper the CALLER'S render() replaces,
       never from `container`. The wizard's container is the one persistent
       #dbody: wiring there stacked a fresh listener on every Back-and-return
       and outlived the wizard onto screens that reuse data-g (Global
       Settings' subtabs). On the wrapper, the listener dies with the picker. */
    var host = container.querySelector('.wz-gpick');
    if(!host) return;
    host.addEventListener('click', function(e){
      var t = e.target && e.target.closest ? e.target.closest('[data-g],[data-gnone]') : null;
      if(!t) return;
      if(t.hasAttribute && t.hasAttribute('data-gnone')){ onPick(null); return; }
      var gid = t.getAttribute('data-g');
      /* D300: a Coming-soon game is never picked. A developer build with
         developer mode off asks for the code, once; any other build says
         "Coming soon" and nothing else happens. */
      if(gameSoon(gid)){
        if(ZS.devBuild && ZS.devBuild()) askCode();
        else if(ZS.toast) ZS.toast(STATUS_WORDS[gameStatus(gid)]);
        return;
      }
      var pk = packGet(gid);
      if(pk) onPick(pk);
    });
    /* D300: "Enter the developer code", inline at the top of this picker
       (it dies with the picker's markup). 2200 is the Debug box's code: it
       turns developer mode on, on this device, and every game opens. */
    function askCode(){
      if(host.querySelector('.gsoon-code')){
        var f0 = host.querySelector('#gsoon-in');
        if(f0) try{ f0.focus(); }catch(x){}
        return;
      }
      var box = document.createElement('div');
      box.className = 'gsoon-code';
      box.setAttribute('style', 'display:flex;gap:8px;align-items:center;flex-wrap:wrap;'+
        'margin:6px 0 4px;padding:10px;border:1px solid var(--line);border-radius:12px;'+
        'background:var(--panel)');
      box.innerHTML = '<label for="gsoon-in" style="flex:1 1 100%;font-weight:600;font-size:13px">'+
          'Enter the developer code</label>'+
        /* the Debug box's own field and button look (22-global.js) */
        '<input id="gsoon-in" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" '+
          'style="flex:1;min-width:0;box-sizing:border-box;min-height:48px;font-size:16px;'+
          'padding:10px 12px;border-radius:12px">'+
        '<button type="button" class="btn primary" id="gsoon-go" style="min-height:48px">Unlock</button>'+
        '<div id="gsoon-msg" role="status" style="flex:1 1 100%;font-size:12px;color:var(--muted)"></div>';
      host.insertBefore(box, host.firstChild);
      var inp = box.querySelector('#gsoon-in'), go = box.querySelector('#gsoon-go');
      function tryIt(){
        if(String(inp.value || '').replace(/\s+/g, '') !== '2200'){
          box.querySelector('#gsoon-msg').textContent = 'That is not the code. These games are not ready yet.';
          return;
        }
        try{ localStorage.setItem('zs-dev-mode', '1'); }catch(e){}
        if(ZS.toast) ZS.toast('Developer mode is on: every game is unlocked');
        repaint();
      }
      go.addEventListener('click', function(e){ if(e && e.stopPropagation) e.stopPropagation(); tryIt(); });
      inp.addEventListener('keydown', function(e){ if(e && e.key === 'Enter') tryIt(); });
      try{ inp.focus(); }catch(x){}
    }
    function repaint(){
      host.innerHTML = gameGridHtml(sel, mode);
      syncGameSections(host);
      wirePics();
      if(afterPaint) afterPaint();
    }
    /* The list is fetched at boot, so it is normally here. When it is not
       (a slow link, a first paint), repaint the grid ONCE when it lands,
       and only while this very picker is still on screen. */
    var st = packsState();
    if(window.ZSPACKS && st !== 'ready' && st !== 'failed'){
      ZSPACKS.load().then(function(){
        if(!container.contains || !container.contains(host)) return;
        repaint();
      });
    }
    /* A picture that fails after all (removed while the app runs) takes its
       span with it, so the tile is words again and never a broken image. */
    function wirePics(){
      host.querySelectorAll('.gpic img').forEach(function(im){
        im.addEventListener('error', function(){
          var s = im.parentNode;
          /* a Coming-soon banner outlives its picture: it moves up to
             where the picture was (D300 amended) */
          var b = s && s.querySelector ? s.querySelector('.gsoon-ban') : null;
          if(b && s.parentNode) s.parentNode.insertBefore(b, s);
          if(s && s.parentNode) s.parentNode.removeChild(s);
        });
      });
    }
    wirePics();
    /* ...and one that LANDS after the grid was drawn repaints it, while
       this picker is still on screen (D121). One subscription at a time,
       the latest picker's: the wizard redraws its step on every tap. */
    if(WZ_ARTSUB) WZ_ARTSUB();
    WZ_ARTSUB = window.ZSPACKS ? ZSPACKS.onChange(function(kind){
      if(kind !== 'art') return;
      if(!container.contains || !container.contains(host)){ if(WZ_ARTSUB) WZ_ARTSUB(); WZ_ARTSUB = null; return; }
      repaint();
    }) : null;
  }
  var WZ_ARTSUB = null;

  /* The Overview's one-time adopt, for a config made BEFORE game packs only:
     gameless, no record of a pack, and not `default`. It sets the game and
     the pack's name for the picture; it does NOT pour the pack's settings
     over a config somebody has been playing on, and says so. The refusal
     path needs no code here: putProfile prints the board's own errors[0]. */
  function openGameAdopt(p){
    var body = note('Pick the game this config is for. <b>You can set this once</b>, then it '+
        'is locked for the life of the config. Your buttons and aim stay exactly as they '+
        'are: a game pack’s own settings only go into configs made from it.')+
      gamePickerHtml(null, 'adopt');
    var sb = ZS.sheetOpen('Choose a game', body, null);
    wireGamePicker(sb, 'adopt', null, function(pk){
      if(!pk){
        ZS.sheetClose();
        ZS.toast('Still a general config. You can choose its game once, any time.');
        return;
      }
      var game = pk.name;
      ZS.flushProfileWrites(p.id).then(function(){
        return ZS.putProfile(p.id, function(f){
          f.game = game;
          f.gamePack = { id: pk.id, version: pk.version, adopted: true };
          /* D406: a config adopted into NBA 2K gets its Auto green block
             (off): not a setting poured over it, the marker that keeps the
             Core's gun reader off for a 2K config */
          if(window.ZSPACKS && ZSPACKS.isNba2k(f) && !(f.autoGreen && typeof f.autoGreen === 'object')) f.autoGreen = ZSPACKS.autoGreenDefaults();
        });
      }).then(function(j){
        if(!(j && j.ok)) return;   /* putProfile toasted the board's refusal */
        var small = ZS.prof(p.id);
        if(small){ small.game = game; small.pack = pk.id; }
        if(ZS.live.full[p.id]){
          ZS.live.full[p.id].game = game;
          ZS.live.full[p.id].gamePack = { id: pk.id, version: pk.version, adopted: true };
        }
        ZS.persistStore();
        ZS.sheetClose();
        ZS.announce('Game set: '+game+'. Locked for the life of this config.');
        ZS.toast('Locked to '+game+' for the life of this config');
        ZS.renderHome();
        ZS.openDetail({id:'overview', lab:'Device'}, p);
      });
    });
  }

  /* A game pack's turn at a new config's document, as ZS.newConfigDoc's
     `prepare`: ZSPACKS.build with the Ready-made Smart Actions built by
     smart-actions.js for the NEW config (`small` is its list object). pk
     null is Start from scratch. Exported so tools/test-game-packs.js builds
     exactly what the wizard builds, and never a lookalike. */
  function packPrepare(pk, input, extra){
    return function(full, small){
      var built;
      if(!window.ZSPACKS){ delete full.gamePack; full.game = ''; full.gamePack = { id:'scratch' }; built = null; }
      else built = ZSPACKS.build(full, pk || null, input, function(doc, refs){
        return (window.ZS_SMART && ZS_SMART.packActions)
          ? ZS_SMART.packActions(small, doc, refs)
          : { actions: [], problems: ['Scripts did not load'] };
      });
      packTranslate(full, pk, extra);
      return built;
    };
  }
  /* D164: what a new config gets from the game it was made for and the
     wizard's DPI. "Defaults that just work after picking the game": a pack
     carrying the game's aim model (zs-aim-model.js) switches its translator
     on at once, and the mouse's real DPI goes where the translator reads it,
     so Speed means the same whatever the mouse is set to. */
  function packTranslate(full, pk, extra){
    var mt = full.mouseTranslation || (full.mouseTranslation = {});
    if(pk && pk.aimModel && window.ZSAIMMODEL){
      /* D394: the config's console picks the game's speeds for it */
      var rm = ZSAIMMODEL.resolve(pk.aimModel, mt, full.console || full.platform);
      if(rm) mt.resolvedAimModel = rm;
    }
    var dpi = extra && +extra.dpi;
    if(dpi >= 100 && dpi <= 32000) mt.dpi = Math.round(dpi);
  }
  ZS.packTranslate = packTranslate;
  ZS.packPrepare = packPrepare;


  function ovGameOf(p, full){ return String((full && full.game) || p.game || ''); }

