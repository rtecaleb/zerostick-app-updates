      if (k.indexOf('e') >= 0) { x1 = Math.max(x0 + MIN_SIDE, clamp(x1 + dx, 0, 1)); }
      if (k.indexOf('n') >= 0) { y0 = Math.min(y1 - MIN_SIDE, clamp(o[1] + dy, 0, 1)); }
      if (k.indexOf('s') >= 0) { y1 = Math.max(y0 + MIN_SIDE, clamp(y1 + dy, 0, 1)); }
