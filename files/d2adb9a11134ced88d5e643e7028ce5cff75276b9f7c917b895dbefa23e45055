      return;
    }
    var n = toFrame(pt, r);
    if (drag.kind === 'new') {
      ghost = [Math.min(drag.from.x, n.x), Math.min(drag.from.y, n.y),
               Math.abs(n.x - drag.from.x), Math.abs(n.y - drag.from.y)];
