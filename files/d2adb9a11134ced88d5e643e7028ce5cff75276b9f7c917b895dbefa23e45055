    nudge: nudge,
    /* D403: the Anti-Recoil Lab's picture of the wall comes down the same
       road (recoil-wall.js): takeShot(0) -> {bytes|blob, w, h, synthetic},
       urlOf(that) -> an object URL the caller revokes */
    takeShot: takeShot,
    urlOf: urlOf
  };
}());
