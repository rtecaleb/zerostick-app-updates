  }

  /* ── nudges: one pixel of the frame a tap ── */
  function nudge(what) {
    var b = S.box;
    if (!b) { return; }
    var f = frameSize(), dx = 1 / f.w, dy = 1 / f.h;
    var x = b[0], y = b[1], w = b[2], h = b[3];
    if (what === 'left') { x -= dx; }
    else if (what === 'right') { x += dx; }
    else if (what === 'up') { y -= dy; }
    else if (what === 'down') { y += dy; }
    else if (what === 'wider') { x -= dx; w += 2 * dx; }
    else if (what === 'narrower') { x += dx; w -= 2 * dx; }
    else if (what === 'taller') { y -= dy; h += 2 * dy; }
    else if (what === 'shorter') { y += dy; h -= 2 * dy; }
    w = clamp(w, MIN_SIDE, 1); h = clamp(h, MIN_SIDE, 1);
    x = clamp(x, 0, 1 - w); y = clamp(y, 0, 1 - h);
    S.box = [x, y, w, h];
    S.say = null;
    paintAll();
  }

  /* ════════════════════════════════════════ the finger on the picture ══
     The Screen Assist stage's three drags (sections/23-vision.js onDown/onMove/
     onUp: move, a handle's resize, draw a new one), in fractions of the
     frame, plus two a zoom needs: pan when zoomed in, and pinch. */
  var drag = null, ghost = null, fingers = {}, pinch = null;
  function stageRect() {
    var stage = el('gf-stage');
    var r = stage && stage.getBoundingClientRect ? stage.getBoundingClientRect() : null;
    return (r && r.width && r.height) ? r : null;
  }
  function ptOf(e) {
    var t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]) || e;
    return { cx: t.clientX, cy: t.clientY };
  }
  /* a point on the stage, as a point of the whole frame */
  function toFrame(pt, r, v) {
    v = v || shown || S.view;
    return { x: v.x + (pt.cx - r.left) / r.width / v.z, y: v.y + (pt.cy - r.top) / r.height / v.z };
  }
  function onDown(e) {
    if (!S.shot) { return; }
    if (e.button !== undefined && e.button !== 0 && e.pointerType !== 'touch') { return; }
    if (settling) { settling.stop(); settling = null; S.view = clampView(shown || S.view); drawView(S.view); }
    var r = stageRect();
    if (!r) { return; }
    var pt = ptOf(e);
    if (e.pointerId !== undefined) { fingers[e.pointerId] = pt; }
    var ids = Object.keys(fingers);
    if (ids.length >= 2) {
      /* A SECOND FINGER IS A PINCH: whatever the first began is put back */
      if (drag && drag.orig) { S.box = drag.orig; }
      drag = null; ghost = null;
      var a = fingers[ids[0]], b = fingers[ids[1]];
      var mid = { cx: (a.cx + b.cx) / 2, cy: (a.cy + b.cy) / 2 };
      pinch = { d0: Math.max(1, Math.sqrt(Math.pow(a.cx - b.cx, 2) + Math.pow(a.cy - b.cy, 2))),
