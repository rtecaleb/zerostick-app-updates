      var v0 = drag.v0, span = 1 / v0.z;
      var rawX = v0.x - (pt.cx - drag.pt.cx) / r.width / v0.z;
      var rawY = v0.y - (pt.cy - drag.pt.cy) / r.height / v0.z;
      var cx = clamp(rawX, 0, 1 - span), cy = clamp(rawY, 0, 1 - span);
