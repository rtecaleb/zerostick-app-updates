      drag = { kind: hEl.getAttribute('data-h'), from: n, pt: pt, orig: S.box.slice() };
    } else if (inBox && S.box) {
      drag = { kind: 'move', from: n, pt: pt, orig: S.box.slice() };
    } else if (S.view.z > 1.001) {
      drag = { kind: 'pan', from: n, pt: pt, v0: { x: S.view.x, y: S.view.y, z: S.view.z } };
