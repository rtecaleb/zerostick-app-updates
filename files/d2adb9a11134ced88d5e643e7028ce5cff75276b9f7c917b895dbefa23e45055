    on('gf-recap3', recapture);
    on('gf-def', function () {
      S.box = S.builtIn.slice();
      S.say = { kind: 'info', text: 'The built-in frame is back on your picture. Tap Next, then save it.' };
      if (S.saved === false && same(S.builtIn, S.core)) { S.say = null; }
