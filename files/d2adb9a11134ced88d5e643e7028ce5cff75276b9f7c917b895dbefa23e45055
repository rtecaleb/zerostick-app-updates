  /* ════════════════════════════════════════════════ the door and back ══ */
  function render(p) {
    injectCss();
    /* a fresh visit asks the Core again; a redraw of this same visit keeps
       what the player is doing */
    if (isCore() && S.read !== 'reading' && S.read !== 'ready') { readBox(); }
    if (isCore()) { loadRef(p); }
    /* D398: the whole flow wears the purple (zs-flat.css section 23) */
    return { html: '<div id="gf" class="gfzone">' + screenHTML() + '</div>', after: function (root) {
      root.setAttribute('data-tint', 'auto');
      wire(root);
      paintAll();
