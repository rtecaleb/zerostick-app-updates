    open: open,
    BUILT_IN: BUILT_IN.slice(),
    /* the "?"'s words, shared with the door in AI Scripts (D339) */
    HELP: HELP,
    /* for the tests: the box rule the Core applies, and the editor's state */
    cleanBox: cleanBox,
    state: function () {
      return { read: S.read, core: S.core && S.core.slice(), saved: S.saved, loaded: S.loaded,
               step: S.step, ref: S.ref ? S.ref.state : null,
               box: S.box && S.box.slice(), shot: !!S.shot, view: { x: S.view.x, y: S.view.y, z: S.view.z } };
