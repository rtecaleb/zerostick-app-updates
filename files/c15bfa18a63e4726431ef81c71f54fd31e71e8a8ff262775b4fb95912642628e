}
html body #edmenu > .item > .ico.ico-img { transition: width .44s var(--ease-settle, cubic-bezier(.22,1,.36,1)), flex-basis .44s var(--ease-settle, cubic-bezier(.22,1,.36,1)); }
html body #edmenu > .item .lab, html body #edmenu > .item .hint { transition: font-size .44s var(--ease-settle, cubic-bezier(.22,1,.36,1)); }
html body #edmenu > .edgrp { max-height: 32px; overflow: hidden; }

/* simple: the Advanced rooms and every heading fold to nothing */
html body #edmenu.edsimple > .item[data-grp="Advanced"],
html body #edmenu.edsimple > .edgrp {
  max-height: 0 !important; min-height: 0 !important; flex-grow: 0 !important;
  margin-top: 0 !important; margin-bottom: 0 !important; border-width: 0 !important;
