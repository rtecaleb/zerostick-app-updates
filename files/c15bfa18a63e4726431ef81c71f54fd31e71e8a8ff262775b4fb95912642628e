html body #edmenu > .edstat { position: relative; flex: 1 1 auto; display: block;
  margin: 6px 14px 4px; border-radius: 16px; overflow: hidden; min-height: 180px; max-height: 1000px;
  border: 1px solid var(--line); background: #000; }
html body #edmenu:not(.edsimple) > .edstat { flex: 0 0 0px; min-height: 0; max-height: 0; margin-top: 0; margin-bottom: 0;
  border-width: 0; opacity: 0; transform: translateY(12px) scale(.98); }
html body #edmenu .edstat-pic { position: absolute; inset: 0; display: block; }
html body #edmenu .edstat-pic .art { width: 100% !important; height: 100% !important; border-radius: 0 !important;
  display: block; box-shadow: none !important; }
html body #edmenu .edstat-pic .art::after { display: none; }
html body #edmenu .edstat-pic .art img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
html body #edmenu .edstat-pic .art img.artbg { display: none; }
html body #edmenu .edstat-top, html body #edmenu .edstat-foot { position: absolute; left: 0; right: 0; z-index: 2;
  display: flex; padding: 12px 14px; color: #fff; }
html body #edmenu .edstat-top { top: 0; gap: 8px; flex-wrap: wrap;
  background: linear-gradient(180deg, rgba(0,0,0,.62), rgba(0,0,0,0)); padding-bottom: 26px; }
html body #edmenu .edstat-foot { bottom: 0; flex-direction: column; gap: 2px;
  background: linear-gradient(0deg, rgba(0,0,0,.8), rgba(0,0,0,.45) 60%, rgba(0,0,0,0)); padding-top: 34px; }
html body #edmenu .edstat-chip { display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px;
