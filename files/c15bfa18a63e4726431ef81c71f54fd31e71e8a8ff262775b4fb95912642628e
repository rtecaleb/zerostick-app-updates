}

/* the Advanced button: small, at the foot, its chevron turns when open */
html body #edmenu > .edadv { flex: none; align-self: center; display: inline-flex; align-items: center; gap: 6px;
  margin: 8px auto 12px; padding: 8px 18px; min-height: 40px; border-radius: 999px;
