/* simple: the four doors share the top half, picture first; the config's
   art takes the rest (owner, 2026-10-22) */
html body #edmenu.edsimple > .item:not([data-grp="Advanced"]) {
  flex: 0 0 76px !important; height: 76px; max-height: 76px; min-height: 76px !important; margin: 5px 14px;
}
/* the full menu: every row pinned to the height it had before the simple
   menu existed (edFixRows measures it), the Advanced button just below */
html body #edmenu.edfixed:not(.edsimple):not(.edmeasure) > .item {
  flex: 0 0 var(--edrow) !important; height: var(--edrow) !important;
  min-height: var(--edrow) !important; max-height: var(--edrow) !important;
}
html body #edmenu.edmeasure > .edstat, html body #edmenu.edmeasure > .edadv { display: none !important; }
html body #edmenu.edmeasure > *, html body #edmenu.edmeasure > * * { transition: none !important; }
html body #edmenu.edsimple > .item.has-pic > .ico.ico-img { width: 40%; flex-basis: 40%; }
html body #edmenu.edsimple > .item .lab { font-size: 21px; letter-spacing: -.01em; }
