// ─────────────────────────────────────────────────────────────────────────────
//  app-connect.js — ZeroStick app WiFi auto-connect layer
//
//  This file is what makes the APP different from the web portal:
//    1. It defines espFetch() — every message to the board goes through here.
//       Inside the app it uses the phone's NATIVE http (via Capacitor), which
//       is allowed to talk to the board even though the board has no internet.
//    2. On app launch (and every time the app comes back to the foreground)
//       it automatically finds + joins the calibrator's WiFi network, checks
//       it's really a ZeroStick board, and only then reveals the UI.
//
//  3. The NEW Bluetooth dongle (CH582F) skips all of the WiFi business: the
//     customer picks "Bluetooth dongle" once (remembered), the phone connects
//     over Bluetooth (js/hid-ble.js), and hid-proxy.js uses that link instead.
//
//  IMPORTANT: this script must load BEFORE js/hid-proxy.js (hid-proxy uses
//  espFetch). Check the <script> order in index.html if you move things.
// ─────────────────────────────────────────────────────────────────────────────
(function () {
  'use strict';

  // Blank line between sentences in the connect overlay. Built from char
  // codes so the copy below stays free of escape sequences.
  var BREAK = String.fromCharCode(10) + String.fromCharCode(10);

  // ── Settings — match these to the firmware (see AP_SSID in the .ino) ───────
  var WIFI_NAME = 'ZeroStick-Calibrator'; // the WiFi network the board creates
  var BOARD_URL = 'http://192.168.4.1';   // the board's fixed address on that network
  var PING_PATH = '/info';                // endpoint that proves "this is our board"

  // Are we running inside the real app (true) or a normal browser tab (false)?
  function isApp() {
    return !!(window.Capacitor && window.Capacitor.isNativePlatform &&
              window.Capacitor.isNativePlatform());
  }

  // ── espFetch: send one request to the board ────────────────────────────────
  //  Returns an object that looks like a normal fetch() response (has .ok,
  //  .text(), .json()) so hid-proxy.js can use it without caring which path
  //  the request actually took.
  window.espFetch = async function (path) {
    var url = BOARD_URL + path;
    if (isApp()) {
      // Native request — goes out over the WiFi connection the app created,
      // and isn't blocked by the browser's "no http from an app page" rule.
      var res = await window.Capacitor.Plugins.CapacitorHttp.request({
        url: url,
        method: 'GET',
        responseType: 'text',
        connectTimeout: 4000,
        readTimeout: 4000
      });
      var asText = (typeof res.data === 'string') ? res.data : JSON.stringify(res.data);
      return {
        ok: res.status >= 200 && res.status < 300,
        status: res.status,
        text: async function () { return asText; },
        json: async function () {
          return (typeof res.data === 'string') ? JSON.parse(res.data) : res.data;
        }
      };
    }
    // Browser fallback (testing on a PC that joined the board's WiFi manually)
    return fetch(url);
  };

  // ── Ping: is the board reachable AND really a ZeroStick calibrator? ────────
  async function pingBoard() {
    try {
      var r = await window.espFetch(PING_PATH);
      if (!r.ok) return false;
      var info = await r.json();
      return info && info.device === 'zerostick-calibrator';
    } catch (e) {
      return false;
    }
  }

  // ── Which dongle: 'ble' (new) or 'wifi' (older), remembered per phone ─────
  var LINK_KEY = 'zsCalibratorLink';
  function savedLink() {
    try { return localStorage.getItem(LINK_KEY); } catch (e) { return null; }
  }
  function saveLink(v) {
    try { localStorage.setItem(LINK_KEY, v); } catch (e) { /* private mode: ask again next time */ }
  }

  // ── The overlay (full-screen "Connecting…" panel shown over the UI) ────────
  var overlay, statusEl, spinnerEl, retryBtn, chooseEl;

  function buildOverlay() {
    overlay = document.createElement('div');
    overlay.id = 'zsConnectOverlay';
    overlay.style.cssText =
      'position:fixed;inset:0;z-index:99999;display:flex;flex-direction:column;' +
      'align-items:center;justify-content:center;background:#101418;color:#fff;' +
      'text-align:center;padding:24px;gap:18px;';
    overlay.innerHTML =
      '<img src="brand-nav.png" alt="ZeroStick" style="max-width:70%;max-height:120px;object-fit:contain;">' +
      '<div id="zsSpinner" style="width:42px;height:42px;border:4px solid #2c3440;' +
        'border-top-color:#0d6efd;border-radius:50%;animation:zsspin 1s linear infinite;"></div>' +
      '<div id="zsStatus" style="font-size:1.05em;max-width:340px;line-height:1.45;white-space:pre-line;">Starting…</div>' +
      '<button id="zsRetry" style="display:none;padding:12px 34px;font-size:1.05em;border:0;' +
        'border-radius:8px;background:#0d6efd;color:#fff;">Try again</button>' +
      '<div id="zsChoose" style="display:none;flex-direction:column;gap:12px;width:100%;max-width:320px;">' +
        '<button data-link="ble" style="padding:14px;font-size:1.05em;border:0;border-radius:8px;' +
          'background:#0d6efd;color:#fff;">Bluetooth dongle</button>' +
        '<button data-link="wifi" style="padding:14px;font-size:1.05em;border:1px solid #2c3440;' +
          'border-radius:8px;background:transparent;color:#fff;">WiFi calibrator (older)</button>' +
      '</div>' +
      '<button id="zsSwitch" style="display:none;background:none;border:0;color:#8aa4c8;' +
        'text-decoration:underline;font-size:.95em;">Use a different calibrator</button>' +
      '<style>@keyframes zsspin{to{transform:rotate(360deg)}}</style>';
    document.body.appendChild(overlay);
    statusEl  = overlay.querySelector('#zsStatus');
    spinnerEl = overlay.querySelector('#zsSpinner');
    retryBtn  = overlay.querySelector('#zsRetry');
    chooseEl  = overlay.querySelector('#zsChoose');
    switchBtn = overlay.querySelector('#zsSwitch');
    retryBtn.addEventListener('click', function () { connectFlow(true); });
    chooseEl.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-link]');
      if (!b) return;
      saveLink(b.getAttribute('data-link'));
      connectFlow(true);
    });
    switchBtn.addEventListener('click', function () { saveLink(''); connectFlow(); });
  }
  var switchBtn;

  function showChooser() {
    overlay.style.display = 'flex'; spinnerEl.style.display = 'none';
    retryBtn.style.display = 'none'; switchBtn.style.display = 'none';
    chooseEl.style.display = 'flex';
    statusEl.textContent = 'Which calibrator do you have?' + BREAK +
      'The Bluetooth dongle came with newer modules. The WiFi calibrator has a ' +
      'blue light and makes a "ZeroStick-Calibrator" WiFi network.';
  }

  function showStatus(msg)  { overlay.style.display = 'flex'; chooseEl.style.display = 'none'; switchBtn.style.display = 'none'; spinnerEl.style.display = 'block'; retryBtn.style.display = 'none'; statusEl.textContent = msg; }
  function showError(msg)   { overlay.style.display = 'flex'; chooseEl.style.display = 'none'; switchBtn.style.display = 'block'; spinnerEl.style.display = 'none';  retryBtn.style.display = 'block'; statusEl.textContent = msg; }
  function hideOverlay()    { overlay.style.display = 'none'; }

  // Always-available fallback: joining the network by hand in Settings works
  // even when the app cannot do it itself. Worth saying on every failure --
  // an App Review tester has no calibrator in range and would otherwise be
  // left looking at what reads as a broken app.
  var MANUAL_HINT = 'You can also join the "' + WIFI_NAME + '" network ' +
                    'yourself in your phone\'s WiFi settings, then tap Try again.';

  // Turn the plugin's error codes into instructions a customer can follow
  function explainError(code) {
    if (code === -4) return 'WiFi is turned off. Please turn WiFi on in your phone settings, then try again.';
    if (code === -5 || code === -6 || code === -1)
      return 'Permission needed: please allow this app to use WiFi/location (required by ' +
             'your phone to join the calibrator network), then try again.';
    if (code === -3) return 'Could not find the "' + WIFI_NAME + '" network.' + BREAK +
           'Make sure the calibrator is plugged in and its light is on, and hold your ' +
           'phone within 6 feet of it. It can take up to 30 seconds after plugging in ' +
           'before the network appears. ' + MANUAL_HINT;
    // Anything else: the join simply did not happen. Two very different
    // causes look identical here -- no hardware in range, or the app not
    // being allowed to join networks itself -- so name both, and always
    // offer the manual route, which works no matter which it was.
    return 'Could not join the calibrator WiFi automatically.' + BREAK +
           'Make sure the calibrator is powered on and your phone is within 6 feet of ' +
           'it, then try again. When your phone asks to join the network, tap Connect ' +
           'or Join. ' + MANUAL_HINT;
  }

  // ── The main connect sequence ──────────────────────────────────────────────
  var connecting = false;

  // ── Bluetooth dongle ───────────────────────────────────────────────────────
  var bleWatching = false;
  async function connectBle(fromTap) {
    if (!window.ZSHIDBLE) { showError('This version of the app cannot use the Bluetooth dongle.'); return; }
    if (window.ZSHIDBLE.isConnected()) { hideOverlay(); return; }
    markBle();
    // A dongle this phone already knows reconnects by itself, no chooser
    // (inside the app it is usually still connected from the dongle screen).
    if (window.ZSHIDBLE.remembered && window.ZSHIDBLE.remembered()) {
      showStatus('Reconnecting to your ZeroStick dongle…');
      try {
        await window.ZSHIDBLE.reconnect();
        watchBle();
        hideOverlay();
        return;
      } catch (e) {
        if (!(e && e.zsKind === 'none') && !fromTap) {
          var x = window.ZSHIDBLE.explain(e);
          showError(x.title + '.' + BREAK + x.text);
          return;
        }
      }
    }
    if (!isApp() && !fromTap) {
      // A browser only opens its Bluetooth picker from a real tap.
      showError('Tap Connect to find your ZeroStick dongle.');
      retryBtn.textContent = 'Connect';
      return;
    }
    retryBtn.textContent = 'Try again';
    showStatus('Looking for your ZeroStick dongle…' + BREAK +
               'Plug the dongle into your PS5 (or any USB charger), plug your ' +
               'controller into the dongle, and keep your phone close. Pick ' +
               '"ZeroStick Dongle" when your phone asks.');
    try {
      await window.ZSHIDBLE.connect();
    } catch (e) {
      var ex = window.ZSHIDBLE.explain(e);
      showError(ex.title + '.' + BREAK + ex.text);
      return;
    }
    watchBle();
    hideOverlay();
  }
  function watchBle() {
    if (bleWatching) return;
    bleWatching = true;
    window.ZSHIDBLE.onDisconnect(function () {
      showError('The dongle disconnected. Check it is still plugged in, then tap Try again.');
    });
  }
  // The Bluetooth dongle has no WiFi network and no reboot page: hide the
  // calibrator's WiFi-only hints (calibrator.html marks them .zs-wifi-only).
  function markBle() {
    var s = document.getElementById('zsBleOnly');
    if (s) return;
    s = document.createElement('style');
    s.id = 'zsBleOnly';
    s.textContent = '.zs-wifi-only{display:none !important;}';
    document.head.appendChild(s);
  }

  async function connectFlow(fromTap) {
    if (connecting) return;
    // Opened from the ZeroStick Dongle screen: it is the Bluetooth dongle.
    if (/[?&]from=dongle(&|$)/.test(location.search)) saveLink('ble');
    var link = savedLink();
    if (link !== 'ble' && link !== 'wifi') { showChooser(); return; }
    if (link === 'ble') {
      connecting = true;
      try { await connectBle(fromTap); } finally { connecting = false; }
      return;
    }
    connecting = true;
    try {
      // Already connected from a previous session? Then we're done instantly.
      showStatus('Looking for your ZeroStick calibrator…' + BREAK +
                 'This can take up to 30 seconds. Keep your phone within 6 feet ' +
                 'of the calibrator.');
      if (await pingBoard()) { hideOverlay(); return; }

      if (!isApp()) {
        // Plain browser: we can't join WiFi for the user — tell them how.
        showError('Join the WiFi network "' + WIFI_NAME + '" on this device, then tap Try again.');
        return;
      }

      var W = window.Capacitor.Plugins.CapacitorWifiConnect;

      // 1) Phones require a permission before an app may manage WiFi
      var perm = (await W.checkPermission()).value;
      if (perm === 'prompt' || perm === 'prompt-with-rationale') {
        perm = (await W.requestPermission()).value;
      }
      if (perm !== 'granted') {
        showError('Permission needed: please allow this app to use WiFi/location so it can find the calibrator, then try again.');
        return;
      }

      // 2) Ask the phone to join the calibrator's network
      showStatus('Connecting to "' + WIFI_NAME + '"…' + BREAK +
                 'Your phone will ask you to join — tap Connect or Join to continue.' + BREAK +
                 'Please allow up to 30 seconds, and keep your phone within 6 feet ' +
                 'of the calibrator.');
      var res = await W.connect({ ssid: WIFI_NAME, saveNetwork: true });
      if (res.value !== 0) { showError(explainError(res.value)); return; }

      // 3) Joined! Now confirm the board answers (can take a few seconds)
      showStatus('Connected! Checking the calibrator…' + BREAK + 'This takes a few seconds.');
      for (var i = 0; i < 12; i++) {
        if (await pingBoard()) { hideOverlay(); return; }
        await new Promise(function (r) { setTimeout(r, 700); });
      }
      showError('Joined the WiFi but the calibrator did not answer. Unplug it, plug it back in, and try again.');
    } catch (e) {
      showError('Something went wrong: ' + (e && e.message ? e.message : e) + ' — try again.');
    } finally {
      connecting = false;
    }
  }

  // ── Watchdog: if the phone drops the WiFi mid-session, reconnect ───────────
  var failCount = 0;
  setInterval(async function () {
    if (connecting) return;
    if (savedLink() !== 'wifi') return;                      // Bluetooth has its own disconnect event
    if (overlay && overlay.style.display !== 'none') return; // already showing
    if (await pingBoard()) { failCount = 0; return; }
    failCount++;
    if (failCount >= 3) {   // ~3 misses in a row = really disconnected
      failCount = 0;
      connectFlow();        // shows the overlay + rejoins automatically
    }
  }, 4000);

  // ── Kick everything off ────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    buildOverlay();
    connectFlow();
    // Re-check every time the user switches back to the app
    if (isApp() && window.Capacitor.Plugins.App) {
      window.Capacitor.Plugins.App.addListener('resume', function () { connectFlow(); });
    }
  });
})();
