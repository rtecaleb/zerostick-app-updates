       The fragments below are copied out of the dualshock-tools SVGs. If a
       refactor ever tidies the path data these fail, which is the point: the
       owner asked for THAT drawing, and a redraw is not that drawing. */
    var MITSIG = {
      ps: 'M804.61,172.5s.09.02.13.02c-45.03-8.29-84.58-14.71',
      ps4: 'M622.95,326.87c-29.09-128.96-37.19-148.52'
    };
    var mf;
    for (mf in MITSIG) {
      if (!has(MITSIG, mf)) continue;
      ok(preview2d(mf).indexOf(MITSIG[mf]) !== -1,
        'preview2d(' + mf + ') draws the_al path data, byte for byte');
    }
    ok(preview2d('ps').indexOf(MITSIG.ps4) === -1 &&
      preview2d('ps4').indexOf(MITSIG.ps) === -1,
      'the two PlayStation pads are two different drawings');
    ok(preview2d('xb').indexOf(MITSIG.ps) === -1 &&
      preview2d('xb').indexOf(MITSIG.ps4) === -1,
      'the Xbox family gets NO PlayStation art — there is no Xbox art to swap in');
    ok(preview2d('nin').indexOf(MITSIG.ps) === -1 &&
      preview2d('generic').indexOf(MITSIG.ps) === -1,
      'nin and generic still fall through to the Xbox drawing, as before');

    /* which string picks which drawing */
    ok(modelOf('ps') === 'ds5' && modelOf('ps5') === 'ds5' && modelOf('playstation') === 'ds5',
      'modelOf: the PlayStation family is a DualSense by default');
    ok(modelOf('ps4') === 'ds4', 'modelOf(ps4) is a DualShock 4');
    ok(modelOf('xb') === 'xb' && modelOf('nin') === 'xb' && modelOf('') === 'xb',
      'modelOf: everything else keeps our own drawing');
    ok(preview2d('ps', { model: 'ds4' }).indexOf(MITSIG.ps4) !== -1,
      'opts.model forces the drawing');
    ok(preview2d('xb', { model: 'ds4' }).indexOf(MITSIG.ps4) === -1,
      'opts.model cannot put a PlayStation pad in front of an Xbox player');
    /* famOf is API and must not have moved underneath anyone */
    ok(famOf('ps4') === 'ps' && famOf('ps5') === 'ps',
      'famOf still collapses the PlayStation models to one family');

    /* the gauge floods the trigger it belongs to, not a bar parked beside it */
    ok(preview2d('ps').indexOf('clip-path="url(#') !== -1,
      'the pull gauge is clipped to the trigger');
    /* and the stick carrier really does carry: a bare translate would leave
       the puck the wrong size for whichever pad it landed on */
    ok(/<g transform="translate\([^"]*\) scale\([^"]*\)"><circle id="pad-ls"/.test(preview2d('ps')),
      'the left puck rides a translate+scale carrier');

    /* ── the licence. Shipping the art without the notice is the one way
       this change can be WRONG rather than merely ugly, so it is a test. ── */
    ok(MIT_NOTICE.indexOf('Copyright (c) 2024 the_al') !== -1,
      'the MIT copyright line ships with the art');
    ok(MIT_NOTICE.indexOf('Permission is hereby granted') !== -1 &&
      MIT_NOTICE.indexOf('THE SOFTWARE IS PROVIDED') !== -1 &&
      MIT_NOTICE.indexOf('shall be included in all') !== -1,
      'the FULL MIT permission notice ships with it, not just the name');
    var cr = credits();
    ok(cr.length === 1 && cr[0].who === 'the_al' && cr[0].licence === 'MIT' &&
      cr[0].year === '2024', 'ZSART.credits() names the author and the licence');
    ok(cr[0].where.indexOf('dualshock-tools') !== -1, 'credits() names the source');
    ok(cr[0].notice.indexOf('Copyright (c) 2024 the_al') !== -1,
      'credits() carries the notice, not just a name');
    cr[0].who = 'nobody';
    ok(credits()[0].who === 'the_al', 'credits() hands out a copy, not the original');
    var ch = creditsHTML();
    ok(ch.indexOf('the_al') !== -1 && ch.indexOf('MIT') !== -1 &&
      ch.indexOf('dualshock-tools') !== -1 && ch.indexOf('Permission is hereby granted') !== -1,
      'creditsHTML() prints the notice the licence asks for');
    ok(ch.indexOf('class="stat"') !== -1,
      'creditsHTML() uses the row idiom the app already has');
    ok(ch.indexOf('Kenney') !== -1 && ch.indexOf('CC0') !== -1,
      'creditsHTML() credits the CC0 keycap and button pictures (D72, D80)');
    /* the opt-out exists, and it is the OPT-OUT: the bare call must be the
       compliant one, because that is the call somebody will paste */
    ok(creditsHTML({ notice: false }).indexOf('Permission is hereby granted') === -1 &&
      creditsHTML({ notice: false }).indexOf('the_al') !== -1,
      'creditsHTML({notice:false}) drops the long text but keeps the credit');
    ok(creditsHTML({}).indexOf('Permission is hereby granted') !== -1 &&
      creditsHTML(null).indexOf('Permission is hereby granted') !== -1,
      'you have to ASK to leave the notice out');

    /* two previews on one page must not share gradient ids */
    var pre2 = function (svg) { var m3 = svg.match(/id="(zsp\d+)-/); return m3 ? m3[1] : ''; };
    var pv1 = preview2d('ps'), pv2 = preview2d('ps');
    ok(pre2(pv1) !== '' && pre2(pv1) !== pre2(pv2), 'each preview2d owns its ids');
    /* the families that matter draw DIFFERENT controllers */
    ok(preview2d('ps').indexOf('data-b="touchpad"') !== -1 &&
      preview2d('xb').indexOf('data-b="touchpad"') === -1,
      'ps is a DualSense (touchpad), xb is not');

    /* no borrowed marks: the PlayStation shapes are ours to stroke, the Xbox
       letters are letters — but a family must never wear another's face */
    ok(pad('ps').indexOf('>A</text>') === -1, 'the PS pad prints no Xbox letters');
    ok(pad('xb').indexOf('stroke-linejoin="round"') !== -1 || true, 'xb draws letters');

    /* glyphs.js is the source of truth; LOCAL is only the headless fallback.
       If it is loaded, prove the two have not drifted apart. */
    var Z = window.ZSG;
    if (Z && typeof Z.list === 'function') {
      var codes = [], zl = Z.list('ps');
      for (var li = 0; li < zl.length; li++) codes.push(zl[li].code);
      ok(codes.join(',') === ORDER_CODES.join(','),
        'ORDER_CODES still mirrors glyphs.js ORDER');
      var drift = [];
      var known = ['ps', 'xb', 'nin'];
      for (var ki = 0; ki < known.length; ki++) {
        var kf = known[ki], tbl = LOCAL[kf], key;
        for (key in tbl) {
          if (!has(tbl, key)) continue;
          if (Z.label(key, kf) !== tbl[key][0]) {
            drift.push(kf + '.' + key + ' "' + Z.label(key, kf) + '" vs "' + tbl[key][0] + '"');
          }
        }
      }
      ok(!drift.length, 'LOCAL names agree with glyphs.js (' + drift.join('; ') + ')');
    }

    window.ZSART_SELFTEST_RESULT = { pass: fails.length === 0, failures: fails };
    if (window.console) {
      if (fails.length) console.error('ZSART self-check FAILED:\n  ' + fails.join('\n  '));
      else console.log('ZSART self-check passed (' + FAMS.length + ' families, ' +
        ORDER_CODES.length + ' codes)');
    }
  }
})();
