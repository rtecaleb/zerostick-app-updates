      '<stop offset="1" stop-color="' + t.plate + '"/></linearGradient>');
    /* the touch surface, a shade lighter than the recess it sits in */
    s.push('<linearGradient id="' + c.id('touch') + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="' + t.plate + '"/>' +
      '<stop offset="1" stop-color="' + t.plateLo + '"/></linearGradient>');

    /* CONCAVE: dark centre, light rim */
    s.push('<radialGradient id="' + c.id('dish') + '" cx="0.5" cy="0.4" r="0.62">' +
      '<stop offset="0" stop-color="#0c0e12"/>' +
      '<stop offset="0.68" stop-color="#282d36"/>' +
      '<stop offset="1" stop-color="#5b6470"/></radialGradient>');
    s.push('<radialGradient id="' + c.id('dishLit') + '" cx="0.5" cy="0.4" r="0.62">' +
      '<stop offset="0" stop-color="' + t.hiLo + '"/>' +
      '<stop offset="0.68" stop-color="' + t.hi + '"/>' +
      '<stop offset="1" stop-color="' + t.hiHi + '"/></radialGradient>');

    /* CONVEX: the same circle with the stops flipped — light upper-left */
    s.push('<radialGradient id="' + c.id('dome') + '" cx="0.34" cy="0.26" r="0.8">' +
      '<stop offset="0" stop-color="#fcfdfe"/>' +
      '<stop offset="0.5" stop-color="' + t.face + '"/>' +
      '<stop offset="1" stop-color="#8a929f"/></radialGradient>');
    s.push('<radialGradient id="' + c.id('lit') + '" cx="0.34" cy="0.26" r="0.8">' +
      '<stop offset="0" stop-color="' + t.hiHi + '"/>' +
      '<stop offset="0.5" stop-color="' + t.hi + '"/>' +
      '<stop offset="1" stop-color="' + t.hiLo + '"/></radialGradient>');

    /* The shoulder slabs sit in the shell's shadow, and the trigger behind the
       bumper is darker again — two tones is what separates them at a glance. */
    s.push('<linearGradient id="' + c.id('bump') + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="' + t.shellLo + '"/>' +
      '<stop offset="1" stop-color="' + t.plateLo + '"/></linearGradient>');
    s.push('<linearGradient id="' + c.id('trig') + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="' + t.edge + '"/>' +
      '<stop offset="1" stop-color="' + t.plateLo + '"/></linearGradient>');

    if (!c.compact) {
      s.push('<filter id="' + c.id('drop') + '" x="-30%" y="-40%" width="160%" height="200%">' +
        '<feGaussianBlur stdDeviation="10"/></filter>');
      s.push('<filter id="' + c.id('soft') + '" x="-70%" y="-70%" width="240%" height="240%">' +
        '<feGaussianBlur stdDeviation="2.2"/></filter>');
      s.push('<filter id="' + c.id('glow') + '" x="-80%" y="-80%" width="260%" height="260%">' +
        '<feGaussianBlur stdDeviation="4.5"/></filter>');
      /* inner shadow — blur+offset, composite OUT of the source alpha, flood,
         then put the source back over it. This is what makes a hole a hole. */
      s.push('<filter id="' + c.id('inner') + '" x="-40%" y="-40%" width="180%" height="180%">' +
        '<feOffset dy="3"/><feGaussianBlur stdDeviation="3" result="o"/>' +
        '<feComposite in="SourceGraphic" in2="o" operator="out" result="k"/>' +
        '<feFlood flood-color="#000" flood-opacity="0.6"/>' +
        '<feComposite in2="k" operator="in"/>' +
        '<feComposite in2="SourceGraphic" operator="over"/></filter>');
    }

    if (full) {
      s.push('<path id="' + c.id('bp') + '" d="' + BODY + '"/>');
      /* href is SVG2; xlink:href keeps an old Android WebView happy too */
      s.push('<clipPath id="' + c.id('clip') + '"><use href="#' + c.id('bp') +
        '" xlink:href="#' + c.id('bp') + '"/></clipPath>');
    }
    return s.join('');
  }

  /* ── the parts ────────────────────────────────────────────────── */

  /* A raised control: cast shadow, optional glow, the dome, a rim. `part` is
     written out as data-part so a caller can also light it from the DOM. */
  function raised(c, shape, on, part, glint, rest) {
    var s = [];
    s.push(shape('fill="#000" opacity="' + (c.compact ? '0.3' : '0.45') +
      '" transform="translate(0,3)"' + c.f('soft')));
    if (on && !c.compact) s.push(shape('fill="' + c.t.hi + '" opacity="0.85"' + c.f('glow')));
    /* `rest` overrides the unlit fill: a dark stud reads as a small utility
       button, where the pale dome reads as a pearl stuck on the shell. */
    s.push(shape('data-part="' + part + '" fill="' +
      (on ? c.ref('lit') : (rest ? c.ref(rest) : c.ref('dome'))) + '"'));
    s.push(shape('fill="none" stroke="' + (on ? c.t.hiHi : '#fff') +
      '" stroke-opacity="' + (on ? '0.9' : (rest ? '0.28' : '0.4')) + '" stroke-width="1"'));
    if (glint) s.push(glint);
    return s.join('');
  }

  /* the squashed white ellipse at 11 o'clock that says "moulded plastic" */
  function glintAt(cx, cy, r) {
    return '<ellipse cx="' + n(cx - r * 0.24) + '" cy="' + n(cy - r * 0.37) +
      '" rx="' + n(r * 0.44) + '" ry="' + n(r * 0.26) + '" fill="#fff" opacity="0.5"/>';
  }

  /* One dished analog stick. Five elements do the whole job, and the bright arc
     on the FAR rim is the one the eye actually reads as concavity. */
  function stickArt(c, cx, cy, wellR, capR, on, dx, dy, part) {
    var s = [];
    var lean = wellR * 0.2;
    var ox = cx + dx * lean, oy = cy - 1.5 + dy * lean;
    s.push('<circle cx="' + n(cx) + '" cy="' + n(cy + 3) + '" r="' + n(wellR) +
      '" fill="#000" opacity="0.45"' + c.f('soft') + '/>');
    s.push('<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(wellR) + '" fill="#0a0c0f"/>');
    s.push('<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(wellR) +
      '" fill="none" stroke="#fff" stroke-opacity="0.16" stroke-width="1.5"/>');
    if (on && !c.compact) {
      s.push('<circle cx="' + n(ox) + '" cy="' + n(oy) + '" r="' + n(capR + 2) +
        '" fill="' + c.t.hi + '" opacity="0.8"' + c.f('glow') + '/>');
    }
    s.push('<circle data-part="' + part + '" cx="' + n(ox) + '" cy="' + n(oy) + '" r="' + n(capR) +
      '" fill="' + c.ref(on ? 'dishLit' : 'dish') + '"/>');
    s.push('<path d="M' + n(ox - capR * 0.78) + ',' + n(oy - capR * 0.53) +
      ' a' + n(capR) + ',' + n(capR) + ' 0 0 1 ' + n(capR * 1.56) + ',0" fill="none" stroke="#fff"' +
      ' stroke-opacity="0.34" stroke-width="' + n(capR * 0.13) + '" stroke-linecap="round"/>');
    s.push('<ellipse cx="' + n(ox) + '" cy="' + n(oy + capR * 0.6) + '" rx="' + n(capR * 0.6) +
      '" ry="' + n(capR * 0.19) + '" fill="#fff" opacity="0.08"/>');
    return s.join('');
  }

  /* The d-pad: one raised plus, four arms that can light independently, and an
     ink tick on each arm so the direction is readable with no colour at all. */
  function dpadArt(c, cx, cy, a, b, hi) {
    var s = [], t = c.t;
    var d = plusPath(cx, cy, a, b);
    s.push(raised(c, pathOf(d), false, 'dpad'));
    var arms = [
      ['dpad_up',    cx - a + 1.5, cy - b + 1.5, 2 * a - 3, b - a - 1.5],
      ['dpad_down',  cx - a + 1.5, cy + a,       2 * a - 3, b - a - 1.5],
      ['dpad_left',  cx - b + 1.5, cy - a + 1.5, b - a - 1.5, 2 * a - 3],
      ['dpad_right', cx + a,       cy - a + 1.5, b - a - 1.5, 2 * a - 3]
    ];
    for (var i = 0; i < arms.length; i++) {
      var A = arms[i], on = !!hi.on[A[0]];
      var sh = rrect(A[1], A[2], A[3], A[4], 3);
      if (on && !c.compact) s.push(sh('fill="' + t.hi + '" opacity="0.9"' + c.f('glow')));
      s.push(sh('data-part="' + A[0] + '" fill="' + (on ? c.ref('lit') : 'none') + '"'));
    }
    var k = (b + a) / 2;                       /* how far out the tick sits */
    var w = a * 0.42;
    var ink = t.ink;
    s.push('<path d="M' + n(cx) + ',' + n(cy - k - w) + ' l' + n(w * 1.2) + ',' + n(w * 2) +
      ' h' + n(-w * 2.4) + ' Z" fill="' + ink + '" opacity="0.92"/>');
    s.push('<path d="M' + n(cx) + ',' + n(cy + k + w) + ' l' + n(w * 1.2) + ',' + n(-w * 2) +
      ' h' + n(-w * 2.4) + ' Z" fill="' + ink + '" opacity="0.92"/>');
    s.push('<path d="M' + n(cx - k - w) + ',' + n(cy) + ' l' + n(w * 2) + ',' + n(-w * 1.2) +
      ' v' + n(w * 2.4) + ' Z" fill="' + ink + '" opacity="0.92"/>');
    s.push('<path d="M' + n(cx + k + w) + ',' + n(cy) + ' l' + n(-w * 2) + ',' + n(-w * 1.2) +
      ' v' + n(w * 2.4) + ' Z" fill="' + ink + '" opacity="0.92"/>');
    return s.join('');
  }

  /* Xbox and Nintendo print letters; a pad we cannot name gets the board's own
     compass words. The stylised sphere is the trademark — the letter is not. */
  var LETTER = {
    xb:      { north: 'Y', east: 'B', south: 'A', west: 'X' },
    nin:     { north: 'X', east: 'A', south: 'B', west: 'Y' },
    generic: { north: 'N', east: 'E', south: 'S', west: 'W' }
  };

  /* The PlayStation shapes, drawn as plain strokes in OUR ink at OUR weight —
     nominative use, identifying the button under the thumb. Never Sony's
     colours, never their stylisation, and never the PS logo. */
  function faceMark(fam, pos, cx, cy, r, ink) {
    var s = r / 15, sw = n(2.2 * s);
    if (fam === 'ps') {
      if (pos === 'north') {
        return '<path d="M' + n(cx) + ',' + n(cy - 9 * s) + ' l' + n(8 * s) + ',' + n(14 * s) +
          ' h' + n(-16 * s) + ' Z" fill="none" stroke="' + ink + '" stroke-width="' + sw +
          '" stroke-linejoin="round"/>';
      }
      if (pos === 'east') {
        return '<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(6.6 * s) +
          '" fill="none" stroke="' + ink + '" stroke-width="' + sw + '"/>';
      }
      if (pos === 'south') {
        return '<path d="M' + n(cx - 6 * s) + ',' + n(cy - 6 * s) + ' l' + n(12 * s) + ',' + n(12 * s) +
          ' M' + n(cx + 6 * s) + ',' + n(cy - 6 * s) + ' l' + n(-12 * s) + ',' + n(12 * s) +
          '" fill="none" stroke="' + ink + '" stroke-width="' + n(2.4 * s) + '" stroke-linecap="round"/>';
      }
      return '<rect x="' + n(cx - 6 * s) + '" y="' + n(cy - 6 * s) + '" width="' + n(12 * s) +
        '" height="' + n(12 * s) + '" rx="' + n(1.6 * s) + '" fill="none" stroke="' + ink +
        '" stroke-width="' + sw + '"/>';
    }
    var ch = has(LETTER, fam) && has(LETTER[fam], pos) ? LETTER[fam][pos] : '';
    if (!ch) return '';
    return '<text x="' + n(cx) + '" y="' + n(cy + 5.4 * s) + '" text-anchor="middle" font-family="' +
      FONT + '" font-size="' + n(15 * s) + '" font-weight="700" fill="' + ink + '">' + esc(ch) + '</text>';
  }

  /* ── the pad ──────────────────────────────────────────────────── */

  function svgOpen(vbW, vbH, width, aria, fam, cls) {
    var attr = '';
    if (typeof width === 'number' && width > 0) {
      attr = ' width="' + n(width) + '" height="' + n(width * vbH / vbW) +
        '" style="max-width:100%;height:auto"';
    } else if (typeof width === 'string' && width) {
      attr = ' style="width:' + esc(width) + ';height:auto"';
    }
    return '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"' +
      ' viewBox="0 0 ' + vbW + ' ' + vbH + '"' + attr + ' role="img" aria-label="' + esc(aria) +
      '" data-fam="' + esc(fam) + '" class="' + cls + '">';
  }

  function drawPad(family, opts) {
    var o = opts || {};
    var fam = famOf(family);
    var c = ctxOf(fam, o);
    var t = c.t;
    var hi = hiOf(o.highlight);
    var showLabel = !!o.label;
    var vbH = VB_H + (showLabel ? CAPTION_H : 0);
    var w = o.width === undefined || o.width === null ? (c.compact ? 76 : 320) : o.width;
    var s = [];

    s.push(svgOpen(VB_W, vbH, w, NAME[fam], fam, c.compact ? 'zsart zsart-small' : 'zsart'));
    s.push('<defs>' + defs(c, true) + '</defs>');

    /* 1 · contact shadow. Without it the pad floats. */
    s.push('<ellipse cx="220" cy="278" rx="150" ry="16" fill="#000" opacity="' +
      (c.compact ? '0.22' : '0.5') + '"' + c.f('drop') + '/>');

    /* 2 · triggers then bumpers, BEHIND the shell and peeking above the crown.
       Occlusion is the strongest depth cue in the whole drawing, and the order
       here IS the depth: trigger behind bumper behind shell. */
    var slab = [
      ['lt', TRIG, TRIG.lx, -1, 'trig'],
      ['rt', TRIG, TRIG.rx,  1, 'trig'],
      ['l1', BUMP, BUMP.lx, -1, 'bump'],
      ['r1', BUMP, BUMP.rx,  1, 'bump']
    ];
    for (var i = 0; i < slab.length; i++) {
      var S = slab[i], G = S[1], sx = S[2], son = !!hi.on[S[0]];
      var sh = rrect(sx, G.y, G.w, G.h, G.r);
      var pivot = n(sx + G.w / 2) + ',' + n(G.y + G.h / 2);
      s.push('<g transform="rotate(' + (S[3] * G.tilt) + ' ' + pivot + ')">');
      /* a lit shoulder must not bloom into a light bar across the crown */
      if (son && !c.compact) s.push(sh('fill="' + t.hi + '" opacity="0.5"' + c.f('glow')));
      s.push(sh('data-part="' + S[0] + '" fill="' + (son ? c.ref('lit') : c.ref(S[4])) + '"'));
      /* a bright lip along the top edge: that is where the light lands */
      s.push('<rect x="' + n(sx + 5) + '" y="' + n(G.y + 2) + '" width="' + n(G.w - 10) +
        '" height="' + n(G.h * 0.3) + '" rx="' + n(G.h * 0.15) + '" fill="#fff" opacity="' +
        (son ? '0.4' : '0.16') + '"/>');
      s.push('</g>');
    }

    /* 3 · the edge slab — the same path, dropped, in a dark gradient */
    s.push('<use href="#' + c.id('bp') + '" xlink:href="#' + c.id('bp') +
      '" transform="translate(0,6)" fill="' + c.ref('edge') + '"/>');
    /* 4 · the front face */
    s.push('<use href="#' + c.id('bp') + '" xlink:href="#' + c.id('bp') +
      '" fill="' + c.ref('body') + '"/>');

    /* 5 · everything from here is clipped to the shell */
    s.push('<g clip-path="' + c.ref('clip') + '">');

    /* 6 · the form shadow, painted through the body itself, turns the grips
       into volumes without leaving an edge anywhere on the shell */
    s.push('<use href="#' + c.id('bp') + '" xlink:href="#' + c.id('bp') +
      '" fill="' + c.ref('vig') + '"/>');

    /* 7 · the recessed centre plate */
    s.push('<rect x="' + PLATE.x + '" y="' + PLATE.y + '" width="' + PLATE.w + '" height="' + PLATE.h +
      '" rx="' + PLATE.r + '" fill="' + c.ref('plate') + '"' + c.f('inner') + '/>');

    if (!c.compact) {
      /* grip texture — small enough to read as moulding, not as dots */
      var dots = '';
      for (var g = 0; g < 2; g++) {
        var gx = g ? 309 : 104;
        for (var rr = 0; rr < 5; rr++) {
          for (var cc = 0; cc < 4; cc++) {
            dots += '<circle cx="' + (gx + cc * 9) + '" cy="' + (214 + rr * 9) +
              '" r="1.7" fill="#000" opacity="0.15"/>';
          }
        }
      }
      s.push(dots);
    }

    /* 8 · one off-centre sheen over the crown */
    s.push('<rect width="' + VB_W + '" height="' + VB_H + '" fill="' + c.ref('sheen') + '"/>');

    /* ── plate contents ── */
    if (!c.compact) {
      /* The touch surface is deliberately MATTE, and no darker than the plate
         around it. A dark glossy panel with a diagonal wipe reads as a little
         LCD screen — which makes the whole thing look like a handheld, and
         nudges it toward one specific pad's trade dress. Neither is wanted. */
      var tOn = !!hi.on.touchpad;
      s.push('<rect data-part="touchpad" x="' + TOUCH.x + '" y="' + TOUCH.y + '" width="' + TOUCH.w +
        '" height="' + TOUCH.h + '" rx="' + TOUCH.r + '" fill="' + (tOn ? c.ref('lit') : c.ref('touch')) +
        '" stroke="' + (tOn ? t.hiHi : '#fff') + '" stroke-opacity="' + (tOn ? '0.8' : '0.18') +
        '" stroke-width="1"/>');
      /* fine dot texture — a trackpad surface, not glass */
      if (!tOn) {
        var tx = '';
        for (var dr = 0; dr < 4; dr++) {
          for (var dc = 0; dc < 7; dc++) {
            tx += '<circle cx="' + (TOUCH.x + 10 + dc * 7.4) + '" cy="' + (TOUCH.y + 11 + dr * 7.4) +
              '" r="1.05" fill="#000" opacity="0.13"/>';
          }
        }
        s.push(tx);
      }
      /* the status accent — a strip, not a light bar wrapped round a touchpad */
      s.push('<rect x="200" y="144" width="40" height="3" rx="1.5" fill="' + t.hi + '" opacity="0.85"/>');

      s.push(raised(c, rrect(SYSL.x, SYSL.y, SYSL.w, SYSL.h, SYSL.h / 2), !!hi.on.select, 'select'));
      s.push(raised(c, rrect(SYSR.x, SYSR.y, SYSR.w, SYSR.h, SYSR.h / 2), !!hi.on.start, 'start'));
      s.push(sysMark(c, 'select', SYSL.x + SYSL.w / 2, SYSL.y + SYSL.h / 2, !!hi.on.select));
      s.push(sysMark(c, 'start', SYSR.x + SYSR.w / 2, SYSR.y + SYSR.h / 2, !!hi.on.start));
    }

    /* the system button: a neutral ring. No console's emblem goes here, ever. */
    s.push(raised(c, circ(GUIDE.x, GUIDE.y, GUIDE.r), !!hi.on.guide, 'guide'));
    s.push('<circle cx="' + GUIDE.x + '" cy="' + GUIDE.y + '" r="' + n(GUIDE.r * 0.5) +
      '" fill="none" stroke="' + (hi.on.guide ? '#0b0e13' : t.ink) + '" stroke-opacity="0.7" stroke-width="1.6"/>');

    /* ── d-pad ── */
    s.push(dpadArt(c, DPAD.x, DPAD.y, DPAD.a, DPAD.b, hi));

    /* ── face buttons ── */
    var pos = ['north', 'east', 'south', 'west'];
    var at = [
      [FACE.x, FACE.y - FACE.off], [FACE.x + FACE.off, FACE.y],
      [FACE.x, FACE.y + FACE.off], [FACE.x - FACE.off, FACE.y]
    ];
    for (var b = 0; b < 4; b++) {
      var bon = !!hi.on[pos[b]];
      s.push(raised(c, circ(at[b][0], at[b][1], FACE.r), bon, pos[b],
        glintAt(at[b][0], at[b][1], FACE.r)));
      s.push(faceMark(fam, pos[b], at[b][0], at[b][1], FACE.r, bon ? '#0b0e13' : t.ink));
    }

    /* ── sticks ── */
    s.push(stickArt(c, STICK.lx, STICK.y, STICK.well, STICK.cap, !!hi.on.ls,
      hi.lean.ls[0], hi.lean.ls[1], 'ls'));
    s.push(stickArt(c, STICK.rx, STICK.y, STICK.well, STICK.cap, !!hi.on.rs,
      hi.lean.rs[0], hi.lean.rs[1], 'rs'));

    /* ── the two extra buttons (what a board paddle maps to) ── */
    if (!c.compact) {
      var ex = [['extra1', EXTRA.lx], ['extra2', EXTRA.rx]];
      for (var xi = 0; xi < 2; xi++) {
        var xOn = !!hi.on[ex[xi][0]], xc = ex[xi][1];
        s.push(raised(c, rrect(xc - EXTRA.w / 2, EXTRA.y - EXTRA.h / 2, EXTRA.w, EXTRA.h, EXTRA.h / 2),
          xOn, ex[xi][0]));
        s.push('<circle cx="' + n(xc) + '" cy="' + n(EXTRA.y) + '" r="1.5" fill="' +
          (xOn ? '#0b0e13' : t.ink) + '" opacity="0.6"/>');
      }
    }

    s.push('</g>');

    /* 9 · the rim light goes LAST, over everything */
    s.push('<use href="#' + c.id('bp') + '" xlink:href="#' + c.id('bp') +
      '" fill="none" stroke="' + c.ref('rim') + '" stroke-width="2"/>');

    /* The console is named in TEXT — that is the whole point of the caption.
       currentColor so it inherits whatever the surrounding UI is using. */
    if (showLabel) {
      s.push('<text x="220" y="' + (VB_H + 28) + '" text-anchor="middle" font-family="' + FONT +
        '" font-size="21" font-weight="600" fill="currentColor" opacity="0.82">' +
        esc(NAME[fam]) + '</text>');
    }

    s.push('</svg>');
    return s.join('');
  }

  /* Start is "menu" (three rules), Select is "view" (two panes), and Nintendo
     prints + and - instead. Marks may differ; the SHAPE never does. */
  function sysMark(c, which, cx, cy, on) {
    var ink = on ? '#0b0e13' : c.t.ink;
    if (c.fam === 'nin') {
      var h = '<path d="M' + n(cx - 3.4) + ',' + n(cy) + ' h6.8" stroke="' + ink +
        '" stroke-width="1.7" stroke-linecap="round"/>';
      if (which === 'select') return h;
      return h + '<path d="M' + n(cx) + ',' + n(cy - 3.4) + ' v6.8" stroke="' + ink +
        '" stroke-width="1.7" stroke-linecap="round"/>';
    }
    if (which === 'start') {
      return '<path d="M' + n(cx - 4) + ',' + n(cy - 2.2) + ' h8 M' + n(cx - 4) + ',' + n(cy) +
        ' h8 M' + n(cx - 4) + ',' + n(cy + 2.2) + ' h8" stroke="' + ink +
        '" stroke-width="1.2" stroke-linecap="round"/>';
    }
    return '<rect x="' + n(cx - 4) + '" y="' + n(cy - 3) + '" width="5" height="5" rx="1" fill="none" stroke="' +
      ink + '" stroke-width="1.1"/><rect x="' + n(cx - 1) + '" y="' + n(cy - 1) +
      '" width="5" height="5" rx="1" fill="none" stroke="' + ink + '" stroke-width="1.1"/>';
  }

  /* ── one control, on its own ───────────────────────────────────── */

  var BVB = 48;      /* every stand-alone control is drawn in a 48×48 box */

  function pillText(txt, cx, cy, ink) {
    var t = String(txt === undefined || txt === null ? '' : txt) || '?';
    var len = t.length;
    /* A round button is the tight case: "HOME" at the 3-character size runs
       straight out of the circle it is meant to be inside. */
    var fs = len <= 2 ? 17 : (len === 3 ? 12.6 : (len === 4 ? 10.2 : 8.2));
    return '<text x="' + n(cx) + '" y="' + n(cy + fs * 0.35) + '" text-anchor="middle" font-family="' +
      FONT + '" font-size="' + fs + '" font-weight="700" fill="' + ink + '"' +
      (len <= 2 ? ' letter-spacing="0.4"' : '') + '>' + esc(t) + '</text>';
  }

  function drawButton(code, family, opts) {
    var o = opts || {};
    var fam = famOf(family);
    var c = ctxOf(fam, o);
    var t = c.t;
    var raw = normCode(code);
    var base = baseOf(raw);
    var on = !!o.on;
    var ink = on ? '#0b0e13' : t.ink;
    var w = o.width === undefined || o.width === null ? 28 : o.width;
    var mid = BVB / 2;
    var s = [];

    s.push(svgOpen(BVB, BVB, w, textOf(raw, fam, 0), fam, 'zsart zsart-btn'));
    s.push('<defs>' + defs(c, false) + '</defs>');

    if (base === 'north' || base === 'east' || base === 'south' || base === 'west') {
      s.push(raised(c, circ(mid, mid, 15), on, base, glintAt(mid, mid, 15)));
      s.push(faceMark(fam, base, mid, mid, 15, ink));

    } else if (base.indexOf('dpad_') === 0) {
      var one = {}; one[base] = true;
      s.push(dpadArt(c, mid, mid, 8, 19, { on: one, lean: { ls: [0, 0], rs: [0, 0] } }));

    } else if (base === 'l1' || base === 'r1') {
      s.push(raised(c, rrect(5, 14, 38, 20, 10), on, base));
      s.push(pillText(textOf(raw, fam, 1), mid, mid, ink));

    } else if (base === 'lt' || base === 'rt') {
      /* a trigger is taller than it is wide — that is how you tell them apart */
      s.push(raised(c, rrect(9, 8, 30, 32, 13), on, base));
      s.push(pillText(textOf(raw, fam, 1), mid, mid + 2, ink));

    } else if (base === 'l3' || base === 'r3' || has(TILT, raw)) {
      var lean = has(TILT, raw) ? TILT[raw] : [0, 0];
      var part = (base.charAt(0) === 'l') ? 'ls' : 'rs';
      s.push(stickArt(c, mid, mid, 20, 14, on || has(TILT, raw), lean[0], lean[1], part));
      if (!has(TILT, raw)) {
        s.push('<text x="' + mid + '" y="' + (mid + 4) + '" text-anchor="middle" font-family="' + FONT +
          '" font-size="10" font-weight="700" fill="#e6edf3" opacity="0.85">' +
          esc(textOf(raw, fam, 1)) + '</text>');
      }

    } else if (base === 'start' || base === 'select') {
      s.push(raised(c, rrect(6, 17, 36, 14, 7), on, base));
      s.push(sysMark(c, base, mid, mid, on));

    } else if (base === 'guide') {
      s.push(raised(c, circ(mid, mid, 14), on, base, glintAt(mid, mid, 14)));
      s.push(pillText(textOf(raw, fam, 1), mid, mid, ink));

    } else if (base === 'touchpad') {
      s.push('<rect data-part="touchpad" x="7" y="13" width="34" height="22" rx="5" fill="' +
        (on ? c.ref('lit') : c.ref('plate')) + '" stroke="' + (on ? t.hiHi : '#fff') +
        '" stroke-opacity="' + (on ? '0.8' : '0.18') + '" stroke-width="1"' +
        (on ? '' : c.f('inner')) + '/>');
      s.push('<circle cx="' + mid + '" cy="24" r="2.2" fill="' + (on ? '#0b0e13' : '#8a929f') + '"/>');

    } else if (base === 'extra1' || base === 'extra2') {
      s.push(raised(c, circ(mid, mid, 14), on, base, glintAt(mid, mid, 14)));
      s.push(pillText(textOf(raw, fam, 1), mid, mid, ink));

    } else {
      /* Unknown code: show it rather than swallow it, so a bad binding is
         visible in the UI instead of rendering as an empty square. */
      s.push(raised(c, rrect(3, 15, 42, 18, 9), on, 'unknown'));
      s.push(pillText(raw, mid, mid, ink));
    }

    s.push('</svg>');
    return s.join('');
  }

  /* ── preview2d — the pad you are holding, drawn front-on ────────
   *
   * The owner rejected the schematic preview on 2026-08-14 ("use a 2d
   * picture of an actual controller, not whatever that blocky stuff is"),
   * and then asked three times for one specific drawing: the controller art
   * from github.com/dualshock-tools/dualshock-tools.github.io. It is that
   * art now — MIT, © 2024 the_al, notice at the top of this file — for the
   * PlayStation family. The Xbox drawing below is still ours, because that
   * repository has none and shipping a DualSense to an Xbox player would be
   * a worse answer than an honest silhouette.
   *
   * THE CONTRACT (phone-sections.js livePad() + two tap-map wirings; the
   * swap must not touch that code, and it did not):
   *   root svg        class "padviz" — livePad finds the drawing by it.
   *   .pad-btn        every pressable part; data-b names it, data-col is the
   *                   PRESSED fill. livePad REWRITES fill every tick:
   *                     pressed      → data-col
   *                     rest, l3/r3  → var(--accent)
   *                     rest, circle → #0b0e13
   *                     rest, other  → var(--bg)
   *                   so those ARE the resting fills below, by construction —
   *                   anything prettier would be stomped on the first poll.
   *                   Shape detail therefore lives in strokes (never touched)
   *                   and in decor elements around the hotspot. On the MIT
   *                   art that is exactly what their *_outline rings are.
   *   #pad-ls #pad-rs circles; livePad writes cx=96±11/cy=86±11 and
   *                   cx=184±11. Each sits inside a <g> carrier that both
   *                   TRANSLATES it to where that controller really keeps
   *                   that stick and SCALES it, so the throw suits the
   *                   drawing while the wire numbers stay exactly what
   *                   livePad sends.
   *   #pad-lt #pad-rt rects; livePad writes width 0..28 — the pull gauge.
   *                   Same trick: the carrier scales x so 28 is FULL on a
   *                   trigger of any width, and clips it to the trigger's
   *                   own outline so pulling L2 floods L2.
   *   tap-map         phone-sections/smart-actions attach click/keydown +
   *                   role=button to .pad-btn by data-b; decor drawn OVER a
   *                   hotspot carries pointer-events="none" so taps land.
   *
   * Contrast, computed (WCAG relative luminance):
   *   engraved ink #5f6875 (L 0.136) — 3.45:1 on the resting cap #0b0e13
   *   (L 0.004) and 3.17:1 on the pressed cap var(--accent) #2fd9ce
   *   (L 0.541): the one ink that survives both states of a stomped fill.
   *   The face-glyph tints are the same set padSVG used; each is ≥4.9:1 on
   *   the #0b0e13 cap. Press is never colour alone: the fill flip is a
   *   ≥10:1 LUMINANCE change (#0b0e13 → #2fd9ce), and the sticks move.
   */

  var VB2_W = 280, VB2_H = 190;      /* the XBOX drawing's own space; the MIT
                                        pads carry their own, see mitFit() */
  var INK2D = '#5f6875';

  /* the same face tints the old schematic used — authentic and pre-vetted */
  var TINT2D = {
    ps:      { north: '#4EC9A8', east: '#E06C75', west: '#D66BA0', south: '#7DA9D8' },
    xb:      { north: '#E8C13C', east: '#D65454', west: '#4C8DE0', south: '#6DBF44' },
    nin:     { north: '#9fb0c0', east: '#9fb0c0', west: '#9fb0c0', south: '#9fb0c0' },
    generic: { north: '#9fb0c0', east: '#9fb0c0', west: '#9fb0c0', south: '#9fb0c0' }
  };

  function mirX(x) { return VB2_W - x; }

  /* A controller is symmetric, so only the RIGHT half is authored: cubic
     segments from the top centre down to the bottom centre, mirrored back up
     the left side programmatically. One set of numbers, guaranteed symmetry,
     and a typo cannot make the two halves disagree. */
  function symPath(topY, segs) {
    var d = 'M140,' + n(topY);
    var i, s, px, py;
    for (i = 0; i < segs.length; i++) {
      s = segs[i];
      d += ' C' + n(s[0]) + ',' + n(s[1]) + ' ' + n(s[2]) + ',' + n(s[3]) +
        ' ' + n(s[4]) + ',' + n(s[5]);
    }
    for (i = segs.length - 1; i >= 0; i--) {
      s = segs[i];
      px = i ? segs[i - 1][4] : 140;
      py = i ? segs[i - 1][5] : topY;
      d += ' C' + n(mirX(s[2])) + ',' + n(s[3]) + ' ' + n(mirX(s[0])) + ',' + n(s[1]) +
        ' ' + n(mirX(px)) + ',' + n(py);
    }
    return d + ' Z';
  }

  /* Xbox Wireless Controller: raised centre prow for the guide, compact
     rounded shoulders, near-vertical grips, and the narrow notch between
     them rising to a rounded peak — the bottom edge stays BELOW the d-pad
     disc and the right stick well on its way there. */
  var XB_D = symPath(16, [
    [158, 16, 172, 19, 184, 24],
    [198, 30, 212, 36, 224, 46],
    [238, 58, 248, 76, 248, 92],
    [246, 108, 240, 124, 232, 138],
    [224, 152, 214, 162, 203, 161],
    [193, 158, 187, 151, 184, 145],
    [178, 150, 168, 152, 158, 150],
    [148, 147, 146, 129, 140, 129]
  ]);

  function pctx() {
    var u = 'zsp' + (++uidN);
    return {
      u: u,
      id: function (nm) { return u + '-' + nm; },
      ref: function (nm) { return 'url(#' + u + '-' + nm + ')'; }
    };
  }

  /* form shading is black/white at low opacity over token fills, so every
     theme (OLED, high contrast) shades ITS OWN colours instead of ours */
  function pDefs(c, d, vigCy) {
    return '<defs>' +
      '<radialGradient id="' + c.id('shad') + '">' +
      '<stop offset="0" stop-color="#000" stop-opacity="0.35"/>' +
      '<stop offset="0.7" stop-color="#000" stop-opacity="0.22"/>' +
      '<stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>' +
      '<linearGradient id="' + c.id('sheen') + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="#fff" stop-opacity="0.12"/>' +
      '<stop offset="0.55" stop-color="#fff" stop-opacity="0"/></linearGradient>' +
      '<radialGradient id="' + c.id('vig') + '" gradientUnits="userSpaceOnUse"' +
      ' cx="140" cy="' + n(vigCy) + '" r="165">' +
      '<stop offset="0" stop-color="#000" stop-opacity="0"/>' +
      /* the vignette only HINTS at curvature: at 0.28 it drove the grip tips
         below the card's own ground, so at glance size the lower half of the
         silhouette vanished and only the stroke remained ("hollow wings") */
      '<stop offset="0.55" stop-color="#000" stop-opacity="0"/>' +
      '<stop offset="0.82" stop-color="#000" stop-opacity="0.04"/>' +
      '<stop offset="1" stop-color="#000" stop-opacity="0.11"/></radialGradient>' +
      '<linearGradient id="' + c.id('rim') + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="#fff" stop-opacity="0.5"/>' +
      '<stop offset="0.45" stop-color="#fff" stop-opacity="0"/></linearGradient>' +
      '<clipPath id="' + c.id('clip') + '"><path d="' + d + '"/></clipPath>' +
      '</defs>';
  }

  /* One shoulder pair: the trigger peeks above the bumper, both tilted to
     follow the crown, both partly hidden behind the shell drawn after them.
     The track is the pull gauge livePad drives: a fixed 28-wide dark bed and
     the accent rect whose width IS the wire value. */
  function pShoulder(side, T, B, K, tilt) {
    var sgn = side === 'r' ? 1 : -1;
    var tx = side === 'r' ? mirX(T[0]) - T[2] : T[0];
    var bx = side === 'r' ? mirX(B[0]) - B[2] : B[0];
    var kx = side === 'r' ? mirX(K[0]) - 28 : K[0];
    var s = [];
    s.push('<g transform="rotate(' + n(sgn * tilt) + ' ' + n(tx + T[2] / 2) + ' ' + n(T[1] + T[3] / 2) + ')">');
    s.push('<rect x="' + n(tx) + '" y="' + n(T[1]) + '" width="' + n(T[2]) + '" height="' + n(T[3]) +
      '" rx="' + n(T[4]) + '" fill="#0e1319" stroke="#fff" stroke-opacity="0.08" stroke-width="1"/>');
    s.push('<rect x="' + n(kx) + '" y="' + n(K[1]) + '" width="28" height="' + n(K[2]) +
      '" rx="' + n(K[3]) + '" fill="#000" opacity="0.35"/>');
    s.push('<rect id="pad-' + side + 't" x="' + n(kx) + '" y="' + n(K[1]) + '" width="0" height="' + n(K[2]) +
      '" rx="' + n(K[3]) + '" fill="var(--accent)" opacity="0.9"/>');
    s.push('</g>');
    s.push('<g transform="rotate(' + n(sgn * tilt) + ' ' + n(bx + B[2] / 2) + ' ' + n(B[1] + B[3] / 2) + ')">');
    s.push('<rect class="pad-btn" data-b="' + (side === 'r' ? 'r1' : 'l1') +
      '" data-col="var(--accent)" x="' + n(bx) + '" y="' + n(B[1]) + '" width="' + n(B[2]) +
      '" height="' + n(B[3]) + '" rx="' + n(B[4]) + '" fill="var(--bg)" stroke="var(--line)" stroke-width="1"/>');
    s.push('<rect x="' + n(bx + 6) + '" y="' + n(B[1] + 2.5) + '" width="' + n(B[2] - 12) +
      '" height="4" rx="2" fill="#fff" opacity="0.08" pointer-events="none"/>');
    s.push('</g>');
    return s.join('');
  }

  /* An analog stick: dark well, rubber cap drawn as decor, and the MOVING
     part — the accent puck — is the wired circle. Its neutral cx/cy are the
     numbers livePad writes back (96/184, 86); the surrounding translate
     carries it to where this controller actually keeps that stick. */
  function pStick2d(side, wx, wy) {
    var isR = side === 'r';
    var nx = isR ? 184 : 96;
    var s = [];
    s.push('<circle cx="' + n(wx) + '" cy="' + n(wy) + '" r="26" fill="#000" opacity="0.3"/>');
    s.push('<circle cx="' + n(wx) + '" cy="' + n(wy) + '" r="26" fill="none" stroke="#fff" stroke-opacity="0.1" stroke-width="1.5"/>');
    s.push('<circle cx="' + n(wx) + '" cy="' + n(wy) + '" r="20" fill="#0d1117"/>');
    s.push('<circle cx="' + n(wx) + '" cy="' + n(wy) + '" r="20" fill="none" stroke="#fff" stroke-opacity="0.14" stroke-width="1.2"/>');
    s.push('<path d="M' + n(wx - 14) + ',' + n(wy - 9) + ' a17,17 0 0 1 28,0" fill="none"' +
      ' stroke="#fff" stroke-opacity="0.2" stroke-width="2" stroke-linecap="round"/>');
    s.push('<g transform="translate(' + n(wx - nx) + ',' + n(wy - 86) + ')">' +
      '<circle id="pad-' + (isR ? 'rs' : 'ls') + '" class="pad-btn" data-b="' + (isR ? 'r3' : 'l3') +
      '" data-col="#fff" cx="' + nx + '" cy="86" r="8" fill="var(--accent)"' +
      ' stroke="rgba(0,0,0,0.55)" stroke-width="1.5"/></g>');
    return s.join('');
  }

  /* the four-arm pad on a recessed disc; each arm is its own hotspot and
     wears an engraved tick so direction reads with no colour at all */
  function pDpad2d(cx, cy, discR, aw, reach, gap) {
    var arm = reach - gap;
    var s = [];
    s.push('<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(discR) + '" fill="#000" opacity="0.28"/>');
    s.push('<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(discR) + '" fill="none" stroke="#fff" stroke-opacity="0.09" stroke-width="1.2"/>');
    var arms = [
      ['dpad_up',    cx - aw, cy - reach, 2 * aw, arm],
      ['dpad_down',  cx - aw, cy + gap,   2 * aw, arm],
      ['dpad_left',  cx - reach, cy - aw, arm, 2 * aw],
      ['dpad_right', cx + gap,   cy - aw, arm, 2 * aw]
    ];
    for (var i = 0; i < arms.length; i++) {
      var A = arms[i];
      s.push('<rect class="pad-btn" data-b="' + A[0] + '" data-col="var(--accent)" x="' + n(A[1]) +
        '" y="' + n(A[2]) + '" width="' + n(A[3]) + '" height="' + n(A[4]) +
        '" rx="5" fill="var(--bg)" stroke="#fff" stroke-opacity="0.12" stroke-width="1"/>');
    }
    var k = reach - arm / 2;
    var t = 3.2;
    s.push('<g fill="' + INK2D + '" pointer-events="none">' +
      '<path d="M' + n(cx) + ',' + n(cy - k - t) + ' l' + n(t) + ',' + n(2 * t) + ' h' + n(-2 * t) + ' Z"/>' +
      '<path d="M' + n(cx) + ',' + n(cy + k + t) + ' l' + n(t) + ',' + n(-2 * t) + ' h' + n(-2 * t) + ' Z"/>' +
      '<path d="M' + n(cx - k - t) + ',' + n(cy) + ' l' + n(2 * t) + ',' + n(-t) + ' v' + n(2 * t) + ' Z"/>' +
      '<path d="M' + n(cx + k + t) + ',' + n(cy) + ' l' + n(-2 * t) + ',' + n(-t) + ' v' + n(2 * t) + ' Z"/>' +
      '</g>');
    return s.join('');
  }

  /* the face diamond: recess shadow, cap (the hotspot), tinted mark on top */
  function pFace2d(fam, cx, cy, off, r) {
    var pos = ['north', 'east', 'south', 'west'];
    var at = [[cx, cy - off], [cx + off, cy], [cx, cy + off], [cx - off, cy]];
    var tint = TINT2D[fam];
    var s = [];
    for (var i = 0; i < 4; i++) {
      s.push('<circle cx="' + n(at[i][0]) + '" cy="' + n(at[i][1]) + '" r="' + n(r + 1.8) + '" fill="#000" opacity="0.25"/>');
      s.push('<circle class="pad-btn" data-b="' + pos[i] + '" data-col="var(--accent)" cx="' + n(at[i][0]) +
        '" cy="' + n(at[i][1]) + '" r="' + n(r) + '" fill="#0b0e13" stroke="#fff" stroke-opacity="0.14" stroke-width="1"/>');
      s.push('<g pointer-events="none">' +
        faceMark(fam, pos[i], at[i][0], at[i][1], r, tint[pos[i]]) + '</g>');
    }
    return s.join('');
  }

  /* a small round system button (guide / view / menu) with an engraved mark */
  function pSysBtn(b, cx, cy, r, mark) {
    return '<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(r + 1.6) + '" fill="#000" opacity="0.25"/>' +
      '<circle class="pad-btn" data-b="' + b + '" data-col="var(--accent)" cx="' + n(cx) + '" cy="' + n(cy) +
      '" r="' + n(r) + '" fill="#0b0e13" stroke="#fff" stroke-opacity="0.14" stroke-width="1"/>' +
      '<g pointer-events="none">' + mark + '</g>';
