/* smart-actions/06-mappings.js — Smart Mappings (D85): a button that runs a script.
 *
 * The Mappings room's smart rows and the "new script for this button" seed.
 *
 * Tests: test-smart-actions.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('mappings', function (SEC) {
  'use strict';
  /* from the parts before this one */
  var acc = SEC.acc, btn = SEC.btn, btnI = SEC.btnI, card = SEC.card, esc = SEC.esc,
      note = SEC.note, helpNote = SEC.helpNote, sh = SEC.sh, srcClass = SEC.srcClass, ZS = SEC.ZS,
      boardWord = SEC.boardWord, roomNoteHTML = SEC.roomNoteHTML, sicon = SEC.sicon;
  /* from parts after this one, bound once every part has run (never used
     while this part is running) */
  var workshopOffered, bindsLive, inputsFor, rowFor, inputRowHTML, inputsHTML, inputWord,
      seqLineHTML, draw, smartSeed;
  ZS_SMART_PARTS.after(function () {
    workshopOffered = SEC.workshopOffered;
    bindsLive = SEC.bindsLive;
    inputsFor = SEC.inputsFor;
    rowFor = SEC.rowFor;
    inputRowHTML = SEC.inputRowHTML;
    inputsHTML = SEC.inputsHTML;
    inputWord = SEC.inputWord;
    seqLineHTML = SEC.seqLineHTML;
    draw = SEC.draw;
    smartSeed = SEC.smartSeed;
  });

  /* ══ SMART MAPPINGS (D85, 2026-09-05) ═════════════════════════════
     The owner: "the smart actions tab should ONLY show the smart actions
     that you currently have, and a button that is a collapsible menu that
     reiterates the mappings again — so it's like, yes, mappings is in 2
     places I think, but in here mappings is a collapsed menu unless
     clicked — and then the smart actions are separated in one menu
     showing as the smart mappings … and add the record sequence button
     also."
     Top to bottom: the buttons that carry a Smart Action, as the SAME
     rows the Mappings list draws for them (D82's .inrow.hasseq — the
     source cell, the sequence's name, the step strip, "+1 more"; a tap
     opens the panel in editor mode, D81), plus the sequences no button
     starts (the ✕ cell, press-to-bind); Record sequence, the page's one
     primary; the whole Mappings list folded closed under it (the kit's
     accordion, remembered per config in S.mapFold), so a plain button can
     be opened from here too and its panel carries the Smart Actions Editor
     door. The old Yours cards and Build's "press the button you want" flow
     are gone; what they showed that matters rides the rows — an "off" tag
     beside a switched-off sequence's name and the D70 "!" chip on one that
     will not fire. The rows come from the same inputsFor() model as the
     fold, so one wireList covers both and a data-row index means the same
     row in either place. */
  function smartMapHTML(S, p) {
    var model = inputsFor(p, S);
    var live = bindsLive(p);
    var flat = model.rows.concat(model.orphans);
    function idxOf(row) { var k; for (k = 0; k < flat.length; k++) if (flat[k] === row) return k; return -1; }
    /* ONE ROW PER ACTION, IN THE ORDER THEY WERE MADE (D127). The owner:
       "when I add a smart mapping it doesn't show that it is added, and I
       should have a list as I add them". Rows were one per BUTTON, with
       "+1 more" for the rest, so on a gun whose fire button already ran two
       Auto Actions a third one made there changed "+1 more" to "+2 more"
       and nothing else. Now each action is its own row (its button, its
       name, its steps), a new one lands at the foot, right above New Smart
       Action, and a tap opens that action in the editor. Every action in
       the room is listed, a hidden-type one included (inputsFor 3b), and so
       is one on a real button whose device is not plugged in (Q with no
       keyboard): its row says "will not fire" and why. Only an action with
       no usable button at all stays in the ✕ list under the card. */
    var loose = model.orphans.filter(function (r) { return !r.source || r.kind === 'unknown'; });
    var pairs = [];
    model.rows.concat(model.orphans).forEach(function (r) {
      if (loose.indexOf(r) >= 0) return;
      r.acts.forEach(function (pair) { pairs.push({ r: r, pair: pair }); });
    });
    pairs.sort(function (x, y) { return x.pair.i - y.pair.i; });
    /* D470: a weapon's page (AI Scripts) on a Native Mouse & Keyboard
       config lists the Scripts that work with a real mouse and keyboard;
       the rest are hidden here, never deleted (native-kbm.js scriptFits) */
    var nkHid = 0;
    if (S.scope && window.ZSNATIVE && ZSNATIVE.on(p)) {
      pairs = pairs.filter(function (x) { var f = ZSNATIVE.scriptFits(x.pair.a); if (!f) nkHid++; return f; });
    }
    var h = (live ? '' :
        note('Your board is offline. Changes are kept on this phone and sent the moment it comes back.', 'warn')) +
      '<div id="sa-running" class="note" style="display:none;color:var(--green)"></div>';
    var rows = pairs.map(function (x) {
      return inputRowHTML(x.r, idxOf(x.r), p, S, { state: true, act: x.pair });
    }).join('');
    var sc = S.scope;
    /* D281 (owner, 2026-10-10: "make the Scripts tab collapsible in
       Scripts"): the card's title row is a real button that folds the list
       in place. Folded it reads "Scripts · 4"; the position is this
       viewer's (localStorage, smartListFolded), open by default. */
    var folded = smartListFolded();
    /* D398 (owner, 2026-10-16: make the Advanced Script Maker "as
       user-friendly and dummy-proof as possible"). The main room (not a
       weapon's page, whose New Script stays its one primary, D125) opens on
       the three easy ways in, biggest first: the Anti-Recoil Lab (the Recoil
       Workshop renamed, purple, zs-flat.css section 21), then "Paste
       ready-made script" (the Ready-made library, with a quiet sheen), then
       Record script in its own record colour. New script (advanced) is the
       last thing in the room, plain, with a "?" saying what it is for.
       D398 amended (owner, 2026-10-16: "you didn't make the script changes
       ... when you click guns"): a weapon's page is the same room, so it
       draws the same two pieces (roomTopHTML, newAdvHTML) in the same
       places; there is one layout, not two that can drift apart. There the
       Lab's model is saved into that weapon's Scripts (the room is scoped). */
    /* on a weapon's page the room is titled as it is in the Editor menu
       (owner, 2026-10-16), so the player knows it is the same Script Maker */
    if (sc) h += '<div class="sh" id="sa-roomhd">Advanced Script Maker</div>';
    /* 2026-10-22 (owner: "in Advanced Script Maker the New script button
       doesn't have to be so hidden - only in AI Scripts does it need to be
       that hidden; in Advanced it should be front and center"): the main
       room opens on New script, the room's primary; a weapon's page (AI
       Scripts) keeps it last and quiet (newAdvHTML) */
    if (!sc) h += newMainHTML();
    h += roomTopHTML(p, sc);
    /* the owner, 2026-10-17 ("get rid of all that text and add question
       marks"): the card's line under its title is a "?" beside the title
       (a sibling of the fold button, never inside it); its fold opens under
       the title row */
    var mh = helpNote('sa-map-help', 'Scripts', esc(sc && sc.mapNote ? sc.mapNote : 'Each Script, and the button that starts it.'));
    var mcut = mh.indexOf('<div class="note qhfold"');
    h += '<div class="grp-card samap sasmartmap safold' + (folded ? ' sacoll' : '') + '" id="sa-smartmap">' +
      '<button type="button" class="samaphd sasmarthd" id="sa-smarthd" aria-controls="sa-smartbody" aria-expanded="' +
        (folded ? 'false' : 'true') + '"><b>Scripts</b><em class="safoldn">· ' + pairs.length + '</em>' +
      '<i class="safoldchev" aria-hidden="true">›</i></button>' +
      (mcut > 0 ? mh.slice(0, mcut) + '<div class="samapsay">' + mh.slice(mcut) + '</div>' : mh) +
      '<div class="safoldbody" id="sa-smartbody">' +
      /* D285: "None yet." on screen; how to make one is the "?" */
      (rows || (sc && sc.emptyHTML ? '<div class="lrow saempty" id="sa-smartnone">' + sc.emptyHTML + '</div>' +
          (sc.emptyHelp ? helpNote('sa-none', 'Scripts', sc.emptyHelp) : '')
        : '<div class="lrow saempty" id="sa-smartnone">None yet.</div>' +
          helpNote('sa-none', 'Scripts', sc ? 'Start with the <b>Anti-Recoil Lab</b>, <b>Paste ready-made ' +
          'script</b> or <b>Record script</b> above. <b>New script (advanced)</b>, at the bottom, builds one ' +
          'step by step.'
          : 'Start with the <b>Anti-Recoil Lab</b>, <b>Paste ready-made script</b> or <b>Record script</b> ' +
          'above, or open a button under <b>Mappings</b>. <b>New script (advanced)</b>, at the bottom, builds one ' +
          'step by step.'))) +
      '</div></div>';
    if (nkHid) {
      h += note('<b>' + nkHid + '</b> Script' + (nkHid > 1 ? 's that drive' : ' that drives') + ' a stick or a ' +
        'trigger ' + (nkHid > 1 ? 'are' : 'is') + ' hidden in Native Mouse &amp; Keyboard. ' +
        (nkHid > 1 ? 'They are' : 'It is') + ' still saved, untouched.');
    }
    /* a Smart Action on a control this config's input type does not use is
       listed above like any other (it used to be counted out here and the
       player told to change the config's input type to see it); what is
       worth saying is that it needs that device plugged in to ever run */
    var typeRows = pairs.filter(function (x) { return !!x.r.typeHidden; }).length;
    if (typeRows) {
      h += note('<b>' + typeRows + '</b> of these start' + (typeRows > 1 ? '' : 's') + ' on a control <b>' +
        esc(inputWord(p)) + '</b> does not use, so ' + (typeRows > 1 ? 'they run' : 'it runs') +
        ' only while that device is plugged in. Open ' + (typeRows > 1 ? 'one' : 'it') +
        ' to choose another button.');
    }
    var saveErr = String((ZS.live && ZS.live.saveError && ZS.live.saveError[p.id]) || '').replace(/\s+$/, '');
    if (saveErr && ZS.live.online !== false) {
      h += note('Your last change did not reach your ' + boardWord() + ': ' + esc(saveErr) +
        (/[.!?]$/.test(saveErr) ? '' : '.') +
        ' It is kept here, and goes over with your next change once that is fixed.', 'warn');
    }
    h += roomNoteHTML(p, !!saveErr);
    /* D291: what moved off X for Turn assist (16-buttons.js), said once */
    if (!sc && SEC.taMovedNoteHTML) h += SEC.taMovedNoteHTML(p);
    if (loose.length) {
      /* D280: a Script that is simply waiting for a key (Turn assist where
         X already had a job) is not a fault, so it is not said as one */
      var waiting = loose.every(function (r) {
        return r.acts.every(function (pair) { return !!(pair.a.trigger && pair.a.trigger.unbound); });
      });
      h += sh('Not attached to a button yet') +
        card(loose.map(function (r) {
          return r.acts.map(function (pair) { return seqLineHTML(pair, idxOf(r), p, S, r); }).join('');
        }).join('')) +
        (waiting ? note('Ready to use: tap the ✕ and press the key you want it on.')
                 : note('These sequences are saved, but nothing on your board can start them. Tap the ✕ and pick a button.', 'warn'));
    }
    /* D125 made New Smart Action a weapon page's one primary, with Record
       and Ready-made under it and the Lab last. D398 (amended) replaced
       that with the main room's own order: the easy ways in on top
       (roomTopHTML, above), New script (advanced) last (newAdvHTML). */
    /* the Mappings fold is the main room's alone: in a weapon's room every
       button opens on a new sequence, never on a remap, so a list titled
       Mappings there promised something it could not do */
    /* D256 (owner, 2026-10-09: "the Mappings tab in Scripts should be the
       same image and banner as the Mappings tab in the home screen"): the
       fold's header is the home menu's Mappings door - its picture
       (ZS.mappingsArt, the plugged-in device) and its name */
    if (!sc) {
      var mart = (ZS.mappingsArt && ZS.mappingsArt()) || null;
      var mhtml = acc('Mappings', mart && mart.src ? null : 'grid', inputsHTML(p, S, { fold: true }), !!S.mapFold, 'sa-mapfold');
      if (mart && mart.src) {
        mhtml = mhtml.replace('<div class="ah">', '<div class="ah samapbanner"><img class="samapimg" src="' +
          esc(mart.src) + '" alt="" aria-hidden="true">');
      }
      h += mhtml;
    }
    h += btn('⤵ Paste a code someone sent me', null, 'sa-import');
    if (sc) h += newAdvHTML();
    return h;
  }
  function newMainHTML() {
    var nh = ZS.helpHTML ? ZS.helpHTML('sa-new-help', 'New script', NEW_MAIN_HELP) : '';
    var nq = nh.indexOf('<div class="note qhfold');
    return '<div class="sanewmain" id="sa-newadv"><div class="sanewrow">' +
      btnI('plus', 'New script', 'primary', 'sa-new') + (nq > 0 ? nh.slice(0, nq) : '') + '</div>' +
      (nq > 0 ? nh.slice(nq) : '') + '</div>';
  }
  var NEW_MAIN_HELP = 'Build a script <b>step by step</b>: choose the button that starts it, then add ' +
    'each press, hold, stick push and wait. For a quicker start, the <b>Anti-Recoil Lab</b>, a ' +
    '<b>ready-made script</b> or <b>Record script</b> below make one for you.';
  /* D398: New script, last and quiet: it is the advanced way in. Both
     rooms (the Advanced Script Maker and a weapon's page) draw this one. */
  function newAdvHTML() {
    var nh = ZS.helpHTML ? ZS.helpHTML('sa-new-help', 'New script (advanced)', NEW_HELP) : '';
    var nq = nh.indexOf('<div class="note qhfold');
    return '<div class="sanewadv" id="sa-newadv"><div class="sanewrow">' +
      btnI('plus', 'New script (advanced)', 'saquiet', 'sa-new') + (nq > 0 ? nh.slice(0, nq) : '') + '</div>' +
      (nq > 0 ? nh.slice(nq) : '') + '</div>';
  }
  var NEW_HELP = 'For building a script <b>step by step</b>: you choose the button that starts it, then add ' +
    'each press, hold and wait yourself. Most people never need it: the <b>Anti-Recoil Lab</b>, a ' +
    '<b>ready-made script</b> or <b>Record script</b> make one for you.';
  /* D398: the room's three easy ways in, biggest first */
  /* owner 2026-10-16: on a gun's page (AI Scripts) "the focus there is
     rapid fire, aim assist and recoil" - so those three ready-made Scripts
     sit right under the Lab as one-tap tiles. Each opens the same
     ready-made sheet the library does (SEC.openTemplate), already scoped to
     this gun. */
  var QUICK = [
    { tpl: 'turbo', ico: 'burst', n: 'Rapid fire' },
    { tpl: 'aimboost', ico: 'waves', n: 'Aim assist' },
    { tpl: 'recoil', ico: 'target', n: 'Anti-recoil' },
    /* 2026-10-22: Warzone's own (AI Scripts' Quick scripts, gun-bulk.js) */
    { tpl: 'autoping', ico: 'target', n: 'Auto ping', games: ['cod-warzone'], svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" ' +
      'stroke-linejoin="round"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0113 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/></svg>' }
  ];
  function quickTilesHTML(p) {
    var T = SEC.TEMPLATES || [];
    var full = p && ZS.live && ZS.live.full ? ZS.live.full[p.id] : null;
    var pk = (window.ZSPACKS && ZSPACKS.ofConfig) ? ZSPACKS.ofConfig(full || p) : null;
    var tiles = QUICK.map(function (q) {
      if (q.games && !(pk && q.games.indexOf(pk.id) >= 0)) return '';   /* a game's own (Auto ping) */
      if (window.ZSNATIVE && !ZSNATIVE.quickShown(p, q.tpl)) return '';  /* D470: a stick/trigger script */
      var ti = -1;
      T.forEach(function (x, i) { if (ti < 0 && x && x.id === q.tpl) ti = i; });
      if (ti < 0) return '';
      return '<button type="button" class="btn saquick" data-quick="' + ti + '" id="sa-quick-' + q.tpl + '">' +
        (q.svg || sicon(q.ico)) + '<b>' + esc(q.n) + '</b></button>';
    }).join('');
    return tiles ? '<div class="saquickrow" id="sa-quick">' + tiles + '</div>' : '';
  }
  function roomTopHTML(p, sc) {
    var big = function (id, cls, icon, title, sub) {
      return '<button type="button" class="btn ' + cls + '" id="' + id + '">' + sicon(icon) +
        '<span class="satopt"><b>' + esc(title) + '</b><em>' + esc(sub) + '</em></span></button>';
    };
    var h = '<div class="saroomtop" id="sa-top">' +
      (workshopOffered(p) ? big('sa-recoil', 'satop1', 'tools', 'Anti-Recoil Lab',
        'Trace a gun’s recoil and cancel it out') : '') +
      (sc ? quickTilesHTML(p) : '') +
      big('sa-readymade', 'satop2 sashine' + (SWEPT ? '' : ' sasweep'), 'package', 'Paste ready-made script', 'Pick one that is already built') +
      /* owner 2026-10-17: say what recording does */
      big('sa-record-seq', 'sarec', 'record', 'Record script', 'Records your buttons and sticks to make your own script') +
      '</div>';
    SWEPT = true;
    return h;
  }
  /* the sheen's one pass of light: once a page load, not on every redraw */
  var SWEPT = false;
  /* Choose the button, then build: the flow New Smart Action starts. The
     row is the button's own (or a stub for a control nothing is bound to
     yet, exactly as Add a button makes one), and the draft is a fresh seed
     even when that button already runs a sequence, because the player
     asked for a NEW one. Nothing is written until the first edit in the
     editor (smartSave), so backing out of it leaves the config as it was. */
  function newSmartAction(root, p, S) {
    /* D128: in a config with a mouse the picker is the mouse, the keyboard,
       then the controller buttons with what each is bound to (sa-mnk.js) */
    var pickKind = window.ZS_SA_MNK ? ZS_SA_MNK.pickKind(p) : ZS.srcPickKind(p);
    ZS.pickButton({ kind: pickKind, p: p, capture: true, page: 'Controller',
                    title: S.scope ? (S.scope.pickTitle || 'Which button starts it on the ' + S.scope.title + '?')
                                   : 'Which button starts it?' })
      .then(function (v) {
        if (!v || !v.source) return;
        var row = rowFor(p, S, v.source);
        if (!row) {
          row = { source: v.source, actSrc: v.source, neutral: '', defTarget: '',
                  kind: srcClass(v.source), seeded: false, binds: [], plainBind: null,
                  chordBinds: [], acts: [], orphan: false };
          S.pendingRow = row;
        }
        S.inputSrc = row.source;
        S.screen = 'input';
        S.step = null; S.sel = null; S.page = 0; S.xf = null;
        smartSeed(p, S, row);
        /* D128: what was picked is what starts it (RT is rt, A follows the
           key bound to it); the box stays EMPTY (owner, 2026-10-07) — the
           steps are the ones the player taps */
        if (window.ZS_SA_MNK) ZS_SA_MNK.seed(p, v, S.draft, { empty: true });
        S.mode = 'smart';
        S.unsaved = false;
        /* the player ASKED for this one, so its Done adds it even untouched
           (D127): the seed in the box is what they were shown, and Done
           used to leave it unwritten and flip the panel to the button's
           plain mapping, which read as "it was not added" */
        S.fresh = true;
        draw(root, p);
      });
  }

  /* D281: the Scripts list's fold, remembered per viewer. Storage can be
     missing or throw (a private window, blocked site data); then the list
     is simply open, and a fold lasts until the page is drawn again. */
  var FOLD_KEY = 'zs.scriptsListFolded';
  function smartListFolded() {
    try { return window.localStorage.getItem(FOLD_KEY) === '1'; } catch (x) { return false; }
  }
  function smartListFold(folded) {
    try { window.localStorage.setItem(FOLD_KEY, folded ? '1' : '0'); } catch (x) {}
  }

  /* what the other parts use from this one */
  SEC.smartListFolded = smartListFolded;
  SEC.smartListFold = smartListFold;
  SEC.newSmartAction = newSmartAction;
  SEC.smartMapHTML = smartMapHTML;
  SEC.QUICK = QUICK;
});
