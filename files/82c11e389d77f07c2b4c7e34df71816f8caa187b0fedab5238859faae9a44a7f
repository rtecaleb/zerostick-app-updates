      tracks: [{ el: el, frame: f }] });
    cur.spring.to(100);
  }

  /* leave: the same path back into the control, then gone */
  function dismiss(markRest) {
    if (!cur) { return; }
    var c = cur;
    cur = null;
    if (markRest !== false) {
      for (var i = 0; i < c.list.length; i++) { TIPS().markSeen(c.list[i].tip.id); }
    }
    var gone = function () {
      if (c.el && c.el.parentNode) { c.el.parentNode.removeChild(c.el); }
      if (c.ring && c.ring.parentNode) { c.ring.parentNode.removeChild(c.ring); }
    };
    if (c.ring) { c.ring.style.opacity = '0'; }
    if (c.spring && !reducedMotion()) {
      c.spring.to(0, { onRest: gone });
      setTimeout(gone, 900);              /* belt and braces */
    } else { gone(); }
  }

  function next() {
    if (!cur) { return; }
    if (cur.i >= cur.list.length - 1) { dismiss(); return; }
    cur.i++;
    drawStep(false);
  }

  /* ── when to look ─────────────────────────────────────────────────── */
  var timer = 0, mo = null, running = false;
  function check() {
    timer = 0;
    if (!running) { return; }
    var screens = screensNow();
    if (cur) {
