      if (screens.indexOf(cur.screen) < 0) { dismiss(); }
      else { place(); }
      return;
    }
    if (!screens.length || busy()) { return; }
    var list = TIPS().pick(T().tips || [], screens, where);
    if (!list.length) { return; }
