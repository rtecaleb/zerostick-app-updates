    var s = document.createElement('style');
    s.id = 'zs-onb-css';
    s.textContent =
      '.onb-layer{position:absolute;inset:0;z-index:46;pointer-events:none}' +
      '.onb-ring{position:absolute;border-radius:14px;box-shadow:0 0 0 2px var(--accent),0 0 0 6px var(--zs-ion-wash,rgba(111,155,255,.13));' +
        'pointer-events:none;transition:opacity var(--t-calm,260ms) var(--ease-settle,ease)}' +
      '.onb-tip{position:absolute;left:16px;right:16px;max-width:360px;margin:0 auto;box-sizing:border-box;pointer-events:auto;' +
        'padding:14px 16px 12px;border-radius:18px;color:var(--text);' +
        'background:linear-gradient(180deg,var(--mat-sheet-a,rgba(23,31,43,.92)),var(--mat-sheet-b,rgba(15,21,30,.96)));' +
        '-webkit-backdrop-filter:var(--mat-thin);backdrop-filter:var(--mat-thin);' +
        'border:1px solid var(--mat-rim,rgba(255,255,255,.09));box-shadow:var(--el-3),var(--edge-lit);' +
        'will-change:transform,opacity}' +
      '.onb-tip .onb-arrow{position:absolute;width:14px;height:14px;transform:rotate(45deg);' +
        'background:var(--mat-sheet-a,rgba(23,31,43,.92));border:1px solid var(--mat-rim,rgba(255,255,255,.09))}' +
      '.onb-tip.below .onb-arrow{top:-8px;border-right:0;border-bottom:0}' +
      '.onb-tip.above .onb-arrow{bottom:-8px;border-left:0;border-top:0;background:var(--mat-sheet-b,rgba(15,21,30,.96))}' +
      '.onb-tip.centre .onb-arrow,.onb-tip.over .onb-arrow{display:none}' +
      '.onb-k{display:flex;align-items:center;gap:8px;margin:0 0 4px;font-size:11px;font-weight:600;' +
        'letter-spacing:var(--tr-label,.085em);text-transform:uppercase;color:var(--accent)}' +
      '.onb-k .onb-n{margin-left:auto;color:var(--muted);letter-spacing:var(--tr-caption,.004em);text-transform:none;' +
        'font-variant-numeric:tabular-nums}' +
      '.onb-t{margin:0 0 2px;font-size:16px;font-weight:650;letter-spacing:var(--tr-title,-.016em);line-height:var(--lh-title,1.24)}' +
      '.onb-p{margin:0;font-size:14px;line-height:1.45;letter-spacing:var(--tr-caption,.004em);color:var(--zs-ink-2,var(--text))}' +
      '.onb-keys{display:flex;gap:8px;justify-content:flex-end;margin-top:10px}' +
      '.onb-keys button{min-height:44px;min-width:88px;padding:0 16px;border-radius:12px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}' +
      '.onb-keys .onb-go{background:var(--accent);color:var(--accent-ink);border:0}' +
      '.onb-keys .onb-skip{background:transparent;color:var(--text);border:1px solid var(--zs-edge,var(--line))}' +
      '.onb-keys button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}' +
      '@media (prefers-reduced-transparency:reduce){.onb-tip{-webkit-backdrop-filter:none;backdrop-filter:none;background:var(--panel)}}' +
      '@media (prefers-contrast:more){.onb-tip{border:2px solid var(--text)}}' +
      'body.a11y-contrast .onb-tip{border:2px solid var(--text);background:var(--panel)}' +
      /* the video sheet */
      '.onb-v{display:flex;flex-direction:column;gap:12px}' +
      '.onb-v p{margin:0;font-size:14px;line-height:1.5;color:var(--zs-ink-2,var(--text))}' +
      '.onb-v .onb-small{font-size:12px;color:var(--muted)}' +
      '.onb-v .btn{min-height:48px;width:100%}' +
      '.onb-frame{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000}' +
      '.onb-frame video,.onb-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#000}' +
      '.onb-soon{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;' +
        'padding:22px 18px;border-radius:14px;border:1px solid var(--mat-rim,rgba(255,255,255,.09));' +
        'background:linear-gradient(180deg,var(--zs-ion-wash,rgba(111,155,255,.13)),transparent)}' +
      '.onb-soon b{font-size:17px;letter-spacing:var(--tr-title,-.016em)}' +
      '.onb-soon svg{color:var(--accent)}';
    document.head.appendChild(s);
  }

  /* ── which screen is open ─────────────────────────────────────────── */
  var ROOM = { overview: 'device', aim: 'aim', bindings: 'mappings', auto: 'ai-scripts',
    autogreen: 'auto-green', 'new': 'new-config' };
  function scriptEditorUp() {
    if (!isOpen('sheetwrap')) { return null; }
    var sb = $('sheetbody');
    return sb ? sb.querySelector('[data-tip="script-editor"], #sa-edit') : null;
  }
  function screensNow() {
    if (scriptEditorUp()) { return ['script-editor']; }
    if (isOpen('sheetwrap')) { return []; }
    if (isOpen('detail')) {
      var body = $('dbody'), out = [];
      var ns = body ? String(body.getAttribute('data-ns') || '') : '';
      var room = ns.slice(ns.indexOf('/') + 1);
      if (ROOM[room]) { out.push(ROOM[room]); }
      if (body && body.querySelector('[data-tip="game-settings"], [data-gskind]')) { out.push('game-settings'); }
      return out;
    }
    if (isOpen('editor')) { return []; }
    return $('hsart') ? ['home'] : [];
  }

  /* ── "not now": a gameplay-critical moment or something in front ──── */
  function busy() {
    var z = Z();
    if (document.hidden) { return 'hidden'; }
    if (videoPending) { return 'video'; }
    var gate = $('blegate');
    if (gate && !gate.hidden) { return 'gate'; }
    var L = window.ZSLEGAL;
    if (L) {
      try {
        if ((L.isOpen && L.isOpen()) || (L.isWaiting && L.isWaiting())) { return 'terms'; }
      } catch (e) { return 'terms'; }
    }
    if (typeof z.savesPending === 'function' && z.savesPending()) { return 'saving'; }
    var cal = $('hscal');
    if (cal && !cal.hidden) { return 'calibrating'; }
    if (autoGreenRunning()) { return 'auto-green'; }
    return '';
  }
  function autoGreenRunning() {
    var z = Z();
    if (!z.live || z.live.online === false || !z.live.full) { return false; }
    var f = z.live.full[z.activeId];
    return !!(f && f.autoGreen && f.autoGreen.enabled === true);
  }

  /* ── where a tip's control is ─────────────────────────────────────── */
  function screenEl() { return document.querySelector('.screen'); }
  function anchorOf(tip) {
    var list = tip.anchor || [];
    for (var i = 0; i < list.length; i++) {
      var el = null;
      try { el = document.querySelector(list[i]); } catch (e) { el = null; }
      if (el && !(el.closest && el.closest('[inert],[hidden],[aria-hidden="true"]'))) { return el; }
    }
    return null;
  }
