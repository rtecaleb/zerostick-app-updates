/* onboarding/onboarding.js — the tips and the setup video (D481).
 *
 * Loaded by onboarding/boot.js, never by phone.html directly, and only once
 * tips are on or the video is wanted. The words are onboarding-text.js
 * (window.ZS_ONBOARDING_TEXT); this file has none of its own.
 *
 * THE TIPS. Which screen is open is read from the app's own panels, never
 * from a hook in every screen:
 *   home            HOME, nothing over it
 *   device / aim / mappings / ai-scripts / auto-green / new-config
 *                   the detail panel, by #dbody's data-ns room id
 *   game-settings   any detail screen showing the in-game settings form
 *   script-editor   the sheet, while it holds the Scripts editor
 * One MutationObserver on those few nodes (class / data-ns / their direct
 * children) and a scroll listener: a check runs 700 ms after things settle.
 *
 * A TIP NEVER GETS IN THE WAY. It is a small glass callout with a ring on
 * the control it is about; there is no scrim and nothing behind it is
 * blocked. A tap anywhere outside it dismisses it (and still does what the
 * tap was for), as do Escape, the back key, and leaving the screen. It is
 * marked seen when it shows, so it is never shown twice. It does not show:
 *   - while a sheet, the Terms or the connect gate is up (except the
 *     Scripts editor's own sheet, which is its screen);
 *   - while a save is in flight (ZS.savesPending);
 *   - while Auto green is running on the playing config, or a calibration
 *     is running on the Core (HOME's #hscal line);
 *   - while the video offer is waiting to be answered.
 *
 * MOTION: one spring (ZSM, the `ui` preset: no overshoot) grows the callout
 * out from the control it points at; Reduce Motion (the system's or the
 * app's) shows it at once. Accessibility: role="dialog" (not modal), the
 * text is its description, the first button takes focus so a keyboard or a
 * controller's Navigate mode reaches it, every button is 44 px tall.
 *
 * ES5 only (DESIGN.md). Tests: tools/test-onboarding.js.
 */
(function () {
  'use strict';

  var SETTLE_MS = 700;
  var T = function () { return window.ZS_ONBOARDING_TEXT || { tips: [], video: {}, buttons: {} }; };
  var Z = function () { return window.ZS || {}; };
  var TIPS = function () { return window.ZSTIPS; };

  function $(id) { return document.getElementById(id); }
  function isOpen(id) { var e = $(id); return !!(e && e.classList && e.classList.contains('open')); }
