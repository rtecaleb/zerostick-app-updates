    var dir = cls === 'above' ? 1 : -1;
    return function (v) {
      var k = v / 100;
      return { transform: 'translateY(' + (dir * 6 * (1 - k)).toFixed(2) + 'px) scale(' + (0.92 + 0.08 * k).toFixed(4) + ')',
