  }
  function offerVideo() {
    var z = Z(), V = T().video || {};
    if (!z.sheetOpen) { return; }
    css();
    if (cur) { dismiss(false); }
    TIPS().markVideoOffered();            /* once, whatever is tapped */
    videoPending = true;
    var h = '<div class="onb-v" id="onb-offer">' +
      '<div class="onb-soon" aria-hidden="true">' + playSVG(44) + '</div>' +
      '<p>' + esc(V.offerText) + '</p>' +
      '<button type="button" class="btn primary" id="onb-watch">' + esc(V.watch) + '</button>' +
      '<button type="button" class="btn ghost" id="onb-skipv">' + esc(V.skip) + '</button>' +
      '<p class="onb-small">' + esc(V.later) + '</p></div>';
    var host = z.sheetOpen(V.offerTitle || 'Setup video', h, function () {
      videoPending = false;
