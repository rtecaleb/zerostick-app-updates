    if (!first) { return; }
    if (reducedMotion() || !window.ZSM || !window.ZSM.spring) {
      el.style.opacity = '1'; el.style.transform = 'none';
      return;
    }
    var cls = el.classList.contains('above') ? 'above' : 'below';
    var P = window.ZSM.PRESET.ui;
    var f = frameFor(cls), z = f(0);
    el.style.transform = z.transform; el.style.opacity = z.opacity;
    cur.spring = window.ZSM.spring({ from: 0, to: 0, damping: P.damping, response: P.response,
