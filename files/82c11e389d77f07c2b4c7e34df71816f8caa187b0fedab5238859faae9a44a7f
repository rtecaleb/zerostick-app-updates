    if (!el || !scr || !el.getBoundingClientRect) { return false; }
    var r = el.getBoundingClientRect(), s = scr.getBoundingClientRect();
    if (!(r.width > 0 && r.height > 0)) { return false; }
    /* most of it on screen, clear of the app bar and the foot */
    var bar = el.closest && el.closest('.appbar,.phead');
    var top = Math.max(r.top, s.top + (bar ? 0 : 56)), bot = Math.min(r.bottom, s.bottom - 24);
    return (bot - top) >= Math.min(40, r.height * 0.6);
  }
  function where(tip) {
    var el = anchorOf(tip);
    if (!el) { return 'none'; }
    return visibleIn(el) ? 'shown' : 'away';
  }

  /* ── the callout ─────────────────────────────────────────────────── */
  var cur = null;     /* { list, i, el, ring, spring, anchor, screen } */
  var layer = null;
  function ensureLayer() {
    var scr = screenEl();
    if (!scr) { return null; }
    if (!layer || layer.parentNode !== scr) {
      layer = document.createElement('div');
      layer.className = 'onb-layer';
      layer.id = 'onb-layer';
      scr.appendChild(layer);
    }
    return layer;
  }

  function show(list, screen) {
    css();
    if (!ensureLayer()) { return; }
    cur = { list: list, i: 0, screen: screen, el: null, ring: null, spring: null, anchor: null };
    drawStep(true);
  }

  function drawStep(first) {
    var step = cur.list[cur.i], tip = step.tip, B = T().buttons || {};
    TIPS().markSeen(tip.id);          /* shown = seen: never twice */
    var n = cur.list.length, last = cur.i === n - 1;
    var el = cur.el;
    if (!el) {
      el = cur.el = document.createElement('div');
      el.className = 'onb-tip';
      el.setAttribute('role', 'dialog');
      el.setAttribute('aria-modal', 'false');
      layer.appendChild(el);
    }
    el.setAttribute('aria-labelledby', 'onb-t');
    el.setAttribute('aria-describedby', 'onb-p');
    el.setAttribute('data-tip-id', tip.id);
    el.innerHTML = '<span class="onb-arrow" aria-hidden="true"></span>' +
      '<div class="onb-k"><span>Tip</span>' + (n > 1 ? '<span class="onb-n">' + (cur.i + 1) + ' of ' + n + '</span>' : '') + '</div>' +
      '<h3 class="onb-t" id="onb-t">' + esc(tip.title || '') + '</h3>' +
      '<p class="onb-p" id="onb-p">' + esc(tip.text) + '</p>' +
      '<div class="onb-keys">' +
        (last ? '' : '<button type="button" class="onb-skip" data-onb="skip">' + esc(B.gotIt || 'Got it') + '</button>') +
        '<button type="button" class="onb-go" data-onb="' + (last ? 'done' : 'next') + '">' +
          esc(last ? (B.gotIt || 'Got it') : (B.next || 'Next')) + '</button>' +
      '</div>';
    if (window.ZSM && window.ZSM.pressable) {
      el.querySelectorAll('button').forEach(function (b) { window.ZSM.pressable(b); });
    }
    cur.anchor = step.at === 'anchor' ? anchorOf(tip) : null;
    place();
    enter(first);
    var go = el.querySelector('.onb-go');
    if (go) { try { go.focus({ preventScroll: true }); } catch (e) { /* courtesy */ } }
  }

  function place() {
    if (!cur || !cur.el) { return; }
    var scr = screenEl(), el = cur.el, s = scr.getBoundingClientRect();
    var a = cur.anchor && cur.anchor.isConnected !== false ? cur.anchor : null;
    if (a && !visibleIn(a)) { a = null; }
    el.classList.remove('below', 'above', 'centre', 'over');
    el.style.top = '';
    var h = el.offsetHeight || 150, gap = 14;
    if (!a) {
      el.classList.add('centre');
      el.style.top = Math.max(70, Math.round((s.height - h) / 2)) + 'px';
      ring(null);
      el.style.transformOrigin = '50% 50%';
      return;
    }
    var r = a.getBoundingClientRect();
    var top = r.top - s.top, bot = r.bottom - s.top, mid = r.left - s.left + r.width / 2;
    var y, cls;
    if (s.height - bot - 24 >= h + gap) { cls = 'below'; y = bot + gap; }
    else if (top - 56 >= h + gap) { cls = 'above'; y = top - gap - h; }
    else { cls = 'over'; y = Math.max(64, Math.min(bot - h - 12, s.height - h - 24)); }
    el.classList.add(cls);
    el.style.top = Math.round(y) + 'px';
    var box = el.getBoundingClientRect(), ax = Math.max(18, Math.min(box.width - 32, mid - (box.left - s.left) - 7));
    var arrow = el.querySelector('.onb-arrow');
    if (arrow) { arrow.style.left = Math.round(ax) + 'px'; }
    el.style.transformOrigin = Math.round(ax + 7) + 'px ' + (cls === 'above' ? '100%' : '0');
    ring(r, s);
  }

  function ring(r, s) {
    if (!r) { if (cur.ring) { cur.ring.style.opacity = '0'; } return; }
    if (!cur.ring) {
      cur.ring = document.createElement('div');
      cur.ring.className = 'onb-ring';
      cur.ring.setAttribute('aria-hidden', 'true');
      layer.insertBefore(cur.ring, layer.firstChild);
    }
