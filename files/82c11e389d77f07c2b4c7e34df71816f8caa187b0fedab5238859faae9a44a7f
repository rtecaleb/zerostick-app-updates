    st.top = Math.round(r.top - s.top - p) + 'px';
    st.width = Math.round(r.width + p * 2) + 'px';
    st.height = Math.round(r.height + p * 2) + 'px';
  }

  /* grow out of the control (spatial consistency): scale .92 -> 1 and a
     6 px travel from its side, opacity with it. Critically damped. */
