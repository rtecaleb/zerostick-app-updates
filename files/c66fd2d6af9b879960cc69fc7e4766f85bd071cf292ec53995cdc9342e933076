/* shell/15-configs-api.js — new configs, and window.ZS.
 *
 * The config list behind an open panel, a new config's document
 * (newConfigDoc: a game pack's or scratch, D115/D120), addProfile (save,
 * then activate), and window.ZS: the API every other file uses.
 *
 * PART OF THE APP SHELL: phone.html's one inline script until 2026-10-02,
 * now these consecutive files, loaded where it was. They are CLASSIC
 * scripts, as it was: every top-level function and var is a global the
 * other files (and devbar.js, sections/, smart-actions/) call by name, and
 * nothing here may use, while loading, a name a LATER shell file declares
 * (calls made after the page has loaded are fine). phone.html lists them.
 */
  /* ── the config list behind an open panel ──────────────────────────
     Since 2026-08-16 HOME is not the only screen that draws PROFILES: the
     Configs screen (R.profiles) draws the whole list, and it lives in #dbody.
     renderHomeIfVisible() deliberately returns early while a panel is open —
     right for the 8 s status tick, because a list must never churn under a
     finger, and WRONG for the one event that REPLACES the array underneath
     it: the reconnect poll's loadLive() empties PROFILES and refills it from
     the board (line ~1170). An app that booted before the board answered was
     therefore left offering the four built-in preview configs forever, and
     tapping one set activeId to an id the board has never heard of — after
     which prof(activeId) is undefined and EVERY renderHome() throws on
     .color, taking the poll's flushPendingBinds() and "Board found" with it.

     So the list gets told — and ONLY when its IDENTITY changed. Same configs
     in the same order (every ordinary status tick) redraws nothing, so the
     poll trap stays shut: no scroll jump, no lost Reorder mode, no flicker. */
  var listWatcher = null;             /* R.profiles' draw(), while it is on screen */
  /* JSON rather than a join: quoted and comma-separated, ['a','bc'] can never
     read as the same list as ['ab','c'], whatever a config is called */
  function profileSig(){
    return JSON.stringify(PROFILES.map(function(p){ return p.id; }));
  }
  var listSig = profileSig();
  function noteProfileList(){ listSig = profileSig(); }
  function syncProfileList(){
    if(profileSig() === listSig) return;
    noteProfileList();
    if(typeof listWatcher !== 'function') return;
    /* The watcher writes into #dbody, which every detail screen shares, so it
       may only run while #dbody really IS the Configs screen. Without this an
       old closure would repaint somebody else's screen the moment a config
       was added from anywhere in the app. */
    if(!document.getElementById('detail').classList.contains('open')) return;
    if(document.getElementById('dbody').dataset.ns !== 'global/profiles') return;
    listWatcher();
  }

  function renderHomeIfVisible(){
    /* before the early return: the panel covering HOME may be the Configs
       screen, and it is exactly the reconnect tick that replaces the list */
    syncProfileList();
    if(!document.getElementById('editor').classList.contains('open') &&
       !document.getElementById('detail').classList.contains('open')) renderHome();
  }

  /* ── a new config's document ──────────────────────────────────────
     Clone a config the board already accepted, as the template, so the
     document validates; then the wizard's choices; then the game pack's turn
     (pr.prepare, D115). Returns null when there is no board document to
     clone. `small` is the object the list will keep, handed to prepare so a
     Smart Action built for the new config resolves against the new config. */
  function newConfigDoc(pr, small){
    var ids = Object.keys(LIVE.full);
    if(!ids.length) return null;
    var tpl = LIVE.full['default'] || LIVE.full[ids[0]];
    var full = JSON.parse(JSON.stringify(tpl));
    full.id = pr.id; full.name = pr.name;
    full.console = pr.platform;
    /* D470 rule B: a Native Mouse & Keyboard config (pr.native, the wizard's
       red answer) never touches the controller side: its inputType (and
       inputAuto, sticks, rate, Turn assist below) stay the template's */
    if(!pr.native) full.inputType = pr.input;
    else if(small && typeof full.inputType === 'string') small.input = full.inputType;
    /* D470: Native Mouse & Keyboard is the new config's own choice (the
       wizard's prepare turns it on); the template's flag and tune are the
       template's, never cloned into a config made from it */
    delete full.nativeKbm; delete full.nativeKbmTune;
    /* the game chosen in the wizard — a one-way latch the BOARD enforces
       from here on (schema v9). '' is an honestly gameless config. The
       template clone could otherwise carry the template's own game. */
    full.game = pr.game || '';
    /* nor may it carry the template's game PACK: that is how the app tells a
       config made from a pack from one started from scratch (D115) */
    delete full.gamePack;
    full.description = 'Created from the phone app';
    /* WHERE IT PLAYS is two fields and one decision, exactly as the
       Connection Method panel writes them (setPlayFrom): the console, above,
       and the output backend. The wizard offers the panel's own rows. */
    if(pr.backend){
      if(!full.output) full.output = {};
      full.output.backend = pr.backend;
    }
    /* A NEW controller config starts NATIVE. A beginner should begin at
       something that already feels right — their own pad, 1:1 — and tune
       AWAY from it, rather than starting at an arbitrary curve+deadzone
       and having no idea what "normal" was. It is only applied here, on
       creation: the schema default stays "tuned" so that migrating the
       configs already on the board cannot change how they feel.
       A mouse config is left alone — a mouse has no native stick position
       to be 1:1 with, so "native" would be a meaningless word there. */
    /* Asked as "does this config have a pad?", not "is it the controller
       type?" — a Joystick + Mouse config has a real stick in a real hand,
       so it deserves the same honest 1:1 starting point. Only a config
       with no stick at all is left alone. */
    /* D241 (owner, 2026-10-09: "thumbstick should be on Native by
       default"): EVERY new config starts Native - its input is detected now
       (D237) and can become a pad config later, so a mouse config made today
       must not carry the schema's tuned default into a stick tomorrow */
    if(!pr.native){
      if(!full.stick) full.stick = {};
      full.stick.mode = 'native';
      if(typeof full.stick.restZone !== 'number') full.stick.restZone = 0.05;
      if(!full.curves) full.curves = {};
      ['leftStick','rightStick'].forEach(function(side){
        if(!full.curves[side]) full.curves[side] = {type:'linear', strength:1.0, points:[]};
        full.curves[side].gain = 1.0;   /* 100% == exactly the pad */
      });
    }
    /* the game pack goes LAST, so a pack that calibrated the stick wins over
       the native start above; a pack that did not leaves it alone */
    var tplRate = full.output ? full.output.rateHz : undefined;
    if(typeof pr.prepare === 'function') pr.prepare(full, small || pr);
    /* D392: a new MOUSE config runs at 1000 Hz: every count reaches the
       console fresher and a stop lands in 1 ms (docs/MOUSE-AUDIT.md
       "after"). Only over the template's own rate (a pack that recommends
       a rate keeps it), and only from the old 250 default or none. The
       console still reads at its own pace; this never makes it read faster. */
    if(!pr.native && inputShows(pr.input, 'mouse')){
      if(!full.output) full.output = {};
      var r = full.output.rateHz;
      if(r === tplRate && (r === undefined || r === null || r === 250)) full.output.rateHz = 1000;
      /* D392: Fine aim starts OFF on a game with a measured translator (a
         pack's measured model): there every move already turns exactly as
         far as the hand, and Fine aim bends that. The template's own Fine
         aim would otherwise ride into the new config. */
      var rm = full.mouseTranslation && full.mouseTranslation.resolvedAimModel;
      if(rm && typeof rm === 'object' && rm.generic !== true && rm.needsCalibration === false){
        full.mouseTranslation.fineAim = 0;
        delete full.mouseTranslation.adsFineAim;
      }
    }
    /* D280/D291: a mouse config starts with Turn assist on keyboard X
       (whatever X did here moves off it, kept, D291; a template still on the old
       shipped layout gets the new one first), after the pack so the X it
       checks is the pack's. The template's "already offered" mark is the
       template's, not the new config's: a copy it carries is kept (and not
       doubled), and nothing else stops the new config's own turn. */
    if(!pr.native){
      delete full.turnAssistOffered;
      if(window.ZS_SMART && typeof ZS_SMART.seedTurnAssist === 'function')
        ZS_SMART.seedTurnAssist(small || pr, full, {fresh:true});
    }
    /* THE PLAYER'S COLOUR IS THE LAST WORD (D120). The wizard's choice goes
       into lighting.color, the field the adapter itself reads (on a Core,
       the D103 LIGHTING section its onboard light shows), not only into the
       list mark. After the pack's turn, so no pack can
       overrule a choice the player just made (a pack cannot carry lighting
       today, and this makes that a rule rather than a coincidence). It is a
       solid colour because a colour was chosen; brightness and speed are
       the template's, exactly as Overview's carousel keeps them. */
    var hex = String(pr.color == null ? '' : pr.color).replace('#','').toLowerCase();
    if(/^[0-9a-f]{6}$/.test(hex)){
      var lg = (full.lighting && typeof full.lighting === 'object') ? full.lighting : {};
      full.lighting = { mode:'solid', color:hex,
        brightness: Math.round(typeof lg.brightness==='number' ? lg.brightness : 100),
        speed: Math.round(typeof lg.speed==='number' ? lg.speed : 20) };
    }
    return full;
  }
  /* A game pack's picture only counts once it has loaded (game-packs.js), and
     that lands after HOME's first paint. One repaint of HOME then, through
     the same gate the poll uses, so a panel the player is reading is never
     redrawn under them. */
  if(window.ZSPACKS) ZSPACKS.onChange(function(kind){
    /* 'packs' too (D300 amended): a config known only by its game's name
       learns whether that game is Coming soon when the list lands */
    if(kind==='art' || kind==='packs') renderHomeIfVisible();
  });

  /* ── API for phone-sections.js ─────────────────────────────────── */
  /* M9 (audit 2026-10-10): a new config's document, saved the way an edit
     is (saveToCore, D103): a Core gets the bytes by id (create-or-replace,
     it has nothing to POST to), an EXO gets the JSON POST. */
  function createProfileDoc(doc){
    return (productId() === 'core') ? saveToCore(doc.id, doc) : api('/profiles', 'POST', doc);
  }
  window.ZS = {
    esc: esc, prof: prof, CON: CON, INP: INP, PB: PB, PROFILES: PROFILES,
    /* the input-type vocabulary and the ONE gate rule, so phone-sections.js
       and smart-actions.js cannot grow a second copy that drifts */
    INPUT_TYPES: INPUT_TYPES, INP_SUB: INP_SUB,
    inputShows: inputShows, inputName: inputName,
    srcDeviceClass: srcDeviceClass, inputShowsSource: inputShowsSource,
    /* gateOK travels with gateText: no section in the five-screen menu carries
       a gate today, so the list-taking rule below has no live caller to prove
       it — and a rule with no caller is a rule that rots. tools/test-input-type.js
       asks it directly instead. */
    gateOK: gateOK, gateText: gateText, icoSVG: icoSVG,
    /* the product gate (D102): which adapter this is and what it lacks.
       phone-sections.js asks productHides() for the Remote Play row, the
       shot card and the delay sheet; PRODUCTS is exported for the test that
       pins the list to D102 */
    productId: productId, productHides: productHides, productName: productName,
    productShort: productShort, linkVia: linkVia, paintHomeGun: paintHomeGun,
    checkHomeCal: checkHomeCal,   /* D203: HOME's calibration-running line */
    paintHomeDev: paintHomeDev,   /* D194: the device card's live mode line */
    paintHomeNav: paintHomeNav,   /* D195: HOME's Navigate announcement */
    productBoard: productBoard, PRODUCTS: PRODUCTS,
    /* the icon pictures (D91): pic() the <img>, picSrc() its file, picHas()
       and picName() the truth tests, sicon() the step / editor mark with
       its si-<name> class; PIC / PIC_ALIAS for the test that pins them */
    pic: pic, picSrc: picSrc, picHas: picHas, picName: picName, sicon: sicon,
    mkbPicSrc: mkbPicSrc,   /* D290: the owner's mouse / keyboard pictures */
    PIC: PIC, PIC_ALIAS: PIC_ALIAS,
    api: api, live: LIVE, putProfile: putProfile, putProfileDebounced: putProfileDebounced,
    putProfileAuto: putProfileAuto,   /* D257: a Script's own write, saved at once */
    hasUnsaved: hasUnsaved, discardUnsaved: discardUnsaved,   /* D257 */
    saveStaged: saveStaged, stageProfile: stageProfile,
    /* M8: the one way a screen changes a config's settings: fn changes a
       clone, never the cached copy in place (staged under D257) */
    editProfile: editProfile,
    /* m2: re-read one config from the board THROUGH adoptBoard, so a
       board-side write (a calibration pack, a vision write) never hides
       the staged edits or moves the "exit without saving" base */
    reloadProfile: function(pid){
      return getProfileDoc(pid).then(function(f){
        if(f && f.ok && f.data) LIVE.full[pid] = adoptBoard(pid, f.data);
        return f;
      });
    },
    /* M5: leaving the editor (back key, delete) in one place */
    closeEditor: closeEditor,
    onStagedSettled: function(fn){ if(typeof fn === 'function') stagedHooks.push(fn); },   /* audit M16 */
    onBeforeCoreSave: onBeforeCoreSave,
    flushProfileWrites: flushProfileWrites,
    savesPending: savesPending,   /* D481: a save queued or in flight */
    refreshStatus: refreshStatus,
    /* D335 (Studio's A-2): a change made elsewhere (the phone, EXO Studio,
       the firmware's configRev or its "changed" push): re-read /status and
       the configs, keep this app's unsaved edits on top, repaint what is
       open. Resolves {ok, changed, ids}. EXO Studio calls it when present. */
    onExternalChange: function(reason){ return externalChange(reason || 'changed'); },
    /* Re-read the config list from the board. Exported so a screen that
       CREATES a config on the board (Overview → Paste config) can make the
       home list agree with the board without a page reload. */
    reloadProfiles: function(){
      return loadLive().then(function(ok){ if(ok) renderHome(); return ok; });
    },
    get activeId(){ return activeId; }, get editId(){ return editId; },
    /* Returns false if that config is not in the list. It can NEVER become the
       active one: renderHome() opens with prof(activeId).color, so accepting
       an id the list has dropped — loadLive() replaces PROFILES wholesale when
       the board answers — makes every draw from then on throw, including the
       one inside the 8 s poll, which takes flushPendingBinds() and the "Board
       found" toast down with it. The app wedges, silently. The caller gets the
       false so it can repaint whatever the list really holds now. */
    setActive: function(id){
      if(!prof(id)) return false;
      activeId = id; persist(); renderHome();
      seedTurnAssistForDevices();      /* D288: a keyboard may already be in */
      return true;
    },
    /* The Configs screen registers its draw() here: it paints the same array
       HOME does, from behind a panel the poll refuses to touch. See
       syncProfileList() — it fires ONLY when the list identity changes. */
    watchProfileList: function(fn){ listWatcher = fn; },
    noteProfileList: noteProfileList,
    /* THE NEW CONFIG'S DOCUMENT, in one place (D115), so the wizard's create
       and tools/test-game-packs.js build the very same thing. null when there
       is no board document to start from (offline preview). pr carries the
       wizard's choices; pr.prepare(full, small) is the game pack's turn. */
    newConfigDoc: newConfigDoc,
    /* M9 (audit 2026-10-10): the one way a NEW config's document reaches
       the adapter, shared by addProfile and Overview's Duplicate / Paste
       config, which POSTed JSON to /profiles and so failed on every Core.
       doc.id must be set; resolves with the save's answer. */
    createProfileDoc: createProfileDoc,
    addProfile: function(pr, done){
      /* the small object the list keeps: never the wizard's callback, which
         persist() would write to localStorage as nothing at all */
      var small = {id:pr.id, name:pr.name, platform:pr.platform, input:pr.input,
                   game:pr.game||'', pack:pr.pack||'', color:pr.color};
      /* The chosen colour is the list mark too, and it is remembered as one:
         profileColor() treats the shipped blue as "never chosen" and would
         otherwise hand a player who CHOSE blue a palette mark instead. The
         same three keys Overview's carousel writes (ovSetColor). */
      var chosenHex = String(pr.color == null ? '' : pr.color).replace('#','').toLowerCase();
      if(/^[0-9a-f]{6}$/.test(chosenHex)){
        STORE.vals['pcolor|'+pr.id] = '#'+chosenHex;
        STORE.vals['lightbar|'+pr.id] = chosenHex;
        STORE.vals['lightbarMode|'+pr.id] = 'solid';
      }
      /* live path: clone a full profile as the template so validation passes */
      if(LIVE.online!==false && Object.keys(LIVE.full).length){
        var full = newConfigDoc(pr, small);
        /* A new config is a save too, so it takes the same fork as an edit
           (saveToCore, above): a Core gets the bytes, an EXO gets the JSON
           POST it has always had. The binary route is a write by id, which
           is create-or-replace on a device that keeps numbered slots, so
           there is nothing for a Core to POST to. */
        var create = createProfileDoc(full);
        create.then(function(j){
          if(j.ok){
            LIVE.full[pr.id]=full;
            PROFILES.push(small); activeId=pr.id; persist(); renderHome();
            api('/profiles/'+encodeURIComponent(pr.id)+'/activate', 'POST', {});
            if(done) done(true);
          } else {
            /* saveToCore has already said the device's own sentence out
               loud; repeating a vaguer one on top would only bury it. */
            if(productId() !== 'core'){
              toast('Board rejected it'+((j.errors&&j.errors[0])?': '+j.errors[0]:''));
            }
            if(done) done(false);
          }
        });
        return;
      }
      PROFILES.push(small); activeId = pr.id; persist(); renderHome();
      if(done) done(true);
    },
    deleteProfile: function(id, done){
      var i=PROFILES.findIndex(function(p){return p.id===id;});
      if(i<0||PROFILES.length<=1){ if(done) done(false); return false; }
      function localDrop(){
        forgetConfigState(id);       /* M5: nothing queued may write it back */
        var j=PROFILES.findIndex(function(p){return p.id===id;});
        if(j>=0) PROFILES.splice(j,1);
        delete LIVE.full[id];
        delete LIVE.rowBytes[id];    /* its room on the Core is free again (D133) */
        forgetPhotoFor(id);          /* its picture lived in the app (D120) */
        forgetValuesFor(id);         /* and so did what its screens remember, GPC slots too */
        if(activeId===id) activeId=PROFILES[0].id;
        if(editId===id) closeEditor();   /* M5: never leave editId on a dead id */
        persist(); renderHome();
      }
      /* a config listed without a readable copy (D124) is on the board too */
      if(LIVE.online!==false && (LIVE.full[id] || (prof(id) && prof(id).unreadable))){
        api('/profiles/'+encodeURIComponent(id), 'DELETE').then(function(j){
          if(j.ok){ localDrop(); if(done) done(true); }
          else { toast('Board refused: '+(j.error||'delete failed')); if(done) done(false); }
        });
        return true;   /* async: caller gets the toast from done() */
      }
      localDrop(); if(done) done(true); return true;
    },
    saveProfiles: function(){
      persist(); renderHome();
      if(editId){ var p=prof(editId); if(p){ document.getElementById('edname').textContent=shownName(p.name);
        if(LIVE.online!==false && LIVE.full[p.id])
          putProfileDebounced(p.id, function(f){ f.name = p.name; });
      } }
    },
    /* config identity: the photo-or-mark tile, the family line, the picker */
    artHTML: artHTML, wireArt: wireArt, idLine: idLine, markKey: markKey, fitPic: fitPic,
    hasPhoto: hasPhoto, photoURL: photoURL, photoKind: photoKind, openPhotoSheet: openPhotoSheet,
    renderHome: renderHome, openEditor: openEditor, openDetail: openDetail,
    /* D124: does this Core hand a stored config back in pieces? The encoder
       writes the copy with picture references only then, and the Auto
       Actions tab's size line has to ask the same question a save does */
    coreReadsPieces: coreReadsPieces,
    /* D133: the connected Core's caps (ZSPROFILE.capsFrom of its /status),
       and the largest piece of a config it takes per PUT (0: one message).
       Every screen that sizes or checks a config for a Core asks these. */
    coreCaps: coreCaps, coreWriteChunk: coreWriteChunk,
    /* D127: fn(pid, sentence) when a config's save starts or stops being
       refused ('' once one lands); the sentence is LIVE.saveError[pid] */
    onSaveResult: function(fn){ if(typeof fn === 'function') saveHooks.push(fn); },
    redrawOpenScreen: redrawOpenScreen,
    sheetOpen: sheetOpen, sheetClose: sheetClose,
    /* kb() is the keyboard rule for anything tappable that is not a <button>:
       tabindex, role=button, Enter/Space. Exported so a screen in
       phone-sections.js reuses it rather than reimplementing it slightly
       differently — that is how a row ends up unreachable by keyboard. */
    wire: wire, kb: kb, toast: toast, hideToast: hideToast, setDetail: setDetail, applyAccess: applyAccess,
    /* Say something to a screen reader and to nobody else, through the live
       region the app ALREADY has: #swipehint, role=status aria-live=polite,
       visually-hidden — the channel a swipe uses for "went back". Exported
       rather than duplicated so a second, competing live region never appears
       (two polite regions on one screen is how announcements start stepping on
       each other). For outcomes that leave the screen looking identical: the
       Reorder arrows are the case — the button under your finger reads exactly
       the same before and after the config it moves has moved. A toast is the
       wrong tool there; it is visual noise for a fact only one reader needs. */
    announce: function(t){
      var l = document.getElementById('swipehint');
      if(l) l.textContent = String(t);
    },
    store: STORE, persistStore: persist, syncInert: syncInert,
    closeDetail: function(){ document.getElementById('detail').classList.remove('open'); syncInert(); }
  };

