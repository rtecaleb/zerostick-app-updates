/* mouse-dpi.js: the Mouse DPI flow (D183), ZS_DPI.
 *
 * A mouse config needs the mouse's real DPI (mouseTranslation.dpi): the
 * translator rescales counts to a 1000-DPI ruler with it, so Aim Speed means
 * the same on any mouse (D164). Most players do not know their number. This
 * sheet finds it, two ways, offered when a keyboard-and-mouse (or Joystick +
 * Mouse) config is made and from the Device page's Mouse DPI card (D289;
 * D375 took the Aim page's DPI row away, the card is the one home):
 *
 *   AUTOMATIC  (if you don't know your DPI)
 *     1. The Core looks at the mouse plugged into it (GET /mouse/info). A
 *        Logitech mouse that speaks HID++ 2.0 or a Razer mouse that answers
 *        its DPI command can be SET from here: presets 800 / 1600 / 3200 /
 *        6400 / 8000 / 12000 or any number in the mouse's own range, 3200
 *        picked and marked recommended (D186), Apply
 *        (POST /mouse/dpi), and the mouse reads it back. A ruler check is
 *        offered after.
 *     2. Any other mouse is MEASURED, the way the DPI-analyser web pages do:
 *        pick a reference (a 10 cm ruler, a credit card, or the player's own
 *        phone, by brand then model, its official height), watch the mouse
 *        slide from one end to the other in the drawing, then do it: Start,
 *        slide, Done (POST /mouse/measure). Two or three tries, averaged;
 *        the nearest common DPI when it is within 5%, the raw number beside.
 *   MANUAL
 *     Type the number.
 *
 * Under 3200 (or not known) is advice, never a block (D164's words; D186
 * the owner's sentence, ADVICE below: between 3200 and 12000, 3200
 * recommended). The wizard and the Translation tab's Calibrate card show
 * the same sentence through ZS_DPI.advice/wantsAdvice; the Device card's
 * picker shows its hint and, under 3200, LOW_NOTE.
 *
 * The Core does the USB and the counting (components/zs_mousedpi, D183);
 * this file draws and asks. ES5 only (DESIGN.md). Load after phone-sizes.js.
 */
(function () {
  'use strict';

  var POLL_MS = 150;
  var TRIES_WANT = 3;
  var TRIES_MAX = 6;
  var NEAR = 0.05;                       /* the Core's ZS_DPI_NEAR */
  var SPREAD_OK = 0.05;                  /* tries within 5% of each other */
  var LOW = 3200;
  var HIGH = 12000;
  var RECOMMENDED = 3200;
  var PRESETS = [800, 1600, 3200, 6400, 8000, 12000];
  var COMMON = [400, 500, 800, 1000, 1200, 1600, 2000, 2400, 3200, 4000, 4800, 5000, 6400,
    8000, 10000, 12000, 12800, 16000, 20000, 25600, 26000, 30000];
  var CARD_MM = 85.6;                    /* ISO/IEC 7810 ID-1 */
  var RULER_MM = 100;

  var supportKnown = null;               /* null unknown, false: a Core before D183 */
  var cssDone = false;

  function Z() { return window.ZS; }
  function esc(s) {
    var z = Z();
    if (z && z.esc) return z.esc(String(s == null ? '' : s));
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function num(v, d) { var n = Number(v); return isFinite(n) ? n : d; }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function isCore() {
    var z = Z();
    return !!(z && typeof z.productId === 'function' && z.productId() === 'core');
  }
  function fmt(n) {
    n = Math.round(num(n, 0));
    return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  /* ── the arithmetic (pinned by test-mouse-dpi.js) ─────────────────── */

  function estimate(counts, mm) {
    counts = num(counts, 0);
    mm = num(mm, 0);
    return mm > 0 ? counts / (mm / 25.4) : 0;
  }
  function roundCommon(dpi) {
    var best = COMMON[0], bd = Infinity, i;
    for (i = 0; i < COMMON.length; i++) {
      var d = Math.abs(dpi - COMMON[i]);
      if (d < bd) { bd = d; best = COMMON[i]; }
    }
    return { value: best, near: dpi > 0 && bd <= NEAR * best };
  }
  /* the tries that count: the Core saw real movement */
  function counted(trials) {
    return (trials || []).filter(function (t) { return t && t.enough !== false && num(t.dpi, 0) > 0; });
  }
  function summary(trials) {
    var ts = counted(trials), i, sum = 0, lo = Infinity, hi = 0;
    if (!ts.length) return null;
    for (i = 0; i < ts.length; i++) {
      var d = num(ts[i].dpi, 0);
      sum += d;
      if (d < lo) lo = d;
      if (d > hi) hi = d;
    }
    var raw = sum / ts.length;
    var rc = roundCommon(raw);
    return {
      n: ts.length,
      raw: raw,
      value: rc.near ? rc.value : Math.round(raw),
      near: rc.near,
      common: rc.value,
      spread: raw > 0 ? (hi - lo) / raw : 0,
      steady: raw > 0 ? (hi - lo) / raw <= SPREAD_OK : false
    };
  }
  function validDpi(v) {
    var n = parseInt(String(v == null ? '' : v).replace(/[^0-9]/g, ''), 10);
    return (n >= 100 && n <= 32000) ? n : 0;
  }

  /* ── the references ───────────────────────────────────────────────── */

  function phones() {
    var P = window.ZS_PHONE_SIZES;
    return (P && P.brands) ? P.brands : [];
  }
  function phoneBrand(id) {
    return phones().filter(function (b) { return b.id === id; })[0] || null;
  }
  function phoneModel(brandId, modelId) {
    var b = phoneBrand(brandId);
    return b ? (b.models.filter(function (m) { return m.id === modelId; })[0] || null) : null;
  }
  function refOf(kind, brandId, modelId) {
    if (kind === 'ruler') return { kind: 'ruler', mm: RULER_MM, name: 'a ruler', what: '10 cm on the ruler' };
    if (kind === 'card') return { kind: 'card', mm: CARD_MM, name: 'a bank card', what: 'the card’s long edge (85.6 mm)' };
    var m = phoneModel(brandId, modelId);
    if (!m) return null;
    return { kind: 'phone', mm: num(m.heightMm, 0), name: 'your ' + m.name, what: 'the long edge of your ' + m.name +
      ' (' + m.heightMm + ' mm)', brand: brandId, model: modelId, phone: m };
  }

  /* ── the drawings ─────────────────────────────────────────────────── */

  var X0 = 40, X1 = 280, LEN = X1 - X0;

  /* a computer mouse from above, nose up, its LEFT side lit: the side the
     player lines up with the start, and watches arrive at the end */
  function mouseSVG(cls, x, y) {
    return '<g class="' + cls + '"><g transform="translate(' + x + ' ' + y + ')">' +
      '<path class="dp-mbody" d="M19,0 C31,0 38,9 38,24 L38,44 C38,55 30,62 19,62 C8,62 0,55 0,44 L0,24 C0,9 7,0 19,0 Z"/>' +
      '<line class="dp-mline" x1="19" y1="1" x2="19" y2="22"/>' +
      '<rect class="dp-mwheel" x="16.5" y="6" width="5" height="10" rx="2.5"/>' +
      '<line class="dp-medge" x1="0.5" y1="20" x2="0.5" y2="46"/>' +
      '</g></g>';
  }
  function objectSVG(ref) {
    var h = '', top = 12, bot, i;
    if (ref.kind === 'ruler') {
      bot = top + 40;
      h += '<rect class="dp-obj" x="' + (X0 - 8) + '" y="' + top + '" width="' + (LEN + 16) + '" height="40" rx="3"/>';
      for (i = 0; i <= 100; i++) {
        var x = X0 + i * LEN / 100, len = i % 10 === 0 ? 15 : (i % 5 === 0 ? 10 : 6);
        h += '<line class="dp-tick" x1="' + x.toFixed(1) + '" y1="' + bot + '" x2="' + x.toFixed(1) + '" y2="' + (bot - len) + '"/>';
        if (i % 10 === 0) h += '<text class="dp-num" x="' + x.toFixed(1) + '" y="' + (top + 12) + '">' + (i / 10) + '</text>';
      }
    } else if (ref.kind === 'card') {
      var ch = Math.round(LEN * 53.98 / CARD_MM);
      bot = top + ch;
      h += '<rect class="dp-obj" x="' + X0 + '" y="' + top + '" width="' + LEN + '" height="' + ch + '" rx="11"/>' +
        '<rect class="dp-chip" x="' + (X0 + 22) + '" y="' + (top + 46) + '" width="34" height="26" rx="5"/>' +
        '<rect class="dp-bar" x="' + (X0 + 22) + '" y="' + (top + 92) + '" width="150" height="9" rx="4.5"/>' +
        '<rect class="dp-bar" x="' + (X0 + 22) + '" y="' + (top + 112) + '" width="80" height="7" rx="3.5"/>';
    } else {
      /* a phone lying on its side, back up: a plain rounded slab with a
         camera bump, no maker's marks (the owner's rule) */
      var ph = 112;
      bot = top + ph;
      h += '<rect class="dp-obj" x="' + X0 + '" y="' + top + '" width="' + LEN + '" height="' + ph + '" rx="20"/>' +
        '<rect class="dp-bump" x="' + (X0 + 12) + '" y="' + (top + 12) + '" width="48" height="48" rx="13"/>' +
        '<circle class="dp-lens" cx="' + (X0 + 26) + '" cy="' + (top + 26) + '" r="8"/>' +
        '<circle class="dp-lens" cx="' + (X0 + 46) + '" cy="' + (top + 26) + '" r="8"/>' +
        '<circle class="dp-lens" cx="' + (X0 + 26) + '" cy="' + (top + 46) + '" r="8"/>';
    }
    return { svg: h, bottom: bot };
  }
  /* the whole picture: the object, the start and end lines, the mouse.
     `mode` 'demo' loops the slide (a still start and end under Reduce
     Motion); 'live' leaves the mouse for liveMove() to place. */
  function sceneSVG(ref, mode) {
    var o = objectSVG(ref);
    var my = o.bottom + 8, vbH = my + 62 + 26;
    var label = 'Slide the mouse from the start line to the end line along ' + ref.what;
    return '<svg class="dp-scene dp-' + mode + '" viewBox="0 0 320 ' + vbH + '" role="img" aria-label="' + esc(label) + '">' +
      o.svg +
      '<line class="dp-guide" x1="' + X0 + '" y1="6" x2="' + X0 + '" y2="' + (my + 66) + '"/>' +
      '<line class="dp-guide" x1="' + X1 + '" y1="6" x2="' + X1 + '" y2="' + (my + 66) + '"/>' +
      '<text class="dp-lab" x="' + X0 + '" y="' + (vbH - 6) + '">start</text>' +
      '<text class="dp-lab" x="' + X1 + '" y="' + (vbH - 6) + '">end</text>' +
      (mode === 'demo' ? mouseSVG('dp-ghost', X1, my) +
        '<path class="dp-arrow" d="M' + (X0 + 50) + ',' + (my + 31) + ' L' + (X1 - 12) + ',' + (my + 31) + ' m-8,-6 l8,6 l-8,6"/>' : '') +
      mouseSVG('dp-m', X0, my) +
      '</svg>';
  }
  function refIcon(kind) {
    if (kind === 'ruler') {
      return '<svg viewBox="0 0 44 28" aria-hidden="true"><rect class="dp-obj" x="2" y="7" width="40" height="14" rx="2"/>' +
        '<path class="dp-tick" d="M6 21v-6M10 21v-3M14 21v-6M18 21v-3M22 21v-6M26 21v-3M30 21v-6M34 21v-3M38 21v-6"/></svg>';
    }
    if (kind === 'card') {
      return '<svg viewBox="0 0 44 28" aria-hidden="true"><rect class="dp-obj" x="4" y="3" width="36" height="23" rx="3"/>' +
        '<rect class="dp-chip" x="8" y="10" width="7" height="6" rx="1.5"/></svg>';
    }
    return '<svg viewBox="0 0 44 28" aria-hidden="true"><rect class="dp-obj" x="2" y="5" width="40" height="19" rx="5"/>' +
      '<rect class="dp-bump" x="5" y="8" width="9" height="9" rx="3"/></svg>';
  }

  /* ── the sheet ────────────────────────────────────────────────────── */

  function css() {
    if (cssDone || !document.head) return;
    cssDone = true;
    var s = document.createElement('style');
    s.id = 'dp-css';
    s.textContent =
      '.dp-q{font-size:17px;font-weight:600;letter-spacing:var(--tr-title,-.016em);margin:2px 0 6px}' +
      '.dp-h{font-size:13.5px;line-height:1.5;color:var(--muted);margin:0 0 12px}' +
      '.dp-choices{display:flex;flex-direction:column;gap:10px;margin:0 0 12px}' +
      '.dp-two{display:flex;gap:8px;margin-top:10px;width:100%}' +
      '.dp-two .btn{flex:1}' +
      '.dp-choice{display:block;width:100%;text-align:left;padding:14px 16px;border-radius:var(--r-card,14px);' +
        'background:var(--panel2);border:1.5px solid var(--line);color:var(--text);font:inherit;min-height:44px}' +
      '.dp-choice b{display:block;font-size:16px;font-weight:600}' +
      '.dp-choice span{display:block;font-size:13px;color:var(--muted);margin-top:2px}' +
      '.dp-choice[disabled]{opacity:.5}' +
      '.dp-list{border-radius:var(--r-card,14px);background:var(--panel2);overflow:hidden;margin:0 0 12px}' +
      '.dp-row{display:flex;align-items:center;gap:12px;width:100%;min-height:48px;padding:10px 14px;background:none;' +
        'border:0;border-bottom:1px solid var(--line);color:var(--text);font:inherit;text-align:left}' +
      '.dp-row:last-child{border-bottom:0}' +
      '.dp-row svg{flex:0 0 44px;height:28px}' +
      '.dp-row .dp-rt{flex:1}' +
      '.dp-row .dp-rt em{display:block;font-style:normal;font-size:12.5px;color:var(--muted)}' +
      '.dp-row .dp-rd{color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}' +
      '.dp-row .dp-chev{color:var(--muted);font-size:18px}' +
      '.dp-presets{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}' +
