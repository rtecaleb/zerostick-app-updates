      'body.a11y-motion .dp-demo .dp-ghost,body.a11y-motion .dp-demo .dp-arrow{display:inline}' +
      '.dp-fld .salab em{display:block;font-style:normal;font-size:12px;color:var(--muted);font-weight:400}' +
      /* D289: the shared picker - three presets a row, a quiet hint */
