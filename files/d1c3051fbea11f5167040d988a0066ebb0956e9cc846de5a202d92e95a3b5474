        'font-variant-numeric:tabular-nums;margin:4px 0 2px}' +
      '.dp-sub{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;margin:0 0 12px}' +
      '.dp-livebox{display:flex;justify-content:space-between;align-items:baseline;margin:0 0 10px;font-variant-numeric:tabular-nums}' +
      '.dp-livebox b{font-size:24px}' +
      '.dp-tries{list-style:none;padding:0;margin:0 0 10px;font-variant-numeric:tabular-nums}' +
      '.dp-tries li{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--line);font-size:14px}' +
      '.dp-tries li:last-child{border-bottom:0}' +
      '.dp-tries em{font-style:normal;color:var(--muted);font-size:12.5px}' +
      '.dp-steps{margin:0 0 12px;padding-left:20px;font-size:14px;line-height:1.5}' +
      '.dp-steps li{margin:0 0 4px}' +
      '.dp-scenebox{background:var(--panel2);border-radius:var(--r-card,14px);padding:8px;margin:0 0 12px}' +
      '.dp-scene{display:block;width:100%;height:auto}' +
      '.dp-obj{fill:var(--zs-raised,#1d2534);stroke:var(--muted);stroke-width:1.2}' +
      '.dp-tick{stroke:var(--muted);stroke-width:1;fill:none}' +
      '.dp-num{fill:var(--muted);font-size:9px;text-anchor:middle}' +
      '.dp-chip{fill:var(--amber,#e3b341);opacity:.55}' +
      '.dp-bar{fill:var(--muted);opacity:.35}' +
      '.dp-bump{fill:var(--zs-control,#27313f);stroke:var(--muted);stroke-width:1}' +
      '.dp-lens{fill:var(--bg,#06080c);stroke:var(--muted);stroke-width:1}' +
      '.dp-guide{stroke:var(--accent);stroke-width:1.4;stroke-dasharray:4 4}' +
      '.dp-lab{fill:var(--accent);font-size:11px;text-anchor:middle;letter-spacing:.02em}' +
      '.dp-mbody{fill:var(--text);opacity:.92}' +
      '.dp-mline{stroke:var(--bg,#06080c);stroke-width:1.2}' +
      '.dp-mwheel{fill:var(--bg,#06080c)}' +
      '.dp-medge{stroke:var(--accent);stroke-width:3;stroke-linecap:round}' +
      '.dp-arrow{fill:none;stroke:var(--accent);stroke-width:1.6;opacity:.7}' +
      '.dp-ghost{opacity:.3;display:none}' +
      '.dp-arrow{display:none}' +
      /* the demo: the mouse waits at the start, slides to the end, rests,
         fades and comes back. Fixed-duration on purpose: nobody can grab it
         (DESIGN.md: springs are for what a finger touches) */
      '.dp-demo .dp-m{animation:dp-slide 3.4s cubic-bezier(.45,0,.25,1) infinite}' +
      '@keyframes dp-slide{0%,14%{transform:translateX(0);opacity:1}62%,84%{transform:translateX(' + LEN + 'px);opacity:1}' +
        '94%{transform:translateX(' + LEN + 'px);opacity:0}95%{transform:translateX(0);opacity:0}100%{transform:translateX(0);opacity:1}}' +
      '.dp-live .dp-m{transition:transform 140ms linear}' +
      /* Reduce Motion: a still start, the end as a ghost, an arrow between */
      '@media (prefers-reduced-motion: reduce){.dp-demo .dp-m{animation:none}.dp-demo .dp-ghost,.dp-demo .dp-arrow{display:inline}' +
        '.dp-live .dp-m{transition:none}}' +
