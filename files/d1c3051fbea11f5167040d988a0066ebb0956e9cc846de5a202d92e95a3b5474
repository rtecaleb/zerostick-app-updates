  }
  function noRoute(j) {
    return /does not answer|501|not found|no such|not implemented/i.test(String((j && j.error) || ''));
  }

  /* D186: the owner's sentence, word for word, wherever a DPI is set or
     shown and it is under 3200 or not known. A gentle note, never a block. */
  var ADVICE = 'For the best experience set your mouse between ' + LOW + ' and ' + HIGH +
    ' DPI (' + RECOMMENDED + ' recommended).';
  function wantsAdvice(dpi) {
    var n = Number(dpi);
    return !(isFinite(n) && n >= LOW);
  }
  var LOW_WORDS = ADVICE + ' Lower still works, but small movements get coarse: each step of ' +
