/* zs-light.css — THE LIGHT THEME (D185)
   ═════════════════════════════════════════════════════════════════════════
   Settings > General > Theme: Dark (the default) / Light / Match system.
   phone.html's zsTheme puts `zs-light` on <body>; everything below hangs off
   that one class, so switching is instant (no reload, no second download).

   HOW IT IS BUILT, AND THE ONE RULE THAT KEEPS IT HONEST
   Every colour in the app is a TOKEN (phone.html :root, zs-brand.css :root,
   zs-kit.css :root). This file gives EVERY one of them a light value and
   nothing else does any theming work. A colour typed straight into a rule
   cannot follow a theme, which is why D185 turned the last literals on
   themed surfaces into tokens (phone.html :root §4) and why
   tools/test-theme.js fails the build if a new one appears.

   Loaded LAST (after zs-fixes.css and phone.html's last <style>), and every
   rule is `body.zs-light ...`, so it out-ranks each file's :root (0,1,0) by
   specificity, not just by order. The palette is re-declared ON BODY,
   aliases included: a custom property resolves where it is declared, so
   `--bg: var(--zs-page)` on :root is already the DARK page by the time body
   inherits it. The aliases are repeated here so they resolve against the
   light ladder (the same fix D185 made for OLED).

   WHAT CHANGES MEANING IN LIGHT, AND WHAT CANNOT
   * The device families keep their meanings (DESIGN.md: --accent is not
     --blue): PlayStation is still blue, Xbox green, keyboard & mouse
     violet. They are DEEPER shades, because #58a6ff on white is 2.6:1 and a
     family colour that fails as text is not a family colour, it is a
     smudge. Each deep shade clears AA as text on all four surfaces AND
     carries white ink as a fill (--ink-on-bright flips to white).
   * The accent is a deeper blue for the same reason, and the cap (the
     primary key's three-stop ramp) is a ramp of it with WHITE ink.
   * Pictures do not change with the theme, so neither does anything that
     rides on one (HOME's foot pills, the photo key, the Overview banner,
     the stance banners): they keep the dark palette, scoped at the bottom.

   MEASURED (WCAG 2.x, the +0.05 flare term), on the four steps
     page #eef1f6 · card #ffffff · raised #f6f8fb · control #e5e9f0
       --text   #121821   15.7 · 17.8 · 16.8 · 14.6
       --muted  #536071    5.66 · 6.40 · 6.02 · 5.26
       --accent #2856cc    5.63 · 6.38 · 5.99 · 5.24    white on it 6.38
       --blue   #0a5cb8    5.73 · 6.49 · 6.10 · 5.33    white on it 6.49
       --green  #17702f    5.46 · 6.19 · 5.81 · 5.08    white on it 6.19
       --purple #6e40cf    5.63 · 6.37 · 5.99 · 5.23    white on it 6.37
       --amber  #835700    5.57 · 6.31 · 5.93 · 5.18    white on it 6.31
       --red    #c0222a    5.29 · 5.99 · 5.63 · 4.92    white on it 5.99
       --rose   #b8225a    5.43 · 6.15 · 5.78 · 5.05    white on it 6.15
       --gold   #7f5900    5.57 · 6.30 · 5.93 · 5.18
       --tint-vision #0a6c75 5.43 · 6.15 · 5.78 · 5.05
     the cap: white on #3d6ad6 4.96 · #2856cc 6.38 · #2350c2 7.00
     a control's edge --zs-edge #77849a against a card 3.6:1 (1.4.11)
   tools/test-theme.js recomputes every one of these from this file. */

body.zs-light {
  /* §1 THE SURFACE LADDER — four steps, page darkest, card brightest:
     on a light screen elevation reads as LIGHTER, the opposite of dark,
     and the card is the white the eye anchors on. */
  --zs-page:    #eef1f6;
  --zs-card:    #ffffff;
  --zs-raised:  #f6f8fb;
  --zs-control: #e5e9f0;
  --frame:      #161b23;      /* the drawn phone's bezel stays a phone */
  /* the aliases, re-declared so they resolve against THIS ladder */
  --bg: var(--zs-page); --panel: var(--zs-card); --panel2: var(--zs-control);
  --line: #b8c2d0;            /* grouping edge: decorative, 1.7:1 on a card */

  /* INK */
  --text:  #121821;
  --muted: #536071;
  --white: #05080d;           /* "the heading level" — the darkest ink here */
  --ink-on-bright: #ffffff;   /* every bright fill is a DEEP fill in light  */
  --fg: var(--text);

  /* §3 FAMILY AND STATE — the same meanings, deeper shades */
  --blue:   #0a5cb8;  --green: #17702f;  --purple: #6e40cf;
  --amber:  #835700;  --red:   #c0222a;
  --red-ink: #b42029; --purple-ink: #6a3bc9;
  --steel:  #4c5a6d;
  --rose:   #b8225a;  --smart: var(--rose);

  /* brand */
  --accent: #2856cc;  --accent-ink: #ffffff;

  /* §2 THE FOUR BUTTON ROLES */
  --btn-1-bg: #2856cc; --btn-1-ink: #ffffff;
  --btn-1-edge: #5b82e0; --btn-1-wall: #173a8f;
  --cap-a: #3d6ad6; --cap-b: #2856cc; --cap-c: #2350c2; --cap-p: #1d45a8;
  --sel: #d3e0ff; --sel-ink: #102a66;          /* 10.9:1                    */
  --tint-vision: #0a6c75;
  --tint-gpc: #9c4400;    /* GPC Scripts: 5.72 / 6.48 / 6.09 / 5.32 on the four surfaces */
  --btn-2-bg: #e5e9f0; --btn-2-ink: #121821; --btn-2-edge: #77849a;
  --btn-3-bg: #c0222a; --btn-3-ink: #ffffff; --btn-3-edge: #8f1820;
  --btn-4-ink: #4d5a6c; --btn-4-edge: #77849a;
  --btn-wall: 0 2px 0 rgba(15,23,42,.16);
  --btn-lit:  inset 0 1px 0 rgba(255,255,255,.7);
  --btn-sunk: inset 0 2px 5px rgba(15,23,42,.18);

  /* §4 (phone.html) — what used to be literals */
  --desk-a: #f4f6fa; --desk-b: #dfe4ec;
  --chrome-a: rgba(246,248,251,.84); --chrome-b: rgba(246,248,251,.97);
  --bar-a: rgba(255,255,255,.90); --bar-b: rgba(246,248,251,.78);
  --rule: rgba(15,23,42,.10);
  --toast-bg: #ffffff;
  --scrim: rgba(15,20,30,.38);
  --scrim-a: rgba(15,20,30,.46); --scrim-b: rgba(15,20,30,.26);
  --gold: #7f5900;
  --room-plain: #56657a;
  --live-ink: #17702f;
  --nav-ink: #0a5cb8; --nav-ink-2: #2f5f99;
  --cap-ink-soft: rgba(255,255,255,.86);
  --kc-letter: #5b3fc4; --kc-digit: #8a2fb0; --kc-mod: #3f4fa0; --kc-edit: #555079;
  --kc-arrow: #b0306e;  --kc-punct: #5d566e; --kc-fn: #4c5170;  --kc-mouse: #6a46c9;
  --cur-a: rgba(40,86,204,.07); --cur-b: rgba(40,86,204,.03);
  --press-wash: rgba(15,23,42,.05);
  --btn-3-press: #9e1b22;
  --caution-bg: #fdecec;
  --knob-a: #8a96a8; --knob-b: #6f7c90;   /* a grey knob, as in dark: 3.3:1 */
  --track-a: rgba(15,23,42,.22); --track-b: rgba(15,23,42,.12);
  --track-hi: rgba(255,255,255,.9);

  /* zs-brand.css — the ion, the tier gradient, materials, elevation */
  --zs-ion: #2856cc; --zs-ion-ink: #ffffff;
  --zs-ion-wash: rgba(40,86,204,.10);
  --zs-ion-edge: rgba(40,86,204,.40);
  --zs-ion-glow: rgba(40,86,204,.22);
  --zs-grad: linear-gradient(135deg, #2856cc 0%, #2856cc 52%, #6e40cf 100%);
  --zs-grad-soft: linear-gradient(135deg, rgba(40,86,204,.10), rgba(110,64,207,.10));
  --mat-scrim: rgba(15,20,30,.36);
  /* light shadows are softer and cooler: a black .5 shadow on white reads
     as a smear, not a lift */
  --el-1: 0 1px 2px rgba(15,23,42,.10);
  --el-2: 0 4px 14px rgba(15,23,42,.10);
  --el-3: 0 12px 34px rgba(15,23,42,.14);
  --el-4: 0 24px 64px rgba(15,23,42,.18);
  --edge-lit: inset 0 1px 0 rgba(255,255,255,.75);
  --mat-bar-a: rgba(255,255,255,.86);  --mat-bar-b: rgba(246,248,251,.74);
  --mat-fade: rgba(238,241,246,.70);   --mat-fade-0: rgba(238,241,246,0);
  --mat-dock-a: rgba(250,251,253,.80); --mat-dock-b: rgba(246,248,251,.95);
  --mat-dock-rim: rgba(15,23,42,.10);
  --mat-dock-shadow: 0 -6px 22px rgba(15,23,42,.08);
  --mat-sheet-a: rgba(255,255,255,.94); --mat-sheet-b: rgba(246,248,251,.97);
  --mat-rim: rgba(15,23,42,.10);
  --mat-grabber: rgba(15,23,42,.22);
  --mat-toast: rgba(255,255,255,.92);

  /* zs-kit.css — edges, the control overlays, wells, the ion lines */
  --zs-edge: #77849a; --zs-edge-hi: #66748a;
  --zs-ink-2: #3f4b5c;
  --zs2-card-a: rgba(255,255,255,0);   --zs2-card-b: rgba(255,255,255,0);
  --zs2-ctl-a:  rgba(255,255,255,.75); --zs2-ctl-b:  rgba(255,255,255,.15);
  --zs2-sel:    rgba(255,255,255,.90);
  --zs2-well:   rgba(15,23,42,.06);    --zs2-well-pg: rgba(15,23,42,.04);
  --zs2-cut:    rgba(15,23,42,.10);    --zs2-bounce: rgba(255,255,255,.85);
  --zs2-sheen:  inset 0 1px 0 rgba(255,255,255,.90);
  --zs2-lit:    inset 0 1px 0 rgba(255,255,255,.75);
  --zs2-groove: inset 0 1px 3px rgba(15,23,42,.14), inset 0 -1px 0 rgba(255,255,255,.8);
  --zs2-wall:   0 2px 0 rgba(15,23,42,.14);
  --zs2-sunk:   inset 0 2px 4px rgba(15,23,42,.14);
  --zs2-ion-tint: rgba(40,86,204,.10);
  --zs2-ion-line: rgba(40,86,204,.50);
  --zs2-ion-dash: rgba(40,86,204,.45);
  --zs2-ion-wall: #173a8f;
}

/* HIGH CONTRAST, IN LIGHT. The dark mode's version brightens the inks to
   white; the light one takes them to black and the edges a step darker.
   Specificity (0,2,1) beats both body.a11y-contrast and body.zs-light. */
body.zs-light.a11y-contrast {
  --text: #000000; --fg: var(--text); --muted: #2f3a48; --line: #66748a;
  --zs-edge: #4f5c70; --zs-edge-hi: #3f4b5c; --zs-ink-2: #1f2833;
  --btn-2-edge: #4f5c70; --btn-4-edge: #4f5c70; --btn-4-ink: #2f3a48;
}
@media (prefers-contrast: more) {
  body.zs-light {
    --text: #000000; --fg: var(--text); --muted: #2f3a48; --line: #66748a;
    --zs-edge: #4f5c70; --zs-edge-hi: #3f4b5c; --zs-ink-2: #1f2833;
  }
}

/* WHAT RIDES ON A PICTURE KEEPS THE DARK PALETTE. A game's art (or the
   TV picture Screen Assist shows) is the same picture in either theme, and the chips, scrims and banners drawn over it
   were tuned against it (dark glass, light ink), so they are scoped back to
   the dark values instead of inheriting light ink onto dark glass. */
body.zs-light .hs-artfoot,
body.zs-light .hero-full .hplay,
body.zs-light .ovban,
body.zs-light .ovban-photo,
body.zs-light .aimban,
body.zs-light #cv-stage {   /* Screen Assist's live picture of the TV */
  --text: #e8edf5; --fg: #e8edf5; --muted: #97a3b6; --white: #ffffff;
  --ink-on-bright: #04120f; --line: #5c7089;
  --blue: #58a6ff; --green: #3fb950; --purple: #a371f7; --amber: #e3b341;
  --red: #e5484d; --red-ink: #ff8078; --purple-ink: #b98cff; --steel: #b9c6d8;
  --rose: #f47fa4; --accent: #6f9bff; --accent-ink: #04120f; --gold: #e3b341;
  --live-ink: #56d364; --zs-ink-2: #b9c7d7;
  color: var(--text);
}

/* HOME's picture box declares the console badge's colour (--pc) from the
   family tokens, ON the box, so the box needs the dark family shades for the
   badge riding the picture to resolve to them. Only the families: the box's
   own frame keeps following the theme. */
body.zs-light .hs-art { --blue: #58a6ff; --green: #3fb950; --purple: #a371f7; }

/* THE PHONE ON THE DESK (the browser preview, not the app window): a light
   desk wants a softer drop under the drawn phone. */
body.zs-light .phone { box-shadow: 0 30px 80px rgba(15,23,42,.28), inset 0 0 0 2px #2a313c; }
