/* recoil-manual.js: the Anti-Recoil Lab's MANUAL, made the way XIM's Recoil
 * Modeling Workshop works (D851), ZS_RECOIL_MANUAL.
 *
 * The owner (2026-11-17): Manual must work EXACTLY like the XIM MATRIX
 * Workshop's manual recoil tuning: the same steps, in the same order, with
 * the same controls, values and behaviour. XIM's own guide
 * (guide.xim.tech/Recoil-Modeling) is the script, step for step:
 *
 *   XIM                                     here (the method 'xim')
 *   Prerequisites, Start your game          1 Check
 *   Fire Rate: Enter Manually / Measure     2 Fire rate (Measure: shots,
 *     (shots, fire, let go), Reset              fire, let go; Reset)
 *   Fire Pattern Modification (optional)    3 Fire pattern: the spread aid,
 *   Fire Pattern Modeling: fire at a wall,     then fire at a wall, reticle
 *     reticle on the first mark, Trace,        on the first mark, Trace, Fire
 *     fire on each mark, Reset, more           on each next mark (in the
 *     samples, Done                            game: the Core holds fire back
 *                                              while tracing, D767), Reset,
 *                                              more patterns, Done
 *   Model (red dots), fire to preview,      4 Model: red dots, fire to
 *   Scale X / Y, Optimization +, Accept        preview (always on), Scale X,
 *   (re-edit: + wait scale)                    Scale Y, Optimization level,
 *                                              Wait scale on a re-edit, Accept
 *
 * Saved on ACCEPT (XIM's way), not by itself as Automatic's Tune is (D418);
 * closing without Accept keeps what was there before.
 *
 * The session, the model and the Script are recoil-workshop.js's (this file
 * draws the four pages and wires them); the Core's routes are /recoil/open
 * {"trigger":true}, /recoil/measure, /recoil/spread, /recoil/mtrace (op
 * "trace", D851: hole 1 at the reticle the moment Trace is pressed),
 * /recoil/samples, /recoil/model and /recoil/test.
 *
 * Costs nothing until Manual is chosen: no timer, no Core call.
 *
 * ES5 ONLY (DESIGN.md). Loaded after recoil-workshop.js and recoil-wall.js.
 */
(function () {
  'use strict';

  function Z() { return window.ZS; }
  function K() { return window.ZS_RECOIL._kit; }
  function num(v, d) { var n = Number(v); return isFinite(n) ? n : d; }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function help(id, label, text) { return Z().helpHTML ? Z().helpHTML(id, label, text) : ''; }
  function mouseCfg(W) { return W.input === 'mnk' || W.input === 'stick_mouse'; }
  function fireWord(W) { return mouseCfg(W) ? 'your fire button' : 'RT'; }

  /* the few rules of its own, added the first time Manual draws */
  var cssDone = false;
  function css() {
    if (cssDone || !document.head) return;
    cssDone = true;
    var st = document.createElement('style');
    st.id = 'xm-css';
    st.textContent = '.xm-seg{margin:0 0 10px}' +
      '.xm-meas{padding:12px var(--sp-3,16px) 14px}.xm-meas .rw-live{margin:0 0 10px}';
    document.head.appendChild(st);
  }

  /* ── 1 Check: the prerequisites (XIM's) ─────────────────────────────────── */

  var HELP_CHECK = 'Check these before you model a gun. <b>Bindings that fire must be disabled:</b> your ' +
    'Core pauses every other Smart Action while the Lab is open, so rapid fire and the rest cannot fire. ' +
    '<b>Passthrough Mode</b> must be off. The model needs <b>accurate real-world units</b>: ' +
    'it is measured through this config’s game settings (and its DPI with a mouse), so your in-game sensitivity, ' +
    'aiming sensitivity and dead zone must match this config. Go to a <b>private match or a training area with no ' +
    'enemies</b>. If you are modeling the pattern aimed down sights, stay aimed down sights for every step.';
  function pageCheck(W) {
    var k = K(), st = W.status || {}, navOk = st.navigate !== true, ads = k.adsName(W.p);
    var h = '<p class="rw-q">Manual: before you start</p>' +
      '<p class="rw-h">Set the fire rate, fire a pattern at a wall, trace each shot mark in your game, and ' +
      'the Lab builds the anti-recoil Script.</p>' + help('xm-check-help', 'Before you start', HELP_CHECK);
    h += '<ul class="rw-checks" id="xm-checks">' +
      '<li><i class="ok">✓</i><span>Other bindings that fire are paused<em>While the Lab is open. They come back ' +
        'when you close it.</em></span></li>' +
      '<li><i class="' + (navOk ? 'ok' : 'no') + '">' + (navOk ? '✓' : '!') + '</i><span>Passthrough Mode is ' +
        (navOk ? 'off' : '<b>on</b>: switch it off with its shortcut first') + '</span></li>' +
      (mouseCfg(W)
        ? '<li><i class="ok">✓</i><span>Mouse DPI: <b>' + k.esc(k.dpiOf(W.p)) + '</b><em>From this config. ' +
          'Change your mouse’s DPI later and model it again.</em></span></li>'
        : '<li><i class="ok">✓</i><span>Your controller<em>Fire with RT, aim with your right stick.</em></span></li>') +
      '<li><i class="ask">?</i><span>Your in-game settings match this config<em>Sensitivity, aiming sensitivity ' +
        'and dead zone.</em></span></li>' +
      '<li><i class="ask">?</i><span>A private match or a training area<em>Somewhere with a plain wall and no ' +
        'enemies.</em></span></li>' +
      '</ul>';
    h += k.card(k.fld('I’ve checked my game settings', k.toggle(W.checked, 'rw-checked', 'my game settings match')) +
      k.fld('Only while aiming down sights', k.toggle(W.ads, 'rw-ads', 'only while aiming down sights'),
        mouseCfg(W) ? (ads ? 'model it aimed in (hold ' + k.esc(ads) + ') for every step' : 'this config has no aim button set, so it would never run')
          : 'model it aimed in (hold your aim trigger) for every step'));
    h += k.errNote(W);
    h += '<div class="rw-row">' + k.btn('Back', null, 'rw-tomode') +
      k.btn(W.busy ? 'Opening…' : (W.editing ? 'Open my model' : 'Start'), 'primary', 'rw-next', !W.checked || W.busy) + '</div>';
    return h;
  }

  /* ── 2 Fire rate: Enter manually (recommended) or Measure ─────────── */

  var HELP_RATE = 'The model needs your weapon’s <b>accurate fire rate in rounds per minute</b>. ' +
    '<b>Enter manually</b> is recommended: look it up for your weapon and its attachments. ' +
    '<b>Measure</b>, if you do not know it: set Shots to the number of rounds you will fire (a full magazine), ' +
    'start firing, and let go <b>immediately after the last round</b>. Press Reset to measure again and check ' +
    'that you get the same number.';
  function measureState(W) {
    var st = W.status || {}, m = st.measure || {};
    return { on: st.state === 'measuring', presses: num(m.presses, 0), down: !!m.down, heldMs: num(m.heldMs, 0) };
  }
  /* the measurement done (fired and let go): its RPM, else 0 */
  function measuredNow(W) {
    var ms = measureState(W);
    if (!ms.on || !ms.presses || ms.down) return 0;
    var r = K().measuredRpm(W);
    return r >= 60 && r <= 3000 ? r : 0;
  }
  function measureWords(W) {
    var ms = measureState(W), r = measuredNow(W);
    if (!ms.on) return 'Starting…';
    if (!ms.presses) return 'Start firing. Let go <b>immediately after the last round</b>.';
    if (ms.down) return '<b>Firing…</b> let go right after the last round';
    if (!r) return 'That did not give a fire rate. Press Reset and fire the whole magazine in one go.';
    return '<b>' + r + ' RPM</b> measured: ' + W.mag + ' shots in ' + (ms.heldMs / 1000).toFixed(2) + ' s';
  }
  function pageRate(W) {
    var k = K(), how = W.xmHow === 'measure' ? 1 : 0;
    var h = '<p class="rw-q">Fire rate</p>' +
      '<p class="rw-h">Rounds per minute (RPM). Entering it manually is recommended.</p>' +
      help('xm-rate-help', 'Fire rate', HELP_RATE) +
      '<div class="xm-seg">' + k.seg(['Enter manually', 'Measure'], how, 'xm-how') + '</div>';
    if (!how) {
      h += k.card(k.stepper('Fire rate', W.params.rpm, 10, 60, 3000, ' RPM', 'rounds per minute', 'rpm'));
    } else {
      h += k.card(k.stepper('Shots', W.mag, 1, 2, 100, '', 'the rounds you will fire: a full magazine', 'mag') +
        '<div class="xm-meas"><p class="rw-live" id="xm-meas" aria-live="polite">' + measureWords(W) + '</p>' +
        k.btn('Reset', null, 'xm-mreset', !measureState(W).on) + '</div>');
      h += '<p class="rw-h" id="xm-rateis">Fire rate: <b>' + W.params.rpm + ' RPM</b>' +
        (W.rateSrc === 'measured' ? ' (measured)' : '') + '</p>';
    }
    h += k.errNote(W) + '<div class="rw-row">' + k.btn('Back', null, 'rw-back') + k.btn('Next', 'primary', 'rw-next', !!W.busy) + '</div>';
    return h;
  }
  /* a finished measurement sets the fire rate (XIM's Measure) */
  function applyMeasure(W) {
    var r = measuredNow(W);
    if (r && (W.params.rpm !== r || W.rateSrc !== 'measured')) {
      W.params.rpm = r;
      W.rateSrc = 'measured';
      W.rateTyped = false;
      return true;
    }
    return false;
  }
  function measureCmd(W, op) {
    return K().api('/recoil/measure', 'POST', { op: op }).then(function (j) {
      if (W.closed) return;
      if (j.ok && j.data) W.status = j.data;
      else if (!j.ok) W.err = String(j.error || 'The Core could not measure.');
      W.paint();
    });
  }

  /* ── 3 Fire pattern: modification (optional), then modeling ───────── */

  var HELP_SPREAD = '<b>Fire pattern modification</b>. If the shots land too close together or on top of ' +
    'each other, your Core pulls the aim down a little after every shot while you fire, so the marks spread out ' +
    'into a column you can trace. The pull is taken out of the model again when it is built, so the Script is ' +
    'your gun’s real pattern. Leave it Off when you can see every mark.';
  function helpTrace(W) {
    return '<b>Trace</b> marks the first shot mark where your reticle is now. Then put the reticle on each next ' +
      'mark, in the order fired, and press <b>' + fireWord(W) + '</b> once per mark: while you trace it does not ' +
      'shoot (your Core holds fire back from the console) and the marks appear here as red dots. Move the reticle ' +
      'with ' + (mouseCfg(W) ? 'your mouse' : 'your right stick') + ', the same way you aimed when you fired' +
      (W.ads ? ', and stay aimed down sights' : '') + '. <b>Do not move your reticle while you fire</b> the pattern. ' +
      'Made a mistake? <b>Reset</b> starts this pattern over (Circle or Backspace also takes the last mark back). ' +
      'If the game has heavy reticle sway, trace quickly. If the marks disappear fast, fire one pattern at a time ' +
      'and trace it straight away. <b>Optional:</b> fire at the wall again and trace another pattern (up to ' +
      K().SAMPLES_MAX + '): more patterns average out a gun whose pattern is a little random. Then <b>Done</b> ' +
      'builds the model. A very random pattern only ever gets an approximate model.';
  }
  function mtOf(W) { return (W.status && W.status.mtrace) || null; }
  function tracing(W) { var m = mtOf(W); return !!(m && m.on); }
  function patternPlot(W) {
    var k = K(), sets = [], i, m = mtOf(W);
    for (i = 0; i < W.samples.length; i++) sets.push({ pts: k.pairs(W.samples[i].pts), cls: 'old', line: true, r: 2.6 });
    if (m && m.on) sets.push({ pts: k.pairs(m.pts), cls: 'tr', line: true });
    return k.plotSVG(sets, 'your traced shots');
  }
  function patternWords(W) {
    var m = mtOf(W), n = W.samples.length;
    var kept = n ? n + (n === 1 ? ' pattern' : ' patterns') + ' traced' : 'No pattern traced yet';
    if (!m || !m.on) return kept;
    var t = Math.round(num(m.n, 0));
    return '<b>' + t + '</b> ' + (t === 1 ? 'shot' : 'shots') + ' traced' +
      (W.xtLegacy && t === 0 ? ': press ' + fireWord(W) + ' on the first shot mark too' : '') +
      (m.full ? ' (the most one pattern holds)' : '') + (n ? ' · ' + kept : '');
  }
  function pagePattern(W) {
    var k = K(), m = mtOf(W), on = tracing(W), n = W.samples.length;
    var can = !!m && W.opened;
    var h = '<p class="rw-q">Fire pattern</p>';
    h += k.card('<div class="fld col"><div class="salab">Fire pattern modification' +
      '<em>Optional: shots too close together? Spread them out vertically. Undone when the model is built.</em></div>' +
      k.seg(k.SPREAD_WORDS, W.spread || 0, 'xm-spread') + '</div>') + help('xm-spread-help', 'Fire pattern modification', HELP_SPREAD);
    h += '<div class="sh">Fire pattern modeling</div>';
    if (!on) {
      h += '<ol class="rw-h" id="xm-steps" style="padding-left:18px;margin-top:0">' +
        '<li>Fire a shot pattern at a wall' + (W.ads ? ', aimed down sights' : '') + '. Don’t move your reticle while you fire.</li>' +
        '<li>Put your reticle on the <b>first</b> shot mark.</li>' +
        '<li>Press <b>Trace</b>.</li>' +
        '<li>Press <b>' + k.esc(fireWord(W)) + '</b> on each next shot mark, in order.</li>' +
        '<li>Press <b>Done</b>.</li></ol>';
    } else {
      h += '<p class="rw-h" id="xm-steps">Reticle on each next shot mark, then <b>' + k.esc(fireWord(W)) +
        '</b>. It does not shoot while you trace.</p>';
    }
    h += help('xm-trace-help', 'How tracing works', helpTrace(W));
    h += '<div class="rw-plotwrap" id="rw-plot">' + patternPlot(W) + '</div>';
    h += '<p class="rw-live" id="xm-count" aria-live="polite">' + patternWords(W) + '</p>';
    if (W.opened && !m) {
      h += k.note('This Core’s firmware cannot trace in the game yet. Update the Core, then try again.', 'warn');
    }
    h += k.errNote(W);
    if (on) {
      var t = Math.round(num(m.n, 0));
      h += '<div class="rw-row">' + k.btn('Reset', null, 'xm-reset', !!W.xmBusy) +
        k.btn('Done', 'primary', 'xm-done', t < 2 || !!W.xmBusy) + '</div>' +
        '<div class="rw-row">' + k.btn('Keep it, fire another pattern', null, 'xm-more',
          t < 2 || n + 1 >= k.SAMPLES_MAX || !!W.xmBusy) + '</div>';
    } else {
      h += '<div class="rw-row">' + (n ? k.btn('Reset', null, 'xm-reset', !!W.xmBusy) : '') +
        k.btn('Trace', n ? null : 'primary', 'xm-trace', !can || n >= k.SAMPLES_MAX || !!W.xmBusy) +
        (n ? k.btn('Done', 'primary', 'xm-done', !!W.xmBusy) : '') + '</div>';
    }
    h += '<div class="rw-row">' + k.btn('Back', null, 'rw-back', on) + '</div>';
    return h;
  }
  function mtCmd(W, op, then) {
    W.xmBusy = true;
    W.err = '';
    K().api('/recoil/mtrace', 'POST', { op: op }).then(function (j) {
      W.xmBusy = false;
      if (W.closed) return;
      if (j.ok && j.data) W.status = j.data;
      if (then && then(j) === false) return;
      if (!j.ok && !W.err) W.err = String(j.error || 'The Core could not do that.');
      W.paint();
    });
  }
  /* Trace: hole 1 is where the reticle is now (D851's op); a Core from
     D767 only knows "start" (the first press marks hole 1: said live) */
  function trace(W) {
    W.traceSpread = K().SPREAD_LEVELS[W.spread || 0] || 0;
    mtCmd(W, W.xtLegacy ? 'start' : 'trace', function (j) {
      if (!j.ok && !W.xtLegacy && /must be/i.test(String(j.error || ''))) {
        W.xtLegacy = true;
        trace(W);
        return false;
      }
    });
  }
  function keep(W, j) {
    var m = (j.data && j.data.mtrace) || {}, pts = Array.isArray(m.pts) ? m.pts.slice() : [];
    if (pts.length < 4) return false;
    W.samples.push({ spread: W.traceSpread || 0, pts: pts });
    return true;
  }
  function build(W) {
    W.testing = true;             /* XIM: "fire to preview the results" */
    W.useSamples(W.samples.slice(), { page: 'model' });
  }
  function done(W) {
    if (!tracing(W)) { if (W.samples.length) build(W); return; }
    mtCmd(W, 'done', function (j) {
      if (!j.ok) return;
      if (!keep(W, j)) { W.err = 'Trace at least two shot marks.'; return; }
      build(W);
      return false;
    });
  }
  function more(W) {
    mtCmd(W, 'done', function (j) {
      if (j.ok && !keep(W, j)) W.err = 'Trace at least two shot marks.';
    });
  }
  function reset(W) {
    if (tracing(W)) { mtCmd(W, 'cancel'); return; }
    /* not tracing: the patterns traced so far go (here and on the Core) */
    W.samples = [];
    W.xmBusy = true;
    K().api('/recoil/samples', 'POST', { op: 'clear' }).then(function () {
      W.xmBusy = false;
      if (!W.closed) W.paint();
    });
    W.paint();
  }

  /* ── 4 Model: the red dots, fire to preview, scale, optimise, Accept ─ */

  var HELP_SCALE = '<b>Scale refinement</b>. Fire to preview: the model runs while you hold Fire. ' +
    'If the reticle still pulls <b>vertically</b>, adjust <b>Scale Y</b>; if it pulls <b>horizontally</b>, adjust ' +
    '<b>Scale X</b>. Scaling also helps when the game changes the pattern as you pull against it, when aim assist ' +
    'changes it, and when the pattern is quite random. Test it against an enemy too before you Accept. ' +
    '<b>Optimization level</b>: + uses fewer moves, which saves space and can sometimes improve accuracy. ' +
    '<b>Wait scale</b> (when you re-open a saved model) stretches the timing: to change only the fire rate, ' +
    'set it to the old RPM ÷ the new RPM.';
  function modelPlot(W) {
    var k = K(), sets = [];
    if (W.model && W.model.mean) sets.push({ pts: k.pairs(W.model.mean), cls: 'old', line: true, r: 2.4 });
    if (W.model) sets.push({ pts: k.modelPts(W.model), cls: 'tr', line: true });
    return k.plotSVG(sets, 'the model as red dots over your traced pattern');
  }
  function previewLine(W) {
    var test = (W.status || {}).test || {};
    return 'Fire to preview: it runs while you hold Fire' + (num(test.plays, 0) ? ' · previewed ' + test.plays + '×' : '');
  }
  function pageModel(W) {
    var k = K();
    var h = '<p class="rw-q">Your recoil model</p>' +
      '<div class="rw-plotwrap" id="rw-plot">' + modelPlot(W) + '</div>' +
      '<div class="rw-legend"><span><b style="background:var(--red,#e5484d)"></b>the model</span>' +
        '<span><b style="background:var(--red,#e5484d);opacity:.35"></b>your traced shots</span></div>' +
      '<p class="rw-stats" id="rw-stats" aria-live="polite">' + k.statsWords(W) + '</p>';
    h += '<div class="rw-test on" id="xm-preview"><p class="rw-live" style="margin:0" id="rw-testline">' + previewLine(W) + '</p></div>';
    h += '<div class="grp-card rw-scales">' +
      k.stepper('Scale X', W.params.sx, 10, 0, k.SCALE_MAX_PCT, '%', 'if the reticle pulls horizontally', 'sx') +
      k.stepper('Scale Y', W.params.sy, 10, 0, k.SCALE_MAX_PCT, '%', 'if the reticle pulls vertically', 'sy') +
      '</div>';
    h += k.card(k.stepper('Optimization level', W.params.opt, 1, 0, 10, '', '+ uses fewer moves', 'opt') +
      (W.editing ? k.stepper('Wait scale', W.params.ws, 5, 25, 400, '%', 'stretches the timing', 'ws') : ''));
    h += help('xm-scale-help', 'Scale and optimization', HELP_SCALE);
    var gv = Math.round(W.vmag * 100);
    h += '<details class="rw-adv"' + (W.advOpen ? ' open' : '') + '><summary>Advanced</summary>' + k.card(
      k.nameHTML(W) +
      k.stepper('Fire rate', W.params.rpm, 10, 60, 3000, ' RPM', 'what the pattern was fired at', 'rpm') +
      k.fld('Only while aiming down sights', k.toggle(W.ads, 'rw-ads', 'only while aiming down sights')) +
      k.stepper('Timing wobble', W.vms, 5, 0, 500, 'ms', 'each step varies by up to this much; 0 is exact', 'vms') +
      '<div class="fld"><div class="salab">Strength wobble<em>' + (W.vmagOverride
        ? 'each shot varies by up to this much; 0 is exact'
        : 'following Translation → Behavior; override to change for this script only') + '</em></div>' +
        '<span class="rw-vmag-row"><label class="rw-vmag-ov-lbl"><input type="checkbox" class="rw-vmag-ov-cb"' +
        (W.vmagOverride ? ' checked' : '') + '> Override</label>' +
        '<span class="stp' + (W.vmagOverride ? '' : ' rw-vmag-dim') + '"><button data-d="-5"' + (W.vmagOverride ? '' : ' disabled') +
        ' aria-label="decrease">−</button><b class="sv" data-nosave="1" data-f="vmag" data-min="0" data-max="100" data-suffix="%"' +
        (W.vmagOverride ? '' : ' aria-disabled="true"') + '>' + gv + '</b><button data-d="5"' + (W.vmagOverride ? '' : ' disabled') +
        ' aria-label="increase">+</button></span></span></div>') + '</details>';
    h += help('rw-feel', 'How the pull feels',
      'On a controller the pull eases off while you move your aim stick, and comes back the moment you let go. ' +
      'It starts just past the dead zone, so the first shots pull right away. With a mouse it moves like your hand does.');
    h += k.note('Good to know: a gun with a very random pattern, marks that disappear fast, or a pattern that changes ' +
      'as you pull against it only ever gets an approximate model.');
    h += (W.saveErr ? k.note(k.esc(W.saveErr), 'warn') : '') + k.errNote(W);
    h += '<div class="rw-row">' + k.btn('Back', null, 'rw-back') + k.btn('Accept', 'primary', 'xm-accept', !W.model) + '</div>';
    h += k.deleteHTML(W);
    return h;
  }
  function modelReady(W) {
    var el = document.getElementById('sheetbody');
    if (!el) return;
    var pl = el.querySelector('#rw-plot'), st = el.querySelector('#rw-stats'), ac = el.querySelector('#xm-accept');
    if (pl) pl.innerHTML = modelPlot(W);
    if (st) st.innerHTML = K().statsWords(W);
    if (ac) { ac.disabled = !W.model; if (W.model) ac.removeAttribute('aria-disabled'); }
  }
  function accept(W) {
    if (!W.model) return;
    W.saveNow();
    if (W.saveErr) { W.paint(); return; }
    Z().sheetClose();
    if (Z().toast) Z().toast('Recoil script saved');
  }

  /* ── the session glue (recoil-workshop.js calls these) ─────────────── */

  function page(W) {
    css();
    if (W.page === 'check') return pageCheck(W);
    if (W.page === 'rate') return pageRate(W);
    if (W.page === 'pattern') return pagePattern(W);
    return pageModel(W);
  }
  /* every paint: tracing only on the Fire pattern page; the pattern
     modification only there too (taken off for the model and its preview) */
  function sync(W) {
    if (!W.opened || W.closed) { W.spreadSent = 0; return; }
    var m = mtOf(W);
    if (m && m.on && W.page !== 'pattern' && !W.xmBusy) mtCmd(W, 'cancel');
    var want = W.page === 'pattern' ? (K().SPREAD_LEVELS[W.spread || 0] || 0) : 0;
    if (want !== (W.spreadSent || 0)) {
      W.spreadSent = want;
      K().api('/recoil/spread', 'POST', { perShot: want, rpm: W.params.rpm });
    }
    /* Measure arms while it is chosen on the Fire rate page */
    var ms = measureState(W);
    if (W.page === 'rate' && W.xmHow === 'measure' && !ms.on && !W.xmMeasAsked) {
      W.xmMeasAsked = true;
      measureCmd(W, 'start');
    } else if ((W.page !== 'rate' || W.xmHow !== 'measure') && ms.on && !W.xmMeasStop) {
      W.xmMeasStop = true;
      measureCmd(W, 'stop').then(function () { W.xmMeasStop = false; });
    }
    if (ms.on) W.xmMeasAsked = false;
  }
  /* the poll's news, without a repaint where one would cut a stepper short */
  function live(W, was) {
    var st = W.status || {};
    if (W.page === 'rate') {
      var m = st.measure || {}, wm = was.measure || {};
      if (m.presses !== wm.presses || m.down !== wm.down || m.heldMs !== wm.heldMs ||
          (st.state === 'measuring') !== (was.state === 'measuring')) {
        applyMeasure(W);
        W.paint();
      }
      return true;
    }
    if (W.page === 'pattern') {
      var a = st.mtrace || {}, b = was.mtrace || {};
      if (a.rev !== b.rev || !!a.on !== !!b.on || !!st.mtrace !== !!was.mtrace) W.paint();
      return true;
    }
    if (W.page === 'model') {
      var t = st.test || {}, wt = was.test || {};
      if (t.plays !== wt.plays) {
        var el = document.getElementById('sheetbody'), tl = el && el.querySelector('#rw-testline');
        if (tl) tl.innerHTML = previewLine(W);
      }
      return true;
    }
    return false;
  }
  function wire(W, el) {
    function on(id, fn) {
      var b = el.querySelector('#' + id);
      if (b) b.addEventListener('click', function (e) { if (!b.disabled) fn(e, b); });
    }
    function segOn(id, fn) {
      var s = el.querySelector('#' + id);
      if (s) s.querySelectorAll('button').forEach(function (b) {
        b.addEventListener('click', function () { fn(num(b.getAttribute('data-i'), 0)); });
      });
    }
    segOn('xm-how', function (i) {
      W.xmHow = i === 1 ? 'measure' : 'typed';
      W.xmMeasAsked = false;
      W.err = '';
      W.paint();
    });
    on('xm-mreset', function () { measureCmd(W, 'start'); });
    segOn('xm-spread', function (i) { W.spread = clamp(i, 0, K().SPREAD_WORDS.length - 1); W.paint(); });
    on('xm-trace', function () { trace(W); });
    on('xm-reset', function () { reset(W); });
    on('xm-done', function () { done(W); });
    on('xm-more', function () { more(W); });
    on('xm-accept', function () { accept(W); });
    /* Measure: a new shot count re-reads the same measurement */
    if (W.page === 'rate') {
      el.addEventListener('zsstep', function (e) {
        var t = e.target;
        if (!t || !t.getAttribute || t.getAttribute('data-f') !== 'mag') return;
        W.mag = clamp(Math.round(num(parseFloat(t.textContent), W.mag)), 2, 100);
        applyMeasure(W);
        var mw = el.querySelector('#xm-meas'), ri = el.querySelector('#xm-rateis');
        if (mw) mw.innerHTML = measureWords(W);
        if (ri) ri.innerHTML = 'Fire rate: <b>' + W.params.rpm + ' RPM</b>' + (W.rateSrc === 'measured' ? ' (measured)' : '');
      });
    }
  }

  window.ZS_RECOIL_MANUAL = {
    page: page, sync: sync, live: live, wire: wire, modelReady: modelReady,
    /* the tests pin these */
    _measuredNow: measuredNow
  };
})();
