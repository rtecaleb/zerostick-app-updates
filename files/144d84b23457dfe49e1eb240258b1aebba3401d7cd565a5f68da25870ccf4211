  var LAYOUTS = {
    '52:1918': { hip: 0x56, ads: 0x29a, inherit: 0x48, curve: 'f32', check: false },
    '52:2734': { hip: 0x56, ads: 0x2ae, inherit: 0x48, curve: 'f32', check: false },
    '53:2734': { hip: 0x70, ads: 0x1ba, inherit: -1, curve: 'u16', check: true }
