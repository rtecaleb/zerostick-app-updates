  /* ── the text ───────────────────────────────────────────────────────── */
  /* The code's body and the name in its START marker, or null. */
  function find(text) {
    if (typeof text !== 'string') { return null; }
    var m = /XMC:([A-Za-z0-9+\/=\s]+?):XMC/.exec(text);
