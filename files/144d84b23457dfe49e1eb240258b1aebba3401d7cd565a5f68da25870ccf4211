/* xim-share-code.js - reading an XIM MATRIX share code, window.ZSXIMCODE.
 *
 * A player who owns an XIM MATRIX can paste the code its Manager app copies
 * (">>> XIM MATRIX [name] START COPY >>>", "XMC:" ... ":XMC"). This file turns
 * that text into the few aim settings docs/XIM-SHARE-CODE.md confirms, and
 * nothing more. xim-import.js (ZSXIM.fromShareCode) puts them into the "Copy
 * your XIM settings in" form; the player still sees the preview, with its
 * Same / Close / Not available labels, and taps Apply. Nothing is applied
 * from here.
 *
 * HOW IT WAS LEARNT (clean room, D76; docs/XIM-SHARE-CODE.md): only codes
 * people posted in PUBLIC were looked at, as data. No XIM app or firmware
 * was downloaded, opened or taken apart. The code is base64 of a 4-byte
 * big-endian length and a zlib stream: COMPRESSION, not encryption. Inflated,
 * it is a plain record whose fields were matched to their meaning by
 * comparing public codes with each other and with what their posters said.
 *
 * WHAT IS READ (and only for the layouts the public samples show):
 *   - the config's name and the game number XIM stores;
 *   - per stance (Hip, Aim Down Sight), the MOUSE aim block: Sensitivity
 *     (cm/360), Y Scale, the smoothing mode (Standard | Classic), Precision /
 *     Response / Easing, Smooth / Decay / Synch, and the aiming curve's
 *     handles;
 *   - the settings inheritance (Inherit All / Sensitivity Only / Inherit
 *     Nothing) where its byte was located.
 * Everything else in the code (bindings, Smart Actions, dead zones,
 * Quantization, motion and stick aim, the DPI) is NOT read, and read()
 * says so in `notRead`, so the screen can tell the player.
 *
 * WHAT IS REFUSED, kindly: the 2023 Manager format ('qds'), codes made with
 * firmware from before March 2024 (Sensitivity was not cm/360 yet), and any
 * layout no public sample shows. read() never guesses an offset.
 *
 * Nothing here is kept, logged or sent: read() takes a string and returns
 * numbers. No network, no XIM servers, no Config Cloud.
 *
 * ES5 ONLY (docs/DESIGN.md). Typed arrays and DataView are library, not
 * syntax. The inflater is our own small RFC 1951 reader (the app has a
 * deflater, zs-deflate.js, and no inflater; DecompressionStream is
 * asynchronous and missing from the test harness).
 */
(function (root) {
  'use strict';

  var MAX_OUT = 65536;          /* a share code inflates to ~2-4 KB; refuse anything huge */

  /* ── base64 ─────────────────────────────────────────────────────────── */
