/* sections/25-profiles.js — the Configs screen (R.profiles) and the search field (D121).
 *
 * The list of configs on the adapter, a page at a time, with search
 * (findFieldHTML / findWire, shared with the wizard's game step), order,
 * activate, and the New config door (which starts the wizard clean).
 *
 * Screens (window.RENDERERS):  R.profiles
 * Core / board routes:        /profiles
 * Tests:                      test-profiles-tab.js, test-wizard-search.js, test-config-photos.js, test-game-lock.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('profiles', function (SEC) {
  /* from the files before this one */
  var esc = SEC.esc, note = SEC.note, pic = SEC.pic, R = SEC.R, ZS = SEC.ZS,
      normGame = SEC.normGame, wzReset = SEC.wzReset;

  /* ── Configs (the profiles screen) ─────────────────────────────────
     HOME used to print EVERY config in one long scroll. Owner, 2026-08-16:
     "just add a profiles tab and put them in there and only display the
     current one". HOME keeps the hero — the config that is PLAYING — and the
     whole list moved behind its #cfgrow door into here.

     NOTHING was dropped: tap-to-switch with the optimistic activate and the
     board's-refusal rollback, Reorder with up/down, the per-row edit chevron,
     ＋ New config and the power-on explanation are all here, in the SAME
     classes they had on HOME, so every CSS rule (zs-editorial.css 392-423,
     zs-fixes.css 43-119, zs-kit.css 607+) and every harness selector still
     matches without a line of new CSS. (Deleting a config was never on this
     list — it lives on the Overview screen inside the editor, and is
     untouched by the move.)

     THE ORDINARY POLL CANNOT REACH THIS SCREEN, which is the point of it
     living in #dbody: the 8 s interval calls renderHomeIfVisible(), which
     returns early while #detail is open. So the list under your finger never
     churns while you are choosing from it.

     HOME DOES NOT KEEP REFRESHING BEHIND THE PANEL. The same early return
     stops it too — renderHomeIfVisible() is the tick's only route to
     renderHome() — so while this screen is up, HOME is frozen at whatever it
     last drew. For eight seconds of a covered screen that is free. It is NOT
     free after a switch: the hero's live line (which backend is running, how
     long the board has been up) would still be describing the config you just
     switched AWAY from, and you would see it the moment you closed the panel.
     So the switch path repaints HOME itself — see the j.ok branch below. That
     is the one moment HOME is known to be wrong, and it is not left to a tick
     that may be seconds away. The other cost, accepted and the same one every
     detail panel pays: if the BOARD changes the active config by itself
     (Passthrough Mode, a "switch config" Smart Action) while this screen is
     open, the tick does not move until you act or reopen.

     ONE event is exempt, and has to be: the reconnect. When the app boots
     before the board answers it shows the four built-in preview configs, and
     the poll's loadLive() then EMPTIES PROFILES and refills it from the board
     (phone.html ~1170). A stale tick is a cosmetic cost; a stale LIST is not
     — every row would name a config the board has never heard of, and this
     screen is the only way to switch. So draw() is registered with
     ZS.watchProfileList() and phone.html's syncProfileList() calls it when,
     and only when, the list IDENTITY changes. Same configs in the same order
     — every ordinary tick — redraws nothing at all.

     P_ORDER is module-level, NOT a closure var: devbar.js calls
     ZS.redrawOpenScreen() when the connected pad's family changes, which
     re-enters openDetail() and rebuilds this screen from scratch. A closure
     variable would silently drop Reorder mode when somebody unplugged a pad.
     Same reason G_TAB (6404) and OV_TAB (2366) live out here. */
  var P_ORDER = false;

  /* ── THE CONFIGS SEARCH (D121) ────────────────────────────────────────
     The owner, 2026-09-23: "make sure there is a search bar to search
     configs". It filters AS YOU TYPE, by hiding rows rather than redrawing
     them, so the field keeps its focus, its caret and the phone's keyboard.
     P_QUERY is module-level for the P_ORDER reason: the pad-family redraw
     and a reconnect rebuild this screen, and the words typed must survive.

     WHAT IT MATCHES: the config's name and its game, normalised the way
     every game name in the app is (normGame: case and punctuation do not
     count), and for a config made from a game pack, or matched to one by
     its name, the pack's own name and aliases too. So "bo2", "black ops"
     and "BO-2" all find a config called "Ranked" that plays Black Ops II.
     Every word typed must match somewhere, in any order ("ranked warzone").
     Never the console or the way to play: the owner asked for the name and
     the game, and a word like "pc" would match half the list by accident.

     It never talks to the adapter. It reads the list the app already
     holds; nothing is fetched or sent while typing. */
  var P_QUERY = '';
  var P_ARTSUB = null;   /* the list's one picture-landed subscription (below) */
  /* The screen descriptor the list was last opened with. redrawOpenScreen()
     re-enters with the SAME object (phone.html keeps it as lastDetail), and
     every real way in (the More menu's door, the wizard's back button)
     passes a new one. So a redraw keeps the words typed, and coming back to
     the screen later starts with an empty search rather than a list that
     silently shows three configs out of twelve. */
  var P_OPENED = null;
  /* A pack's own name and every other name players call the game by. The
     Configs rows and the wizard's game tiles both search these, so "bo2"
     finds Black Ops II in either place. */
  function packFindParts(pk){
    return pk ? [pk.name].concat(pk.aliases || []) : [];
  }
  /* '|' between fields, so a word can never match across two of them */
  function findKeyOf(parts){
    return parts.map(normGame).filter(function(s){ return !!s; }).join('|');
  }
  function cfgFindKey(p){
    var pk = window.ZSPACKS ? ZSPACKS.ofConfig({ pack: p.pack, game: p.game }) : null;
    return findKeyOf([p.name, p.game].concat(packFindParts(pk)));
  }
  function cfgFindWords(q){
    return String(q || '').split(/\s+/).map(normGame).filter(function(w){ return !!w; });
  }
  function cfgFindHit(key, words){
    for(var i=0;i<words.length;i++) if(String(key).indexOf(words[i]) < 0) return false;
    return true;
  }
  /* THE FIELD, one for every list that has a search (the Configs list,
     D121, and the new-config wizard's games, D125). type=search and
     enterkeyhint=search give a phone its search key; 16px text stops iOS
     zooming the page when the field is touched; no autofocus, ever, so
     opening a screen never pops a keyboard over the list the player came to
     look at. The browser's own clear control is hidden (zs-fixes.css)
     because this one is a real 44px target. `o` is the field's id, the
     words already typed, its placeholder and its spoken name; the clear key
     is the id with "-clear". */
  function findFieldHTML(o){
    var ico = pic('search', 20, 'cfgfind-ico') ||
      '<svg class="cfgfind-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" '+
      'stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15 L20 20"/></svg>';
    return '<div class="cfgfind" role="search">'+ico+
      '<input type="search" class="txt" id="'+o.id+'" data-nosave="1" value="'+esc(o.value)+'" '+
        'placeholder="'+esc(o.placeholder)+'" aria-label="'+esc(o.label)+'" '+
        'autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="search">'+
      '<button type="button" class="cfgfind-x" id="'+o.id+'-clear" aria-label="Clear search"'+
        (o.value ? '' : ' hidden')+'>×</button>'+
    '</div>';
  }
  function cfgSearchHTML(){
    return findFieldHTML({ id:'cfgsearch', value:P_QUERY, placeholder:'Search configs',
                           label:'Search configs by name or game' });
  }
  /* THE FILTER, wired, for any list drawn with findFieldHTML. Filtering
     HIDES rows in place; nothing is redrawn, so the field keeps its focus
     and the phone its keyboard. What it found is said to a screen reader
     through the app's one polite live region (ZS.announce), after a pause
     in the typing so it is said once and not once per letter.
       o.id       the field's id
       o.rows     the selector of the rows it filters; each carries its
                  words in data-find. A row outside it is never hidden,
                  which is how the wizard keeps Start from scratch.
       o.none     the id of the honest empty state, filled when nothing
                  matches; o.noneText(q) is what it says
       o.get / o.set   where the words live, so a redraw keeps them
       o.say(shown, total, q)   the sentence for the live region
       o.after()  optional, run after every filtering (the wizard hides a
                  game section the search emptied, D300 amended)
     Returns the filter, so a caller that repaints the rows under the field
     (a picture landing) can run it again over the new ones. */
  function findWire(root, o){
    var sayT = null;
    function apply(announce){
      var q0 = o.get();
      var words = cfgFindWords(q0), shown = 0, total = 0;
      root.querySelectorAll(o.rows).forEach(function(row){
        var hit = !words.length || cfgFindHit(row.getAttribute('data-find') || '', words);
        total++;
        if(hit){ shown++; row.removeAttribute('hidden'); row.style.display = ''; }
        else { row.setAttribute('hidden', ''); row.style.display = 'none'; }
      });
      var q = String(q0).replace(/^\s+|\s+$/g, '');
      var none = root.querySelector('#'+o.none);
      if(none){
        var empty = !!words.length && !shown;
        none.textContent = empty ? o.noneText(q) : '';
        if(empty){ none.removeAttribute('hidden'); none.style.display = ''; }
        else { none.setAttribute('hidden', ''); none.style.display = 'none'; }
      }
      var sx = root.querySelector('#'+o.id+'-clear');
      if(sx){ if(q0) sx.removeAttribute('hidden'); else sx.setAttribute('hidden', ''); }
      if(o.after) o.after();
      if(announce){
        clearTimeout(sayT);
        sayT = setTimeout(function(){ ZS.announce(o.say(words.length ? shown : -1, total, q)); }, 600);
      }
    }
    var sf = root.querySelector('#'+o.id), sx = root.querySelector('#'+o.id+'-clear');
    if(sf){
      sf.addEventListener('input', function(){ o.set(sf.value); apply(true); });
      sf.addEventListener('keydown', function(e){
        /* Escape empties the search first, and only an empty one lets
           Escape go on to whatever else it does on this screen */
        if(e.key==='Escape' && o.get()){
          e.preventDefault(); e.stopPropagation();
          sf.value = ''; o.set(''); apply(true);
        } else if(e.key==='Enter'){
          /* the phone's search key: put the keyboard away, the list is
             already filtered */
          e.preventDefault();
          try{ sf.blur(); }catch(x){}
        }
      });
    }
    if(sx) sx.addEventListener('click', function(){
      /* back into the field, as a phone's own search bar does: clearing
         a search is almost always the start of typing another */
      o.set('');
      if(sf){ sf.value = ''; try{ sf.focus(); }catch(x){} }
      apply(true);
    });
    apply(false);
    return apply;
  }

  R.profiles = function(p, s){
    if(s !== P_OPENED){ P_OPENED = s; P_QUERY = ''; }
    return { html:'', after: function(root){
      /* ── FOCUS ACROSS A REDRAW ────────────────────────────────────────
         draw() replaces the whole screen, so whatever the user was standing
         on is destroyed and focus falls to <body>. On this screen that is not
         a detail. This is the screen you come to in order to press the SAME
         control several times running — Reorder's ↓ three times to move a
         config three places — and without this, each press cost a full re-tab
         from the top of the panel to get back to where you already were. The
         owner uses keyboard/switch access; that is three presses becoming
         about twenty.

         FOCUS FOLLOWS THE CONFIG, NEVER THE POSITION. The naive version
         re-focuses the Nth button, and in Reorder the Nth button is the one
         control guaranteed to belong to a DIFFERENT config afterwards: press
         ↓ and the row you are moving is no longer at N, so the next press
         moves somebody else. Exactly the reason the arrows themselves carry
         an id rather than an index. Same deliberate focus move as sheetOpen()
         (phone.html), which puts focus into a sheet it has just filled. */
      function focusKey(){
        var d = root.ownerDocument || document, el = d.activeElement;
        if(!el || !el.closest || !root.contains(el)) return null;
        var b = el.closest('#orderbtn,#newcfg,#cfgsearch,#cfgsearch-clear,[data-up],[data-down],[data-edit]');
        if(b){
          if(b.id) return b.id;
          var kinds = ['up','down','edit'], i;
          for(i=0;i<kinds.length;i++)
            if(b.getAttribute('data-'+kinds[i]))
              return kinds[i]+':'+b.getAttribute('data-'+kinds[i]);
        }
        var row = el.closest('.cfg');
        return row ? 'row:'+row.getAttribute('data-open') : null;
      }
      /* by attribute VALUE rather than by selector, because a config id comes
         from the board and a quote in one would break out of [data-up="…"] */
      function byAttr(name, val){
        var L = root.querySelectorAll('['+name+']'), i;
        for(i=0;i<L.length;i++) if(L[i].getAttribute(name)===val) return L[i];
        return null;
      }
      function put(el){ if(!el) return false; try{ el.focus(); }catch(e){} return true; }
      function restoreFocus(key){
        /* NULL means focus was never in here — the reconnect redraw, or the
           very first paint while the finger is still on HOME's door. Moving
           focus then would yank it out from under whatever the user is
           actually doing. */
        if(!key) return;
        var c = key.indexOf(':');
        if(c<0){
          var el = root.querySelector('#'+key);
          /* the search field only exists outside Reorder; its clear key only
             while there is something to clear. Either way the field is where
             that hand was, so it goes there, with the caret at the end. */
          if(!el && /^cfgsearch/.test(key)) el = root.querySelector('#cfgsearch');
          put(el);
          if(el && el.id==='cfgsearch'){ try{ el.setSelectionRange(el.value.length, el.value.length); }catch(e){} }
          return;
        }
        var kind = key.slice(0,c), id = key.slice(c+1);
        /* the same control on the same config first; then that config's row
           (Done takes the arrows away, and one config takes Reorder away);
           then the way out of the mode. Never the Nth anything. */
        if(kind!=='row' && put(byAttr('data-'+kind, id))) return;
        if(put(byAttr('data-open', id))) return;
        put(root.querySelector('#orderbtn') || root.querySelector('.cfg'));
      }

      /* THE SEARCH, WIRED (D121), through the one filter findWire() is */
      function wireFind(){
        findWire(root, { id:'cfgsearch', rows:'.cfg', none:'cfgnone',
          get: function(){ return P_QUERY; }, set: function(v){ P_QUERY = v; },
          noneText: function(q){
            return 'No configs match "'+q+'". The search looks at each config’s name and its game.';
          },
          say: function(shown, total, q){
            return shown < 0 ? 'Showing all '+total+' configs'
              : shown ? shown+(shown===1 ? ' config matches' : ' configs match')
              : 'No configs match '+q;
          } });
      }

      function draw(){
        /* "this screen now agrees with the array" — said HERE rather than by
           each caller, so no path can repaint the list and leave phone.html
           thinking it is still stale (which would redraw it a second time). */
        ZS.noteProfileList();
        var PR = ZS.PROFILES, act = ZS.activeId, h = '';
        var refocus = focusKey();     /* read BEFORE the innerHTML wipe */
        /* ONE config is a different screen, and it has to say so. Reorder
           cannot order one thing and there is nothing to switch to, so
           neither word is offered — the same honesty HOME's door already
           keeps ("… is your only config — tap to add another"). A user must
           never be told to do something the screen cannot do. */
        var one = PR.length<=1;
        /* and never left stranded INSIDE a mode whose only exit button has
           just stopped being drawn (delete down to one while reordering) */
        if(one) P_ORDER = false;
        /* Reorder moves a row past its neighbours, so it has to see all of
           them: entering it drops the search, and so does a list of one,
           which has nothing to search. */
        if(one || P_ORDER) P_QUERY = '';
        /* The panel header above already says "Configs" — this heading must
           not say it a second time. It said "Your configs — tap to switch",
           which restated the title 40px below it AND wrapped to two lines at
           375px. What is left is the one thing the title cannot say: what
           tapping a row actually does. */
        h += '<div class="grp">'+(one ? 'Just this one so far' : 'Tap to switch')+
             (one ? '' : '<button class="gact" id="orderbtn">'+
                         (P_ORDER?'Done':'Reorder')+'</button>')+
             '</div>';
        /* ➕ NEW CONFIG CAME UP FROM THE FLOOR (2026-08-18). It used to sit
           BELOW every row — fifteen of them on this rig — and below the
           explanation under those, so the one action on this screen that is
           not "tap a row" was the one thing you had to scroll to find. It
           keeps its id and its .newcfg class (emulate-app.js selects on the
           class; four tests select on the id), and takes the solid ion face
           in zs-fixes.css: this is the third element in the app allowed to
           wear it, and it qualifies on the same terms as the other two —
           press it and a thing happens. */
        h += '<div class="newcfg" id="newcfg">'+(pic('plus', 18, 'sicon si-plus')||'＋ ')+'New config</div>';
        /* the search sits right on top of the rows it filters (D121) */
        if(!one && !P_ORDER) h += cfgSearchHTML();
        /* D133: storage, on a Core only (an EXO's configs are JSON on its
           SD card and it reports no sizes). A config the Core could not load
           (not enough memory, say; the one before it keeps running) is the
           first thing this screen says, in the Core's own sentence. */
        var core = !!(ZS.productId && ZS.productId()==='core' && window.ZSROOM);
        var loadErr = core ? ZSROOM.storage().loadError : '';
        if(loadErr) h += note(esc(loadErr), 'warn');
        PR.forEach(function(p){
          var on = p.id===act;
          var sz = core ? ZSROOM.configBytes(p.id) : -1;
          /* THE LEFT EDGE IS THE FAMILY, NOT THE CONFIG'S PERSONAL COLOUR.
             Every row was carrying TWO colour systems at once: this 4px edge
             in the arbitrary per-config colour (blue, purple, teal, orange,
             pink — chosen from a palette by creation order) AND a family
             badge on the idline. So blue on the edge and blue in the badge
             meant different things, on the same row, 40px apart, and neither
             could be trusted. docs/DESIGN.md's rule that outranks the rest:
             decoration does not get to overwrite a signal. The personal
             colour is NOT lost — it already rides the tile art as --cfg
             (phone.html artHTML), which is where a memory aid belongs; the
             edge now answers "which console is this" exactly the way HOME's
             hero edge already does, so the two screens finally agree. */
          var fam = (ZS.PB && ZS.PB[p.platform] && ZS.PB[p.platform].c) || 'var(--steel)';
          var platLabel = (ZS.PB && ZS.PB[p.platform] && ZS.PB[p.platform].t) ||
                         (ZS.CON && ZS.CON[p.platform]) || p.platform || '';
          /* D300 amended: a config for an unfinished game wears the picker's
             "Coming soon" badge under its name, always; locked (no developer
             mode) its picture is grey like the picker's tile and a tap only
             says so (ZS.configGate below) */
          var soonB = ZS.configSoonBadge ? ZS.configSoonBadge(p, 'margin-top:3px') : '';
          var locked = !!(ZS.configLocked && ZS.configLocked(p));
          /* THE ROW IS THE NAME AND THE PICTURE (D121; the owner: "it should
             just say the config name, it should also have the picture of
             the config"). The identity line under the name (console, way to
             play, game) is gone from the eye; HOME and the Overview still
             print all three, and this row still SPEAKS all three in its
             label, because the picture says nothing to a screen reader.
             The picture is WIDE, the shape of the game's own Steam header,
             so the game's art fills it whole; a photo or our own mark takes
             the same slot. data-find is what the search matches. */
          h += '<div class="cfg'+(soonB?' csoon':'')+(locked?' clocked':'')+'" data-open="'+p.id+'" data-find="'+esc(cfgFindKey(p))+'"'+
                 (on?' aria-current="true"':'')+
                 (locked?' aria-disabled="true"':'')+
                 ' style="border-left-color:'+fam+'"'+
                 ' aria-label="'+esc(p.name)+' — '+esc(ZS.CON[p.platform]||'')+', '+
                   esc(ZS.INP[p.input]||'')+
                   (p.game ? ', for '+esc(p.game) : '')+
                   (on?', playing now':'')+
                   (sz>0?', takes '+esc(ZSROOM.words(sz))+' on your Core':'')+
                   (p.unreadable?', its settings cannot be opened here':'')+
                   (soonB?', '+esc(String(ZS.configStatusWords ? ZS.configStatusWords(p) : 'not ready').toLowerCase()):'')+'">'+
                 ZS.artHTML(p, 52, {shape:'wide'})+
                 /* THE STATE PILL SITS UNDER THE NAME, NOT BESIDE IT. As a
                    sibling of .cn it was a flex:none 87px column, so on the
                    one row that carries it the name and the identity line
                    were squeezed to 80px — the row you most want to read
                    clearly was the only one that clipped. Inside .cn it costs
                    the name nothing and sits next to the identity it
                    describes.
                    The tick AND the word, never colour alone — for eyes.
                    aria-hidden because the row's own aria-label above already
                    ends with "playing now": without this a screen reader says
                    the config's state twice, the second time as "Playingnow". */
                 '<span class="cn"><span class="name">'+esc(p.name)+'</span>'+
                   /* the console under the name (owner, 2026-10-21); the dot
                      wears the family colour, the words stay readable */
                   (platLabel?'<span class="cpf" aria-hidden="true" '+
                     'style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)">'+
                     '<i style="width:7px;height:7px;border-radius:50%;flex:none;background:'+fam+'"></i>'+
                     esc(platLabel)+'</span>':'')+
                   (soonB?'<span class="csoon-b" aria-hidden="true" style="display:block">'+soonB+'</span>':'')+
                   /* D124: listed although its copy could not be read; the
                      sentence and what can still be done are behind › */
                   (p.unreadable?'<span class="cunread" aria-hidden="true" '+
                     'style="display:block;color:var(--amber);font-size:12px">'+
                     'Settings cannot be opened</span>':'')+
                   /* D133: what it takes on the Core. D121 made the row the
                      name and the picture; the size is the one fact the owner
                      asked to see per config, so it rides under the name in
                      the muted caption, and the label above speaks it */
                   (sz>0?'<span class="csize" aria-hidden="true" '+
                     'style="display:block;color:var(--muted);font-size:12px;'+
                     'font-variant-numeric:tabular-nums">'+esc(ZSROOM.words(sz))+
                     ' on your Core</span>':'')+
                   (on?'<span class="cstate" aria-hidden="true">'+
                       '<span class="tick">✓</span>Playing<br>now</span>':'')+
                 '</span>'+
                 /* The arrows carry the config's ID, not the position it had
                    when this was drawn. ZS.PROFILES is shared and gets
                    REPLACED underneath this screen on a reconnect, and an
                    index captured before that swaps two configs the user
                    never touched — silently, and then saves it. */
                 (P_ORDER
                   ? '<button class="ib" data-up="'+p.id+'" aria-label="Move '+esc(p.name)+' up">↑</button>'+
                     '<button class="ib" data-down="'+p.id+'" aria-label="Move '+esc(p.name)+' down">↓</button>'
                   : '<button class="ib" data-edit="'+p.id+'" aria-label="Edit '+esc(p.name)+'">›</button>')+
               '</div>';
        });
        /* the search's honest empty state, filled and shown by applyFind() */
        h += '<div class="note cfgnone" id="cfgnone" hidden style="display:none"></div>';
        /* D133: the Core's storage as a whole, from its /status (an older
           Core's from its own caps and the list's sizes), under the list it
           describes. D135, one shared pool and no count: "Core storage:
           5.9 MB left of 6 MB. Your 7 configs use 52 KB." */
        var stored = core ? ZSROOM.storageSentence() : '';
        if(stored) h += '<div class="note" id="cfgstore" style="margin:8px 0 0;'+
          'font-variant-numeric:tabular-nums">'+esc(stored)+'</div>';
        /* The config that loads at power-on IS the active one: the board boots
           state.json's activeProfileId, which persists across restarts. ONE
           explanatory block, never a stack of them — the power-on fact and,
           for someone who has only ever seen one config, what a config even
           IS are both reading matter, not controls. Merged, they read once
           and stop. This sentence points AT the list, which is why it
           travelled here with it rather than staying on HOME beside a hero
           that has no list to point at.

           It names the badge, and the badge now has ONE name. The pill used
           to print "LIVE" (zs-fixes.css §1 prints it from ::after, because
           the full words over three lines ate the width config names needed)
           while HOME's badge on the same config said "Playing now" — so this
           sentence had to name both words to be understood, which is the
           tell that one state had two names. The pill says PLAYING, HOME
           says Playing now, the row's accessible label ends "playing now",
           and this sentence names the word all three share. */
        var explain = '<b>PLAYING</b> marks the config playing now — the one your '+
                      'ZeroStick loads when you power it on.';
        /* a first-time reader has no idea what a "config" is — say it once, here.
           It ends by pointing FORWARD ("once you have more than one…") rather
           than telling someone with a single config to tap a config to switch
           to it: they have nothing to switch to, and the heading above has
           just stopped pretending otherwise. */
        if(one){
          explain += '<span style="display:block;margin-top:7px">A <b>config</b> is one saved setup: '+
                     'which console, what each button does, and how your aiming feels. Make one for '+
                     'each game you play — once you have more than one, tapping a config here '+
                     'switches to it instantly.</span>';
        }
        h += '<div class="note" style="margin:8px 0 0">'+explain+'</div>';

        /* data-ns is untouched here, so zs-anim reads this as a REFRESH, not
           navigation, and the rows never replay their entrance stagger — the
           same contract R.global's render() keeps. */
        root.innerHTML = h;
        ZS.wire(root, 'global/profiles');   /* also runs wireArt: a 404'd photo
                                               becomes the family mark, never a
                                               broken-image icon */
        wireFind();
        root.querySelectorAll('.cfg').forEach(function(el){
          el.addEventListener('click', function(e){
            if(e.target.closest('.ib')) return;
            var id = el.dataset.open;
            /* D300 amended: a config for an unfinished game is not made
               active from here without developer mode; nothing changes */
            if(ZS.configGate && ZS.configGate(ZS.prof(id))) return;
            var prevActive = ZS.activeId;
            /* Optimistic, and the ORDER matters: ZS.setActive persists and
               calls renderHome(), which re-reads every p.color from the board
               document — so it has to run BEFORE draw(), or this list paints
               yesterday's stripe colours.
               It returns false when that config is no longer in the list, the
               one case this row can be a lie: the board answered between the
               draw and the tap and replaced every config. Repaint what is
               really there rather than activating a config that does not
               exist — and send nothing to the board. */
            if(ZS.setActive(id)===false){
              draw();
              ZS.toast('That config is gone — this is what your ZeroStick has now');
              return;
            }
            draw();
            /* a config listed without a readable copy (D124) is still on
               the board, and switching to it needs no copy at all */
            if(ZS.live.online!==false && (ZS.live.full[id] ||
               (ZS.prof(id) && ZS.prof(id).unreadable))){
              ZS.api('/profiles/'+encodeURIComponent(id)+'/activate', 'POST', {}).then(function(j){
                if(j.ok){ ZS.toast('"'+((ZS.prof(id) || {}).name || 'That config')+'" is now live on the board');
                          /* HOME TOO, not just this list. renderHomeIfVisible()
                             is the 8 s tick's only route to renderHome() and it
                             returns early while this panel is open, so nothing
                             else repaints the hero's live line — which names
                             the running backend and the uptime. Repainting only
                             the list left that line describing the config we
                             just switched AWAY from, visible the moment the
                             panel closed. draw() first, so its noteProfileList()
                             makes renderHome()'s own list-changed check find
                             nothing to do rather than drawing this screen a
                             second time (same order as move()). */
                          ZS.refreshStatus().then(function(){ draw(); ZS.renderHome(); }); }
                else {
                  /* the board did NOT switch — put the tick back where it belongs
                     rather than showing a config that isn't running */
                  ZS.setActive(prevActive); draw();
                  /* m12: the list may have been replaced while the switch was
                     in flight, and prevActive with it */
                  var was = ZS.prof(ZS.activeId) || ZS.prof(prevActive);
                  var wasName = was ? was.name : 'your last config';
                  ZS.toast(ZS.live.online===false
                    ? 'Couldn’t reach your ZeroStick — still on "'+wasName+'"'
                    : 'Board kept "'+wasName+'": '+(j.error||'switch failed'));
                }
              });
            }
          });
          ZS.kb(el);
        });
        root.querySelectorAll('[data-edit]').forEach(function(b){
          b.addEventListener('click', function(){
            /* CLOSE THIS PANEL FIRST. The list lives in #dbody now, inside
               #detail — z-index 30, opaque, inset:0 — and #editor is z-index
               20, so an editor opened while the panel is still up slides in
               BEHIND the list and the tap looks dead. syncInert() then makes
               it worse for the people this product is for: `ed.inert =
               !edOpen || dtOpen` (phone.html) takes the covered editor out of
               the tab order too, so a keyboard or screen-reader user gets no
               focus move and nothing announced at all. On HOME these rows had
               nothing above them and openEditor alone was enough; here it is
               not. Same two lines, same order, as the New Config wizard when
               it lands on the editor for the config it just made.
               This is the ONLY way into a config that is not the playing one
               — HOME's hero edits the active one — and therefore the only way
               to its Delete. */
            /* D300 amended: nor is its editor opened (openEditor checks too) */
            if(ZS.configGate && ZS.configGate(ZS.prof(b.dataset.edit))) return;
            ZS.closeDetail();
            ZS.openEditor(b.dataset.edit);
          });
        });
        /* Move by ID, never by the position the row had when it was drawn: a
           captured index applied to a list that has since been REPLACED (the
           reconnect) reorders two configs the user never touched and saves
           it, with nothing on screen to say so. If the id has gone, so has
           the row — do nothing. */
        function move(id, dir){
          var L=ZS.PROFILES, i=-1, k;
          for(k=0;k<L.length;k++) if(L[k].id===id) i=k;
          var j=i+dir;
          if(i<0 || j<0 || j>=L.length) return;
          var t=L[j]; L[j]=L[i]; L[i]=t;
          /* M28 (audit 2026-10-10): the order is kept as ids too, because the
             next list from the board (every boot and reconnect) replaces
             this array in the board's order; loadLive sorts by it */
          ZS.store.vals.configOrder = L.map(function(p){ return p.id; });
          ZS.persistStore();
          /* draw() BEFORE renderHome(): draw() tells phone.html this screen
             now agrees with the array, so renderHome()'s own list-changed
             check finds nothing to do rather than drawing it a second time.
             No colour dependency here — reordering changes no stripe. */
          draw(); ZS.renderHome();
          /* Say where it landed, politely, into the live region the app
             already has — draw() has just put focus back on the SAME arrow
             for the SAME config, which is right for the hand and silent for
             the ear: the button's own label ("Move Warzone down") reads
             identically before and after. Position and total, because "moved
             down" alone never tells you when you have reached the end. */
          ZS.announce(L[j].name+' moved to position '+(j+1)+' of '+L.length);
        }
        root.querySelectorAll('[data-up]').forEach(function(b){
          b.addEventListener('click', function(){ move(b.dataset.up, -1); });
        });
        root.querySelectorAll('[data-down]').forEach(function(b){
          b.addEventListener('click', function(){ move(b.dataset.down, 1); });
        });
        var ob = root.querySelector('#orderbtn');
        if(ob) ob.addEventListener('click', function(){ P_ORDER=!P_ORDER; draw(); });
        var nc = root.querySelector('#newcfg');
        if(nc){
          nc.addEventListener('click', function(){
            /* Cancel must land back on the list you came from, not on HOME —
               and it must still do so after the screen has been rebuilt.
               onBack rides ON THE DESCRIPTOR rather than in a setDetail()
               call made afterwards: devbar.js calls ZS.redrawOpenScreen()
               whenever the connected pad's family changes, which re-enters
               openDetail() with this same object. The old setDetail() version
               was nulled by that redraw while the "‹ Configs" label was
               restored from backLabel — a back button that said Configs and
               closed to HOME. Plugging in the pad you are making the config
               FOR is the natural thing to do on that screen, so it happened
               to whoever used the wizard properly. */
            wzReset();   /* fresh entry starts the wizard clean; the pad-family
                            redraw re-enters R['new'] WITHOUT coming through
                            here, so mid-wizard state survives it (P_ORDER) */
            ZS.openDetail({ id:'new', lab:'New config', backLabel:'‹ Configs',
              onBack:function(){ ZS.openDetail({id:'profiles', lab:'Configs'}); } });
          });
          ZS.kb(nc);
        }
        /* last, so every control it can land on is wired and keyboard-ready */
        restoreFocus(refocus);
      }
      draw();
      /* Registered after the first paint, so the signature phone.html
         compares against is the one actually on screen. From here on, the
         ONE thing that reaches this screen through the panel is the list
         being replaced — see syncProfileList() and the note at the top. */
      ZS.watchProfileList(draw);
      /* ...and one more (D121): a game pack's picture that lands after the
         first paint (the pictures load at boot, and a quick finger can beat
         them here). HOME repaints for it, but HOME's repaint stops at an
         open panel, so this list repaints itself, only while it is still on
         screen (only its rows carry data-find) and never under a finger
         that is typing in its search. One subscription at a time: the
         previous screen's is dropped before this one is taken. */
      if(P_ARTSUB) P_ARTSUB();
      P_ARTSUB = window.ZSPACKS ? ZSPACKS.onChange(function(){
        if(!root.querySelector('.cfg[data-find]')){ if(P_ARTSUB) P_ARTSUB(); P_ARTSUB = null; return; }
        var d = root.ownerDocument || document;
        if(d.activeElement && d.activeElement.id === 'cfgsearch') return;
        draw();
      }) : null;
    }};
  };

  /* what the other screen files use from this one */
  SEC.findFieldHTML = findFieldHTML;
  SEC.findKeyOf = findKeyOf;
  SEC.findWire = findWire;
  SEC.packFindParts = packFindParts;
});
