    scriptSet: function (slot, bytes16) {
      var b = u8(bytes16), f = new Uint8Array(17);
      if (b.length !== 16) { return Promise.reject(new Error('a script is 16 bytes')); }
      f[0] = slot; f.set(b, 1);
