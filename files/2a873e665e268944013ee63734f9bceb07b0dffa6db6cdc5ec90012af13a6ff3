/* hid-ble.js — the ZeroStick Dongle's Bluetooth link (window.ZSHIDBLE).
 *
 * ES5 ONLY, like the rest of the app.
 *
 * The ZeroStick Dongle (WCH CH582F/CH592F) does two jobs, both over one
 * Bluetooth service:
 *   1. Calibration: it is a USB host to the controller and relays HID
 *      reports, the same five calls as the old ESP32 Wi-Fi calibrator's
 *      /hid/* web addresses (hid-proxy.js turns them into navigator.hid).
 *   2. Script Edition: it keeps 8 scripts and drives the stick flex
 *      (L2 = aim pattern, L2+R2 = anti-recoil).
 *
 * Firmware: DSE Recoil Mod firmware/dongle/src/app.c. Protocol:
 * docs/CALIBRATION-DONGLE.md and docs/STICK-LINK.md in that repo.
 *
 *   CMD write  [op][seq][payload]          RSP notify [op][seq][status][data]
 *   0x01 DEV   -                           connected(1) vid(2 LE) pid(2 LE)
 *   0x02 SFR   [id][data...]               -
 *   0x03 GFR   [id][len]                   report bytes, byte 0 = id
 *   0x04 SOR   [id][data...]               -
 *   0x05 INPUT [hz] (0 = stop)             reports stream on INPUT notify
 *   0x10 INFO  -                           "zerostick-dongle <version>"
 *   0x11 DEVINFO -                         20 bytes (version, chip, pad, flex, power)
 *   0x20 SCRIPT_SET    [slot][script 16]   -
 *   0x21 SCRIPT_GET    [slot]              script 16
 *   0x22 SCRIPT_SELECT [slot]              -
 *   0x23 LINK          -                   state, flex fw, enabled, slot, act, flex flags
 *   0x24 ENABLE        [0/1]               -
 *   0x25 FORGET        -                   - (pair the next flex held close)
 *   0x26 FLEX_CAL      [cmd]               12 bytes (stick flex setup)
 *   0x30-0x34 OTA_BEGIN / DATA / END / ABORT / STATUS (dongle firmware update)
 *   0x38-0x3C the same for the stick flex, relayed by the dongle (0x3C STATUS
 *             is 14 bytes: phase, error, percent, done, size, version)
 *   status: 0 ok, 1 no controller, 2 USB error, 3 bad command, 4 too big
 *   for the MTU, 5 busy, 6 flash error [reason], 7 OTA bad [reason][next u32]
 *   (firmware 0.9.0; the error's .data holds the status's data bytes)
 *
 * Which Bluetooth it uses:
 *   - inside the app: the native plugin (Capacitor BluetoothLe) DIRECTLY,
 *     so a dongle picked once is remembered and reconnected silently on
 *     every page (dongle.html -> calibrator.html) with no chooser;
 *   - in desktop Chrome: real Web Bluetooth (navigator.bluetooth);
 *   - with js/zs-dongle-mock.js loaded (?mock=1): the simulated dongle.
 */
(function () {
  'use strict';

  function zsUuid(n) {
    var h = ('0000' + n.toString(16)).slice(-4);
    return '5a53' + h + '-5a53-4f4b-9c2b-1e5d0e0d0a00';
  }
  var SVC = zsUuid(1), CHR_CMD = zsUuid(2), CHR_RSP = zsUuid(3), CHR_IN = zsUuid(4);
  var OP = { DEV: 1, SFR: 2, GFR: 3, SOR: 4, INPUT: 5, INFO: 0x10,
             /* Script Edition (DSE Recoil Mod docs/STICK-LINK.md) */
             SCRIPT_SET: 0x20, SCRIPT_GET: 0x21, SCRIPT_SELECT: 0x22,
             LINK: 0x23, ENABLE: 0x24, FORGET: 0x25, FLEX_CAL: 0x26,
             DEVINFO: 0x11,
             OTA_BEGIN: 0x30, OTA_DATA: 0x31, OTA_END: 0x32, OTA_ABORT: 0x33, OTA_STATUS: 0x34,
             FLEX_OTA_BEGIN: 0x38, FLEX_OTA_DATA: 0x39, FLEX_OTA_END: 0x3A, FLEX_OTA_ABORT: 0x3B,
             FLEX_OTA_STATUS: 0x3C };
  /* END checks a ~200 KB signature (~1 s): give those answers longer */
  var SLOW_OPS = { 0x32: 8000, 0x3A: 8000 };
  /* link state 0 = the dongle's Bluetooth central is still starting (first
     ~1 s after power-up); 5 = no stick flex remembered (never paired) */
  var LINK_STATES = ['starting', 'searching', 'connecting', 'setting up', 'connected', 'no flex'];
  var ACTS = ['idle', 'aim', 'recoil'];
  var STATUS_TEXT = ['ok', 'no controller plugged into the dongle',
                     'the controller did not answer', 'the dongle did not understand',
                     'the answer was too big for this Bluetooth link', 'the dongle was busy',
                     'the dongle could not save', 'the firmware update was refused'];
  var STATUS_KIND = ['', 'no-pad', 'usb', 'dongle', 'too-big', 'busy', 'flash', 'ota'];
  var TIMEOUT_MS = 3000;
  var REMEMBER_KEY = 'zsDongle';

  var state = {
    device: null, cmd: null, rsp: null, inp: null,
    connected: false, seq: 0, pending: {}, queue: Promise.resolve(),
    onInput: null, onDisconnect: [], onConnect: [], info: null, quiet: false
  };

  function u8(data) {
    if (data instanceof Uint8Array) { return data; }
    if (data instanceof ArrayBuffer) { return new Uint8Array(data); }
    if (data && data.buffer) { return new Uint8Array(data.buffer, data.byteOffset || 0, data.byteLength); }
    return new Uint8Array(data || []);
  }

  function zsErr(kind, msg) {
    var e = new Error(msg);
    e.zsKind = kind;
    return e;
  }

  /* ── The native plugin, wrapped in the small slice of the Web Bluetooth
        API this file uses. Not exo/zs-ble-cap.js: that one can only open
        the chooser, and a remembered dongle must reconnect without it. ── */
  function nativePlugin() {
    var c = window.Capacitor;
    if (window.ZS_DONGLE_MOCK) { return null; }
    if (!c || !c.isNativePlatform || !c.isNativePlatform()) { return null; }
    return (c.Plugins && c.Plugins.BluetoothLe) || null;
  }
  function platform() {
    var c = window.Capacitor;
    return (c && c.getPlatform && c.getPlatform()) || 'web';
  }

  function hexToU8(hex) {
    var out = [], i;
    hex = String(hex || '').replace(/[^0-9a-f]/gi, '');
    for (i = 0; i + 1 < hex.length; i += 2) { out.push(parseInt(hex.substr(i, 2), 16)); }
    return new Uint8Array(out);
  }
  function u8ToHex(b) {
    var s = '', i, h;
    b = u8(b);
    for (i = 0; i < b.length; i++) { h = b[i].toString(16); s += (h.length < 2 ? '0' : '') + h; }
    return s;
  }

  function Listeners() { this._l = {}; }
  Listeners.prototype.addEventListener = function (t, fn) { (this._l[t] = this._l[t] || []).push(fn); };
  Listeners.prototype.removeEventListener = function (t, fn) {
    var a = this._l[t] || [], i = a.indexOf(fn);
    if (i >= 0) { a.splice(i, 1); }
  };
  Listeners.prototype.emit = function (t, ev) {
    var a = (this._l[t] || []).slice(), i;
    for (i = 0; i < a.length; i++) { try { a[i](ev); } catch (e) { /* keep going */ } }
  };

  function NativeChar(dev, uuid) {
    Listeners.call(this);
    this.dev = dev; this.uuid = uuid;
  }
  NativeChar.prototype = Object.create(Listeners.prototype);
  NativeChar.prototype.writeValueWithResponse = function (data) {
    return this.dev.ble.write({ deviceId: this.dev.id, service: SVC, characteristic: this.uuid,
                                value: u8ToHex(data), timeout: TIMEOUT_MS });
  };
  NativeChar.prototype.startNotifications = function () {
    var self = this, ble = this.dev.ble;
    var key = 'notification|' + self.dev.id + '|' + SVC + '|' + self.uuid;
    return Promise.resolve(ble.addListener(key, function (ev) {
      var v = hexToU8(ev && ev.value);
      self.emit('characteristicvaluechanged', { target: { value: new DataView(v.buffer) } });
    })).then(function (h) {
      self.dev.handles.push(h);
      return ble.startNotifications({ deviceId: self.dev.id, service: SVC, characteristic: self.uuid });
    });
  };

  function NativeDevice(ble, id, name) {
    var self = this;
    Listeners.call(this);
    this.ble = ble; this.id = id; this.name = name || 'ZeroStick Dongle';
    this.handles = [];
    this.gatt = {
      connect: function () { return self._connect(); },
      disconnect: function () {
        self._drop();
        return ble.disconnect({ deviceId: id }).then(function () {}, function () {});
      },
      getPrimaryService: function () {
        return Promise.resolve({
          getCharacteristic: function (u) { return Promise.resolve(new NativeChar(self, String(u).toLowerCase())); }
        });
      }
    };
  }
  NativeDevice.prototype = Object.create(Listeners.prototype);
  NativeDevice.prototype._drop = function () {
    this.handles.forEach(function (h) { try { if (h && h.remove) { h.remove(); } } catch (e) { /* gone */ } });
    this.handles = [];
  };
  NativeDevice.prototype._connect = function () {
    var self = this, ble = this.ble;
    var already = ble.getConnectedDevices ?
      ble.getConnectedDevices({ services: [SVC] }).then(function (r) {
        return ((r && r.devices) || []).some(function (d) { return d.deviceId === self.id; });
      }, function () { return false; }) : Promise.resolve(false);
    return Promise.resolve(ble.addListener('disconnected|' + self.id, function () {
      self._drop();
      self.emit('gattserverdisconnected', {});
    })).then(function (h) {
      self.handles.push(h);
      return already;
    }).then(function (isUp) {
      /* the previous page left it connected: adopt it, no new connection */
      if (isUp) { return null; }
      return ble.connect({ deviceId: self.id, timeout: 10000 });
    }).then(function () { return self.gatt; });
  };

  /* ── Getting Bluetooth ready: permission + switched on ─────────────── */
  var nativeReady = null;
  function prepare() {
    var ble = nativePlugin();
    if (ble) {
      if (!nativeReady) {
        /* Android 12+ asks for "Nearby devices" here; iOS asks the first
           time Bluetooth is used. */
        nativeReady = Promise.resolve(ble.initialize({ androidNeverForLocation: true }))
          .then(null, function (e) {
            nativeReady = null;
            throw zsErr('permission', (e && e.message) || 'Bluetooth permission was not given');
          });
      }
      return nativeReady.then(function () {
        return ble.isEnabled();
      }).then(function (r) {
        if (r && r.value) { return; }
        if (platform() === 'android' && ble.requestEnable) {
          /* Android shows its own "Turn on Bluetooth?" box */
          return ble.requestEnable().then(function () { return ble.isEnabled(); }).then(function (r2) {
            if (!(r2 && r2.value)) { throw zsErr('bt-off', 'Bluetooth is off'); }
          }, function () { throw zsErr('bt-off', 'Bluetooth is off'); });
        }
        throw zsErr('bt-off', 'Bluetooth is off');
      }, function (e) {
        if (e && e.zsKind) { throw e; }
        /* iOS answers isEnabled with an error while permission is denied */
        throw zsErr('permission', (e && e.message) || 'Bluetooth permission was not given');
      });
    }
    if (!navigator.bluetooth) {
      return Promise.reject(zsErr('unsupported', 'Bluetooth is not available here'));
    }
    if (navigator.bluetooth.getAvailability) {
      return navigator.bluetooth.getAvailability().then(function (ok) {
        if (!ok) { throw zsErr('bt-off', 'Bluetooth is off'); }
      }, function () {});
    }
    return Promise.resolve();
  }

  /* ── Remembered dongle (per phone) ──────────────────────────────────── */
  function remembered() {
    try { return JSON.parse(localStorage.getItem(REMEMBER_KEY) || 'null'); } catch (e) { return null; }
  }
  function remember(dev) {
    try { localStorage.setItem(REMEMBER_KEY, JSON.stringify({ id: dev.id, name: dev.name || 'ZeroStick Dongle' })); } catch (e) { /* private mode */ }
  }
  function forgetRemembered() {
    try { localStorage.removeItem(REMEMBER_KEY); } catch (e) { /* private mode */ }
  }

  /* ── Command / answer ───────────────────────────────────────────────── */
  function failAll(msg) {
    for (var k in state.pending) {
      if (Object.prototype.hasOwnProperty.call(state.pending, k)) {
        clearTimeout(state.pending[k].timer);
        state.pending[k].reject(zsErr('disconnected', msg));
      }
    }
    state.pending = {};
  }

  function onRsp(dv) {
    var b = u8(dv), p;
    if (b.length < 3) { return; }
    p = state.pending[b[1]];
    if (!p || p.op !== b[0]) { return; }      /* late answer to a timed-out call */
    delete state.pending[b[1]];
    clearTimeout(p.timer);
    if (b[2] !== 0) {
      var e = new Error(STATUS_TEXT[b[2]] || ('dongle error ' + b[2]));
      e.status = b[2];
      e.zsKind = STATUS_KIND[b[2]] || 'dongle';
      e.data = b.slice(3);
      p.reject(e);
    } else {
      p.resolve(b.slice(3));
    }
  }

  /* One command at a time: the dongle answers in order and holds one
     command buffer, and dualshock-tools awaits every call anyway. */
  function call(op, payload) {
    var waitMs = SLOW_OPS[op] || TIMEOUT_MS;
    var run = function () {
      if (!state.connected) { return Promise.reject(zsErr('disconnected', 'the dongle is not connected')); }
      var seq = state.seq = (state.seq + 1) & 0xff;
      var body = u8(payload || []);
      var frame = new Uint8Array(2 + body.length);
      frame[0] = op; frame[1] = seq; frame.set(body, 2);
      return new Promise(function (resolve, reject) {
        state.pending[seq] = {
          op: op, resolve: resolve, reject: reject,
          timer: setTimeout(function () {
            delete state.pending[seq];
            reject(zsErr('timeout', 'the dongle did not answer'));
          }, waitMs)
        };
        state.cmd.writeValueWithResponse(frame).catch(function (e) {
          if (state.pending[seq]) {
            clearTimeout(state.pending[seq].timer);
            delete state.pending[seq];
            reject(e);
          }
        });
      });
    };
    var tries = 0;
    var runRetry = function () {
      return run().then(null, function (e) {
        if (e && e.status === 5 && tries++ < 6) {
          return new Promise(function (r) { setTimeout(r, 80); }).then(runRetry);
        }
        throw e;
      });
    };
    var p = state.queue.then(runRetry, runRetry);
    state.queue = p.then(function () {}, function () {});
    return p;
  }

  function u16(b, i) { return b[i] | (b[i + 1] << 8); }
  function i16(b, i) { var v = u16(b, i); return v > 32767 ? v - 65536 : v; }
  function u32(b, i) { return (b[i] | (b[i + 1] << 8) | (b[i + 2] << 16) | (b[i + 3] << 24)) >>> 0; }
  function le32(v) { return [v & 255, (v >>> 8) & 255, (v >>> 16) & 255, (v >>> 24) & 255]; }
  var CHIPS = { 0x92: 'CH592F', 0x82: 'CH582' };
  var PAD_STATES = ['none', 'starting', 'ready', 'not supported', 'switched off'];
  var CAL_STATES = ['idle', 'waiting', 'running', 'done', 'failed'];

  function onGone() {
    var was = state.connected;
    state.connected = false;
    failAll('the dongle disconnected');
    if (!was || state.quiet) { return; }
    state.onDisconnect.forEach(function (fn) { try { fn(); } catch (e) { /* keep going */ } });
  }

  /* Open the service on a picked/remembered device and check it is ours. */
  function attach(device) {
    state.device = device;
    device.addEventListener('gattserverdisconnected', function () {
      if (state.device === device) { onGone(); }
    });
    return device.gatt.connect().then(function (server) {
      return server.getPrimaryService(SVC);
    }).then(function (svc) {
      return Promise.all([svc.getCharacteristic(CHR_CMD), svc.getCharacteristic(CHR_RSP),
                          svc.getCharacteristic(CHR_IN)]);
    }).then(function (cs) {
      state.cmd = cs[0]; state.rsp = cs[1]; state.inp = cs[2];
      cs[1].addEventListener('characteristicvaluechanged', function (e) { onRsp(e.target.value); });
      cs[2].addEventListener('characteristicvaluechanged', function (e) {
        if (state.onInput) { state.onInput(u8(e.target.value)); }
      });
      return cs[1].startNotifications();
    }).then(function () {
      return state.inp.startNotifications();
    }).then(function () {
      state.connected = true;
      return call(OP.INFO);
    }).then(function (info) {
      var text = '';
      for (var i = 0; i < info.length; i++) { text += String.fromCharCode(info[i]); }
      if (text.indexOf('zerostick-dongle') !== 0) {
        throw zsErr('not-ours', 'that is not a ZeroStick dongle');
      }
      state.info = { text: text, version: text.replace(/^zerostick-dongle\s*/, '') || '?',
                     name: device.name || 'ZeroStick Dongle', id: device.id };
      remember(device);
      state.onConnect.forEach(function (fn) { try { fn(state.info); } catch (e) { /* keep going */ } });
      return text;
    }).then(null, function (e) {
      /* half-open link: close it so the next try starts clean */
      state.connected = false;
      state.quiet = true;
      try { device.gatt.disconnect(); } catch (x) { /* already gone */ }
      state.quiet = false;
      throw e;
    });
  }

  /* Pick a dongle (Bluetooth chooser). Needs a tap in a browser. */
  function connect() {
    if (state.connected) { return Promise.resolve(state.info.text); }
    return prepare().then(function () {
      var ble = nativePlugin();
      if (ble) {
        return ble.requestDevice({ services: [SVC], optionalServices: [SVC] }).then(function (raw) {
          if (!raw || !raw.deviceId) { throw zsErr('cancelled', 'No dongle was picked (cancelled)'); }
          return new NativeDevice(ble, raw.deviceId, raw.name);
        }, function (e) {
          var m = (e && e.message) || '';
          throw zsErr(/cancel/i.test(m) ? 'cancelled' : 'not-found', m || 'No dongle found');
        });
      }
      return navigator.bluetooth.requestDevice({
        filters: [{ services: [SVC] }], optionalServices: [SVC]
      }).then(null, function (e) {
        var m = (e && e.message) || String(e);
        throw zsErr(/cancel/i.test(m) || (e && e.name === 'NotFoundError') ? 'cancelled' : 'other', m);
      });
    }).then(attach);
  }

  /* Reconnect the remembered dongle without a chooser. Rejects (kind
     'none') when there is nothing remembered or this browser can't. */
  function reconnect() {
    if (state.connected) { return Promise.resolve(state.info.text); }
    var mem = remembered();
    if (!mem || !mem.id) { return Promise.reject(zsErr('none', 'no dongle remembered')); }
    return prepare().then(function () {
      var ble = nativePlugin();
      if (ble) {
        /* iOS only knows a peripheral it has "retrieved" this launch */
        var get = ble.getDevices ? ble.getDevices({ deviceIds: [mem.id] }).then(null, function () {}) : Promise.resolve();
        return get.then(function () { return new NativeDevice(ble, mem.id, mem.name); });
      }
      if (!navigator.bluetooth.getDevices) { throw zsErr('none', 'this browser cannot reconnect by itself'); }
      return navigator.bluetooth.getDevices().then(function (list) {
        for (var i = 0; i < list.length; i++) { if (list[i].id === mem.id) { return list[i]; } }
        throw zsErr('none', 'the remembered dongle is not allowed in this browser any more');
      });
    }).then(function (dev) {
      return attach(dev).then(null, function (e) {
        if (e && (e.zsKind === 'not-ours' || e.zsKind === 'permission' || e.zsKind === 'bt-off')) { throw e; }
        throw zsErr('out-of-range', (e && e.message) || 'the dongle did not answer');
      });
    });
  }

  function disconnect() {
    var d = state.device;
    state.quiet = true;
    state.connected = false;
    failAll('disconnected');
    state.quiet = false;
    if (d && d.gatt) { try { d.gatt.disconnect(); } catch (e) { /* gone */ } }
    return Promise.resolve();
  }

  /* Plain-English explanation for any error from this file:
     {title, text, fix: 'app-settings' | 'bt-settings' | null} */
  function explain(e) {
    var kind = (e && e.zsKind) || '', m = (e && e.message) || String(e || '');
    var ios = platform() === 'ios';
    if (kind === 'bt-off') {
      return { title: 'Bluetooth is off', fix: ios ? null : 'bt-settings',
        text: ios ? 'Turn Bluetooth on: swipe down from the top-right corner and tap the Bluetooth symbol, then try again.'
                  : 'Turn Bluetooth on, then try again.' };
    }
    if (kind === 'permission') {
      return { title: 'Bluetooth permission needed', fix: 'app-settings',
        text: ios ? 'ZeroStick needs Bluetooth to reach the dongle. Open Settings, turn Bluetooth on for ZeroStick, then come back.'
                  : 'ZeroStick needs the "Nearby devices" permission to reach the dongle. Open Settings, allow it, then come back.' };
    }
    if (kind === 'unsupported') {
      return { title: 'Bluetooth is not available here', fix: null,
        text: 'Use the ZeroStick app on your phone, or Google Chrome on a computer.' };
    }
    if (kind === 'cancelled') {
      return { title: 'No dongle picked', fix: null,
        text: 'Tap Connect and choose "ZeroStick Dongle" from the list. If it is not in the list, check the dongle is plugged in and its light is on.' };
    }
    if (kind === 'not-ours') {
      return { title: 'That is not a ZeroStick Dongle', fix: null,
        text: 'Tap Connect and choose "ZeroStick Dongle".' };
    }
    if (kind === 'out-of-range' || kind === 'not-found' || kind === 'timeout') {
      return { title: 'Can\'t reach your dongle', fix: null,
        text: 'Check the dongle is plugged into your PS5 (or a USB charger) and its light is on, keep your phone close, then try again.' };
    }
    if (kind === 'disconnected') {
      return { title: 'The dongle disconnected', fix: null,
        text: 'Check it is still plugged in and your phone is close, then reconnect.' };
    }
    if (kind === 'busy') {
      return { title: 'The dongle was busy', fix: null, text: 'Wait a moment and try again.' };
    }
    if (kind === 'too-big') {
      return { title: 'Bluetooth link too small', fix: null,
        text: 'Your phone\'s Bluetooth link could not carry that answer. Disconnect, reconnect the dongle, and try again.' };
    }
    if (kind === 'flash') {
      if (e.data && e.data[0] === 0x81) {
        return { title: 'Not enough power to save', fix: null,
          text: 'The USB port the dongle is plugged into is giving too little power right now, so nothing was saved. Try again in a moment, or plug the dongle into a different USB port.' };
      }
      return { title: 'The dongle could not save', fix: null,
        text: 'Try again. If it keeps happening, unplug the dongle, plug it back in, and contact ZeroStick support.' };
    }
    if (kind === 'ota') {
      return { title: 'The update was refused', fix: null, text: otaReason(e.data && e.data[0]) };
    }
    if (kind === 'usb') {
      return { title: 'The controller did not answer', fix: null,
        text: 'Unplug the controller from the dongle, plug it back in, and try again.' };
    }
    if (kind === 'no-pad') {
      return { title: 'No controller plugged in', fix: null,
        text: 'Plug your controller into the dongle with a USB cable.' };
    }
    return { title: 'Something went wrong', fix: null, text: m + '. Try again.' };
  }

  function otaReason(r) {
    return ({
      1: 'The dongle lost track of the update. Tap Try again to start it again.',
      2: 'That firmware file is the wrong size for this dongle.',
      3: 'Part of the update went missing. Tap Try again to carry on.',
      4: 'The app sent the update in the wrong piece size. Tap Try again.',
      5: 'The dongle did not get the whole update. Tap Try again to carry on.',
      6: 'The update arrived damaged. Tap Try again to send it again.',
      7: 'That file is not ZeroStick Dongle firmware.',
      8: 'That firmware is for a different model.',
      9: 'That update file is not signed by ZeroStick, so it was not installed. Update the ZeroStick app and try again.',
      10: 'That update file is damaged or has been changed, so it was not installed. Reinstall the ZeroStick app and try again.',
      11: 'That update was signed with a key this device does not trust (for example a test update on a retail unit), so it was not installed. Contact ZeroStick support.',
      12: 'The dongle is still updating your stick flex. Wait for that to finish, then try again.'
    })[r] || 'Tap Try again.';
  }

  function openSettings(fix) {
    var ble = nativePlugin();
    if (!ble) { return Promise.resolve(); }
    if (fix === 'bt-settings' && ble.openBluetoothSettings) { return ble.openBluetoothSettings(); }
    return ble.openAppSettings ? ble.openAppSettings() : Promise.resolve();
  }

  window.ZSHIDBLE = {
    SERVICE: SVC,
    SLOTS: 8,
    connect: connect,
    reconnect: reconnect,
    disconnect: disconnect,
    isConnected: function () { return state.connected; },
    onDisconnect: function (fn) { state.onDisconnect.push(fn); },
    onConnect: function (fn) { state.onConnect.push(fn); },
    /* {text, version, name, id} of the connected dongle, or null */
    info: function () { return state.connected ? state.info : null; },
    remembered: remembered,
    forget: function () { forgetRemembered(); return disconnect(); },
    explain: explain,
    openSettings: openSettings,
    isApp: function () { return !!nativePlugin(); },

