    },
    scriptSelect: function (slot) { return call(OP.SCRIPT_SELECT, [slot]); },
    scriptsEnable: function (on) { return call(OP.ENABLE, [on ? 1 : 0]); },
    forgetStick: function () { return call(OP.FORGET); },
    /* -> {link, linkCode 0-5, flexFw, enabled, slot, act: 'idle'|'aim'|'recoil',
           flags, flex: {running, railOk, saturated, calibrated, failsafe, calibrating}}
