        var full = b.length > 8;
        return { link: LINK_STATES[b[0]] || ('state ' + b[0]), linkCode: b[0], flexFw: b[1],
                 flexVersion: b[1] ? b[1] + '.' + (full ? b[6] : 0) + '.' + (full ? b[7] : 0) : '',
                 flexChip: full && b[8] ? b[8] : null,
                 enabled: !!b[2], slot: b[3], act: ACTS[b[4]] || String(b[4]), flags: f,
                 hasFlags: b.length > 5,
                 flex: { running: !!(f & 1), railOk: !!(f & 2), saturated: !!(f & 4),
