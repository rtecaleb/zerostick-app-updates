         reason, or 0xFE the flex stopped answering) */
      flexStatus: function (ops) {
        return call(ops.status).then(function (b) {
          return { phase: b[0], error: b[1], percent: b[2], done: u32(b, 3), size: u32(b, 7),
                   version: b[11] + '.' + b[12] + '.' + b[13], open: b[0] === 1, received: u32(b, 3) };
        });
      },
      status: function (ops) {
        return call(ops.status).then(function (b) {
          return { open: !!b[0], received: u32(b, 1), size: u32(b, 5) };
        });
      },
      reason: otaReason,
      u32: u32
    },
    /* any op, for features newer than this file: -> answer bytes */
    raw: function (op, payload) { return call(op, payload); }
  };
})();
