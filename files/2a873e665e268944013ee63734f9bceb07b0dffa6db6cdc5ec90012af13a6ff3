    },
    /* 0x26 FLEX_CAL: cmd 0 status, 1 start, 2 cancel, 3 clear ->
       {state 'idle'|'waiting'|'running'|'done'|'failed', error 0-8, progress,
        swap, cpvX, cpvY, zoX, zoY} */
    flexCal: function (cmd) {
      return call(OP.FLEX_CAL, [cmd || 0]).then(function (b) {
        return { stateCode: b[0], state: CAL_STATES[b[0]] || String(b[0]), error: b[1], progress: b[2],
                 swap: !!b[3], cpvX: i16(b, 4), cpvY: i16(b, 6), zoX: u16(b, 8), zoY: u16(b, 10) };
