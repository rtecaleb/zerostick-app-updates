                         updating: !!(f & 64) } };
      });
    },
    /* 0x11 DEVINFO -> everything about the dongle in one answer */
    devinfo: function () {
      return call(OP.DEVINFO).then(function (b) {
        var fl = b[17];
        return {
          record: b[0], version: b[1] + '.' + b[2] + '.' + b[3], ver: [b[1], b[2], b[3]],
          chipCode: b[4], chip: CHIPS[b[4]] || ('0x' + b[4].toString(16)),
          padCode: b[5], pad: PAD_STATES[b[5]] || String(b[5]), vid: u16(b, 6), pid: u16(b, 8),
          linkCode: b[10], link: LINK_STATES[b[10]] || String(b[10]), flexFw: b[11],
          /* bytes 20-22: flex minor, patch, chip (23-byte record; needs MTU >= 29) */
          flexVersion: b[11] ? b[11] + '.' + (b.length > 22 ? b[20] : 0) + '.' + (b.length > 22 ? b[21] : 0) : '',
          flexChip: b.length > 22 && b[22] ? b[22] : null,
          consoleMv: u16(b, 13), padMv: u16(b, 15),
          padPowered: !!(fl & 1), sagged: !!(fl & 2), updating: !!(fl & 4), enabled: !!(fl & 8),
          unsaved: !!(fl & 16), lowNow: !!(fl & 32), resetCause: b[18], overCurrent: b[19]
