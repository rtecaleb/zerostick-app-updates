<title>ZeroStick Pad Calibrator</title>
<!-- ZS local build: ZeroStick branding -->
<style id="zs-brand">
  .zs-nav-logo{height:32px;width:auto;display:block;}
  [data-bs-theme="dark"] .zs-logo-light{display:none;}
  html:not([data-bs-theme="dark"]) .zs-logo-dark{display:none;}
  .btn-primary{
    --bs-btn-bg:#2c8cdc;--bs-btn-border-color:#2c8cdc;
    --bs-btn-hover-bg:#2678bd;--bs-btn-hover-border-color:#2678bd;
    --bs-btn-active-bg:#20699f;--bs-btn-active-border-color:#20699f;
    --bs-btn-disabled-bg:#2c8cdc;--bs-btn-disabled-border-color:#2c8cdc;
  }
  .progress-bar{background-color:#2c8cdc;}
  .form-check-input:checked{background-color:#2c8cdc;border-color:#2c8cdc;}
</style>

<link id="bootstrap-css" href="vendor/bootstrap.min.css"
      rel="stylesheet">

<link rel="stylesheet"
      href="vendor/fontawesome/css/fontawesome.min.css">

<link rel="stylesheet"
      href="vendor/fontawesome/css/all.min.css">


<script src="vendor/jquery-3.7.1.min.js"></script>

<meta http-equiv="Permissions-Policy" content="interest-cohort=()">
<script src="zs-core-hid.js"></script>
<!-- ZS EXO app: the phone layout and the app's colours (D414) -->
<script src="zs-mobile.js"></script>
<script type="module" src="app.js"></script>
<script src="zs-tweaks.js"></script>
