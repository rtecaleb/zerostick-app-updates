</head>
<body>
  <script src="vendor/bootstrap.bundle.min.js"></script>

  <nav class="navbar bg-body-tertiary navbar-expand-md bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="#" onclick="return false;">
        <img src="brand/zs-nav-light.png" alt="ZeroStick" class="zs-nav-logo zs-logo-light">
        <img src="brand/zs-nav-dark.png" alt="ZeroStick" class="zs-nav-logo zs-logo-dark">
        <span class="ms-2 text-body-secondary" style="font-size:.78rem;letter-spacing:.14em;font-weight:600;">PAD&nbsp;CALIBRATOR</span>
