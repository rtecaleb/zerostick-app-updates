/* gun-bulk.js — "Add quick scripts to guns" (D405, owner 2026-10-17).
 *
 * The owner: "In the tab below the Gun reader frame, a tab that says 'Add
 * quick scripts to guns'. You click it and choose adding aim assist, recoil
 * and rapid fire to guns, and you go through and check the guns you want to
 * add it to, and the strength of each one you click, so then it applies to
 * all the checked guns."
 *
 * ONE SHEET, TWO STEPS:
 *   1. the scripts: the gun page's three quick tiles (Rapid fire, Aim assist,
 *      Anti-recoil), each a checkbox; a ticked one shows its ONE slider, the
 *      same scale and default as the gun page's own (ZS_SMART.quick.range,
 *      shared with 11-library.js openQuickAdd);
 *   2. the guns: the game's weapon list by class, with the list's own
 *      pictures, a checkbox per gun, "Every <class>" per class and "Every
 *      gun" over all, a live count; "Add to N guns".
 *
 * WHAT A GUN GETS is exactly what its own page's tile adds: the same Script
 * (ZS_SMART.quick.build), on that gun alone (auto: {pack, item, on}; the
 * stored switch off, as every scoped room stamps it). A gun that already has
 * that quick Script is UPDATED to the new strength (the row slider's own
 * write, ZS_SMART.quick.restrength), never given a second one. A gun whose
 * button already runs a different Script the same way (the room's clash
 * rule, dupWhen) is left alone and counted, as is a gun that already gets
 * the Script through a link from another gun (D134).
 *
 * ONE WRITE for every gun (ZSAUTO.kit.linkWrite: after anything a room still
 * has queued, then putProfile, which takes the Core's big-save path), checked
 * first against the Core's free storage (kit.roomAfter, as Copy is).
 *
 * The pure half is planAdd(doc, cat, pack, p, picks, guns), exported for
 * dashboard/tools/test-gun-bulk.js.
 */
(function () {
  'use strict';
  if (!window.ZS || !window.ZSAUTO || !window.ZSAUTO.kit) { return; }
  var ZS = window.ZS, esc = ZS.esc, K = window.ZSAUTO.kit;
  var HAS = Object.prototype.hasOwnProperty;
  function Q() { return (window.ZS_SMART && window.ZS_SMART.quick) || null; }
  function arr(v) { return Object.prototype.toString.call(v) === '[object Array]' ? v : []; }

  /* What the sheet lists: the guns. A game with two kinds lists its guns
     when they stand on their own (an All entry, D126); a game whose guns
     only exist under an operator (Siege) lists the operators, since that is
     where a Script without a pair lives. */
  function targetKind(cat) {
    if (!cat) { return null; }
    if (!cat.multi) { return { kind: null, groups: cat.groups, one: 'gun', many: 'guns' }; }
    var k = (cat.carried && K.allName(cat)) ? cat.carried : cat.lead;
    var one = K.nounOf(k);
    return { kind: k, groups: k.groups, one: one === 'weapon' ? 'gun' : one, many: one === 'weapon' ? 'guns' : K.nounsOf(k) };
  }

  /* ══ THE PLAN (pure but for ZS_SMART.quick, which reads the config) ══
     picks: [{ tpl, s }]   guns: [item ids]   mutates `doc`.
     Returns { added: {gun: [tpl]}, updated: {gun: [tpl]}, clash: {gun: [tpl]},
               linked: {gun: [tpl]}, cannot: [tpl], ids: [action ids written] } */
  function ownOf(doc, gun) {
    return arr(doc && doc.accessibilityActions).filter(function (a) {
      return K.isAuto(a) && a.auto.item === gun && !K.withOf(a) && !K.hasTiers(a);
    });
  }
  function freeName(list, base) {
    var used = {};
    list.forEach(function (o) { if (o && o.name) { used[o.name] = true; } });
    if (!used[base]) { return base; }
    for (var n = 2; ; n++) { if (!used[base + ' ' + n]) { return base + ' ' + n; } }
  }
  function note(map, gun, tpl) { (map[gun] || (map[gun] = [])).push(tpl); }
  function planAdd(doc, cat, pack, p, picks, guns) {
    var q = Q();
    var out = { added: {}, updated: {}, clash: {}, linked: {}, cannot: [], ids: [] };
    if (!q || !doc) { return out; }
    if (!arr(doc.accessibilityActions).length) { doc.accessibilityActions = arr(doc.accessibilityActions); }
    arr(picks).forEach(function (pk) {
      var fresh = q.build(p, pk.tpl, pk.s);
      if (!fresh) { out.cannot.push(pk.tpl); return; }
      arr(guns).forEach(function (gun) {
        var own = ownOf(doc, gun);
        /* already on this gun: the new strength, never a second one */
        var mine = own.filter(function (a) { return q.tplOf(a) === pk.tpl; });
        if (mine.length) {
          var turned = false;
          mine.forEach(function (a) {
            if (q.strengthOf(a, p) === null) { return; }
            turned = true;
            if (q.strengthOf(a, p) === pk.s) { return; }
            var j = q.restrength(p, a, pk.s);
            if (!j) { return; }
            var L = doc.accessibilityActions, i = L.indexOf(a);
            if (i >= 0) { L[i] = j; out.ids.push(j.id); }
          });
          /* one the player reshaped in the editor is theirs: left as it is,
             and still not doubled */
          note(turned ? out.updated : out.clash, gun, pk.tpl);
          return;
        }
        /* a linked one from another gun already runs here (D134) */
        var viaLink = arr(doc.accessibilityActions).some(function (a) {
          return K.isAuto(a) && a.auto.item !== gun && q.tplOf(a) === pk.tpl && !K.withOf(a) && !K.hasTiers(a) &&
            K.isLinked(a) && cat && K.gunsOf(a, cat).indexOf(gun) >= 0;
        });
        if (viaLink) { note(out.linked, gun, pk.tpl); return; }
        /* the room's clash rule: another Script on the same button, the same way */
        if (q.clash(p, own, fresh)) { note(out.clash, gun, pk.tpl); return; }
        var c = JSON.parse(JSON.stringify(fresh));
        c.id = K.mintIds(doc, 1)[0];
        c.name = freeName(own, c.name);
        c.auto = { pack: pack, item: gun, on: true };
        c.enabled = false;
        doc.accessibilityActions.push(c);
        out.ids.push(c.id);
        note(out.added, gun, pk.tpl);
      });
    });
    return out;
  }
  function countOf(map) { var n = 0; for (var k in map) { if (HAS.call(map, k)) { n++; } } return n; }
  /* "Added to 12 guns, updated 3." and what was left alone */
  function resultWords(r, T) {
    var a = countOf(r.added), u = countOf(r.updated), c = countOf(r.clash), l = countOf(r.linked);
    var parts = [];
    if (a) { parts.push('Added to ' + K.plural(a, T.one, T.many)); }
    if (u) { parts.push((a ? 'updated ' : 'Updated on ') + (a ? u : K.plural(u, T.one, T.many))); }
    var say = parts.join(', ');
    if (!say) { say = 'Nothing new to add'; }
    say += '.';
    if (c) { say += ' Skipped ' + K.plural(c, T.one, T.many) + ': that button already runs another Script there.'; }
    if (l) { say += ' ' + K.plural(l, T.one, T.many) + ' already ' + (l === 1 ? 'gets' : 'get') + ' it through a link.'; }
    if (r.cannot.length) { say += ' This config cannot run ' + r.cannot.map(titleOf).join(' or ') + '.'; }
    return say;
  }
  function titleOf(tpl) { var r = Q() && Q().range(tpl); return r ? r.title : tpl; }

  /* ══ THE CARD on the AI Scripts list, under the Gun reader frame ══ */
  var ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" ' +
    'stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" ' +
    'height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><path d="M17 14v6M14 17h6"/></svg>';
  var HELP = 'Pick <b>Rapid fire</b>, <b>Aim assist</b> or <b>Anti-recoil</b> and how strong, then tick the guns. ' +
    'Each gun gets its own copy, the same one its own page adds. ' +
    'A gun that already has it gets the new strength instead of a second one. ' +
    'Change one gun later on its own page.';
  function cardHTML(p) {
    if (!Q() || !Q().tiles().length) { return ''; }
    var st = K.stateOf(p), cat = st.cat && st.cat.data, T = targetKind(cat);
    if (!T) { return ''; }
    var help = ZS.helpHTML ? ZS.helpHTML('gb-help', 'Add quick scripts to ' + T.many, HELP) : '';
    var qi = help.indexOf('<div class="note qhfold');
    var chip = qi > 0 ? help.slice(0, qi) : '', fold = qi > 0 ? help.slice(qi) : '';
    return '<div class="aa-frbox gb-box' + (chip ? ' aa-frq' : '') + '" id="gb-box"><div class="aa-frrow">' +
      '<div class="aa-frame gb-door" id="gb-door" role="button" tabindex="0">' +
      '<span class="aa-frico" aria-hidden="true">' + ICON + '</span>' +
      '<span class="aa-frt"><b>' + esc('Add quick scripts to ' + T.many) + '</b><span>' +
      esc('Rapid fire, aim assist or anti-recoil on many ' + T.many + ' at once') + '</span></span>' +
      '<span class="chev" aria-hidden="true">›</span></div>' + chip + '</div>' + fold + '</div>';
  }
  function wireCard(root, p) {
    var door = root.querySelector('#gb-door');
    if (!door || door._gb) { return; }
    door._gb = true;
    var go = function () { open(p); };
    door.addEventListener('click', go);
    door.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
    });
    door.addEventListener('pointerdown', function () { door.classList.add('zs-pressing'); });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
      door.addEventListener(ev, function () { door.classList.remove('zs-pressing'); });
    });
  }

  /* ══ THE SHEET ══ */
  var MEM = {};                 /* pid -> what was picked, kept for the session */
  function memOf(p) {
    if (!MEM[p.id]) {
      var s = {};
      (Q() ? Q().tiles() : []).forEach(function (t) { s[t.tpl] = Q().range(t.tpl).def; });
      MEM[p.id] = { on: {}, s: s };
    }
    return MEM[p.id];
  }
  function box() { return '<span class="aa-pkbox" aria-hidden="true"></span>'; }

  function open(p) {
    var q = Q(), st = K.stateOf(p), cat = st.cat && st.cat.data, T = targetKind(cat);
    if (!q || !cat || !T || !K.docOf(p)) { ZS.toast('Connect your Core first'); return; }
    injectCss();
    var mem = memOf(p), tiles = q.tiles();
    var pack = st.pack.id;
    var lists = [];
    var now = T.groups.filter(function (g) { return !K.isLegacy(g); }), old = T.groups.filter(K.isLegacy);
    now.concat(old).forEach(function (g) { if (g.items.length) { lists.push({ g: g, items: g.items }); } });
    var all = [], gOf = {};
    lists.forEach(function (l) { l.items.forEach(function (it) { all.push(it.id); gOf[it.id] = l.g.id; }); });
    var sel = {}, ui = { step: 1, q: '', open: {} }, saved = false;
    var sb = null;

    function picks() {
      return tiles.filter(function (t) { return !!mem.on[t.tpl]; }).map(function (t) {
        return { tpl: t.tpl, s: mem.s[t.tpl] };
      });
    }
    function count() { return all.filter(function (g) { return !!sel[g]; }).length; }
    function onIn(l) { return l.items.filter(function (it) { return !!sel[it.id]; }).length; }
    function classState(l) { var n = onIn(l); return n === l.items.length ? 'true' : n ? 'mixed' : 'false'; }
    function everyState() { var n = count(); return n === all.length ? 'true' : n ? 'mixed' : 'false'; }

    /* what a gun already has, of the picked ones, said on its row */
    var doc0 = K.docOf(p);
    function hasWords(gun) {
      var names = [];
      var own = ownOf(doc0, gun);
      picks().forEach(function (pk) {
        if (own.some(function (a) { return q.tplOf(a) === pk.tpl; })) { names.push(titleOf(pk.tpl)); }
      });
      return names.length ? 'has ' + names.join(', ') : '';
    }

    /* ── step 1: the scripts ── */
    function sliderHTML(t) {
      var r = q.range(t.tpl), s = mem.s[t.tpl];
      return '<div class="gb-sl" data-gbsl="' + esc(t.tpl) + '">' +
        '<div class="flab"><span class="gb-sln">' + esc(r.title) + '</span><span class="gb-slv">' + esc(r.lab) +
        ' <b data-gbv="' + esc(t.tpl) + '">' + esc(r.shown(s)) + '</b> <span class="safeath" data-gbh="' + esc(t.tpl) +
        '">' + esc(r.hint(s)) + '</span></span></div>' +
        '<input class="rng" type="range" min="' + r.min + '" max="' + r.max + '" step="1" value="' + s +
        '" data-gbr="' + esc(t.tpl) + '" data-nosave="1" aria-label="' + esc(r.title + ' ' + r.lab.toLowerCase()) + '"></div>';
    }
    function step1HTML() {
      var on = picks();
      return '<div class="gb" id="gb" data-step="1" data-tint="auto">' +
        '<div class="gb-eye">Step 1 of 2 · Pick the scripts</div>' +
        '<div class="saquickrow gb-tiles" role="group" aria-label="Quick scripts">' +
        tiles.map(function (t) {
          var ticked = !!mem.on[t.tpl];
          return '<button type="button" role="checkbox" aria-checked="' + (ticked ? 'true' : 'false') +
            '" class="btn saquick gb-tile" id="gb-q-' + esc(t.tpl) + '" data-gbq="' + esc(t.tpl) + '">' +
            '<span class="gb-tick" aria-hidden="true"></span>' + t.ico + '<b>' + esc(t.n) + '</b></button>';
        }).join('') + '</div>' +
        '<div id="gb-sliders" class="gb-sliders">' + (on.length
          ? tiles.filter(function (t) { return !!mem.on[t.tpl]; }).map(sliderHTML).join('')
          : '<div class="gb-none" id="gb-none">Tap one or more.</div>') + '</div>' +
        '<div class="aa-pkfoot"><div class="aa-pkcount" id="gb-count1" aria-live="polite">' +
          esc(on.length ? K.plural(on.length, 'script', 'scripts') + ' picked' : 'Nothing picked yet') + '</div>' +
        '<button type="button" class="btn primary" id="gb-next"' + (on.length ? '' : ' disabled') +
          '>Next: pick the ' + esc(T.many) + '</button></div></div>';
    }

    /* ── step 2: the guns ── */
    function gunRow(l, it) {
      var has = hasWords(it.id);
      return '<button type="button" role="checkbox" class="aa-pkrow gb-gun" data-gbgun="' + esc(it.id) +
        '" aria-checked="' + (sel[it.id] ? 'true' : 'false') + '">' + box() +
        '<span class="aa-pic gb-pic' + (K.squareKind(T.kind) ? ' aa-sq' : '') + (it.image ? '' : ' aa-codeonly') + '">' +
          K.picHTML(pack, l.g, it, '', T.kind) + '</span>' +
        '<span class="aa-pkname">' + esc(it.name) + (has ? '<span class="aa-pksub">' + esc(has) + '</span>' : '') +
        '</span></button>';
    }
    function listHTML() {
      var nq = K.norm(ui.q), h = '', shown = 0, oldHead = false;
      lists.forEach(function (l) {
        var items = nq ? K.matching({ id: l.g.id, name: l.g.name, items: l.items }, nq) : l.items;
        if (nq && !items.length) { return; }
        shown += items.length;
        if (K.isLegacy(l.g) && !oldHead) { oldHead = true; h += '<div class="aa-pksh">Legacy</div>'; }
        var opened = nq ? true : !!ui.open[l.g.id];
        h += '<div class="aa-pkcls gb-cls' + (opened ? ' open' : '') + '" data-gbcls="' + esc(l.g.id) + '">' +
          '<div class="aa-pkhd"><button type="button" role="checkbox" class="aa-pkrow aa-pkclsbox" data-gbg="' +
            esc(l.g.id) + '" aria-checked="' + classState(l) + '">' + box() +
            K.classTile(l.g, T.kind) +
            '<span class="aa-pkname">' + esc('Every ' + K.singular(K.shortName(l.g))) + '</span></button>' +
          '<button type="button" class="aa-pkfold" data-gbfold="' + esc(l.g.id) + '" aria-expanded="' +
            (opened ? 'true' : 'false') + '" aria-label="' + esc((opened ? 'Hide' : 'Show') + ' the ' + l.g.name) + '">' +
            '<span class="aa-pkn">' + esc(onIn(l) + ' of ' + l.items.length) + '</span><span class="chev">›</span></button></div>' +
          (opened ? '<div class="aa-pkbody">' + items.map(function (it) { return gunRow(l, it); }).join('') + '</div>' : '') +
          '</div>';
      });
      if (nq && !shown) {
        h = '<div class="aa-none" id="gb-nomatch">' + esc('No ' + T.one + ' is called “' + ui.q + '”.') + '</div>';
      }
      return h;
    }
    function chipsHTML() {
      return '<div class="gb-chips" id="gb-chips">' + picks().map(function (pk) {
        var r = q.range(pk.tpl);
        return '<span class="gb-chip">' + esc(r.title) + ' <b>' + esc(r.taps ? pk.s + '/s' : pk.s + '%') + '</b></span>';
      }).join('') + '</div>';
    }
    function addWords() {
      var n = count();
      return n ? 'Add to ' + K.plural(n, T.one, T.many) : 'Add';
    }
    function step2HTML() {
      var find = 'Search ' + T.many;
      return '<div class="gb aa-pk" id="gb" data-step="2" data-tint="auto">' +
        '<div class="gb-top"><button type="button" class="btn gb-back" id="gb-back" aria-label="Back to the scripts">‹ Scripts</button>' +
        '<div class="gb-eye">Step 2 of 2 · Pick the ' + esc(T.many) + '</div></div>' +
        chipsHTML() +
        '<input type="search" class="txt aa-search" id="gb-q" data-nosave="1" autocomplete="off" placeholder="' +
          esc(find) + '" aria-label="' + esc(find) + '" value="' + esc(ui.q) + '">' +
        '<button type="button" role="checkbox" class="aa-pkrow aa-pkevery" id="gb-every" aria-checked="' +
          everyState() + '">' + box() + '<span class="aa-pkname"><b>' + esc('Every ' + T.one) + '</b></span></button>' +
        '<div id="gb-list">' + listHTML() + '</div>' +
        '<div class="aa-pkfoot"><div class="aa-pkcount" id="gb-count" aria-live="polite">' +
          esc(count() ? K.plural(count(), T.one, T.many) + ' ticked' : 'Tick the ' + T.many) + '</div>' +
        '<div id="gb-warn"></div>' +
        '<button type="button" class="btn primary" id="gb-add"' + (count() ? '' : ' disabled') + '>' +
          esc(addWords()) + '</button></div></div>';
    }

    function paint2() {
      sb.querySelectorAll('[data-gbgun]').forEach(function (b) {
        b.setAttribute('aria-checked', sel[b.getAttribute('data-gbgun')] ? 'true' : 'false');
      });
      lists.forEach(function (l) {
        var c = sb.querySelector('[data-gbcls="' + l.g.id + '"]');
        if (!c) { return; }
        var cb = c.querySelector('[data-gbg]');
        if (cb) { cb.setAttribute('aria-checked', classState(l)); }
        var n = c.querySelector('.aa-pkn');
        if (n) { n.textContent = onIn(l) + ' of ' + l.items.length; }
      });
      var ev = sb.querySelector('#gb-every');
      if (ev) { ev.setAttribute('aria-checked', everyState()); }
      var ct = sb.querySelector('#gb-count');
      if (ct) { ct.textContent = count() ? K.plural(count(), T.one, T.many) + ' ticked' : 'Tick the ' + T.many; }
      var ad = sb.querySelector('#gb-add');
      if (ad) { ad.textContent = addWords(); ad.disabled = !count(); }
      var wn = sb.querySelector('#gb-warn');
      if (wn) { wn.innerHTML = ''; }
    }
    function wirePics(el) {
      el.querySelectorAll('img.aa-img').forEach(function (im) {
        if (im._gbPic) { return; }
        im._gbPic = true;
        im.addEventListener('error', function () { K.picFailed(im); });
      });
    }
    function wireList2() {
      var bx = sb.querySelector('#gb-list');
      if (!bx) { return; }
      bx.querySelectorAll('[data-gbgun]').forEach(function (b) {
        b.addEventListener('click', function () {
          var g = b.getAttribute('data-gbgun');
          if (sel[g]) { delete sel[g]; } else { sel[g] = true; }
          paint2();
        });
      });
      bx.querySelectorAll('[data-gbg]').forEach(function (b) {
        b.addEventListener('click', function () {
          var gid = b.getAttribute('data-gbg'), l = null;
          lists.forEach(function (x) { if (x.g.id === gid) { l = x; } });
          if (!l) { return; }
          var whole = classState(l) === 'true';
          l.items.forEach(function (it) { if (whole) { delete sel[it.id]; } else { sel[it.id] = true; } });
          paint2();
        });
      });
      bx.querySelectorAll('[data-gbfold]').forEach(function (b) {
        b.addEventListener('click', function () {
          var gid = b.getAttribute('data-gbfold');
          ui.open[gid] = !ui.open[gid];
          bx.innerHTML = listHTML();
          wireList2();
          var again = sb.querySelector('[data-gbfold="' + gid + '"]');
          if (again && again.focus) { try { again.focus(); } catch (e) { /* a convenience */ } }
        });
      });
      wirePics(bx);
    }

    function draw() {
      var html = ui.step === 1 ? step1HTML() : step2HTML();
      if (!sb) {
        var opened = ZS.sheetOpen('Add quick scripts to ' + T.many, html, function () {
          if (!saved && ui.step === 2 && count()) { ZS.toast('Closed without Add: nothing was added.', { ms: 4000 }); }
        });
        sb = opened;
      } else {
        sb.innerHTML = html;
      }
      if (ui.step === 1) { wire1(); } else { wire2(); }
      var sc = sb.parentNode;
      if (sc && sc.scrollTo) { try { sc.scrollTo(0, 0); } catch (e) { sc.scrollTop = 0; } }
    }
    function wire1() {
      sb.querySelectorAll('[data-gbq]').forEach(function (b) {
        b.addEventListener('click', function () {
          var id = b.getAttribute('data-gbq');
          if (mem.on[id]) { delete mem.on[id]; } else { mem.on[id] = true; }
          draw();
          var again = sb.querySelector('[data-gbq="' + id + '"]');
          if (again && again.focus) { try { again.focus(); } catch (e) { /* a convenience */ } }
        });
      });
      sb.querySelectorAll('input[data-gbr]').forEach(function (r) {
        var id = r.getAttribute('data-gbr'), R = q.range(id);
        r.addEventListener('input', function () {
          var s = Math.max(R.min, Math.min(R.max, Math.round(+r.value || R.def)));
          mem.s[id] = s;
          var v = sb.querySelector('[data-gbv="' + id + '"]'), h = sb.querySelector('[data-gbh="' + id + '"]');
          if (v) { v.textContent = R.shown(s); }
          if (h) { h.textContent = R.hint(s); }
        });
      });
      var nx = sb.querySelector('#gb-next');
      if (nx) {
        nx.addEventListener('click', function () {
          if (!picks().length) { return; }
          ui.step = 2;
          draw();
        });
      }
    }
    function wire2() {
      var bk = sb.querySelector('#gb-back');
      if (bk) { bk.addEventListener('click', function () { ui.step = 1; draw(); }); }
      var ev = sb.querySelector('#gb-every');
      if (ev) {
        ev.addEventListener('click', function () {
          var every = everyState() === 'true';
          all.forEach(function (g) { if (every) { delete sel[g]; } else { sel[g] = true; } });
          paint2();
        });
      }
      var qf = sb.querySelector('#gb-q');
      if (qf) {
        qf.addEventListener('input', function () {
          ui.q = qf.value || '';
          var bx = sb.querySelector('#gb-list');
          if (bx) { bx.innerHTML = listHTML(); wireList2(); }
        });
      }
      wireList2();
      var ad = sb.querySelector('#gb-add');
      if (ad) {
        ad.addEventListener('click', function () {
          if (ad.disabled) { return; }
          var guns = all.filter(function (g) { return !!sel[g]; }), pk = picks();
          if (!guns.length || !pk.length) { return; }
          /* would it fit? measured as the save would write it (D135) */
          var next = JSON.parse(JSON.stringify(K.docOf(p)));
          var trial = planAdd(next, cat, pack, p, pk, guns);
          var room = K.roomAfter(p, next, Math.max(1, trial.ids.length), 'Script', 'Scripts');
          if (!room.ok) {
            var wn = sb.querySelector('#gb-warn');
            if (wn) {
              wn.innerHTML = '<div class="note warn aa-pkfull" id="gb-full">' +
                esc(room.say.replace(/ ?Link it instead:.*$/, ' Tick fewer ' + T.many + '.')) + '</div>';
            }
            return;
          }
          ad.disabled = true;
          saved = true;
          ZS.sheetClose();
          write(p, cat, pack, T, pk, guns);
        });
      }
    }
    draw();
  }

  /* ── the one write ── */
  function write(p, cat, pack, T, pk, guns) {
    var r = null;
    K.linkWrite(p, function (doc) { r = planAdd(doc, cat, pack, p, pk, guns); }, function () {
      if (!r) { return; }
      if (window.ZS_SMART && ZS_SMART.refreshRooms && r.ids.length) { ZS_SMART.refreshRooms(p.id, r.ids); }
      /* the list opens the classes that changed, so the counts are in view */
      var ui = K.uiOf(p), seen = {};
      [r.added, r.updated].forEach(function (m) {
        for (var g in m) {
          if (HAS.call(m, g) && cat.byId[g] && !seen[g]) { seen[g] = true; ui.open[cat.byId[g].group.id] = true; }
        }
      });
      var words = pk.map(function (x) { return titleOf(x.tpl); });
      ZS.toast((words.length > 1 ? words.slice(0, -1).join(', ') + ' and ' + words[words.length - 1] : words[0]) + ': ' +
        resultWords(r, T), { ms: 6000 });
      K.redrawIfOpen();
    });
  }

