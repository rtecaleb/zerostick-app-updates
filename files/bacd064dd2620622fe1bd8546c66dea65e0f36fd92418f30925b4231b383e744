/* smart-actions/12-share-live.js — share codes and the live indicators.
 *
 * ZSA2. share codes (copy / paste an action), and the live poll that lights an
 * action while it runs, with the pad-family hook (ZSG.onFamilyChange).
 *
 * Tests: test-smart-actions.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('share-live', function (SEC) {
  'use strict';
  /* from the parts before this one */
  var arr = SEC.arr, clone = SEC.clone, esc = SEC.esc, migrateV1 = SEC.migrateV1,
      mintId = SEC.mintId, normAction = SEC.normAction, saFor = SEC.saFor,
      screenLive = SEC.screenLive, ZS = SEC.ZS, ensureCaps = SEC.ensureCaps,
      subLineHTML = SEC.subLineHTML;
  /* from parts after this one, bound once every part has run (never used
     while this part is running) */
  var rowFor, backToEditor, nsOf, draw, panelBody;
  ZS_SMART_PARTS.after(function () {
    rowFor = SEC.rowFor;
    backToEditor = SEC.backToEditor;
    nsOf = SEC.nsOf;
    draw = SEC.draw;
    panelBody = SEC.panelBody;
  });

  var pollTimer = null;
  var famUnhook = null, famNs = null;

  /* ══ share codes ══════════════════════════════════════════════════ */

  /* D432 (owner, 2026-10-22): "when someone copies a config to send to
     someone ... we can see the settings they had and use math to scale it
     to the new profile". A code carries the in-game settings it was made
     on (`madeWith`), from the config it is copied out of. */
  function gameSet(p) {
    var G = window.ZSGAMESET;
    return (G && p && typeof G.of === 'function') ? G.of(p) : null;
  }
  function shareCode(a, p) {
    var o = clone(a);
    delete o.id; delete o.raw; delete o.edited;   /* a shared action is always a NEW one */
    var gs = gameSet(p);
    if (gs) o.madeWith = clone(gs);
    return 'ZSA2.' + btoa(unescape(encodeURIComponent(JSON.stringify(o))))
      .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  /* `info` (optional) is told {scaled, clipped} */
  function readShareCode(txt, p, info) {
    txt = String(txt || '').trim();
    var v1 = txt.indexOf('ZSA1.') === 0, v2 = txt.indexOf('ZSA2.') === 0;
    if (!v1 && !v2) return null;
    try {
      var b = txt.slice(5).replace(/-/g, '+').replace(/_/g, '/');
      while (b.length % 4) b += '=';
      var o = JSON.parse(decodeURIComponent(escape(atob(b))));
      /* codes made by the old editor still work — they go through the same
         one-way migration the stored actions did */
      if (v1) {
        o = migrateV1([{
          name: o.n, trig: o.t, cond: o.c, tog: o.g, modif: o.m, act: o.a,
          grp: o.gr, cat: o.ca, unint: o.u, varOn: o.v, steps: o.s
        }], p)[0];
      }
      var a = normAction(o);
      a.id = mintId();
      a.raw = null; a.edited = true;
      /* D432: made on other settings than this config's: scaled to these,
         then stamped with them so it is never scaled twice. Either side
         without settings: as it came. */
      var G = window.ZSGAMESET, mine = gameSet(p);
      if (G && typeof G.fitAction === 'function' && a.madeWith && mine) {
        var r = G.fitAction(a, a.madeWith, mine);
        if (info) { info.scaled = r.scaled; info.clipped = r.clipped; }
      }
      return a;
    } catch (e) { return null; }
  }

  /* ══ live indicators ══════════════════════════════════════════════ */

  function paintRunning(root, p, S, seqs) {
    var el = root.querySelector('#sa-running');
    if (el) {
      var names = seqs.map(function (q) { return q.name || q.id; });
      if (names.length) { el.style.display = ''; el.innerHTML = '▶ Running now: <b>' + esc(names.join(', ')) + '</b>'; }
      else el.style.display = 'none';
    }
    /* THE POLL RULE, at 500 ms: while the editor sheet is open this may
       toggle classes and rewrite the tile's sub-line, and NOTHING else. A
       repaint here would reset the pager, the selection and the caret — so
       the scope is the sheet body, and the touches are surgical. */
    if (S.screen === 'input' && (S.mode === 'sequence' || S.mode === 'smart') && S.draft) {
      var scope = S.sheetEditor ? document.getElementById('sheetbody') : (panelBody() || root);
      if (!scope) return;
      var run = S.running[S.draft.id];
      var idx = (run && run.step_index != null) ? run.step_index : -1;
      /* the strip follows the run, so the map shows where you are in the
         sequence without having to hunt for it */
      scope.querySelectorAll('[data-tile]').forEach(function (t) {
        t.classList.toggle('now', (+t.dataset.tile) === idx);
      });
      /* and the tile's sub-line says it in WORDS, because a lit tile is
         colour alone */
      var sub = scope.querySelector('#sa-sub');
      if (sub) sub.innerHTML = subLineHTML(S.draft, p, S, rowFor(p, S, S.inputSrc));
    }
  }

  function startPoll(p, S, root) {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    if (ZS.live.online === false || p.id !== ZS.activeId) return;
    var ns = nsOf(root, p);
    /* exactly one interval app-wide, and it dies with the screen — ZS.api
       carries the 8 s abort and never rejects, so a dropped board cannot
       leave this spinning */
    pollTimer = setInterval(function () {
      /* the screen is gone: give back BOTH long-lived subscriptions here, so
         nothing keeps ticking for the rest of the session */
      if (!screenLive(ns)) { clearInterval(pollTimer); pollTimer = null; releaseFamily(); return; }
      if (document.hidden) return;
      /* a board that dropped and came back may be a DIFFERENT board — the
         capability answer goes stale on the drop and is re-asked on return */
      ensureCaps(p, root);
      ZS.api('/output/live').then(function (j) {
        if (!j || !j.ok || !screenLive(ns)) return;
        var seqs = arr(j.data && j.data.activeSequences);
        S.running = {};
        seqs.forEach(function (q) { if (q && q.id) S.running[q.id] = q; });
        paintRunning(root, p, S, seqs);
      });
    }, 500);
  }

  /* ZSG runs a 750 ms watchdog for as long as anything is subscribed, so the
     subscription has to be given back when this screen goes away — not merely
     on the NEXT family change, which may never come. */
  function releaseFamily() {
    if (famUnhook) { famUnhook(); famUnhook = null; }
    famNs = null;
  }

  function hookFamily(p, root) {
    var ns = nsOf(root, p);
    if (famUnhook && famNs === ns) return;      /* already listening for this screen */
    releaseFamily();
    if (!window.ZSG || typeof window.ZSG.onFamilyChange !== 'function') return;
    famNs = ns;
    /* Swapping a DualSense for an Xbox pad renames and redraws every INPUT
       glyph on screen, so the whole editor is repainted from the model. */
    famUnhook = window.ZSG.onFamilyChange(function () {
      if (!screenLive(ns)) { releaseFamily(); return; }
      draw(root, p);
      /* THE ONE EXCEPTION to the poll rule, and it is not a poll: swapping a
         DualSense for an Xbox pad renames and redraws every INPUT glyph, and
         the tile's whole job is to show the button under your thumb. Leaving
         Xbox art on a DualSense is the exact bug this file was written to
         end, so the sheet is rebuilt from the model — losing the pager page
         is the cheaper of the two costs, and it only happens when hardware
         actually changed. */
      var S = saFor(p);
      if (S.sheetEditor && S.draft) backToEditor(root, p, S);
    });
  }

  /* what the other parts use from this one */
  SEC.hookFamily = hookFamily;
  SEC.readShareCode = readShareCode;
  SEC.shareCode = shareCode;
  SEC.startPoll = startPoll;
});
