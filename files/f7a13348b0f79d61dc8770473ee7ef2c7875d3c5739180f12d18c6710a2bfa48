/* shell/15-configs-api.js — new configs, and window.ZS.
 *
 * The config list behind an open panel, a new config's document
 * (newConfigDoc: a game pack's or scratch, D115/D120), addProfile (save,
 * then activate), and window.ZS: the API every other file uses.
 *
 * PART OF THE APP SHELL: phone.html's one inline script until 2026-10-02,
 * now these consecutive files, loaded where it was. They are CLASSIC
 * scripts, as it was: every top-level function and var is a global the
 * other files (and devbar.js, sections/, smart-actions/) call by name, and
 * nothing here may use, while loading, a name a LATER shell file declares
 * (calls made after the page has loaded are fine). phone.html lists them.
 */
  /* ── the config list behind an open panel ──────────────────────────
     Since 2026-08-16 HOME is not the only screen that draws PROFILES: the
     Configs screen (R.profiles) draws the whole list, and it lives in #dbody.
     renderHomeIfVisible() deliberately returns early while a panel is open —
     right for the 8 s status tick, because a list must never churn under a
     finger, and WRONG for the one event that REPLACES the array underneath
     it: the reconnect poll's loadLive() empties PROFILES and refills it from
     the board (line ~1170). An app that booted before the board answered was
     therefore left offering the four built-in preview configs forever, and
     tapping one set activeId to an id the board has never heard of — after
     which prof(activeId) is undefined and EVERY renderHome() throws on
     .color, taking the poll's flushPendingBinds() and "Board found" with it.

     So the list gets told — and ONLY when its IDENTITY changed. Same configs
     in the same order (every ordinary status tick) redraws nothing, so the
     poll trap stays shut: no scroll jump, no lost Reorder mode, no flicker. */
  var listWatcher = null;             /* R.profiles' draw(), while it is on screen */
  /* JSON rather than a join: quoted and comma-separated, ['a','bc'] can never
     read as the same list as ['ab','c'], whatever a config is called */
  function profileSig(){
    return JSON.stringify(PROFILES.map(function(p){ return p.id; }));
  }
  var listSig = profileSig();
  function noteProfileList(){ listSig = profileSig(); }
  function syncProfileList(){
    if(profileSig() === listSig) return;
    noteProfileList();
    if(typeof listWatcher !== 'function') return;
    /* The watcher writes into #dbody, which every detail screen shares, so it
       may only run while #dbody really IS the Configs screen. Without this an
       old closure would repaint somebody else's screen the moment a config
       was added from anywhere in the app. */
    if(!document.getElementById('detail').classList.contains('open')) return;
    if(document.getElementById('dbody').dataset.ns !== 'global/profiles') return;
    listWatcher();
  }

  function renderHomeIfVisible(){
    /* before the early return: the panel covering HOME may be the Configs
       screen, and it is exactly the reconnect tick that replaces the list */
    syncProfileList();
    if(!document.getElementById('editor').classList.contains('open') &&
       !document.getElementById('detail').classList.contains('open')) renderHome();
  }

  /* ── a new config's document ──────────────────────────────────────
     Clone a config the board already accepted, as the template, so the
     document validates; then the wizard's choices; then the game pack's turn
     (pr.prepare, D115). Returns null when there is no board document to
     clone. `small` is the object the list will keep, handed to prepare so a
     Smart Action built for the new config resolves against the new config. */
  /* THE STARTER (2026-11-04). A new config is a copy of one the board
     already has, so its every block is one the board reads. A board with NO
     configs (the owner's rev A Core, wiped: GET /profiles answered data []
     and total 0) had nothing to copy, and every config made or kept in the
     app stayed app-only for ever: New config made it on this device alone,
     and nothing could put it on the board. So the app carries one: the
     board schema's own default document (board/agent/zs_agent/profiles/
     schema.py default_profile(), schema 11, dumped as JSON), used only when
     the board has none to copy. test-exo-light.js encodes it for a Core. */
  var STARTER_DOC = {"schemaVersion":11,"id":"","name":"","description":"","console":"ps5","inputType":"mnk","game":"","inputDevices":{"allowlist":[],"priority":["gamepad","mouse","keyboard"]},"bindings":[{"source":"KEY_W","target":"ly+"},{"source":"KEY_S","target":"ly-"},{"source":"KEY_A","target":"lx-"},{"source":"KEY_D","target":"lx+"},{"source":"KEY_SPACE","target":"south"},{"source":"KEY_LEFTSHIFT","target":"r3"},{"source":"KEY_Q","target":"l1"},{"source":"KEY_R","target":"west"},{"source":"KEY_G","target":"r1"},{"source":"KEY_E","target":"east"},{"source":"KEY_F","target":"dpad_right"},{"source":"KEY_3","target":"dpad_up"},{"source":"KEY_CAPSLOCK","target":"dpad_left"},{"source":"KEY_C","target":"dpad_down"},{"source":"KEY_ESC","target":"guide"},{"source":"KEY_TAB","target":"select"},{"source":"KEY_LEFTALT","target":"start"},{"source":"BTN_LEFT","target":"rt+"},{"source":"BTN_RIGHT","target":"lt+"},{"source":"BTN_MIDDLE","target":"north"},{"source":"BTN_SIDE","target":"l3"},{"source":"BTN_EXTRA","target":"east"}],"mouseTranslation":{"enabled":true,"dpi":1000,"game":"generic","sensitivityX":0.014,"sensitivityY":0.014,"yxRatio":1,"cm360":0,"adsCm360":0,"calibration":null,"invertX":false,"invertY":false,"maxOutput":1,"noiseThreshold":0,"innerDeadzone":0,"outerDeadzone":1,"deadzoneMode":"radial","curve":"linear","curveStrength":1,"curvePoints":[],"boost":0,"steadyAim":0,"feel":"snappy","smoothing":0,"smoothingMode":"oneEuro","oneEuroBeta":1,"smoothingEasing":0.3,"antiDeadzone":0.12,"antiDeadzoneShape":"circle","acceleration":0,"deceleration":0,"maxVelocity":4000,"adsSensitivityScale":0.55,"adsBinding":"BTN_RIGHT","adsSmoothing":null,"adsOneEuroBeta":null,"adsSmoothingEasing":null,"adsCurve":null,"adsCurveStrength":null,"adsCurvePoints":null,"adsBoost":null},"keyboardMovement":{"enabled":false,"walkThreshold":0.55,"rampMs":120,"releaseMs":80,"diagonalShape":"circular","antiDeadzone":0,"turnAssist":0,"stickMerge":"strongest"},"stick":{"mode":"tuned","restZone":0.05},"deadZones":{"leftInner":0.08,"leftOuter":1,"rightInner":0.08,"rightOuter":1,"mode":"radial","triggerThreshold":0.02,"hairTriggerLeft":0,"hairTriggerRight":0},"curves":{"leftStick":{"type":"linear","strength":1,"gain":1,"points":[]},"rightStick":{"type":"linear","strength":1,"gain":1,"adsGain":null,"points":[]}},"smoothing":{"leftStick":0,"rightStick":0},"lighting":{"mode":"solid","color":"0080ff","brightness":100,"speed":20},"artwork":{"kind":"mark"},"axisInvert":{"lx":false,"ly":false,"rx":false,"ry":false},"accessibilityActions":[],"constraints":{"disableButtons":[],"maxStickMagnitude":1,"maxTrigger":1},"output":{"backend":"uinput","rateHz":250,"remotePlay":{"account":"","mac":""}},"aiAdjustment":{"enabled":false,"maxMagnitude":0.2},"vision":{"enabled":false,"target":{"preset":"red"},"reject":{},"filters":{"minAreaFrac":0.0002,"maxAreaFrac":0.25,"minFill":0.1,"minAspect":0.12,"maxAspect":3.5,"crosshairRadius":0.03,"crosshairMaxArea":0.004,"aimX":0.5,"aimY":0.5,"exclude":[]},"tracking":{"minHits":2,"lostAfterMs":350,"matchRadius":0.12,"staticEps":0.0025,"staticAfterS":3,"lockBonus":0.25,"minConfidence":0.3},"assist":{"activation":"ads","strength":0.6,"window":0.12,"deadZone":0.012,"verticalScale":0.6,"playerAuthority":0.7,"smoothingMs":60,"minConfidence":0.35,"recoil":{"enabled":false,"vertical":0.15,"riseS":0.3,"decayMs":150,"horizontal":0,"driftDelayS":0.25},"continuous":{"enabled":true,"viewRate":1,"horizonMs":120}},"regions":[],"model":{"enabled":false,"name":"","path":"","runtime":"auto","inputW":320,"inputH":320,"layout":"NCHW","cropFrac":0.35,"scoreThreshold":0.35,"nmsIou":0.45,"aimFrac":0.32,"aimAt":"body","headFrac":0.12,"everyN":6,"classIds":[0],"labels":["person"],"letterbox":true},"shotAssist":{"enabled":false,"button":"west","abortButton":"","feedbackRegion":"","meter":{"rect":[0.4,0.3,0.22,0.06],"axis":"x","read":"marker","rowStep":4,"colStep":1,"barLumaMin":60,"barMinFrac":0.2,"barRowFrac":0.5,"indLumaMin":200,"indPeakFrac":0.35,"zone":{},"zoneMinFrac":0.03,"zoneMaxFrac":0.4,"aimFrac":0.5,"spanFrac":0,"growAtFrac":1,"growWidthFrac":0.08,"growSoftMult":0},"latencyMs":90,"latencyMinMs":0,"latencyMaxMs":400,"aimOffsetMs":0,"confidenceSigmas":2,"trimStepMs":30,"trimDecay":0.88,"trimMinStepMs":4,"minVerdicts":6,"minSamples":8,"maxSamples":20,"fitWindowMs":250,"minBaselineMs":120,"commitMarginMs":25,"lateGraceMs":0,"fillMinMs":150,"fillMaxMs":1250,"holdMinMs":250,"holdMaxMs":1800,"maxHoldMs":2200,"pressClockMs":0,"pressClockMovingMs":0,"cooldownMs":500,"lateFireSlackMs":16,"minSpeedPerS":0.8,"maxResidualFrac":0.03,"zoneDriftFrac":0.06,"maxGapFrames":2,"endDropFrac":0.35,"priorFireShots":0}}};
  function starterDoc(){ return JSON.parse(JSON.stringify(STARTER_DOC)); }
  function newConfigDoc(pr, small){
    var ids = Object.keys(LIVE.full);
    /* no config on the board to copy: the starter, once the board's list has
       been read and is empty (LIVE.boardIds), never offline */
    var fromStarter = !ids.length;
    if(fromStarter && !(LIVE.boardIds && LIVE.online !== false)) return null;
    var tpl = fromStarter ? STARTER_DOC : (LIVE.full['default'] || LIVE.full[ids[0]]);
    var full = JSON.parse(JSON.stringify(tpl));
    if(fromStarter && !pr.backend){
      /* the starter's backend is the A7S's own (uinput): a Core plays a
         console through the Pico and a PC as an XInput pad (PLAY_FROM) */
      if(!full.output) full.output = {};
      full.output.backend = (ZS.playBackendOf && ZS.playBackendOf(pr.platform)) ||
                            (pr.platform === 'pc' ? 'xinput' : 'pico');
    }
    full.id = pr.id; full.name = pr.name;
    full.console = pr.platform;
    /* D470 rule B: a Native Mouse & Keyboard config (pr.native, the wizard's
       red answer) never touches the controller side: its inputType (and
       inputAuto, sticks, rate, Turn assist below) stay the template's */
    if(!pr.native) full.inputType = pr.input;
    else if(small && typeof full.inputType === 'string') small.input = full.inputType;
    /* D470: Native Mouse & Keyboard is the new config's own choice (the
       wizard's prepare turns it on); the template's flag and tune are the
       template's, never cloned into a config made from it */
    delete full.nativeKbm; delete full.nativeKbmTune;
    /* the game chosen in the wizard — a one-way latch the BOARD enforces
       from here on (schema v9). '' is an honestly gameless config. The
       template clone could otherwise carry the template's own game. */
    full.game = pr.game || '';
    /* nor may it carry the template's game PACK: that is how the app tells a
       config made from a pack from one started from scratch (D115) */
    delete full.gamePack;
    full.description = 'Created from the phone app';
    /* WHERE IT PLAYS is two fields and one decision, exactly as the
       Connection Method panel writes them (setPlayFrom): the console, above,
       and the output backend. The wizard offers the panel's own rows. */
    if(pr.backend){
      if(!full.output) full.output = {};
      full.output.backend = pr.backend;
    }
    /* A NEW controller config starts NATIVE. A beginner should begin at
       something that already feels right — their own pad, 1:1 — and tune
       AWAY from it, rather than starting at an arbitrary curve+deadzone
       and having no idea what "normal" was. It is only applied here, on
       creation: the schema default stays "tuned" so that migrating the
       configs already on the board cannot change how they feel.
       A mouse config is left alone — a mouse has no native stick position
       to be 1:1 with, so "native" would be a meaningless word there. */
    /* Asked as "does this config have a pad?", not "is it the controller
       type?" — a Joystick + Mouse config has a real stick in a real hand,
       so it deserves the same honest 1:1 starting point. Only a config
       with no stick at all is left alone. */
    /* D241 (owner, 2026-10-09: "thumbstick should be on Native by
       default"): EVERY new config starts Native - its input is detected now
       (D237) and can become a pad config later, so a mouse config made today
       must not carry the schema's tuned default into a stick tomorrow */
    if(!pr.native){
      if(!full.stick) full.stick = {};
      full.stick.mode = 'native';
      if(typeof full.stick.restZone !== 'number') full.stick.restZone = 0.05;
      if(!full.curves) full.curves = {};
      ['leftStick','rightStick'].forEach(function(side){
        if(!full.curves[side]) full.curves[side] = {type:'linear', strength:1.0, points:[]};
        full.curves[side].gain = 1.0;   /* 100% == exactly the pad */
      });
    }
    /* the game pack goes LAST, so a pack that calibrated the stick wins over
       the native start above; a pack that did not leaves it alone */
    var tplRate = full.output ? full.output.rateHz : undefined;
    if(typeof pr.prepare === 'function') pr.prepare(full, small || pr);
    /* D392: a new MOUSE config runs at 1000 Hz: every count reaches the
       console fresher and a stop lands in 1 ms (docs/MOUSE-AUDIT.md
       "after"). Only over the template's own rate (a pack that recommends
       a rate keeps it), and only from the old 250 default or none. The
       console still reads at its own pace; this never makes it read faster. */
    if(!pr.native && inputShows(pr.input, 'mouse')){
      if(!full.output) full.output = {};
      var r = full.output.rateHz;
      if(r === tplRate && (r === undefined || r === null || r === 250)) full.output.rateHz = 1000;
      /* D392: Fine aim starts OFF on a game with a measured translator (a
         pack's measured model): there every move already turns exactly as
         far as the hand, and Fine aim bends that. The template's own Fine
         aim would otherwise ride into the new config. */
      var rm = full.mouseTranslation && full.mouseTranslation.resolvedAimModel;
      if(rm && typeof rm === 'object' && rm.generic !== true && rm.needsCalibration === false){
        full.mouseTranslation.fineAim = 0;
        delete full.mouseTranslation.adsFineAim;
      }
    }
    /* D280/D291: a mouse config starts with Turn assist on keyboard X
       (whatever X did here moves off it, kept, D291; a template still on the old
       shipped layout gets the new one first), after the pack so the X it
       checks is the pack's. The template's "already offered" mark is the
       template's, not the new config's: a copy it carries is kept (and not
       doubled), and nothing else stops the new config's own turn. */
    if(!pr.native){
      delete full.turnAssistOffered;
      if(window.ZS_SMART && typeof ZS_SMART.seedTurnAssist === 'function')
        ZS_SMART.seedTurnAssist(small || pr, full, {fresh:true});
    }
    /* THE PLAYER'S COLOUR IS THE LAST WORD (D120). The wizard's choice goes
       into lighting.color, the field the adapter itself reads (on a Core,
       the D103 LIGHTING section its onboard light shows), not only into the
       list mark. After the pack's turn, so no pack can
       overrule a choice the player just made (a pack cannot carry lighting
       today, and this makes that a rule rather than a coincidence). It is a
       solid colour because a colour was chosen; brightness and speed are
       the template's, exactly as Overview's carousel keeps them. */
    var hex = String(pr.color == null ? '' : pr.color).replace('#','').toLowerCase();
    if(/^[0-9a-f]{6}$/.test(hex)){
      var lg = (full.lighting && typeof full.lighting === 'object') ? full.lighting : {};
      full.lighting = { mode:'solid', color:hex,
        brightness: Math.round(typeof lg.brightness==='number' ? lg.brightness : 100),
        speed: Math.round(typeof lg.speed==='number' ? lg.speed : 20) };
    }
    return full;
  }
  /* A game pack's picture only counts once it has loaded (game-packs.js), and
     that lands after HOME's first paint. One repaint of HOME then, through
     the same gate the poll uses, so a panel the player is reading is never
     redrawn under them. */
  if(window.ZSPACKS) ZSPACKS.onChange(function(kind){
    /* 'packs' too (D300 amended): a config known only by its game's name
       learns whether that game is Coming soon when the list lands */
    if(kind==='art' || kind==='packs') renderHomeIfVisible();
  });

  /* ── API for phone-sections.js ─────────────────────────────────── */
  /* M9 (audit 2026-10-10): a new config's document, saved the way an edit
     is (saveToCore, D103): a Core gets the bytes by id (create-or-replace,
     it has nothing to POST to), an EXO gets the JSON POST. */
  function createProfileDoc(doc){
    return (productId() === 'core') ? saveToCore(doc.id, doc) : api('/profiles', 'POST', doc);
  }
  /* WHY A CONFIG HAS NO DOCUMENT HERE, IN TRUE WORDS (2026-11-04). The owner
     met "saved on this device, your board is offline" with the board
     plugged in: the screen took "no document" to mean "offline". It can mean
     three things, and each is said as it is:
       'offline'  the link is down;
       'absent'   the board's list was read and this config is not in it
                  (a preview config, or one made while the board was away);
       'unread'   the board has it (or its list is still being read) and
                  this app has not loaded its settings yet.
     '' when the document is here. loadDoc() fetches one config's copy and
     redraws the open screen when it lands; noDocSay() is the toast. */
  function noDocWhy(pid){
    if(LIVE.online === false) return 'offline';
    if(pid && LIVE.full[pid]) return '';
    if(LIVE.boardIds && !LIVE.boardIds[pid]) return 'absent';
    return 'unread';
  }
  var docLoading = {};
  function loadDoc(pid){
    if(!pid || LIVE.online === false || LIVE.full[pid]) return Promise.resolve(!!(pid && LIVE.full[pid]));
    if(docLoading[pid]) return docLoading[pid];
    docLoading[pid] = getProfileDoc(pid).then(function(f){
      delete docLoading[pid];
      if(!(f && f.ok && f.data)) return false;
      LIVE.full[pid] = adoptBoard(pid, f.data);
      if(LIVE.boardIds) LIVE.boardIds[pid] = 1;
      if(editId === pid){ try{ redrawOpenScreen(); }catch(e){} }
      return true;
    }, function(){ delete docLoading[pid]; return false; });
    return docLoading[pid];
  }
  /* lead: what was just done ('Colour → Red'); offline: the words for a
     link that is down, as the caller has always said them */
  function noDocSay(pid, lead, offline){
    var why = noDocWhy(pid);
    function say(t, opt){ toast(lead ? lead + ' — ' + t : t.charAt(0).toUpperCase() + t.slice(1), opt); }
    if(why === 'offline'){
      say(offline || 'your board is offline');
    } else if(why === 'absent'){
      say('this config isn’t on your board yet, so it is kept on this device only', {
        ms: 8000, action: 'Put it on my board',
        onAction: function(){ putOnBoard(pid); }
      });
    } else if(why === 'unread'){
      say('this config’s settings haven’t loaded from your board yet', {
        action: 'Load now',
        onAction: function(){
          loadDoc(pid).then(function(ok){
            toast(ok ? 'Loaded from your board' : 'Your board did not send this config. Try again in a moment.');
          });
        }
      });
      loadDoc(pid);
    }
    return why;
  }
  /* PUT AN APP-ONLY CONFIG ON THE BOARD, ONE TAP (2026-11-04). The owner's
     "NBA 2K27" lived only in this app (left from his dev kit; the rev A
     board had no configs at all), so every settings page said the board was
     offline. This makes its board copy the way New config makes one
     (newConfigDoc: a copy of a config the board has, or the starter; its
     name, console, input, game pack and colour from the list row), saves it
     by the one create path (createProfileDoc: a Core takes the bytes), and
     runs it when it is the config this app has running. Then every page
     has its document and works. Resolves {ok}. */
  var putting = {};
  function putOnBoard(pid){
    var p = prof(pid);
    if(!p) return Promise.resolve({ok:false, error:'no such config'});
    if(LIVE.online === false){ toast('Your board is offline. Connect it, then put this config on it.'); return Promise.resolve({ok:false, error:'offline'}); }
    if(LIVE.full[pid]) return Promise.resolve({ok:true, already:true});
    if(putting[pid]) return putting[pid];
    var pk = null;
    if(window.ZSPACKS && p.pack !== 'scratch'){
      pk = (p.pack && ZSPACKS.get(p.pack)) || (p.game && ZSPACKS.forGame ? ZSPACKS.forGame(p.game) : null) || null;
    }
    var hex = String(STORE.vals['lightbar|'+pid] || p.color || '').replace('#','').toLowerCase();
    var pr = { id: pid, name: p.name || 'My config', platform: p.platform || 'ps5', input: p.input || 'controller',
               game: p.game || '', color: /^[0-9a-f]{6}$/.test(hex) ? '#'+hex : '',
               backend: ZS.playBackendOf ? ZS.playBackendOf(p.platform) : undefined,
               prepare: (pk && ZS.packPrepare) ? ZS.packPrepare(pk, p.input || 'controller') : null };
    var small = { id: pid, name: pr.name, platform: pr.platform, input: pr.input, game: pr.game, pack: p.pack || '', color: p.color };
    var full = newConfigDoc(pr, small);
    if(!full){
      toast('Your board’s config list has not been read yet. Try again in a moment.');
      return Promise.resolve({ok:false, error:'no list'});
    }
    full.description = 'Put on the board from the app';
    toast('Putting “'+pr.name+'” on your board…', {ms: 4000});
    putting[pid] = Promise.resolve(createProfileDoc(full)).then(function(j){
      delete putting[pid];
      j = j || {ok:false};
      if(!j.ok){
        if(productId() !== 'core') toast('Your board did not take it'+((j.errors && j.errors[0]) ? ': '+j.errors[0] : (j.error ? ': '+j.error : '')));
        return j;
      }
      LIVE.full[pid] = full;
      if(LIVE.boardIds) LIVE.boardIds[pid] = 1;
      if(small.nativeKbm) p.nativeKbm = true;
      persist();
      if(pid === activeId) api('/profiles/'+encodeURIComponent(pid)+'/activate', 'POST', {});
      try{ renderHome(); }catch(e){}
      if(editId === pid){ try{ redrawOpenScreen(); }catch(e){} }
      toast('“'+pr.name+'” is on your board now. Every setting works.', {ms: 4000});
      return j;
    }, function(e){
      delete putting[pid];
      toast('Your board did not answer. Try again in a moment.');
      return {ok:false, error:String(e && e.message || e)};
    });
    return putting[pid];
  }

  /* THE TRUTH ON EVERY CONFIG SCREEN (2026-11-04, the owner: "this whole
     settings part doesn't see the board even though other things do").
     Dozens of screens read "no document" as "the board is offline" in their
     own words. Rather than trust every one of them, the screen door
     (openDetail, shell/11-detail-swipe.js) asks here: a config screen whose
     config has no document while the link is up gets a banner at the top
     with the real reason and its one action, and any note on it that says
     the board is offline is put right. Toasts get the same (toastTruth, used
     by toast()). Nothing changes when the link is really down. */
  var OFFLINE_WORDS = /\b(board|adapter|core)\b[^.<]{0,24}\boffline\b|\boffline\b[^.<]{0,12}\b(board|adapter|core)\b|\bboard (did not|didn.t) answer\b/i;
  function noDocTruth(why){
    return why === 'absent'
      ? '<b>This config isn’t on your board yet.</b> It is only in this app, so its settings cannot reach the board. Put it on your board and every setting works.'
      : '<b>This config’s settings haven’t loaded from your board yet.</b> Your board is connected.';
  }
  function noDocBannerHTML(pid){
    var why = noDocWhy(pid);
    if(why !== 'absent' && why !== 'unread') return '';
    return '<div class="nodoc-bar" id="nodoc-bar" data-nodoc="'+why+'" role="status" style="margin:0 0 12px">'+
      '<div class="note warn">'+noDocTruth(why)+'</div>'+
      '<button type="button" class="btn primary" id="nodoc-go" style="width:100%;min-height:48px;margin-top:8px">'+
        (why === 'absent' ? 'Put this config on my board' : 'Load it now')+'</button></div>';
  }
  function noDocFixNotes(body, why){
    var line = why === 'absent' ? 'This config isn’t on your board yet, so this cannot reach it. Put it on your board (the key at the top).'
                                : 'This config’s settings haven’t loaded from your board yet. Your board is connected.';
    body.querySelectorAll('.note').forEach(function(n){
      if(n.closest && n.closest('#nodoc-bar')) return;
      if(OFFLINE_WORDS.test(n.textContent || '')) n.textContent = line;
    });
  }
  function noDocDress(body, pid){
    if(!body || !pid) return;
    var why = noDocWhy(pid);
    var old = body.querySelector('#nodoc-bar');
    if(why !== 'absent' && why !== 'unread'){ if(old) old.remove(); return; }
    if(!old){
      var tmp = document.createElement('div');
      tmp.innerHTML = noDocBannerHTML(pid);
      var bar = tmp.firstChild;
      body.insertBefore(bar, body.firstChild);
      var go = bar.querySelector('#nodoc-go');
      go.addEventListener('click', function(){
        go.disabled = true;
        var run = why === 'absent' ? putOnBoard(pid)
