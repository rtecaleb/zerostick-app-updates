    $('c-other').addEventListener('click', function () { B.forget().then(function () { doConnect(true); }); });
    $('c-wifi').addEventListener('click', function () {
      try { localStorage.setItem('zsdongle:zsCalibratorLink', 'wifi'); } catch (e) { /* ok */ }
      location.href = 'calibrator.html';
    });

    $('h-cal').addEventListener('click', function () {
      try { localStorage.setItem('zsdongle:zsCalibratorLink', 'ble'); } catch (e) { /* ok */ }
      openCal();
    });
    $('h-scr').addEventListener('click', function () { go('#scripts'); });
    $('h-disc').addEventListener('click', function () {
      B.disconnect().then(function () { go('#'); render(); });
    });
    $('h-forget').addEventListener('click', function () {
      sheet({
        title: 'Forget this dongle?',
        body: 'The app will stop connecting to it by itself. Your scripts stay saved on the dongle.',
        buttons: [
          { label: 'Forget', kind: 'danger', fn: function () {
            closeSheet();
            B.forget().then(function () { go('#'); render(); $('c-other').hidden = true; $('c-go').textContent = 'Connect'; });
          } },
          { label: 'Cancel', fn: closeSheet }
        ]
      });
    });

    $('s-master').addEventListener('click', function () {
      var on = $('s-master').getAttribute('aria-checked') !== 'true';
      $('s-master').setAttribute('aria-checked', on ? 'true' : 'false');
      if (app.link) { app.link.enabled = on; }
      B.scriptsEnable(on).then(function () {
        toast(on ? 'Scripts on' : 'Scripts off: sticks work normally');
      }, fail);
    });
    $('s-slots').addEventListener('click', function (ev) {
      var u = ev.target.closest('[data-use]'), ed = ev.target.closest('[data-edit]');
      if (u) { selectSlot(+u.getAttribute('data-use')); return; }
      if (ed) { go('#edit/' + ed.getAttribute('data-edit')); }
    });
    $('s-pair').addEventListener('click', pairStart);
    $('s-calbtn').addEventListener('click', function () { calCmd(1); });
    $('s-calstop').addEventListener('click', function () { calCmd(2); });
    $('h-fwrow').addEventListener('click', function () { go('#update'); });
    $('u-go').addEventListener('click', function () { startUpdate('dongle'); });
    $('u-fgo').addEventListener('click', function () { startUpdate('flex'); });
    $('u-cancel').addEventListener('click', cancelUpdate);
    /* "?" buttons: explanations and raw numbers live behind them */
    document.addEventListener('click', function (ev) {
      var q = ev.target.closest('[data-more]');
      if (!q) { return; }
      var box = $(q.getAttribute('data-more')), open = box.hidden;
      box.hidden = !open;
      q.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    $('s-linkbtn').addEventListener('click', pairStart);

    /* editor */
    $('e-name').addEventListener('input', function () {
      if (!app.edit) { return; }
      var v = $('e-name').value;
      app.edit.name = (v === 'Script ' + (app.edit.slot + 1)) ? '' : v.replace(/^\s+|\s+$/g, '');
      paintEditor();
    });
    allCtls().forEach(function (c) {
      $('in-' + c.k).addEventListener('input', function () { change(c.k, +this.value); });
    });
    Array.prototype.forEach.call(document.querySelectorAll('.step'), stepper);
    $('e-aimtype').addEventListener('click', function (ev) {
      var b = ev.target.closest('[data-v]');
      if (b) { change('aimType', +b.getAttribute('data-v')); }
    });
    $('e-awf').addEventListener('click', function () { change('aimWhileFiring', !app.edit.cur.aimWhileFiring); });
    $('e-inv').addEventListener('click', function () { change('invertY', !app.edit.cur.invertY); });
    document.addEventListener('click', function (ev) {
      var p = ev.target.closest('[data-preset]');
      if (!p || !app.edit) { return; }
      app.edit.cur = S.applyPreset(app.edit.cur, p.getAttribute('data-preset'));
      paintEditor();
    });
    $('e-reset').addEventListener('click', function () {
      if (!app.edit) { return; }
      app.edit.cur = S.defaults();
      paintEditor();
    });
    $('e-save').addEventListener('click', function () { save().then(null, function () {}); });
    $('e-use').addEventListener('click', function () {
      var slot = app.edit.slot;
      (dirty() ? save() : Promise.resolve()).then(function () { return selectSlot(slot); }).then(renderUseButton, function () {});
    });

    $('scrim').addEventListener('click', function (ev) { if (ev.target === $('scrim')) { closeSheet(); } });
    document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape' && !$('scrim').hidden) { closeSheet(); } });

    window.addEventListener('hashchange', function () {
      if (app.route === 'edit' && dirty() && parseHash().name !== 'edit') {
        /* system back gesture from the editor: ask, then carry on */
        var target = location.hash || '#';
        history.replaceState(null, '', '#edit/' + app.edit.slot);
        leaveEditor(function () { go(target); });
        return;
      }
      render();
    });

    B.onDisconnect(function () {
      if (app.updating) { return; }      /* the update reconnects by itself */
      stopPoll();
      pairGen++;
      closeSheet();
      app.edit = null;
      if (location.hash) { history.replaceState(null, '', location.pathname + location.search); }
      render();
      $('toast').className = 'hide';
      connectError({ zsKind: 'disconnected' });
      $('c-go').textContent = 'Reconnect';
    });
    window.addEventListener('beforeunload', function (ev) {
      if ((app.route === 'edit' && dirty()) || app.updating) { ev.preventDefault(); ev.returnValue = ''; }
    });
  }

  /* ── start ──────────────────────────────────────────────────────────── */
  function start() {
    wire();
    var mem = B.remembered();
    $('c-other').hidden = !mem;
    render();
    if (!mem) { return; }
    /* a remembered dongle reconnects by itself, no chooser */
    busy('Reconnecting to your dongle…');
    B.reconnect().then(connected, function (e) {
      busy('');
      if (e && e.zsKind === 'none') { return; }        /* this browser needs a tap first */
      connectError(e);
    });
  }

  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', start); }
  else { start(); }
})();
