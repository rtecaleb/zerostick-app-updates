/* zs-dongle-app.js — the ZeroStick Dongle screens (dongle.html).
 *
 * ES5 ONLY, like the rest of the app.
 *
 *   #          connect (not connected) or the hub (connected): device info
 *              + the two big choices
 *   #scripts   Recoil & Aim (Script Edition): stick-flex link, master
 *              switch, what's running now, the 8 script slots
 *   #edit/N    one script: name, presets, sliders
 *   #update    firmware update (dongle now; the stick flex slots in later)
 *
 * Talks only to window.ZSHIDBLE (js/hid-ble.js), window.ZSScripts
 * (js/zs-scripts.js) and window.ZSFW (js/zs-fw.js). Protocol: dongle
 * firmware 0.9.0 (DSE Recoil Mod docs/CALIBRATION-DONGLE.md, STICK-LINK.md).
 * Desktop testing: open dongle.html?mock=1.
 */
(function () {
  'use strict';

  var B = window.ZSHIDBLE, S = window.ZSScripts, F = window.ZSFW;

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

  var app = {
    route: '', slots: [], slotsLoaded: false, names: [], link: null,
    dev: null, cal: null, fw: null, edit: null, pollTimer: null, pollGen: 0, updating: null
  };

  /* ── toast ──────────────────────────────────────────────────────────── */
  var toastTimer;
  function toast(msg, bad) {
    var t = $('toast');
    t.textContent = msg;
    t.className = bad ? 'bad' : '';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { t.className = 'hide' + (bad ? ' bad' : ''); }, bad ? 4200 : 2400);
  }
  function fail(e) { var x = B.explain(e); toast(x.title + '. ' + x.text, true); }

  /* ── sheet (bottom dialog) ──────────────────────────────────────────── */
  function sheet(o) {
    $('sh-t').textContent = o.title;
    $('sh-b').innerHTML = o.body || '';
    $('sh-art').innerHTML = o.art || '';
    $('sh-art').hidden = !o.art;
    var box = $('sh-btns');
    box.innerHTML = '';
    (o.buttons || []).forEach(function (b) {
      var el = document.createElement('button');
      el.className = 'btn ' + (b.kind || 'second');
      el.textContent = b.label;
      el.addEventListener('click', b.fn);
      box.appendChild(el);
    });
    $('scrim').hidden = false;
    var first = box.querySelector('button');
    if (first) { first.focus(); }
  }
  function closeSheet() { $('scrim').hidden = true; }

  /* ── routing ────────────────────────────────────────────────────────── */
  function show(id, title) {
    ['v-connect', 'v-hub', 'v-scripts', 'v-edit', 'v-update'].forEach(function (v) { $(v).hidden = v !== id; });
    $('title').textContent = title;
    var chip = $('linkchip');
    chip.hidden = !(B.isConnected() && (id === 'v-scripts' || id === 'v-edit' || id === 'v-update'));
    chip.className = 'chip ok';
    chip.lastChild.textContent = 'Dongle';
    window.scrollTo(0, 0);
  }

  function parseHash() {
    var h = (location.hash || '').replace(/^#/, '');
    var m = /^edit\/(\d)$/.exec(h);
    if (m) { return { name: 'edit', slot: +m[1] }; }
    if (h === 'scripts') { return { name: 'scripts' }; }
    if (h === 'update') { return { name: 'update' }; }
    return { name: '' };
  }

  function render() {
    var r = parseHash();
    stopPoll();
    if (app.updating) {                 /* the update screen stays up, even while it reconnects */
      app.route = 'update';
      show('v-update', 'Firmware update');
      renderUpdate();
      return;
    }
    if (!B.isConnected()) {
      app.route = 'connect';
      show('v-connect', 'ZeroStick Dongle');
      return;
    }
    if (r.name === 'scripts' || r.name === 'edit') { r = { name: '' }; }   /* no stick-flex screens on this device */
    if (r.name === 'scripts') {
      app.route = 'scripts';
      show('v-scripts', 'Recoil & Aim');
      renderSlots();
      if (!app.slotsLoaded) { loadSlots(); }
      startPoll(300);
      return;
    }
    if (r.name === 'edit' && r.slot < S.SLOTS) {
      app.route = 'edit';
      show('v-edit', 'Edit script');
      openEditor(r.slot);
      startPoll(1500);
      return;
    }
    if (r.name === 'update') {
      app.route = 'update';
      show('v-update', 'Firmware update');
      renderUpdate();
      startPoll(2000);
      return;
    }
    /* calibration only (owner 2026-10-23): a connected dongle goes straight
       to the calibrator - no hub, no stick-flex screens on this device */
    app.route = 'cal';
    show('v-hub', 'ZeroStick Dongle');
    openCal();
  }

  function go(hash) {
    if (location.hash === hash || (!location.hash && hash === '#')) { render(); return; }
    location.hash = hash;
  }

  /* ── connect ────────────────────────────────────────────────────────── */
  function busy(text) {
    $('c-busy').hidden = !text;
    $('c-busytext').textContent = text || '';
    $('c-go').disabled = !!text;
    if (text) { $('c-err').hidden = true; }
  }
  function connectError(e) {
    busy('');
    var x = B.explain(e);
    $('c-errt').textContent = x.title;
    $('c-errd').textContent = x.text;
    $('c-err').hidden = false;
    $('c-fix').hidden = !x.fix || !B.isApp();
    $('c-fix').textContent = x.fix === 'bt-settings' ? 'Open Bluetooth settings' : 'Open Settings';
    $('c-fix').onclick = function () { B.openSettings(x.fix); };
    $('c-go').textContent = 'Try again';
    $('c-other').hidden = !B.remembered();
  }

  function connected() {
    busy('');
    $('c-err').hidden = true;
    app.slotsLoaded = false;
    app.link = null;
    app.cal = null;
    app.fw = null;
    app.flexChecked = null;
    app.names = S.getNames(B.info().id);
    render();
    /* what's in it + is there newer firmware in this app */
    B.devinfo().then(function (d) {
      app.dev = d;
      if (app.route === 'hub') { renderHub(); }
      return F.check('dongle', d.chipCode, d.version).then(function (r) {
        app.fw = app.fw || {};
        app.fw.dongle = r;
        if (app.route === 'hub') { renderHub(); }
        if (app.route === 'update') { renderUpdate(); }
      });
    }).then(null, function () { /* no manifest / old firmware: no update offered */ });
  }

  function doConnect(fresh) {
    busy('Connecting… pick "ZeroStick Dongle" if your phone asks.');
    var mem = B.remembered();
    var p = (!fresh && mem && B.isApp()) ?
      B.reconnect().then(null, function (e) {
        if (e && e.zsKind === 'none') { return B.connect(); }
        throw e;
      }) : B.connect();
    p.then(connected, connectError);
  }

  /* ── hub ────────────────────────────────────────────────────────────── */
  function padName(pid) {
    if (pid === 0x0DF2) { return 'DualSense Edge'; }
    if (pid === 0x0CE6) { return 'DualSense'; }
    if (pid === 0x05C4 || pid === 0x09CC) { return 'DualShock 4'; }
    return 'Controller';
  }
  function flexWords(code) {
    if (code == null) { return { t: 'Checking…', c: '' }; }
    if (code === 4) { return { t: 'Connected', c: 'ok' }; }
    if (code === 2 || code === 3) { return { t: 'Connecting…', c: 'warn' }; }
    if (code === 1) { return { t: 'Looking…', c: 'warn' }; }
    if (code === 5) { return { t: 'Not paired yet', c: '' }; }
    return { t: 'Starting…', c: '' };                    /* 0: first second after power-up */
  }
  function padWords(d) {
    if (!d) { return { t: 'Checking…', c: '' }; }
    if (d.padCode === 2) { return { t: padName(d.pid), c: 'ok' }; }
    if (d.padCode === 1) { return { t: 'Starting…', c: 'warn' }; }
    if (d.padCode === 3) { return { t: 'Not supported', c: 'bad' }; }
    if (d.padCode === 4) { return { t: 'Port switched off', c: 'bad' }; }
    return { t: 'Not plugged in', c: '' };
  }
  /* the Power line: plain words up front, the numbers behind the ? */
  function powerWords(d) {
    if (!d) { return { t: 'Checking…', c: '', d: '' }; }
    if (d.lowNow) {
      return { t: 'Too low', c: 'bad', d: 'The USB port the dongle is plugged into is not giving enough power right now. Plug the dongle into a different USB port on the PS5 (the back ports are usually stronger).' };
    }
    if (d.padCode === 4 || (d.overCurrent && !d.padPowered)) {
      return { t: 'Controller port off', c: 'bad', d: 'The controller drew too much power, so the dongle switched its port off to protect it. It tries again by itself. If this keeps happening, try a different USB cable.' };
    }
    if (d.sagged || (d.consoleMv && d.consoleMv < 4500)) {
      return { t: 'Dipped', c: 'warn', d: 'The power from the USB port dipped at some point. Everything still works; a different USB port may be steadier.' };
    }
    return { t: 'Good', c: 'ok', d: '' };
  }
  function color(c) {
    return c === 'ok' ? 'var(--ok)' : (c === 'warn' ? 'var(--warn)' : (c === 'bad' ? 'var(--bad)' : 'var(--muted)'));
  }
  function volts(mv) { return mv ? (mv / 1000).toFixed(2) + ' V' : 'not measured'; }
  var RESETS = ['the app restarted it', 'it was plugged in', 'it recovered from a freeze', 'its reset pin'];
  function renderHub() {
    var i = B.info(), d = app.dev;
    if (!i) { return; }
    $('h-name').textContent = i.name || 'ZeroStick Dongle';
    $('h-fw').textContent = 'Firmware ' + (d ? d.version : String(i.version));
    var w = padWords(d);
    $('h-pad').textContent = w.t; $('h-pad').style.color = color(w.c);
    w = flexWords(d ? d.linkCode : null);
    $('h-flex').textContent = w.t; $('h-flex').style.color = color(w.c);
    w = powerWords(d);
    $('h-pow').textContent = w.t; $('h-pow').style.color = color(w.c);
    $('h-powd').textContent = w.d;
    $('h-powd').hidden = !w.d;
    if (d) {
      $('h-powmore').innerHTML =
        'Power from the console\'s USB port: <b>' + volts(d.consoleMv) + '</b><br>' +
        'Power to the controller: <b>' + (d.padPowered ? volts(d.padMv) : 'switched off') + '</b><br>' +
        'Controller port over-current trips since plug-in: <b>' + d.overCurrent + '</b><br>' +
        'Port dipped below 4.4 V since plug-in: <b>' + (d.sagged ? 'yes' : 'no') + '</b><br>' +
        'Last restart: <b>' + esc(RESETS[d.resetCause] || ('code ' + d.resetCause)) + '</b><br>' +
        'Chip: <b>' + esc(d.chip) + '</b>' + (d.unsaved ? ' · settings waiting to be saved' : '') +
        '<br><span class="faint">Healthy is about 4.75 to 5.25 V. Below 4.4 V the dongle still runs; below 4.0 V it stops saving until the power recovers.</span>';
    }
    var fw = $('h-fwchip'), fd = app.fw && app.fw.dongle, ff = app.fw && app.fw.flex;
    if ((fd && fd.available) || (ff && ff.available)) { fw.className = 'chip ion'; fw.textContent = 'Update ready'; }
    else if (fd) { fw.className = 'chip ok'; fw.textContent = 'Up to date'; }
    else { fw.className = 'chip'; fw.textContent = d ? d.version : '–'; }
    $('h-fwrow').querySelector('.d').textContent = 'Dongle and stick flex.';
  }

  /* ── the calibrator, on this page (owner 2026-10-23) ─────────────────
     It opens in a full-screen frame over the hub instead of as a new page:
     a page change drops the PC's Web Bluetooth link and the browser cannot
     get it back without the chooser ("pair again"). The frame borrows this
     page's link (js/zs-ble-embed.js); its back key, the system back and
     Escape close it. */
  var calFrame = null;
  function openCal() {
    if (calFrame) { return; }
    stopPoll();
    calFrame = document.createElement('iframe');
    calFrame.id = 'calframe';
    calFrame.title = 'Calibrator';
    calFrame.src = 'calibrator.html?from=dongle&embed=1' + (/[?&]app=1(&|$)/.test(location.search) ? '&app=1' : '');
    document.body.appendChild(calFrame);
    document.body.classList.add('cal-open');
    try { history.pushState({ zsCal: 1 }, '', location.href); } catch (e) { /* ok */ }
  }
  /* the calibrator's back key: there is no hub behind it, so back means
     leave - let go of the dongle and return to the device list */
  function closeCal() {
    if (!calFrame) { return; }
    calFrame.remove();
    calFrame = null;
    document.body.classList.remove('cal-open');
    var to = '../devices.html?pick=1' + (/[?&]app=1(&|$)/.test(location.search) ? '&app=1' : '');
    var left = false;
    function leave() { if (!left) { left = true; location.href = to; } }
    setTimeout(leave, 4000);
    B.disconnect().then(leave, leave);
  }
  window.addEventListener('message', function (ev) {
    if (!calFrame || ev.source !== calFrame.contentWindow || ev.origin !== location.origin) { return; }
    if (ev.data && ev.data.zs === 'cal-close') {
      if (history.state && history.state.zsCal) { history.back(); } else { closeCal(); }
    }
  });
  window.addEventListener('popstate', function () { if (calFrame) { closeCal(); } });

  /* ── polling (one call at a time, never piles up) ───────────────────── */
  function stopPoll() { app.pollGen++; clearTimeout(app.pollTimer); }
  function startPoll(every) {
    var gen = ++app.pollGen, n = 0;
    function tick() {
      if (gen !== app.pollGen || !B.isConnected()) { return; }
      var work, k = n++;
      if (app.route === 'hub') {
        work = B.devinfo().then(function (d) { app.dev = d; });
        if (k % 3 === 0) { work = work.then(function () { return B.link(); }).then(gotLink); }
      } else {
        work = B.link().then(gotLink);
        if (app.route === 'scripts' && k % 6 === 0) {
          work = work.then(function () { return B.devinfo(); }).then(function (d) { app.dev = d; });
        }
        /* stick flex setup: fast while it runs, slow otherwise */
        if (app.route === 'scripts' && (k % 6 === 0 || calBusy() || (app.link && app.link.flex.calibrating))) {
          work = work.then(function () { return B.flexCal(0); }).then(function (c) { app.cal = c; });
        }
      }
      work.then(function () {
        if (gen !== app.pollGen) { return; }
        if (app.route === 'hub') { renderHub(); }
        if (app.route === 'scripts') { renderLink(); renderCal(); }
        if (app.route === 'update' && !app.updating) { renderUpdate(); }
        if (app.route === 'edit') { renderUseButton(); }
      }, function () { /* a missed poll is fine; disconnects arrive as an event */ }).then(function () {
        if (gen === app.pollGen) { app.pollTimer = setTimeout(tick, every); }
      });
    }
    tick();
  }
  function gotLink(l) {
    app.link = l;
    /* the flex's version is only known once it is linked: check then */
    if (l.linkCode === 4 && l.flexVersion && app.flexChecked !== l.flexVersion) {
      app.flexChecked = l.flexVersion;
      F.check('flex', l.flexChip, l.flexVersion).then(function (r) {
        app.fw = app.fw || {};
        app.fw.flex = r;
        if (app.route === 'update' && !app.updating) { renderUpdate(); }
        if (app.route === 'hub') { renderHub(); }
      }, function () { /* no manifest */ });
    }
  }
  function calBusy() { return !!(app.cal && (app.cal.stateCode === 1 || app.cal.stateCode === 2)); }

  /* ── Recoil & Aim screen ────────────────────────────────────────────── */
  var ICONS = {
    ok: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
    wait: '<div class="spin" style="width:26px;height:26px;flex-basis:26px;border-width:3.5px;border-top-color:#fbbf24"></div>',
    none: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#a9b5c5" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg>'
  };
  function renderLink() {
    var l = app.link, t, d, ic, bg, btn = false;
    if (!l) { return; }
    if (l.linkCode === 4 && l.flex.updating) {
      t = 'Stick flex updating'; ic = ICONS.wait; bg = 'var(--warn-wash)';
      d = 'Your stick works normally until it\'s done. Scripts are paused.';
    } else if (l.linkCode === 4) {
      t = 'Stick flex connected'; ic = ICONS.ok; bg = 'var(--ok-wash)';
      d = (l.flexVersion ? 'Stick flex firmware ' + l.flexVersion + '. ' : '') + 'Ready when you pull the triggers.';
    } else if (l.linkCode === 2 || l.linkCode === 3) {
      t = 'Connecting to your stick flex…'; ic = ICONS.wait; bg = 'var(--warn-wash)';
      d = 'This takes a few seconds.';
    } else if (l.linkCode === 1) {
      t = 'Looking for your stick flex…'; ic = ICONS.wait; bg = 'var(--warn-wash)';
      d = 'Turn your controller on and keep it near the dongle.';
    } else if (l.linkCode === 5) {
      t = 'No stick flex paired yet'; ic = ICONS.none; bg = 'var(--zs-control)';
      d = 'Recoil & Aim works through the ZeroStick stick flex fitted inside your controller. ' +
          'Pair it once and the dongle remembers it. You can set up your scripts now either way.';
      btn = true;
    } else {
      t = 'Starting up…'; ic = ICONS.wait; bg = 'var(--warn-wash)';
      d = 'The dongle has just been plugged in. This takes a second.';
    }
    /* things the stick flex reports about itself */
    var warn = '';
    if (l.linkCode === 4 && l.hasFlags && !l.flex.railOk) {
      warn = 'The stick flex is short of power. Charge the controller or plug it in, then try again.';
    } else if (l.linkCode === 4 && l.flex.failsafe) {
      warn = 'The link to the stick flex dropped for a moment, so it stopped to keep your sticks normal. Keep the controller nearer the dongle.';
    }
    $('s-linkwarn').textContent = warn;
    $('s-linkwarn').hidden = !warn;
    $('s-sat').hidden = !(l.linkCode === 4 && l.flex.saturated);
    if ($('s-linkt').textContent !== t) {
      $('s-linkt').textContent = t;
      $('s-linkic').innerHTML = ic;
      $('s-linkic').style.background = bg;
    }
    $('s-linkd').textContent = d;
    $('s-linkbtn').hidden = !btn;

    var m = $('s-master');
    m.setAttribute('aria-checked', l.enabled ? 'true' : 'false');
    $('s-masterd').textContent = l.enabled ? 'On: your scripts run when you hold the triggers.' :
      'Off: your sticks work normally.';

    $('s-slotchip').textContent = S.displayName(app.names, l.slot);
    var a = l.enabled ? l.act : 'idle';
    Array.prototype.forEach.call($('s-live').children, function (el) {
      el.classList.toggle('on', el.getAttribute('data-a') === a);
    });
    var noPad = app.dev && app.dev.padCode !== 2;
    var hint = $('s-livehint');
    hint.style.color = noPad ? 'var(--warn)' : '';
    hint.innerHTML = noPad ?
      '<b>No controller plugged into the dongle.</b> Plug it in with its USB cable: the dongle needs to see L2 and R2 to run your scripts.' :
      'Hold <b>L2</b> to aim, then press <b>R2</b> to fire. The controller must stay plugged into the dongle so it can see your triggers.';
    renderSlotsSelection();
  }

  function loadSlots() {
    var i = 0;
    function next() {
      if (i >= S.SLOTS || !B.isConnected()) {
        app.slotsLoaded = i >= S.SLOTS;
        return;
      }
      var slot = i;
      return B.scriptGet(slot).then(function (b) {
        app.slots[slot] = { raw: b, s: S.decode(b) };
        renderSlots();
        i++;
        return next();
      }, function (e) { fail(e); });
    }
    next();
  }

  function renderSlots() {
    var box = $('s-slots'), html = '', i, sl, sel = app.link ? app.link.slot : -1;
    for (i = 0; i < S.SLOTS; i++) {
      sl = app.slots[i];
      html += '<div class="slot' + (i === sel ? ' sel' : '') + '" role="listitem" data-slot="' + i + '">' +
        '<button class="main" data-edit="' + i + '" aria-label="Edit ' + esc(S.displayName(app.names, i)) + '">' +
          '<span class="n">' + esc(S.displayName(app.names, i)) + '</span>' +
          '<span class="s' + (sl && !sl.s ? ' empty' : '') + '">' +
            (sl ? esc(S.summary(sl.s)) : 'Loading…') + '</span></button>' +
        (i === sel ? '<span class="use inuse">In use</span>' :
          '<button class="use" data-use="' + i + '" aria-label="Use ' + esc(S.displayName(app.names, i)) + '">Use</button>') +
        '</div>';
    }
    box.innerHTML = html;
  }
  function renderSlotsSelection() {
    var sel = app.link ? app.link.slot : -1;
    var cur = $('s-slots').querySelector('.slot.sel');
    if (cur && +cur.getAttribute('data-slot') === sel) { return; }
    renderSlots();
  }

  function selectSlot(slot) {
    var sl = app.slots[slot];
    var p = Promise.resolve();
    if (sl && !sl.s) {
      /* an empty slot can't run: give it the default script first */
      var s = S.defaults();
      p = B.scriptSet(slot, S.encode(s)).then(function () { app.slots[slot] = { raw: S.encode(s), s: s }; });
    }
    return p.then(function () { return B.scriptSelect(slot); }).then(function () {
      if (app.link) { app.link.slot = slot; }
      renderSlots();
      toast(S.displayName(app.names, slot) + ' is now in use');
    }, fail);
  }

  /* ── pair stick flex (op 0x25) ──────────────────────────────────────── */
  var PAIR_ART =
    '<svg width="220" height="92" viewBox="0 0 220 92" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<g stroke="#6f9bff" stroke-width="3"><rect x="8" y="34" width="62" height="28" rx="5"/><path d="M8 44H0v8h8"/>' +
    '<rect x="20" y="41" width="16" height="14" rx="2"/></g>' +
    '<g stroke="#fbbf24" stroke-width="3"><path d="M84 40c6-6 6-14 0-20M92 46c11-11 11-27 0-38" transform="translate(0 18)"/></g>' +
    '<g stroke="#eef1f6" stroke-width="3"><path d="M128 30h58c12 0 19 10 20 23 1 12-3 21-10 21-6 0-9-5-13-11-2-4-4-6-9-6h-35c-5 0-7 2-9 6-4 6-7 11-13 11-7 0-11-9-10-21 1-13 9-23 21-23Z"/>' +
    '<path d="M136 46v8M132 50h8M178 46h.1M186 52h.1"/></g></svg>';

  function pairStart() {
    sheet({
      art: PAIR_ART,
      title: 'Pair your stick flex',
      body: '<ol class="steps" style="margin-top:0">' +
        '<li><span>Turn your controller <b>on</b>.</span></li>' +
        '<li><span>Hold it <b>right next to the dongle</b>. Touching is fine.</span></li>' +
        '<li><span>Tap <b>Start pairing</b> and keep holding until it says <b>Paired</b>.</span></li></ol>' +
