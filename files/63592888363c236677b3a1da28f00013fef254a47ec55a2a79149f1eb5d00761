/* shell/06-core-configs.js — configs on the adapter: read, list, save.
 *
 * One config's editable document (a Core's SOURCE sidecar, read back in
 * pieces through zs-profile-copy.js, D124), what this Core holds (its caps,
 * D133), the list a page at a time (D135), loadLive() and refreshStatus()
 * (GET /status), saving to a Core as bytes (ZSPROFILE.encode -> PUT
 * /profiles/<id>/zsp, in pieces with resends, D133/D138), putProfile /
 * putProfileDebounced, the save chips and the last refusal (D127).
 *
 * PART OF THE APP SHELL: phone.html's one inline script until 2026-10-02,
 * now these consecutive files, loaded where it was. They are CLASSIC
 * scripts, as it was: every top-level function and var is a global the
 * other files (and devbar.js, sections/, smart-actions/) call by name, and
 * nothing here may use, while loading, a name a LATER shell file declares
 * (calls made after the page has loaded are fine). phone.html lists them.
 */
  /* GET one config's editable document, whichever of the two shapes the
     adapter answers in.

     An EXO keeps its configs as JSON and hands back {ok:true, data:{...}}.
     A Core keeps the binary (D103) with the original document beside it as a
     GZIPPED sidecar, and hands that back as {ok:true, encoding:'gzip', b64},
     because it has no room for a decompressor and does not need one: the
     browser has DecompressionStream built in and zs-frame.js already wraps it.

     This is what makes a reinstalled app able to edit a config that only
     exists on the adapter, which is the whole reason D103 kept the sidecar.
     Both shapes come out of here as {ok:true, data:<document>}, so nothing
     downstream branches. */
  /* ── a Core's config, read back in numbered pieces (D124) ────────────
     A Core used to hand a config's editable copy back in ONE reply of at
     most 8 KB, and a Warzone config outgrew it at its third taught weapon
     (D122 section 7): the app then dropped the config from its list while
     it went on playing. A Core that SAYS so (the list's `read`, /status's
     profileFormat.sourceRead) now hands back the stored blob in pieces, and
     zs-profile-copy.js puts them together, checks them against the blob's
     CRC-32, and makes the document editable again, taught pictures and all.

     Both places it can say so are remembered, because at start-up the list
     and /status are asked at once and either may land first. An EXO says
     neither and never reaches this path. */
  var CORE_READ = { list: '' };
  function coreReadsPieces(){
    var pf = LIVE.status && LIVE.status.profileFormat;
    return CORE_READ.list === 'zsp-chunks' ||
           !!(pf && pf.sourceRead === 'zsp-chunks');
  }
  /* ── what THIS Core holds (D133) ─────────────────────────────────────
     The caps every encode, check and size line uses, read from the
     connected Core's own /status (profileFormat.caps) and never typed here:
     a D133 Core says its ceilings, an older one says 32 Smart Actions, 256
     steps and 16 KB and holds the 16 pictures it never said, and
     ZSPROFILE.capsFrom knows which is which. So an older Core is still
     warned and refused at its own numbers, and a newer one never meets a
     count at all. */
  function coreCaps(){
    var pf = LIVE.status && LIVE.status.profileFormat;
    return window.ZSPROFILE ? ZSPROFILE.capsFrom(pf && pf.caps) : null;
  }
  /* The largest piece of a config one PUT may carry, in raw bytes, when the
     Core says it takes a config in pieces (profileFormat.writeChunk, D133);
     0 when it takes one message only, as every Core before D133 did. */
  /* D668: a Core that can hold a config's live preview in RAM, without
     writing it to flash, says so in /status profileFormat.preview. No
     firmware says so yet: every preview is then an ordinary stored write,
     and the app puts the saved copy back when the player leaves without
     Save (discardUnsaved). */
  function corePreviewInRam(){
    var pf = LIVE.status && LIVE.status.profileFormat;
    return !!(pf && pf.preview === true);
  }
  /* 2026-11-12 ("the save button takes so long to work sometimes"): a Core
     that takes a config's CHANGED BYTES on their own says so in /status
     profileFormat.patch (zs_api profiles_write.c profile_patch). */
  function corePatch(){
    var pf = LIVE.status && LIVE.status.profileFormat;
    return !!(pf && pf.patch === true);
  }
  /* The link this app reaches the Core over: 'usb' (the cable, zs-serial)
     or 'ble'. */
  function coreTransport(){
    var st = LIVE.status;
    return (st && st.transport === 'usb') ? 'usb' : 'ble';
  }
  /* How long one write may go unanswered. Over the cable a piece is on the
     wire in ~0.2 s and stored in well under a second, and the link loses
     about one line in several hundred (D138): with api()'s 8 s that one
     lost line was an 8 s stall inside a Save. A re-sent piece or patch is
     answered as the first one was, so asking again sooner is safe.
     Bluetooth keeps the 8 s: a whole piece takes ~2 s there. */
  function writeWaitMs(reqBytes, storeBytes){
    if(coreTransport() !== 'usb') return 0;
    return Math.min(8000, 2500 + Math.ceil(reqBytes / 12) + Math.ceil((storeBytes || 0) / 50));
  }
  function coreWriteChunk(){
    var pf = LIVE.status && LIVE.status.profileFormat;
    var n = pf && pf.writeChunk;
    return (typeof n === 'number' && isFinite(n) && n >= 1) ? Math.floor(n) : 0;
  }
  /* The last copy of each config this app read or saved, keyed by the
     stored blob's CRC-32. putProfile reads before it writes (see there), and
     on a Core that read is now a header plus its 4 KB pieces (four at most
     while a config was 16 KB; up to 64 for a D133 config of 256 KB); when the
     header's CRC is the one this app last saw, the document it already
     holds IS that blob's, and the pieces are not fetched again. */
  var COPY_CACHE = {};
  /* ...and the stored bytes themselves (2026-11-12), so the next save can
     send only the ranges it changes (savePatch). Only for a config small
     enough to be patched. */
  var PATCH_MAX_BLOB = 65535;     /* under ZS_STORE_STREAM_MIN: stored whole */
  function keepBlob(b){
    return (b && b.length && b.length <= PATCH_MAX_BLOB) ? new Uint8Array(b) : null;
  }
  /* cloneDoc is declared once, below (the null-safe one; a second copy
     here was dead, 2026-10-31) */
  function getCoreCopy(pid){
    var head = '/profiles/'+encodeURIComponent(pid)+'/zsp';
    /* The header gets the same second ask as every piece (2026-10-02): it
       was the one read of the config without it, so ONE lost line while the
       list loaded listed a healthy config as unreadable for the session.
       Not while the link is down: a board that is away fails every call. */
    function header(tries){
      tries = tries || 0;
      return api(head).then(function(h){
        return (ZSCOPY.silent && ZSCOPY.silent(h) && tries < 2 && LIVE.online !== false)
          ? header(tries + 1) : h;
      });
    }
    return header().then(function(h){
      if(!h || !h.ok || !h.data){
        return {ok:false, error:(h && h.error) || ZSCOPY.SAY.unreadable};
      }
      var crc = String(h.data.crc32 || '').toLowerCase();
      var had = COPY_CACHE[pid];
      if(had && had.crc === crc) return {ok:true, data:cloneDoc(had.doc)};
      return ZSCOPY.read(function(path){ return api(path); }, h.data, header).then(function(r){
        if(r.ok) COPY_CACHE[pid] = {crc:r.crc, doc:cloneDoc(r.data), blob:keepBlob(r.blob)};
        return r;
      });
    });
  }
  function getProfileDoc(pid){
    if(window.ZSCOPY && coreReadsPieces()) return getCoreCopy(pid);
    return api('/profiles/'+encodeURIComponent(pid)).then(function(f){
      if(!f || !f.ok) return f;
      if(f.encoding !== 'gzip') return f;          /* an EXO, or a plain sidecar */
      if(!window.ZSFRAME || !f.b64){
        return {ok:false, error:'This config is compressed and this app cannot read it.'};
      }
      var bin;
      try{ bin = atob(f.b64); }
      catch(e){ return {ok:false, error:'The adapter\'s copy of this config was garbled in transit.'}; }
      var raw = new Uint8Array(bin.length);
      for(var i=0;i<bin.length;i++) raw[i] = bin.charCodeAt(i);
      return window.ZSFRAME.gunzip(raw).then(function(out){
        /* TextDecoder, not fromCharCode: a config name can hold anything a
           person typed, and reading UTF-8 a byte at a time turns an accent
           into two wrong characters that then get SAVED back that way. */
        var doc = JSON.parse(new TextDecoder().decode(out));
        /* A copy that only REFERS to its taught pictures (D124) came from a
           Core that could hand back the blob they live in. This one cannot
           (it answered in one reply), so the pictures are not recoverable
           here and the copy is not opened half-read. */
        if(window.ZSCOPY && ZSCOPY.hasRefs(doc)) return {ok:false, error:ZSCOPY.SAY.firmware};
        return {ok:true, data:doc};
      }).catch(function(){
        /* The bytes are there but would not come apart. Say so plainly: the
           config itself is still running on the adapter, it is only its
           editable copy that is unreadable. */
        return {ok:false, error:'This config is on the adapter but its editable copy could not be opened.'};
      });
    });
  }

  /* A CONFIG WHOSE COPY CANNOT BE READ IS STILL A CONFIG (D124). It is on
     the adapter, it plays, and the list row says what it is called and what
     it is for. It used to vanish from this list instead, so the owner's
     Warzone config disappeared exactly while he was teaching it guns. Now it
     is listed from the row, with the one sentence that says what is wrong
     (`unreadable`), and never with a document in LIVE.full: nothing may edit
     a config through a copy that was not read whole. The editor offers what
     can still be done with it (renderEdMenu). When the blob itself came back
     and only its copy would not open, IDENT still names its game, so a new
     copy can start from the right game pack. */
  function uiUnreadable(row, f, i){
    var gi = (f && f.ident) || {};
    return { id: row.id, name: row.name || gi.name || row.id,
      platform: row.console || gi.console || 'ps5',
      input: row.inputType || gi.inputType || 'mnk',
      game: gi.game || '', pack: '',
      color: STORE.vals['pcolor|'+row.id] || PALETTE[i%PALETTE.length],
      unreadable: String((f && f.error) || (window.ZSCOPY ? ZSCOPY.SAY.unreadable
        : 'This config’s editable copy could not be read, so its settings cannot be opened here.')) };
  }
  /* THE WHOLE LIST, A PAGE AT A TIME (D135). A Core with no count on its
     configs lists as many as fit one 8 KB reply (about twenty-five) and says
     where the next page starts (`next`, and `total` for the whole list);
     every other device answers in one reply with neither, and this is one
     request for it as before. The pages are put back together into the one
     reply shape loadLive has always read. A page that fails after the first
     fails the list, rather than showing a Core with some configs missing. */
  function listAll(){
    var rows = [], read = '';
    function page(from){
      return api(from ? '/profiles?from=' + from : '/profiles').then(function(j){
        if(!j || !j.ok || !Array.isArray(j.data)) return from ? {ok:false} : j;
        if(j.read) read = j.read;
        rows = rows.concat(j.data);
        if(typeof j.next === 'number' && j.next > from && j.next <= (j.total || Infinity) &&
           rows.length < 100000) return page(j.next);
        return {ok:true, data:rows, read:read};
      });
    }
    return page(0);
  }
  function loadLive(){
    return listAll().then(function(j){
      if(!j.ok || !Array.isArray(j.data)) return false;
      var list=j.data;
      CORE_READ.list = (j.read === 'zsp-chunks') ? 'zsp-chunks' : '';
      /* D133: each row of a Core's list carries its stored blob's size, which
         is what the Configs list and the Overview say the config takes; D135
         adds what it occupies in the pool, sectors and all (storedBytes),
         which is the number the rows add up to the Core's total with */
      /* 2026-11-04: which configs the board has, so a missing document can
         be told apart from a config the board never had (ZS.noDocWhy) */
      LIVE.boardIds = {};
      list.forEach(function(row){ if(row && row.id) LIVE.boardIds[row.id] = 1; });
      LIVE.rowBytes = {};
      LIVE.rowStored = {};
      list.forEach(function(row){
        if(row && typeof row.bytes === 'number' && row.bytes > 0) LIVE.rowBytes[row.id] = row.bytes;
        if(row && typeof row.storedBytes === 'number' && row.storedBytes > 0)
          LIVE.rowStored[row.id] = row.storedBytes;
      });
      return Promise.all(list.map(function(s){
        /* one config's failure must never take the others down with it */
        return Promise.resolve(getProfileDoc(s.id)).then(null, function(e){
          return {ok:false, error:String(e && e.message || e)};
        });
      }))
        .then(function(fulls){
          var ui=[]; var act=null;
          fulls.forEach(function(f,i){
            if(f && f.ok && f.data){ LIVE.full[f.data.id]=adoptBoard(f.data.id, f.data); ui.push(uiProfile(LIVE.full[f.data.id], i)); }
            else if(list[i] && list[i].id){
              delete LIVE.full[list[i].id];
              ui.push(uiUnreadable(list[i], f, i));
            }
            if(list[i] && list[i].active) act=list[i].id;
          });
          if(!ui.length) return false;
          /* THE PLAYER'S ORDER SURVIVES A RELOAD (audit 2026-10-10, M51 and
             M28, two fixes merged). First the order this app last kept
             (PROFILES, read from the store at start), configs it has not seen
             after in the board's order; then the Configs screen's Reorder
             (stored as ids) on top, so an explicit reorder always wins. */
          var was = PROFILES.map(function(p){ return p && p.id; });
          var at = function(p){ var k = was.indexOf(p.id); return k < 0 ? was.length : k; };
          ui = ui.map(function(p, k){ return {p:p, k:k}; }).sort(function(a, b){
            return (at(a.p) - at(b.p)) || (a.k - b.k);
          }).map(function(x){ return x.p; });
          ui = inPlayerOrder(ui);
          /* board is the source of truth for the config list */
          PROFILES.length=0; ui.forEach(function(p){ PROFILES.push(p); });
          activeId = (act && PROFILES.some(function(p){return p.id===act;})) ? act : PROFILES[0].id;
          /* THE DRAWER CHANGES WITH THE LIST (D120). A new list is a boot or
             a reconnect, and a reconnect may be a different adapter, so the
             photos are re-read for whoever /status says this is (the list
             and /status are asked together at boot, and /status leads every
             reconnect). The key is stored beside this list, so the list
             shown offline and the drawer belong together. */
          usePhotoDevice(photoDevKey());
          STORE.photoDev = PHOTO.dev;
          persist();
          seedTurnAssistAll();
          seedTurnAssistForDevices();
          migrateTranslatorsAll();
          return true;
        });
    });
  }
  /* D280/D291: Turn assist on every mouse config the player already has,
     once (ZS_SMART.seedTurnAssist says the rules: only with a mouse, always
     on keyboard X with X's old job moved off it, never twice). Only the
     configs it changes are written, one after another, each through
     putProfile like any edit. */
  /* WHICH CONFIGS THIS APP HAS ALREADY OFFERED TURN ASSIST TO (2026-10-14,
     found by EXO Studio chasing the owner's "My EXO is laggy"). The
     config's own `turnAssistOffered` mark never reaches the Core: the zsp
     encoder has no field for it, so every config read back from the Core
     lacks it and the boot pass below planned the seed AGAIN on every app
     open: up to one PUT per config (ten with the owner's eight), each one
     bumping configRev and pushing a reload to every other link, and a Turn
     assist the player had deleted came back. So this app remembers, on
     this device, per Core and per config, that it has looked; a config is
     offered at most once here, and never written again after. */
  var TA_SEEN_KEY = 'zs-ta-seen';
  function taSeenKey(pid){
    var dev = (LIVE.status && LIVE.status.deviceId) || 'core';
    return dev + '/' + pid;
  }
  function taSeenMap(){
    try{ var m = JSON.parse(localStorage.getItem(TA_SEEN_KEY) || '{}'); return (m && typeof m === 'object') ? m : {}; }
    catch(e){ return {}; }
  }
  function taSeen(pid){ return !!taSeenMap()[taSeenKey(pid)]; }
  function taMarkSeen(pid){
    var m = taSeenMap();
    m[taSeenKey(pid)] = 1;
    try{ localStorage.setItem(TA_SEEN_KEY, JSON.stringify(m)); }catch(e){}
  }
  function seedTurnAssistAll(){
    var SM = window.ZS_SMART;
    if(!SM || typeof SM.turnAssistWrites !== 'function' || LIVE.online === false) return;
    var chain = Promise.resolve();
    PROFILES.forEach(function(p){
      var doc = p && LIVE.full[p.id];
      if(!doc || taSeen(p.id)) return;
      /* only a config that gets the Script: a mark alone is not worth a
         write (it is set with the next save of that config anyway) */
      var plan = SM.turnAssistPlan(doc, false);
      taMarkSeen(p.id);              /* looked at: never again on this device */
      if(!SM.turnAssistWrites(plan)) return;
      chain = chain.then(function(){
        return putProfile(p.id, function(f){ SM.seedTurnAssist(p, f); });
      }).then(null, function(){});
    });
  }
  /* THE D394 TRANSLATOR MIGRATION (owner, 2026-10-15: "the translators you
     were given are supposed to be used on ALL those configs as the new
     calibration profile, since they're already made"). Every config whose
     game has an imported translator moves onto it ONCE, for its console:
     ZSAIMMODEL.migrationPlan says what and why (and when the player's own
     choice stands). Only the configs it changes are written, one after
     another, each through putProfile like any edit (D333: each write is one
     configRev bump and one push). Once: the config's own mark
     (translatorMigrated) AND this device's list per Core (zs-xt-seen, the
     zs-ta-seen lesson), and a config already on its translator is never
     written. A failed write is not marked here, so the next open tries it
     again (nothing reached the Core, so nothing was pushed). */
  var XT_SEEN_KEY = 'zs-xt-seen';
  function xtSeenMap(){
    try{ var m = JSON.parse(localStorage.getItem(XT_SEEN_KEY) || '{}'); return (m && typeof m === 'object') ? m : {}; }
    catch(e){ return {}; }
  }
  function xtKey(pid){ return taSeenKey(pid) + '@' + ((window.ZSAIMMODEL && (ZSAIMMODEL.MIGRATION_SEEN || ZSAIMMODEL.MIGRATION)) || ''); }
  function xtSeen(pid){ return !!xtSeenMap()[xtKey(pid)]; }
  function xtMarkSeen(pid){
    var m = xtSeenMap();
    m[xtKey(pid)] = 1;
    try{ localStorage.setItem(XT_SEEN_KEY, JSON.stringify(m)); }catch(e){}
  }
  var xtRunning = false;
  function migrateTranslatorsAll(){
    var A = window.ZSAIMMODEL, P = window.ZSPACKS;
    if(!A || typeof A.migrationPlan !== 'function' || !P || LIVE.online === false || xtRunning) return;
    if(window.ZS_NO_TRANSLATOR_MIGRATION) return;      /* the test harness, unless a suite asks */
    if(P.state() !== 'ready'){
      if(P.state() !== 'failed') P.load().then(function(){ if(P.state() === 'ready') migrateTranslatorsAll(); });
      return;
    }
    var ids = P.list().map(function(pk){ return pk.id; });
    var chain = Promise.resolve(), any = false;
    xtRunning = true;
    PROFILES.forEach(function(p){
      var doc = p && LIVE.full[p.id];
      if(!doc || xtSeen(p.id)) return;
      var pk = P.ofConfig(doc) || P.ofConfig(p);
      var plan = pk ? A.migrationPlan(pk, doc, {packIds: ids}) : {act:'none'};
      if(plan.act !== 'apply'){ xtMarkSeen(p.id); return; }
      any = true;
      chain = chain.then(function(){
        return putProfile(p.id, function(f){
          /* the save moves a legacy-speed config onto cm/360 (D392); done
             first, so the translator is resolved against the cm/360 it
             will run with (its use_cm) */
          if(window.ZSPROFILE && ZSPROFILE.speedMigrate && productId() === 'core') ZSPROFILE.speedMigrate(f);
          /* planned again on the copy just read: the Core's newest */
          var again = A.migrationPlan(pk, f, {packIds: ids});
          A.migrationApply(f, again.act === 'apply' ? again : null);
        });
      }).then(function(j){ if(j && j.ok) xtMarkSeen(p.id); }, function(){});
    });
    chain.then(function(){
      xtRunning = false;
      if(any && window.ZS && typeof ZS.redrawOpenScreen === 'function') ZS.redrawOpenScreen();
    });
  }
  /* D288 (owner, 2026-10-13: "put Turn assist in Mappings if a keyboard
     and/or mouse is detected, and just bind it automatically to the X key
     on a keyboard"): the input type is not the only way in. When the
     Core's device list shows a keyboard or a mouse (a pretend one too,
     ZS.simMnk), the ACTIVE config gets Turn assist, by seedTurnAssist's own
     rules (on X, whatever X did moved off it, D291; one copy; once per config, the
     turnAssistOffered mark), whatever its input type. Asked when the device
     list changes, when the config list arrives, and when another config
     becomes the active one. A config is tried at most once a session here,
     so a refused write never turns into a save on every poll. */
  var taDevTried = {};
  function seedTurnAssistForDevices(){
    var SM = window.ZS_SMART;
    if(!SM || typeof SM.turnAssistWrites !== 'function' || LIVE.online === false) return;
    if(typeof productId !== 'function' || productId() !== 'core') return;
    var dc = (window.ZS && typeof ZS.deviceClasses === 'function') ? ZS.deviceClasses() : null;
    if(!dc || !(dc.keyboard || dc.mouse)) return;
    var pid = activeId, p = prof(pid), doc = p && LIVE.full[pid];
    if(!doc || taDevTried[pid] || taSeen('dev:' + pid)) return;
    /* a config with a mouse is the boot pass's and setInputType's to seed
       (seedTurnAssistAll); this one adds only what they leave out */
    var own = SM.turnAssistPlan(doc, false);
    if(SM.turnAssistWrites(own)) return;
    var plan = SM.turnAssistPlan(doc, false, {device:true});
    if(!SM.turnAssistWrites(plan)) return;
    taDevTried[pid] = true;
    taMarkSeen('dev:' + pid);
    putProfile(pid, function(f){ SM.seedTurnAssist(p, f, {device:true}); }).then(function(){
      if(window.ZS && typeof ZS.redrawOpenScreen === 'function') ZS.redrawOpenScreen();
    }, function(){});
  }
  /* devbar.js loads after the shell, so the hook is taken when it exists */
  (function hookTaDevices(){
    if(window.ZS && typeof ZS.onDevicesChange === 'function'){
      ZS.onDevicesChange(seedTurnAssistForDevices);
      seedTurnAssistForDevices();
      return;
    }
    setTimeout(hookTaDevices, 300);
  })();
  /* M28: the list in the order the player set (STORE.vals.configOrder, a
     list of ids written by the Configs screen's Reorder). The sort is
     stable: ids the order does not name stay in the board's order, after. */
  function inPlayerOrder(ui){
    var ord = STORE.vals && STORE.vals.configOrder;
    if(!Array.isArray(ord) || !ord.length) return ui;
    var at = {};
    ord.forEach(function(id, i){ if(typeof id === 'string' && !(id in at)) at[id] = i; });
    return ui.map(function(p, i){ return { p:p, i:i }; }).sort(function(a, b){
      var x = (a.p.id in at) ? at[a.p.id] : ord.length + a.i;
      var y = (b.p.id in at) ? at[b.p.id] : ord.length + b.i;
      return x - y;
    }).map(function(e){ return e.p; });
  }
  function refreshStatus(){
    var was = productId();
    return api('/status').then(function(j){
      if(j.ok){
        LIVE.status=j.data; noteSeen(); productApply(); photoDevFromStatus(); noteConfigRev(j.data);
        if(productId() !== was) productChanged();
      }
      return j;
    });
  }
  /* THE PRODUCT IS KNOWN ONLY WHEN /status SAYS (owner, 2026-10-14: screens
     drawn while Bluetooth was still connecting showed the old A7S layout
     until he left and came back). productId() guesses until the first
     /status lands; ef831907 made the guess the Core, but a guess can still be
     wrong, and productApply() only retitles the window. So when /status
     changes the answer, everything drawn on the old answer is drawn once
     more: the editor menu if it is open, the open room (redrawOpenScreen
     waits while a text box has focus), and HOME. */
  function productChanged(){
    try{
      if(document.getElementById('editor').classList.contains('open') &&
         typeof editId !== 'undefined' && editId && prof(editId)) renderEdMenu(prof(editId));
    }catch(e){}
    try{ redrawOpenScreen(); }catch(e){}
    try{ renderHomeIfVisible(); }catch(e){}
  }

  /* ══ D335: A CHANGE MADE ELSEWHERE SHOWS HERE (Studio's A-2) ══════════
