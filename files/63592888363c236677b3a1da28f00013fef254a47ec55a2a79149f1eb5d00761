      el.addEventListener('pointerleave', function(){ el.classList.remove('zs-pressing'); });
      el.addEventListener('click', fireClick);
    });
    paintSaveChips();
  }

  function putProfileDebounced(pid, mutate){
    if(manualSave()) return stageProfile(pid, mutate);    /* D257 */
    return putProfileAuto(pid, mutate);
  }
  /* putWaiters: audit M14 (app-scripts). putProfileAuto RETURNS a promise of
     the answer to the write its change went out in, so a caller (the Scripts
     sync) can tell a write that landed from one the link lost; it used to
     return nothing, and the sync cleared its "still owed" mark inside the
     mutator, before any answer. Never rejects. */
  var putWaiters={};
  function settleWaiters(list, j){ (list || []).forEach(function(r){ try{ r(j); }catch(e){} }); }
  function putProfileAuto(pid, mutate){
    (putPending[pid] || (putPending[pid]=[])).push(mutate);
    var done = new Promise(function(r){ (putWaiters[pid] || (putWaiters[pid]=[])).push(r); });
    if(putTimers[pid]) clearTimeout(putTimers[pid]);
    putTimers[pid]=setTimeout(function(){
      delete putTimers[pid];
      var queued = putPending[pid] || [];
      var waiting = putWaiters[pid]; delete putWaiters[pid];
      delete putPending[pid];
      putProfile(pid, function(f){ queued.forEach(function(m){ m(f); }); })
        .then(function(j){ paintSaveChips(); settleWaiters(waiting, j); },
              function(){ paintSaveChips(); settleWaiters(waiting, {ok:false, error:'could not save'}); });
    }, 600);
    /* AFTER the timer is assigned, never before: saveChipDirty() reads
       putTimers[pid], so painting a line earlier asked "is a write queued?"
       of the tick before the queue existed and got "no" on the first edit -
       the one moment this control exists for. */
    paintSaveChips();
    return done;
  }
  /* Let a screen force its queued write out early — before navigating, and
     before asking the BOARD to write this same config (applying a calibration
     pack). Returns a promise that settles once the queued write has landed, so
     a caller can order a board-side write strictly after the app's own.
     With nothing queued it still waits for a write already IN FLIGHT (the
     600 ms timer fired, the read-before-write or the PUT not answered yet):
     resolving at once let the calibration-pack apply land first and the
     in-flight PUT, built from the pre-apply document, put the old one back.
     It never rejects; it resolves with the save's answer ({ok:false,...} on
     a refusal, undefined when there was nothing to save). */
  function flushProfileWrites(pid){
    paintSaveChips();
    var inFlight = function(){ return (putChain[pid] || Promise.resolve()).then(function(){}); };
    if(!putTimers[pid]) return inFlight();
    clearTimeout(putTimers[pid]); delete putTimers[pid];
    var queued = putPending[pid] || []; delete putPending[pid];
    var waiting = putWaiters[pid]; delete putWaiters[pid];   /* M14 */
    if(!queued.length){ settleWaiters(waiting, undefined); return inFlight(); }
    return putProfile(pid, function(f){ queued.forEach(function(m){ m(f); }); })
      .then(function(j){ settleWaiters(waiting, j); return j; },
            function(){ var e = {ok:false, error:'could not save'}; settleWaiters(waiting, e); return e; });
  }

