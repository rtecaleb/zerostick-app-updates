/* zs-dongle-exo.css - the dongle pages in the EXO app's dark look (owner
 * 2026-10-23: "like the EXO in terms of its colour theme ... the same glow").
 * Loaded LAST on dongle.html and calibrator.html, after zs-dongle-theme.css.
 *
 * EXO dark, as its screens show it: a near-black ground, cards that are a
 * soft top-lit gradient with a cool slate edge, grey-white text, and the
 * primary action lit from inside with a blue glow. Copied by eye from the
 * EXO app, NOT linked to its stylesheets (the dongle folder shares no file
 * with the EXO app - tools/test-dongle-isolation.js).
 *
 * One theme only: dark (owner 2026-10-23, "don't make a light theme").
 */
:root{
  --zs-page:#07090d;
  --zs-card:#1b2130;
  --zs-raised:#242b3b;
  --zs-control:#121722;
  --line:#33405a;
  --line-soft:#262f42;
  --fg:#e9edf4;
  --muted:#a9b3c2;
  --faint:#929cab;
  --x-card:linear-gradient(180deg,#232b3d 0%,#181d2a 100%);
  --x-card-shadow:0 10px 28px rgba(0,0,0,.45);
  --x-btn:linear-gradient(180deg,#8fbeff 0%,#4f8ff0 100%);
  --x-btn-ink:#06172e;
  --x-btn-glow:inset 0 1px 0 rgba(255,255,255,.35), 0 0 0 1px rgba(143,190,255,.6), 0 8px 26px rgba(88,166,255,.42);
  --x-icon-glow:0 0 22px rgba(88,166,255,.42), inset 0 0 0 1px rgba(120,180,255,.5);
  --x-icon-bg:radial-gradient(circle at 50% 35%,#2b4d85 0%,#152238 72%);
  --x-edge-glow:0 0 12px rgba(88,166,255,.8);
}
body{background:var(--zs-page);}

/* ── the hub (dongle.html) ───────────────────────────────────────────── */
.card, .choice{background:var(--x-card); box-shadow:var(--x-card-shadow);}
.choice{border-radius:16px; position:relative; overflow:hidden;}
/* EXO's config rows: a lit accent edge down the left side */
.choice::before{content:""; position:absolute; left:0; top:0; bottom:0; width:4px;
  background:var(--ion); box-shadow:var(--x-edge-glow);}
.choice:active{box-shadow:var(--x-card-shadow), 0 0 0 1px var(--ion), 0 0 22px rgba(88,166,255,.25);}
.choice .ic, .devhead .glyph{background:var(--x-icon-bg); box-shadow:var(--x-icon-glow);}
.btn.primary{background:var(--x-btn); color:var(--x-btn-ink); border-color:transparent; box-shadow:var(--x-btn-glow);}
.btn.primary:disabled{background:var(--zs-control); color:var(--faint); border-color:var(--line); box-shadow:none;}

/* ── the calibrator (Bootstrap) ──────────────────────────────────────── */
.card{--bs-card-bg:transparent;}
.btn-primary{background:var(--x-btn) !important; color:var(--x-btn-ink) !important;
  border-color:transparent !important; box-shadow:var(--x-btn-glow);}
.btn-primary:disabled{background:var(--zs-control) !important; color:var(--faint) !important; box-shadow:none;}
.navbar.bg-body-tertiary{background:var(--zs-page) !important;}

/* the header logo: the owner's white ZEROSTICK artwork */
.zs-logo{height:48px; width:auto; max-width:100%;}

/* EXO's lit ground: not flat black - a soft blue glow from the top and a
   faint cyan one low on the other side, fixed behind the content */
body{
  background:
    radial-gradient(110% 55% at 50% 8%, rgba(88,166,255,.30) 0%, rgba(88,166,255,0) 70%),
    radial-gradient(90% 50% at 100% 100%, rgba(47,217,206,.20) 0%, rgba(47,217,206,0) 60%),
    radial-gradient(80% 45% at 0% 62%, rgba(88,120,255,.16) 0%, rgba(88,120,255,0) 60%),
    var(--zs-page);
  background-attachment:fixed;
}
.navbar.bg-body-tertiary{background:transparent !important;}
/* the sticky top bars: frosted, so the glow shows through */
#zsbar, #bar{background:rgba(7,9,13,.55) !important; -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px);}
