      if(liveOn){
        /* ONE WARNINGS BLOCK (screen-map §3.2): the drift warning + its fix
           button, the board's suppression sentences, and the stick/mouse
           warnings all merge here — BELOW the controls that answer them
           since the owner's reorder (2026-09-04), and still never folded:
           live feedback is rule 4's explicit exemption. */
        var wr = '';
        /* The reported "my aim drifts on its own" bug. The old Inner
           deadzone slider ran 0..40 with no floor, so one drag to zero let
           the pad's own resting offset through forever — and because the
           slider's minimum is 3 now, a config already at 0 would otherwise
           SHOW 3 while the board held 0. Say so, and offer the one tap. */
        var dz0 = (full || {}).deadZones || {};
        if(hasPad && feelOf('right')==='custom' &&
           dz0.rightInner!=null && dz0.rightInner < 0.03){
          /* "The slider below" was true when Inner deadzone sat on this
             screen. It is in the sheet now, so the sentence gives the route
             instead of pointing at nothing. The one-tap fix below still
             writes deadZones.rightInner = 0.08 either way. */
          /* D260: 0 is allowed again (the owner asked), so this is a
             warning chip, not a floor */
          wr += note('<b>Your aim may drift.</b> This config’s inner deadzone is '+
                    Math.round(dz0.rightInner*100)+'%. Most sticks rest a little off centre, '+
                    'so under about 3% a resting stick can reach the game as a slow push. '+
                    'If your aim moves on its own, raise Inner on the <b>Deadzones</b> card.','warn')+
               btn('Stop my aim drifting','primary','aim-fixdrift');
        }
        wr += suppressionNote();
        /* THE SAME LIST OVERVIEW USES, filtered to what belongs on an aim
           screen. This was a second, uncapped `st.warnings.forEach` that knew
           nothing about warnNotes() — five byte-identical cards, 617px of a
           685px viewport, before a single control. warnList() de-duplicates
           and rewrites once for the whole app, and the cap of three keeps a
           bad board from burying the aim settings it is complaining about. */
        if(isActive){
          var stW = warnList(ZS.live.status).filter(function(w){
            return /stick|mouse|dead ?zone|drift|aim help/i.test(w);
          });
          stW.slice(0,3).forEach(function(w){ wr += note('⚠ '+esc(w), 'warn'); });
          if(stW.length>3) wr += note('…and '+(stW.length-3)+' more — open Your board for the full list','warn');
        }
        /* The live aim pad is a PAD-mode instrument now: it draws two sticks,
           so a config that HAS a pad gets it — Joystick + Mouse included — and
           a mouse-only config does not, because there the two aim cards own
           the whole screen and there are no sticks to draw. */
        /* the live aim pad is OFF this screen (owner, 2026-09-05); the
           warning chips stay — live feedback is rule 4's explicit exemption,
           and a chip that is not needed draws nothing */
        h += wr;
      }
      /* D410 (owner, 2026-10-19: "In Controller Aim, at the bottom, a button
         you click - 'Calibration'"): the pad half's last thing, under both
         stance tabs, after the warnings. It opens the Calibration screen
         (pad-cal.js), which lends the pad on the Core to the calibration. */
      if(hasPad && window.ZSPADCAL) h += ZSPADCAL.buttonHTML();
      /* NO "Match Your Game" door here any more (owner, 2026-09-04: "remove
         start from a preset from the Aim tab — that's the whole point of
         when you make a profile, it asks you what game, and the presets are
         there"). R.game itself stays: the new-config flow is its home. */
       /* D238: the key back to the two halves */
       if (aimBoth && aimView) {
         /* D290: the Mouse & Keyboard half wears the owner's two pictures */
         h = '<button type="button" class="aimswitch" id="aim-switch">'+
           (aimView === 'pad' ? '' : '<i class="mkbhead" aria-hidden="true">'+'<img class="mkbpic" src="brand/devices/mouse-256.webp" alt="" aria-hidden="true">'+'<img class="mkbpic" src="brand/devices/keyboard-256.webp" alt="" aria-hidden="true">'+'</i>')+'Showing <b>'+
           (aimView === 'pad' ? 'Controller' : 'Mouse &amp; Keyboard')+'</b><span>Switch ›</span></button>'+h;
       }
       root.innerHTML = h; ZS.wire(root, ns);
       /* D243/D247: every Aim view wears the ZS8K Configurator's look - the
          controller page, and the mouse & keyboard one too (owner: "the same
          idea, colour theme and concept for the mouse and keyboard aim tabs
          and Mappings") */
       root.classList.add('zkaim');
       var asw = root.querySelector('#aim-switch');
       if (asw) asw.addEventListener('click', function(){ delete AIMV[p.id]; ZS.redrawOpenScreen(); });
      /* the doors this screen's copy names — each target keeps its own ns */
      wireDoors(root, p);
      /* D375: the read-only Mouse DPI line opens Device on its card */
      var dpiGo = root.querySelector('[data-aimdpi]');
      if (dpiGo) dpiGo.addEventListener('click', function(){
        if (ovSetTab) ovSetTab('Dpi');
        ZS.openDetail({ id:'overview', lab:'Device' }, p);
      });

      /* ── the stance tabs ──
         A tab tap flips which page is visible and nothing else: both pages
         are already rendered and wired, so there is no re-render to pay for
         and nothing the ~8s poll could ever replay. pagerPage survives the
         re-renders a preset tap DOES cause, exactly as it survived them when
         it was a scroll position. */
      var atabs = root.querySelector('#aimtabs');
      if(atabs){
        var tabBtns = atabs.querySelectorAll('button');
        var showStance = function(pg){
          pagerPage = pg;
          tabBtns.forEach(function(b){
            var on = (b.getAttribute('data-pg')==='1' ? 1 : 0) === pg;
            b.classList.toggle('on', on);
            b.setAttribute('aria-pressed', on?'true':'false');
          });
          /* [data-stance] — the pager's two panes and nothing else. The stick
             page is an .aimpage too, and the bare selector's
             `data-key==='ads' ? 1 : 0` would read its key as 0 and hide the
             whole stick card the moment a Joystick + Mouse player tapped ADS
             aim. Tabs hide stances, not pages. */
          root.querySelectorAll('.aimpage[data-stance]').forEach(function(sec){
            sec.classList.toggle('aimoff',
              (sec.getAttribute('data-key')==='ads' ? 1 : 0) !== pg);
          });
        };
        tabBtns.forEach(function(b){
          b.addEventListener('click', function(){
            showStance(b.getAttribute('data-pg')==='1' ? 1 : 0);
          });
        });
      }
      /* the ADS sensitivity switch. wire() has already given the .sw its
         flip (nosave, so no saveV); this listener is the write. It asks the
         board's copy what the switch WAS rather than reading the class after
         the flip, so it cannot depend on listener order. */
      /* the stick ADS page's inheritance line (the old switch): one tap
         flips adsGain between null and a seeded number through adsSet */
      root.querySelectorAll('[data-zkadssm]').forEach(function(b){
        b.addEventListener('click', function(){
          if(ZS.live.online===false || !ZS.live.full[p.id]){ ZS.toast('Your board is offline'); return; }
          var v = parseFloat(b.getAttribute('data-zkadssm')) || 0;
          feelWrite(function(f){ if(!f.smoothing) f.smoothing = {}; f.smoothing.rightStickAds = v; });
          render(root);
        });
      });
      var inh = root.querySelector('[data-xinherit="stick"]');
      if(inh) inh.addEventListener('click', function(){
        adsSet(adsGainOf()===null, root);
      });
      root.querySelectorAll('.smcar[data-mode]').forEach(function(car){
        var mode = car.getAttribute('data-mode')==='ads' ? 'ads' : 'hip';
        car.querySelectorAll('button').forEach(function(b){
          b.addEventListener('click', function(){
            var opts = smOptionsOf(mode);
            var i = opts.indexOf(smPresetOf(mode)) +
                    (parseFloat(b.getAttribute('data-d')||'1')<0 ? -1 : 1);
            if(i<0 || i>=opts.length) return;
            smApply(mode, opts[i], root);
          });
        });
      });
      /* D191: XIM's Custom mode button (Standard | Classic), mouse stances and
         the aim stick alike, and Classic's "adds about N ms" line, which
         follows the three steppers as they move. */
      root.querySelectorAll('.smstyle[data-smstylefor]').forEach(function(seg){
        var who = seg.getAttribute('data-smstylefor');
        seg.querySelectorAll('button[data-smstyle]').forEach(function(b){
          b.addEventListener('click', function(){
            /* the style the page was drawn on, not the .on class (the kit's
               seg2 wiring may already have moved it to this button) */
            var style = b.getAttribute('data-smstyle');
            if(style === seg.getAttribute('data-smcur')) return;
            if(who==='stick') smStickStyleSet(style, root);
            else smStyleSet(who==='ads' ? 'ads' : 'hip', style, root);
          });
        });
      });
      /* D392: "Use Sync to game": the stance's Synch (both stances', so
         nothing is left stacked) moves to mouseTranslation.syncHz, the one
         frame-sync control, unless that is already on */
      root.querySelectorAll('[data-synchmove]').forEach(function(b){
        b.addEventListener('click', function(){
          if(ZS.live.online===false || !ZS.live.full[p.id]){ ZS.toast('Your board is offline'); return; }
          var ms = parseFloat(b.getAttribute('data-synchmove')) || 0;
          smWrite(function(f){
            if(!f.mouseTranslation) f.mouseTranslation={};
            var mt = f.mouseTranslation;
            if(!(+mt.syncHz > 0)) mt.syncHz = ms <= 12 ? 120 : 60;
            if(typeof mt.classicSynch==='number') mt.classicSynch = 0;
            if(typeof mt.adsClassicSynch==='number') mt.adsClassicSynch = 0;
          });
          ZS.toast('Sync to game is on (Translation page)');
          render(root);
        });
      });
      root.querySelectorAll('.smcustom').forEach(function(box){
        var lag = box.querySelector('.smlag');
        if(!lag) return;
        box.addEventListener('zsstep', function(){
          var v = [].map.call(box.querySelectorAll('.stp .sv'), function(sv){ return parseFloat(sv.textContent||'0'); });
          /* D392: the mouse's Classic shows two steppers (no Synch); a Synch
             still stored counts until it is moved to Sync to game */
          var mv = box.querySelector('[data-synchmove]');
          var sy = v.length >= 3 ? v[2] : (mv ? parseFloat(mv.getAttribute('data-synchmove')) || 0 : 0);
          if(v.length >= 2) lag.textContent = 'Adds about '+(Math.round(classicLagMs(v[0], v[1], sy)*10)/10)+' ms of delay.';
        });
      });
      /* A SEPARATE loop from the pager's .smcar[data-mode] one above, not a
         branch inside it. That one hands `mode` to smOptionsOf / smPresetOf /
         smApply — the mouse trio's three functions, one of which has a
         "Same as hip" inherit branch a stick has no concept of. Keeping the
         two paths apart means nothing here can regress the shipped pager. */
      root.querySelectorAll('.smcar[data-smset="stick"]').forEach(function(car){
        car.querySelectorAll('button').forEach(function(b){
          b.addEventListener('click', function(){
            var opts = smStickOptions();
            var d = parseFloat(b.getAttribute('data-d')||'1')<0 ? -1 : 1;
            var i = opts.indexOf(smStickPreset()) + d;
            if(i<0 || i>=opts.length) return;
            smStickApply(opts[i], root, d);
          });
        });
      });
      /* ── the ••• folds ──
         A tap flips the fold's `hidden` and nothing else — the fold is
         already rendered and wired — and remembers itself in XMECH_OPEN so
         the re-render a preset tap causes opens it again. */
      root.querySelectorAll('[data-xmore]').forEach(function(bt){
        bt.addEventListener('click', function(){
          var key = bt.getAttribute('data-xmore');
          var fold = root.querySelector('.xmech[data-xmech="'+key+'"]');
          if(!fold) return;
          var open = fold.hasAttribute('hidden');
          if(open) fold.removeAttribute('hidden'); else fold.setAttribute('hidden', '');
          bt.setAttribute('aria-expanded', open ? 'true' : 'false');
          XMECH_OPEN[p.id+'|'+key] = open;
        });
      });
      /* D376: Advanced, for the whole screen at once (both stances' cards
         carry the button); the quantization buttons open their two */
      root.querySelectorAll('[data-xadv]').forEach(function(bt){
        bt.addEventListener('click', function(){
          var on = !aimAdvOn();
          aimAdvSet(on);
          /* the section is below everything, so nothing above it moves;
             the scroller's position is put back anyway, so turning it off
             at the bottom of a long page never jumps the view */
          var sc = bt, top = null;
          while(sc && sc.parentElement && !(sc.scrollHeight > sc.clientHeight + 4 &&
                /auto|scroll/.test((window.getComputedStyle ? getComputedStyle(sc).overflowY : '') || ''))) sc = sc.parentElement;
          var y0 = bt.getBoundingClientRect ? bt.getBoundingClientRect().top : 0;
          if(sc && sc !== bt) top = sc.scrollTop;
          root.querySelectorAll('.advonly').forEach(function(d){
            if(on) d.removeAttribute('hidden'); else d.setAttribute('hidden', '');
          });
          root.querySelectorAll('.xadvwhere').forEach(function(w){
            if(on) w.removeAttribute('hidden'); else w.setAttribute('hidden', '');
          });
          if(top !== null && bt.getBoundingClientRect){
            var dy = bt.getBoundingClientRect().top - y0;
            if(dy) sc.scrollTop = top + dy;
          }
          var inUse = advInUse();
          root.querySelectorAll('[data-xadv]').forEach(function(b){ b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
          root.querySelectorAll('.xadvhint').forEach(function(t){
            if(!on && inUse) t.removeAttribute('hidden'); else t.setAttribute('hidden', '');
          });
        });
      });
      root.querySelectorAll('[data-xquant]').forEach(function(bt){
        bt.addEventListener('click', function(){
          var st = bt.getAttribute('data-xquant');
          var box = root.querySelector('#xquant-'+st);
          if(!box) return;
          var open = box.hasAttribute('hidden');
          if(open) box.removeAttribute('hidden'); else box.setAttribute('hidden', '');
          bt.setAttribute('aria-expanded', open ? 'true' : 'false');
          XQUANT_OPEN[p.id+'|'+st] = open;
        });
      });
      wireMouseMech(root);
      wireSpeedCm(root);                 /* D376 amended: Speed's cm/360 small print */
      wireActivation(root);              /* D376 amended: Activation opens and closes */
      wireZeroWord(root);                /* D377: 0 says Standard / Same as hip */
      feelWire(root);                    /* D184 / D186: the stick mode */
      if(hasPad && window.ZSZK) ZSZK.wire(root, p, zkOpt(root));   /* D245 */
      if(hasPad && window.ZSPADCAL) ZSPADCAL.wire(root, p);         /* D410 */

      /* no live pad on this screen any more (owner, 2026-09-05: "nothing
         more AT ALL"); liveResponsePad() and aimPadHTML() stay in the file
         for a future home. */

      var fixd = root.querySelector('#aim-fixdrift');
      if(fixd) fixd.addEventListener('click', function(){
        if(!liveOn){ ZS.toast('Your board is offline'); return; }
        /* m13: staged like every setting (D257), and the toast and the
           redraw follow the answer: a refused write used to say it was set */
        ZS.editProfile(p.id, function(f){
          if(!f.deadZones) f.deadZones={};
          f.deadZones.rightInner = 0.08;
        }).then(function(j){
          if(j && j.ok === false){ ZS.toast('Not set: '+(j.error || 'the board would not take it')); return; }
          ZS.toast('Inner deadzone set to 8% — take your hands off and check the dot sits centre');
          /* the whole screen, not render(): boardFull was read when R.aim
             was called, so only a full re-open sees the value just written */
          ZS.redrawOpenScreen();
        });
      });

      /* THE .seg2 SWEEP IS GONE, all four branches of it. Two of them wired
         controls that moved into the stick's Mechanics sheet (the old
         Native|Tuned switch, merged into Stick mode by D186, and the curve
         preset) and are hand-wired there now, next to the
         markup they belong to. The other two were already ghosts of exactly
         the kind the comment that used to stand here forbade: the update-rate
         seg lives in another renderer with its own wiring, the game seg is
         not emitted by R.aim at all, and that branch's `gameSel = ...` was an
         assignment to a name declared nowhere in the file. Nothing this
         screen emits needs hand-wiring any more — the shared Feel seg and the
         sheet's Deadzone shape both carry data-binds and are ZS.wire's. */

    }

    return { html:'', after:function(root){
      /* D238: which half? */
      if (aimBoth && !aimView) {
        var padPic = (ZS.devicePicFor && ZS.userDevices)
          ? (ZS.userDevices(ZS.devices).filter(function(d){ return d.kind === 'gamepad'; }).map(ZS.devicePicFor)[0] || '') : '';
        root.classList.add('zkaim');     /* D247: the chooser too */
        root.innerHTML = '<div class="aimchoose" role="group" aria-label="which aim settings to tune">'+
          '<button type="button" class="aimch" data-aimview="pad">'+
            (padPic ? '<img src="'+esc(padPic)+'" alt="" aria-hidden="true">' : '')+
            '<b>Controller</b><span>stick aim</span></button>'+
          /* D290: the owner's own mouse and keyboard, side by side, as
             Mappings' chooser wears them */
          '<button type="button" class="aimch" data-aimview="kbm">'+
            '<span class="aimch2">'+
              '<img class="mkbpic" src="brand/devices/mouse-256.webp" alt="" aria-hidden="true">'+
              '<img class="mkbpic" src="brand/devices/keyboard-512.webp" alt="" aria-hidden="true">'+
            '</span>'+
            '<b>Mouse &amp; Keyboard</b><span>mouse aim</span></button></div>';
        root.querySelectorAll('[data-aimview]').forEach(function(b){
          b.addEventListener('click', function(){ AIMV[p.id] = b.dataset.aimview; ZS.redrawOpenScreen(); });
        });
        return;
      }
      render(root);
    } };
  };
});
