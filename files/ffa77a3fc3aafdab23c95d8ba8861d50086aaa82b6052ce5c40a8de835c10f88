/* sections/10-aim.js — the Aim page: the mouse translator's and the sticks' settings.
 *
 * R.aim: Hip / ADS stances with Speed (cm/360 = 500 / Speed), the response
 * curve, smoothing (Standard EMA / 1 euro, Classic D191 presets and steppers),
 * Fine aim, the Mechanics fold (Y scale, noise, Feel, invert, a read-only
 * Mouse DPI line that opens Device's card D375,
 * quantization D189; the XIM import door moved to Legacy Devices, D215),
 * the stick pages (sensitivity, rest zone, Native / EXO Linear / Custom
 * with the grid curve editor zs-curve-grid.js),
 * and the ADS binding. Every field is under mouseTranslation.*, stick.*, curves.*
 * or smoothing.* in the config (docs/CODE-GUIDE.md "Aim" traces each one to
 * the firmware).
 *
 * Since 2026-10-31 the page is three files: this one (R.aim: the mouse stance
 * pages and the draw), 10-aim-tables.js (the tables, the presets, labHelp) and
 * 10-aim-controller.js (the stick mode and the controller page, a factory
 * R.aim calls). A function keeps its name: grep for it.
 *
 * Screens (window.RENDERERS):  R.aim
 * Tests:                      test-aim-simple.js (D376), test-aim-help.js, test-aim-stance.js, test-smoothing.js, test-stick-modes.js, test-vertical-balance.js, test-aim-xim.js, test-xim-import.js, test-mouse-dpi.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('aim', function (SEC) {
  /* from the files before this one */
  var B = SEC.B, btn = SEC.btn, card = SEC.card, curveBox = SEC.curveBox,
      curvePath = SEC.curvePath, door = SEC.door, esc = SEC.esc, helpHTML = SEC.helpHTML,
      liveOutput = SEC.liveOutput, note = SEC.note, pic = SEC.pic, R = SEC.R,
      screenLive = SEC.screenLive, seg = SEC.seg, sh = SEC.sh, srcNameOf = SEC.srcNameOf,
      stepper = SEC.stepper, slider = SEC.slider, toggleFld = SEC.toggleFld, warnHTML = SEC.warnHTML,
      warnList = SEC.warnList, wireDoors = SEC.wireDoors, ZS = SEC.ZS,
      stickChoiceOf = SEC.stickChoiceOf, stickChoiceWrite = SEC.stickChoiceWrite,
      stickModesCore = SEC.stickModesCore, calObj = SEC.calObj, cpVal = SEC.cpVal,
      vhBalanceHTML = SEC.vhBalanceHTML, ovSetTab = SEC.ovSetTab;
  /* from files after this one, bound once every file has run (never used
     while this file is loading) */
  var trModelOf;
  ZS_SECTIONS.after(function () {
    trModelOf = SEC.trModelOf;
  });

  /* from 10-aim-tables.js and 10-aim-controller.js (2026-10-31) */
  var aimAdvOn = SEC.aimAdvOn, aimAdvSet = SEC.aimAdvSet,
      aimActOpen = SEC.aimActOpen, aimActSet = SEC.aimActSet,
      curveFromBoard = SEC.curveFromBoard, customFromBoard = SEC.customFromBoard,
      smClassicPreset = SEC.smClassicPreset, classicLagMs = SEC.classicLagMs,
      classicShown = SEC.classicShown, smPresetFromValues = SEC.smPresetFromValues,
      invNameOf = SEC.invNameOf, mouseSVG = SEC.mouseSVG, qhParts = SEC.qhParts,
      labHelp = SEC.labHelp, smHelpText = SEC.smHelpText,
      XQUANT_OPEN = SEC.XQUANT_OPEN,
      CURVE_MAP = SEC.CURVE_MAP, CURVE_NAMES = SEC.CURVE_NAMES,
      SM_PRESETS = SEC.SM_PRESETS, CLASSIC_SEED = SEC.CLASSIC_SEED,
      MOUSE_CLASSIC_SEED = SEC.MOUSE_CLASSIC_SEED, INV_OPTS = SEC.INV_OPTS,
      XMECH_OPEN = SEC.XMECH_OPEN, AIM_HELP = SEC.AIM_HELP,
      makeAimController = SEC.makeAimController;

  var aimPollTimer=null;   /* live-feedback poller (one, app-wide) — the Smart
    Actions poller that shared this line moved to smart-actions.js with the
    rest of that screen (screen-map §5.4) */
  R.aim = function(p){
    /* TWO questions, not one either/or. `var mnk = p.input==='mnk'` meant
       "not mnk" silently became "controller", so a Joystick + Mouse config
       would have been handed a controller-only Aim screen with the mouse
       untunable anywhere in the app. It answers YES to both and gets both
       halves of this screen. */
    var hasMouse = ZS.inputShows(p.input, 'mouse');
    var hasPad   = ZS.inputShows(p.input, 'controller');
    /* D238 (owner, 2026-10-09): a pad AND a mouse/keyboard plugged in -> the
       screen first asks which half to tune, two big halves, and then shows
       only that half with a key to switch (window.ZS_AIM_VIEW, per config,
       for the app's life; Mappings keeps its own choice) */
    var dcA = (typeof ZS.deviceClasses === 'function') ? ZS.deviceClasses() : null;
    var aimBoth = hasMouse && hasPad && !!(dcA && dcA.controller && (dcA.mouse || dcA.keyboard));
    var AIMV = window.ZS_AIM_VIEW || (window.ZS_AIM_VIEW = {});
    var aimView = aimBoth ? (AIMV[p.id] || null) : null;
    if (aimView === 'pad') hasMouse = false;
    else if (aimView === 'kbm') hasPad = false;
    var baseNs = p.id+'/aim';
    /* D482 (owner, 2026-10-26): Response Curve, Triggers and Deadzones are
       folded EVERY time the page opens. A redraw of the page already on
       screen (a setting, the poll, the M&K / Controller switch) keeps what
       the player opened; anything else is a fresh open and starts folded. */
    if(window.ZSZK && ZSZK.resetFolds && typeof document!=='undefined'){
      var dtEl = document.getElementById('detail'), dbEl = document.getElementById('dbody');
      var redraw = !!(dtEl && dtEl.classList.contains('open') && dbEl &&
        dbEl.querySelector('.zkapp, .aimpage, [data-aimview], #aim-switch'));
      if(!redraw) ZSZK.resetFolds();
    }
    /* the aim pager: which page is showing (survives the re-render every
       preset tap causes — a pager that snapped back to Hip on each tap would
       make ADS untunable), and the preset the user just picked, held ahead of
       the debounced write because the eye is faster than the board. `stick` is
       the pad card's own rung on the same ladder; smApply only ever writes
       'hip'/'ads', so the three keys cannot collide.
       (This comment used to cite `gameSel` as the precedent. There was no such
       variable — it was an assignment to an undeclared name inside a ghost
       wiring, and both went out with the .seg2 sweep below.) */
    var pagerPage = 0;
    var smSel = { hip:null, ads:null, stick:null };
    /* The board wins. Controller Feel -> Stick response writes the SAME
       curves.<side> fields this screen's preset writes, so a curve name kept
       only in localStorage could show "Even" while the board held power/1.9 —
       and the next preset tap would then overwrite the other screen's choice
       from a stale starting point. */
    var boardFull = ZS.live.online!==false ? ZS.live.full[p.id] : null;
    /* ONE curve state per half. They are different board fields —
       mouseTranslation.curve* for the mouse, curves.rightStick.* for the
       stick — so a config showing both halves needs both. A single shared
       `st` would have let the mouse's preset seg overwrite the stick's.
       The mouse half keeps the store keys it has always used; the stick half
       gets new ones, and falls back to the old key so a config that WAS a
       Controller config does not forget its curve name on upgrade. */
    function curveState(isMouse, ck, cck, altCk, altCck){
      var bc = curveFromBoard(boardFull, isMouse);
      var bx = bc==='Custom' ? customFromBoard(boardFull, isMouse) : null;
      var s = {
        ck: ck, cck: cck,
        curve: bc || ZS.store.vals[baseNs+'|'+ck] || (altCk && ZS.store.vals[baseNs+'|'+altCk]) || 'Even',
        custom: bx || ZS.store.vals[baseNs+'|'+cck] || (altCck && ZS.store.vals[baseNs+'|'+altCck]) || [30,55,80]
      };
      if(CURVE_NAMES.indexOf(s.curve) < 0) s.curve = 'Even';   /* stale old name */
      return s;
    }
    var stM = curveState(true,  'curve', 'custom');
    var stP = curveState(false, 'padcurve', 'padcustom', 'curve', 'custom');
    function saveSt(){
      [stM, stP].forEach(function(s){
        ZS.store.vals[baseNs+'|'+s.ck]=s.curve; ZS.store.vals[baseNs+'|'+s.cck]=s.custom;
      });
      ZS.persistStore();
    }
    /* curveHalves() is gone with the last curve preset on this screen: BOTH
       editors are sheet-side now (the mouse's in openMech, the stick's in
       openStickMech), so which board fields a preset writes is settled by
       which sheet drew it rather than by DOM order. The warning it carried
       moved with the risk — see openStickMech's curve wiring. */

    /* XIM-style real-time feedback: the board's actual aim output, so every
       tweak can be FELT while tuning (also surfaces running Smart Actions) */
    function aimPadHTML(){
      return '<div class="vizbox" style="display:flex;gap:14px;align-items:center;padding:12px;text-align:left">'+
        '<svg viewBox="0 0 100 100" style="width:92px;height:92px;flex:none" aria-hidden="true">'+
        '<circle cx="50" cy="50" r="46" fill="none" stroke="var(--line)"/>'+
        '<circle cx="50" cy="50" r="23" fill="none" stroke="var(--line)" stroke-dasharray="3 3"/>'+
        '<line x1="50" y1="4" x2="50" y2="96" stroke="var(--line)" opacity=".35"/>'+
        '<line x1="4" y1="50" x2="96" y2="50" stroke="var(--line)" opacity=".35"/>'+
        '<circle id="aim-dot" cx="50" cy="50" r="5" fill="var(--accent)"/></svg>'+
        '<div style="min-width:0"><div style="font-weight:700;font-size:13px">Live aim response</div>'+
        /* "Take your hand off and it should sit dead centre" was an instruction
           to run a test the app already runs: #aim-rest below prints in red the
           moment the resting dot is NOT centred. Asking the reader to do by eye
           what the card does for him is the "restates its label" case — the
           30-word lead is 11 words now, and the check is unchanged. */
        '<div style="color:var(--muted);font-size:12px;line-height:1.45">move your '+(hasMouse?'mouse':'stick')+
        ' — this dot is your board’s output <b>right now</b>.</div>'+
        '<div id="aim-mag" style="font-size:12px;margin-top:4px;color:var(--muted)">aim stick · 0%</div>'+
        '<div id="aim-rest" style="font-size:12px;color:var(--red);display:none"></div>'+
        '<div id="aim-run" style="font-size:12px;color:var(--green);display:none"></div></div></div>';
    }
    function liveResponsePad(){
      if(aimPollTimer) clearInterval(aimPollTimer);
      var myNs = document.getElementById('dbody').dataset.ns;
      /* "hands off = dead centre" is the one thing a user can check by eye, so
         the pad says it out loud rather than leaving a 1-pixel offset to be
         noticed. restSince tracks how long the output has been non-zero while
         nothing is moving. */
      var restSince = 0, lastMag = -1;
      aimPollTimer = setInterval(function(){
        var dot = document.getElementById('aim-dot');
        var dbody = document.getElementById('dbody');
        /* stop the moment this screen is gone OR replaced by another one —
           an element check alone leaks when a re-render rebuilds the node */
        if(!dot || !screenLive(myNs) || !dbody || !dbody.contains(dot)){
          clearInterval(aimPollTimer); aimPollTimer=null; return;
        }
        if(document.hidden) return;               /* don't poll a phone in your pocket */
        liveOutput(function(data){
          var dot=document.getElementById('aim-dot'); if(!dot) return;
          var s=(data&&data.state)||{}; var ax=s.axes||{};
          var rx=+ax.rx||0, ry=+ax.ry||0;
          dot.setAttribute('cx', (50+rx*44).toFixed(1));
          dot.setAttribute('cy', (50-ry*44).toFixed(1));   /* engine +Y = up */
          var m = Math.hypot(rx,ry);
          var mag=document.getElementById('aim-mag');
          if(mag) mag.textContent='aim stick · '+Math.round(Math.min(1,m)*100)+'%';
          /* still (within a hair) AND off centre for 3s = a real resting drift */
          if(m > 0 && Math.abs(m-lastMag) < 0.002 && m < 0.08){
            if(!restSince) restSince = Date.now();
          } else { restSince = 0; }
          lastMag = m;
          var rest=document.getElementById('aim-rest');
          if(rest){
            var drifting = restSince && (Date.now()-restSince > 3000);
            rest.style.display = drifting ? '' : 'none';
            /* the control it names is behind the ⋯ door now, so the sentence
               says the whole route — a message that points at a control the
               reader cannot find on the screen is worse than no message */
            if(drifting && rest.getAttribute('data-wh')!=='1'){
              rest.setAttribute('data-wh','1');
              rest.innerHTML = warnHTML('your aim is sitting off centre with your hands off — raise <b>Inner deadzone</b> in <b>Mechanics ⋯</b>', 'aim-drift');
            }
          }
          var run=document.getElementById('aim-run');
          if(run){
            var seqs=(data&&data.activeSequences)||[];
            if(seqs.length){ run.style.display=''; run.textContent='▶ Script running: '+seqs.map(function(q){ return q.name; }).join(', '); }
            else run.style.display='none';
          }
        });
      }, 150);
    }

    /* Mouse mode, said plainly and switchable from the screen it changes.

       Neither choice turns any device off — Caleb's instruction is that mouse
       mode opens the mouse options and the controller keeps working. This
       switch only decides which tuning sections the app shows, and the copy
       says exactly that so nobody unplugs a pad they didn't need to.

       If a device's stream IS being dropped (a role someone set on the
       Devices screen, or this config's device list), the board's own sentence
       for it is shown right here too — those are the only two things left
       that can silence anything, and neither is this switch. */
    function suppressionNote(){
      var live = ZS.live.online!==false && ZS.live.status;
      var items = (live && ZS.live.status.inputSuppression) || [];
      var h = '', i;
      for(i=0;i<items.length;i++){
        h += note('⚠ <b>'+esc(items[i].name||'A device')+'</b> — '+esc(items[i].reason),'warn');
      }
      return h;
    }
    /* The input-type switch is GONE from this screen (screen-map §3, rule 2
       — one home per setting, and it is the owner's named complaint: "in aim
       you have like what you play with when that is literally in overview").
       Overview's Setup card is the one home; nothing else changed hands. */

    /* stickSwitchHTML() went into openStickMech: "what kind of stick is this"
       is the once-per-config question, which is exactly what the ⋯ door is
       for. It is not hidden in effect — the card above it holds the two
       controls THIS MODE HONOURS and nothing else, so the card's shape is the
       answer even before the sheet is opened. */

    /* One line of calibration truth per stance pane (screen-map §3.4): has
       this stance been measured, straight from the same calibration object
       the velocity screen writes. A door row, so the fix is one tap away. */
    function calChipHTML(ads){
      var full = ZS.live.online!==false ? ZS.live.full[p.id] : null;
      var c = calObj(full);
      var m = ads ? 'ads' : 'hip';
      /* D392: a Core is sent the RESOLVED model, never the calibration
         object, so its copy of a config may not carry one: a measured
         translator (calibrated, or a pack's measured model) counts too */
      var r = full && full.mouseTranslation && full.mouseTranslation.resolvedAimModel;
      var done = !!(c && cpVal(c, m+'X') && cpVal(c, m+'Y')) ||
        !!(r && typeof r==='object' && r.generic!==true && r.needsCalibration===false &&
           r[m] && typeof r[m]==='object');
      var word = (ads?'ADS':'Hip')+(done ? ': measured ✓' : ': not measured');
      return labHelp('<div class="lrow tapper" role="button" tabindex="0" '+
        'data-door="velocity" data-doorlab="Aim Speed Match" '+
        'aria-label="'+esc(word+' — reticle velocity calibration')+'">'+
        '<span class="src" style="font-size:12.5px;'+(done?'':'color:var(--amber)')+'">'+esc(word)+
        '<em style="display:block;font-weight:400;font-style:normal;color:var(--muted);'+
        'font-size:11px;white-space:normal">reticle velocity — tap to measure</em></span>'+
        '<span class="rt"><span class="arrow">›</span></span></div>', 'aim-cal-'+m, 'Reticle velocity', AIM_HELP.measured);
    }

    /* padStanceTailHTML() is GONE (2026-09-04, the owner's second ask). Its
       whole job was to explain why a pad had no Hip / ADS tabs — true while
       a stick had one gain, and false the day core/stages.SensitivityStage
       grew curves.rightStick.adsGain. The pad has the tabs now
       (stickAdsPageHTML below); the fold and the Aim door it carried
       moved onto the ADS page, where the thing they explain is. */

    /* ── the hip/ADS aim pager (mouse branch) ─────────────────────────
       XIM's shape on our fields: two swipeable full-width cards, gold Hip
       and green ADS, each holding ONE sensitivity stepper and ONE smoothing
       carousel, with ⋯ into Mechanics. The controls that used to sit flat on
       this screen (Smoothing, Aim distance while aiming, the drawer's filter
       detail, both invert toggles, Vertical ratio) live here now and ONLY
       here — one control per field. */

    /* Which preset each page shows. The tap the user just made wins, then
       the board's stored trio, then what was last picked here — never a
       name the values deny. */
    /* D191: the seven ADS fields that say "this stance has its own
       smoothing"; all null = Same as hip. */
    var SM_ADS_KEYS = ['adsSmoothing','adsOneEuroBeta','adsSmoothingEasing',
                       'adsSmoothingStyle','adsClassicSmooth','adsClassicDecay','adsClassicSynch'];
    function smInherits(mt){
      return SM_ADS_KEYS.every(function(k){ return mt[k]==null; });
    }
    /* Before hip's style changes: an ADS stance with numbers of its own but
       no style named was riding hip's style; name it, so the hip change
       cannot quietly switch ADS's filter family under its numbers. */
    function smPinAds(mt){
      if(!smInherits(mt) && mt.adsSmoothingStyle==null)
        mt.adsSmoothingStyle = mt.smoothingStyle==='classic' ? 'classic' : 'standard';
    }
    /* The EFFECTIVE smoothing of a stance, read off the board's document the
       way the Core resolves it (zs_mouse.c configure): ADS overlays hip. */
    function smEffective(mt, mode){
      var ads = mode==='ads';
      function pick(a, h){ return (ads && mt[a]!=null) ? mt[a] : mt[h]; }
      var style = pick('adsSmoothingStyle', 'smoothingStyle')==='classic' && classicShown() ? 'classic' : 'standard';
      return { style: style,
               sm: pick('adsSmoothing','smoothing'), beta: pick('adsOneEuroBeta','oneEuroBeta'),
               eas: pick('adsSmoothingEasing','smoothingEasing'),
               cs: pick('adsClassicSmooth','classicSmooth'), cd: pick('adsClassicDecay','classicDecay'),
               cy: pick('adsClassicSynch','classicSynch') };
    }
    function smPresetOf(mode){
      if(smSel[mode]) return smSel[mode];
      var local = ZS.store.vals[baseNs+'|sm-'+mode];
      var full = ZS.live.online!==false ? ZS.live.full[p.id] : null;
      var mt = full && full.mouseTranslation;
      if(!mt) return local || (mode==='ads' ? 'Same as hip' : 'Disabled');
      /* all seven null/absent = inherit — the board has nothing of its own */
      if(mode==='ads' && smInherits(mt)) return 'Same as hip';
      if(local==='Custom') return 'Custom';   /* an exact match may still be MY numbers */
      var e = smEffective(mt, mode);
      if(e.style==='classic') return 'Custom';   /* D392: no Classic preset on the mouse */
      return smPresetFromValues(e.sm, e.beta, e.eas) || 'Custom';
    }
    function smOptionsOf(mode){
      /* D392: no "Synchronous" here: it was Classic with only Synch on, which
         is Sync to game's job (Classic itself is under Custom) */
      var names = SM_PRESETS.map(function(pr){ return pr[0]; })
        .concat(['Custom']);
      return mode==='ads' ? ['Same as hip'].concat(names) : names;
    }
    /* ── Custom: XIM's mode button and its three values (D191) ─────────
       Custom reveals, right under the carousel, a Standard | Classic button
       and the chosen style's three numbers, 0-100% with one decimal on
       Standard (XIM's own words and example 67.5 / 55.0 / 42.5) and XIM
       APEX's numbers on Classic. Standard's three ARE the fields Precision
       / Response / Easing always wrote, rescaled to XIM's 0-100%:
         Precision % = smoothing / 0.90     (the 1 euro floor cutoff; D392:
                                             it was / 0.95, and the filter
                                             has done all it can by 0.90, so
                                             the top of the slider did
                                             nothing, docs/MOUSE-AUDIT.md)
         Response %  = oneEuroBeta x 10     (how fast the cutoff opens)
         Easing %    = smoothingEasing x 100 (the derivative cutoff)
       so every config keeps its filter bit for bit. One control per field:
       the fold no longer draws them. */
    function smStyleSeg(attrs, style){
      return '<div class="seg2 smstyle" data-nosave="1"'+attrs+' data-smcur="'+style+'" aria-label="Smoothing mode">'+
        [['standard','Standard'],['classic','Classic']].map(function(o){
          return '<button data-smstyle="'+o[0]+'"'+(o[0]===style?' class="on"':'')+'>'+o[1]+'</button>';
        }).join('')+'</div>';
    }
    function classicLagLine(cs, cd, cy){
      return '<div class="xsub smlag" aria-live="polite">Adds about '+
        (Math.round(classicLagMs(cs, cd, cy)*10)/10)+' ms of delay.</div>';
    }
    function classicSteppers(keys, vals, who, mouse){
      /* keys: [smooth, decay, synch] field paths; who: hip | ads | stick,
         which keeps the three "?" of each stance apart */
      return labHelp(stepper('Smooth', vals[0], 0.5, 0, 100, '',
          'Higher = more smoothing.',
          B(keys[0], 1, {mn:0, mx:100, dp:1})), 'aim-csmooth-'+who, 'Smooth', AIM_HELP.smooth)+
        labHelp(stepper('Decay', vals[1], 0.5, 0, 20, '',
          'How much Smooth leans on past movement. Higher = older movement counts less. Usual: 9.0.',
          B(keys[1], 1, {mn:0, mx:20, dp:1})), 'aim-cdecay-'+who, 'Decay', AIM_HELP.decay)+
        (mouse ? synchMovedHTML(vals[2]) :
        labHelp(stepper('Synch', vals[2], 1, 0, 64, ' ms',
          'Evens aim out over this many ms, to match the game\u2019s frames. 8 Default, 16 Common, 32 Slow, 0 Off.',
          B(keys[2], 1, {mn:0, mx:64, dp:0})), 'aim-csynch-'+who, 'Synch', AIM_HELP.synch))+
        classicLagLine(vals[0], vals[1], vals[2]);
    }
    /* D392: a mouse stance whose Classic still holds a Synch (an older setup,
       or an XIM import before D392) says so, with the one tap that moves it
       to Sync to game, so nothing runs that no control on the screen shows */
    function synchMovedHTML(sy){
      if(!(+sy > 0)) return '';
      return '<div class="lrow synchmoved" style="font-size:12.5px;gap:10px">'+
        '<span class="src" style="white-space:normal">Synch '+esc(String(Math.round(+sy)))+' ms is on from an older setup</span>'+
        '<button class="btn ghost" data-synchmove="'+esc(String(Math.round(+sy)))+'" style="flex:none">Use Sync to game</button></div>'+
        helpHTML('aim-synchmoved', 'Synch', 'Frame sync is one setting now: <b>Sync to game</b> on the Translation page. '+
          'This moves your Synch there (8 ms becomes 120, longer becomes 60) and turns it off here, so the two never stack.');
    }
    /* Standard | Classic: a seg with no label of its own, so its "?" is the
       app's usual row under it */
    function smStyleHelp(who){
      return helpHTML('aim-smstyle-'+who, 'Smoothing mode', AIM_HELP.style);
    }
    function smCustomHTML(mode){
      var ads = mode==='ads';
      var mt = ((ZS.live.online!==false ? ZS.live.full[p.id] : null) || {}).mouseTranslation || {};
      var e = smEffective(mt, mode);
      var h = '<div class="smcustom" data-smcustom="'+mode+'">';
      if(classicShown()) h += smStyleSeg(' data-smstylefor="'+mode+'"', e.style)+smStyleHelp(mode);
      if(e.style==='classic'){
        h += classicSteppers(ads ? ['mouseTranslation.adsClassicSmooth','mouseTranslation.adsClassicDecay','mouseTranslation.adsClassicSynch']
                                 : ['mouseTranslation.classicSmooth','mouseTranslation.classicDecay','mouseTranslation.classicSynch'],
          [typeof e.cs==='number' ? e.cs : 0, typeof e.cd==='number' ? e.cd : 9, typeof e.cy==='number' ? e.cy : 0], mode, true);
      } else {
        h += labHelp(stepper('Precision', 0, 0.5, 0, 100, '%',
               'Fine aim. Higher = smoother at low speeds, a heavier reticle.',
               B(ads?'mouseTranslation.adsSmoothing':'mouseTranslation.smoothing', 0.009, {mn:0, mx:0.9, dp:1})),
               'aim-precision-'+mode, 'Precision', AIM_HELP.precision)+
