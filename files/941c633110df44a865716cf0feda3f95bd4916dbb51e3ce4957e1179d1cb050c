  /* new meaning -> old, where nothing overlaps: the gap after the press */
  function oldForm(steps) {
    var out = steps.map(clone);
    for (var i = 0; i + 1 < out.length; i++) {
      if (timedPress(out[i]) && out[i + 1].k === 'wait') {
        out[i + 1] = { k: 'wait', ms: Math.max(0, intOf(out[i + 1].ms, 0) - intOf(out[i].ms, 0)) };
