      if (e.at > cur) { pushWait(e.at - cur); cur = e.at; }
      if (e.d > 0 && (e.s.k === 'stick' || e.s.k === 'sens' || e.s.k === 'swap' || e.s.k === 'move')) {
        /* a timed stick / sensitivity / swap step that a press starts or
           ends inside is cut there and carries on (same value), so the
           press is not made to wait for it. A Recoil pull is cut the same
           way, its distance shared in proportion (audit m17: uncut, it held
           the press for the whole pull, three times too long) */
        var cut = 0;
        for (i = 0; i < ev.length; i++) {
          if (ev[i].at > cur && ev[i].at < cur + e.d) { cut = ev[i].at - cur; break; }
        }
        if (cut) {
          var part = clone(e.s), rest = clone(e.s);
          part.ms = cut;
          if (e.s.k === 'move') {
            part.dx = Math.round(intOf(e.s.dx, 0) * cut / e.d);
            part.dy = Math.round(intOf(e.s.dy, 0) * cut / e.d);
            rest.dx = intOf(e.s.dx, 0) - part.dx;
            rest.dy = intOf(e.s.dy, 0) - part.dy;
          }
          out.push(part);
          ev.push({ at: cur + cut, o: late++, s: rest, d: e.d - cut });
          cur += cut;
          sortEv();
          continue;
        }
      }
      if (e.d > 0) st.ms = e.d;
      out.push(st);
      cur += e.d;
    }
    if (end > cur) pushWait(end - cur);
    return out;
  }

  function isTrigTargets(list) {
    return list.length === 1 && (list[0] === 'lt+' || list[0] === 'rt+');
  }

