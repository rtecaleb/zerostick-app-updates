/* smart-actions/01-model.js — the Scripts editor's model: the board's own action JSON.
 *
 * The engine's limits (STEP_MS_CAP...), the small helpers and the local control
 * kit, the vocabulary (step kinds, trigger gestures), the pad in hand order,
 * names and art for a source or a target (INPUT = the pad you hold, OUTPUT = the
 * console this config targets), the room a weapon's actions live in (D122),
 * the local draft (persist), the old editor's migration, the board's step JSON
 * both ways (emitStep / fromBoardStep), the ADS gate, toBoard, and the sync
 * that MERGES into accessibilityActions[] (syncBoard, saveAll; never replaces).
 * Profile: accessibilityActions[] -> ACTIONS 0x0011 -> components/zs_actions.
 *
 * Tests: test-smart-actions.js (and its self-check), test-profile-writes.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('model', function (SEC) {
  'use strict';
  /* from parts after this one, bound once every part has run (never used
     while this part is running) */
  var hasErrors, stepLine, sicon, openStepSheet;
  ZS_SMART_PARTS.after(function () {
    hasErrors = SEC.hasErrors;
    stepLine = SEC.stepLine;
    sicon = SEC.sicon;
    openStepSheet = SEC.openStepSheet;
  });

  var ZS = window.ZS, esc = ZS.esc, ico = ZS.icoSVG;
  /* VIEW: the editor's state that more than one file changes (the room
     being drawn, the screen to redraw into, the open panel). One object,
     so every file sees the same values (smart-actions.js, rule 4). */
  var VIEW = {};

  /* ── board limits, quoted from the engine ─────────────────────── */
  var STEP_MS_CAP = 10000;      /* steps.py: STEP_MS_CAP */
  var DUR_MIN = 100, DUR_MAX = 30000;   /* schema.py: maxDurationMs */
  var COOL_MAX = 60000, VAR_MAX = 500, REP_MAX = 10;
  /* D171: a stick push may vary by up to +-10 points of full deflection */
  var SVAR_MAX = 10;
  /* null = "use the config's" (the Translation tab's Stick variance); a
     number 0..10 is this action's own, 0 meaning "exact, whatever the
     config says". Rounded to a hundredth because that is what the wire
     carries (points x 100 + 1). */
  function stickVarOf(v) {
    if (typeof v !== 'number' || !isFinite(v)) return null;
    return Math.round(clamp(v, 0, SVAR_MAX) * 100) / 100;
  }
  /* "Switch config to number N". It was 1 to 20, a number from when a Core
     held eight configs. Since D135 a Core's configs have no count, so the
     only bound is the one the wire carries: the encoders write the number as
     a signed 16-bit index (encode.py, zs-profile-encode.js), and the Core
     reads it as one. The editor offers at least 20, and more when there are
     more configs to switch to (configNumberTop). */
  var CONFIG_NUMBER_MAX = 32767;
  function configNumberTop(cur) {
    var n = (ZS.PROFILES && ZS.PROFILES.length) || 0;
    return Math.min(CONFIG_NUMBER_MAX, Math.max(20, n, typeof cur === 'number' ? cur : 1));
  }

  /* ── small helpers ────────────────────────────────────────────── */
  function num(v, d) { var n = parseFloat(v); return isFinite(n) ? n : d; }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function clone(o) { return o == null ? o : JSON.parse(JSON.stringify(o)); }
  function intOf(v, d) { return Math.round(num(v, d)); }
  function arr(v) { return Array.isArray(v) ? v : []; }
  /* The board reads a step's ms through steps.py's ms(), which falls back to
     the default for a bool or anything non-numeric — so only a real numeric
     zero carries the "hold, do not tap" meaning. */
  function isZero(v) { return typeof v === 'number' && v === 0; }
  /* the shortest tap the board can tell apart from a hold */
  var TAP_MS_MIN = 1;

  /* A closed detail panel keeps its DOM (it is only translated off-screen), so
     a poller must check the panel is open AND still showing this screen.
     Re-declared here because phone-sections.js keeps its copy private. */
  function screenLive(ns) {
    var d = document.getElementById('detail');
    if (!d || !d.classList.contains('open')) return false;
    var b = document.getElementById('dbody');
    return !!b && (!ns || b.dataset.ns === ns);
  }

  /* confirm-on-second-tap for destructive buttons (same idiom as the kit).
     `say` replaces "Tap again to confirm" when the second tap does more
     than the button's word says (D134: deleting a linked Smart Action
     deletes it from every gun it is linked to, and says how many first). */
  function armConfirm(b, fn, say) {
    b.addEventListener('click', function () {
      if (b.dataset.armed === '1') { b.dataset.armed = ''; fn(); return; }
      b.dataset.armed = '1';
      /* innerHTML, not textContent: the delete keys wear the set's trash
         icon (D82), and the mark has to come back with the word */
      var old = b.innerHTML;
      b.textContent = say || 'Tap again to confirm';
      setTimeout(function () {
        if (b.dataset.armed === '1') { b.dataset.armed = ''; b.innerHTML = old; }
      }, 2600);
    });
  }

  /* Enter/Space on a role="button" row */
  function kbRow(el, fn) {
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fn(e); }
    });
  }

  /* ── the control kit, re-declared locally ─────────────────────────
     Two deliberate differences from phone-sections.js's copy:
       · no data-bind support — the model owns every value here;
       · labels use .salab, not .flab. phone.html's wire() derives a
         localStorage key from the .flab text, and this screen repeats labels
         ("How long") across steps, which would make them share one key and
         reload the previous step's number. No .flab means keyFor() returns
         null and nothing is ever written. Everything else on screen also
         carries data-nosave="1" for the same reason. */
  function sh(t) { return '<div class="sh">' + esc(t) + '</div>'; }
  function card(inner) { return '<div class="grp-card">' + inner + '</div>'; }
  /* RAW HTML SINK: `t` is inserted unescaped so a note can carry <b> and a
     coloured dot. Every caller passes a literal or escapes the model values it
     interpolates — anything from an action, a step or a share code must go
     through esc() before it gets here. */
  /* a warning is the shared "!" chip (phone-sections.js warnHTML) so the
     two files can never grow two disagreeing warnings; everything else is
     the plain note it always was */
  /* `full` is D70's third argument: the whole block, ONLY for a sentence
     that answers something the player just tapped (the recorder's "your
     board couldn't start"); an advisory warning never passes it */
  function note(t, kind, full) {
    if (kind === 'warn' && !full && ZS.warnHTML) return ZS.warnHTML(t);
    return '<div class="note' + (kind ? ' ' + kind : '') + '">' + t + '</div>';
  }
  /* D285 (owner, 2026-10-13: "you explain every script with like a
     paragraph - just turn that into the question mark thing"): an
     explanation is never printed on a Scripts screen; it is the "?" fold
     (phone-sections' helpHTML: bullets per D260, hidden with Show help
     buttons off per D236). Without helpHTML (a test page that never loaded
     the kit) it falls back to the plain note, so nothing is ever lost. */
  function helpNote(id, label, t) {
    return ZS.helpHTML ? ZS.helpHTML(id, label, t) : note(t);
  }
  function btn(label, kind, id) {
    return '<button class="btn' + (kind ? ' ' + kind : '') + '"' + (id ? ' id="' + id + '"' : '') + '>' + esc(label) + '</button>';
  }
  /* the same key with one of the set's icons before its word (D82): the
     word is still the label, the icon is recognition */
  function btnI(icon, label, kind, id) {
    return '<button class="btn' + (kind ? ' ' + kind : '') + '"' + (id ? ' id="' + id + '"' : '') + '>' +
      sicon(icon) + '<span>' + esc(label) + '</span></button>';
  }
  function addbtn(label, id) { return '<div class="addbtn"' + (id ? ' id="' + id + '"' : '') + ' role="button" tabindex="0">' + (sicon('plus') || '＋ ') + esc(label) + '</div>'; }
  function acc(title, iconName, inner, open, id) {
    return '<div class="acc' + (open ? ' open' : '') + '"' + (id ? ' id="' + id + '"' : '') + '><div class="ah">' +
      (iconName ? '<span class="aicon">' + ico(iconName, 20) + '</span>' : '') + esc(title) +
      '<span class="chev">›</span></div><div class="ab">' + inner + '</div></div>';
  }
  /* `sub` is a RAW HTML SINK in both of these (it carries the odd <b>), so a
     caller feeding it a model field must esc() it first; `label` is escaped. */
  function fld(label, control, sub) {
    return '<div class="fld"><div class="salab">' + esc(label) +
      (sub ? '<em>' + sub + '</em>' : '') + '</div>' + control + '</div>';
  }
  function fldCol(label, control, sub) {
    return '<div class="fld col"><div class="salab">' + esc(label) +
      (sub ? '<em>' + sub + '</em>' : '') + '</div>' + control + '</div>';
  }
  function toggle(on, id, aria) {
    return '<span class="sw' + (on ? ' on' : '') + '" data-nosave="1" role="switch"' +
      (id ? ' id="' + id + '"' : '') + ' aria-checked="' + (on ? 'true' : 'false') +
      '" tabindex="0" aria-label="' + esc(aria || '') + '"></span>';
  }
  function svspan(val, min, max, suf, d, field) {
    return '<span class="stp"><button data-d="-' + d + '" aria-label="decrease">−</button>' +
      '<b class="sv" data-nosave="1" data-f="' + esc(field) + '" data-min="' + min + '" data-max="' + max + '"' +
      (suf ? ' data-suffix="' + esc(suf) + '"' : '') + '>' + esc(String(val)) + '</b>' +
      '<button data-d="' + d + '" aria-label="increase">+</button></span>';
  }
  function stepper(label, val, d, min, max, suf, sub, field) {
    return fld(label, svspan(val, min, max, suf, d, field), sub);
  }
  function seg(label, opts, idx, id, sub, disabled) {
    return fldCol(label, '<div class="seg2" data-nosave="1"' + (id ? ' id="' + id + '"' : '') + '>' +
      opts.map(function (o, i) {
        return '<button' + (i === (idx || 0) ? ' class="on"' : '') +
          (disabled ? ' aria-disabled="true"' : '') + '>' + esc(o) + '</button>';
      }).join('') + '</div>', sub);
  }
  function txtFld(label, val, cls, ph, sub) {
    return '<div class="fld col"><div class="salab">' + esc(label) + (sub ? '<em>' + sub + '</em>' : '') + '</div>' +
      '<input class="txt ' + cls + '" data-nosave="1" style="margin-top:10px" value="' + esc(val || '') +
      '" placeholder="' + esc(ph || '') + '" aria-label="' + esc(label) + '"></div>';
  }

  /* ══ vocabulary ═══════════════════════════════════════════════════ */

  /* The 28 targets a step may drive: every Button in the board's neutral model
     plus the eight stick directions and the two pulled triggers. "lt-"/"rt-"
     are deliberately absent — schema accepts them and parse_target throws them
     away, so offering them would build a step that does nothing. */
  var TARGET_SECTIONS = [
    { h: 'Face buttons',      codes: ['south', 'east', 'west', 'north'] },
    { h: 'Shoulders',         codes: ['l1', 'r1'] },
    { h: 'Triggers',          codes: ['lt+', 'rt+'] },
    { h: 'Stick clicks',      codes: ['l3', 'r3'] },
    { h: 'D-pad',             codes: ['dpad_up', 'dpad_down', 'dpad_left', 'dpad_right'] },
    { h: 'System',            codes: ['start', 'select', 'guide', 'touchpad'] },
    { h: 'Move (left stick)', codes: ['ly+', 'ly-', 'lx-', 'lx+'] },
    { h: 'Aim (right stick)', codes: ['ry+', 'ry-', 'rx-', 'rx+'] },
    { h: 'Extras',            codes: ['extra1', 'extra2'] }
  ];
  var TARGET_OK = {};
  TARGET_SECTIONS.forEach(function (s) {
    s.codes.forEach(function (c) { TARGET_OK[c] = true; });
  });

  /* Neutral pad control → the exact code the engine matches a trigger on.
     THIS TABLE MUST AGREE WITH board/agent/zs_agent/mapping/labels.py's
     CONTROL_SOURCES. The engine compares `a.source != code` on an exact
     string, so a disagreement here is not a rendering bug — it is an action
     that never fires. (The board now normalises neutral names itself, so a
     mismatch is caught rather than silent, but the app should still write the
     code the board wants.)

     l2/r2 resolve to the ANALOG source, not to BTN_TL2/BTN_TR2. The digital
     trigger click is a DualSense thing; xpad publishes triggers only as
     ABS_Z/ABS_RZ and never sends BTN_TL2 at all, so a "fires on R2" action
     resolved to BTN_TR2 was dead on every Xbox-family pad. The analog source
     fires past 60% pull and works on both. */
  var CONTROL_SOURCE = {
    south: 'BTN_SOUTH', east: 'BTN_EAST', west: 'BTN_WEST', north: 'BTN_NORTH',
    l1: 'BTN_TL', r1: 'BTN_TR',
    l2: 'lt', r2: 'rt', lt: 'lt', rt: 'rt',
    l3: 'BTN_THUMBL', r3: 'BTN_THUMBR',
    dpad_up: 'BTN_DPAD_UP', dpad_down: 'BTN_DPAD_DOWN',
    dpad_left: 'BTN_DPAD_LEFT', dpad_right: 'BTN_DPAD_RIGHT',
    start: 'BTN_START', select: 'BTN_SELECT', guide: 'BTN_MODE',
    touchpad: 'BTN_TRIGGER_HAPPY1'
  };

  /* the pad controls offered as a trigger source, in the order a hand finds
     them; [neutral code for the art/name, the code the engine watches] */
  var PAD_SOURCES = [
    ['south', 'BTN_SOUTH'], ['east', 'BTN_EAST'], ['west', 'BTN_WEST'], ['north', 'BTN_NORTH'],
    ['l1', 'BTN_TL'], ['r1', 'BTN_TR'], ['l2', 'lt'], ['r2', 'rt'],
    ['l3', 'BTN_THUMBL'], ['r3', 'BTN_THUMBR'],
    ['dpad_up', 'BTN_DPAD_UP'], ['dpad_down', 'BTN_DPAD_DOWN'],
    ['dpad_left', 'BTN_DPAD_LEFT'], ['dpad_right', 'BTN_DPAD_RIGHT'],
    ['start', 'BTN_START'], ['select', 'BTN_SELECT']
  ];

  /* ── the pad, in the order one hand finds it ────────────────────────
     Moved here from R.bindings (its PAD_SRC_CODE / PAD_IDX_TARGET pair) so
     the Buttons screen and the Smart Actions screen are ONE renderer over one
     model. Each entry:

       [0] the code a BINDING watches   [1] neutral name, for art and words
       [2] its passthrough target       [3] the code an ACTION watches

     The two trigger rows are the only place [0] and [3] differ, and the
     difference is real rather than tidy: a binding watches the digital
     trigger CLICK (BTN_TL2, which only a DualSense sends), while an action
     watches the ANALOG pull past 60% ("lt", which every pad sends). Under
     your finger they are one control, so they are one ROW — and the row
     writes the right code into each of the two lists. */
  var PAD_ROWS = [
    ['BTN_SOUTH', 'south', 'south', 'BTN_SOUTH'],
    ['BTN_EAST', 'east', 'east', 'BTN_EAST'],
    ['BTN_WEST', 'west', 'west', 'BTN_WEST'],
    ['BTN_NORTH', 'north', 'north', 'BTN_NORTH'],
    ['BTN_TL', 'l1', 'l1', 'BTN_TL'],
    ['BTN_TR', 'r1', 'r1', 'BTN_TR'],
    ['BTN_TL2', 'l2', 'lt+', 'lt'],
    ['BTN_TR2', 'r2', 'rt+', 'rt'],
    ['BTN_THUMBL', 'l3', 'l3', 'BTN_THUMBL'],
    ['BTN_THUMBR', 'r3', 'r3', 'BTN_THUMBR'],
    ['BTN_DPAD_UP', 'dpad_up', 'dpad_up', 'BTN_DPAD_UP'],
    ['BTN_DPAD_DOWN', 'dpad_down', 'dpad_down', 'BTN_DPAD_DOWN'],
    ['BTN_DPAD_LEFT', 'dpad_left', 'dpad_left', 'BTN_DPAD_LEFT'],
    ['BTN_DPAD_RIGHT', 'dpad_right', 'dpad_right', 'BTN_DPAD_RIGHT'],
    ['BTN_START', 'start', 'start', 'BTN_START'],
    ['BTN_SELECT', 'select', 'select', 'BTN_SELECT']
  ];

  /* GRID_TARGETS — a flat list of fourteen codes drawn as a wrapping row of
     identical tiles — is GONE. PAD_TGT_GROUPS replaces it: the same controls
     in five captioned rows (the 6×5 pad silhouette that came between lasted
     eleven days — see the comment on PAD_TGT_GROUPS), so you point at a
     named group instead of reading fourteen tiles that differ only by
     their label. The half of the old idea that was right is kept: the grid
     still never moves between the two screens, only what a tap MEANS changes. */

  /* plain-English names for keyboard and mouse sources */
  var KEY_NAME = {
    KEY_SPACE: 'Space', KEY_LEFTSHIFT: 'Shift', KEY_RIGHTSHIFT: 'Right Shift',
    KEY_LEFTCTRL: 'Ctrl', KEY_RIGHTCTRL: 'Right Ctrl', KEY_LEFTALT: 'Alt',
    KEY_TAB: 'Tab', KEY_ESC: 'Esc', KEY_ENTER: 'Enter', KEY_CAPSLOCK: 'Caps Lock'
  };
  var MOUSE_NAME = {
    BTN_LEFT: 'Left click', BTN_RIGHT: 'Right click', BTN_MIDDLE: 'Middle click',
    BTN_SIDE: 'Mouse button 4', BTN_EXTRA: 'Mouse button 5'
  };

  /* Names spelled out only when glyphs.js has not loaded; ZSG owns the real
     ones. This table has to switch family too — a single frozen family here is
     how an Xbox config ends up labelling its OUTPUT "Cross". "lt+"/"rt+" carry
     their own rows because those, not "lt"/"rt", are the codes TARGET_SECTIONS
     offers, and a missing row renders the raw code on screen. */
  var FALLBACK_FAM = {
    ps: {
      south: 'Cross', east: 'Circle', west: 'Square', north: 'Triangle',
      l1: 'L1', r1: 'R1', l2: 'L2', r2: 'R2', lt: 'L2', rt: 'R2',
      'lt+': 'L2', 'rt+': 'R2',
      start: 'Options', select: 'Create', guide: 'PS'
    },
    xb: {
      south: 'A', east: 'B', west: 'X', north: 'Y',
      l1: 'LB', r1: 'RB', l2: 'LT', r2: 'RT', lt: 'LT', rt: 'RT',
      'lt+': 'LT', 'rt+': 'RT',
      start: 'Menu', select: 'View', guide: 'Guide'
    }
  };
  /* the same words on every pad */
  var FALLBACK_SHARED = {
    l3: 'L3', r3: 'R3', touchpad: 'Touchpad', extra1: 'Extra 1', extra2: 'Extra 2',
    dpad_up: 'D-pad Up', dpad_down: 'D-pad Down',
    dpad_left: 'D-pad Left', dpad_right: 'D-pad Right',
    'ly+': 'Left Stick Up', 'ly-': 'Left Stick Down',
    'lx-': 'Left Stick Left', 'lx+': 'Left Stick Right',
    'ry+': 'Right Stick Up', 'ry-': 'Right Stick Down',
    'rx-': 'Right Stick Left', 'rx+': 'Right Stick Right'
  };
  /* every table read goes through here: a code like "constructor" would
     otherwise reach Object.prototype and hand back a function */
  function has(table, key) { return Object.prototype.hasOwnProperty.call(table, key); }
  function fallbackName(code, fam) {
    var c = String(code === undefined || code === null ? '' : code);
    var f = FALLBACK_FAM[fam] || FALLBACK_FAM.ps;
    if (has(f, c)) return f[c];
    if (has(FALLBACK_SHARED, c)) return FALLBACK_SHARED[c];
    return c;
  }

  /* ── names and art ────────────────────────────────────────────── */

  /* Which button family names what the CONSOLE receives. The output stage
     started life Xbox-only, which is why ZSG's out* helpers still answer Xbox
     when no console is named; a PS5 config genuinely arrives at the console as
     a DualSense, so `west` there is Square, not X. p.platform is the config's
     console — phone.html's uiProfile() maps the agent's `console` onto it. */
  function conFam(p) { return (p && (p.platform === 'ps5' || p.platform === 'ps4')) ? 'ps' : 'xb'; }

  /* a keyboard key or a mouse click the PC receives (binding targets since
     2026-09-04, PC configs only — see gridHTML). Named and drawn as the key
     it is, by the same functions the input side uses, so "F key" reads the
     same whether you press it or send it. BTN_ is only a target for the
     five mouse buttons; a pad's BTN_SOUTH is never a target ("south" is). */
  function isKeyTarget(code) {
    var c = String(code || '');
    return c.indexOf('KEY_') === 0 || !!MOUSE_NAME[c];
  }
  function tgtName(code, p) {
    if (isKeyTarget(code)) return srcName(code);
    var Z = window.ZSG;
    if (Z) return Z.outLabel(code, conFam(p));
    return fallbackName(code, conFam(p));
  }
  function tgtShort(code, p) {
    if (isKeyTarget(code)) return srcName(code).replace(/ key$/, '').replace(/ mouse button$/, ' click');
    var Z = window.ZSG;
    if (Z) return Z.outShort(code, conFam(p));
    return fallbackName(code, conFam(p));
  }
  function tgtSvg(code, p) {
    if (isKeyTarget(code)) return srcArt(code);
    var Z = window.ZSG;
    return Z ? Z.outGlyph(code, conFam(p)) : '';
  }
  function tgtArt(code, p) { return '<span class="glyimg">' + tgtSvg(code, p) + '</span>'; }

  /* The INPUT side. Always the pad in your hands (ZSG reads that from the
     device enumerated on the board, never from the config's platform). */
  /* mapping/labels.py: REGION_SOURCE_PREFIX + a non-empty body. */
  var REGION_PREFIX = 'region:';
  function isRegionSource(code) {
    var c = String(code == null ? '' : code);
    return c.indexOf(REGION_PREFIX) === 0 && c.length > REGION_PREFIX.length;
  }
  /* "region:weapon=sniper" -> "Screen: weapon is sniper" — the same sentence
     labels.py's _pretty_region builds, so the app and the board read alike. */
  function regionName(code) {
    var body = String(code).slice(REGION_PREFIX.length);
    var eq = body.indexOf('='), id = body, val = '';
    if (eq >= 0) { id = body.slice(0, eq); val = body.slice(eq + 1); }
    id = id.replace(/[_-]/g, ' ').replace(/^\s+|\s+$/g, '');
    val = val.replace(/^\s+|\s+$/g, '');
    if (!val) return 'Screen: ' + (id || 'an area');
    return 'Screen: ' + id + ' is ' + val;
  }

  function srcName(code) {
    var c = String(code || '');
    if (isRegionSource(c)) return regionName(c);
    if (MOUSE_NAME[c]) return MOUSE_NAME[c];
    if (KEY_NAME[c]) return KEY_NAME[c];
    if (c.indexOf('KEY_') === 0) {
      var k = c.slice(4);
      return k.length === 1 ? k + ' key' : (k.charAt(0) + k.slice(1).toLowerCase() + ' key');
    }
    var low = c.toLowerCase();
    if (low === 'lt' || low === 'rt') return padName(low) + ' pulled';
    return padName(c);
  }
  function padName(code) {
    var Z = window.ZSG;
    if (Z) return Z.label(code);       /* no family: whatever is in your hands */
    /* Without ZSG there is nothing to read the plugged-in pad from, so the
       fallback names the pad this product ships against — a DualSense. An
       unrecognised code surfaces as it arrived rather than lower-cased, so a
       bad binding is visible instead of looking like a control we know. */
    var c = String(code || '').toLowerCase().replace(/^btn_/, '');
    var nm = fallbackName(c, 'ps');
    return nm === c ? String(code) : nm;
  }
  /* The name a 4-up picker TILE shows. 'D-pad Down' truncates to 'D-pad D…'
     in the .pkgrid, leaving two tiles told apart only by which segment of
     the glyph is lit — colour/shape alone, which this app never allows. The
     D-pad glyph drawn above the label already says "D-pad", so the tile
     shows just the direction; aria-label and title keep the full padName,
     so a screen reader still hears "D-pad Down". Everywhere else (toasts,
     sentences, rows) keeps the full name — this is display-width only. */
  var DPAD_TILE = {
    dpad_up: 'Up', dpad_down: 'Down', dpad_left: 'Left', dpad_right: 'Right'
  };
  function tileName(code) {
    var c = String(code || '').toLowerCase().replace(/^btn_/, '');
    return has(DPAD_TILE, c) ? DPAD_TILE[c] : padName(code);
  }
  function srcArt(code) {
    var c = String(code || ''), key = null;
