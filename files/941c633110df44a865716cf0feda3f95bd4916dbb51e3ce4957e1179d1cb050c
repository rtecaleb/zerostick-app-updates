  /* when the whole thing ends, in the new meaning */
  function timelineEnd(steps) {
    var t = 0, end = 0;
    for (var i = 0; i < steps.length; i++) {
      var s = steps[i], nx = steps[i + 1];
      if (timedPress(s)) {
