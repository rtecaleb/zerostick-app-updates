    for (var i = 0; i + 1 < steps.length; i++) {
      if (timedPress(steps[i]) && steps[i + 1].k === 'wait') {
        var sum = Math.max(0, intOf(steps[i + 1].ms, 0) + intOf(steps[i].ms, 0));
        /* past one step's cap, the rest is a second wait (audit m19): it
           used to be clamped, so loading and re-saving an old action
           shortened its pause by up to 10 s */
        if (sum > STEP_MS_CAP) {
          steps[i + 1] = { k: 'wait', ms: STEP_MS_CAP };
          steps.splice(i + 2, 0, { k: 'wait', ms: Math.min(sum - STEP_MS_CAP, STEP_MS_CAP) });
          i++;
