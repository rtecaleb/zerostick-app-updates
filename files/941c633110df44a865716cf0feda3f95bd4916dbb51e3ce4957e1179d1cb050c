  /* the authored timeline -> steps the engine runs one at a time */
  function compileSteps(steps) {
    if (!overlapsIn(steps)) return oldForm(steps);
    var ev = [], t = 0, seq = 0, i;
    for (i = 0; i < steps.length; i++) {
      var s = steps[i], nx = steps[i + 1];
      if (timedPress(s)) {
        var hold = s.k === 'trig' ? { k: 'trig', t: s.t.slice(), ms: 120, keep: true } : { k: 'hold', t: s.t.slice() };
        /* gen: made here from a timed press, so counted per control below */
        ev.push({ at: t, o: seq++, s: hold, d: 0, gen: true });
        ev.push({ at: t + intOf(s.ms, 0), o: seq++, s: { k: 'release', t: s.t.slice() }, d: 0, gen: true });
        if (!(nx && nx.k === 'wait')) t += intOf(s.ms, 0);
      } else if (s.k === 'wait') {
        t += intOf(s.ms, 0);
      } else {
        var d = stepLen(s);
