  /* ══ the board's step JSON, in both directions ════════════════════ */

  /* Every emitted step carries exactly ONE discriminator key — steps.py
     dispatches press → hold → aim → release → wait → sensitivity →
     swapSticks → loadConfig, so a step with two keys silently loses one. */
  function emitStep(s) {
    if (!s) return null;
    /* ms is floored at 1, never 0 — steps.py reads press+ms:0 as a hold */
    if (s.k === 'tap') return { press: s.t.slice(), ms: clamp(intOf(s.ms, 80), TAP_MS_MIN, STEP_MS_CAP) };
    /* never emit ms on a hold: steps.py ignores it, so storing one is a lie */
    if (s.k === 'hold') return { hold: s.t.slice() };
    if (s.k === 'release') return { release: s.t.slice() };
    if (s.k === 'wait') return { wait: clamp(intOf(s.ms, 0), 0, STEP_MS_CAP) };
    if (s.k === 'stick') {
      var aimJ = {
        angle: ((intOf(s.angle, 0) % 360) + 360) % 360,
        magnitude: clamp(Math.round(num(s.dist, 0) * 100) / 100, 0, 1),
        stick: s.stick === 'left' ? 'left' : 'right'
      };
      /* D189: the turn rate rides beside the stick-% fallback */
      if (aimJ.stick === 'right' && num(s.dps, 0) > 0) aimJ.dps = clamp(num(s.dps, 0), DPS_MIN, DPS_MAX);
      return { aim: aimJ, ms: clamp(intOf(s.ms, 0), 0, STEP_MS_CAP) };
    }
    if (s.k === 'trig') return s.keep
      ? { hold: s.t.slice() }
      : { press: s.t.slice(), ms: clamp(intOf(s.ms, 120), TAP_MS_MIN, STEP_MS_CAP) };
    if (s.k === 'sens') return {
      sensitivity: {
        which: s.which === 'left' ? 'left' : s.which === 'right' ? 'right' : 'aim',
        scale: clamp(Math.round(num(s.scale, 1) * 100) / 100, 0, 3),
        axis: (s.axis === 'x' || s.axis === 'y') ? s.axis : 'both'
      }, ms: clamp(intOf(s.ms, 0), 0, STEP_MS_CAP)
    };
    /* never emit swapSticks:false — steps.py emits no step at all for it,
       which silently shortens the sequence */
    if (s.k === 'swap') return { swapSticks: true, ms: clamp(intOf(s.ms, 0), 0, STEP_MS_CAP) };
    if (s.k === 'config') return { loadConfig: s.to };
    /* D170 */
    if (s.k === 'move') return { move: [moveCount(s.dx), moveCount(s.dy)], ms: clamp(intOf(s.ms, 0), 0, STEP_MS_CAP) };
    /* D280: only the tuning that is set travels; {} is the Core's defaults.
       ms 0 always: it holds until the action ends (the button is let go) */
    if (s.k === 'tassist') {
      var ta = {};
      if (intOf(s.gap, 0) > 0) ta.gapMs = clamp(intOf(s.gap, 0), 0, TA_GAP_MAX);
      if (intOf(s.floor, 0) > 0) ta.minSpeed = clamp(intOf(s.floor, 0), 0, TA_FLOOR_MAX);
      return { turnAssist: ta, ms: 0 };
    }
    if (s.k === 'unknown') return clone(s.raw);
    return null;
