        return isTrigTargets(pt) ? { k: 'trig', t: pt, ms: 120, keep: true } : { k: 'hold', t: pt };
      }
      return isTrigTargets(pt)
        ? { k: 'trig', t: pt, ms: clamp(intOf(st.ms, 80), 1, STEP_MS_CAP), keep: false }
        : { k: 'tap', t: pt, ms: clamp(intOf(st.ms, 80), 1, STEP_MS_CAP) };
