    return steps;
  }
  function stepLen(s) {
    if (!s) return 0;
    if (s.k === 'tap' || s.k === 'wait' || s.k === 'stick' || s.k === 'sens' || s.k === 'swap' || s.k === 'move') return intOf(s.ms, 0);
    if (s.k === 'trig') return s.keep ? 0 : intOf(s.ms, 0);
    if (s.k === 'unknown' && s.raw) return intOf(s.raw.ms != null ? s.raw.ms : s.raw.wait, 0);
