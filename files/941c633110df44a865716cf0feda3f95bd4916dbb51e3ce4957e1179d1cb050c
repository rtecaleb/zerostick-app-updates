    var end = t, out = [], cur = 0, late = 1e9, held = {};
    ev.forEach(function (e) { end = Math.max(end, e.at); });
    function sortEv() { ev.sort(function (x, y) { return x.at - y.at || x.o - y.o; }); }
    /* one engine step waits at most STEP_MS_CAP (emitStep clamps), so a
       longer gap is several (audit m17: a long pause came out shortened) */
    function pushWait(ms) {
      while (ms > 0) { var w = Math.min(ms, STEP_MS_CAP); out.push({ k: 'wait', ms: w }); ms -= w; }
    }
    sortEv();
    while (ev.length) {
      var e = ev.shift();
      var st = clone(e.s);
      if (e.gen) {
        /* TWO PRESSES OF ONE CONTROL that overlap (audit m17): the first
           one's release used to let go while the second still held it. A
           control is held from its first press to its LAST press's end:
           counted per control, only the first hold and the last release
           are sent. */
        st.t = e.s.t.filter(function (x) {
          var n = held[x] || 0;
          if (e.s.k === 'release') { held[x] = Math.max(0, n - 1); return n <= 1; }
          held[x] = n + 1;
          return n === 0;
