    if (d) { for (i = 0; i < SLOTS; i++) { if (d.slots[i]) { n++; } } }
    if (!n) { return 'Paste a script, use its menu'; }
    return n + (n === 1 ? ' script' : ' scripts') + ' · ' + (d.slot ? 'slot ' + d.slot + ' loaded' : 'off');
  }

  if (typeof window.addEventListener === 'function') {
    window.addEventListener('resize', function () { if (onScreen()) { sizeCanvas(); } });
  }
  /* the app put away and brought back: the loop stopped itself while hidden,
     so it starts again here */
  if (typeof document.addEventListener === 'function') {
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && onScreen()) { S.drawnKey = ''; startLoop(); }
    });
  }
  injectCss();

  /* The engine compiles asynchronously (gpc.wasm). When it is there, every
     slot is checked again and the loaded one starts; if it cannot run, the
     room says why. */
  if (engine() && typeof engine().whenReady === 'function') {
    engine().whenReady(function () {
      S.results = [];
      var box = $('gpc-engine');
      if (box) { box.innerHTML = engineHTML(); }
      if (!S.data) { return; }
      if (!S.sim) { startSim(); }
      pushSlots();
      S.drawnKey = '';
      paintAll();
      paintSheet();
    });
  }

  /* D215: the switch changed (in Legacy Devices): Live follows it */
  if (window.ZSMODES) {
    window.ZSMODES.onChange(function () {
      if (!ROOT || document.getElementById('gpc') !== ROOT) { return; }
      if (deviceOff() && liveOn()) { liveLeave(); S.live = { ok: false, reason: GPC_OFF, detach: function () {} }; }
      else if (!deviceOff() && S.mode === 'live' && CORE.ready && !liveOn()) { attachLive(); }
      paintAll();
    });
  }

  if (!window.RENDERERS) { window.RENDERERS = {}; }
  window.RENDERERS.gpc = render;

  window.gpcLive = gpcLive;
  window.ZSGPC = {
    hint: hint,
    live: gpcLive,
    /* the pieces the tests (tools/test-gpc-tab.js) check on their own */
    pixel: pixel,
    gapFor: gapFor,
    looksLikeText: looksLikeText,
    colonFix: colonFix,
    looseFix: looseFix,
    applyFix: applyFix,
    mapGamepad: mapGamepad,
    readData: readData,
    device: function () { return S.dev; },
    verdict: function (n) { return verdict(resultOf(n || S.data.slot)); },
    state: function () {
      var d = S.dev;
      return { pid: S.pid, slot: S.data ? S.data.slot : 0, mode: S.mode, running: !!S.loop, sim: !!S.sim,
               fault: S.fault, draws: S.draws, drawnKey: S.drawnKey, scale: S.scale, inits: S.inits,
               pad: S.pad ? S.pad.id : null, sheet: S.sheet,
               menu: d && d.menu ? d.menu.page : null, pairing: !!(d && d.pairing), bright: d ? d.bright : 0,
               live: { on: liveOn(), slot: LV.slot, state: LV.state, menuSent: LV.menuSent, note: LV.note },
               texts: S.data ? S.data.slots.map(function (s) { return s ? s.text : null; }) : [] };
    },
