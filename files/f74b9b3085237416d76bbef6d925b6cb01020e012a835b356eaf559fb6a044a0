  function paintAll() {
    if (!ROOT) { return; }
    var list = $('gpc-slotlist');
    if (list) { list.innerHTML = slotsHTML(); wireSlots(list); }
    paintMode();
    paintStatus();
    paintFault();
    paintSend();
  }
  function paintMode() {
    if (!ROOT) { return; }
    var seg = $('gpc-mode');
    if (seg) {
