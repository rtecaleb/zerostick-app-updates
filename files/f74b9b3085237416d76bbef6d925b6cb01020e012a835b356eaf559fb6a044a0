    var clr = $('gpc-clear');
    if (clr) {
      clr.addEventListener('click', function () {
        if (!S.clearArmed) {
          clr.textContent = 'Tap again to clear it';
          S.clearArmed = setTimeout(function () { S.clearArmed = null; clr.textContent = 'Clear this slot'; }, 4000);
