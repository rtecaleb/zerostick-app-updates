  /* the engine cannot run on this phone (no WebAssembly, or the file did
     not load): one plain sentence, and the rest of the room still works */
  function engineHTML() {
    var d = engineDown();
    return d ? '<p class="note warn" id="gpc-enginenote" role="alert">' + esc(d) + '</p>' : '';
  }

  /* the lines around the one the checker named, that line marked by more
     than colour: a ▸ stands beside its number */
  function excerptHTML(text, err) {
    var lines = String(text).split(/\r\n|\n|\r/), n = err.line, from = Math.max(1, n - 2),
      to = Math.min(lines.length, n + 2), h = '', i, L, c;
    for (i = from; i <= to; i++) {
      L = (lines[i - 1] || '').replace(/\t/g, '  ');
      if (L.length > 160) { L = L.slice(0, 157) + '...'; }
      if (i === n) {
        c = err.col >= 1 ? err.col - 1 : -1;
        if (c >= 0 && c < L.length && (lines[i - 1] || '').indexOf('\t') < 0) {
          L = esc(L.slice(0, c)) + '<mark class="gpc-at">' + esc(L.charAt(c)) + '</mark>' + esc(L.slice(c + 1));
        } else { L = esc(L); }
        h += '<div class="gpc-ln gpc-bad" data-line="' + i + '" aria-current="true"><span class="gpc-no">▸ ' + i +
          '</span><code>' + (L || ' ') + '</code></div>';
      } else {
        h += '<div class="gpc-ln" data-line="' + i + '"><span class="gpc-no">' + i + '</span><code>' + (esc(L) || ' ') + '</code></div>';
      }
    }
    return '<div class="gpc-code" role="group" aria-label="The script around line ' + n + '">' + h + '</div>';
  }
  function lowerFirst(s) { return /^[A-Z][a-z]/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s; }
  function names(fs, v) {
    var out = [];
    for (var i = 0; i < fs.length; i++) { if (fs[i].verdict === v) { out.push(lowerFirst(fs[i].feature)); } }
    return out.join(', ');
  }
  function reportHTML(text, r) {
    var v = verdict(r), h, i, f;
    if (v === 'none') { return ''; }
    if (v === 'pending') { return '<div class="gpc-card" id="gpc-checking" role="status"><b>Checking the script…</b></div>'; }
    if (v === 'down') {
      return '<div class="gpc-card gpc-cannot" id="gpc-down" role="alert"><b>This phone can’t check scripts.</b>' +
        '<span class="gpc-sub">' + esc(r.error ? r.error.msg : engineDown()) + '</span></div>';
    }
    if (v === 'error') {
      var e = r.error, fix = colonFix(text, e);
      h = '<div class="gpc-card gpc-error" id="gpc-err" role="alert">' +
        '<div class="gpc-vt"><span class="gpc-vi" aria-hidden="true">!</span><b>Line ' + e.line + ' needs a fix</b></div>' +
        '<p class="gpc-msg">The checker says: ' + esc(e.msg) + '.</p>' +
        excerptHTML(text, e);
      if (fix) {
        h += '<div class="gpc-fix" id="gpc-fixbox"><p>It looks like a <b>:</b> was typed where a <b>;</b> belongs, ' +
          'on line ' + fix.line + '.</p>' +
          '<button type="button" class="btn primary" id="gpc-fixbtn" data-line="' + fix.line + '">Change it to ; on line ' + fix.line + '</button>' +
          '<span class="gpc-sub">Only line ' + fix.line + ' changes, and nothing changes until you tap.</span></div>';
      } else {
        h += '<span class="gpc-sub">Fix it in the script below, or in the place you copied it from, and paste it again.</span>';
      }
      return h + '</div>';
    }
    var head = v === 'runs' ? 'Runs'
      : v === 'differs' ? 'Runs, with differences: ' + names(r.features, 'differs')
      : 'Can’t run: needs ' + names(r.features, 'cannot');
    h = '<div class="gpc-card gpc-' + v + '" id="gpc-verdict" role="status">' +
      '<div class="gpc-vt"><span class="gpc-vi" aria-hidden="true">' + (v === 'runs' ? '✓' : v === 'differs' ? '≈' : '✕') +
      '</span><b id="gpc-head">' + esc(head) + '</b></div>';
    if (v === 'cannot') {
      h += '<span class="gpc-sub">The Core cannot give this script what it needs, so it is not run here either.</span>';
    }
    if (r.loose && r.loose.length) {
      var lf = looseFix(text, r);
      h += '<div class="gpc-fix" id="gpc-loose"><p>It runs as it is. The checker read ' +
        (r.loose.length === 1 ? 'one thing' : r.loose.length + ' things') + ' written loosely:</p><ul class="gpc-feats">';
      for (i = 0; i < r.loose.length; i++) {
        h += '<li class="v-differs"><i>Line ' + r.loose[i].line + '</i><span>' + esc(r.loose[i].msg) + '</span></li>';
      }
      h += '</ul>';
      if (lf) {
        h += '<div id="gpc-fixbox"><button type="button" class="btn" id="gpc-fixbtn" data-line="' + lf.line +
          '">Change it to ; on line ' + lf.line + '</button>' +
          '<span class="gpc-sub">Optional: other tools may want it written the usual way. Only line ' + lf.line +
          ' changes, and nothing changes until you tap.</span></div>';
      }
      h += '</div>';
    }
    if (r.features.length) {
      h += '<ul class="gpc-feats">';
      for (i = 0; i < r.features.length; i++) {
        f = r.features[i];
        h += '<li class="v-' + f.verdict + '"><i>' + (f.verdict === 'runs' ? 'Runs' : f.verdict === 'differs' ? 'Differs' : 'Can’t run') +
          '</i><b>' + esc(f.feature) + '</b>' + (f.reason ? '<span>' + esc(f.reason) + '</span>' : '') + '</li>';
      }
      h += '</ul>';
    }
    return h + '</div>';
  }
  function rowWord(n) {
    var s = slotOf(n), r, v;
    if (!s) { return 'Tap to paste a script'; }
    r = resultOf(n); v = verdict(r);
    if (v === 'pending') { return 'Checking…'; }
    if (v === 'down') { return 'Can’t check on this phone'; }
    if (v === 'error') { return 'Needs a fix: line ' + r.error.line; }
    if (v === 'cannot') { return 'Can’t run'; }
    if (n === S.data.slot && (S.fault || S.simErr)) { return 'Stopped · press Reset'; }
    return v === 'differs' ? 'Runs, with differences' : 'Runs';
  }
  function slotsHTML() {
    var h = '', n, s, cur;
    for (n = 1; n <= SLOTS; n++) {
      s = slotOf(n); cur = n === S.data.slot;
      h += '<button type="button" class="gpc-slot' + (s ? '' : ' gpc-empty') + '" data-slot="' + n + '"' +
        (cur ? ' aria-current="true"' : '') + ' aria-label="Slot ' + n + ': ' + esc(s ? nameOf(s, n) : 'empty') + '. ' +
        esc(rowWord(n)) + (cur ? '. Loaded' : '') + '. Open">' +
        '<span class="gpc-sn" aria-hidden="true">' + n + '</span>' +
        '<span class="gpc-st" aria-hidden="true"><b>' + esc(s ? nameOf(s, n) : 'Empty') + '</b><span>' + esc(rowWord(n)) + '</span></span>' +
        '<span class="gpc-tag" aria-hidden="true">' + (cur ? 'Loaded' : '') + '</span>' +
        '<span class="chev" aria-hidden="true">›</span></button>';
    }
    return h;
  }

