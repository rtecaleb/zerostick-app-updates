      seg.querySelectorAll('button').forEach(function (b) {
        b.addEventListener('click', function () { setMode(b.getAttribute('data-mode')); });
      });
    }
    var send = $('gpc-send');
    if (send) { send.addEventListener('click', sendToCore); }
    wireKeys();
    probeCore();
  }

  /* ═══════════════════════════════════════════ the door and back ══ */
  function render(p) {
    injectCss();
    if (p && p.id !== S.pid) {
      /* another config: its own slots, a fresh device */
      stopLoop();
      liveLeave();
      S.pid = p.id;
      S.data = readData(p.id);
      S.results = [];
      S.sim = null; S.fault = null; S.simErr = ''; S.mode = 'preview'; S.live = null; S.spvSaved = '';
      S.fam = (p.platform === 'xbox' || p.platform === 'x360') ? 'xbox' : 'ps';   /* D349: a 360 config draws Xbox glyphs */
