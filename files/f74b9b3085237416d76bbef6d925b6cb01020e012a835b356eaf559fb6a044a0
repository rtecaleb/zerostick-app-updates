      ROOT = body.querySelector('#gpc');
      wire();
      paintAll();
      applyBright();
      sizeCanvas();
      /* openDetail() marks the screen open only AFTER this hook returns, and
         the loop refuses to run on a closed screen, so it starts a moment
         later */
      setTimeout(function () { if (ROOT === body.querySelector('#gpc')) { startLoop(); } }, 0);
    } };
