  /* ═════════════════════════════════════════════════════ wiring ══ */
  function wireSlots(list) {
    list.querySelectorAll('[data-slot]').forEach(function (b) {
      b.addEventListener('click', function () { openSheet(Number(b.getAttribute('data-slot'))); });
    });
  }
  function wire() {
