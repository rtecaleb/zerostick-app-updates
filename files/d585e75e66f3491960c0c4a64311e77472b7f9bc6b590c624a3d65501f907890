  /* Take the owner to the teach card: the Tune tab, and the area that
     already holds this game's items of the SAME kind when there is one (an
     operator's badge and a gun are two areas, D125; a single-kind game has
     one kind, so any item's area, as before). Only taps a person could
     make, so a Screen Assist change that renames a control makes this do
     less, never something else. */
  function steer(p) {
    var tries = 0;
    function go() {
      tries++;
      var body = document.getElementById('dbody');
      var ask = askFor(p);
      if (!body || !ask) { return; }
      var tune = body.querySelector('#cvtabs button[data-pg="Tune"]');
      if (tune && tries === 1) { tune.click(); }
      var full = ZS.live.full[p.id] || {};
      var st = stateOf(p), cat = st.cat && st.cat.data;
