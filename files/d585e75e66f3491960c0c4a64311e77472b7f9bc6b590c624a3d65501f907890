      if (area >= 0) {
        var row = body.querySelector('#cv-boxlist [data-cvedit="' + area + '"]');
        if (row) {
          row.click();
          /* the teach card is below the kind picker in that sheet: bring
             it, with the weapon's name already in it, into view */
          setTimeout(function () {
