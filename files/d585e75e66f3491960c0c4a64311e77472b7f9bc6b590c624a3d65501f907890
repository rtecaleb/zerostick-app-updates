      var a = actionIn(doc, id);
      if (!a || !cat) { return; }
      var home = a.auto.item;
      did = unlinkGun(a, cat, gun);
      if (did && a.auto.item !== home) { moved = a.auto.item; }
      left = did ? gunsOf(a, cat).length : 0;
    }, function () {
      if (!did) { return; }
      if (window.ZS_SMART && ZS_SMART.refreshRooms) { ZS_SMART.refreshRooms(p.id, [id]); }
