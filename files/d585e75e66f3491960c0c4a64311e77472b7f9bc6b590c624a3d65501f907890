  /* Untrain: the picture goes, the item's AI Scripts stay and stop
     running (an untaught item's actions are never sent). A parked copy of
     it goes too, so switching its kind back on cannot bring it back. */
  function forget(p, itemId) {
    if (!ZS.live.full[p.id]) { ZS.toast('Connect your Core first'); return; }
    ZS.putProfile(p.id, function (doc) {
      function drop(r) {
        var list = templatesOf(r);
        for (var i = list.length - 1; i >= 0; i--) {
          if (isObj(list[i]) && list[i].item === itemId) { list.splice(i, 1); }
        }
      }
      arr(doc.vision && doc.vision.regions).forEach(drop);
      parkedOf(doc).forEach(function (e) { if (isObj(e) && isObj(e.region)) { drop(e.region); } });
      retie(doc);
    }).then(function (j) {
      if (j && j.ok) {
        dropCrop(p.id, itemId);
        ZS.toast('Forgotten. Its Scripts are kept and will not run until you teach it again.', { ms: 6000 });
      }
      redrawIfOpen();
    });
  }

  /* ═══════════ D134: a gun's rarities, and one Smart Action on many guns ══
     docs/AUTO-ACTIONS-LINKING.md section 3. Everything below reads the
     config document (ZS.live.full) and writes it through ZS.putProfile,
     with retie() inside the same write, like every other write this tab
     makes. Nothing here is capped: the Core's storage is the only limit
     (D135, D136), and a copy that would not fit it says so. */

  function docOf(p) { return (ZS.live && ZS.live.full && ZS.live.full[p.id]) || null; }
  function catOf(p) { var st = stateOf(p); return (st.cat && st.cat.state === 'ready') ? st.cat.data : null; }
  /* What one of an action's guns is called: a Warzone weapon is a "gun" on
     its page ("Teach the Core this gun"); a two-kind game's items are their
     kind's noun (D125: an operator, a mode). */
  function gunNoun(cat, id) {
    if (!cat || !cat.multi) { return 'gun'; }
    var e = cat.byId[id];
    return e ? nounOf(e.kind) : 'gun';
  }
  function gunNouns(cat, id) { var n = gunNoun(cat, id); return n === 'hero' ? 'heroes' : n + 's'; }
  /* "the M15 Mod 0", but "Ash": a weapon takes the article, a person not */
  function theName(cat, id) {
    var e = cat && cat.byId[id], n = gunNoun(cat, id);
    if (!e) { return id; }
    return (n === 'gun' || n === 'weapon' ? 'the ' : '') + e.item.name;
  }
  function plural(n, one, many) { return n + ' ' + (n === 1 ? one : many); }
  /* "Assault Rifles" is "every Assault Rifle" */
  function singular(name) {
    var s = trim(name);
    return /ss$/i.test(s) ? s : s.replace(/s$/, '');
  }
  function andList(names) {
    return names.length < 2 ? names.join('') : names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];
  }
  /* The guns a pair's lead carries (D125: Ash's loadout, a mode's pool), as
     a set, or null. A pair's link is read inside it (section 7). */
  function poolOf(cat, leadId) {
    var e = (cat && leadId && has(cat.byId, leadId)) ? cat.byId[leadId] : null;
    if (!e) { return null; }
    var out = {};
    loadoutOf(cat, e.item).forEach(function (l) { l.items.forEach(function (x) { out[x.item.id] = true; }); });
    return out;
  }
  /* The guns an action runs on: its link, and for a pair only the guns its
     lead carries */
  function gunsOf(a, cat) {
    var ids = reachOf(a, cat).ids, pool = withOf(a) ? poolOf(cat, withOf(a)) : null;
    return pool ? ids.filter(function (id) { return pool[id] || id === a.auto.item; }) : ids;
  }
  /* The link in words: "every SMG and the M15 Mod 0, less the VMP" */
  function ruleWords(a, cat) {
    var lk = linkOf(a) || {}, parts = [], noun = gunNoun(cat, a.auto.item);
    function name(id) { return (cat && has(cat.byId, id)) ? theName(cat, id) : ''; }
    function some(list) { return list.length > 3 ? list.slice(0, 3).concat([(list.length - 3) + ' more']) : list; }
    if (lk.every === true) {
      parts.push(withOf(a) ? 'every ' + noun + ' ' + name(withOf(a)) + ' carries' : 'every ' + noun);
    } else {
      idList(lk.classes).forEach(function (gid) {
        var g = groupById(cat, gid);
        if (g) { parts.push('every ' + singular(g.g.name)); }
      });
    }
    parts = parts.concat(some(idList(lk.items).filter(function (id) { return !ruleCovers(a, cat, id); })
      .map(name).filter(function (s) { return !!s; })));
    var ex = idList(lk.except).map(name).filter(function (s) { return !!s; });
    return andList(parts) + (ex.length ? ', less ' + andList(some(ex)) : '');
  }
  /* "SINCE THE OWNER LAST LOOKED" (section 2): a rule's size is kept per
     game in the app's store, and a change is said, for the rest of this
     session, on the card of every action that uses that rule. */
  var SEEN_NOW = {};
  function newCounts(cat, a) {
    var lk = linkOf(a), pack = a.auto.pack, e = cat && cat.byId[a.auto.item];
    if (!lk || !e || typeof pack !== 'string' || !ZS.store) { return ''; }
    var key = 'aaseen|' + pack, seen = isObj(ZS.store.vals[key]) ? ZS.store.vals[key] : {}, out = [], wrote = false;
    function look(k, label, n) {
      var sk = pack + '|' + k;
      if (typeof seen[k] === 'number' && seen[k] !== n) {
        SEEN_NOW[sk] = label + ': now ' + plural(n, gunNoun(cat, a.auto.item), gunNouns(cat, a.auto.item)) + '.';
      }
      if (seen[k] !== n) { seen[k] = n; wrote = true; }
      if (SEEN_NOW[sk]) { out.push(SEEN_NOW[sk]); }
    }
    idList(lk.classes).forEach(function (gid) {
      var g = groupById(cat, gid);
      if (g) { look(gid, 'Every ' + singular(g.g.name), g.g.items.length); }
    });
    if (lk.every === true) {
      var n = 0;
      e.kind.groups.forEach(function (g) { n += g.items.length; });
      look('*' + e.kind.kind, 'Every ' + gunNoun(cat, a.auto.item), n);
