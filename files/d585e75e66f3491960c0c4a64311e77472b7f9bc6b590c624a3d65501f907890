       own, in the carried kind's groups, vaulted ones too. A search opens
       it onto its matches, exactly as it opens the Legacy fold. */
    var h = '', all = allName(cat);
    if (all) {
      var ck = cat.carried;
      var inAll = draw(ck.groups, ck);
      var allHits = shown;
      if (!q || allHits) {
        var every = 0, rest = 0;
        ck.groups.forEach(function (g) {
          every += g.items.length;
          g.items.forEach(function (it) { if (!carriersOf(cat, it.id).length) { rest++; } });
        });
        var allOpen = q ? true : !!ui.all;
        h += '<div class="acc aa-all aa-legacy' + (allOpen ? ' open' : '') + '" id="aa-all">' +
          '<div class="ah" role="button" tabindex="0"><span class="aa-code" aria-hidden="true">ALL</span>' +
            '<span class="aa-lgt"><span class="aa-clsname">' + esc(all) + '</span>' +
            '<span class="aa-lgsub">' + esc('Every known ' + nounOf(ck) + ', ' + rest + ' of them vaulted. ' +
              'What you set here runs in every ' + nounOf(cat.lead) + '.') + '</span></span>' +
            '<span class="aa-clscount">' + esc(q ? countWord(allHits, 'match', 'matches')
              : countWord(every, nounOf(ck), nounsOf(ck))) + '</span>' +
            '<span class="chev">›</span></div>' +
          '<div class="ab">' + inAll + '</div></div>';
      }
    }
    h += draw(now);
    if (old.length) {
