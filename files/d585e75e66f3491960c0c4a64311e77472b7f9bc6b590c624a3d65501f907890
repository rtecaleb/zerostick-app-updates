  }
  var OUT_SEEN = '';
  function gunOutHTML(cat) {
    var it = gunOutItem(cat);
    OUT_SEEN = it ? it.id : '';
    if (!it) { return ''; }
    return '<button type="button" class="aa-outnow" id="aa-outnow" data-aagun="' + esc(it.id) + '" aria-label="' +
      esc('The gun out now: ' + it.name + '. Open its scripts.') + '">' +
      '<span class="aa-outdot" aria-hidden="true"></span><span class="aa-outtxt"><em>Gun out now</em><b>' + esc(it.name) +
      '</b></span><span class="aa-outgo" aria-hidden="true">›</span></button>';
  }

  function listHTML(p) {
    var st = stateOf(p);
    var cat = (st.cat && st.cat.state === 'ready') ? st.cat.data : null;
    var multi = !!(cat && cat.multi);
    var all = allName(cat);
    /* a game with two kinds says both (D125), and one whose guns stand on
       their own says the two ways in (D126); every other game keeps the
       line as decided */
    /* D405: "Add quick scripts to guns", right under the Gun reader frame,
       once there is a weapon list and a Core to write to (gun-bulk.js) */
    var bulkReady = !!(cat && st.full && !st.scratch && window.ZSGUNBULK);
    var h = gunOutHTML(cat) + frameDoorHTML() + '<p class="aa-lead">' + esc(all
      ? 'Scripts that switch on by themselves when the Core sees your ' + nounOf(cat.carried) +
        ': in every ' + nounOf(cat.lead) + ' from ' + all + ', or only in one ' + nounOf(cat.lead) +
        ' from that ' + nounOf(cat.lead) + '’s page.'
      : multi
      ? 'Scripts that switch on by themselves when the Core sees your ' + nounOf(cat.lead) +
        (cat.carried ? ', and the ' + nounOf(cat.carried) + ' they have out' : '') + '.'
      : LEAD) + '</p>';
    if (st.scratch) {
      return h + emptyHTML('AI Scripts are not built for configs started from scratch yet',
        'They need a game, because the Core has to know which weapons to look for. ' +
        'A config made from a game pack gets them when that game’s weapons are listed.');
    }
    if (!st.pack && window.ZSPACKS && ZSPACKS.state() === 'loading') {
      /* the game packs are still arriving; "not built" now would be a guess */
      return h + '<div class="note" id="aa-loading">Loading your games…</div>';
    }
    if (!st.pack) {
      return h + emptyHTML('AI Scripts for ' + (st.game || 'this game') + ' are not built yet',
        'They are built one game at a time, starting with Call of Duty: Warzone.');
    }
    if (!st.cat || st.cat.state === 'loading') {
      loadCatalog(st.pack.id);
      return h + '<div class="note" id="aa-loading">Loading the weapons for ' + esc(st.game) + '…</div>';
    }
    if (st.cat.state === 'none') {
      return h + emptyHTML('AI Scripts for ' + st.game + ' are not built yet',
        'They are built one game at a time. When ' + esc(st.game) + '’s weapons are listed, ' +
        'they appear here.');
    }
    if (st.cat.state === 'failed') {
      return h + emptyHTML('AI Scripts for ' + st.game + ' could not be read',
        esc(st.cat.problems[0] || 'The weapon list is damaged.'));
    }
    if (!st.full) {
      return h + emptyHTML('Your Core is not connected',
        'Connect it and this config’s AI Scripts appear here.');
    }
    var vis = visionLine(p);
