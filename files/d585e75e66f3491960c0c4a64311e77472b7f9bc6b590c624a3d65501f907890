    }
    return { html: html, say: say.join(' ') };
  }

  /* ── the rarity strip (section 3, "On a gun's page") ── */

  /* rarities are a gun's (Warzone's weapons); an operator or a mode has none */
  function tiersShown(cat, f) {
    return !!(cat && cat.tiers && cat.tiers.length && f && (!cat.multi || f.kind === cat.carried));
  }
  function viewKey(item, opId) { return (opId ? opId + '+' : '') + item; }
  /* which rarity the page shows: '' is Any rarity, the default */
  function tierView(p, cat, f, opId) {
    if (!tiersShown(cat, f)) { return ''; }
    var t = (uiOf(p).tier || {})[viewKey(f.item.id, opId)] || '';
    return tierOf(cat, t) ? t : '';
  }
  function setView(p, item, opId, t) {
    var ui = uiOf(p);
    if (!ui.tier) { ui.tier = {}; }
    ui.tier[viewKey(item, opId)] = t || '';
  }
  /* What runs on this gun at each rarity, its own and linked: the chips'
     numbers */
  function viewCounts(doc, cat, item, opId) {
    var out = { '': 0 };
    arr(doc && doc.accessibilityActions).forEach(function (a) {
      if (!isAuto(a) || withOf(a) !== opId || !reachOf(a, cat).has[item]) { return; }
      var ts = tiersOf(a);
      if (!ts.length) { out[''] += 1; return; }
      ts.forEach(function (t) { out[t] = (out[t] || 0) + 1; });
    });
    return out;
  }
  function rarityHTML(p, st, f, opId, tier) {
    var cat = st.cat.data;
    if (!tiersShown(cat, f)) { return ''; }
    var n = viewCounts(st.full, cat, f.item.id, opId);
