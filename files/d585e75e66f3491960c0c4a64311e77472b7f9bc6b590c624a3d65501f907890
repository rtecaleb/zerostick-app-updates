     taken (it always fits the counts, which include a parked kind, but the
     bytes one config may be are the encoder's to judge) and then puts
     everything back. */
  function setKind(p, on) {
    var st = stateOf(p), cat = st.cat && st.cat.data, k = cat && cat.carried;
    var full = ZS.live.full[p.id];
    if (!k || !full) { ZS.toast('Connect your Core first'); redrawIfOpen(); return; }
    if (on && window.ZSPROFILE) {
      var why = '';
      try { why = firstRefusal(retie(unpark(JSON.parse(JSON.stringify(full)), k.kind))); } catch (e) { why = ''; }
      if (why) {
        ZS.toast('Your Core would not take the ' + nounsOf(k) + ' back as this config is: ' + why + '.', { ms: 8000 });
        redrawIfOpen();
        return;
      }
    }
    ZS.putProfile(p.id, function (doc) {
      if (on) { unpark(doc, k.kind); }
      else { park(doc, k.kind, function (id) { return kindOfItem(cat, id); }); }
      retie(doc);
    }).then(function (j) {
      if (j && j.ok) {
        ZS.toast(on ? capital(nounsOf(k)) + ' are recognised again: every ' + nounOf(k) + ' picture and its ' +
                      'Scripts are back on your Core.'
                    : capital(nounsOf(k)) + ' are switched off for this config. Nothing is deleted.', { ms: 6000 });
      }
      redrawIfOpen();
    });
  }

  /* THE GUN OUT NOW (the owner, 2026-10-20: "at the top of AI Scripts show
     the gun that's out, and make it clickable to bring you to that gun's
     settings"). From the Core's name reader (ZS.liveInput.weapon, the device
     bar's poll), matched to this game's weapon list by name or alias. */
  function gunOutItem(cat) {
    var w = ZS.liveInput && ZS.liveInput.weapon;
    if (!cat || !w || w.noWeapon || !w.active) { return null; }
    var want = norm(w.active), hit = null;
    arr(cat.kinds).forEach(function (k) {
      arr(k.groups).forEach(function (g) {
        arr(g.items).forEach(function (it) {
