  /* ════════════════════════════════════════════ the teach hand-off ══
     "Teach the Core this operator" (or legend, or mode) goes to Screen
     Assist's own screenshot, crop and teach flow (D110, D118), not to a copy
     of it. A GUN'S PAGE NO LONGER STARTS IT (the owner, 2026-09-25): guns are
     read by name now (readByName), and the per-player Gun reader frame
     (gun-frame.js) replaces a picture per gun. This is the note that
     travels there and back: which weapon, under which label. phone-sections.js
     asks for it in three places (the teach card's label, the picture it is
     about to save, and where to go afterwards). */
  var ASK = null;               /* { pid, item, name, label, group, kind, noun, back, at, done } */
  var ASK_MS = 10 * 60 * 1000;  /* an ask nobody finished does not outlive a coffee */
  var PENDING = {};             /* "pid|item" -> when a taught picture was handed over */

  function askFor(p) {
    if (!ASK || !p || ASK.pid !== p.id) { return null; }
    if (Date.now() - ASK.at > ASK_MS) { ASK = null; return null; }
    return ASK;
  }
  /* Screen Assist's teach card: what to prefill and say, or null. `say` is
     the card's sentence for a kind that is not a weapon (D125): an operator
     is recognised by his badge, and "hold it" means nothing for one. */
  function asking(p) {
    var a = askFor(p);
    if (!a) { return null; }
    var out = { item: a.item, name: a.name, label: a.label };
    if (a.noun === 'mode') {
      /* a mode has no icon of its own on screen (D126): what tells it apart
         is something only it shows for the whole match */
      out.say = 'Teaching <b>' + esc(a.name) + '</b> for AI Scripts. Start a ' + esc(a.name) +
        ' match and put the box round something on screen that only this mode shows for the whole ' +
        'match, then tap <b>Show it this one</b>.';
    } else if (a.noun && a.noun !== 'gun' && a.noun !== 'weapon') {
      out.say = 'Teaching <b>' + esc(a.name) + '</b> for AI Scripts. Play as ' + esc(a.name) +
        ' so the ' + esc(a.noun) + '’s icon is in the box, then tap <b>Show it this one</b>.';
    }
    return out;
  }
  /* Screen Assist has just cut the picture `t` for this config and is about
     to save its list. Make the picture this item's: its item, one picture per
     item, every picture in the list tied again (a gun becoming live gives
     each operator carrying it a pair to name, D125), and keep the owner's
     crop in the app. */
  function taught(p, t, ctx) {
    var a = askFor(p);
    if (!a || !t) { return; }
    ctx = ctx || {};
    t.item = a.item;
    /* one picture per item: a re-teach under another label replaces the
       old picture rather than leaving two that disagree */
    arr(ctx.regions).forEach(function (r) {
      var list = templatesOf(r);
      for (var i = list.length - 1; i >= 0; i--) {
