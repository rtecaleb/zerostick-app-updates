        '<button type="button" class="btn" id="aa-ed-sep">' + esc('Make a separate copy for this ' + noun) + '</button>' : '') +
      (tiersShown(cat, f) && !hasTiers(a) ? '<button type="button" class="btn" id="aa-ed-tier">Copy for one rarity…</button>' : '') +
      '</div>';
    if (hasTiers(a)) {
      var names = andList(tiersOf(a).map(function (t) { var x = tierOf(cat, t); return x ? x.name : t; }));
      h += '<p class="aa-edsay" id="aa-edtier">' + esc('Runs only while the ' + noun + ' is ' + names + '.' +
        (rarityReadable(docOf(p), cat) ? '' : ' Needs rarity detection: your Core cannot read rarity yet, so ' +
