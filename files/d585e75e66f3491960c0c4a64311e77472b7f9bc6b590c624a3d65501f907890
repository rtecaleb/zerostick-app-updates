     operator's, or the gun's page under an operator), which says "saving"
     until the config really carries the picture. True when this took over. */
  function afterTeach(p) {
    var a = askFor(p);
    if (!a || !a.done) { return false; }
    ASK = null;
    PENDING[cropKey(p.id, a.item)] = Date.now();
    openGun(p, a.item, a.back || '');
