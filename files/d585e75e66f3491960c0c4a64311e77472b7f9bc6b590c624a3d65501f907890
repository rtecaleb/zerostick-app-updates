  }
  /* A row's choices, as a sheet: Edit it where it lives (the default), and
     for one linked from another gun, Unlink from this gun and Make a
     separate copy for this gun. */
  function openAlso(p, f, opId, id) {
    var cat = catOf(p), a = actionIn(docOf(p), id);
    if (!cat || !a) { return; }
    var mine = a.auto.item === f.item.id;
    var T = tierOf(cat, homeTier(a, cat));
