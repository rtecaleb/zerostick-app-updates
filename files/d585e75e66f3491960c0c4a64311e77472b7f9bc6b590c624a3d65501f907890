    return o;
  }
  function openPicker(p, id, mode) {
    var st = stateOf(p), cat = st.cat && st.cat.data, a = actionIn(st.full, id);
    if (!cat || !a || !isAuto(a) || !has(cat.byId, a.auto.item)) { ZS.toast('Connect your Core first'); return; }
    var home = a.auto.item, w = withOf(a), link = mode === 'link';
    var noun = gunNoun(cat, home), nouns = gunNouns(cat, home);
    var lists = pickerLists(cat, a);
    var lk = link ? (linkOf(a) || {}) : {};
    var sel = { every: lk.every === true, classes: setOf(lk.classes), items: setOf(lk.items), except: setOf(lk.except) };
    var gOf = {}, all = [];
    lists.forEach(function (l) { l.items.forEach(function (it) { gOf[it.id] = l.g.id; all.push(it.id); }); });
    var ui = { q: '', open: {} }, saved = false, asked = false;
    var nm = trim(a.name) || 'this Script';

    function covered(gid) { return sel.every || !!sel.classes[gid]; }
    function ticked(g) {
      if (g === home) { return link; }
      return !sel.except[g] && (covered(gOf[g]) || !!sel.items[g]);
    }
    function count() { return all.filter(ticked).length; }
    /* how many of one class's guns are ticked */
    function onIn(l) { return l.items.filter(function (it) { return ticked(it.id); }).length; }
    function box(state) { return '<span class="aa-pkbox" aria-hidden="true"></span>' + (state || ''); }
    function classState(l) {
      var n = onIn(l);
      if (sel.classes[l.g.id] && !sel.every && n === l.items.length) { return 'true'; }
