  function wireGunHead(root, p, f, lead) {
    var t = root.querySelector('#aa-teach');
    if (t) { t.addEventListener('click', function () { startTeach(p, f, lead ? lead.item.id : ''); }); }
    var fg = root.querySelector('#aa-forget');
    if (fg) {
      /* the kit's confirm-on-second-tap, because a picture takes a
         screenshot and a crop to make again */
