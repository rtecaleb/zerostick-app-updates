  }

  /* THE GUN READER FRAME'S DOOR (the owner, 2026-09-25: "add a universal
     set gun reader frame ... tab in the auto actions"). Universal: one box
     per Core, for every config and every gun, so it sits above everything
     the config decides, even a game with no weapon list yet. Only a Core
     reads names, so an EXO gets no door. */
  /* D339 (the owner, 2026-10-14: "make it more obvious at the top, with a
     question mark explaining that the user needs to ensure the frame is
     around the proper HUD elements"): the door is the room's first thing,
     under a "Start here" line, in the room's rose, with the kit's purple
     "?" beside it. The "?" is NOT inside the door (a button in a button):
     it sits over the door's right side, before the chevron, and its words
     fold open under the door. They are gun-frame.js's own (ZSGUNFRAME.HELP),
     so the door and the frame's screen can never say two things. */
  function frameDoorHTML() {
    if (!window.ZSGUNFRAME || !(ZS.productId && ZS.productId() === 'core')) { return ''; }
    var help = (ZS.helpHTML && ZSGUNFRAME.HELP) ? ZS.helpHTML('aa-frame-help', 'Gun reader frame', ZSGUNFRAME.HELP) : '';
