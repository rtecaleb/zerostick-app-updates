      (mine ? '' : '<button type="button" class="btn" id="aa-al-unlink">Unlink from this ' +
        esc(gunNoun(cat, f.item.id)) + '</button>' +
        '<button type="button" class="btn" id="aa-al-sep">Make a separate copy for this ' +
