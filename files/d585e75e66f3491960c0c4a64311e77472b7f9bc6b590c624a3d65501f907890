    /* STORAGE, NOT A COUNT AGAINST A CAP (D133). This line said "Taught 3
       of 16" and "Smart Actions 6 of 32", and the owner asked why a config
       could only hold that many. The Core now holds far more than anybody
       teaches, so the line says what the config TAKES on the Core, sized as
       a save to this Core would store it; the counts stay as plain facts
       with no ceiling beside them. A config close to a real limit is warned
       below, in words, before anything is refused. */
    var size = r.stored > 0 ? r.stored : r.bytes;
    var h = '<div class="aa-room" id="aa-room">' +
      (size > 0 && window.ZSROOM ? '<span>This config: <b>' + esc(ZSROOM.words(size)) + '</b></span>' : '') +
      '<span>Taught <b>' + r.pictures + '</b>' + esc(splitOf(st, r)) + '</span>' +
      '<span>Scripts <b>' + r.actions + '</b></span>' +
      '</div>';
    /* THE EDITABLE COPY (D103's SOURCE sidecar) is what lets the app open
       this config again after it restarts. Since D124 a Core hands it back
       in pieces and it refers to the taught pictures rather than repeating
       them, so the one limit left is the most one config may be on this
       Core (its blobBytes, D133), with the copy inside (past it the encoder
       leaves the copy out); a Core on older firmware still hands it back in
       ONE reply, READBACK_MAX bytes at most. Past either, the app lists the
       config after a restart but cannot open its settings (it is never
       dropped any more). This tab is what walks a config past the limit, so
       it is said here first. */
    var core = ZS.productId && ZS.productId() === 'core';
    var gone = 'It plays exactly the same, but after the app restarts the app can list this ' +
      'config and not open its settings. Keep this app open while you set it up.';
    if (r.refusal) {
      h += note('The Core will not take this config as it is: ' + esc(r.refusal) + '.', 'warn');
    } else if (r.wholeRefusal) {
      h += note('This config fits the Core only while a kind is switched off. With every kind ' +
        'back on, the Core would refuse it: ' + esc(r.wholeRefusal) + '.', 'warn');
    } else {
      /* close to a limit and a copy that no longer fits are two facts, and
         a config near its bytes has often lost its copy too, so both say so */
      if (r.near.length) {
        h += note(r.near.map(function (s) { return esc(s); }).join(' ') + ' Forget a picture or ' +
          'a Script you no longer use to make room.', 'warn');
      }
      if (core && r.bytes > 0 && r.source === 0) {
        h += note('This config is now too big to carry its own editable copy on the Core. ' + gone, 'warn');
      } else if (core && !r.readBack && r.source > 0) {
        h += note('This config is now too big for the Core to hand back to the app in one piece ' +
          '(its editable copy is ' + (r.source / 1024).toFixed(1) + ' KB and the Core can send about ' +
          Math.floor(READBACK_MAX / 1024) + ' KB). Updating the Core lets it hand the copy back in ' +
          'pieces. ' + gone, 'warn');
      }
    }
    return h;
  }
  /* the owner, 2026-10-17 ("get rid of all that text and add question
     marks"): a gun page keeps its title, picture, controls and live status
     on screen; every sentence that explains is a "?" (the kit's helpHTML)
     beside the thing it explains. helpParts splits the chip from its fold
     so the "?" can ride a title row and the fold open under it. Without
     the kit (a bare test page) the text stays a plain note: nothing lost. */
  function helpParts(id, label, t) {
    if (!t) { return { chip: '', fold: '' }; }
    if (!(window.ZS && ZS.helpHTML)) { return { chip: '', fold: '<div class="note">' + t + '</div>' }; }
    var h = ZS.helpHTML(id, label, t), cut = h.indexOf('<div class="note qhfold"');
    return cut > 0 ? { chip: h.slice(0, cut), fold: h.slice(cut) } : { chip: h, fold: '' };
  }
  /* a blocking line ("these never run") stays on screen, its first
     sentence only; the rest goes behind the "?" */
  function firstSentence(t) {
    var m = /^([\s\S]*?[.!?])\s+([A-Z<][\s\S]*)$/.exec(t);
    return m ? [m[1], m[2]] : [t, ''];
  }
  function note(t, kind) {
    if (kind === 'warn' && ZS.warnHTML) { return ZS.warnHTML(t); }
    return '<div class="note' + (kind ? ' ' + kind : '') + '">' + t + '</div>';
  }

  /* WHAT THE CONFIG SAYS ABOUT EVERY WEAPON AT ONCE: how many Auto Actions
     each has and which are trained, in one pass over the actions and one
     over the pictures. The list asks it for 270 weapons on every search
     keystroke, so asking each weapon separately (a scan of the whole config
     per weapon) is what would make typing lag on a phone. Keyed by the
     document object, which the app replaces on every write. */
  var indexMemo = { doc: null, out: null };
  function indexOf(doc) {
    if (doc && indexMemo.doc === doc) { return indexMemo.out; }
    /* count: an item's own actions; pair: "<lead>+<carried>" -> a pair's;
       lead: every pair action under one lead item (D125) */
    var out = { count: {}, trained: {}, pair: {}, lead: {} };
    arr(doc && doc.accessibilityActions).forEach(function (a) {
      if (!isAuto(a)) { return; }
      var w = withOf(a);
      /* D134: a linked action counts on every gun it runs on, not only the
         one it lives on */
      var guns = isLinked(a) ? reachOf(a, catalogFor(a.auto.pack)).ids : [a.auto.item];
      guns.forEach(function (g) {
        if (w) {
          out.pair[w + '+' + g] = (out.pair[w + '+' + g] || 0) + 1;
        } else {
          out.count[g] = (out.count[g] || 0) + 1;
        }
      });
      if (w) { out.lead[w] = (out.lead[w] || 0) + 1; }
    });
    function mark(t, r) {
      if (typeof t.item === 'string' && t.item && trim(t.label) && patchOk(t) &&
          t.enabled !== false && r.enabled !== false) {
        out.trained[t.item] = true;
      }
    }
    eachTemplate(doc, function (t, r) { mark(t, r); return true; });
    /* a switched-off kind's pictures are still taught (D125) */
    eachParked(doc, function (t, e) { mark(t, e.region); });
    indexMemo.doc = doc; indexMemo.out = out;
    return out;
  }

  /* One item's row: its picture (the owner's taught crop once there is
     one), its exact name, where it is from, and at a glance how many Auto
     Actions it has and whether the Core can recognise it yet. `o.kind` is
     its kind (an operator's slot is square), `o.pair` the lead item whose
     page it is listed on, which is whose actions it counts (D125). */
  function gunRow(p, st, ix, g, it, o) {
    o = o || {};
    var n = o.pair ? (ix.pair[o.pair + '+' + it.id] || 0) : (ix.count[it.id] || 0) + (ix.lead[it.id] || 0);
    var taught = !!ix.trained[it.id];
    var named = !taught && namedGun(st.pack.id, o.kind ? nounOf(o.kind) : 'gun');
    var trained = taught || named;
    /* D398: the trained line and the taught crop are training tools too */
    var tools = devTools();
    var crop = taught && tools ? cropUrl(p.id, it.id) : '';
    var cnt = n ? countWord(n, 'AI Script', 'AI Scripts') : 'No AI Scripts';
    var tword = !tools ? '' : named ? 'Read by name' : trained ? 'Trained' : 'Not trained yet';
    var say = it.name + (o.vaulted ? ', vaulted' : '') + ', ' + (n ? cnt : 'no AI Scripts') +
      (tword ? ', ' + tword.toLowerCase() : '');
    return '<div class="aa-gun" role="button" tabindex="0" data-aagun="' + esc(it.id) + '"' +
      (o.pair ? ' data-aapair="' + esc(o.pair) + '"' : '') + ' aria-label="' + esc(say) + '">' +
      '<span class="aa-pic' + (squareKind(o.kind) ? ' aa-sq' : '') + (!crop && !it.image ? ' aa-codeonly' : '') + '">' +
        picHTML(st.pack.id, g, it, crop, o.kind) + '</span>' +
      '<span class="aa-t"><span class="aa-nl"><span class="aa-name">' + esc(it.name) + '</span>' +
        badge(it.from) + '</span>' +
      '<span class="aa-sub aa-col" aria-hidden="true"><span>' + esc(cnt) + '</span>' +
        (tword ? '<span class="aa-tr' + (trained ? ' on' : '') + '"><span class="aa-dot"></span>' +
          tword + '</span>' : '') +
      '</span></span>' +
      '<span class="chev" aria-hidden="true">›</span></div>';
  }

  /* THE GAME'S OWN SHAPE. Warzone lists the current title's classes, and
     keeps every older title's weapons behind a separate Legacy tab. The
     catalog marks those classes with a `legacy_` id (game-data/README.md),
     so they are drawn the same way: the current classes first, then ONE
     Legacy fold holding the rest, each named without the word Legacy it is
     already inside. Twenty-one flat headers would be a list nobody could
     find their gun in. */
  function isLegacy(g) { return /^legacy_/.test(g.id); }
  function shortName(g) { return isLegacy(g) ? g.name.replace(/^Legacy\s+/i, '') : g.name; }

  /* THE WEAPONS OF ONE CLASS ARE ONLY DRAWN WHILE IT IS OPEN. A closed
     class is its header and an empty body, filled the moment it is opened
     (fillClass, from the header's own tap), so the whole armoury is 21
     headers and not 270 rows of pictures until somebody asks. */
  /* The words the list uses for what it lists: a single-kind game's own
     ("weapon"), or the lead kind's for a game with two (D125). */
  function listWords(st, k) {
    var cat = st.cat && st.cat.data;
    if (!cat || !cat.multi) { return { one: 'weapon', many: 'weapons' }; }
    k = k || cat.lead;
    return { one: nounOf(k), many: nounsOf(k) };
  }
  /* `k` is the kind whose group this is: the lead's, or (D126) the carried
     kind's inside the All fold, where a row is the item on its own and says
     when it is in no lead item's list today. */
  function classBody(p, st, ix, g, items, k) {
    var cat = st.cat && st.cat.data;
    k = cat && cat.multi ? (k || cat.lead) : null;
    var alone = !!(k && cat.carried && k === cat.carried);
    if (!items.length) {
      return '<div class="aa-none">No ' + esc(listWords(st, k).many) + ' listed in this class yet.</div>';
    }
    function rows(list, vaulted) {
      return list.map(function (it) { return gunRow(p, st, ix, g, it, { kind: k, vaulted: vaulted }); }).join('');
    }
    if (!alone) { return rows(items, false); }
    /* the All fold (D126): what is in a mode today first, then the vaulted
       ones under a heading of their own, which says it once for the class
       rather than on every row */
    var now = [], old = [];
    items.forEach(function (it) { (carriersOf(cat, it.id).length ? now : old).push(it); });
    return (now.length && old.length
        ? '<div class="aa-lsub">In ' + esc(an(nounOf(cat.lead))) + '’s pool today</div>' : '') + rows(now, false) +
      (old.length ? '<div class="aa-lsub aa-vault">Vaulted</div>' + rows(old, true) : '');
  }
  function classHTML(p, st, ix, g, items, q, k) {
    var ui = uiOf(p);
    var open = q ? true : !!ui.open[g.id];
    var setUp = 0, w = listWords(st, k);
    g.items.forEach(function (it) { if (ix.count[it.id] || ix.trained[it.id] || ix.lead[it.id]) { setUp++; } });
    var count = countWord(g.items.length, w.one, w.many) + (setUp ? ' · ' + setUp + ' set up' : '');
    return '<div class="acc aa-cls' + (open ? ' open' : '') + '" data-aacls="' + esc(g.id) + '">' +
      '<div class="ah" role="button" tabindex="0">' +
        classTile(g, k || (st.cat && st.cat.data && st.cat.data.multi ? st.cat.data.lead : null),
                  st.pack && st.pack.id) +
        '<span class="aa-clsname">' + esc(shortName(g)) + '</span>' +
        '<span class="aa-clscount">' + esc(q ? countWord(items.length, 'match', 'matches') : count) + '</span>' +
        '<span class="chev">›</span></div>' +
      '<div class="ab">' + (open ? classBody(p, st, ix, g, items, k) : '') + '</div></div>';
  }
  /* An item matches when the query starts one of its runs of words, or
     sits inside one of its words (D126: name, short forms, aliases); a
     class's own code ("SG", "AR") lists the whole class. */
  function hit(it, q) {
    var k = it.keys || searchKeys(it.name, it.aliases);
    var i;
    for (i = 0; i < k.runs.length; i++) { if (k.runs[i].indexOf(q) === 0) { return true; } }
    for (i = 0; i < k.words.length; i++) { if (k.words[i].indexOf(q) >= 0) { return true; } }
    return false;
  }
  function matching(g, q) {
    if (!q) { return g.items; }
    if (q.length >= 2 && norm(classCode(g)) === q) { return g.items; }
    return g.items.filter(function (it) { return hit(it, q); });
  }
  function legacyTitles(groups) {
    var seen = {}, out = [];
    groups.forEach(function (g) {
      g.items.forEach(function (it) { if (it.from && !seen[it.from]) { seen[it.from] = true; out.push(it.from); } });
    });
    if (out.length < 2) { return out.join(''); }
    return out.slice(0, -1).join(', ') + ' and ' + out[out.length - 1];
  }

  function classesHTML(p, st) {
    var ui = uiOf(p), q = norm(ui.q), cat = st.cat.data;
    var ix = indexOf(st.full);
    var shown = 0;
    var now = cat.groups.filter(function (g) { return !isLegacy(g); });
    var old = cat.groups.filter(isLegacy);
    function draw(list, k) {
      return list.map(function (g) {
        var items = matching(g, q);
