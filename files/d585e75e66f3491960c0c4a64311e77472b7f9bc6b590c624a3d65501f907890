        var total = 0;
        old.forEach(function (g) { total += g.items.length; });
        var open = q ? true : !!ui.legacy;
        var titles = legacyTitles(old);
        h += '<div class="acc aa-legacy' + (open ? ' open' : '') + '" id="aa-legacy">' +
          '<div class="ah" role="button" tabindex="0">' +
            '<span class="aa-lgt"><span class="aa-clsname">Legacy</span>' +
            (titles ? '<span class="aa-lgsub">' + esc(titles) + '</span>' : '') + '</span>' +
            '<span class="aa-clscount">' + esc(q ? countWord(hits, 'match', 'matches')
              : countWord(total, 'weapon', 'weapons')) + '</span>' +
            '<span class="chev">›</span></div>' +
          '<div class="ab">' + inner + '</div></div>';
      }
    }
    if (q && !shown) {
      h = '<div class="aa-none" id="aa-nomatch">No ' + esc(listWords(st).one +
        (all ? ' or ' + nounOf(cat.carried) : '')) + ' in ' + esc(st.game || 'this game') +
        ' is called “' + esc(ui.q) + '”.</div>';
    }
    return h;
  }

  /* THE ONE SWITCH A GAME WITH TWO KINDS HAS (D125): "Recognise guns too".
     On, the Core watches the operator AND the gun; off, the operator only,
     and every picture and pair action of the carried kind is kept in the
     config but not sent (park). What the position it is in means is said in
     a sentence under it, because "off" alone would read as "deleted". */
  function kindSwitchHTML(st) {
    var cat = st.cat.data, k = cat.carried;
    if (!k) { return ''; }
