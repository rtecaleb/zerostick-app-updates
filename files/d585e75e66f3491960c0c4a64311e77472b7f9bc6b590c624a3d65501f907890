      var on = id === tier, c = n[id] || 0;
      return '<button type="button" class="aa-rchip' + (on ? ' on' : '') + '" data-aatier="' + esc(id) + '" ' +
        'aria-pressed="' + (on ? 'true' : 'false') + '" aria-label="' +
        esc(label + ': ' + plural(c, 'Script', 'Scripts')) + '"' +
        (t && t.colour ? ' style="--tc:' + t.colour + '"' : '') + '>' +
        (t ? '<span class="aa-tdot" aria-hidden="true"></span>' : '') + esc(label) +
        (c ? '<span class="aa-rn" aria-hidden="true">' + c + '</span>' : '') + '</button>';
    }
    var T = tier ? tierOf(cat, tier) : null;
    /* D398 (owner, 2026-10-16): the rarities are COLLAPSED. The strip reads
       "Any rarity" and a "•••" that shows the rest; nothing about them
       changed (the same chips, views and data). It stays open by itself when
       a rarity is picked or one already has Scripts, so nothing is hidden
       that is in use; otherwise the viewer's own choice (uiOf, per page). */
    var used = cat.tiers.some(function (t) { return (n[t.id] || 0) > 0; });
    var ui = uiOf(p);
    var open = !!T || used || !!((ui.rarOpen || {})[viewKey(f.item.id, opId)]);
    var say = T
      ? T.name + ' Scripts replace this gun’s any-rarity Script on the same button while it is ' +
        T.name + '.'
      : open ? 'Any rarity runs whatever the rarity. Pick a rarity to give ' + theName(cat, f.item.id) +
        ' a different script while it is that rarity.'
      : 'Any rarity runs whatever the rarity. Tap ••• for the rarities, to give ' + theName(cat, f.item.id) +
        ' a different script while it is that rarity.';
    /* section 3: Warzone's Legacy guns reach a match almost only as the
       player's own loadout guns (NAME-READING.md 10.1) */
    if (isLegacy(f.group) && tierOf(cat, 'loadout')) {
      say += ' A Legacy gun comes into a match almost only as your own loadout gun, so its rarity is almost always ' +
        tierOf(cat, 'loadout').name + '.';
