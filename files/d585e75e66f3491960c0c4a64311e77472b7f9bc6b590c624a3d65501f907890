  function linkWrite(p, mutate, done) {
    if (!docOf(p)) { ZS.toast('Connect your Core first'); return; }
    var flush = ZS.flushProfileWrites ? ZS.flushProfileWrites(p.id) : Promise.resolve();
    flush.then(function () {
      return ZS.putProfile(p.id, function (doc) { mutate(doc); retie(doc); });
