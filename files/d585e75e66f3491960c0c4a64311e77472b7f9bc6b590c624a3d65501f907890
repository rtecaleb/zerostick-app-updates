  /* ═══ THE PICKER (section 3, Linking and Copying) ═══
     One sheet for both: the room's own search on top, "Every gun" first,
     then each class as a header with its own checkbox ("Every Assault
     Rifle"), folded, its guns under it; Legacy classes last, as the room
     orders them; a count that follows the boxes; the gun the action lives
     on ticked and locked. Done saves; the sheet's close saves nothing and
     says so (D125).
     A class checkbox writes `classes`, never its guns; unticking a gun under
     a ticked class writes `except`. So the link stays a RULE: next season's
     SMG is in "every SMG" the day the catalog gains it. Copy expands the
     same ticks once, at Done. The boxes are buttons with role="checkbox",
     so a tap, a key and a screen reader all say the same thing. */
  function pickerLists(cat, a) {
    var home = cat.byId[a.auto.item];
    if (!home) { return []; }
    var pool = withOf(a) ? poolOf(cat, withOf(a)) : null;
    var now = [], old = [];
    home.kind.groups.forEach(function (g) {
      var items = pool ? g.items.filter(function (it) { return pool[it.id]; }) : g.items;
      if (items.length) { (isLegacy(g) ? old : now).push({ g: g, items: items }); }
    });
