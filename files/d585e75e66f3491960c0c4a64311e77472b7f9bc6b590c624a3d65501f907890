    var lead = nounOf(cat.lead), gun = nounOf(k);
    var title = 'Recognise ' + nounsOf(k) + ' too';
    var say = off
      ? '<b>Off:</b> the Core watches your ' + lead + ' only. Each ' + lead + '’s own Scripts ' +
        'still run. The Scripts you gave ' + an(gun) + ', and every ' + gun + ' picture you taught, ' +
        'stay in this config but are not sent to your Core. Switch this back on and they all come ' +
        'back as they were.'
      : '<b>On:</b> the Core watches your ' + lead + ' and your ' + gun + '. The Scripts you give ' +
        an(gun) + ' on ' + an(lead) + '’s page run only while that ' + lead + ' has it out.';
    return '<div class="grp-card aa-kind" id="aa-kind">' +
      '<div class="fld"><div class="flab">' + esc(title) + '</div>' +
        '<span class="sw' + (off ? '' : ' on') + '" data-nosave="1" id="aa-kindsw" aria-label="' +
        esc(title) + '"></span></div>' +
      '<p class="aa-kindsay" id="aa-kindsay">' + say + '</p></div>';
  }
  function capital(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
  /* "an operator", "a gun": the nouns come from the catalog, so the article does too */
  function an(w) { return (/^[aeiou]/i.test(w) ? 'an ' : 'a ') + w; }
  /* Flip it. Off parks the carried kind and ties again, so its pair actions
