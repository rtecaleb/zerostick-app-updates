            var e = cat && cat.byId[row.getAttribute('data-aagun')];
            var show = !q || !!(e && (hit(e.item, q) || (q.length >= 2 && norm(classCode(e.group)) === q)));
            if (show) { row.removeAttribute('hidden'); n++; } else { row.setAttribute('hidden', ''); }
