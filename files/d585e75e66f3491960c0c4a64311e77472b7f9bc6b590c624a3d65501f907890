            if (f && typeof f.scrollIntoView === 'function') {
              try { f.scrollIntoView({ block: 'center' }); } catch (e) { /* only a convenience */ }
            }
          }, 350);
          return;
        }
        if (tries < 12) { setTimeout(go, 250); }
        return;
      }
      if (tries === 1) {
