      '</span></button></div>';
  }
  function wireEditor(p, f, host, id) {
    function on(sel, fn) {
      var b = host.querySelector(sel);
      if (b) { b.addEventListener('click', function (e) { if (e && e.stopPropagation) { e.stopPropagation(); } fn(); }); }
    }
    on('#aa-ed-link', function () { openPicker(p, id, 'link'); });
