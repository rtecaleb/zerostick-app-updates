            esc(l.g.id) + '" aria-checked="' + classState(l) + '"' + (sel.every ? ' aria-disabled="true"' : '') +
            '>' + box() + '<span class="aa-pkname">' + esc('Every ' + cls) + '</span></button>' +
          '<button type="button" class="aa-pkfold" data-pkfold="' + esc(l.g.id) + '" aria-expanded="' +
            (open ? 'true' : 'false') + '" aria-label="' + esc((open ? 'Hide' : 'Show') + ' the ' + l.g.name) + '">' +
            '<span class="aa-pkn">' + esc(on + ' of ' + l.items.length) + '</span><span class="chev">›</span></button></div>' +
          (open ? '<div class="aa-pkbody">' + items.map(gunRow).join('') + '</div>' : '') + '</div>';
      });
      if (q && !shown) {
        h = '<div class="aa-none" id="aa-pknone">' + esc('No ' + noun + ' is called “' + ui.q + '”.') + '</div>';
      }
      return h;
    }
    function countWords() {
      var n = count();
      if (link) { return 'Linked to ' + plural(n, noun, nouns); }
      return n ? plural(n, 'copy', 'copies') + ', one for each ' + noun + ' ticked' : 'Tick the ' + nouns + ' to copy it to';
    }
    /* D405: Copy's button says what it will do */
    function doneWords() {
      if (link) { return 'Done'; }
      var n = all.filter(function (g) { return g !== home && ticked(g); }).length;
      return n ? 'Copy to ' + plural(n, noun, nouns) : 'Copy';
    }
    var lead = '', why = '';
    if (link) {
      lead = 'One Script on every ' + noun + ' you tick: change it once and every one of them changes. ' +
        'A whole class stays whole: a new ' + noun + ' the game adds to it later joins by itself.';
    } else {
      /* D405: one short line; the rest is the "?" */
      lead = 'Tick the ' + nouns + ' that get their own copy of “' + nm + '”.';
      why = 'Each ' + noun + ' you tick gets a <b>separate copy</b>, to change on its own. ' +
        'To change them all at once later, use <b>Use on more ' + esc(nouns) + '</b> (Link) instead. ' +
