    if (wrote) { ZS.store.vals[key] = seen; if (ZS.persistStore) { ZS.persistStore(); } }
    return out.join(' ');
  }
  /* An action's chips, and their words for a screen reader: "Linked: 12
     guns", each of its rarities by NAME (the colour is a dot beside it,
     never the only cue), and "Needs rarity detection" while no Core reads
     rarity. */
  function tierChip(t, id) {
    return '<span class="aa-chip aa-tier"' + (t && t.colour ? ' style="--tc:' + t.colour + '"' : '') + '>' +
      '<span class="aa-tdot" aria-hidden="true"></span>' + esc(t ? t.name : id) + '</span>';
  }
  function chipsOf(a, cat, doc) {
    var html = '', say = [];
    var n = gunsOf(a, cat).length;
    if (isLinked(a) && n > 1) {
      html += '<span class="aa-chip aa-link">' + esc('Linked: ' + plural(n, gunNoun(cat, a.auto.item),
        gunNouns(cat, a.auto.item))) + '</span>';
      say.push('Linked to ' + plural(n, gunNoun(cat, a.auto.item), gunNouns(cat, a.auto.item)) + '.');
    }
