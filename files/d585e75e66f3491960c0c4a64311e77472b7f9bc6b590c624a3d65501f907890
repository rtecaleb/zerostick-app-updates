      return '<button type="button" role="checkbox" class="aa-pkrow" data-pkgun="' + esc(it.id) + '" aria-checked="' +
        (ticked(it.id) ? 'true' : 'false') + '"' + (mine ? ' aria-disabled="true"' : '') + '>' + box() +
        '<span class="aa-pkname">' + esc(it.name) + '</span>' +
        (mine ? '<span class="aa-pktag">' + esc(link ? 'this ' + noun + ', always' : 'this ' + noun + ' has it') + '</span>' : '') +
        '</button>';
    }
    function listHTML() {
      var q = norm(ui.q), h = '', shown = 0, oldHead = false;
      lists.forEach(function (l) {
        var items = q ? matching({ id: l.g.id, name: l.g.name, items: l.items }, q) : l.items;
        if (q && !items.length) { return; }
        shown += items.length;
        if (isLegacy(l.g) && !oldHead) { oldHead = true; h += '<div class="aa-pksh">Legacy</div>'; }
        var open = q ? true : !!ui.open[l.g.id];
        var cls = singular(l.g.name);
        var on = onIn(l);
        h += '<div class="aa-pkcls' + (open ? ' open' : '') + '" data-pkcls="' + esc(l.g.id) + '">' +
