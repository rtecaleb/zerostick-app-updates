      return n ? 'mixed' : 'false';
    }
    function everyState() {
      if (!sel.every) { return 'false'; }
      return count() === all.length ? 'true' : 'mixed';
    }
    function gunRow(it) {
      var mine = it.id === home;
      /* D405: Copy's list is the OTHER guns: the one it is on is not a target */
