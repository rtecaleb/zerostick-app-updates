      (it.uncertain && !hideTeach ? '<div class="aa-sub">' + esc(it.uncertain) + '</div>' : '') +
      stay + hp.fold + (vis && !(hideTeach && /TEST PICTURES/.test(vis)) ? note(esc(vis), 'warn') : '') + teach + shared +
