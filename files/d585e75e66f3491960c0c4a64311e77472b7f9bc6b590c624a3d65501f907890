  }
  function wireList(root, p) {
    var ui = uiOf(p);
    var outBtn = root.querySelector('#aa-outnow');
    if (outBtn) { outBtn.addEventListener('click', function () { openGun(p, outBtn.getAttribute('data-aagun'), ''); }); }
    if (window.ZSGUNBULK) { ZSGUNBULK.wireCard(root, p); }
    var door = root.querySelector('#aa-frame');
    if (door) {
      var go = function () { ZSGUNFRAME.open(p, { label: '‹ AI Scripts', go: function () { openList(p); } }); };
      door.addEventListener('click', go);
      door.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
      });
      /* feedback on the press, not the release (DESIGN.md) */
      door.addEventListener('pointerdown', function () { door.classList.add('zs-pressing'); });
      ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
        door.addEventListener(ev, function () { door.classList.remove('zs-pressing'); });
      });
    }
    var ns = root.dataset ? root.dataset.ns : '';
    /* a picture that will not load stands down to the class chip */
    function pics(el) {
      el.querySelectorAll('img.aa-img').forEach(function (im) {
        if (im._aaPic) { return; }
        im._aaPic = true;
        im.addEventListener('error', function () { picFailed(im); });
      });
    }
    function gunRows(el) {
      el.querySelectorAll('.aa-gun').forEach(function (row) {
        if (row._aaRow) { return; }
        row._aaRow = true;
        function go() { openGun(p, row.getAttribute('data-aagun'), row.getAttribute('data-aapair') || ''); }
        row.addEventListener('click', go);
        row.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
        });
        /* feedback on the press, not the release (DESIGN.md), and gone
           again the moment the finger slides off */
        row.addEventListener('pointerdown', function () { row.classList.add('zs-pressing'); });
        ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
          row.addEventListener(ev, function () { row.classList.remove('zs-pressing'); });
        });
      });
      pics(el);
    }
    /* A class's header tap, AFTER wire()'s own toggle: remember it, and
       draw its weapons the first time it opens. The body is filled in the
       same tap, before the next frame, which is when zs-anim.js measures
       the height it opens to, so the fold opens onto real rows. */
    function heads(el) {
      el.querySelectorAll('.acc.aa-cls > .ah').forEach(function (hd) {
        hd.addEventListener('click', function () {
          var acc = hd.parentElement, id = acc.getAttribute('data-aacls');
          var open = acc.classList.contains('open');
          if (!norm(ui.q)) { ui.open[id] = open; }     /* a search opens every match */
          var ab = acc.querySelector('.ab');
          if (open && ab && !ab.firstChild) {
            /* the lead's classes and (D126) the All fold's, which are the
               carried kind's */
            var st = stateOf(p), found = groupById(st.cat && st.cat.data, id);
            if (found) {
              ab.innerHTML = classBody(p, st, indexOf(st.full), found.g, matching(found.g, norm(ui.q)), found.k);
              gunRows(ab);
            }
          }
        });
      });
      var lg = el.querySelector('#aa-legacy > .ah');
      if (lg) {
        lg.addEventListener('click', function () {
          if (!norm(ui.q)) { ui.legacy = lg.parentElement.classList.contains('open'); }
        });
      }
      var al = el.querySelector('#aa-all > .ah');
      if (al) {
        al.addEventListener('click', function () {
          if (!norm(ui.q)) { ui.all = al.parentElement.classList.contains('open'); }
        });
      }
    }
    function wireClasses(el) { heads(el); gunRows(el); }
    wireClasses(root);
    /* the kit flipped the switch already (phone.html wire); this is the
       write it stands for */
    var ksw = root.querySelector('#aa-kindsw');
    if (ksw) { ksw.addEventListener('click', function () { setKind(p, ksw.classList.contains('on')); }); }
    var q = root.querySelector('#aa-q');
    if (q) {
      /* one repaint per frame however fast the letters come, so a quick
         typist never queues up a repaint per keystroke */
      var queued = false;
      q.addEventListener('input', function () {
        ui.q = q.value || '';
        if (queued) { return; }
        queued = true;
        var paint = function () {
          queued = false;
          var box = root.querySelector('#aa-classes');
          var st = stateOf(p);
          if (!box || !st.cat || !st.cat.data) { return; }
          box.innerHTML = classesHTML(p, st);
          ZS.wire(box, ns);
          wireClasses(box);
        };
        if (typeof window.requestAnimationFrame === 'function') { window.requestAnimationFrame(paint); }
        else { setTimeout(paint, 0); }
      });
    }
  }

  /* D215 (owner): with EXO Studio on, the capture picture is the PC's and
     the Core's AI Scripts are off (/vision/* and Auto Actions answer 409).
     The room says so in one calm line and shows the player's AI Scripts
     with nothing wired and the whole list inert, so no tap can arm or
     change anything. It comes back as it was the moment the Core says
     EXO Studio is off (ZSMODES.onChange redraws it). */
  var PC_OFF = 'Off while EXO Studio is on: the picture goes to your PC. Turn EXO Studio off to use AI Scripts on your Core.';
  /* D218 (owner): GPC mode turns the EXO into a Cronus Zen, which has no
     CV: AI Scripts are off on the Core (its capture parked to save memory),
     said and drawn the same way, inert */
  var GPC_PAUSED = 'Off in GPC mode: switch to normal mode to use AI Scripts.';
  /* 'studio' | 'gpc' | '': the mode that has the Core's capture parked */
  function parkedMode() { return (window.ZSMODES && window.ZSMODES.parked) ? window.ZSMODES.parked() : ''; }
  function pcHasPicture() { return !!parkedMode(); }
  function renderPaused(p) {
    var mode = parkedMode() || 'studio';
    return { html: '<div class="note" id="aa-pc" role="status" data-mode="' + mode + '">' +
      esc(mode === 'gpc' ? GPC_PAUSED : PC_OFF) + '</div>' +
      '<div id="aa-paused" inert aria-hidden="true" style="opacity:.5;pointer-events:none">' + listHTML(p) + '</div>',
      after: function (root) { root.setAttribute('data-tint', 'auto'); } };
  }
  function renderList(p) {
    injectCss();
    if (pcHasPicture()) {
      CUR.pid = p.id; CUR.item = null; CUR.pair = ''; CUR.from = null;
      return renderPaused(p);
    }
    ASK = null;
    CUR.pid = p.id; CUR.item = null; CUR.pair = ''; CUR.from = null;
    /* D431 (owner, 2026-10-22): AI Scripts is not usable until the player
       has said their in-game settings for this game (once per game; Device
       keeps them editable) */
    if (window.ZSGAMESET && ZSGAMESET.needs(p)) {
      return { html: ZSGAMESET.gateHTML(p), after: function (root) {
        root.setAttribute('data-tint', 'auto');
        ZSGAMESET.wire(root, p, function () { openList(p); });
      } };
    }
    var st = stateOf(p);
    if (st.pack && !st.cat) { loadCatalog(st.pack.id); }
    healNames(p, st);                                  /* D415 */
    if (!VIS[p.id]) { askVision(p); }
    loadCrops(redrawIfOpen);
    /* a redraw while somebody is typing in the search keeps the caret */
    var ae = document.activeElement;
    var caret = (ae && ae.id === 'aa-q') ? (ae.selectionStart || 0) : -1;
    return { html: listHTML(p), after: function (root) {
      root.setAttribute('data-tint', 'auto');
      wireList(root, p);
      if (caret >= 0) {
        var q = root.querySelector('#aa-q');
        if (q) { try { q.focus(); q.setSelectionRange(caret, caret); } catch (e) {} }
      }
    } };
  }

  /* `inAll`: the group is one of the All fold's (D126), so the fold opens too */
  function openList(p, openGroup, inAll) {
    if (openGroup) { uiOf(p).open[openGroup] = true; }
    if (inAll) { uiOf(p).all = true; }
    ZS.openDetail({ id: 'auto', lab: 'AI Scripts' }, p);
  }

  /* Redraw whichever of this file's screens is showing, and only then. */
  function redrawIfOpen() {
    var body = document.getElementById('dbody');
    var det = document.getElementById('detail');
    if (!body || !det || !det.classList.contains('open')) { return; }
    var ns = String(body.dataset.ns || '');
    if (/\/auto$/.test(ns) || /\/autogun$/.test(ns)) {
      if (typeof ZS.redrawOpenScreen === 'function') { ZS.redrawOpenScreen(); }
    }
  }
  listeners.push(function () { redrawIfOpen(); });
  /* the gun out changed while AI Scripts is open: redraw, so the top card
     always names the gun in your hands */
  if (typeof ZS.onLiveInput === 'function') {
    ZS.onLiveInput(function () {
      var body = document.getElementById('dbody');
      if (!body || !/\/auto$/.test(String(body.dataset.ns || ''))) { return; }
      var p = CUR.pid && typeof ZS.prof === 'function' ? ZS.prof(CUR.pid) : null;
      var st = p ? stateOf(p) : null;
      var cat = (st && st.cat && st.cat.state === 'ready') ? st.cat.data : null;
      var it = gunOutItem(cat);
      if ((it ? it.id : '') !== OUT_SEEN) { redrawIfOpen(); }
    });
  }
  /* D215: EXO Studio on or off (the Core's answer) redraws the room */
  if (window.ZSMODES && window.ZSMODES.onChange) { window.ZSMODES.onChange(function () { redrawIfOpen(); }); }
  if (window.ZSPACKS && ZSPACKS.onChange) {
    ZSPACKS.onChange(function (kind) { if (kind === 'packs') { redrawIfOpen(); } });
  }

  /* ═════════════════════════════════════════════ one weapon's page ══
     smart-actions.js's own room, scoped to this weapon (renderScoped), with
     the weapon's card on top. In a game with two kinds (D125) the same page
     serves an operator (his card, his guns, then his own Smart Actions) and
     a gun opened from an operator's page (the pair's Smart Actions). */

  /* `pairWith` is the lead item a carried one is opened under, '' for none.
     A carried item has no page of its own in Siege: a gun's Smart Actions
     belong to an operator AND a gun, so it is always opened from one. Where
     the carried kind has an All entry (D126) it has a page of its own too,
     reached from that fold. */
  function aloneOk(cat, f) { return !!(f && cat && cat.multi && f.kind === cat.carried && allName(cat)); }
  function openGun(p, itemId, pairWith, from) {
    CUR.pid = p.id; CUR.item = itemId; CUR.pair = pairWith || '';
    var st = stateOf(p), cat = st.cat && st.cat.data;
    var f = cat ? findItem(cat, itemId) : null;
    var lead = (cat && pairWith) ? findItem(cat, pairWith) : null;
    if (!f || (pairWith && !lead) || (cat && cat.multi && f.kind === cat.carried && !lead && !aloneOk(cat, f))) {
      openList(p);
      return;
    }
    /* D134: a linked action's Edit, from another gun's page, comes back
       there, not to the list */
    var back = (from && cat && findItem(cat, from.item)) ? from : null;
    CUR.from = back;
    var nav = backOf(p, st, f, lead);
    ZS.openDetail({ id: 'autogun', lab: f.item.name, backLabel: nav.label, onBack: nav.go }, p);
  }
  /* The page's back key: the page a linked action's Edit came from (D134),
     else the lead item a carried one is under (D125), else the list, with
     the item's class (and the All fold, D126) open. */
  function backOf(p, st, f, lead) {
    var cat = st.cat && st.cat.data;
    var from = (CUR.pid === p.id && CUR.from) ? CUR.from : null;
    var fe = (from && cat) ? findItem(cat, from.item) : null;
    var inAll = !lead && aloneOk(cat, f);
    if (fe) {
      return { label: '‹ ' + fe.item.name, go: function () { openGun(p, from.item, from.pair || ''); } };
    }
    if (lead) { return { label: '‹ ' + lead.item.name, go: function () { openGun(p, lead.item.id); } }; }
    return { label: '‹ AI Scripts', go: function () { openList(p, f.group.id, inAll); } };
  }

  /* A GUN IS READ BY ITS NAME, NOT TAUGHT (the owner, 2026-09-25: "remove
     the teach the core this gun option on each gun"). The Core reads the
     gun's name out of one box on screen (the name reader, D141), and each
     player sets that box once, for every gun, in the Gun reader frame
     (gun-frame.js), so a gun's page no longer offers to teach a picture of
     it. An operator, a legend or a mode is not a name on the HUD, so its
     page still teaches a picture (D125, D126). */
  /* AUDIT M23: read by name is a fact about the GAME, not the noun. Only a
     game with a name reader (NAME_PACKS, the games with a
     game-data/<pack>/recognition.json: cod-bo2, and since D415 cod-bo7 and
     cod-warzone) is read by name; on every other game (Apex, Fortnite,
     Siege, Battlefield 6) a gun's page
     pointed at the Gun reader frame, which reads nothing there, and with
     teaching gone no gun could ever be recognised, so every gun Script was
     never sent. There, a gun is taught a picture again, as an operator or
     a legend is: the fallback (gun detection's third layer). */
  function readsNames(packId) { return !!NAME_PACKS[packId]; }
  function readByName(packId, noun) { return readsNames(packId) && (noun === 'gun' || noun === 'weapon'); }
  /* The Core recognises every gun of a NAME_PACKS game by the name the game
     writes on screen (D141-D143), with no picture: its page and its row say
     "Read by name" the way a taught gun's say "Trained". */
  function namedGun(packId, noun) { return readByName(packId, noun); }
  function unreadHTML(gun, whose) {
    return '<p class="aa-rule off">The Core does not recognise this ' + gun + ' yet, so ' + whose +
      ' never run, whatever their switch says. It reads a ' + gun + ' by the name your game writes on ' +
      'screen: show it where that is in Gun reader frame, at the top of AI Scripts.</p>';
  }
  /* The sentence under the card: when these Smart Actions run, in the words
     of the page it is on. A single-kind game's two sentences are D122's. */
  function ruleHTML(st, f, lead, trained, noun) {
    var full = st.full || {};
    var packId = st.pack && st.pack.id;
    var cat = st.cat && st.cat.data;
    var name = esc(f.item.name);
    if (!cat || !cat.multi) {
      return trained
        ? '<p class="aa-rule">These Scripts run only while the Core sees the ' + name +
          ' on screen, and switch off the moment it sees any other weapon.</p>'
        : readByName(packId, 'gun') ? unreadHTML('gun', 'its Scripts')
        : '<p class="aa-rule off">Teach the Core this gun first. Until it has been taught, its ' +
          'Scripts never run, whatever their switch says.</p>';
    }
    var k = cat.carried, gun = k ? nounOf(k) : 'gun', op = nounOf(cat.lead);
    if (!lead && k && f.kind === k) {
      /* a gun on its own, from the All fold (D126): D122's rule, in every mode */
      return trained
        ? '<p class="aa-rule">These Scripts run while the Core sees the ' + name + ' on screen, in ' +
          'every ' + op + ', and switch off the moment it sees another ' + gun + '. The ' + name + '’s ' +
          'Scripts for one ' + op + ' are on that ' + op + '’s page.</p>'
        : readByName(packId, gun) ? unreadHTML(gun, 'its Scripts')
        : '<p class="aa-rule off">Teach the Core this ' + gun + ' first. Until it has been taught, its ' +
          'Scripts never run, whatever their switch says.</p>';
    }
    if (!lead) {
      return trained
        ? '<p class="aa-rule">These Scripts run whenever the Core sees ' + name + ' on screen, ' +
          'whatever ' + gun + ' is out, and switch off the moment it sees another ' + op + '.</p>'
        : '<p class="aa-rule off">Teach the Core this ' + op + ' first. Until it has been taught, ' + name +
          '’s Scripts, and every ' + gun + '’s for ' + name + ', never run, whatever their ' +
          'switch says.</p>';
    }
    var who = esc(lead.item.name);
    if (k && kindOff(full, k.kind)) {
      return '<p class="aa-rule off">Recognise ' + nounsOf(k) + ' too is switched off for this config, ' +
        'so these never run. Nothing is deleted: switch it back on in AI Scripts and they run again.</p>';
    }
    if (!trained) {
      return readByName(packId, gun) ? unreadHTML(gun, 'these')
        : '<p class="aa-rule off">Teach the Core this ' + gun + ' first. Until it has been taught, ' +
          'these never run, whatever their switch says.</p>';
    }
    if (!isTrained(full, lead.item.id)) {
      return '<p class="aa-rule off">The Core knows the ' + name + ' but not ' + who + ' yet. Teach it ' +
        who + ' on ' + who + '’s own page; until then these never run.</p>';
    }
    return '<p class="aa-rule">These Scripts run only while the Core sees ' + who + ' and the ' +
      name + ' on screen together. ' + who + '’s own Scripts keep running beside them.</p>';
  }

  /* D398 (owner, 2026-10-16): "remove the Teach Core this gun / training
     stuff from ALL gun pages". D398 first hid it only with developer mode
     off, but the owner runs with developer mode ON (Debug code 2200) and
     still saw it ("remove the 'teach the Core this gun' stuff, etc.",
     2026-10-16). So it is hidden from EVERYONE by default: teaching a
     picture, the trained / not-trained line (page and rows), the taught
     crop, the picture limit, the picture talk, the TEST PICTURES warning
     and a catalog entry's "uncertain" source note show only with the
     explicit developer switch Global Settings > Developer > "Show gun
     training tools" on (ZS.gunTraining: developer builds only, off by
     default, stored per install), and never in a release build. Operators,
     legends and modes follow the same switch, so the rule is one rule. */
  function devTools() {
    if (window.ZS_BUILD && window.ZS_BUILD.dev === false) { return false; }
    return !!(ZS.gunTraining && ZS.gunTraining());
  }
  function gunHeadHTML(p, st, f, lead) {
    var full = st.full || {};
    var cat = st.cat && st.cat.data;
    var multi = !!(cat && cat.multi);
    var hideTeach = !devTools();
    var it = f.item, g = f.group;
    var noun = multi ? nounOf(f.kind) : 'gun';
    var taught = isTrained(full, it.id);
    var named = !taught && namedGun(st.pack && st.pack.id, noun);
    var trained = taught || named;
    var pending = !!PENDING[cropKey(p.id, it.id)] && !taught;
    var crop = taught ? cropUrl(p.id, it.id) : '';
    var r = room(full);
    var byName = readByName(st.pack && st.pack.id, noun);
    /* D136: a Core with no picture ceiling says null, and `n >= null` is
       true in JavaScript, so "no ceiling" is asked about first. A gun is
       never taught now, so the ceiling is nothing to it. */
    var full16 = !byName && !trained && typeof r.picturesMax === 'number' && r.pictures >= r.picturesMax;
    var vis = visionLine(p);
    var parkedKind = multi && cat.carried && f.kind === cat.carried && kindOff(full, cat.carried.kind);
    var state = pending ? '<span class="aa-tr"><span class="aa-dot"></span>Saving the picture to your Core…</span>'
      : '<span class="aa-tr' + (trained ? ' on' : '') + '"><span class="aa-dot"></span>' +
        (named ? 'Read by name: the Core knows it by the name on screen'
          : trained ? 'Trained: the Core can recognise it' : 'Not trained yet') + '</span>';
    var rule = ruleHTML(st, f, lead, trained, noun);
    if (hideTeach) {
      /* no training talk: a gun the Core does not know yet is simply one
         whose Scripts wait for it (unless it is read by name, whose line
         points at the Gun reader frame, which every player does set) */
      if (/Teach/.test(rule)) {
        rule = '<p class="aa-rule">These Scripts switch on by themselves when your Core recognises ' +
          (lead ? esc(lead.item.name) + ' and the ' + esc(it.name) + ' on screen together.</p>'
            : (multi && f.kind === cat.lead ? '' : 'the ') + esc(it.name) + ' on screen.</p>');
      }
      state = '';
      crop = '';
    }
    /* THE LIMIT covers both kinds at once (D125): a Siege config's pictures
       are its operators and its guns together, so the sentence says so. The
       number is the connected Core's (D133), so on a D133 Core nobody meets
       it and on an older one it is still its 16. */
    var limit = multi
      ? 'The Core holds ' + r.picturesMax + ' taught pictures in one config, ' + nounsOf(cat.lead) +
        (cat.carried ? ' and ' + nounsOf(cat.carried) : '') + ' together, and this config has ' + r.pictures +
        esc(splitOf(st, r)) + '. Forget one you no longer use (on its own page) to teach this ' + noun + '.'
      : 'The Core holds ' + r.picturesMax + ' taught weapons in one config, and this config has ' +
        r.pictures + '. Forget a weapon you no longer use (on its own page) to teach this one.';
    /* NO "Teach the Core this gun" (the owner, 2026-09-25): guns are read by
       name now, and the per-player Gun reader frame replaces a picture per
       gun. A gun taught before keeps its picture until it is forgotten, so
       "Forget the picture" stays for it; teaching it again does not. */
    var teach = parkedKind ? ''
