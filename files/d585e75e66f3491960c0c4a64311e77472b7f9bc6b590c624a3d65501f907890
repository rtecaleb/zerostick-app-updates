      var src = JSON.parse(JSON.stringify(a));
      if (!unlinkGun(a, cat, gun)) { return; }
      made = mintIds(doc, 1)[0];
      doc.accessibilityActions.push(copyFor(src, gun, made));
    }, function () {
      if (!made) { return; }
      if (window.ZS_SMART && ZS_SMART.refreshRooms) { ZS_SMART.refreshRooms(p.id, [id, made]); }
      ZS.toast('This ' + gunNoun(cat, gun) + ' has its own copy now: change it here without changing the others. ' +
        'The other ' + gunNouns(cat, gun) + ' keep the linked one.', { ms: 6000 });
    });
  }

  /* ── the editor's card, for an action this page owns ── */

  function editorTop(p, id) {
    var cat = catOf(p), a = actionIn(docOf(p), id);
