    return '<div class="aa-frbox aa-frclear' + (chip ? ' aa-frq' : '') + '" id="aa-frbox">' +
      '<div class="aa-freye">One-time setup</div>' +
      '<div class="aa-frrow">' +
      '<div class="aa-frame" id="aa-frame" role="button" tabindex="0">' +
      '<span class="aa-frico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
      'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5V18h15.5"/>' +
      '<path d="M2.5 6H18v15.5"/></svg></span>' +
