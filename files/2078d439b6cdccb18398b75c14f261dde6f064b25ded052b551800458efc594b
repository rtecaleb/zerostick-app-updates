<title>ZeroStick — your devices</title>

<!-- Which kind of build this is (owner / release): decides whether the
     EXO's developer door exists at all. -->
<!-- D423: the phone app shell's live updates (zerostick-app/www/zs-live-update.js; never on the exe) -->
<script>if(window.Capacitor&&window.Capacitor.isNativePlatform&&window.Capacitor.isNativePlatform()){document.write('<script src="/zs-live-update.js"><\/script>');}</script>
<script src="zs-build.js"></script>
<!-- The registry. Must load before the redirect script below. -->
<script src="devices.js"></script>
<script>
  /* ══ AUTO-OPEN — runs before the first paint ═══════════════════════
     With one shipping product this file must be invisible: no picker
     frame, no extra tap, ~1 ms on localhost. The rules, exactly:

       ?pick=1 in the URL      → always show the list, never redirect
       only 1 listed, ready    → replace() to it
       memory hits a ready one → replace() to the remembered one
       no/stale/locked memory  → show the list
       ('ready' = zsDevReady: status ready, or a soon product whose
        developer unlock is set on this device, D271)
       0 ready                 → show the list (empty state)
       any exception           → swallowed, the list renders

     location.replace, not href, so Back from the product app never
     bounces into a redirect loop. */
  /* ?app=1 (the desktop exe, desktop.js) means "full-bleed app mode" and
     must reach the product page, whether the picker redirects or the user
     taps a tile — so one helper adds it to any product href. */
  /* 2026-10-23 (owner: the list came back inside the phone outline after
     the calibrator's Back): app mode is remembered for this window's session
     once the exe opened it with ?app=1, so a link back that drops the flag
     (the calibrator's Back) still lands full-bleed */
  window.zsIsApp = function () {
    var on = /[?&]app=1/.test(location.search);
    try {
      if (on) sessionStorage.setItem('zs-app-mode', '1');
      else on = sessionStorage.getItem('zs-app-mode') === '1';
    } catch (e) {}
    return on;
  };
  window.zsWithApp = function (href) {
    if (!window.zsIsApp() || /[?&]app=1/.test(href)) return href;
    return href + (href.indexOf('?') >= 0 ? '&' : '?') + 'app=1';
  };
  /* D264: this list is ALSO the ZeroStick phone app's home screen now (its
     www/index.html opens exo/devices.html). Inside the app (Capacitor) a
     product may give a different page (nativeHref, devices.js): the Core
     opens as the Bluetooth page there, as the phone app always opened it. */
  window.zsHrefOf = function (d) {
    var c = window.Capacitor;
    var native = !!(c && c.isNativePlatform && c.isNativePlatform());
    return (native && d.nativeHref) ? d.nativeHref : d.href;
  };
  /* D271: is this product open on THIS device? 'ready' always is. A 'soon'
     product with devUnlock (the EXO) is too once its hidden developer unlock
     has set that localStorage key to '1' (the summary sheet below, ten taps
     on its picture). A SOFT GATE: it keeps the public out of an unfinished
     product in the normal flow, it is not security - anyone with the
     browser's dev tools can set the key. Storage that throws reads as locked. */
  /* STORE BUILDS HAVE NO DEVELOPER DOOR (2026-10-13). Apple rejects apps
     with hidden or undocumented features (App Review Guideline 2.3.1), and
     the EXO's ten-tap unlock and the preview behind it are exactly that. So
     a release build (zs-build.js dev:false, made by set-build-flavor.js
     release) never opens the EXO: it is simply Coming soon. The owner's
     builds (dev:true) keep the door, as before. */
  window.zsDevDoor = function () { return !(window.ZS_BUILD && window.ZS_BUILD.dev === false); };
  window.zsDevReady = function (d) {
    if (!d) return false;
    if (d.status === 'ready') return true;
    if (d.devUnlock && window.zsDevDoor()) {
      try { return localStorage.getItem(d.devUnlock) === '1'; } catch (e) {}
    }
    return false;
  };
  (function () {
    try {
      if (/[?&]pick=1/.test(location.search)) return;
      var L = window.ZS_DEVICES || [], ready = [], listed = 0, i;
      for (i = 0; i < L.length; i++) {
        if (!L[i] || !L[i].id || !L[i].href) continue;
        listed++;
        if (window.zsDevReady(L[i])) ready.push(L[i]);
      }
      var go = null;
      /* D271: "exactly one ready" became "the ONLY product listed, and it is
         ready". With the EXO coming soon only the dongle is ready, and the
         old rule would have opened it on a first launch, so nobody would
         ever see the EXO tile. */
      if (listed === 1 && ready.length === 1) {
        go = ready[0];
      } else if (ready.length > 0) {
        var mem = null;
        try { mem = localStorage.getItem('zs-device'); } catch (e) {}
        for (i = 0; i < ready.length; i++) if (ready[i].id === mem) go = ready[i];
      }
      if (go) {
        /* belt and braces: replace() usually stops the parser dead, but a
           hidden root guarantees the picker never flashes on the way out */
        document.documentElement.style.visibility = 'hidden';
        var target = window.zsWithApp(window.zsHrefOf(go));
        var cap = window.Capacitor;
        if (cap && cap.isNativePlatform && cap.isNativePlatform()) {
          /* INSIDE THE PHONE APP, WAIT FOR THE FIRST LAYOUT (owner,
             2026-10-14: reopening the app auto-opened the EXO filling the
             whole screen, under the Dynamic Island and the home bar; opening
             it with a tap was right). Navigating from <head> on a cold launch
             happens before WKWebView has handed the page its safe-area
             insets, so the product page reads env(safe-area-inset-*) as 0
             and never recovers. A tap always comes after that first layout,
             which is why it was fine. So the app redirects only once this
             page has loaded and painted a frame (still hidden); a browser
             keeps the immediate replace(). */
          var went = false;
          var goNow = function () {
            if (went) return;
            went = true;
            location.replace(target);
          };
          window.addEventListener('load', function () {
            var raf = window.requestAnimationFrame || function (f) { return setTimeout(f, 16); };
            raf(function () { raf(goNow); });
          });
          setTimeout(goNow, 1500);   /* never stuck on a hidden page */
        } else {
          location.replace(target);
        }
      }
    } catch (e) { /* fall through: the list renders */ }
  })();
</script>

<style>
  /* ══ Screen zero of ZeroStick — the device selector ═══════════════════
     THE BONES ARE THE STORE APP'S (owner, 2026-09-04: "take the current app
     and duplicate it and build from it"). The phone app that went to Google
     Play opens on this exact screen — a hero with the mark and "Select your
     device", a "My devices" label, one tile per product with a glyph, a
     name, one plain line and a status chip, and a foot note — and the exe
     must read as the same product, so its selector is that screen and not
     a list of rows that happens to hold the same names. Picking ZeroStick
     EXO lands on the EXO home; the EXO's ⋯ → Your devices lands back here.

     WHAT THIS FILE KEEPS FROM ITS OWN PAST, because the store app never
     needed it and the exe does: the auto-open rule above (one ready product
     means no picker at all), the JS-free fallback tile (the picker must not
     be able to brick the shipping product), the reachability probe, the
     Back affordance when a product app sent you here, and the shared Ease
     of Access settings.

     This is a COPY of the frame CSS from phone.html plus the values it
     needs from zs-kit.css, and that duplication is deliberate: the picker
     has to be bootable when everything else in the app is broken, so it
     depends on nothing. If the kit's card language moves, re-copy.

     --accent is Ion Cyan, NOT the PlayStation blue — DESIGN.md and D45. The
     store app's own stylesheet painted its "Connect" chip #6f9bff, which in
     this palette MEANS PlayStation; here the chip wears the product's
     interactive colour and the glyph wears the product's own accent, so
     "this is tappable" and "this is a PS5 thing" can never be one pixel. */
  /* D271: THE 8K FLAT LOOK (D259) here too. The values are a COPY of
     zs-flat.css's --zk-* palette (this page depends on nothing, see above):
     one charcoal ground, one card, one blue for "press this", a hairline
     for an edge, no gloss and no glow. The old Ion cyan / navy ladder went
     with it, so the list and the EXO summary sheet read as one app. */
  :root{
    --bg:#1b1d20; --frame:#0b0c0e; --panel:#26282d; --panel2:#1b1e22;
    --raised:#2d3036; --control:#1b1e22;
    --line:#3a3e45;
    --edge:#5a616b;
    --text:#eef1f4; --muted:#9aa3ad; --faint:#9aa3ad;
    --blue:#58a6ff; --green:#3fb950; --amber:#ffb454;
    --accent:#58a6ff; --accent-ink:#06172e;
    --accent-wash:rgba(88,166,255,.12); --accent-edge:rgba(88,166,255,.45);
    --pic-well:#000;
    --r-card:14px; --r-ctl:10px;
    --el-1:0 0 0 0 transparent; --el-2:0 0 0 0 transparent;
    --edge-lit:0 0 0 0 transparent;
    --tr-title:-.016em; --tr-label:.06em; --tr-caption:.004em;
    --ease-settle:cubic-bezier(.22,1,.36,1);
  }
  /* LIGHT (D271): the zs-flat.css light values. Which theme comes from the
     EXO app's own Theme setting when there is one (one setting across the
     app, like Ease of Access below), else the system's, as the dongle does. */
  body.zs-light{
    --bg:#f4f5f7; --frame:#d5dae0; --panel:#ffffff; --panel2:#f1f3f5;
    --raised:#f6f7f9; --control:#f1f3f5;
    --line:#d5dae0; --edge:#8a929c;
    --text:#1b1d20; --muted:#56606b; --faint:#56606b;
    --green:#17702f; --amber:#835700;
    --accent:#1a5fd0; --accent-ink:#ffffff;
    --accent-wash:rgba(26,95,208,.10); --accent-edge:rgba(26,95,208,.45);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{margin:0;min-height:100vh;background:var(--bg);
    color:var(--text);font:15px/1.5 -apple-system,"Segoe UI Variable Text","Segoe UI",Roboto,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    display:flex;flex-direction:column;align-items:center;gap:14px;padding:28px 12px}
  button{font:inherit;color:inherit;background:none;border:0}
  .cap{color:var(--muted);font-size:13px;text-align:center;max-width:410px}
  .cap b{color:var(--text)}

  /* theme + accessibility modes — the same body classes and the same
     localStorage the app uses, so text size and contrast are ONE setting */
  body.zs-oled{--bg:#000000; --frame:#000000; --panel:#0a0d11; --panel2:#11151b}
  body.zs-oled .phone{box-shadow:0 30px 80px rgba(0,0,0,.9), inset 0 0 0 2px #14181f}
  body.a11y-contrast{--muted:#bcc7d3; --line:#bcc7d3; --faint:#bcc7d3; --text:#ffffff}
  body.zs-light.a11y-contrast{--muted:#1b1d20; --line:#1b1d20; --faint:#1b1d20; --text:#000000}
  body.a11y-contrast .dev{box-shadow:none;border:2px solid var(--text)}
  body.a11y-contrast .pback{background-color:var(--panel2);border:2px solid var(--text);
    box-shadow:none;color:var(--text)}
  body.a11y-motion *{transition:none !important; animation:none !important}

  /* FULL-BLEED inside a real app (owner, 2026-10-12: "remove that iphone
     outline on that home screen"). The mockup frame below is for a browser,
     where this page stands in for a phone; inside the ZeroStick phone app
     (Capacitor) or the desktop exe (?app=1) the device IS the frame, so the
     bezel, notch and caption go and the screen fills the window, with room
     for the iPhone's notch and home bar. The class is set by the script at
     the top of <body>. Same idea as phone.html's body.zs-app. */
  body.zs-app{padding:0;display:block}
  body.zs-app .cap,
  body.zs-app .notch{display:none}
  body.zs-app .phone{width:100%;max-width:none;height:100vh;height:100dvh;max-height:none;
    padding:0;border-radius:0;box-shadow:none;background:var(--bg)}
  body.zs-app .screen{border-radius:0}
  body.zs-app .appbar{padding-top:calc(30px + env(safe-area-inset-top, 0px))}
  body.zs-app .screen > :last-child{padding-bottom:env(safe-area-inset-bottom, 0px)}

  /* phone shell — the same frame as phone.html, so this is screen zero of the
     product and not a website index */
  .phone{width:390px;max-width:96vw;height:800px;max-height:88vh;
    background:var(--frame);border-radius:44px;padding:12px;
    box-shadow:0 30px 80px rgba(0,0,0,.6), inset 0 0 0 2px #1d2530;position:relative}
  .screen{width:100%;height:100%;background:var(--bg);border-radius:33px;
    overflow:clip;display:flex;flex-direction:column;position:relative}
  .notch{position:absolute;top:8px;left:50%;transform:translateX(-50%);
    width:130px;height:26px;background:var(--frame);border-radius:0 0 16px 16px;z-index:40}

  /* the bar holds ONLY the way back, and only when there is one. The mark
     moved down into the hero — that is where the store app carries it, and
     a mark in the bar over a mark in the hero says the name twice. */
  .appbar{padding:30px 18px 0;display:flex;align-items:center;min-height:44px;
    position:relative;z-index:2}
  /* ‹ Back — only shown when the picker was reached FROM a product app; the
     script at the bottom decides and un-hides it. Hidden by default because
     on screen zero there is nothing behind us, and a Back that does nothing
     is worse than none. ≥44px target from min-height/min-width, not the glyph. */
  .pback{display:inline-flex;align-items:center;flex:none;
    min-height:44px;min-width:44px;padding:0 13px;margin:-2px 2px -2px -4px;
    border-radius:var(--r-ctl);border:1px solid var(--line);
    background:var(--panel2);color:var(--accent);
    font-weight:700;font-size:14px;cursor:pointer;box-shadow:var(--el-1),var(--edge-lit)}
  .pback[hidden]{display:none}

  .home{flex:1;overflow-y:auto;padding:0 18px 26px}

  /* ── THE STORE APP'S BONES ─────────────────────────────────────────── */
  #hero{text-align:center;margin:22px 0 28px}
  #hero .mark{display:flex;justify-content:center;min-height:44px}
  #hero .mark svg{display:block}
  #hero .fallback{font-size:26px;line-height:44px;color:var(--accent)}
  #hero p{color:var(--muted);margin:12px 0 0;font-size:14.5px}

  .lbl{color:var(--muted);font-size:11.5px;font-weight:650;
    letter-spacing:var(--tr-label);text-transform:uppercase;margin:0 4px 10px}

  /* one tile per product. A ready tile is a real <a>, so middle-click,
     Ctrl-click and "open in new tab" all work and it needs no JS to be
     followed; a soon tile is a <div> that cannot be tabbed to, because a
     control that does nothing is worse than none. A soon tile WITH a
     summary (`about`, D271) is a <button>: it does something, it opens the
     sheet. */
  .dev{width:100%;display:flex;align-items:center;gap:12px;text-align:left;
    background:var(--panel);border-radius:var(--r-card);padding:14px 14px 14px 12px;
    margin-bottom:12px;box-shadow:var(--el-2),var(--edge-lit);
    border:1px solid var(--line);color:inherit;text-decoration:none;font:inherit;cursor:pointer;
    transition:transform 90ms var(--ease-settle),border-color 90ms var(--ease-settle)}
  a.dev:active, button.dev:active{transform:scale(.975);border-color:var(--accent-edge)}
  a.dev:focus-visible, button.dev:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .dev.dim{opacity:.5}
  /* A PHOTO TILE (owner, 2026-10-02: "make the Core tab look like our
     polished image"): HOME's device card, here. The picture is flush to the
     tile's left edge and its full height, the tile's rounded corners are its
     only edge, it fades into the tile on the right, and a blurred copy of
     the SAME animated picture under it is the glow, so the light follows the
     RGB loop round. The tile wears HOME's card colours (raised panel, one
     hairline edge). */
  .dev.has-pic{padding:0 14px 0 0;gap:14px;align-items:stretch;overflow:hidden;
    background:var(--panel);border:1px solid var(--line);box-shadow:var(--el-2)}
  .dev.has-pic .pic{position:relative;flex:0 0 116px;min-height:104px;align-self:stretch}
  /* the photo sits on its OWN black (D271, the owner's renders are on
     black), so no edge of the picture shows before the fade */
  .dev.has-pic .pic .well{position:absolute;inset:0;overflow:hidden;background:var(--pic-well);
    -webkit-mask-image:linear-gradient(to right,#000 62%,transparent 100%);
            mask-image:linear-gradient(to right,#000 62%,transparent 100%)}
  .dev.has-pic .pic picture{display:block;width:100%;height:100%}
  .dev.has-pic .pic img{width:100%;height:100%;object-fit:cover;display:block}
  .dev.has-pic .pic .glow{position:absolute;inset:-10px;overflow:hidden;pointer-events:none;
    filter:blur(16px) saturate(2) brightness(1.5);opacity:.85;mix-blend-mode:screen}
  .dev.has-pic .pic .glow img{transform:scale(2.1)}
  .dev.has-pic .tx{align-self:center;padding:12px 0}
  .dev.has-pic .chip{display:inline-block;margin-top:8px}
  @media (prefers-reduced-transparency:reduce){ .dev.has-pic .pic .glow{display:none} }
  body.a11y-contrast .dev.has-pic .pic .glow{display:none}
  body.zs-light .dev.has-pic .pic .glow{display:none}
  .glyph{flex:0 0 50px;height:50px;border-radius:13px;
    background:var(--control);display:grid;place-items:center;box-shadow:var(--edge-lit)}
  .glyph svg{width:30px;height:30px}
  .tx{flex:1;min-width:0}
  /* THE NAME WRAPS; IT NEVER TRUNCATES. The store app keeps its names on one
     line with an ellipsis, and at its 335px column that is safe. Inside this
     390px frame the column is ~150px once the glyph and the chip have taken
     theirs, and the ellipsis was landing on the one word that tells the
     products apart — "ZeroStick …" for all three. A second line is cheap;
     losing "EXO" is not. The description clamps instead, because it is the
     line that can afford to. */
  .nm{display:block;font-size:16px;font-weight:650;letter-spacing:var(--tr-title);
    line-height:1.2;overflow-wrap:normal}
  .ds{color:var(--muted);font-size:12.5px;margin-top:3px;line-height:1.35;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  /* the reachability line rides under the description: presentation only,
     an unreachable device is STILL tappable (the EXO app works offline) */
  .st{display:block;font-size:12px;margin-top:4px;letter-spacing:var(--tr-caption)}
  .chip{flex:0 0 auto;font-size:10.5px;font-weight:700;letter-spacing:var(--tr-label);
    text-transform:uppercase;padding:5px 10px;border-radius:999px;white-space:nowrap}
  .chip.on{background:var(--accent-wash);color:var(--accent);border:1px solid var(--accent-edge)}
  .chip.off{background:var(--control);color:var(--faint)}
  /* "Coming soon" on a tile you CAN tap (D271): the product's news, so it
     reads, not greyed. Ink on a wash, a hairline, never colour alone. */
  .chip.soon{background:var(--panel2);color:var(--text);border:1px solid var(--edge)}

  /* ══ THE EXO SUMMARY SHEET (D271) ═════════════════════════════════════
     A page over the list, inside the phone screen: the 8K flat look, one
     column, short points (the "?" help style, D260), a 44 px close key and
     Escape. A fade and a short rise, nothing under Reduce Motion. */
  .about{position:absolute;inset:0;z-index:30;background:var(--bg);
    display:flex;flex-direction:column;opacity:0;transform:translateY(14px);
    visibility:hidden;transition:opacity 170ms var(--ease-settle),transform 260ms var(--ease-settle),visibility 0s linear 260ms}
  .about.open{opacity:1;transform:none;visibility:visible;
    transition:opacity 170ms var(--ease-settle),transform 260ms var(--ease-settle),visibility 0s}
  .about .abar{display:flex;align-items:center;gap:10px;padding:30px 14px 8px 18px;min-height:44px}
  .about .abar h2{flex:1;margin:0;font-size:17px;font-weight:650;letter-spacing:var(--tr-title)}
  .about .x{min-width:44px;min-height:44px;border-radius:var(--r-ctl);border:1px solid var(--line);
    background:var(--panel2);color:var(--text);font-size:20px;line-height:1;cursor:pointer;
    display:inline-flex;align-items:center;justify-content:center}
  .about .x:focus-visible, .about a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .about .abody{flex:1;overflow-y:auto;padding:4px 18px 26px}
  /* the picture: the owner's render on its own black, so no edge shows.
     It is also the developer door (ten taps, see the script) - and says
     nothing about it: no cursor, no press state, no hint. */
  .about .apic{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;
    border-radius:var(--r-card);background:#000;-webkit-user-select:none;user-select:none;
    -webkit-touch-callout:none;touch-action:manipulation}
  .about .when{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;margin:14px 0 4px}
  .about .when span{font-size:13.5px;color:var(--text)}
  .about h3{margin:18px 0 6px;font-size:11.5px;font-weight:650;color:var(--muted);
    letter-spacing:var(--tr-label);text-transform:uppercase}
  .about ul{margin:0;padding:0 0 0 18px}
  .about li{margin:0 0 6px;font-size:14.5px;line-height:1.45}
  .about li::marker{color:var(--muted)}
  .about .note{margin:16px 0 0;font-size:13.5px;color:var(--muted);line-height:1.5}
  .about .go{display:flex;align-items:center;justify-content:center;width:100%;
    min-height:48px;margin-top:20px;border-radius:var(--r-ctl);
    background:var(--accent);color:var(--accent-ink);border:1px solid var(--accent);
    font-weight:700;font-size:15px;text-decoration:none}
  .about .rsv{margin:12px 0 0;text-align:center;font-size:13.5px;color:var(--muted)}
  .about .rsv a{color:var(--accent);font-weight:650;text-decoration:underline;
    display:inline-block;min-height:44px;line-height:44px;padding:0 4px}
  .toast{position:absolute;left:50%;bottom:22px;transform:translate(-50%,12px);z-index:40;
    background:var(--raised);color:var(--text);border:1px solid var(--line);border-radius:999px;
    padding:10px 16px;font-size:13.5px;font-weight:600;opacity:0;pointer-events:none;
