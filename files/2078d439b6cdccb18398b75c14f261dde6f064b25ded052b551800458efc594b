<script src="zs-mark.js"></script>
<script>
  (function () {
    try {
      if (!window.ZSLOGO) { return; }
      var el = document.getElementById('brandmark');
      /* 40, the same height the EXO home gives the mark under its live foot:
         the hero is where the store app carries the name, so it gets the
         size a title gets rather than a header glyph's 24. (The owner's
         "Your devices" logo is the More menu's door icon, not this hero.) */
      if (el) { el.innerHTML = window.ZSLOGO.lockup({ height: 40 }); }
      var ico = document.createElement('link');
      ico.rel = 'icon';
      ico.href = window.ZSLOGO.faviconURI();
      document.head.appendChild(ico);
    } catch (e) { /* the ◉ fallback stands */ }
  })();
</script>
<script>
  /* ══ THE PICKER ════════════════════════════════════════════════════
     Renders window.ZS_DEVICES as the store app's tiles. Everything here is
     wrapped so that a failure leaves the static fallback tile above
     untouched. ES5 only (dashboard/public rule): var, function, concatenation. */
  (function () {
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }

    /* Ease of Access is one setting across every ZeroStick device — a
       disabled user should not have to set text size per product. Same
       localStorage key and same body classes the app uses. */
    try {
      var raw = localStorage.getItem('zs-phone-v2');
      var v = (raw ? (JSON.parse(raw) || {}).vals : null) || {};
      var ts = v['global/global|Text size'] || 'Default';
      document.querySelector('.screen').style.zoom =
        ts === 'XL' ? 1.16 : ts === 'Large' ? 1.08 : 1;
      if (v['global/global|High contrast'] === '1') document.body.className += ' a11y-contrast';
      if (v['global/global|Reduce motion'] === '1') document.body.className += ' a11y-motion';
      if (v['global/global|Theme'] === 'OLED black') document.body.className += ' zs-oled';
      /* D271: the theme. The EXO app's Theme setting when it has one (Dark,
         Light, Match system), else the system's, as the dongle follows it. */
      var th = v['global/global|Theme'];
      var sysLight = false;
      try { sysLight = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches); } catch (eM) {}
      if (th === 'Light' || ((!th || th === 'Match system') && sysLight)) document.body.className += ' zs-light';
    } catch (e) {}

    var L = window.ZS_DEVICES || [];
    if (!L.length) return;              /* keep the fallback tile */

    var ART = window.ZS_DEVICE_ART || {};
    var host = document.getElementById('list');
    var html = '', i, d, ready = 0;
    var isReady = window.zsDevReady || function (x) { return x && x.status === 'ready'; };

    for (i = 0; i < L.length; i++) {
      d = L[i];
      if (!d || !d.id || !d.href) continue;
      var soon = !isReady(d);
      /* a soon product with a summary is a button that opens it (D271) */
      var about = soon && d.about === 'exo';
      /* unlocked on this device by the developer door, not shipping */
      var dev = !soon && d.status !== 'ready';
      if (!soon && !dev) ready++;
      var art = ART[d.art] || '';
      /* the product's own photo, when it has one: the RGB loop, or the
         still under Reduce Motion (the app's switch or the system's) */
      var pic = '';
      if (d.pic && d.pic.still) {
        var stillOnly = soon || !d.pic.loop || /\ba11y-motion\b/.test(document.body.className);
        var im = '<img src="' + esc(stillOnly ? d.pic.still : d.pic.loop) + '" alt="" decoding="async" draggable="false">';
        var pv = stillOnly ? im
          : '<picture><source media="(prefers-reduced-motion: reduce)" srcset="' + esc(d.pic.still) + '">' + im + '</picture>';
        /* .art: a picture and its black backing (theme-shots' ART rule) */
        pic = '<span class="pic art" aria-hidden="true">' +
                (soon || !d.pic.loop ? '' : '<span class="glow">' + pv + '</span>') +
                '<span class="well">' + pv + '</span>' +
              '</span>';
      }
      /* THE CHIP IS THE STORE APP'S WORDS: "Connect" on a product you can
         open, "Coming soon" on one you cannot. The glyph wears the product's
         own accent so the tiles tell apart at a glance; the chip wears the
         interactive colour, and only on a tile that is actually a link. */
      var chip = about ? '<span class="chip soon">Coming soon</span>'
        : soon ? '<span class="chip off">Coming soon</span>' : '<span class="chip on">Connect</span>';
      html +=
        (about
          ? '<button type="button" class="dev' + (pic ? ' has-pic' : '') + '" aria-haspopup="dialog" data-about="' + esc(d.about) + '"'
          : soon
          ? '<div class="dev dim' + (pic ? ' has-pic' : '') + '" aria-disabled="true"'
          : '<a class="dev' + (pic ? ' has-pic' : '') + '" href="' + esc(window.zsWithApp ? window.zsWithApp(window.zsHrefOf(d)) : d.href) + '"') +
          ' data-id="' + esc(d.id) + '">' +
          (pic ||
           '<span class="glyph" style="color:' + esc(soon ? '#8695a8' : (d.accent || '#58a6ff')) + '">' + art + '</span>') +
          '<span class="tx">' +
            '<span class="nm">' + esc(d.name) + '</span>' +
            '<span class="ds">' + esc(d.tagline) + '</span>' +
            (soon ? '' : '<span class="st" data-st="' + esc(d.id) + '">' +
              (dev ? '<span style="color:var(--muted)">Developer access</span>' : '') + '</span>') +
            /* a photo tile carries its chip UNDER the words (D271): beside
               them it left the tagline one word wide at 393 px */
            (pic ? chip : '') +
          '</span>' +
          (pic ? '' : chip) +
        (about ? '</button>' : soon ? '</div>' : '</a>');
    }
    if (!html) return;                  /* keep the fallback tile */
    host.innerHTML = html;

    /* remember the choice so "last device wins" (Cronus behaviour) */
    host.addEventListener('click', function (e) {
      var a = e.target.closest ? e.target.closest('a.dev') : null;
      if (!a) return;
      try { localStorage.setItem('zs-device', a.getAttribute('data-id')); } catch (err) {}
    });

    document.getElementById('foot').innerHTML = ready
      ? 'Nothing here working? Check it’s powered on and on the same Wi-Fi as this ' +
        'device. <b>You can still go in</b> — anything you change is kept here and ' +
        'sent over once it reconnects.<br><button class="btn" id="retry">Check again</button>'
      : 'No ZeroStick devices are set up yet.';

    var rb = document.getElementById('retry');
    if (rb) rb.addEventListener('click', function () { probeAll(); });

    /* ── reachability line ──────────────────────────────────────────
       Presentation only. An unreachable device is STILL tappable: the
       EXO app is designed to work offline and replay edits, so gating
       entry on a probe would break a documented behaviour. Never colour
       alone — a glyph AND a word, both times. */
    function probeAll() {
      for (var k = 0; k < L.length; k++) probeOne(L[k]);
    }
    function probeOne(d) {
      if (!d || !isReady(d) || !d.probe) return;   /* no probe → no line */
      var slot = document.querySelector('[data-st="' + d.id + '"]');
      if (!slot) return;
      slot.innerHTML = '<span style="color:var(--muted)">checking…</span>';
      var ctl = ('AbortController' in window) ? new AbortController() : null;
      var t = ctl ? setTimeout(function () { ctl.abort(); }, 2500) : null;
      fetch(d.probe, { signal: ctl ? ctl.signal : undefined })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (t) clearTimeout(t);
          paint(slot, !!(j && j.ok));
        })
        .catch(function () { if (t) clearTimeout(t); paint(slot, false); });
    }
    function paint(slot, ok) {
      slot.innerHTML = ok
        ? '<span style="color:var(--green)">● connected</span>'
        : '<span style="color:var(--amber)">○ not found</span>';
    }
    probeAll();
  })();
</script>
<script>
  /* ══ THE EXO SUMMARY AND THE DEVELOPER DOOR (D271) ═════════════════════
     The EXO tile (devices.js: status 'soon', about 'exo') opens the summary
     sheet (#exo-about). Close: the ✕ key, Escape, or the phone's back
     gesture via the ✕ (focus goes back to the tile).

     THE DOOR: ten taps on the sheet's PICTURE (#exo-about-pic) within five
     seconds. Nothing shows before the tenth (no counter, no press state, no
     cursor). On the tenth: a short buzz where the device has one, the toast
     "Developer access on", the key devices.js names (devUnlock, zs-exo-dev)
     set to '1' in localStorage, zs-device set to the EXO, and the EXO app
     opens as the tile used to. From then on this device treats the EXO as
     ready: the tile is a link again and the exe's auto-open lands in it.
     To lock it again: in the EXO app, More > "Lock developer access"
     (shell/16-start.js), shown only while unlocked.

     A SOFT GATE, NOT SECURITY: the whole thing is in the page. It keeps the
     public out of an unfinished product in the normal flow and nothing
     more. ES5, all of it inside one try, so the list works without it. */
  (function () {
    try {
      var sheet = document.getElementById('exo-about');
      var pic = document.getElementById('exo-about-pic');
      var x = document.getElementById('exo-about-x');
      var toastEl = document.getElementById('pick-toast');
      var home = document.querySelector('.home');
      var list = document.getElementById('list');
      if (!sheet || !pic || !x || !list) return;
      var L = window.ZS_DEVICES || [], exo = null, i;
      for (i = 0; i < L.length; i++) if (L[i] && L[i].about === 'exo') exo = L[i];
      if (!exo) return;

      var opener = null;
      function open(from) {
        opener = from || null;
        sheet.classList.add('open');
        if (home) home.setAttribute('aria-hidden', 'true');
        taps = [];
        try { x.focus(); } catch (e) {}
      }
      function close() {
        if (!sheet.classList.contains('open')) return;
        sheet.classList.remove('open');
        if (home) home.removeAttribute('aria-hidden');
        try { if (opener) opener.focus(); } catch (e) {}
      }
      window.zsExoAbout = { open: open, close: close };

      list.addEventListener('click', function (e) {
        var b = e.target && e.target.closest ? e.target.closest('[data-about]') : null;
        if (b) open(b);
      });
      x.addEventListener('click', close);
      document.addEventListener('keydown', function (e) {
        if (!sheet.classList.contains('open')) return;
        if (e.key === 'Escape' || e.key === 'Esc') { e.preventDefault(); close(); return; }
        /* keep Tab inside the sheet while it is open */
        if (e.key === 'Tab') {
          var f = sheet.querySelectorAll('button, a[href]');
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });

      var toastT = null;
      function toast(t) {
        if (!toastEl) return;
        toastEl.textContent = t;
        toastEl.classList.add('on');
        clearTimeout(toastT);
        toastT = setTimeout(function () { toastEl.classList.remove('on'); }, 2400);
      }

      var NEED = 10, WINDOW_MS = 5000, taps = [];
      pic.addEventListener('click', function () {
        var now = Date.now();
        taps.push(now);
        while (taps.length && now - taps[0] > WINDOW_MS) taps.shift();
        if (taps.length < NEED) return;
        taps = [];
        if (window.zsDevDoor && !window.zsDevDoor()) return;   /* store build: no door */
        try { localStorage.setItem(exo.devUnlock, '1'); } catch (e) {}
        try { localStorage.setItem('zs-device', exo.id); } catch (e) {}
        try { if (navigator.vibrate) navigator.vibrate(30); } catch (e) {}
        toast('Developer access on');
        var go = window.zsHrefOf ? window.zsHrefOf(exo) : exo.href;
        if (window.zsWithApp) go = window.zsWithApp(go);
        setTimeout(function () { location.href = go; }, 700);
      });

      /* phone.html sends a locked visitor here as ?pick=1&soon=<id>: show
         them what the EXO is rather than a list with no explanation */
      var m = /[?&]soon=([a-z0-9-]+)/.exec(location.search);
      if (m && m[1] === exo.id && !(window.zsDevReady && window.zsDevReady(exo))) open(null);
    } catch (e) { /* the list works without the sheet */ }
  })();
</script>
<script>
  /* ══ THE BACK AFFORDANCE ═══════════════════════════════════════════════
     The picker is screen zero when you cold-boot the app, but it is ALSO the
     device SWITCHER when a product app sends you here (?pick=1). In that
     second life it had no way back — the only exits were picking a device or
     an OS back gesture the user may not have.

     WHEN THE BUTTON SHOWS — the picker was demonstrably reached FROM an app:
       · document.referrer is a SAME-ORIGIN product page (a ZS_DEVICES href), OR
       · ?pick=1 is in the URL and history.length > 1. ?pick=1 is only ever
         emitted by product-app switcher links, so it is itself evidence.
     On a genuine cold boot neither holds and the button stays hidden — a
     Back that does nothing is worse than none.

     WHERE IT GOES — without ever re-entering the auto-open redirect:
       · history.back() only when it is provably safe: the entry behind us IS
         the product page that linked here (same-origin referrer match). The
         auto-open uses location.replace(), so a redirecting devices.html can
         never be sitting in history — back cannot bounce.
       · otherwise location.replace() straight to a product page: the
         referrer-matched device, else the remembered zs-device, else the
         only ready device. replace() skips devices.html entirely, so the
         redirect logic never runs.
       · nowhere provable to go → the button never appears.

     Everything is inside one try/catch: if any of this throws, the button
     stays hidden and the picker renders and opens the product exactly as
     before. ES5 only (dashboard/public rule). */
  (function () {
    try {
      var btn = document.getElementById('pickback');
      if (!btn) return;
      /* D271: sent here BECAUSE the EXO is locked (phone.html's gate,
         ?soon=) or was just locked (More > Lock developer access, ?locked=1):
         there is no product behind us to go back to */
      if (/[?&](soon|locked)=/.test(location.search)) return;

      var L = window.ZS_DEVICES || [], i;

      /* same-origin referrer → its basename; anything else → '' */
      var refPage = '';
      if (document.referrer) {
        var a = document.createElement('a');
        a.href = document.referrer;
        if (a.protocol === location.protocol && a.host === location.host) {
          refPage = a.pathname.replace(/^.*\//, '');
          /* a product in its own folder (dongle/dongle.html, D264) */
          var refDir = a.pathname.replace(/\/[^\/]*$/, '').replace(/^.*\//, '');
          var here = location.pathname.replace(/\/[^\/]*$/, '').replace(/^.*\//, '');
          if (refDir && refDir !== here) refPage = refDir + '/' + refPage;
        }
      }

      /* did a product page send us here? */
      var fromProduct = false;
      for (i = 0; i < L.length; i++) {
        if (L[i] && (L[i].href === refPage ||
            (refPage.indexOf('/') >= 0 && L[i].href.replace(/[?#].*$/, '') === refPage))) { fromProduct = true; }
      }

      var picked = /[?&]pick=1/.test(location.search);
      var deep = false;
      try { deep = window.history.length > 1; } catch (eH) {}

      /* a concrete page to replace() to, best evidence first */
      var target = fromProduct ? refPage : '';
      if (!target) {
        var mem = null, ready = [];
        try { mem = localStorage.getItem('zs-device'); } catch (eM) {}
        for (i = 0; i < L.length; i++) {
          if (L[i] && L[i].href && window.zsDevReady(L[i])) {
            ready.push(L[i]);
            if (L[i].id === mem) { target = window.zsHrefOf(L[i]); }
          }
        }
        if (!target && ready.length === 1) { target = window.zsHrefOf(ready[0]); }
      }

      var canBack = fromProduct && deep;          /* history.back() is safe   */
      if (!fromProduct && !(picked && deep)) return;   /* screen zero: no button */
      if (!canBack && !target) return;            /* nowhere provable to go   */

      btn.hidden = false;
      btn.addEventListener('click', function () {
        if (canBack) { window.history.back(); }
        else { location.replace(target); }
      });
    } catch (e) { /* the picker works without a back button */ }
  })();
</script>
