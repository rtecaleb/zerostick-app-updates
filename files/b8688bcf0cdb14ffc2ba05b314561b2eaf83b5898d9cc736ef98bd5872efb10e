  function dress() {
    if (!overlay) return;
    var m = mode();
    var k = copyKey();
    var c = COPY[k];
    if (dressed !== k) {
      dressed = k;
      heroEl.innerHTML = m === 'ble' ? DONGLE_ART : PHOTO;
      titleEl.textContent = c.title;
      stepsEl.innerHTML = c.steps;
      noteEl.innerHTML = c.note;
      helpList.innerHTML = helpItems();
    }
    newBtn.hidden = !!LOCKED || !SHOW_NEW_CALIBRATOR || m === 'ble';
    switchBtn.hidden = !!LOCKED || m !== 'ble';
  }
