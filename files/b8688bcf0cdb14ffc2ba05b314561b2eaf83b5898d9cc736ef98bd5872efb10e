  var previewKey = null;
  function copyKey() {
    if (previewKey) return previewKey;
    var m = mode();
    if (m === 'app') return isIos() ? 'ios' : 'android';
    return m;
  }
  /* the ways that start with Search (everything but a browser and Bluetooth) */
  function searches() {
    var k = copyKey();
