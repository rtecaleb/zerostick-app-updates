    // causes look identical here -- no hardware in range, or the app not
    // being allowed to join networks itself -- so name both, and always
    // offer the manual route, which works no matter which it was.
    return { t: 'Could not join the calibrator\'s WiFi', d: 'Make sure the calibrator is powered on and your phone ' +
             'is within 6 feet of it. When your phone asks to join the network, tap Connect or Join. ' + MANUAL_HINT };
  }
  // The exe's answers (src/wifi.js codes)
  function explainPc(r) {
    var code = r && r.code;
    if (code === 'location') {
      return { t: 'Windows needs Location turned on', d: 'Windows only lets apps see and join WiFi when Location is on. ' +
        'Turn on "Location services" and "Let desktop apps access your location", then tap Try again. ' + PC_MANUAL,
        fix: { label: 'Open Location settings', run: function () { pcCall('POST', PC_LOCATION, {}, 5000).catch(function () {}); } } };
    }
    if (code === 'no-wifi') return { t: 'This PC has no WiFi', d: 'Use the ZeroStick app on your phone instead, or plug a USB WiFi adapter into this PC and tap Try again.' };
    if (code === 'wifi-off') return { t: 'This PC\'s WiFi is off', d: 'Turn WiFi on from the WiFi button in the bottom-right corner of Windows, then tap Try again.' };
    if (code === 'not-found') return { t: 'Can\'t find the calibrator\'s WiFi', d: NEAR + 'Move this PC closer to it, then tap Try again. ' + PC_MANUAL };
    return { t: 'Could not join the calibrator\'s WiFi', d: ((r && r.error) ? r.error + ' ' : '') + PC_MANUAL };
  }

  // ── The PC's network line (exe only) ───────────────────────────────────────
  var pcNet = null;
  function paintPcNet() {
    if (!pcJoined || mode() !== 'pc') { if (pcNet) pcNet.hidden = true; return; }
    if (!pcNet) {
      pcNet = document.createElement('div');
      pcNet.id = 'zsPcNet';
      pcNet.setAttribute('role', 'status');
      pcNet.innerHTML = '<span class="t"></span><button type="button"></button>';
      var bar = document.getElementById('zsbar');
      if (bar && bar.parentNode) bar.parentNode.insertBefore(pcNet, bar.nextSibling);
      else document.body.insertBefore(pcNet, document.body.firstChild);
      pcNet.querySelector('button').addEventListener('click', function () {
        leave().then(function () { showIdle(); });
      });
    }
    pcNet.hidden = false;
    pcNet.querySelector('.t').textContent = 'This PC is on the calibrator’s WiFi, so it has no internet.';
    pcNet.querySelector('button').textContent = pcPrevious ? 'Back to ' + pcPrevious : 'Leave its WiFi';
  }
  /* back to the PC's own WiFi (the back key calls this before leaving) */
  function leave() {
    if (!pcJoined || mode() !== 'pc') return Promise.resolve(false);
    pcJoined = false;
    if (pcNet) pcNet.hidden = true;
    return pcCall('POST', PC_RESTORE, {}, 6000).then(function (r) { return !!(r && r.ok); }, function () { return false; });
  }

  // ── The main connect sequence ──────────────────────────────────────────────
  var connecting = false;
  var appJoined = false;       // this visit, the phone app put the phone on the calibrator

  // ── Bluetooth dongle ───────────────────────────────────────────────────────
  var bleWatching = false;
  async function connectBle(fromTap) {
    if (!window.ZSHIDBLE) { showError('This version of the app cannot use the Bluetooth dongle', ''); return; }
    markBle();
    if (window.ZSHIDBLE.isConnected()) { hideOverlay(); return; }
    // A dongle this phone already knows reconnects by itself, no chooser
    // (inside the app it is usually still connected from the dongle screen).
    if (window.ZSHIDBLE.remembered && window.ZSHIDBLE.remembered()) {
      showStatus('Reconnecting to your ZeroStick Dongle…');
      try {
        await window.ZSHIDBLE.reconnect();
        watchBle();
        hideOverlay();
        return;
      } catch (e) {
        if (!(e && e.zsKind === 'none') && !fromTap) {
          var x = window.ZSHIDBLE.explain(e);
          showError(x.title, x.text);
          return;
        }
      }
    }
    if (!isApp() && !fromTap) {
      // A browser only opens its Bluetooth picker from a real tap.
      showIdle('Connect');
      return;
    }
    showStatus('Looking for your ZeroStick Dongle…', 'Pick "ZeroStick Dongle" when your phone asks.');
    try {
      await window.ZSHIDBLE.connect();
    } catch (e) {
      var ex = window.ZSHIDBLE.explain(e);
      showError(ex.title, ex.text);
      return;
    }
    watchBle();
    hideOverlay();
  }
  function watchBle() {
    if (bleWatching) return;
    bleWatching = true;
    window.ZSHIDBLE.onDisconnect(function () {
      showError('The dongle disconnected', 'Check it is still plugged in, then tap Try again.');
    });
  }
  // The Bluetooth dongle has no WiFi network and no reboot page: hide the
  // calibrator's WiFi-only hints (calibrator.html marks them .zs-wifi-only).
  function markBle() {
    var s = document.getElementById('zsBleOnly');
    if (s) return;
    s = document.createElement('style');
    s.id = 'zsBleOnly';
    s.textContent = '.zs-wifi-only{display:none !important;}';
    document.head.appendChild(s);
  }

  /* after the join: does the board answer? (it can take a few seconds) */
  async function checkBoard() {
    showStatus('Checking the calibrator…', 'This takes a few seconds.');
    for (var i = 0; i < 12; i++) {
      if (await pingBoard()) { await showConnected(); return true; }
      await wait(700);
    }
    showError('The calibrator didn\'t answer', 'Joined its WiFi, but the calibrator did not answer. ' +
              'Unplug it, plug it back in, wait for the blue light, and tap Try again.');
    return false;
  }

  // ── Search (the step before the join) ──────────────────────────────────────
  var SEARCHING = 'Searching for your calibrator…';
  /* the phone app: the WiFi permission first, with one line that says why */
  async function appPermission() {
    var W = window.Capacitor.Plugins.CapacitorWifiConnect;
    var perm = (await W.checkPermission()).value;
    if (perm === 'prompt' || perm === 'prompt-with-rationale') {
      showStatus('Allow the app to find the calibrator', 'Your phone asks for Location or "Nearby devices". ' +
                 'The app only uses it to find the calibrator’s WiFi.');
      perm = (await W.requestPermission()).value;
    }
    if (perm !== 'granted') {
      showError('Permission needed', 'Allow this app to use WiFi and Location so it can find the calibrator, then tap Try again. ' + MANUAL_HINT);
      return false;
    }
    return true;
  }
  /* Android: the plugin's scan (4 scans every 2 minutes; a throttled scan
     returns the phone's last list, status 1, with our patch). Answers
     { found, others } or { failed } or { code } */
  async function scanAndroid() {
    var W = window.Capacitor.Plugins.CapacitorWifiConnect;
    var res;
    try {
      res = await Promise.race([W.getSSIDs(), wait(15000).then(function () { return { timeout: true }; })]);
    } catch (e) { return { failed: true }; }
    if (!res || res.timeout) return { failed: true };
    if (res.status === -4) return { code: -4 };
    if (!Array.isArray(res.value)) return { failed: true };           // a permission refused mid-way (-2)
    var names = res.value.filter(function (n) { return typeof n === 'string' && n; });
    var found = names.indexOf(WIFI_NAME) >= 0;
    if (!found && !names.length) return { failed: true };              // nothing at all: the scan didn't happen
    return { found: found, others: names.filter(function (n) { return n !== WIFI_NAME; }).length };
  }
  /* the PC exe: Windows' own list (GET /zs/wifi/scan) */
  async function scanPc() {
    var r;
    try { r = await pcCall('GET', PC_SCAN, null, 15000); }
    catch (e) { return { failed: true }; }
    if (!r || !r.ok) return { pcError: r };
    var d = r.data || {};
    if (d.scanned === false) return { skip: true };                    // a Mac: no list, join directly
    return { found: !!d.found, others: d.others || 0, on: !!d.onCalibrator };
  }
  async function search() {
    showStatus(SEARCHING, onPhone() ? 'Looking at the WiFi networks near your phone.' : 'Looking at the WiFi networks near this PC.', 'Searching…');
    if (copyKey() === 'pc') {
      var p = await scanPc();
      if (p.pcError) { var x = explainPc(p.pcError); showError(x.t, x.d, x.fix); return; }
      if (p.skip || p.on) { await pcJoin(); return; }
      showFound(p);
      return;
    }
    var a = await scanAndroid();
    if (a.code) { var y = explainError(a.code); showError(y.t, y.d); return; }
    showFound(a);
  }

  // ── The joins ──────────────────────────────────────────────────────────────
  async function pcJoin() {
    showStatus('Joining ' + SHOW_NAME + '…', 'This PC will be on "' + WIFI_NAME + '" while you calibrate.');
    var r;
    try { r = await pcCall('POST', PC_JOIN, { ssid: WIFI_NAME }, 30000); }
    catch (e) { r = { ok: false, code: 'failed', error: 'The app could not reach its own WiFi helper.' }; }
    if (!r || !r.ok) { var x = explainPc(r); showError(x.t, x.d, x.fix); return; }
    pcJoined = true;
    if (r.data && r.data.previous) pcPrevious = r.data.previous;
    await checkBoard();
  }
  async function appJoin() {
    var W = window.Capacitor.Plugins.CapacitorWifiConnect;
    showStatus('Joining ' + SHOW_NAME + '…',
               (isIos() ? 'Your iPhone will ask to join "' + WIFI_NAME + '". Tap Join. '
                        : 'If your phone asks to connect to "' + WIFI_NAME + '", tap Connect. ') +
               'Keep your phone within 6 feet of the calibrator.');
    var res = await W.connect({ ssid: WIFI_NAME, saveNetwork: true });
    if (res.value !== 0) { var ex = explainError(res.value); showError(ex.t, ex.d); return; }
    appJoined = true;
    await checkBoard();
  }
  /* the person tapped the calibrator in the list (or "Join it anyway") */
  async function joinPicked() {
    if (connecting) return;
    connecting = true;
    try {
      if (mode() === 'pc') await pcJoin();
      else if (mode() === 'app') await appJoin();
    } catch (e) {
      showError('Something went wrong', (e && e.message ? e.message : String(e)) + '. Tap Try again.');
    } finally {
      connecting = false;
    }
  }

  /* fromTap: the person tapped Search / Connect / Try again. lost: the
     watchdog saw the calibrator stop answering mid-session. */
  async function connectFlow(fromTap, lost) {
    if (connecting) return;
    // Opened from the ZeroStick Dongle screen: it is the Bluetooth dongle.
    if (/[?&]from=dongle(&|$)/.test(location.search)) saveLink('ble');
    else if (LOCKED) saveLink(LOCKED);
    /* THE WIFI CALIBRATOR BY DEFAULT (owner, 2026-10-10): most players have
       it, the Bluetooth one has not launched. Nothing is asked; the screen
       offers "I have the new calibrator" instead. */
    var link = savedLink();
    if (link !== 'ble' && link !== 'wifi') { saveLink('wifi'); link = 'wifi'; }
    /* the new calibrator is hidden: a phone that once picked it is back on WiFi */
    if (!SHOW_NEW_CALIBRATOR && link === 'ble' && !/[?&]from=dongle(&|$)/.test(location.search)) {
      saveLink('wifi'); link = 'wifi';
    }
    connecting = true;
    try {
      if (link === 'ble') { await connectBle(fromTap); return; }
      // Already connected (joined by hand, or still on it)? Straight in.
      if (!listShown || fromTap) showStatus('Looking for your calibrator…', 'This can take a few seconds.');
      await detectPc();
      if (await pingBoard()) { await showConnected(); return; }
      var m = mode();

      if (m === 'browser') {
        // Plain browser: we can't join WiFi for the user — the steps say how.
        if (lost) showError('Lost the calibrator', 'This device left the "' + WIFI_NAME + '" WiFi, or the ' +
                            'calibrator lost power. Join it again in your WiFi settings, then tap Try again.');
        else if (fromTap) showError('Not on the calibrator\'s WiFi yet', 'Join "' + WIFI_NAME + '" in this ' +
                            'device\'s WiFi settings (no password), then tap Try again. ' + NEAR);
        else showIdle('Connect');
        return;
      }

      if (!fromTap) {
        // Not a tap: rejoin by itself only when the app already joined this
        // visit (or the calibrator dropped mid-session); otherwise wait for
        // Search. A list on screen stays (coming back from the WiFi settings).
        if (m === 'pc') {
          if (pcJoined) { await pcJoin(); return; }
          if (lost) showError('Lost the calibrator', 'It stopped answering. Check its blue light, then tap Try again.');
          else if (!listShown) showIdle();
          return;
        }
        if (appJoined || lost) {
          if (await appPermission()) await appJoin();
          return;
        }
        if (!listShown) showIdle();
        return;
      }

      // A tap on Search / Try again
      if (m === 'pc') { await search(); return; }
      if (!(await appPermission())) return;
      // iPhone: no list is possible; the system's join prompt IS the pick
      if (isIos()) { await appJoin(); return; }
      await search();
    } catch (e) {
      showError('Something went wrong', (e && e.message ? e.message : String(e)) + '. Tap Try again.');
    } finally {
      connecting = false;
    }
  }

  // ── Watchdog: if the WiFi drops mid-session, reconnect ─────────────────────
  var failCount = 0;
  setInterval(async function () {
    if (connecting) return;
    if (savedLink() !== 'wifi') return;                      // Bluetooth has its own disconnect event
    if (overlay && !overlay.hidden) return;                  // already showing
    if (await pingBoard()) { failCount = 0; return; }
    failCount++;
    if (failCount >= 3) {   // ~3 misses in a row = really disconnected
      failCount = 0;
      connectFlow(false, true);   // shows the screen + rejoins automatically (app, and the exe after a first join)
    }
  }, 4000);

  // For the back key (js/zs-cal-bar.js), the tests and the screenshots
  // (tools/theme-shots.js --pages draws each state with preview()).
  // as: 'pc' | 'browser' | 'android' | 'ios' (the words; nothing is joined)
  window.ZSCALWIFI = {
    leave: leave,
    mode: mode,
    busy: function () { return connecting; },
    connect: function () { return connectFlow(true); },
    preview: function (state, as) {
      if (as === 'pc') pc = pc || { supported: true };
      if (as === 'browser') pc = false;
      previewKey = (as === 'android' || as === 'ios') ? as : null;
      dressed = '';
      if (state === 'idle') showIdle();
      else if (state === 'permission') showStatus('Allow the app to find the calibrator', 'Your phone asks for Location or "Nearby devices". The app only uses it to find the calibrator’s WiFi.');
      else if (state === 'searching') showStatus(SEARCHING, onPhone() ? 'Looking at the WiFi networks near your phone.' : 'Looking at the WiFi networks near this PC.', 'Searching…');
      else if (state === 'found') showFound({ found: true, others: 6 });
      else if (state === 'none') { showFound({ found: false, others: 4 }); overlay.querySelector('#zsHelp').open = true; }
      else if (state === 'scan-failed') showFound({ failed: true });
      else if (state === 'joining') showStatus('Joining ' + SHOW_NAME + '…', as === 'ios' ? 'Your iPhone will ask to join "' + WIFI_NAME + '". Tap Join. Keep your phone within 6 feet of the calibrator.'
        : onPhone() ? 'If your phone asks to connect to "' + WIFI_NAME + '", tap Connect. Keep your phone within 6 feet of the calibrator.'
        : 'This PC will be on "' + WIFI_NAME + '" while you calibrate.');
      else if (state === 'checking') showStatus('Checking the calibrator…', 'This takes a few seconds.');
      else if (state === 'connected') { show(); reset(); doneEl.hidden = false; retryBtn.disabled = true; retryBtn.textContent = 'Connected'; }
      else if (state === 'not-found') { var x = explainPc({ code: 'not-found' }); showError(x.t, x.d); }
      else if (state === 'location') { var y = explainPc({ code: 'location' }); showError(y.t, y.d, y.fix); }
      else if (state === 'on-calibrator') { pcJoined = true; pcPrevious = 'Home WiFi'; hideOverlay(); }
    }
  };

  // ── Kick everything off ────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    buildOverlay();
    connectFlow();
    // Re-check every time the user switches back to the app
    if (isApp() && window.Capacitor.Plugins.App) {
      window.Capacitor.Plugins.App.addListener('resume', function () { connectFlow(); });
    }
  });
})();
