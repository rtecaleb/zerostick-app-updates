// ─────────────────────────────────────────────────────────────────────────────
//  app-connect.js — the calibrator's Connect screen and its WiFi auto-connect
//
//  This file is what makes the APP different from the web portal:
//    1. It defines espFetch() — every message to the board goes through here.
//       Inside the app it uses the phone's NATIVE http (via Capacitor), which
//       is allowed to talk to the board even though the board has no internet.
//    2. It finds + joins the original calibrator's WiFi network ITSELF, checks
//       it's really a ZeroStick board, and only then reveals the calibrator:
//         - in the phone app with the CapacitorWifiConnect plugin, after a
//           tap on Search (a drop after that rejoins by itself, on resume too);
//         - in the PC exe through the exe's own server (D273: POST
//           /zs/wifi/join runs netsh / networksetup, server.js + src/wifi.js),
//           after the person taps Search and picks it (it costs the PC its internet), and
//           back to the PC's own WiFi when they leave (ZSCALWIFI.leave, the
//           back key, the "Back to ..." line);
//         - in a plain browser it cannot, so step 3 says how to join by hand.
//    3. The NEW Bluetooth dongle (CH582F) skips all of the WiFi business: the
//       calibrator opened from the dongle hub (?from=dongle) remembers "ble",
//       the phone connects over Bluetooth (js/hid-ble.js), and hid-proxy.js
//       uses that link instead.
//
//  THE LOOK (D273, owner: "why do the new calibrator's instructions and
//  colouring look so much better"): the Connect screen is dongle.html's
//  Connect view - the calibrator's photo, "Connect your calibrator", three
//  numbered steps with the key words in bold, one small note, a big Connect
//  button docked at the bottom, a spinner line for progress and a red card
//  that says what went wrong and what to do. Styles: css/zs-cal-connect.css.
//
//  SEARCH -> PICK -> CONNECT -> STRAIGHT IN (owner, 2026-10-10: "you click
//  Search and it searches your WiFi and lets you choose ZeroStick
//  Calibrator, then it connects and pushes you into the app"):
//    - Android: Search asks for the WiFi/Location permission (one line says
//      why), scans with the plugin's getSSIDs(), and lists ONLY calibrators
//      (other networks are counted, never named). Tap "ZeroStick Calibrator"
//      -> connect() -> /info -> the calibrator page.
//    - iPhone: Apple lets no app list nearby WiFi. Search goes straight to
//      the system's "Join ZeroStick-Calibrator?" prompt (NEHotspot), then in.
//    - PC exe: Search asks GET /zs/wifi/scan (Windows' own list, netsh), the
//      same list, then the D273 join. A Mac cannot list: it joins directly.
//    - A plain browser cannot do any of it: unchanged (join by hand).
//  The board's network name is fixed in its firmware (never updated):
//  "ZeroStick-Calibrator", with a hyphen. It is SHOWN as "ZeroStick
//  Calibrator"; the hyphenated name appears only where the person has to
//  find it themselves (their WiFi list, the system's join prompt).
//  Nothing is joined on open any more: the app waits for Search. A drop
//  after the app joined (or mid-session) still rejoins by itself.
//
//  IMPORTANT: this script must load BEFORE js/hid-proxy.js (hid-proxy uses
//  espFetch). Check the <script> order in calibrator.html if you move things.
// ─────────────────────────────────────────────────────────────────────────────
(function () {
  'use strict';

  // ── Settings — match these to the firmware (see AP_SSID in the .ino) ───────
  var WIFI_NAME = 'ZeroStick-Calibrator'; // the WiFi network the board creates (its SSID)
  var SHOW_NAME = 'ZeroStick Calibrator'; // how the app names it
  var BOARD_URL = 'http://192.168.4.1';   // the board's fixed address on that network
  var PING_PATH = '/info';                // endpoint that proves "this is our board"
  // The PC exe's own WiFi routes (server.js, D273). Web addresses on this
  // page's own server, not files: the isolation test knows them.
  var PC_STATUS = '/zs/wifi/status';
  var PC_JOIN = '/zs/wifi/join';
  var PC_RESTORE = '/zs/wifi/restore';
  var PC_LOCATION = '/zs/wifi/location-settings';
  var PC_SCAN = '/zs/wifi/scan';

  // Are we running inside the real app (true) or a normal browser tab (false)?
  function isApp() {
    return !!(window.Capacitor && window.Capacitor.isNativePlatform &&
              window.Capacitor.isNativePlatform());
  }
  // Inside the app: an iPhone/iPad (no WiFi scanning allowed) or not
  function isIos() {
    return isApp() && !!(window.Capacitor.getPlatform && window.Capacitor.getPlatform() === 'ios');
  }
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

  // ── espFetch: send one request to the board ────────────────────────────────
  //  Returns an object that looks like a normal fetch() response (has .ok,
  //  .text(), .json()) so hid-proxy.js can use it without caring which path
  //  the request actually took.
  window.espFetch = async function (path) {
    var url = BOARD_URL + path;
    if (isApp()) {
      // Native request — goes out over the WiFi connection the app created,
      // and isn't blocked by the browser's "no http from an app page" rule.
      var res = await window.Capacitor.Plugins.CapacitorHttp.request({
        url: url,
        method: 'GET',
        responseType: 'text',
        connectTimeout: 4000,
        readTimeout: 4000
      });
      var asText = (typeof res.data === 'string') ? res.data : JSON.stringify(res.data);
      return {
        ok: res.status >= 200 && res.status < 300,
        status: res.status,
        text: async function () { return asText; },
        json: async function () {
          return (typeof res.data === 'string') ? JSON.parse(res.data) : res.data;
        }
      };
    }
    // Browser / PC exe: the PC is on the board's WiFi (joined by the exe or
    // by hand), so the board answers directly
    return fetch(url);
  };

  // ── Ping: is the board reachable AND really a ZeroStick calibrator? ────────
  async function pingBoard() {
    try {
      // 4 s at most, like the app's native request: a PC with no route to
      // 192.168.4.1 can otherwise wait out the browser's own ~20 s timeout
      var r = await Promise.race([window.espFetch(PING_PATH),
        wait(4000).then(function () { throw new Error('timeout'); })]);
      if (!r.ok) return false;
      var info = await r.json();
      return info && info.device === 'zerostick-calibrator';
    } catch (e) {
      return false;
    }
  }

  // ── Which dongle: 'ble' (new) or 'wifi' (older), remembered per phone ─────
  var LINK_KEY = 'zsdongle:zsCalibratorLink';
  /* THE NEW (BLUETOOTH) CALIBRATOR IS HIDDEN (owner, 2026-10-10: "get rid of
     the 'I have the new calibrator' option in the app, forget that for
     now"). Nothing offers it: the Connect screen has no link to it and a
     saved 'ble' choice is treated as the WiFi calibrator. Opened from the
     dongle screen itself (?from=dongle) it still works, but nothing in the
     app leads there. Set true to bring it back. */
  var SHOW_NEW_CALIBRATOR = true;   /* owner, 2026-10-22: back on, to test the Bluetooth dongle (DSE session) */
  function savedLink() {
    try { return localStorage.getItem(LINK_KEY); } catch (e) { return null; }
  }
  function saveLink(v) {
    try { localStorage.setItem(LINK_KEY, v); } catch (e) { /* private mode: ask again next time */ }
  }
  /* D445 (owner, 2026-10-23): the device list now asks "which calibrator do
     you have?" and opens this page with ?link=wifi. That choice is LOCKED for
     this visit: it overrides a remembered 'ble' and the screen offers no
     switch to the other calibrator (the owner picked one; it must not land
     on the Bluetooth screen with WiFi as a link at the bottom). */
  var LOCKED = (/[?&]link=(wifi|ble)(&|$)/.exec(location.search) || [])[1] || null;
  if (LOCKED) saveLink(LOCKED);

  // ── The PC exe's WiFi routes ───────────────────────────────────────────────
  //  null = not asked yet; false = not the exe (a plain browser, or a server
  //  that cannot change WiFi); otherwise the exe's last /zs/wifi/status.
  var pc = null;
  var pcJoined = false;        // this visit, the exe put the PC on the calibrator
  var pcPrevious = '';         // the PC's own network, to go back to
  function pcCall(method, path, body, ms) {
    var ctl = (typeof AbortController === 'function') ? new AbortController() : null;
    var timer = ctl ? setTimeout(function () { ctl.abort(); }, ms || 4000) : 0;
    var opt = { method: method, headers: { 'X-ZS-App': '1' } };
    if (body) { opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(body); }
    if (ctl) opt.signal = ctl.signal;
    if (method === 'POST') opt.keepalive = true;
    return fetch(path, opt).then(function (r) {
      if (timer) clearTimeout(timer);
      var type = (r.headers && r.headers.get && r.headers.get('content-type')) || '';
      if (!/json/.test(type)) throw new Error('not the exe');
      return r.json();
    }, function (e) { if (timer) clearTimeout(timer); throw e; });
  }
  async function detectPc() {
    if (pc !== null) return pc;
    if (isApp()) { pc = false; return pc; }
    try {
      var j = await pcCall('GET', PC_STATUS, null, 3000);
      pc = (j && j.ok && j.data && j.data.supported) ? j.data : false;
    } catch (e) { pc = false; }
    if (pc && pc.joinedByApp) { pcJoined = true; pcPrevious = pc.previous || ''; }
    return pc;
  }
  function mode() {
    if (savedLink() === 'ble') return 'ble';
    if (isApp()) return 'app';
