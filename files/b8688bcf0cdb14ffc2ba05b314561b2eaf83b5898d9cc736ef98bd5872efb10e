      foundEl, foundT, listEl, foundNote, anywayBtn, helpList;

  var PHOTO = '<img id="zsPic" src="assets/zs-dongle.webp" alt="The ZeroStick Calibrator">';
  var DONGLE_ART = '<div class="art"><svg width="78" height="78" viewBox="0 0 24 24" fill="none" ' +
    'stroke="#6f9bff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<path d="M1.7 10.1h3.9v3.8H1.7z"/><path d="M3 11.4v1.2"/>' +
    '<rect x="5.6" y="6.9" width="16.5" height="10.2" rx="1.3"/>' +
    '<rect x="8.1" y="9.5" width="5.1" height="5" rx=".7"/>' +
    '<path d="M15.8 9.7v4.6M18.5 9.7v4.6"/></svg></div>';
  var WIFI_ICON = '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
    'stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<path d="M2 8.8a15 15 0 0 1 20 0"/><path d="M5 12.3a10 10 0 0 1 14 0"/><path d="M8.5 15.8a5 5 0 0 1 7 0"/>' +
    '<circle cx="12" cy="19.3" r="1.1" fill="currentColor"/></svg>';
  var CHEVRON = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
    'stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';

  /* the steps and the note, per way of connecting */
  var POWER = '<li><span>Plug the calibrator into your <b>PS5</b> or any <b>USB charger</b>. Wait for its <b>blue light</b>.</span></li>' +
              '<li><span>Plug your <b>controller</b> into the calibrator with its USB cable.</span></li>';
  var TITLE = 'Connect your ZeroStick Calibrator';
  var COPY = {
    android: {
      title: TITLE,
      steps: POWER + '<li><span>Tap <b>Search</b>, then tap <b>ZeroStick Calibrator</b>. The app joins its WiFi and opens it.</span></li>',
      note: 'Your phone may ask to allow Location or "Nearby devices". Tap <b>Allow</b>, it’s only used to find the calibrator’s WiFi.'
    },
    ios: {
      title: TITLE,
      steps: POWER + '<li><span>Tap <b>Search</b>. When your iPhone asks to join <b>ZeroStick-Calibrator</b>, tap <b>Join</b>.</span></li>',
      note: 'iPhones don’t let apps show a list of nearby WiFi, so your iPhone asks you to join the calibrator’s WiFi directly. ' +
            'It has no internet, so your phone is offline while you calibrate.'
    },
    pc: {
      title: TITLE,
      steps: POWER + '<li><span>Tap <b>Search</b>, then pick <b>ZeroStick Calibrator</b>. The app joins its WiFi for you.</span></li>',
      note: 'While you calibrate, this PC is on the calibrator’s WiFi, so it has <b>no internet</b>. ' +
            'The app puts it back on your own WiFi when you leave.'
    },
    browser: {
      title: TITLE,
      steps: POWER + '<li><span>Open this device’s WiFi settings and join <b>ZeroStick-Calibrator</b> ' +
             '(no password). Then come back and tap <b>Connect</b>.</span></li>',
      note: 'The calibrator’s WiFi has no internet, so this device is offline while it’s on it. ' +
            'The ZeroStick app joins it for you.'
    },
    ble: {
      title: 'Connect your ZeroStick Dongle',
      steps: '<li><span>Plug the dongle into your <b>PS5</b> or any <b>USB charger</b>. Its light comes on.</span></li>' +
             '<li><span>Plug your <b>controller</b> into the dongle with its USB cable.</span></li>' +
             '<li><span>Keep your phone close, tap <b>Connect</b>, and choose <b>ZeroStick Dongle</b>.</span></li>',
      note: 'Your phone may ask to allow Bluetooth or "Nearby devices". Tap <b>Allow</b>, it’s only used to reach the dongle.'
    }
  };
  /* the "Not finding it?" fold under the search list */
  function helpItems() {
    var who = onPhone() ? 'your phone' : 'this PC';
    var where = onPhone() ? 'your phone’s WiFi settings' : 'the WiFi button in the bottom-right corner of Windows';
    return '<li>Check the calibrator’s <b>blue light</b> is on. Its WiFi can take up to 30 seconds to appear after you plug it in.</li>' +
           '<li>Keep ' + who + ' within 6 feet of it.</li>' +
           '<li>It shows in ' + where + ' as <b>ZeroStick-Calibrator</b>. You can join it there yourself, then come back and tap <b>Search again</b>.</li>';
  }

  function buildOverlay() {
    overlay = document.createElement('div');
    overlay.id = 'zsConnectOverlay';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-labelledby', 'zsTitle');
    overlay.innerHTML =
      '<div class="shell">' +
        /* the owner's photo of the WiFi calibrator (2026-10-10): the default,
           because most players have this one */
        '<div class="hero" id="zsHero">' + PHOTO + '</div>' +
        '<h1 id="zsTitle">' + TITLE + '</h1>' +
        '<div class="status" id="zsBusy" hidden role="status" aria-live="polite">' +
          '<div class="spin" aria-hidden="true"></div>' +
          '<div><span id="zsStatus">Connecting…</span><span class="sub" id="zsSub"></span></div></div>' +
        '<div class="done" id="zsDone" hidden role="status"><span class="tick"><svg width="18" height="18" ' +
          'viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="3" stroke-linecap="round" ' +
          'stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>' +
          '<span>Connected</span></div>' +
        '<div class="err" id="zsErr" hidden role="alert"><b id="zsErrT"></b><span id="zsErrD"></span>' +
          '<button class="btn second" id="zsFix" type="button" hidden></button></div>' +
        /* the Search list: only calibrators, the person taps one */
        '<section class="found" id="zsFound" hidden aria-labelledby="zsFoundT">' +
          '<h2 id="zsFoundT">Calibrators near you</h2>' +
          '<div class="list" id="zsList" role="list"></div>' +
          '<button class="btn second" id="zsAnyway" type="button" hidden>Join ' + SHOW_NAME + ' anyway</button>' +
          '<p class="hint" id="zsFoundNote" hidden></p>' +
          '<details class="help" id="zsHelp"><summary>Not finding it?</summary><ul id="zsHelpList"></ul></details>' +
        '</section>' +
        '<ol class="steps" id="zsSteps"></ol>' +
        '<p class="hint" id="zsNote"></p>' +
        '<div class="stack">' +
          '<button class="btn plain" id="zsSwitch" type="button" hidden>I have the ZeroStick Calibrator (WiFi)</button>' +
          /* WiFi is the default; this is the way to the new one (owner: "it
             would be ALL black if it's the new one, you'd know") */
          '<button class="btn plain" id="zsNew" type="button">I have the new calibrator <span class="faint">(it\'s all black)</span></button>' +
        '</div>' +
      '</div>' +
      '<div class="dock"><div class="in"><button class="btn primary" id="zsRetry" type="button">Connect</button></div></div>';
    document.body.appendChild(overlay);
    var q = function (id) { return overlay.querySelector('#' + id); };
    statusEl = q('zsStatus'); subEl = q('zsSub'); busyEl = q('zsBusy'); doneEl = q('zsDone');
    errEl = q('zsErr'); errT = q('zsErrT'); errD = q('zsErrD'); fixBtn = q('zsFix');
    retryBtn = q('zsRetry'); switchBtn = q('zsSwitch'); newBtn = q('zsNew');
    heroEl = q('zsHero'); titleEl = q('zsTitle'); stepsEl = q('zsSteps'); noteEl = q('zsNote');
    foundEl = q('zsFound'); foundT = q('zsFoundT'); listEl = q('zsList'); foundNote = q('zsFoundNote');
    anywayBtn = q('zsAnyway'); helpList = q('zsHelpList');
    /* the new calibrator is the Bluetooth dongle: its own screen */
    newBtn.addEventListener('click', function () { location.href = 'dongle.html'; });
    retryBtn.addEventListener('click', function () { connectFlow(true); });
    fixBtn.addEventListener('click', function () { if (fixAction) fixAction(); });
    anywayBtn.addEventListener('click', function () { joinPicked(); });
    /* on the Bluetooth link, "a different calibrator" is the WiFi one */
    switchBtn.addEventListener('click', function () { saveLink('wifi'); dress(); connectFlow(true); });
