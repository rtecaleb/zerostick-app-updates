  function onPhone() { var k = copyKey(); return k === 'android' || k === 'ios'; }

  // ── The Connect screen ─────────────────────────────────────────────────────
  var overlay, statusEl, subEl, busyEl, doneEl, errEl, errT, errD, fixBtn,
