/* zs-dongle.css - the ZeroStick Calibration Dongle screens (dongle.html).
 *
 * Moved into the EXO app on 2026-10-10 (D264) from the phone app's
 * www/dongle.html <style> (zerostick-app 2bba734), and restyled to the EXO
 * app's 8K flat look (D259). The palette is css/zs-dongle-theme.css, the
 * dongle's OWN copy of the EXO tokens, never a link to the EXO's file
 * (dongle/README.md). Solid surfaces, one 1px hairline, one blue, no
 * gradients, glows, frosted glass or left rails. Layout and class names are
 * unchanged, so zs-dongle-app.js draws into it exactly as before.
 *
 * Accessibility first (the owner is disabled and so are many buyers): every
 * target >= 56 px tall, text >= 4.5:1, sliders also have - / + buttons, the
 * main action sits at the bottom for one thumb, the page fits 360 px with no
 * sideways scroll, and every explanation lives behind a "?".
 */
*{box-sizing:border-box; margin:0; padding:0;}
html,body{min-height:100%;}
body{
  background:var(--zs-page); color:var(--fg);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI Variable Text",
    "Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  font-size:17px; line-height:1.45; overflow-x:hidden;
  -webkit-font-smoothing:antialiased; -webkit-text-size-adjust:100%;
}
button,input{font:inherit; color:inherit;}
button{background:none; border:0; cursor:pointer; -webkit-tap-highlight-color:transparent;}
button:disabled{cursor:default;}
:focus-visible{outline:3px solid var(--ion); outline-offset:2px; border-radius:10px;}
[hidden]{display:none !important;}

/* ── top bar ─────────────────────────────────────────────────────── */
#bar{
  position:sticky; top:0; z-index:20; display:flex; align-items:center; gap:6px;
  padding:calc(var(--top) + 8px) 10px 8px; background:var(--zs-page);
  border-bottom:1px solid var(--line);
}
#back{width:56px; height:56px; border-radius:12px; display:grid; place-items:center; flex:0 0 56px;}
#back:active{background:var(--zs-raised);}
#title{flex:1; min-width:0; font-size:19px; font-weight:700; letter-spacing:var(--tr-title);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
#linkchip{flex:0 0 auto; margin-right:6px;}

.shell{max-width:560px; margin:0 auto; padding:18px 16px calc(var(--bot) + 120px);}
.view{animation:in .22s var(--ease);}
@keyframes in{from{opacity:0; transform:translateY(6px);}}
@media (prefers-reduced-motion:reduce){.view{animation:none;} *{transition:none !important;}}

h1{font-size:26px; font-weight:700; letter-spacing:var(--tr-title); line-height:1.2;}
h2{font-size:13px; font-weight:700; letter-spacing:var(--tr-label); text-transform:uppercase;
  color:var(--muted); margin:26px 4px 10px;}
p.lead{color:var(--muted); margin-top:8px;}

.card{background:var(--zs-card); border-radius:12px; padding:16px 18px; border:1px solid var(--line);}
.card + .card{margin-top:12px;}

.chip{display:inline-flex; align-items:center; gap:7px; font-size:12px; font-weight:700;
  letter-spacing:var(--tr-label); text-transform:uppercase; padding:6px 11px;
  border-radius:999px; white-space:nowrap; background:var(--zs-control); color:var(--muted);
  border:1px solid var(--line);}
.chip .dot{width:9px; height:9px; border-radius:50%; background:currentColor;}
.chip.ok{background:var(--ok-wash); color:var(--ok); border-color:transparent;}
.chip.warn{background:var(--warn-wash); color:var(--warn); border-color:transparent;}
.chip.bad{background:var(--bad-wash); color:var(--bad); border-color:transparent;}
.chip.ion{background:var(--ion-wash); color:var(--ion); border-color:transparent;}

/* ── buttons ─────────────────────────────────────────────────────── */
.btn{display:flex; align-items:center; justify-content:center; gap:10px; width:100%;
  min-height:60px; padding:14px 20px; border-radius:12px; font-size:18px; font-weight:700;
  letter-spacing:var(--tr-title); transition:transform 90ms var(--ease);}
.btn:active:not(:disabled){transform:scale(.98);}
.btn.primary{background:var(--ion); color:var(--ion-ink); border:1px solid var(--ion);}
.btn.primary:disabled{background:var(--zs-control); color:var(--faint); border-color:var(--line);}
.btn.second{background:var(--zs-control); color:var(--fg); border:1px solid var(--line);}
.btn.danger{background:transparent; color:var(--bad); border:1px solid var(--bad-edge);}
.btn.plain{min-height:56px; color:var(--muted); font-weight:600; font-size:16px; text-decoration:underline;
  text-underline-offset:3px;}
.stack{display:flex; flex-direction:column; gap:12px;}
.row2{display:flex; gap:12px;} .row2 > *{flex:1; min-width:0;}

/* sticky action bar at the bottom: thumb reach (solid, a hairline on top) */
.dock{position:fixed; left:0; right:0; bottom:0; z-index:15;
  padding:12px 16px calc(var(--bot) + 12px); background:var(--zs-page); border-top:1px solid var(--line);}
.dock .in{max-width:560px; margin:0 auto;}

/* ── connect view ────────────────────────────────────────────────── */
.hero{display:grid; place-items:center; margin:8px 0 18px;}
.hero .art{width:128px; height:128px; border-radius:16px; background:var(--zs-card);
  display:grid; place-items:center; border:1px solid var(--line);}
.steps{list-style:none; counter-reset:s; margin-top:18px;}
.steps li{counter-increment:s; display:flex; gap:14px; align-items:flex-start; padding:12px 0;}
.steps li::before{content:counter(s); flex:0 0 34px; height:34px; border-radius:50%;
  background:var(--zs-card); color:var(--fg); font-weight:700; display:grid; place-items:center;
  border:1px solid var(--line);}
.status{display:flex; gap:14px; align-items:center; margin-top:16px;}
.spin{width:30px; height:30px; flex:0 0 30px; border-radius:50%; border:4px solid var(--zs-control);
  border-top-color:var(--ion); animation:spin 1s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.err{border:1px solid var(--bad-edge); background:var(--zs-card);}
.err b{display:block; font-size:18px; color:var(--bad); margin-bottom:4px;}

/* ── hub ─────────────────────────────────────────────────────────── */
.devhead{display:flex; align-items:center; gap:14px;}
.devhead .glyph{flex:0 0 56px; height:56px; border-radius:12px; background:var(--zs-control);
  display:grid; place-items:center; border:1px solid var(--line);}
.devhead .nm{font-size:19px; font-weight:700; letter-spacing:var(--tr-title);}
.devhead .sub{color:var(--muted); font-size:14.5px;}
.facts{margin-top:14px; border-top:1px solid var(--line);}
.fact{display:flex; align-items:center; gap:12px; padding:13px 0; border-bottom:1px solid var(--line-soft);}
.fact:last-child{border-bottom:0; padding-bottom:2px;}
.fact .k{flex:1; color:var(--muted);}
.fact .v{font-weight:650; text-align:right;}
.choice{width:100%; display:flex; align-items:center; gap:16px; text-align:left; min-height:116px;
  background:var(--zs-card); border-radius:12px; padding:18px; border:1px solid var(--line);
  transition:transform 90ms var(--ease);}
.choice + .choice{margin-top:12px;}
.choice:active{transform:scale(.98); border-color:var(--ion);}
.choice .ic{flex:0 0 64px; height:64px; border-radius:12px; display:grid; place-items:center;
  background:var(--ion-wash); border:1px solid var(--ion-edge);}
.choice .tx{flex:1; min-width:0;}
.choice .eb{font-size:11.5px; font-weight:700; letter-spacing:var(--tr-label); text-transform:uppercase; color:var(--ion);}
.choice .t{font-size:21px; font-weight:700; letter-spacing:var(--tr-title); line-height:1.2;}
.choice .d{color:var(--muted); font-size:15px; margin-top:3px;}

/* ── scripts ─────────────────────────────────────────────────────── */
.linkcard{display:flex; gap:14px; align-items:flex-start;}
.linkcard .big{flex:0 0 48px; height:48px; border-radius:12px; display:grid; place-items:center;}
.linkcard .t{font-size:18px; font-weight:700;}
.linkcard .d{color:var(--muted); font-size:15px; margin-top:2px;}
.linkcard .act{margin-top:12px;}
.switchrow{display:flex; align-items:center; gap:14px; min-height:64px; width:100%; text-align:left;}
.switchrow .tx{flex:1; min-width:0;}
.switchrow .t{font-size:18px; font-weight:700;}
.switchrow .d{color:var(--muted); font-size:14.5px;}
.sw{flex:0 0 68px; height:40px; border-radius:999px; background:var(--zs-control);
  border:1px solid var(--line); position:relative; transition:background .18s;}
.sw::after{content:""; position:absolute; top:4px; left:4px; width:30px; height:30px; border-radius:50%;
  background:var(--knob); transition:transform .2s var(--ease), background .2s;}
[aria-checked="true"] .sw{background:var(--ion); border-color:var(--ion);}
[aria-checked="true"] .sw::after{transform:translateX(28px); background:var(--thumb);}

.live{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:12px;}
.live div{min-height:64px; border-radius:10px; background:var(--zs-page); border:1px solid var(--line);
  display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
  color:var(--faint); font-weight:700; font-size:15px; transition:all .12s;}
.live div small{font-weight:600; font-size:12px; letter-spacing:.02em;}
.live div.on{color:var(--fg); background:var(--zs-raised); border-color:var(--line);}
.live div.on.aim{background:var(--ion-wash); border-color:var(--ion); color:var(--ion);}
.live div.on.recoil{background:var(--fire-wash); border-color:var(--fire); color:var(--fire);}
.hint{color:var(--muted); font-size:14.5px; margin-top:10px;}

.slots{display:flex; flex-direction:column; gap:10px;}
.slot{display:flex; align-items:stretch; background:var(--zs-card); border-radius:12px;
  border:1px solid var(--line); overflow:hidden;}
/* the chosen script: a blue outline and a blue wash (no left rail, D259) */
.slot.sel{border-color:var(--ion); background:var(--ion-wash);}
.slot .main{flex:1; min-width:0; min-height:72px; text-align:left; padding:12px 8px 12px 18px; display:flex;
  flex-direction:column; justify-content:center;}
.slot .main:active{background:var(--zs-raised);}
.slot .n{font-size:17.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.slot .s{color:var(--muted); font-size:14.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.slot .s.empty{font-style:italic;}
.slot .use{flex:0 0 92px; display:grid; place-items:center; border-left:1px solid var(--line);
  font-weight:700; font-size:15px; color:var(--ion);}
.slot .use:active{background:var(--zs-raised);}
.slot .use.inuse{color:var(--ok); font-size:13px; letter-spacing:var(--tr-label); text-transform:uppercase;}
.menu{display:flex; align-items:center; gap:14px; width:100%; min-height:64px; padding:10px 18px; text-align:left;
  background:var(--zs-card); border-radius:12px; border:1px solid var(--line);}
.menu + .menu{margin-top:10px;}
.menu .tx{flex:1; min-width:0;}
.menu .t{font-weight:700;}
.menu .d{color:var(--muted); font-size:14.5px;}
.menu:active{background:var(--zs-raised);}

/* ── editor ──────────────────────────────────────────────────────── */
.namebox{width:100%; min-height:60px; padding:12px 16px; border-radius:12px; background:var(--zs-control);
  border:1px solid var(--line); font-size:20px; font-weight:700;}
.namebox:focus{outline:none; border-color:var(--ion);}
.presets{display:flex; flex-wrap:wrap; gap:8px;}
.pre{min-height:56px; padding:10px 18px; border-radius:999px; background:var(--zs-control);
  border:1px solid var(--line); font-weight:700; font-size:16px;}
.pre[aria-pressed="true"]{background:var(--ion-wash); border-color:var(--ion); color:var(--ion);}
.pre:active{transform:scale(.97);}
.plab{color:var(--muted); font-size:13px; font-weight:700; letter-spacing:var(--tr-label);
  text-transform:uppercase; margin:14px 2px 8px;}
.plab:first-child{margin-top:0;}

.ctl{padding:14px 0; border-bottom:1px solid var(--line-soft);}
.ctl:last-child{border-bottom:0; padding-bottom:4px;}
.ctl:first-child{padding-top:4px;}
.ctl .top{display:flex; align-items:baseline; gap:10px;}
.ctl .lab{flex:1; min-width:0; font-weight:700; font-size:17px;}
.ctl .val{font-weight:700; font-size:20px; color:var(--ion); font-variant-numeric:tabular-nums; text-align:right;}
.ctl .help{color:var(--muted); font-size:14.5px; margin-top:2px;}
.ctl.off .val{color:var(--faint);}
.ctl.off{opacity:.55;}
.slider{display:flex; align-items:center; gap:10px; margin-top:10px;}
.step{flex:0 0 56px; height:56px; border-radius:12px; background:var(--zs-control); border:1px solid var(--line);
  font-size:26px; font-weight:700; line-height:1; display:grid; place-items:center;}
.step:active:not(:disabled){background:var(--zs-raised);}
input[type=range]{flex:1; min-width:0; -webkit-appearance:none; appearance:none; height:56px; background:transparent;}
/* the filled part of the track is the one place a two-stop background is
   used, and both stops are flat colours meeting at the value (no blend) */
input[type=range]::-webkit-slider-runnable-track{height:8px; border-radius:4px;
  background:linear-gradient(90deg,var(--ion) var(--p,0%),var(--zs-raised) var(--p,0%));}
input[type=range]::-moz-range-track{height:8px; border-radius:4px; background:var(--zs-raised);}
input[type=range]::-moz-range-progress{height:8px; border-radius:4px; background:var(--ion);}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none; width:30px; height:30px; margin-top:-11px;
  border-radius:50%; background:var(--thumb); border:3px solid var(--ion);}
input[type=range]::-moz-range-thumb{width:26px; height:26px; border-radius:50%; background:var(--thumb); border:3px solid var(--ion);}
input[type=range].center::-webkit-slider-runnable-track{
  background:linear-gradient(90deg,var(--zs-raised) calc(50% - 1px),var(--line) calc(50% - 1px),var(--line) calc(50% + 1px),var(--zs-raised) calc(50% + 1px));}
.seg{display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-top:10px; padding:5px;
  background:var(--zs-control); border-radius:12px; border:1px solid var(--line);}
.seg button{min-height:56px; border-radius:9px; font-weight:700; color:var(--muted);}
.seg button[aria-checked="true"]{background:var(--ion-wash); color:var(--ion); box-shadow:inset 0 0 0 1px var(--ion);}

/* ── sheet + toast ───────────────────────────────────────────────── */
#scrim{position:fixed; inset:0; z-index:40; background:var(--scrim); display:flex; align-items:flex-end; justify-content:center;}
#sheet{width:100%; max-width:560px; background:var(--zs-card); border-radius:16px 16px 0 0;
  border:1px solid var(--line); border-bottom:0;
  padding:22px 18px calc(var(--bot) + 18px);
  animation:up .26s var(--ease); max-height:92vh; overflow:auto;}
@keyframes up{from{transform:translateY(40px);}}
#sheet h1{font-size:23px;}
#sheet .body{color:var(--muted); margin:10px 0 18px;}
#sheet .body b{color:var(--fg);}
.pairart{display:grid; place-items:center; margin:6px 0 14px;}
.pairart svg{max-width:100%; height:auto;}
#toast{position:fixed; left:16px; right:16px; bottom:calc(var(--bot) + 96px); z-index:50; max-width:528px;
  margin:0 auto; background:var(--toast-bg); color:var(--toast-ink); font-weight:650; border-radius:12px; padding:14px 18px;
  transition:opacity .2s, transform .2s;}
#toast.hide{opacity:0; transform:translateY(10px); pointer-events:none;}
#toast.bad{background:var(--toast-bad); color:var(--zs-page);}
/* "?" = explanations and raw numbers live behind it (owner rule: never deleted) */
.qbtn{flex:0 0 44px; width:44px; height:44px; border-radius:50%; background:var(--zs-control);
  border:1px solid var(--line); color:var(--muted); font-weight:700; font-size:18px; display:grid; place-items:center;}
.qbtn[aria-expanded="true"]{color:var(--ion); border-color:var(--ion);}
.more{margin-top:10px; padding:12px 14px; border-radius:10px; background:var(--zs-control);
  border:1px solid var(--line); color:var(--muted); font-size:14.5px; line-height:1.6;}
.more b{color:var(--fg); font-weight:650;}
.faint{color:var(--faint);}
.note{font-size:14.5px; margin-top:6px;}
.warnline{margin-top:10px; color:var(--warn); font-size:14.5px; font-weight:600;}
.bar{height:12px; border-radius:6px; background:var(--zs-raised); overflow:hidden; margin-top:12px;}
.bar > div{height:100%; width:0; background:var(--ion); transition:width .25s var(--ease);}
.bar.big{height:20px; border-radius:10px;}
.pct{font-size:44px; font-weight:700; letter-spacing:var(--tr-title); font-variant-numeric:tabular-nums; margin-top:18px;}
.dontunplug{display:flex; gap:12px; align-items:flex-start; padding:14px 16px; border-radius:12px;
  background:var(--warn-wash); border:1px solid var(--warn-edge); color:var(--warn-ink); font-weight:600; margin-top:18px;}
.sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);}

/* the calibrator on this page (zs-dongle-app.js openCal): a full-screen frame */
#calframe{position:fixed; inset:0; width:100%; height:100%; border:0; z-index:50; background:var(--zs-page);}
body.cal-open{overflow:hidden;}
