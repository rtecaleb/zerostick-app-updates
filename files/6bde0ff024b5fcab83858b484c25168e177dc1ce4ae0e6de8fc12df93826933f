/* smart-actions/20-in-place.js — THE SCRIPTS EDITOR, IN PLACE (D79).
 *
 * The editor drawn in the screen itself, a step's numbers one slider at a time,
 * and the three doors in: render (Scripts), renderInputs (Mappings) and
 * renderScoped (one weapon's AI Scripts, D122).
 *
 * Tests: test-smart-actions.js, test-auto-actions.js, test-auto-links.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('in-place', function (SEC) {
  'use strict';
  /* from the parts before this one */
  var armConfirm = SEC.armConfirm, clamp = SEC.clamp, clone = SEC.clone,
      configNumberTop = SEC.configNumberTop, defaultStep = SEC.defaultStep,
      DPS_MAX = SEC.DPS_MAX, emitSource = SEC.emitSource, esc = SEC.esc,
      hydrate = SEC.hydrate, intOf = SEC.intOf, newAction = SEC.newAction,
      normAction = SEC.normAction, normStep = SEC.normStep, num = SEC.num,
      saFor = SEC.saFor, saveAll = SEC.saveAll, STEP_MS_CAP = SEC.STEP_MS_CAP,
      TAP_MS_MIN = SEC.TAP_MS_MIN, TARGET_OK = SEC.TARGET_OK, VIEW = SEC.VIEW, ZS = SEC.ZS,
      stepLine = SEC.stepLine, MARK_AIM = SEC.MARK_AIM, MARK_CONFIG = SEC.MARK_CONFIG,
      MARK_SENS = SEC.MARK_SENS, MARK_SWAP = SEC.MARK_SWAP, MARK_WAIT = SEC.MARK_WAIT,
      sicon = SEC.sicon, stepTile = SEC.stepTile, stripHTML = SEC.stripHTML,
      tileBody = SEC.tileBody, totalChip = SEC.totalChip,
      isRecoilAction = SEC.isRecoilAction, openWorkshop = SEC.openWorkshop,
      catAllowed = SEC.catAllowed, errorsHTML = SEC.errorsHTML, MK_TAG = SEC.MK_TAG,
      repeatBadge = SEC.repeatBadge, openStepSheet = SEC.openStepSheet,
      pickTrigger = SEC.pickTrigger, readShareCode = SEC.readShareCode,
      shareCode = SEC.shareCode, rowFor = SEC.rowFor, rowName = SEC.rowName,
      rowTarget = SEC.rowTarget, kbPageHTML = SEC.kbPageHTML, keyHTML = SEC.keyHTML,
      MARK_HOLDSTEP = SEC.MARK_HOLDSTEP, MARK_RELEASE = SEC.MARK_RELEASE,
      mousePageHTML = SEC.mousePageHTML, padTargetPageHTML = SEC.padTargetPageHTML,
      stickPageHTML = SEC.stickPageHTML, deckHTML = SEC.deckHTML, wireDeck = SEC.wireDeck,
      backToEditor = SEC.backToEditor, ctlSeg = SEC.ctlSeg,
      openNameSheet = SEC.openNameSheet, openSeqListSheet = SEC.openSeqListSheet,
      selIndex = SEC.selIndex, seqSwitchHTML = SEC.seqSwitchHTML,
      sheetIsOpen = SEC.sheetIsOpen, swapOuter = SEC.swapOuter,
      openHelpersSheet = SEC.openHelpersSheet, openTagSheet = SEC.openTagSheet,
      openTimingSheet = SEC.openTimingSheet, openWhenSheet = SEC.openWhenSheet,
      draw = SEC.draw, panelBody = SEC.panelBody, panelDismiss = SEC.panelDismiss,
      panelIsOpen = SEC.panelIsOpen, wireInputCommon = SEC.wireInputCommon;

  /* ══════════════════════════════════════════════════════════════════
     THE SMART ACTIONS EDITOR, IN PLACE (D79)
     ══════════════════════════════════════════════════════════════════

     Owner (2026-09-05, with XIM Matrix screenshots): "when you click that
     smart actions button it takes the sub menu and keeps it in place but
     transforms it with these added options, and you can scroll down in that
     sub menu and see the other added options on the screen now; and as I
     click the new options added for smart actions look how they populate
     that little box up top and the box expands to fit the smart action, and
     I can click an action in the box and move or delete it or edit it" —
     "notice this is all in a sub menu in mappings."

     So S.mode === 'smart' is the SAME screen (inputScreenHTML, the same
     #dbody, the same head with the Behaves pill) and the body under the
     head is, top to bottom: the sequence bar (on/off, the tag, timing, the
     helpers), the sequence's name, the BOX — the steps as the tiles the
     sheet's strip already draws, with the once/repeat badge at its left edge —
     the selected step's − slider +, then ← ✕ → ⋯, the target deck (a tap
     now APPENDS a press step), one option tile per step kind the board runs
     (steps.py), and the foot. Every edit goes to the board through
     smartSave → saveAll, the sheet's own Save path (putProfileDebounced),
     and the screen is redrawn from the written draft, so the box is never
     ahead of the board. There is no Save button because nothing is unsaved.

     XIM's controls that are NOT drawn, each because no engine field exists
     for it (D79): Enable / Disable Binding Group (no step switches a
     layer), "aim 10°/s" (our aim step is a push of a distance for a time),
     "Uncategorized" (our category is the Ready-made stamp, not a field
     anyone edits), and the keyboard / mouse target pages (a Smart-Action
     step cannot send a key — D72 — so the deck here is Pad · Sticks). */

  /* the draft for a button that has no sequence yet: the button that
     starts it, and an EMPTY box (owner, 2026-10-07: "in the script window
     it should be empty by default"). It used to seed ONE press step of
     what the button already sends, the way XIM seeds "RT 100%" — so a new
     script opened with a step the player never chose, and the first thing
     they had to do was delete it. Every step is now one they tapped. It is
     a draft until the first edit: opening the editor and leaving writes
     nothing (smartSave never writes a stepless draft — the board refuses
     an action with no steps). */
  function smartSeed(p, S, row) {
    var a = newAction();
    a.trigger.src = row.actSrc;      /* the literal control this row IS */
    a.trigger.follow = null;
    a.name = '';                     /* blank on purpose — see beginSequence */
    a.steps = [];
    S.draft = normAction(a);
    S.editIdx = -1;
    /* and the deck opens on the controller buttons, whatever page the last
       script was left on (owner: the pad buttons are "99.9% where people
       are clicking") */
    S.gridPage = 0;
  }
  /* open the editor on this button: its first sequence, a named one, or a
     fresh seed */
  function enterSmart(p, S, row, actIdx) {
    var i = (actIdx != null && actIdx >= 0 && S.actions[actIdx]) ? actIdx
          : (row && row.acts && row.acts.length ? row.acts[0].i : -1);
    if (i >= 0) { S.editIdx = i; S.draft = clone(S.actions[i]); }
    else smartSeed(p, S, row);
    S.mode = 'smart';
    S.unsaved = false; S.sel = null; S.step = null; S.xf = null;
    S.gridPage = 0;       /* every script opens on the controller buttons */
    S.fresh = false;      /* only New Smart Action's own seed is fresh */
  }
  function leaveSmart(S) {
    S.mode = 'simple'; S.draft = null; S.editIdx = -1;
    S.unsaved = false; S.sel = null; S.step = null; S.xf = null;
    S.fresh = false;
  }

  /* THE ONE WRITE — the sheet's Save without the button. The draft stays
     the working object (the wiring's closures hold it); a COPY goes into
     S.actions so syncBoard's post-write bookkeeping (raw / edited) lands on
     the list's entry and never on the thing being typed into. A seed with no
     steps is never written: an action with no steps does nothing, and the
     board refuses it. */
  function smartSave(p, S) {
    var a = S.draft;
    if (!a) return false;
    if (S.editIdx < 0 && !a.steps.length) return false;
    a.edited = true;
    if (S.editIdx >= 0) S.actions[S.editIdx] = clone(a);
    else { S.actions.push(clone(a)); S.editIdx = S.actions.length - 1; }
    saveAll(p, S);
    S.unsaved = false;
    return true;
  }
  function smartCommit(root, p, S) {
    smartSave(p, S);
    draw(root, p);
  }
  /* back from a sub-sheet (When, Tag, Timing, Helpers, Name, a step's ⋯,
     the sequence list). Closing the host runs smartGuard's callback, which
     lands here again with the sheet shut — that second pass is the one that
     writes. */
  function smartReturn(root, p, S) {
    if (sheetIsOpen()) { ZS.sheetClose(); return; }
    if (S.unsaved) smartCommit(root, p, S);
    else draw(root, p);
  }
  /* every sub-sheet opened from the in-place editor goes THROUGH this. The
     host resets its close-callback stack on the first open and runs it on
     ANY close (✕, scrim, Escape), so a guard pushed first is what makes a
     sub-sheet's edit reach the board however the sheet is left. The
     opener's own paint swaps the content and keeps the stack. */
  function smartGuard(root, p, S, open) {
    ZS.sheetOpen('', '', function () { smartReturn(root, p, S); });
    open();
  }

  /* ── the numbers a step has, one slider at a time ──
     f: the field name shared by the slider and the stepper; d: the − / +
     step; top: the slider's ceiling (the stepper and typing reach `hi`,
     the board's cap — a slider that spanned 0..10 s could not land on 80). */
  function smartFields(s) {
    var MS = { f: 'cms', n: 'For how long', u: 'ms', lo: 0, hi: STEP_MS_CAP, d: 10, top: 2000 };
    if (!s) return [];
    if (s.k === 'tap') return [{ f: 'cms', n: 'Tap for', u: 'ms', lo: TAP_MS_MIN, hi: STEP_MS_CAP, d: 10, top: 2000 }];
    if (s.k === 'trig') return s.keep ? [] : [{ f: 'cms', n: 'Pull for', u: 'ms', lo: TAP_MS_MIN, hi: STEP_MS_CAP, d: 10, top: 2000 }];
    if (s.k === 'wait') return [{ f: 'cms', n: 'Wait for', u: 'ms', lo: 0, hi: STEP_MS_CAP, d: 10, top: 2000 }];
    if (s.k === 'stick' && num(s.dps, 0) > 0) return [
      { f: 'cdps', n: 'Turn speed', u: '°/s', lo: 1, hi: DPS_MAX, d: 5, top: 600 },
      { f: 'cangle', n: 'Which way', u: '°', lo: 0, hi: 359, d: 15, top: 359 },
      MS];
    if (s.k === 'stick') return [
      { f: 'cdist', n: 'How far', u: '%', lo: 1, hi: 100, d: 5, top: 100 },
      { f: 'cangle', n: 'Which way', u: '°', lo: 0, hi: 359, d: 15, top: 359 },
      MS];
    if (s.k === 'sens') return [
      { f: 'cscale', n: 'Aim speed', u: '%', lo: 0, hi: 300, d: 5, top: 300 },
      { f: 'cms', n: 'For how long', u: 'ms', lo: 0, hi: STEP_MS_CAP, d: 100, top: 2000 }];
    if (s.k === 'swap') return [{ f: 'cms', n: 'Swap for', u: 'ms', lo: 0, hi: STEP_MS_CAP, d: 100, top: 2000 }];
    if (s.k === 'move') return [{ f: 'cms', n: 'Pull over', u: 'ms', lo: 0, hi: STEP_MS_CAP, d: 1, top: 1000 }];
    if (s.k === 'config') return (typeof s.to === 'number')
      ? [{ f: 'cto', n: 'Config number', u: '', lo: 1, hi: configNumberTop(s.to), d: 1,
           top: configNumberTop(s.to) }] : [];
    return [];
  }
  function smartFieldOf(s, f) {
    var fs = smartFields(s), i;
    for (i = 0; i < fs.length; i++) if (fs[i].f === f) return fs[i];
    return null;
  }
  function smartRead(s, f) {
    if (f === 'cms') return intOf(s.ms, 0);
    if (f === 'cdist') return Math.round(num(s.dist, 0) * 100);
    if (f === 'cdps') return Math.round(num(s.dps, 0));
    if (f === 'cangle') return ((intOf(s.angle, 0) % 360) + 360) % 360;
    if (f === 'cscale') return Math.round(num(s.scale, 1) * 100);
    if (f === 'cto') return intOf(s.to, 1);
    return 0;
  }
  function smartWrite(s, fd, v) {
    v = clamp(intOf(v, fd.lo), fd.lo, fd.hi);
    if (fd.f === 'cms') s.ms = v;
    else if (fd.f === 'cdist') s.dist = v / 100;
    else if (fd.f === 'cdps') s.dps = v;
    else if (fd.f === 'cangle') s.angle = v % 360;
    else if (fd.f === 'cscale') s.scale = v / 100;
    else if (fd.f === 'cto') s.to = v;
    else return false;
    return true;
  }
  /* a step with no number says why — a greyed slider that writes nothing is
     the class of control this codebase refuses */
  function smartNoNum(s) {
    if (!s) return '';
    if (s.k === 'hold') return 'Held down until a later step lets go — no time to set';
    if (s.k === 'trig') return 'Kept pulled until a later step lets go — no time to set';
    if (s.k === 'release') return 'Lets go — nothing to set';
    if (s.k === 'config') return 'Switches config — nothing to set';
    return 'Nothing to set for this step';
  }

  /* the selected step's − slider + (owner: "− slider +"). Two kits in one
     row: the .stp stepper (hold-to-repeat, tap-to-type — phone.html's
     wire()) with the .rng slider between its two keys, both writing the
     same field. A kind with two or three numbers gets a switch above it;
     Tap/Hold, Pull/Keep pulled and Next/Before/Number ride there too. */
  function smartCtlHTML(a, sel, S) {
    var s = a.steps[sel];
    if (!s) return '';
    var h = '', segs = '', fs = smartFields(s), fi = 0, i;
    if (s.k === 'tap' || s.k === 'hold') segs += ctlSeg(['Tap', 'Hold'], s.k === 'hold' ? 1 : 0, 'sx-ctlmode');
    else if (s.k === 'trig') segs += ctlSeg(['Pull', 'Keep pulled'], s.keep ? 1 : 0, 'sx-ctlkeep');
    else if (s.k === 'config') segs += ctlSeg(['Next', 'Before', 'Number'],
      s.to === 'next' ? 0 : s.to === 'prev' ? 1 : 2, 'sx-ctlto');
    if (fs.length > 1) {
      for (i = 0; i < fs.length; i++) if (fs[i].f === S.xf) fi = i;
      segs += ctlSeg(fs.map(function (x) { return x.n; }), fi, 'sx-ctlf');
    }
    if (segs) h += '<div class="sxseg">' + segs + '</div>';
    if (!fs.length) {
      if (s.k === 'unknown') return h + '<div class="sxctl off"><i class="sxlab">' + esc(stepLine(s, sel, a.steps, null)) + '</i></div>';
      return h + '<div class="sxctl off"><i class="sxlab">' + esc(smartNoNum(s)) + '</i></div>';
    }
    var fd = fs[fi], v = smartRead(s, fd.f);
    var unit = fd.u === 'ms' ? 'milliseconds' : fd.u === '%' ? 'percent' : fd.u === '°' ? 'degrees' : '';
    return h + '<div class="sxctl"><i class="sxlab">' + esc(fd.n) + '</i>' +
      '<span class="stp sxstp"><button type="button" data-d="-' + fd.d + '" aria-label="decrease">−</button>' +
      '<input class="rng sxrng" type="range" min="' + fd.lo + '" max="' + Math.max(fd.top, v) +
      '" step="1" value="' + v + '" data-nosave="1" data-f="' + fd.f + '" aria-label="' +
      esc(fd.n + (unit ? ', in ' + unit : '')) + '">' +
      '<b class="sv" data-nosave="1" data-f="' + fd.f + '" data-min="' + fd.lo + '" data-max="' + fd.hi + '"' +
      (fd.u ? ' data-suffix="' + esc(fd.u) + '"' : '') + '>' + v + '</b>' +
      '<button type="button" data-d="' + fd.d + '" aria-label="increase">+</button></span></div>';
  }

  /* ← ✕ → in XIM's order, then ⋯ (everything a step can be — combo
     targets, the direction dial, which stick). 44×44 each; every label
     names the position so the count is not sighted-only. */
  var NAVSVG = (function () {
    /* the class names stay the set's (sicon si-<name>), so every check that
       finds a key by its mark still finds it */
    function svg(name, d) {
      return '<svg class="sicon si-' + name + '" data-flat="1" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor"' +
        ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg>';
    }
    return {
      left: svg('left', '<path d="M15 5l-7 7 7 7"/>'),
      right: svg('right', '<path d="M9 5l7 7-7 7"/>'),
      remove: svg('remove', '<path d="M6 6l12 12M18 6L6 18"/>'),
      more: svg('more', '<circle cx="6" cy="12" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>' +
        '<circle cx="18" cy="12" r="1.2" fill="currentColor"/>')
    };
  })();
  function smartNavHTML(a, sel) {
    var n = a.steps.length, has = !!(n && a.steps[sel]);
    var pos = n ? ' (step ' + (sel + 1) + ' of ' + n + ')' : '';
    function b(id, cls, glyph, say, off) {
      return '<button type="button" id="' + id + '"' + (cls ? ' class="' + cls + '"' : '') +
        (off ? ' aria-disabled="true"' : '') + ' aria-label="' + esc(say) + '">' + glyph + '</button>';
    }
    /* every key is icon-only to the eye and a whole sentence to a screen
       reader. D259 (owner: "make sure it doesn't look AI"): plain line
       glyphs in the ink of the key, not the 3D chrome pictures (D82) - a
       picture of an arrow on a flat key read as clip art */
    return '<div class="saednav sxnav">' +
      b('sx-mvearl', 'mv', NAVSVG.left, 'move this step earlier' + pos, !(has && sel > 0)) +
      b('sx-delstep', 'rm', NAVSVG.remove, 'delete this step' + pos, !has) +
      b('sx-mvlate', 'mv', NAVSVG.right, 'move this step later' + pos, !(has && sel < n - 1)) +
      (has ? b('sx-stepmore', 'more', NAVSVG.more, 'all settings for this step' + pos, false) : '') +
      (n ? '<span class="saedpos" aria-hidden="true">' + (sel + 1) + '/' + n + '</span>' : '') +
      '</div>';
  }

  /* the target deck in editor mode: Pad · Sticks, and on a Core in a config
     with a mouse, Mouse · Keys too. The engine grew its key step in D128 (a
     Core step may press a key or a click, zs_actions.c), so the pages that
     were held back here "until the engine grows a key step" are back, each
     headed by the one sentence that says whether a key can arrive through
     the identity the adapter is (sa-mnk.js keysNoteHTML). The A7S still has
     no such path, so an EXO keeps Pad · Sticks. Pad stays FIRST: a pad
     button is what reaches a console, and the default a console config
     keeps. */
  /* ── THE STICKS PAGE (D232, owner 2026-10-07) ─────────────────────────
     "If you have a sticks tab, that is where you have stick direction, left
     and right, and where they select any angle of the stick - which way,
     how far and how long - and they choose the stick, left or right; change
     the logo to an actual stick, animated, pushed whatever direction they
     set." One stick push is built here and added as ONE aim step
     ({k:'stick'}): the stick (Left / Right), the direction (any degree, set
     by dragging on the picture or the slider), how far (%) and how long
     (ms). The picture is the stick pushed that way, on a loop. */
  var DIR_WORDS = ['right', 'up-right', 'up', 'up-left', 'left', 'down-left', 'down', 'down-right'];
  function dirWord(deg) { return DIR_WORDS[Math.round(((deg % 360) + 360) % 360 / 45) % 8]; }
  function stkState(S) {
    if (!S.stk) S.stk = { stick: 'right', angle: 90, dist: 50, ms: 100 };
    return S.stk;
  }
  function stickBuilderHTML(p, S) {
    var k = stkState(S);
    function side(v, lab) {
      return '<button type="button" data-stkside="' + v + '"' + (k.stick === v ? ' class="on" aria-pressed="true"' : ' aria-pressed="false"') + '>' + lab + '</button>';
    }
    function rng(id, lab, val, min, max, step, unit) {
      return '<div class="sxstkrow"><span class="sxstklab">' + esc(lab) + '</span>' +
        '<input class="rng" type="range" id="' + id + '" min="' + min + '" max="' + max + '" step="' + step + '" value="' + val + '" data-nosave="1" aria-label="' + esc(lab) + '">' +
        '<b class="sxstkv" id="' + id + '-v">' + val + unit + '</b></div>';
    }
    return '<div class="sxstk" id="sx-stk">' +
      '<div class="seg2 sxstkside" role="group" aria-label="which stick">' + side('left', 'Left stick') + side('right', 'Right stick') + '</div>' +
      '<div class="sxstkpad" id="sx-stkpad" role="img" aria-label="' + esc('the ' + k.stick + ' stick pushed ' + dirWord(k.angle) + ', ' + k.dist + '%') + '">' +
        SEC.stickSvg(k.angle, k.dist / 100, true) + '</div>' +
      '<div class="sxstkhint" id="sx-stkhint">Drag on the stick, or use the sliders · <b id="sx-stkword">' + esc(dirWord(k.angle)) + '</b></div>' +
      rng('sx-stka', 'Direction', k.angle, 0, 359, 1, '°') +
      rng('sx-stkd', 'How far', k.dist, 5, 100, 5, '%') +
      rng('sx-stkm', 'How long', k.ms, 20, 2000, 10, 'ms') +
      '<button type="button" class="btn primary sxstkadd" id="sx-stkadd">' + sicon('plus', '+') + '<span>Add this stick push</span></button>' +
      '</div>';
  }

  function smartGridHTML(p, S) {
    var pages = [
      { n: 'Pad', say: 'controller buttons', h: padTargetPageHTML(p) },
      { n: 'Sticks', say: 'push a stick: which stick, which way, how far and how long', h: stickBuilderHTML(p, S) }
    ];
    if (window.ZS_SA_MNK && ZS_SA_MNK.keysOffered(p)) {
      var kn = ZS_SA_MNK.keysNoteHTML(p);
      pages.push({ n: 'Mouse', say: 'mouse clicks the computer receives', h: kn + mousePageHTML('data-gt') },
                 { n: 'Keys', say: 'keyboard keys the computer receives', h: kn + kbPageHTML('data-gt') });
    }
    return '<div class="sasgrid" data-noswipe="1">' +
      deckHTML('sa-sgrid', pages, clamp(intOf(S.gridPage, 0), 0, pages.length - 1)) +
      '</div>';
  }

  /* XIM's option list, on OUR step vocabulary — one tile per kind steps.py
     runs, and nothing else: Wait · Hold · Let go (only while something is
     held) · Aim nudge (XIM's Aim Magnitude and Aim Angle are the two
     numbers of this ONE step) · Aim speed · Swap sticks · Switch config
     (only with more than one config). Seven fit; no "•••" is needed. */
  function smartOptsHTML(a) {
    var h = '<div class="sxopts" role="group" aria-label="other kinds of step">';
    h += keyHTML('data-cat', 'wait', MARK_WAIT, 'Wait next', 'add a pause with a length');   /* owner, 2026-10-10: 'Wait next' */
    h += keyHTML('data-cat', 'hold', MARK_HOLDSTEP, 'Hold', 'hold a button down until a later step lets go');
    if (catAllowed({ k: 'release' }, a)) {
      h += keyHTML('data-cat', 'release', MARK_RELEASE, 'Let go', 'let go of the button held earlier');
    }
    /* owner, 2026-10-10: "the bottom should only be Wait, Hold and Switch
       config - stick stuff is in Stick". Aim nudge is added from the deck's
       Sticks page; Let go stays (only while something is held) because a
       held button needs it to be released. */
    /* owner, 2026-10-10: "why do you have the Swap sticks and Aim speed
       options in Scripts too? remove them - why change aim speed when Aim
       nudge exists". No tile adds them any more; a step that already has
       one (an old script, or a ready-made built on it) still shows, edits
       and runs - the model and the engine keep both kinds. */
    if (catAllowed({ k: 'config' }, a)) {
      h += keyHTML('data-cat', 'config', MARK_CONFIG, 'Switch config', 'switch to another config');
    }
    return h + '</div>';
  }

  /* D283: the On and Tag chips, drawn at the right end of the Activation
     row (inputHeadHTML); the clicks are still this editor's (wireSmart's
     delegate on .saxed, which holds the head) */
  function sxChipsHTML(a) {
    var on = a.enabled !== false;
    return '<button type="button" class="sxchip' + (on ? ' on' : '') + '" id="sx-on" role="switch" aria-checked="' +
        (on ? 'true' : 'false') + '" aria-label="' +
        esc('this Script is ' + (on ? 'on' : 'off') + ' — tap to switch it ' + (on ? 'off' : 'on')) + '">' +
        (on ? sicon('on') + '<span>On</span>' : sicon('off') + '<span>Off</span>') + '</button>' +
      '<button type="button" class="sxchip" id="sx-tag" aria-label="' +
        esc((a.group ? 'tagged ' + a.group : 'no tag') + ' — change the tag') + '">' +
        MK_TAG + '<span>' + esc(a.group || 'No tag') + '</span></button>' +
