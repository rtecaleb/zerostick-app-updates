        : 'Pasted onto ' + rowName(target) + ' — check it over, then Save');
    }
    if (navigator.clipboard && navigator.clipboard.readText) {
      navigator.clipboard.readText().then(apply, function () { apply(window.prompt('Paste the code:') || ''); });
    } else apply(window.prompt('Paste the code:') || '');
  }

  /* Change the open draft's trigger. Shared by the "will not fire" line's
     one-tap fix, so a dead sequence is one tap from a button that works.
     Changing it MOVES the sequence to another input, so the screen follows
     it there rather than sitting on a button it no longer belongs to. */
  function retrigger(root, p, S) {
    var a = S.draft;
    if (!a) return;
    var inSheet = !!S.sheetEditor;
    /* ZS.pickButton (the capture route) hard-closes the sheet host, which
       would run the editor's dismissal callback and throw the draft away.
       The flag tells that callback this is a trip, not a dismissal. */
    if (inSheet) S.keepEditor = true;
    pickTrigger(p, { keepOpen: inSheet }).then(function (v) {
      if (v) {
        a.trigger.src = v.src || null;
        a.trigger.follow = v.follow || null;
        /* D280: a Script that waited for a key has one now, and runs */
        if (a.trigger.unbound) { a.trigger.unbound = false; a.trigger.home = null; a.enabled = true; }
        a.edited = true;
        S.unsaved = true;
        var row = rowFor(p, S, emitSource(p, a.trigger) || '');
        if (row) S.inputSrc = row.source;
        /* D280: the in-place editor writes each change as it is made (its
           Done only shuts the panel), so a new key is written now too */
        if (!inSheet && S.mode === 'smart') { smartCommit(root, p, S); return; }
      }
      /* back to the editor either way — cancelling a picker must not also
         throw away the sequence you were editing */
      if (inSheet) { backToEditor(root, p, S); return; }
      draw(root, p);
    });
  }

  /* D280 (2026-10-13 audit): one Script, opened in the editor and straight
     on its "What starts this action?" picker. Used where the honest answer
     to a tap is "choose its key first": switching on a Script that waits on
     no key (it cannot run until it has one), and Featured's Turn assist when
     the config already has one or X is taken. Picking a key clears the wait
     and switches it on (retrigger); cancelling leaves it as it was. */
  function openOnKeyPicker(root, p, S, i) {
    var a = S.actions[i];
    if (!a) return false;
    var row = rowFor(p, S, SEC.emitSource(p, a.trigger) || '');
    if (!row) return false;
    S.inputSrc = row.source; S.screen = 'input'; S.page = 0;
    enterSmart(p, S, row, i);
    draw(root || VIEW.lastRoot, p);
    retrigger(root || VIEW.lastRoot, p, S);
    return true;
  }

  /* phone-sections.js's R.bindings and R.smart hand over to these at call
     time when ZS_SMART exists, which is why this file must load AFTER it.
     Same contract as every other renderer: {html, after(root, p)}.

     TWO DOORS, ONE ROOM. renderInputs is "I know which button I want to
     change"; render is "I want bunny hop, show me the options". Both land on
     the same input screen, and neither of them ever asks anyone to create a
     standalone action and then go hunting for a trigger. */
  function enter(p, screen, home) {
    var S = saFor(p);
    /* THE PANEL SURVIVES A REDRAW (D81). redrawOpenScreen() and the polls
       re-enter this section with the same descriptor; with the sub-menu up
       that is a repaint of the screen UNDER it, not a navigation, so its
       state — which input, which mode, the draft being edited — is kept
       and draw() paints both from the fresh profile. A real navigation
       (the menu door) can only happen with the panel shut: it is modal. */
    var keep = panelIsOpen() && VIEW.panelPid === p.id && S.screen === 'input' && S.home === home;
    if (!keep) {
      S.screen = screen; S.home = home;
      S.draft = null; S.editIdx = -1; S.step = null;
      S.mode = 'simple'; S.unsaved = false;
      S.pendingRow = null;
    }
    hydrate(p, S);
    return { html: '', after: function (root) { draw(root, p); } };
  }
  /* WHICH TAB THE SCREEN OPENS ON (screen-map §5.7). It used to be Ready-made
     always: a 31-card catalogue as the first screenful of the screen you
     opened to look at the sequences you already have. The library is the
     right first answer only when there is nothing to list — with sequences on
     the config, "Everything you have" is the thing you came for, and it is
     the door onto each one (a row tap opens that button's screen).

     hydrate() FIRST, or the question is asked before the board's own actions
     have been read in and a config full of sequences still lands on the
     catalogue. It is a no-op after the first call and on an offline boot, so
     the answer then comes from whatever this phone had stored — the same list
     the screen is about to draw either way.

     This is a DEFAULT, never an override: the moment a tab is landed on,
     draw() writes it into S.smartTab and that choice wins for the rest of the
     session. */
  function render(p) {
    VIEW.SCOPE = null;
    var S = saFor(p);
    hydrate(p, S);
    /* Smart mappings is the landing tab (D85): with sequences it is the
       list of them, without it is the one-line empty state, Record and the
       Mappings fold — the library is one tab to the right either way */
    if (S.smartTab == null) S.smartTab = 'index';
    var tab = S.smartTab;
    return enter(p, tab, tab);
  }
  function renderInputs(p) { VIEW.SCOPE = null; return enter(p, 'inputs', 'inputs'); }
  /* THE THIRD DOOR (D122): the same room, about one weapon's actions. The
     scope object is described beside SCOPE above; auto-actions.js makes it. */
  function renderScoped(p, scope) {
    VIEW.SCOPE = scope || null;
    var S = saFor(p);
    hydrate(p, S);
    if (S.smartTab == null) S.smartTab = 'index';
    return enter(p, S.smartTab, S.smartTab);
  }

  /* what the other parts use from this one */
  SEC.copyShare = copyShare;
  SEC.enterSmart = enterSmart;
  SEC.leaveSmart = leaveSmart;
  SEC.openOnKeyPicker = openOnKeyPicker;
  SEC.pasteFlow = pasteFlow;
  SEC.render = render;
  SEC.renderInputs = renderInputs;
  SEC.renderScoped = renderScoped;
  SEC.retrigger = retrigger;
  SEC.smartBodyHTML = smartBodyHTML;
  SEC.smartCommit = smartCommit;
  SEC.smartReturn = smartReturn;
  SEC.smartSeed = smartSeed;
  SEC.wireSmart = wireSmart;
});
