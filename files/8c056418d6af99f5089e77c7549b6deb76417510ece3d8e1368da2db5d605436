    ['left', 'right', 'ads'].forEach(function (s) {
      var cv = root.querySelector('#zk-c-' + s);
      var rng = root.querySelector('input[data-zk="arc"][data-zkside="' + s + '"]');
      if (!cv || !rng) return;
      function apply(ev) {
        var r = cv.getBoundingClientRect();
        if (!r.width || !r.height) return;
        var x = clamp((ev.clientX - r.left - 8) / (r.width - 16), 0.02, 0.98);
        var y = clamp(1 - (ev.clientY - r.top - 8) / (r.height - 16), 0.001, 0.999);
        rng.value = arcOf(clamp(Math.log(y) / Math.log(x), 1 / 3, 3));
