    root.querySelectorAll('.zk [data-zkpre]').forEach(function (b) {
      b.addEventListener('click', function () {
        var side = b.getAttribute('data-zkside'), pre = b.getAttribute('data-zkpre'), arc = +pre;
        if (pre === 'custom') {
