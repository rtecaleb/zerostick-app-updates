    return antiSlider(s, Math.round(d.anti * 100));
  }

  function dzHTML(full, opt) {
    var body = '';
    [selOf(opt)].forEach(function (s) {
      var d = dzOf(full, s);
      body += (custom(opt, s) ? '' : '<div class="zksub">' + sideName(s) + ' <i>\u00b7 Native</i></div>') +
        slider('in', s, 'Inner', Math.round(d.inner * 100), 0, 40, '%') +
        slider('out', s, 'Outer', Math.round((1 - d.outer) * 100), 0, 40, '%') +
        (opt.anti ? antiHTML(opt, s, d) : '');
    });
    var lim = clamp(num(((full && full.constraints) || {}).maxStickMagnitude, 1), 0.1, 1);
    body += '<div class="zksub">Both sticks</div>' +
