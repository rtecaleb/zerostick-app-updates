      }
      function commit() {
        if (offline()) return;
        var v = +r.value;
        var fn = function (f) {
          if (!f.deadZones) f.deadZones = {};
          if (key === 'in') f.deadZones[side + 'Inner'] = clamp(v, 0, 40) / 100;
          else if (key === 'out') f.deadZones[side + 'Outer'] = Math.round((1 - clamp(v, 0, 40) / 100) * 100) / 100;
          else if (key === 'anti') f.deadZones[side + 'Anti'] = clamp(v, 0, 40) / 100;   /* D261 */
          else if (key === 'hair') {
            f.deadZones[side === 'left' ? 'hairTriggerLeft' : 'hairTriggerRight'] = clamp(v, 0, 50) / 100;
          } else if (key === 'arc') writeCurve(f, side, v);
          else if (key === 'lim' || key === 'tlim') {
            if (!f.constraints) f.constraints = {};
            f.constraints[key === 'lim' ? 'maxStickMagnitude' : 'maxTrigger'] = clamp(v, 10, 100) / 100;
          }
        };
        /* a deadzone on a Native stick puts it on a curve, in the same write */
