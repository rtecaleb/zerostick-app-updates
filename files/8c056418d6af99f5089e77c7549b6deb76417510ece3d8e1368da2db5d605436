      });
    });
    root.querySelectorAll('.zk input.zk-rng').forEach(function (r) {
      var key = r.getAttribute('data-zk'), side = r.getAttribute('data-zkside');
      function label() {
        var v = +r.value, out = root.querySelector('[data-zkv="' + key + '-' + side + '"]');
        if (key === 'hair' || key === 'anti') {
          if (out) out.textContent = v ? v + '%' : 'Off';
          if (key === 'anti') return;
          var hm = root.querySelector('#zk-th-' + side);
          if (hm) { hm.style.bottom = v + '%'; hm.style.display = v ? '' : 'none'; }
