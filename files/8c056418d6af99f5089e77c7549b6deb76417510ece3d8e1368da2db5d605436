         left is higher the right can't be lower"): each point is free */
      function setY(i, y) {
        ys[i] = clamp(y, 0, 1);
        place(i);
        if (path) path.setAttribute('d', epath(ys));
      }
      function save() {
        if (offline()) return;
        var copy = ys.slice();
        write(p, function (f) { writePts(f, side, copy); });
      }
      svgEl.querySelectorAll('.zkh').forEach(function (h) {
        var i = +h.getAttribute('data-i');
        h.addEventListener('pointerdown', function (ev) {
          if (ev.preventDefault) ev.preventDefault();
          try { h.setPointerCapture(ev.pointerId); } catch (e) {}
          h.classList.add('on');
          function mv(e2) {
            var r = svgEl.getBoundingClientRect();
            if (!r.height) return;
            var yy = (e2.clientY - r.top) / r.height * 140;
            setY(i, (EB - yy) / (EB - ET));
          }
          /* m44: a drag the browser takes back (pointercancel, or the
             capture lost to a scroll or a system gesture) ends here too and
             saves what the curve now shows; with pointerup alone the point
             looked set but was never written, and each cancel left its
             listeners behind to stack onto the next drag */
          var done = false;
