    root.querySelectorAll('.zk [data-zkcopy]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (offline()) return;
        if (opt.onCopy) opt.onCopy(b.getAttribute('data-zkcopy'));
      });
    });
    /* the Custom curve: drag a point, or arrow keys on a focused one */
    root.querySelectorAll('.zk svg.zkcedit').forEach(function (svgEl) {
      var side = svgEl.getAttribute('data-zkside');
      var ys = ysOf(fullOf(p), side);
      var path = svgEl.querySelector('.zkcpath');
      function place(i) {
        var h = svgEl.querySelector('.zkh[data-i="' + i + '"]');
        if (!h) return;
