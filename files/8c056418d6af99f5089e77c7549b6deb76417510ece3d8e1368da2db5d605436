    root.querySelectorAll('.zk [data-zkmode]').forEach(function (b) {
      b.addEventListener('click', function () {
        var side = b.getAttribute('data-zkside'), m = b.getAttribute('data-zkmode');
        if (modeOf(opt, side) === m) return;
        if (opt.onMode) opt.onMode(side, m);
      });
    });
    /* a curve: on a Native stick it makes the stick Custom WITH that curve,
