  /* ── wiring ──────────────────────────────────────────────────── */
  var SUB = false;
  var CUR = null;            /* { p, opt } of the page on screen */

  function fullOf(p) { return (window.ZS && ZS.live && ZS.live.full && ZS.live.full[p.id]) || null; }
  function liveOk(p) { return ZS.live.online !== false && !!fullOf(p); }

  function paint() {
