     screen. The redraw still shows what the write makes true, because
     editProfile replaces the cached copy with the changed clone. */
  function write(p, fn) {
    if (ZS.editProfile && fullOf(p)) { ZS.editProfile(p.id, fn); return; }
    ZS.putProfileDebounced(p.id, fn);
  }

  function wire(root, p, opt) {
    if (!root || !p) return;
    opt = opt || {};
    CUR = { p: p, opt: opt };
    var warned = false;
    function offline() {
      if (liveOk(p)) return false;
