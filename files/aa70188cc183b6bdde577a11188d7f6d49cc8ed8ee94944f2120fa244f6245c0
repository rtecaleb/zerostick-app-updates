/* zs-profile-encode.js - a config becomes the Core's binary blob, in the
 * browser (window.ZSPROFILE). D103.
 *
 * ES5 ONLY, the same discipline as zs-serial.js and devices.js: no arrow
 * function, no template literal, no let/const, no class, no async/await
 * anywhere in this file. Typed arrays and TextEncoder are library, not
 * syntax, and zs-serial.js already depends on both.
 *
 * -- What this is -----------------------------------------------------------
 *
 * D103 gave the Core a binary profile format and two halves were built on
 * 2026-09-18: the PC-side encoder (firmware/lite-p4/tools/zsp/encode.py, pure
 * Python) and the device-side decoder (firmware/lite-p4/components/zs_profile,
 * pure C99). The phone app is neither. It cannot run Python and it is what a
 * person actually saves a config from, so until this file existed a config
 * edited on a phone could not reach a Core at all.
 *
 * This is the THIRD implementation of ONE format, and the only reason it is
 * allowed to exist is that it is pinned to the first: dashboard/tools/
 * test-profile-encode.js encodes the same profiles this file does and asserts
 * the bytes are IDENTICAL to what encode.py wrote, from a committed fixture
 * (dashboard/tools/fixtures/zsp-vectors.json, generated by gen-zsp-fixtures.py).
 * If the two ever disagree the test fails and ONE of them is wrong; work out
 * which before touching the fixture, because regenerating it always makes the
 * test pass and that is not the same as making it right.
 *
 * THE BYTE LAYOUTS ARE NOT RESTATED HERE. D103 section 10 settled that they
 * live in exactly one place: the SECTION LAYOUT comment beside each writer in
 * encode.py. Every writer below names the Python function it ports and stops
 * there, the same rule the C parsers follow.
 *
 * -- What it takes ----------------------------------------------------------
 *
 * A MIGRATED, VALIDATED profile document: the shape the board hands back from
 * GET /agent/profiles/<id>. It does not run schema.migrate() or
 * schema.validate(); D103 forbids a second copy of those 2,834 lines and the
 * board has already run both on everything it stores. migrate() is idempotent
 * (checked in gen-zsp-fixtures.py), so a document that came from the board is
 * already a migrated document.
 *
 * validate() below is therefore NOT schema.py. It checks only what the ENCODER
 * itself must judge, which is the same short list the Python collects into its
 * own `problems`: the caps from D103 section 5, that every source and every
 * target resolves to a number, and that every enum value is one the wire
 * knows. Its sentences are the Python's sentences, word for word, because the
 * test pins four of them against the Python's own output.
 *
 * -- The one thing a browser cannot resolve ---------------------------------
 *
 * D103 section 1's biggest saving is that the AIMMODEL section arrives already
 * RESOLVED: the encoder runs translate/mouse_stick.py's configure() and
 * _caps() and sends the answer, so the device looks nothing up. encode.py does
 * that by importing the board agent and reading translate/translators/*.json.
 * A browser has neither.
 *
 * So, in order:
 *
 *   1. If the document carries a resolved model already (the field name is
 *      `mouseTranslation.resolvedAimModel`, holding exactly what
 *      encode.py's resolve_aim_model() returns), it is used VERBATIM. That
 *      path is byte-identical to the Python and the "everything" fixture
 *      proves it. Nothing writes that field today; it is named here so the
 *      board can start to, and so this file is ready when it does.
 *   2. Otherwise the GENERIC model is computed here, exactly as
 *      game_model._generic() states it and mouse_stick._caps() resolves it:
 *      the deadzone from the profile's own antiDeadzone, its shape from
 *      antiDeadzoneShape, a linear curve, and GENERIC_MAX_TURN_SPEED deg/s
 *      run through the same four-step calibration precedence chain. For a
 *      config that never picked a game translator (the shipped default and
 *      most configs) that is not a fallback at all: it is the right answer,
 *      and the "default" and "sixty" fixtures are byte-identical on it.
 *   3. If the document DOES name a game translator, the generic model is used
 *      and a sentence saying so comes back in validate()'s problems. The
 *      numbers in a translator file are MEASURED and this file does not have
 *      them; guessing them would change how somebody's aim feels for a reason
 *      nobody could see, which is the failure D103 section 4 exists to stop.
 *      It is a warning and not a refusal (the config still aims, on the same
 *      300 deg/s map every unprofiled game uses), and encode() still returns
 *      bytes, but the app is expected to show the sentence.
 *
 * -- The SOURCE sidecar, and why its bytes are not the Python's -------------
 *
 * Section 0x00F0 is the original document, gzipped, that the device never
 * parses and hands back so a new phone can recover a config (D103 section 8,
 * kept by the owner). encode.py writes it with zlib at level 9 over Python's
 * own json.dumps. NEITHER of those can be reproduced in a browser without a
 * dependency and a build step: matching zlib's deflate bit for bit means
 * porting its lazy matcher and its block-splitting heuristics, and Python and
 * JavaScript do not format floats the same way anyway ("1.0" against "1").
 *
 * So this file writes its own real, legal gzip stream over its own sorted
 * compact JSON. Any inflater reads it, the device treats it as opaque bytes
 * exactly as D103 says, and the tests gunzip it with node's zlib and check
 * the JSON comes back.
 *
 * Until D124 that stream was made of STORED deflate blocks, which is no
 * compression at all, and D122 measured what that cost: a Warzone config's
 * copy stopped fitting at about the fifth taught weapon. Since D124 the
 * deflate is real (zs-deflate.js, synchronous, within a percent of zlib's
 * best on a real config), and when the Core says it can hand a stored config
 * back in pieces (sourceRefs), each taught picture in the copy is a
 * reference to the VISION section's copy of it (PATCH_REF) rather than a
 * second 684 characters of base64. zs-profile-copy.js puts them back.
 *
 * The byte-identity claim above is therefore about the blob WITHOUT the
 * sidecar, which is the whole profile: every section the device reads.
 *
 * -- The evdev table --------------------------------------------------------
 *
 * CODES below is GENERATED, never typed, for the reason gen_evdev_codes.py
 * gives: 640-odd numbers typed by hand is a table with a typo in it somewhere
 * that repoints somebody's binding to the wrong key. The master is
 * firmware/lite-p4/tools/zsp/gen_evdev_codes.py, which reads the kernel's
 * input-event-codes.h and writes evdev_codes.py; this table was transformed
 * from THAT file, mechanically:
 *
 *     python -c "import re,io,sys; src=io.open('firmware/lite-p4/tools/zsp/
 *       evdev_codes.py',encoding='utf-8').read(); rows=re.findall(r'\"([A-Z0-9_]+)\":\\s*(\\d+),',src); ..."
 *
 * and test-profile-encode.js re-derives it from evdev_codes.py on every run
 * and fails if one name or one number has drifted, so the transform is
 * checked rather than trusted.
 */
(function () {
  'use strict';

  /* ======================================================================
     Small helpers
     ====================================================================== */

  var HAS = Object.prototype.hasOwnProperty;

  /* Every lookup below goes through this. A bare `key in obj` on an object
     literal also finds "constructor", "toString" and friends on the
     prototype, so a binding whose source was literally named "toString"
     would resolve to a function instead of being reported as unknown. */
  function has(map, key) {
    return typeof key === 'string' && HAS.call(map, key);
  }

  function get(map, key, dflt) {
    return has(map, key) ? map[key] : dflt;
  }

  /* An object or an empty one. The Python writers all do p.get("x", {}) and
     then .get() on the result, which raises on a non-dict; here a non-object
     reads as "said nothing", and validate() reports the missing block. */
  function obj(v) {
    return (v && typeof v === 'object' && !isArray(v)) ? v : {};
  }

  function isArray(v) {
    return Object.prototype.toString.call(v) === '[object Array]';
  }

  /* Python's isinstance(v, (int, float)) and not isinstance(v, bool). JSON
     has one number type, so booleans are the only thing to exclude. */
  function isNum(v) {
    return typeof v === 'number' && isFinite(v);
  }

  /* A field that is absent or JSON null reads as "the document said
     nothing", which is what Python's dict.get(key) returning None means at
     every call site ported below. */
  function said(v) {
    return v !== undefined && v !== null;
  }

  function num(v, dflt) {
    return isNum(v) ? v : dflt;
  }

  /* Python's round(): half goes to EVEN, not up. Every millisecond field on
     the wire goes through int(round(...)) in encode.py, so a JS Math.round
     would silently disagree on any value landing exactly on .5. Six lines
     to remove a whole class of divergence that no test on whole numbers
     would ever catch. */
  function pyRound(v) {
    var f = Math.floor(v);
    var d = v - f;
    if (d > 0.5) { return f + 1; }
    if (d < 0.5) { return f; }
    return (f % 2 === 0) ? f : f + 1;
  }

  /* Python's int(): truncate toward zero. */
  function trunc(v) {
    return v < 0 ? Math.ceil(v) : Math.floor(v);
  }

  /* Python's repr() of a string, so the sentences this file produces are the
     Python's sentences character for character (the test pins four of them
     against encode.py's own output). Python prefers single quotes and only
     switches to double quotes when the string holds a single quote and no
     double quote. */
  function pyRepr(s) {
    /* m62 (2026-10-10): a value that is not a string is repr()'d the way
       Python would (None, True, 5, [..], {..}); String() used to print
       "undefined" and "[object Object]" where encode.py says None. */
    if (s === undefined || s === null) { return 'None'; }
    if (typeof s === 'boolean') { return s ? 'True' : 'False'; }
    if (typeof s === 'number') {
      if (s !== s) { return 'nan'; }
      if (!isFinite(s)) { return s > 0 ? 'inf' : '-inf'; }
      return String(s);
    }
    if (isArray(s)) {
      var items = [];
      for (var ai = 0; ai < s.length; ai++) { items.push(pyRepr(s[ai])); }
      return '[' + items.join(', ') + ']';
    }
    if (typeof s === 'object') {
      var pairs = [];
      for (var k in s) {
        if (Object.prototype.hasOwnProperty.call(s, k)) { pairs.push(pyRepr(k) + ': ' + pyRepr(s[k])); }
      }
      return '{' + pairs.join(', ') + '}';
    }
    s = String(s);
    var esc = s.replace(/\\/g, '\\\\');
    if (s.indexOf("'") >= 0 && s.indexOf('"') < 0) {
      return '"' + esc + '"';
    }
    return "'" + esc.replace(/'/g, "\\'") + "'";
  }

  /* Python's str() of a tuple of strings, for the "is not one of (...)"
     sentences. Every enum table below has at least two entries, so the
     one-element trailing comma case cannot arise. */
  function pyTuple(list) {
    var parts = [];
    for (var i = 0; i < list.length; i++) { parts.push(pyRepr(list[i])); }
    return '(' + parts.join(', ') + ')';
  }

  function fmt(template, args) {
    /* A tiny %s/%d/%r stand-in so the ported sentences read like the Python
       lines they came from instead of a wall of concatenation. */
    var i = 0;
    return template.replace(/%[sdr]/g, function (tok) {
      var v = args[i++];
      if (tok === '%r') { return pyRepr(v); }
      if (tok === '%d') { return String(trunc(Number(v))); }
      return String(v);
    });
  }

  /* ======================================================================
     CRC-32 (the ordinary zlib and PNG one, D103 section 2)
     ====================================================================== */

  var CRC_TABLE = null;

  function crcTable() {
    if (CRC_TABLE) { return CRC_TABLE; }
    var t = new Int32Array(256);
    for (var n = 0; n < 256; n++) {
      var c = n;
      for (var k = 0; k < 8; k++) {
        c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
      }
      t[n] = c;
    }
    CRC_TABLE = t;
    return t;
  }

  function crc32(bytes, start, end) {
    var t = crcTable();
    var c = 0xFFFFFFFF;
    var i = (start === undefined) ? 0 : start;
    var stop = (end === undefined) ? bytes.length : end;
    for (; i < stop; i++) {
      c = t[(c ^ bytes[i]) & 0xFF] ^ (c >>> 8);
    }
    return (c ^ 0xFFFFFFFF) >>> 0;
  }

  /* ======================================================================
     The little-endian writer (encode.py's _W)
     ====================================================================== */

  var F32 = new DataView(new ArrayBuffer(4));

  /* A value that does not fit the field it is written to. The Python's _W
     packs with struct, which RAISES on a byte of 300 or a float of 'x'; this
     writer used to mask (300 -> 44) and coerce ('x' -> NaN) without a word
     (audit m59, 2026-10-10). Now it throws this, and build() turns it into
     a refusal. A writer that WANTS the low bits (VISION's narrow counts,
     whose whole value rides in a _WIDE section) masks them itself. */
  function WireRange(message) { this.name = 'WireRange'; this.message = message; }
  WireRange.prototype = new Error();
  WireRange.prototype.constructor = WireRange;
  function wireInt(v, lo, hi, kind) {
    var n = (typeof v === 'boolean') ? (v ? 1 : 0) : trunc(v);
    if (typeof n !== 'number' || n !== n || n < lo || n > hi) {
      throw new WireRange(String(v) + ' does not fit a ' + kind + ' (' + lo + '..' + hi + ')');
    }
    return n;
  }

  function W() {
    this.b = [];
  }
  W.prototype.u8 = function (v) { this.b.push(wireInt(v, 0, 255, 'byte')); };
  W.prototype.i8 = function (v) { this.b.push(wireInt(v, -128, 127, 'signed byte') & 0xFF); };
  W.prototype.u16 = function (v) {
    var n = wireInt(v, 0, 65535, '16-bit field');
    this.b.push(n & 0xFF, (n >> 8) & 0xFF);
  };
  W.prototype.i16 = function (v) {
    var n = wireInt(v, -32768, 32767, 'signed 16-bit field') & 0xFFFF;
    this.b.push(n & 0xFF, (n >> 8) & 0xFF);
  };
  W.prototype.u32 = function (v) {
    var n = wireInt(v, 0, 4294967295, '32-bit field') >>> 0;
    this.b.push(n & 0xFF, (n >>> 8) & 0xFF, (n >>> 16) & 0xFF, (n >>> 24) & 0xFF);
  };
  W.prototype.i32 = function (v) { this.u32(wireInt(v, -2147483648, 2147483647, 'signed 32-bit field') >>> 0); };
  /* struct.pack("<f", v) exactly: DataView rounds to nearest-even the same
     way the C library does, so a double that is not representable as a
     float32 lands on the same float32 on both sides. */
  W.prototype.f32 = function (v) {
    if (typeof v !== 'number' && typeof v !== 'boolean') {
      throw new WireRange(pyRepr(v) + ' is not a number');
    }
    F32.setFloat32(0, Number(v), true);
    this.b.push(F32.getUint8(0), F32.getUint8(1), F32.getUint8(2), F32.getUint8(3));
  };
  /* A length byte and UTF-8 bytes, cut at a character boundary when it is
     over `limit`. Ported from _W.string; display strings are the one thing
     in this format that may be shortened rather than refused. */
  W.prototype.string = function (text, limit) {
    if (limit === undefined) { limit = 255; }
    var raw = utf8(String(text));
    if (raw.length > limit) {
      var cut = limit;
      while (cut > 0 && (raw[cut] & 0xC0) === 0x80) { cut -= 1; }
      raw = raw.subarray(0, cut);
    }
    this.b.push(raw.length & 0xFF);
    for (var i = 0; i < raw.length; i++) { this.b.push(raw[i]); }
  };
  W.prototype.raw = function (bytes) {
    for (var i = 0; i < bytes.length; i++) { this.b.push(bytes[i]); }
  };
  W.prototype.bytes = function () { return new Uint8Array(this.b); };

  /* TextEncoder when the page has one, and a hand-rolled encoder when it does
     not. The fallback is not decoration: the app's own node harness
     (dashboard/tools/app-harness.js) runs phone.html in a bare VM with no
     TextEncoder at all, which is the same thing zs-serial.js's self-test says
     about its environment. Without this, every check that saves a config
     would be testing the harness rather than the app. */
  var TE = null;
  var TE_TRIED = false;

  function utf8(s) {
    if (!TE_TRIED) {
      TE_TRIED = true;
      if (typeof TextEncoder !== 'undefined') { TE = new TextEncoder(); }
    }
    if (TE) { return TE.encode(s); }
    return utf8Manual(s);
  }

  /* UTF-8, including surrogate pairs (an emoji in a config name is two JS
     chars and one code point, and getting that wrong writes a length byte
     that does not match the bytes after it). */
  function utf8Manual(s) {
    var out = [];
    for (var i = 0; i < s.length; i++) {
      var c = s.charCodeAt(i);
      if (c >= 0xD800 && c <= 0xDBFF && i + 1 < s.length) {
        var lo = s.charCodeAt(i + 1);
        if (lo >= 0xDC00 && lo <= 0xDFFF) {
          c = 0x10000 + ((c - 0xD800) << 10) + (lo - 0xDC00);
          i += 1;
        }
      }
      if (c < 0x80) {
        out.push(c);
      } else if (c < 0x800) {
        out.push(0xC0 | (c >> 6), 0x80 | (c & 0x3F));
      } else if (c < 0x10000) {
        out.push(0xE0 | (c >> 12), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));
      } else {
        out.push(0xF0 | (c >> 18), 0x80 | ((c >> 12) & 0x3F),
          0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));
      }
    }
    return new Uint8Array(out);
  }

  /* ======================================================================
     The container (D103 section 2)
     ====================================================================== */

  var MAGIC = [0x5A, 0x53, 0x50, 0x52];      /* "ZSPR" */
  var CONTAINER_VERSION = 1;
  var HEADER_BYTES = 20;
  var ENTRY_BYTES = 12;

  var FLAG_REQUIRED = 0x0001;
  var FLAG_EXTERNAL = 0x0002;

  /* The section type registry, version 1. These numbers are the wire format:
     never renumber, only add. */
  var SECTION_IDENT = 0x0001;
  var SECTION_DEVICES = 0x0002;
  var SECTION_BINDINGS = 0x0010;
  var SECTION_ACTIONS = 0x0011;
  /* D136: ACTIONS' counts and step ranges past 16 bits, only when needed */
  var SECTION_ACTIONS_WIDE = 0x0012;
  var SECTION_AIM = 0x0020;
  var SECTION_AIMMODEL = 0x0021;
  var SECTION_KBDMOVE = 0x0022;
  var SECTION_BEHAVIOR = 0x0023;     /* Fine aim + Behavior Simulation (D162, D163) */
  var SECTION_AIMTIME = 0x0024;      /* the game's turn ramp + input dampening (D164) */
  var SECTION_AIMQUANT = 0x0026;     /* D189: quantization (magnitude, angle) per aim mode */
  var SECTION_SMOOTHING = 0x0027;    /* D191: smoothing style + Classic's Smooth/Decay/Synch */
  var SECTION_AIMAXES = 0x0028;      /* D187: how the game combines the two axes */
  var SECTION_AIMCURVE = 0x0029;     /* D401: an XIM-format aim curve per aim mode */
  var SECTION_STICKS = 0x0030;
  var SECTION_LIMITS = 0x0031;
  var SECTION_STICKFEEL = 0x0032;    /* D184: each stick's mode against the game */
  var SECTION_STICKADS = 0x0033;     /* D254: the aim stick's own curve + smoothing while aiming */
  var SECTION_STICKANTI = 0x0034;    /* D261: each stick's anti-deadzone */
  var SECTION_OUTPUT = 0x0040;
  var SECTION_LIGHTING = 0x0041;
  var SECTION_LIGHTSPLIT = 0x0042;   /* D262: the controller's and the EXO's light, same/own/off */
  var SECTION_SCRIPTS = 0x0050;      /* the GPC script slots + saved values (version 1) */
  var SECTION_VISION = 0x0060;
  /* D133: a taught picture's Smart Actions at ACTIONS index 32 and up */
  var SECTION_VISION_TIES = 0x0061;
  /* D136: VISION's picture count and slices past 8 bits, and VISION_TIES in
     32 bits (in its place), each only when a config needs it */
  var SECTION_VISION_WIDE = 0x0062;
  var SECTION_VISION_TIES_WIDE = 0x0063;
  var SECTION_SHOT = 0x0070;         /* D406: NBA 2K Auto green (optional) */
  var SECTION_NAMEREADER = 0x0065;   /* D424: the game's gun-name reader + the player's box (optional) */
  var SECTION_SOURCE = 0x00F0;

  /* D136: the three _WIDE sections are REQUIRED because each widens a field
     another section keeps the low half of, and a firmware that skipped one
     would read the low half as the whole (encode.py says the same). */
  var REQUIRED_SECTIONS = [SECTION_IDENT, SECTION_BINDINGS, SECTION_AIM,
    SECTION_AIMMODEL, SECTION_STICKS, SECTION_OUTPUT,
    SECTION_ACTIONS_WIDE, SECTION_VISION_WIDE, SECTION_VISION_TIES_WIDE];

  /* D103 section 5's caps, the same numbers encode.py and zs_profile.h hold.

     SINCE D133 THESE ARE SAFETY CEILINGS, NOT BUDGETS. The owner met "Smart
     Actions 0 of 32" and "Taught 0 of 16" and asked why a config had a count
     at all. Each kind now has ONE ceiling so high nobody meets it, the Core
     sizes its tables when a config loads, and the app shows storage. These
     are only the DEFAULT (the D133 firmware's): every encode, validate and
     sizeOf takes the connected Core's own caps as {caps: ...}, read from its
     /status through capsFrom(), so an older Core is held to what it really
     holds (LEGACY_CAPS). Each number lives in exactly one constant here, as
     in encode.py, so it can be retuned without hunting for a second copy. */
  var CAP_BINDINGS = 96;
  var CAP_CHORDS = 64;
  /* D136: NO CEILING (null) on Smart Actions or their steps. They were 32 and
     256 (D103), then 512 and 4,096 (D133), measured against a tick that
     walked every armed action; the Core's tick now visits only what runs, so
     there is nothing left for a count to protect. A Core that still has a
     ceiling advertises it and is held to it (capsFrom). encode.py says the
     same beside its own copy. */
  var CAP_ACTIONS = null;
  var CAP_STEPS = null;
  var CAP_CURVE_POINTS = 16;
  var CAP_PROFILES = 8;
  /* D133: was 16384. One 256 KB flash record minus its 32-byte head. */
  var CAP_BLOB_BYTES = 262112;
  /* D110's areas, four. TAUGHT PICTURES: NO CEILING SINCE D136 (eight at
     D110, sixteen at D122, 255 at D133, the VISION section's u8 count); past
     255 a config carries VISION_WIDE. encode.py says the same. */
  var CAP_VISION_REGIONS = 4;
  var CAP_VISION_TEMPLATES = null;
  /* corner_read.h's CR_PATCH_W and CR_PATCH_H. The MATCHER's size, not the
     format's: a picture of any other shape is one the device cannot read, so
     it is refused on a mismatch rather than resampled. */
  var VISION_PATCH_W = 32;
  var VISION_PATCH_H = 16;
  var VISION_PATCH_N = VISION_PATCH_W * VISION_PATCH_H;

  var BIND_RECORD_BYTES = 16;
  var CHORD_RECORD_BYTES = 4;
  var ACTION_RECORD_BYTES = 24;
  /* D171: encode.py ACTION_VAR_RECORD_BYTES: the record with the per-action
     stick variance appended, written only when some action sets one. */
  var ACTION_VAR_RECORD_BYTES = 26;
  /* D421: the record with variance_mag after stick_var1, written when any
     action sets a magnitude wobble. */
  var ACTION_MAG_RECORD_BYTES = 28;
  var STICK_VARIANCE_MAX = 10;
  var STEP_RECORD_BYTES = 36;
  var VREGION_RECORD_BYTES = 28;
  var VTEMPLATE_RECORD_BYTES = 8;
  /* D128: a step that presses a key or a mouse click carries their evdev
     codes in four u16 slots after the axes. The longer stride is written only
     when some step in the section has a key, so every config without one
     keeps exactly the bytes it had. encode.py says the same beside its copy. */
  var STEP_KEYS_RECORD_BYTES = 44;
  var CAP_KEYS_PER_STEP = 4;
  /* A step's targets are a button bitmask plus six axis values, so every
     button and every axis can be named at once: 18 + 6, structural. */
  var CAP_TARGETS_PER_STEP = 24;
  /* A taught picture's record carries a u32 mask, bit i for ACTIONS index i.
     An index at or past this width travels in VISION_TIES (D133). */
  var VTEMPLATE_MASK_BITS = 32;

  /* The caps by the names a Core's /status advertises them under
     (profileFormat.caps), the default for every call below. */
  var CAPS = {
    bindings: CAP_BINDINGS, chords: CAP_CHORDS, actions: CAP_ACTIONS,
    steps: CAP_STEPS, targetsPerStep: CAP_TARGETS_PER_STEP,
    curvePoints: CAP_CURVE_POINTS, profiles: CAP_PROFILES,
    blobBytes: CAP_BLOB_BYTES, keysPerStep: CAP_KEYS_PER_STEP,
    visionRegions: CAP_VISION_REGIONS, visionTemplates: CAP_VISION_TEMPLATES,
    visionPatchW: VISION_PATCH_W, visionPatchH: VISION_PATCH_H
  };
