/* pad-dial.js: the dualshock-tools stick drawing, for the ZS 8K (D414).
 *
 * The owner, 2026-10-20: the dualshock-tools screens' numbers and graphics
 * are better - "everything is better" - and the 8K's Calibration screen
 * should look like the same tool. So its sticks are drawn by the SAME code
 * the site draws a DualSense with: draw_stick_dial, calculateCircularityError,
 * apply_center_zoom, float_to_str and the 48-sector circularity map, ported
 * line for line from vendor/dualshock-tools/app.js (MIT, (c) 2024 the_al) to
 * ES5. Same colours, same line weights, same "+0.00" readouts, the same
 * "N.N %" circularity figure in the dial.
 *
 * Coordinates are the site's: x right, y DOWN, -1..1 (pad-cal.js turns the
 * 8K's numbers round before they get here).
 *
 *   ZSDIAL.draw(ctx, cx, cy, sz, x, y, { dark, circ, zoom, highlight })
 *   ZSDIAL.circErr(data)         -> RMS % (the site's figure)
 *   ZSDIAL.collect(data, x, y)   -> one live sample into a 48-sector map
 *   ZSDIAL.str(f, precision)     -> "+0.00" the site's way
 *   ZSDIAL.N                     -> 48
 */
(function (root) {
  'use strict';

  var N = 48;   /* CIRCULARITY_DATA_SIZE */

  function str(f, precision) {
    if (precision === undefined) precision = 2;
    if (precision <= 2 && f < 0.004 && f >= -4e-3) return '+0.00';
    return (f < 0 ? '' : '+') + f.toFixed(precision);
  }

  function circErr(data) {
    var sum = 0, n = 0;
    for (var i = 0; i < data.length; i++) {
      if (data[i] > 0.2) { sum += Math.pow(data[i] - 1, 2); n++; }
    }
    return n > 0 ? Math.sqrt(sum / n) * 100 : 0;
  }

  function zoom(x, y) {
    var d = Math.sqrt(x * x + y * y);
    if (d === 0) return { x: x, y: y };
    var a = Math.atan2(y, x);
    var nd = d <= 0.05 ? (d / 0.05) * 0.5 : 0.5 + ((d - 0.05) / 0.95) * 0.5;
    return { x: Math.cos(a) * nd, y: Math.sin(a) * nd };
  }

  function collect(data, x, y) {
    var d = Math.sqrt(x * x + y * y);
    var i = (Math.round(Math.atan2(y, x) * N / 2.0 / Math.PI) + N) % N;
    data[i] = Math.max(data[i] || 0, d);
  }

  function hue(cc) {
    var dd = Math.sqrt(Math.pow(1.0 - cc, 2));
    if (cc <= 1.0) return 220 - 220 * Math.min(1.0, Math.max(0, dd - 0.05) / 0.1);
    return (245 + (360 - 245) * Math.min(1.0, Math.max(0, dd - 0.05) / 0.15)) % 360;
  }

  function draw(ctx, cx, cy, sz, sx, sy, o) {
    o = o || {};
    var dark = o.dark !== false;
    var data = o.circ || null;
    ctx.lineWidth = 1;
    ctx.fillStyle = dark ? '#2b3035' : '#ffffff';
    ctx.strokeStyle = dark ? '#9fa2a4' : '#000000';
    ctx.beginPath();
    ctx.arc(cx, cy, sz, 0, 2 * Math.PI);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    var i;
    if (data && data.length > 0) {
      for (i = 0; i < N; i++) {
        var kd = data[i], kd1 = data[(i + 1) % N];
        if (kd === undefined || kd1 === undefined) continue;
        var ka = i * Math.PI * 2 / N, ka1 = ((i + 1) % N) * 2 * Math.PI / N;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(cx + Math.cos(ka) * kd * sz, cy + Math.sin(ka) * kd * sz);
        ctx.lineTo(cx + Math.cos(ka1) * kd1 * sz, cy + Math.sin(ka1) * kd1 * sz);
        ctx.lineTo(cx, cy);
        ctx.closePath();
        ctx.fillStyle = 'hsla(' + parseInt(hue((kd + kd1) / 2), 10) + ', 100%, 50%, 0.5)';
        ctx.fill();
      }
    }
    if (data && data.filter(function (n) { return n > 0.3; }).length > 10) {
      ctx.fillStyle = dark ? '#2b3035' : '#ffffff';
      ctx.strokeStyle = dark ? '#9fa2a4' : '#000000';
      ctx.lineWidth = 3;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = Math.round(24 * sz / 60) + 'px Arial';
      var t = circErr(data).toFixed(1) + ' %';
      ctx.strokeText(t, cx, cy + sz * 0.5);
      ctx.fillText(t, cx, cy + sz * 0.5);
    }

    ctx.strokeStyle = '#aaaaaa';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(cx - sz, cy); ctx.lineTo(cx + sz, cy); ctx.closePath(); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, cy - sz); ctx.lineTo(cx, cy + sz); ctx.closePath(); ctx.stroke();

    var dx = sx, dy = sy;
    if (o.zoom) {
      var z = zoom(sx, sy);
      dx = z.x; dy = z.y;
      ctx.strokeStyle = '#d3d3d3';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(cx, cy, sz * 0.5, 0, 2 * Math.PI); ctx.stroke();
    }
    ctx.fillStyle = '#000000';
    ctx.strokeStyle = dark ? '#9fa2a4' : '#000000';
    var dist = Math.sqrt(dx * dx + dy * dy);
    if (o.zoom && dist > 0.5) {
      var bx = (dx / dist) * 0.5, by = (dy / dist) * 0.5;
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + bx * sz, cy + by * sz); ctx.stroke();
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(cx + bx * sz, cy + by * sz); ctx.lineTo(cx + dx * sz, cy + dy * sz); ctx.stroke();
    } else {
      ctx.lineWidth = o.zoom ? 3 : 1;
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + dx * sz, cy + dy * sz); ctx.stroke();
    }
    ctx.beginPath();
    ctx.arc(cx + dx * sz, cy + dy * sz, o.highlight ? 4 : 3, 0, 2 * Math.PI);
    ctx.fillStyle = o.highlight ? '#2989f7ff' : dark ? '#00FF00' : '#030b84ff';
    ctx.fill();
  }

  var api = { draw: draw, circErr: circErr, collect: collect, str: str, zoom: zoom, N: N };
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  root.ZSDIAL = api;
})(typeof window !== 'undefined' ? window : this);
