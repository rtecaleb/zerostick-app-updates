      '.zw-pop-q{margin:10px 0 0;font-size:13px;line-height:1.45;color:var(--text)}',
      '.zw-pop-err{margin:10px 0 0;font-size:13px;line-height:1.4;color:var(--red-ink,var(--red))}',
