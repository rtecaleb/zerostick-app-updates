      'aria-hidden="true" focusable="false" fill="none" stroke="currentColor" ' +
      'stroke-width="2.2" stroke-linecap="round">';
    for (var i = 0; i < arcs.length; i++) {
      var on = !lit || i < lit;
      h += '<path d="' + arcs[i] + '"' + (i === 0 ? ' fill="currentColor"' : '') +
        (on ? '' : ' opacity=".28"') + '/>';
    }
    return h + '</svg>';
  }
  function lockSVG() {
    return '<svg class="zw-lock" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" ' +
      'focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">' +
      '<rect x="5" y="10.5" width="14" height="10" rx="2.2" fill="currentColor" stroke="none"/>' +
      '<path d="M8.2 10.5 V7.6 A3.8 3.8 0 0 1 15.8 7.6 V10.5"/></svg>';
  }

