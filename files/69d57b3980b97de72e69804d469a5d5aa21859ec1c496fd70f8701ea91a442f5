  function chipWord(w, s) {
    if ((s === 'connected' || s === 'connecting') && w.ssid) return w.ssid;
    return s === 'failed' ? 'Failed' : s === 'connecting' ? 'Joining' : s === 'connected' ? 'On' : 'Off';
  }
