      '.hs-link .hd-name:has(.hd-wifi) .hd-nm{flex:none}',
      '.hs-link .hd-wifi{display:inline-flex;align-items:center;gap:4px;flex:0 1 auto;min-width:0;' +
        'margin-left:1px;padding:3px 8px 3px 6px;border-radius:999px;' +
