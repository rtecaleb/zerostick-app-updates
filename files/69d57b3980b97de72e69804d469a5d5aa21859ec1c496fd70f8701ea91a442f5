      if (hit) try { hit.focus(); } catch (e) { /* focus is a courtesy */ }
      if (z.toast) z.toast('Wi‑Fi reminder hidden. Tap the Wi‑Fi light by EXO Core to set it up.');
    });
  }

  function open(opener) {
    css();
    sheet.opener = opener && opener.nodeType === 1 ? opener :
      (document.getElementById('hswifi') || document.getElementById('hdwifihit'));
    sheet.gen++;
    var w = block() || { state: 'off' };
    var s = stateOf(w);
    if (s === 'connected') return viewConnected(w);
    if (s === 'connecting') return viewJoining(w.ssid || '', true);
    return scan();
  }

  /* straight to the network list (the popover's Change Wi-Fi) */
  function openList(opener) {
    css();
    sheet.opener = opener && opener.nodeType === 1 ? opener : document.getElementById('hdwifihit');
    sheet.gen++;
    return scan();
  }

  /* connected: what it is on, and the two ways on */
  function viewConnected(w) {
    var h = statusCard('connected', 'Connected to <b>' + esc(w.ssid || 'your network') + '</b>',
      'Your EXO Core is online and will update itself automatically.' +
      (w.ip ? ' Address ' + esc(w.ip) + '.' : ''));
    h += '<button class="btn" id="zw-change">Use a different network</button>';
    h += '<button class="btn caution" id="zw-forget">Forget this network</button>';
    var host = draw(h);
    on(host, '#zw-change', function () { scan(); });
    on(host, '#zw-forget', function () { viewForget(w); });
  }

  function viewForget(w) {
    var h = '<p class="zw-lead">Forget <b>' + esc(w.ssid || 'this network') + '</b>? Your EXO Core ' +
      'disconnects from it and stops updating automatically until you connect it again. ' +
      'Everything you play keeps working.</p>' +
      '<button class="btn danger" id="zw-forget-yes">Forget network</button>' +
      '<button class="btn ghost" id="zw-forget-no">Cancel</button>';
    var host = draw(h);
    on(host, '#zw-forget-no', function () { viewConnected(w); });
    on(host, '#zw-forget-yes', function () {
      var b = host.querySelector('#zw-forget-yes');
      b.disabled = true; b.textContent = 'Forgetting…';
      var g = sheet.gen;
      Z().api('/wifi/forget', 'POST', {}).then(function (j) {
        if (g !== sheet.gen) return;
        if (!j || !j.ok) {
          b.disabled = false; b.textContent = 'Forget network';
          viewError('The Core did not forget the network' + (j && j.error ? ': ' + j.error : '.'));
          return;
        }
        afterStatus(function () {
          if (g !== sheet.gen) return;
          scan('Forgotten. Your EXO Core is not on Wi‑Fi now.');
        });
      });
    });
  }

  function viewError(msg) {
    var h = '<p class="zw-lead" role="alert">' + esc(msg) + '</p>' +
      '<button class="btn primary" id="zw-again">Try again</button>' + ignoreHTML();
    var host = draw(h);
    on(host, '#zw-again', function () { scan('', true); });
    wireIgnore(host);
  }

  /* re-read /status (the shell's own refresh, so HOME's light follows) */
  function afterStatus(then) {
    var z = Z();
    var p = z && z.refreshStatus ? z.refreshStatus() : Promise.resolve(null);
    p.then(function () { homeRedraw(); if (then) then(); },
           function () { if (then) then(); });
  }

  /* `fresh` (Scan again, Try again) asks the Core for a NEW scan; without
     it the Core may answer the list it found in the last ~10 s at once. */
  function scan(lead, fresh) {
    var g = ++sheet.gen;
    wireIgnore(draw((lead ? '<p class="zw-lead" role="status">' + esc(lead) + '</p>' : '') +
      statusCard('connecting', 'Looking for networks…', 'The Core is listening; this takes a few seconds.') +
      ignoreHTML()));
    askScan(g, lead, fresh ? '/wifi/scan?fresh=1' : '/wifi/scan', Date.now(), 0);
  }

  /* one GET /wifi/scan; while the Core says scanning, again every
     SCAN_POLL_MS until the list comes or SCAN_LIMIT_MS pass */
  function askScan(g, lead, url, t0, n) {
    Z().api(url).then(function (j) {
      if (g !== sheet.gen) return;
      if (!j || !j.ok) {
        viewError('The Core could not look for networks' + (j && j.error ? ': ' + j.error : '.'));
        return;
      }
      var d = j.data || {};
      if (d.scanning === true) {
        if (Date.now() - t0 >= SCAN_LIMIT_MS || n + 1 >= SCAN_LIMIT_MS / SCAN_POLL_MS) {
          viewError('The Core did not finish looking for networks. Try again.');
          return;
        }
        setTimeout(function () {
          if (g === sheet.gen) askScan(g, lead, '/wifi/scan', t0, n + 1);
        }, SCAN_POLL_MS);
        return;
      }
      var nets = Array.isArray(d.networks) ? d.networks : (Array.isArray(d) ? d : []);
      /* one row per name (a mesh repeats its name per access point); the
         list arrives strongest first, so the first of a name is the best */
      var seen = {}, out = [];
      nets.forEach(function (n) {
        if (!n || !n.ssid || seen[n.ssid]) return;
        seen[n.ssid] = 1;
        out.push({ ssid: String(n.ssid), rssi: n.rssi, secure: n.secure !== false });
      });
      sheet.nets = out;
      viewList(lead);
    });
  }

  function viewList(lead) {
    var w = block() || {};
    var cur = stateOf(w) === 'connected' ? w.ssid : '';
    var h = '<p class="zw-lead">' + (lead ? esc(lead) + ' ' : '') +
      'Pick your network. On Wi‑Fi your EXO Core updates itself automatically.</p>';
    if (sheet.nets && sheet.nets.length) {
      h += '<div class="grp-card zw-list" role="list">';
      sheet.nets.forEach(function (n, i) {
        var b = bars(n.rssi);
        h += '<button class="zw-net" data-net="' + i + '" role="listitem" aria-label="' +
          esc(n.ssid + ', signal ' + b + ' of 4' + (n.secure ? ', secured' : ', open') +
            (n.ssid === cur ? ', connected' : '')) + '">' +
          '<span class="zw-sig">' + fanSVG(20, b) + '</span>' +
          '<span class="zw-nm">' + esc(n.ssid) + '</span>' +
          (n.ssid === cur ? '<span class="zw-cur">Connected</span>' : '') +
          (n.secure ? '<span class="zw-lk">' + lockSVG() + '</span>' : '') +
          '<span class="zw-cv" aria-hidden="true">›</span></button>';
      });
      h += '</div>';
    } else {
      h += '<div class="grp-card"><div class="zw-status zw-off"><span class="zw-ico">' + fanSVG(28, 0) +
        '</span><span>No networks found<small>Move the Core closer to your router, then scan again.</small></span></div></div>';
    }
    h += '<div class="zw-row2"><button class="btn" id="zw-rescan">Scan again</button>' +
      '<button class="btn" id="zw-hidden">Other network…</button></div>' + ignoreHTML();
    var host = draw(h);
    wireIgnore(host);
    host.querySelectorAll('.zw-net').forEach(function (b) {
      b.addEventListener('click', function () {
        var n = sheet.nets[Number(b.getAttribute('data-net'))];
        if (!n) return;
        if (!n.secure) { join(n.ssid, ''); return; }
        viewPassword(n, false);
      });
    });
    on(host, '#zw-rescan', function () { scan('', true); });
    on(host, '#zw-hidden', function () { viewPassword(null, true); });
  }

  /* the password page; `hidden` adds the network's name field */
  function viewPassword(n, hidden, failNote) {
    sheet.pick = n ? { ssid: n.ssid, secure: n.secure, rssi: n.rssi } : null;
    var h = '';
    if (failNote) h += '<p class="zw-lead" role="alert">' + failNote + '</p>';
    if (hidden) {
      h += '<p class="zw-lead">Type the name of the network exactly as it is set on your router.</p>' +
        '<div class="zw-field"><label for="zw-ssid">Network name</label>' +
        '<input class="txt" id="zw-ssid" type="text" autocomplete="off" autocapitalize="off" ' +
          'spellcheck="false" maxlength="32" data-nosave="1"' +
          (n ? ' value="' + esc(n.ssid) + '"' : '') + '></div>';
    } else {
      h += '<div class="zw-net-hd">' + fanSVG(22, bars(n.rssi)) + '<span>' + esc(n.ssid) + '</span></div>';
    }
    h += '<div class="zw-field"><label for="zw-pass">Password' + (hidden ? ' (leave empty for an open network)' : '') +
        '</label><div class="zw-pw">' +
        '<input class="txt" id="zw-pass" type="password" autocomplete="off" autocapitalize="off" ' +
          'autocorrect="off" spellcheck="false" maxlength="63" data-nosave="1">' +
        '<button type="button" class="btn sm" id="zw-show" aria-pressed="false" ' +
          'aria-controls="zw-pass">Show</button></div></div>' +
      '<button class="btn primary" id="zw-join">Join</button>' +
      '<button class="btn ghost" id="zw-back">Back to networks</button>';
    var host = draw(h);
    var pass = host.querySelector('#zw-pass');
    var ssidIn = host.querySelector('#zw-ssid');
    on(host, '#zw-show', function () {
      var b = host.querySelector('#zw-show');
      var show = pass.type === 'password';
      pass.type = show ? 'text' : 'password';
      b.textContent = show ? 'Hide' : 'Show';
      b.setAttribute('aria-pressed', show ? 'true' : 'false');
    });
    function go() {
      var ssid = hidden ? String((ssidIn && ssidIn.value) || '').trim() : n.ssid;
      if (!ssid) { if (ssidIn) ssidIn.focus(); return; }
      var pw = String(pass.value || '');
      pass.value = '';                     /* out of the page before anything else */
      join(ssid, pw, hidden);
      pw = null;
    }
    on(host, '#zw-join', go);
    pass.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); go(); } });
    on(host, '#zw-back', function () { if (sheet.nets) viewList(); else scan(); });
    try { (hidden ? ssidIn : pass).focus(); } catch (e) { /* focus is a courtesy */ }
  }

  /* the one call that carries the password; it is never kept */
  function join(ssid, password, hidden) {
    var g = ++sheet.gen;
    var body = { ssid: ssid, password: password };
    password = null;
    viewJoining(ssid, false, hidden);
    Z().api('/wifi/join', 'POST', body).then(function (j) {
      body.password = '';
      body = null;
      if (g !== sheet.gen) return;
      if (!j || !j.ok) {
        viewFailed(ssid, (j && j.error) || 'the Core refused the request', hidden);
        return;
      }
      poll(g, ssid, Date.now(), 0, false, hidden);
    });
  }

  function viewJoining(ssid, resume, hidden) {
    draw(statusCard('connecting', 'Connecting to <b>' + esc(ssid || 'your network') + '</b>…',
      'This usually takes a few seconds.'));
    if (resume) poll(sheet.gen, ssid, Date.now(), 0, true, hidden);
  }

  /* /status until the Core says connected or failed. A failure the Core
     reported BEFORE this join (the last attempt's) is not this join's
     answer, so "failed" counts only once "connecting" has been seen, or
     after a few polls. */
  function poll(g, ssid, t0, n, sawConnecting, hidden) {
    setTimeout(function () {
      if (g !== sheet.gen) return;
      var z = Z();
      (z.refreshStatus ? z.refreshStatus() : z.api('/status')).then(function (j) {
        if (g !== sheet.gen) return;
        var w = j && j.ok && j.data ? j.data.wifi : null;
        var s = w ? stateOf(w) : '';
        var same = w && (!w.ssid || w.ssid === ssid);
        if (s === 'connecting') sawConnecting = true;
        if (s === 'connected' && same) {
          homeRedraw();
          viewDone(w);
          return;
        }
        if ((s === 'failed' || s === 'off') && same && (sawConnecting || n >= 3)) {
          homeRedraw();
          viewFailed(ssid, w.reason || 'the network did not accept the Core', hidden);
          return;
        }
        if (Date.now() - t0 > JOIN_LIMIT_MS || n > JOIN_LIMIT_MS / POLL_MS) {
          homeRedraw();
          viewFailed(ssid, 'the Core did not finish connecting in time', hidden);
          return;
        }
        poll(g, ssid, t0, n + 1, sawConnecting, hidden);
      });
    }, POLL_MS);
  }

  function viewDone(w) {
    var h = statusCard('connected', 'Connected to <b>' + esc(w.ssid || 'your network') + '</b>',
      'Your EXO Core will now update itself automatically.') +
      '<button class="btn primary" id="zw-done">Done</button>';
    var host = draw(h);
    on(host, '#zw-done', function () { Z().sheetClose(); });
  }

  function viewFailed(ssid, reason, hidden) {
    var r = String(reason || '');
    r = r.charAt(0).toUpperCase() + r.slice(1);
    var h = statusCard('failed', 'Could not join <b>' + esc(ssid) + '</b>', esc(r) + '.') +
      '<button class="btn primary" id="zw-retry">Try again</button>' +
      '<button class="btn ghost" id="zw-other">Choose another network</button>';
    var host = draw(h);
    on(host, '#zw-retry', function () {
      var n = null, i;
      for (i = 0; sheet.nets && i < sheet.nets.length; i++) if (sheet.nets[i].ssid === ssid) n = sheet.nets[i];
      if (hidden || !n) viewPassword({ ssid: ssid, secure: true, rssi: null }, true);
      else viewPassword(n, false);
    });
    on(host, '#zw-other', function () { scan(); });
  }

  window.ZS_WIFI = {
    block: block, stateOf: stateOf, bars: bars,
    lightHTML: lightHTML, labelText: labelText,
    rowHTML: rowHTML, wireRow: wireRow, open: open, openList: openList,
    openPop: openPop, closePop: closePop, popOpen: function () { return pop.open; },
    hitHTML: hitHTML, wireHome: wireHome, placeHit: placeHit,
    ignored: ignored, maybePrompt: maybePrompt, KEYS: { prompt: K_PROMPT, ignore: K_IGNORE }
  };
})();
