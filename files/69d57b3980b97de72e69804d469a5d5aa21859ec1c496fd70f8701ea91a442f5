/* core-wifi.js: the EXO Core's Wi-Fi on HOME (D343), ZS_WIFI.
 *
 * Owner, 2026-10-14: "add a section or something on the home screen showing
 * if the Core is connected to Wi-Fi; maybe add it on the EXO Core sign and
 * make it shine red or green depending on if it's connected to Wi-Fi, and
 * prompt the user to constantly connect to Wi-Fi for the best experience and
 * automatic updates." And: "add the ability to connect the actual Core to the
 * Wi-Fi; put this feature on the EXO Core card on the home screen."
 *
 * THE CONTRACT (agreed with the firmware branch, use exactly these names):
 *   GET  /status        gains "wifi": {"state":"off|connecting|connected|failed",
 *                       "ssid", "rssi" (dBm or null), "ip", "reason" (short text
 *                       when failed), "scanning" (bool)}. ABSENT on firmware
 *                       without Wi-Fi.
 *   GET  /wifi/scan     {"networks":[{"ssid","rssi","secure"}],"ageMs","scanning"},
 *                       strongest first. ANSWERS AT ONCE (D342 amended: a 5 s
 *                       scan inside the request held every Bluetooth request
 *                       for 5 s): with "scanning":true the Core has started
 *                       one, and the app asks again every SCAN_POLL_MS until
 *                       the list comes (an older Core answers the list
 *                       straight away, without "scanning", and that still
 *                       works). ?fresh=1 forces a new scan (Scan again).
 *   POST /wifi/join     {"ssid","password"} -> {"state":"connecting"}; then
 *                       poll /status
 *   POST /wifi/forget   -> {"state":"off"}
 * Every call goes through ZS.api, so it works over the USB serial line, over
 * Bluetooth and inside EXO Studio alike.
 *
 * WHAT IT DRAWS
 *   the light   a small CHIP beside "EXO Core" on HOME's device card (owner,
 *               2026-10-14: "put a small little box for the Wi-Fi and
 *               something that says WIFI in small writing, so users know you
 *               can click the Wi-Fi"): the Wi-Fi glyph, a tiny "WI-FI" and
 *               the state ("Off", "Failed", or the network's name, cut with
 *               an ellipsis), in a flat outlined box tinted by the state.
 *               The glyph is the light: green glow connected, red not
 *               connected or failed, amber pulse connecting (no pulse under
 *               Reduce Motion). The chip shrinks (its name first), never the
 *               title, so "EXO Core" never wraps at 393 px. NOTHING when
 *               /status has no "wifi" (firmware without Wi-Fi) or the Core is
 *               offline. The card's aria-label says the state in words.
 *   the row     "Wi-Fi" on the same card, under the card's own button: the
 *               gentle prompt, "Connecting to <name>..." or "Could not join".
 *               With a "?" that says why (automatic updates; the Core works
 *               without it). NOT drawn when connected or ignored (D343
 *               amended, owner: "remove that padding it creates in the menu
 *               and just have it tiny to the right of the word EXO CORE").
 *   the popover tapping the light opens a small box anchored under it (the
 *               owner's "sub box"): connected -> "Connected to <name>", the
 *               signal, Change Wi-Fi (the sheet's network list) and
 *               Disconnect (asks, then /wifi/forget); otherwise the state in
 *               words and Connect to Wi-Fi (the sheet). A "?" inside. It
 *               closes on an outside tap, Escape, focus leaving it, and when
 *               the light goes away; HOME's ~8 s redraw rebuilds it in place
 *               (it would otherwise vanish under the finger).
 *   the sheet   Scan -> networks (signal bars, a lock) -> password (show /
 *               hide) -> Join -> live progress from /status -> connected, or
 *               failed with the Core's reason and Try again. A hidden network
 *               (type its name), and Forget network with a confirm.
 *
 * THE FIRST-RUN PROMPT (owner, 2026-10-14: "when you connect to the Core for
 * the first time on a fresh install it asks you to connect to the Wi-Fi for
 * the best experience, and you can click Skip"). Once per install
 * (localStorage zs.wifiPrompt), the first time HOME is drawn for a Core
 * whose /status has "wifi" with state "off" and no network. Never offline,
 * never on a Core without Wi-Fi, never on top of a sheet, the editor, a
 * room or the Terms (it waits for the next draw), never when
 * ZSHOST.hides('wifiPrompt'). "Connect to Wi-Fi" goes on into the sheet.
 *
 * IGNORE (owner: "it says Ignore, and you can ignore it, but leave the red
 * Wi-Fi logo, and if they ever click it, it brings back up the Wi-Fi
 * settings"). In the sheet, under the networks, while the Core is not on
 * Wi-Fi. It hides the ROW (localStorage zs.wifiIgnore); the light stays.
 * The light is a real button in every state: a transparent target at least
 * 44 px square laid over the chip (#hdwifihit, a sibling of the card's
 * button, since a button cannot hold a button), placed and sized by
 * measuring the chip. Connected clears the ignore.
 *
 * THE PASSWORD: typed into a type=password field, read once on Join, sent in
 * the POST body to the Core and nowhere else; the field is emptied and the
 * view redrawn the moment it is sent. Never stored, never logged, never in a
 * URL, never in this file's state.
 *
 * ES5 only (DESIGN.md). Loaded after the shell; every call into the shell is
 * made at run time, through window.ZS.
 */
(function () {
  'use strict';

  var POLL_MS = 1000;          /* /status while a join is in flight */
  var JOIN_LIMIT_MS = 40000;   /* a join that never settles is said, not waited on */
  var SCAN_POLL_MS = 1000;     /* GET /wifi/scan again while the Core says scanning */
  var SCAN_LIMIT_MS = 12000;   /* the Core's own budget is 9 s; past this, Try again */
  var cssDone = false;

  function Z() { return window.ZS; }
  function esc(s) {
    var z = Z();
    if (z && z.esc) return z.esc(String(s == null ? '' : s));
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* ── this install's memory (localStorage; a store that refuses still
     works for this session) ─────────────────────────────────────── */
  var K_PROMPT = 'zs.wifiPrompt', K_IGNORE = 'zs.wifiIgnore';
  var mem = {};
  function lsGet(k) {
    try { return window.localStorage.getItem(k); } catch (e) { return mem[k] == null ? null : mem[k]; }
  }
  function lsSet(k, v) {
    try { window.localStorage.setItem(k, v); } catch (e) { mem[k] = v; }
  }
  function lsDel(k) {
    delete mem[k];
    try { window.localStorage.removeItem(k); } catch (e) { /* mem is cleared */ }
  }
  function ignored() { return lsGet(K_IGNORE) === '1'; }
  /* connected answers the reminder: a later disconnect reminds again */
  function note(w) { if (w && stateOf(w) === 'connected' && lsGet(K_IGNORE) != null) lsDel(K_IGNORE); }

  /* ── what the Core says ─────────────────────────────────────────── */
  /* the wifi block, or null: offline, or a Core without Wi-Fi */
  function block(st) {
    var z = Z();
    var live = z && z.live;
    if (!live || live.online === false) return null;
    st = st || live.status;
    var w = st && st.wifi;
    return (w && typeof w === 'object') ? w : null;
  }
  function stateOf(w) {
    var s = String((w && w.state) || 'off');
    return (s === 'connected' || s === 'connecting' || s === 'failed') ? s : 'off';
  }
  /* 1..4 bars from dBm (null = unknown, drawn as 0) */
  function bars(rssi) {
    if (rssi == null || isNaN(Number(rssi))) return 0;
    var r = Number(rssi);
    return r >= -55 ? 4 : r >= -67 ? 3 : r >= -75 ? 2 : 1;
  }

