    });
  }
  ZS.pickButton = pickButton;
  ZS.btnArt = btnArt;
  ZS.srcPickKind = srcPickKind;

  /* askPaste(cb) — a textarea sheet for pasting a config in by hand.
     navigator.clipboard.readText() needs a permission prompt and is simply
     absent in some webviews (the packaged exe among them), so a paste flow that
     ONLY reads the clipboard silently does nothing there. This is the fallback
     that always works: paste into the box, press the button. */
  /* m11 (audit 2026-10-10): COPY, AND SAY WHAT HAPPENED. navigator.clipboard
     .writeText is a promise that can be refused (no focus, no permission, an
     http page), and every caller toasted "copied" before it answered, so a
     player pasted an empty or old clipboard into a bug report. The answer
     decides the toast; a refusal tries the old textarea route once more,
     and only then says it failed. */
  function copyText(text, said, failSaid){
    text = String(text == null ? '' : text);
    function viaTextarea(){
      try{
        var ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', '');
        ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        if(ta.select) ta.select();
        var done = !!(document.execCommand && document.execCommand('copy'));
        document.body.removeChild(ta);
        return done;
      }catch(e){ return false; }
    }
    function fallback(){
      ZS.toast(viaTextarea() ? said : (failSaid || 'Copy failed \u2014 this device did not allow it'));
    }
    try{
      if(navigator.clipboard && navigator.clipboard.writeText){
        Promise.resolve(navigator.clipboard.writeText(text)).then(function(){ ZS.toast(said); }, fallback);
        return;
      }
    }catch(e){}
    fallback();
  }
  function askPaste(cb){
    var body = ZS.sheetOpen('Paste a config',
      '<div class="note">Paste the config text someone sent you — the whole thing, starting with <b>{</b>.</div>'+
      '<textarea id="pst-txt" rows="7" style="width:100%;box-sizing:border-box;background:var(--bg);'+
        'color:var(--fg);border:1px solid var(--line);border-radius:10px;padding:10px;'+
        'font-size:12px;font-family:ui-monospace,Menlo,Consolas,monospace" '+
        'placeholder="{ &quot;name&quot;: &quot;…&quot;, … }"></textarea>'+
      '<button class="btn primary" id="pst-go">Import this config</button>');
    var ta = body.querySelector('#pst-txt'); if(ta) ta.focus();
    var go = body.querySelector('#pst-go');
    if(go) go.addEventListener('click', function(){
      var v = ta ? ta.value : '';
      ZS.sheetClose();
      cb(v);
    });
  }

  /* pickList({title, items:[{icon(html), name, sub?, value, cur?}]}) —
     a sheet of logo+name rows (for choices that have names AND logos). */
  function pickList(opts){
    return new Promise(function(resolve){
      var done=false; function finish(v){ if(done) return; done=true; resolve(v); }
      var html = opts.items.map(function(it,i){
        return '<button class="pkr'+(it.cur?' cur':'')+'" data-i="'+i+'">'+
          '<span class="pki">'+(it.icon||'')+'</span>'+
          '<span class="pkn">'+esc(it.name)+(it.sub?'<em>'+esc(it.sub)+'</em>':'')+'</span></button>';
      }).join('');
      var body = ZS.sheetOpen(opts.title||'Choose', html, function(){ finish(null); });
      body.querySelectorAll('.pkr').forEach(function(b){
        b.addEventListener('click', function(){ finish(opts.items[+b.dataset.i].value); ZS.sheetClose(); });
      });
    });
  }
  ZS.pickList = pickList;

  /* rebind ✎ → the image picker; the picked art replaces the row's button art.
     It used to stop there: redraw, toast "Set", store NOTHING. Every choice
     vanished the moment the screen was reopened. These rows describe things
     the board has no field for yet (Passthrough Mode's combo buttons, the
     config-cycle buttons), so this device is the honest place to keep them —
     but losing them silently was not honest. Remembered under the screen's own
     namespace, keyed by the row's label. */
  function wireRebind(root, kind, p, ns){
    var body = document.getElementById('dbody');
    ns = ns || (root.dataset && root.dataset.ns) || (body && body.dataset.ns) || '';
    root.querySelectorAll('.rebind').forEach(function(b){
      if(!b.getAttribute('aria-label')) b.setAttribute('aria-label','rebind');
      var host = b.closest('.lrow, .fld');
      var labEl = host && (host.querySelector('.flab') || host.querySelector('.src'));
      var labTx = labEl ? ((labEl.childNodes[0] && labEl.childNodes[0].textContent) || '').trim() : '';
      var key = labTx ? ns+'|rebind·'+labTx : null;
      function paint(g){
        var cell = host && (host.querySelector('.tgtcell') || host.querySelector('.glyimg'));
        if(!cell || !g) return;
        if(cell.classList.contains('tgtcell')) cell.innerHTML = glyFor(g);
        else cell.innerHTML = btnArt(g);
      }
      var saved = key ? ZS.store.vals[key] : null;
      /* a stored pad SOURCE re-renders through the family layer so the art
         follows today's pad, not the family it was saved under */
      if(saved && saved.source && PAD_CODE_NAME[saved.source]!=null && window.ZSG)
        paint(ZSG.glyph(saved.source));
      else if(saved && saved.g) paint(saved.g);
      b.addEventListener('click', function(){
        ZS.pickButton({kind: kind||'trigger', p: p, title:'Pick a button'}).then(function(v){
          if(!v) return;
          paint(v.g);
          if(key){ ZS.store.vals[key] = {g:v.g, source:v.source||null, target:v.target||null}; ZS.persistStore(); }
          ZS.toast(labTx ? labTx+' set' : 'Set');
        });
      });
    });
  }

  /* ── curve drawing (aim response) ─────────────────────────────── */
  function curvePath(type, custom){
    var W=260,H=120,pad=10;
    function pt(x,y){ return (pad+x*(W-2*pad)).toFixed(1)+','+(H-pad-y*(H-2*pad)).toFixed(1); }
    if(type==='Custom' && custom){
      var pts=[[0,0],[0.25,custom[0]/100],[0.5,custom[1]/100],[0.75,custom[2]/100],[1,1]];
      var d='M'+pt(0,0);
      for(var i=1;i<pts.length;i++){
        var a=pts[i-1], b=pts[i];
        var cx1=a[0]+(b[0]-a[0])/3, cx2=a[0]+2*(b[0]-a[0])/3;
        d+=' C'+pt(cx1,a[1])+' '+pt(cx2,b[1])+' '+pt(b[0],b[1]);
      }
      return d;
    }
    /* the exponents here must stay equal to CURVE_MAP's curveStrength values,
       or the picture on screen stops being the curve the board is running */
    function f(x){
      if(type==='Gentle')     return Math.pow(x,1.9);
      if(type==='Aggressive') return Math.pow(x,0.55);
      return x;
    }
    var d2=''; for(var j=0;j<=24;j++){ var x=j/24; d2 += (j?' L':'M')+pt(x,f(x)); }
    return d2;
  }
  /* `sfx` exists because a Joystick + Mouse config draws TWO of these on one
     screen — the mouse curve and the stick curve. Without distinct ids the
     second one's drag handles would move the first one's path. */
  function curveBox(type, custom, sfx){
    sfx = sfx || '';
    var handles='';
    if(type==='Custom' && custom){
      var W=260,H=120,pad=10;
      [0.25,0.5,0.75].forEach(function(t,i){
        var cx=pad+t*(W-2*pad), cy=H-pad-(custom[i]/100)*(H-2*pad);
        handles += '<circle class="chandle" data-h="'+i+'" cx="'+cx.toFixed(1)+'" cy="'+cy.toFixed(1)+'" r="7" fill="var(--accent)" stroke="#0b0e13" stroke-width="2.5" style="cursor:grab;touch-action:none"/>';
      });
    }
    return '<div class="vizbox" style="padding:10px">'+
      '<svg id="curvesvg'+sfx+'" viewBox="0 0 260 120" style="width:100%;height:auto;touch-action:none">'+
        '<line x1="10" y1="110" x2="250" y2="110" stroke="var(--line)"/>'+
        '<line x1="10" y1="10" x2="10" y2="110" stroke="var(--line)"/>'+
        '<line x1="10" y1="110" x2="250" y2="10" stroke="var(--line)" stroke-dasharray="3 4"/>'+
        '<path id="curvepath'+sfx+'" d="'+curvePath(type,custom)+'" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round"/>'+
        handles+
      '</svg><div style="color:var(--muted);font-size:12px;text-align:center;margin-top:2px">'+
      (type==='Custom'?'drag the handles to shape your curve':'stick / mouse input → aim output')+'</div></div>';
  }

  /* ── virtual controller (dashboard) ───────────────────────────── */
  /* The controller picture. Every part carries an id so livePad() can light
     it up from the board's real output — the fastest way for anyone to see
     "yes, this thing is working, and that was MY button". */
  function padSVG(p){
    /* [colour, cx, cy, button-name] — north/east/south/west by position */
    var face = padFam(p)==='ps'
      ? [['#4EC9A8','150','66','north'],['#E06C75','166','80','east'],['#D66BA0','134','80','west'],['#7DA9D8','150','94','south']]
      : [['#E8C13C','150','66','north'],['#D65454','166','80','east'],['#4C8DE0','134','80','west'],['#6DBF44','150','94','south']];
    var dots = face.map(function(f){
      return '<circle class="pad-btn" data-b="'+f[3]+'" cx="'+f[1]+'" cy="'+f[2]+'" r="6" fill="#0b0e13" stroke="'+f[0]+'" stroke-width="1.8" data-col="'+f[0]+'"/>';
    }).join('');
    return '<svg viewBox="0 0 280 150" style="width:100%;height:auto" class="padviz">'+
      /* shoulders + triggers (triggers fill by how far they are pulled) */
      '<rect class="pad-btn" data-b="l1" x="72" y="20" width="40" height="10" rx="5" fill="var(--panel2)" stroke="var(--line)" data-col="var(--accent)"/>'+
      '<rect class="pad-btn" data-b="r1" x="168" y="20" width="40" height="10" rx="5" fill="var(--panel2)" stroke="var(--line)" data-col="var(--accent)"/>'+
      '<rect x="78" y="6" width="28" height="11" rx="5" fill="var(--panel2)" stroke="var(--line)"/>'+
      '<rect id="pad-lt" x="78" y="6" width="0" height="11" rx="5" fill="var(--accent)" opacity=".85"/>'+
      '<rect x="174" y="6" width="28" height="11" rx="5" fill="var(--panel2)" stroke="var(--line)"/>'+
      '<rect id="pad-rt" x="174" y="6" width="0" height="11" rx="5" fill="var(--accent)" opacity=".85"/>'+
      '<rect x="40" y="34" width="200" height="86" rx="42" fill="var(--panel2)" stroke="var(--line)"/>'+
      '<rect x="70" y="16" width="140" height="30" rx="14" fill="var(--panel2)" stroke="var(--line)"/>'+
      /* sticks — the inner dot moves with the real axes */
      '<circle cx="96" cy="86" r="19" fill="var(--bg)" stroke="var(--line)"/>'+
      '<circle id="pad-ls" class="pad-btn" data-b="l3" cx="96" cy="86" r="7" fill="var(--accent)" data-col="#fff"/>'+
      '<circle cx="184" cy="86" r="19" fill="var(--bg)" stroke="var(--line)"/>'+
      '<circle id="pad-rs" class="pad-btn" data-b="r3" cx="184" cy="86" r="7" fill="var(--accent)" data-col="#fff"/>'+
      dots+
      /* d-pad arms */
      '<rect class="pad-btn" data-b="dpad_up" x="112" y="76" width="8" height="10" rx="2" fill="var(--bg)" stroke="var(--line)" data-col="var(--accent)"/>'+
      '<rect class="pad-btn" data-b="dpad_down" x="112" y="86" width="8" height="10" rx="2" fill="var(--bg)" stroke="var(--line)" data-col="var(--accent)"/>'+
      '<rect class="pad-btn" data-b="dpad_left" x="106" y="82" width="10" height="8" rx="2" fill="var(--bg)" stroke="var(--line)" data-col="var(--accent)"/>'+
      '<rect class="pad-btn" data-b="dpad_right" x="116" y="82" width="10" height="8" rx="2" fill="var(--bg)" stroke="var(--line)" data-col="var(--accent)"/>'+
      '</svg>';
  }
  /* drive the picture from /output/live; returns a stop().
     One pad poller app-wide — revisiting a screen must not stack another. */
  var padPollTimer = null;
  /* liveOutput(cb) — one reader of the SHARED /output/live cache devbar.js
     already fills. Every screen that wants the live output state goes through
     here, so opening a screen no longer adds a second or third concurrent
     request for a document the devbar is fetching anyway. If the cache is
     missing or stale (no devbar on the page, or it stopped), this falls back to
     a direct fetch so the picture still moves. */
  function liveOutput(cb){
    var cached = (ZS.outputLive && ZS.outputLive());
    if(cached){ cb(cached); return; }
    fetch('/agent/output/live').then(function(r){ return r.json(); }).then(function(j){
      if(j && j.ok && j.data) cb(j.data);
    })['catch'](function(){});
  }

  function livePad(root){
    var svg = root.querySelector('.padviz');
    if(padPollTimer){ clearInterval(padPollTimer); padPollTimer=null; }
    if(!svg) return function(){};
    var btns = [].slice.call(svg.querySelectorAll('.pad-btn'));
    var ls = svg.querySelector('#pad-ls'), rs = svg.querySelector('#pad-rs');
    var lt = svg.querySelector('#pad-lt'), rt = svg.querySelector('#pad-rt');
    var iv = setInterval(function(){
      if(!document.body.contains(svg) || !screenLive(null)){ clearInterval(iv); if(padPollTimer===iv) padPollTimer=null; return; }
      if(document.hidden) return;
      liveOutput(function(data){
        if(!document.body.contains(svg)) return;
        var s = (data && data.state) || {}, ax = s.axes || {};
        var down = {}; (s.buttons||[]).forEach(function(b){ down[b]=true; });
        btns.forEach(function(el){
          var on = !!down[el.dataset.b];
          el.setAttribute('fill', on ? (el.dataset.col||'var(--accent)') : (el.dataset.b==='l3'||el.dataset.b==='r3' ? 'var(--accent)' : (el.tagName==='circle'?'#0b0e13':'var(--bg)')));
          el.setAttribute('opacity', on ? '1' : '');
        });
        if(ls){ ls.setAttribute('cx', (96 + (+ax.lx||0)*11).toFixed(1)); ls.setAttribute('cy', (86 - (+ax.ly||0)*11).toFixed(1)); }
        if(rs){ rs.setAttribute('cx', (184 + (+ax.rx||0)*11).toFixed(1)); rs.setAttribute('cy', (86 - (+ax.ry||0)*11).toFixed(1)); }
        if(lt) lt.setAttribute('width', (Math.max(0, Math.min(1, +ax.lt||0))*28).toFixed(1));
        if(rt) rt.setAttribute('width', (Math.max(0, Math.min(1, +ax.rt||0))*28).toFixed(1));
      });
    }, 120);
    padPollTimer = iv;
    return function(){ clearInterval(iv); if(padPollTimer===iv) padPollTimer=null; };
  }
  /* smart-actions.js draws the Buttons screen now and wants the same picture
