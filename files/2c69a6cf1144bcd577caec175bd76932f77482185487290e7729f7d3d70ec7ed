              secs[si].items.splice(2, 0, {g:sg, lab:sl, showLab:true,
                                           v:{kind:'pad', target:'extra1', g:sg}});
          }
        }
      }
      return secs;
    }
    /* 'source-both' is the Joystick + Mouse config's picker: the pad sheet
       and the keyboard/mouse sheet, one after the other in one sheet. It is
       not a new sheet — it is the two existing ones concatenated, so a control
       can never be offered here and be missing there. */
    var padSecs = null;
    if(kind==='source-pad' || kind==='source-both'){
      /* INPUT grid: these are buttons you PRESS, so art and words wear the
         family of the pad in your HANDS (ZSG: connected pad → config console
         → last-seen pad → Xbox), never the OUTPUT platform's table — that
         reuse is exactly how an Xbox config showed A/B/X/Y over a DualSense.
         Only the presentation changes: v.source stays the neutral evdev code. */
      var fam = (window.ZSG && ZSG.family()) || padFam(p||ZS.prof(ZS.activeId));
      var ft = fam==='ps' ? OUT.ps5 : OUT.xbox;
      function ps(i, code){
        var neutral = PAD_IDX_TARGET[i];
        /* nin has no drawn art; ZSG pills it with the right words (B, ZR, +) */
        var g = (fam==='nin' && window.ZSG) ? ZSG.glyph(neutral, fam) : ft[i][1];
        var lab = window.ZSG ? ZSG.label(neutral, fam) : (FRIENDLY[ft[i][0]]||ft[i][0]);
        return {g:g, lab:lab, showLab:true, v:{kind:'source', source:code, g:g}};
      }
      padSecs = [
        /* XIM's rows (D78), the same order as the target sections above and
           the button screen's deck: triggers & bumpers, stick clicks & menu,
           face, D-pad */
        {h:'Triggers & bumpers', pg:'Controller', items:[ps(6,'BTN_TL2'),ps(4,'BTN_TL'),ps(5,'BTN_TR'),ps(7,'BTN_TR2')]},
        {h:'Stick clicks & menu', pg:'Controller', items:[ps(8,'BTN_THUMBL'),ps(15,'BTN_SELECT'),ps(14,'BTN_START'),ps(9,'BTN_THUMBR')]},
        {h:'Face buttons', pg:'Controller', items:[ps(0,'BTN_SOUTH'),ps(1,'BTN_EAST'),ps(2,'BTN_WEST'),ps(3,'BTN_NORTH')]},
        /* "D-pad Down" needs 58px in a 52px tile, so three of the four
           captions clipped to "D-pad D…" / "D-pad Ri…" and "D-pad Left"
           touched both tile edges. The section header already says D-pad;
           the tile only has to say which way. */
        {h:'D-pad', pg:'Controller', items:[ps(10,'BTN_DPAD_UP'),ps(11,'BTN_DPAD_DOWN'),
                           ps(12,'BTN_DPAD_LEFT'),ps(13,'BTN_DPAD_RIGHT')].map(function(it){
          return { g:it.g, lab:it.lab.replace(/^D-?pad\s+/i,''), aria:it.lab,
                   showLab:true, v:it.v };
        })}
      ];
      if(kind==='source-pad') return padSecs;
    }
    /* source-mnk: a picture of the keyboard + the mouse */
    function key(ch, code){ return {g:'key:'+ch, lab:ch+' key', v:{kind:'source', source:code||('KEY_'+ch.toUpperCase()), g:'key:'+ch}}; }
    function wkey(labl, code){ return {g:'wkey:'+labl, lab:labl+' key', wide:true, v:{kind:'source', source:code, g:'wkey:'+labl}}; }
    function ms(g, labl, code){ return {g:g, lab:labl.replace(' mouse button','').replace('mouse side button ','M'), showLab:true, aria:labl, v:{kind:'source', source:code, g:g}}; }
    var mkSecs = [
      {h:'Keyboard', pg:'Keyboard', items:'QWERTYUIOP'.split('').map(function(c){return key(c);})},
      {h:'', pg:'Keyboard', items:'ASDFGHJKL'.split('').map(function(c){return key(c);})},
      {h:'', pg:'Keyboard', items:'ZXCVBNM'.split('').map(function(c){return key(c);})},
      {h:'Numbers', pg:'Keyboard', items:'1234567890'.split('').map(function(c){return key(c,'KEY_'+c);})},
      {h:'Big keys', pg:'Keyboard', items:[wkey('Space','KEY_SPACE'), wkey('Shift','KEY_LEFTSHIFT'), wkey('Ctrl','KEY_LEFTCTRL'),
        wkey('Tab','KEY_TAB'), wkey('Esc','KEY_ESC'), wkey('Enter','KEY_ENTER'), wkey('Caps','KEY_CAPSLOCK'),
        wkey('Alt','KEY_LEFTALT'), wkey('Win','KEY_LEFTMETA'), wkey('Bksp','KEY_BACKSPACE')]},
      /* [ and ] are the SHIPPED Passthrough Mode shortcut, and until this row
         existed they were the one pair of keys the picker could not express —
         you could be told to press them and then not find them here. The
         arrows and the punctuation round out the keys a shortcut actually
         tends to use, since a shortcut wants keys that are NOT already bound
         to something in your config. */
      {h:'Arrows & punctuation', pg:'Keyboard', items:[wkey('↑','KEY_UP'), wkey('↓','KEY_DOWN'),
        wkey('←','KEY_LEFT'), wkey('→','KEY_RIGHT'), wkey('[','KEY_LEFTBRACE'),
        wkey(']','KEY_RIGHTBRACE'), wkey('-','KEY_MINUS'), wkey('=','KEY_EQUAL'),
        wkey(';','KEY_SEMICOLON'), wkey('\'','KEY_APOSTROPHE'),
        wkey(',','KEY_COMMA'), wkey('.','KEY_DOT'), wkey('/','KEY_SLASH'),
        wkey('\\','KEY_BACKSLASH'), wkey('`','KEY_GRAVE')]},
      {h:'Function keys', pg:'Keyboard', items:[wkey('F1','KEY_F1'), wkey('F2','KEY_F2'),
        wkey('F3','KEY_F3'), wkey('F4','KEY_F4'), wkey('F5','KEY_F5'),
        wkey('F6','KEY_F6'), wkey('F7','KEY_F7'), wkey('F8','KEY_F8'),
        wkey('F9','KEY_F9'), wkey('F10','KEY_F10'), wkey('F11','KEY_F11'),
        wkey('F12','KEY_F12')]},
      {h:'Mouse', pg:'Mouse', items:[ms('m-left','left mouse button','BTN_LEFT'), ms('m-right','right mouse button','BTN_RIGHT'),
        ms('m-mid','middle mouse button','BTN_MIDDLE'), ms('m4','mouse side button 4','BTN_SIDE'), ms('m5','mouse side button 5','BTN_EXTRA')]}
    ];
    return padSecs ? padSecs.concat(mkSecs) : mkSecs;
  }

  /* glyph for a control captured on the device (labels.py describe() shape).
     A capture happened on the PHYSICAL pad, so its art must wear that pad's
     family — never the output platform's table. */
  function capturedGlyph(c, p){
    if(c.target && TGT_IDX[c.target]!=null){
      var i = TGT_IDX[c.target];
      if(window.ZSG) return ZSG.glyph(PAD_IDX_TARGET[i]);
      var fam = padFam(p||ZS.prof(ZS.activeId));
      return (fam==='ps' ? OUT.ps5 : OUT.xbox)[i][1];
    }
    var src = String(c.source||'');
    if(PAD_CODE_NAME[src]!=null && window.ZSG) return ZSG.glyph(src);
    var n = srcNameOf(src);
    if(SRC_PAD[n]) return SRC_PAD[n];
    return n.length<=2 ? 'key:'+n : 'wkey:'+n;
  }

  /* pickButton({kind:'target'|'trigger'|'source-mnk'|'source-pad'|'source-both', p, title, current,
     capture:true}) → Promise resolving {kind, g, target?/source?/idx?} or null.
     capture: also arms the board's press-to-bind — pressing the real control picks it. */
  /* THE PICKER SHEET PAGES (2026-09-04). Owner, on the button screen: "I
     should be able to swipe left or right like on the phone to see other
     buttons, like keyboard buttons." Where that is true — an INPUT can be a
     key — the sheet that used to be one long scroll (five pad sections,
     then eight keyboard rows, then the mouse) is now a deck: Controller ·
     Keyboard · Mouse for a Joystick + Mouse config, Keyboard · Mouse for a
     mouse config, Buttons · Sticks for a target. It is the Smart Actions
     palette's own deck (ZS.deck, exported from smart-actions.js), so the
     app has one swipe and the page NAMES stay the primary control. A kind
     whose sections all share one page draws the plain list it always did.
     PK_PAGE remembers the page per kind: re-opening the picker lands where
     you left it, which is usually the page you are still working on. */
  var PK_PAGE = {};
  /* The listening banner at the top of a picker (D159). Status, in words
     AND in shape (DESIGN.md: never colour alone): a breathing accent ring
     while the device listens, a check when it heard, a hollow ring and a
     "Listen again" key when the time ran out. The ring breathes on
     opacity only, and stands still under Reduce Motion (body.a11y-motion
     or the OS setting) without losing the words. */
  function pkLiveHTML(state){
    if(state==='timeout') return '<span class="pkl-dot" aria-hidden="true"></span>'+
      '<span class="pkl-t"><b>Stopped listening.</b> Tap the button below, or listen again.</span>'+
      '<button class="pkl-again" id="pk-again" type="button">Listen again</button>';
    if(state==='off') return '<span class="pkl-dot" aria-hidden="true"></span>'+
      '<span class="pkl-t">Tap the button you want below.</span>';
    if(state==='nav') return '<span class="pkl-dot" aria-hidden="true"></span>'+
      '<span class="pkl-t"><b>Passthrough Mode is on,</b> so your controller is moving through the app. Tap the button you want below.</span>';
    if(state==='heard') return '<span class="pkl-dot" aria-hidden="true">✓</span>'+
      '<span class="pkl-t"><b>Got it.</b></span>';
    return '<span class="pkl-dot" aria-hidden="true"></span>'+
      '<span class="pkl-t"><b>Press the button you want</b> on your keyboard, mouse or controller — '+
      'or tap it below. That press is not sent to the game.</span>';
  }
  function injectPkLiveCSS(){
    if(document.getElementById('zs-pklive-css')) return;
    var st = document.createElement('style');
    st.id = 'zs-pklive-css';
    st.textContent = [
      '.pk-live{display:flex;align-items:center;gap:11px;margin:0 0 8px;padding:11px 13px;',
      'border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--r-card,12px);',
      'background:var(--panel);font-size:13px;line-height:1.4;color:var(--text)}',
      '.pk-live .pkl-t{flex:1;min-width:0}',
      '.pk-live .pkl-dot{flex:none;display:flex;align-items:center;justify-content:center;',
      'width:14px;height:14px;border-radius:50%;background:var(--accent);',
      'box-shadow:0 0 0 4px rgba(47,217,206,.18);animation:pklBreathe 1.6s ease-in-out infinite;',
      'color:var(--accent-ink);font-size:10px;font-weight:800}',
      '.pk-live.heard .pkl-dot{animation:none;background:var(--green)}',
      '.pk-live.timeout,.pk-live.off,.pk-live.nav{border-left-color:var(--line)}',
      '.pk-live.timeout .pkl-dot,.pk-live.off .pkl-dot,.pk-live.nav .pkl-dot{animation:none;background:none;',
      'box-shadow:none;border:2px solid var(--muted)}',
      '.pk-live .pkl-again{flex:none;min-height:36px;padding:0 13px;border-radius:999px;border:0;',
      'background:var(--accent);color:var(--accent-ink);font-weight:700;font-size:13px;cursor:pointer}',
      '.pk-live .pkl-again:active{transform:scale(.97);transition:transform 90ms ease-out}',
      '@keyframes pklBreathe{0%,100%{opacity:1}50%{opacity:.45}}',
      '@media (prefers-reduced-motion: reduce){.pk-live .pkl-dot{animation:none}}',
      'body.a11y-motion .pk-live .pkl-dot{animation:none}'
    ].join('');
    document.head.appendChild(st);
  }
  /* THE PICKER LISTENS FOR AS LONG AS IT IS OPEN (owner, 2026-10-10: "remove
     the Press and I'll find it button: the picker always listens and the
     first deliberate press is selected"). One listener for every sheet that
     asks for an INPUT: pickButton below, the Scripts editor's "What starts
     this action?" and Record a script's start and stop questions
     (smart-actions/09-sheets.js, 10-recorder.js), so the three can never
     disagree about what counts as a press.

     listenForPress(body, {mount, p, onHeard}) arms the device's press-to-bind
     (POST /capture/start) the moment the sheet is painted and keeps it armed
     until stop(): a time-out (the Core's safety net) re-arms at once, so
     nothing has to be tapped to listen again. onHeard(src, c, said) gets the
     source ("BTN_TL2"/"BTN_TR2" for a pulled trigger, as a binding names
     it). WHAT COUNTS is the Core's own rule (zs_bindcap.c, D159): a fresh
     down edge of a key, mouse button or pad button, or a trigger pulled past
     60% from below it. A stick never answers, a trigger resting or already
     pulled when the sheet opened does not, and a press that was already
     down when the sheet opened does not (its release is not a press).
     NOT IN PASSTHROUGH MODE (D205): there the pad is moving through the app, and
     its presses are how the player picks a tile, so the sheet says "tap"
     and the device is never asked to listen; it starts listening the moment
     Navigate goes off while the sheet is still open. Returns {stop}. */
  function listenForPress(body, o){
    var done=false, capIv=null, armed=false, navIv=null, lastState='';
    var mount = o.mount;
    if(!mount) return { stop:function(){} };
    injectPkLiveCSS();
    /* is Passthrough Mode ON - not "does the Core report its block" (the
       block is always there; that read said "on" every time) */
    function navOn(){ return !!(window.zsNavIsOn && window.zsNavIsOn()); }
    function liveSay(state){
      if(lastState===state && state!=='listening') return;
      lastState = state;
      mount.className = 'pk-live'+(state==='listening'?'':' '+state);
      mount.innerHTML = pkLiveHTML(state);
      var again = mount.querySelector('#pk-again');
      if(again) again.addEventListener('click', function(){ arm(); });
    }
    function stopCapture(){
      if(capIv){ clearInterval(capIv); capIv=null; }
      if(armed){ armed=false; ZS.api('/capture/cancel','POST',{}); }
    }
    function stop(){
      if(done) return;
      done=true; stopCapture();
      if(navIv){ clearInterval(navIv); navIv=null; }
    }
    /* Navigate on: no listening; poll the flag and arm when it goes off */
    function waitNav(){
      liveSay('nav');
      if(navIv) return;
      navIv = setInterval(function(){
        if(done){ clearInterval(navIv); navIv=null; return; }
        if(!navOn()){ clearInterval(navIv); navIv=null; arm(); }
      }, 500);
    }
    function arm(){
      if(done) return;
      if(navOn()){ waitNav(); return; }
      liveSay('listening');
      ZS.api('/capture/start','POST',{accept:'control', timeoutMs:60000}).then(function(j){
        if(!j || !j.ok){
          if(!done) liveSay('off');
          return;
        }
        if(done){
          /* the sheet closed before the board answered — disarm it now, or
             it keeps listening and grabs an unrelated press */
          ZS.api('/capture/cancel','POST',{});
          return;
        }
        armed = true;
        if(capIv) clearInterval(capIv);
        capIv = setInterval(function(){
          if(done){ stopCapture(); return; }
          if(navOn()){ stopCapture(); waitNav(); return; }
          ZS.api('/capture/status').then(function(s){
            if(!s || !s.ok || done) return;
            var d = s.data||{};
            if(d.state==='captured'){
              var c = d.captured || d.control || d;
              if(!c.source){ return; }
              armed = false; /* capture consumed itself */
              if(capIv){ clearInterval(capIv); capIv=null; }
              /* A pulled analog trigger is reported as the AXIS ("rt"), but a
                 binding source must be a key/button code the resolver can
                 match — translate it to the pad's trigger button. */
              var src = String(c.source);
              var axis = src.toLowerCase().replace(/[+-]$/,'');
              if(axis==='lt') src='BTN_TL2';
              else if(axis==='rt') src='BTN_TR2';
              liveSay('heard');
              o.onHeard(src, c);
            } else if(d.state==='timeout' || d.state==='cancelled' || d.state==='idle'){
              /* the Core's time ran out (or something else cancelled it):
                 the sheet is still open, so it simply listens again */
              armed = false;
              if(capIv){ clearInterval(capIv); capIv=null; }
              arm();
            }
          });
        }, 450);
      });
    }
    if(o.canCapture === false || ZS.live.online === false){ liveSay('off'); }
    else arm();
    return { stop: stop };
  }
  ZS.listenForPress = listenForPress;
  ZS.pkLiveHTML = function(state){ injectPkLiveCSS(); return pkLiveHTML(state); };

  function pickButton(opts){
    return new Promise(function(resolve){
      var done=false, listener=null;
      function finish(v){ if(done) return; done=true; if(listener) listener.stop(); resolve(v); }
      /* PRESS-TO-BIND EVERYWHERE (D159). Any picker that asks for an INPUT
         (a source, a trigger, a shortcut key) listens on the device: the
         next key, mouse button, wheel notch, pad button or trigger pull
         answers it, and the device keeps that press from the console. Only a
         TARGET picker (what to SEND) does not listen, because pressing a
         button on your pad is not how you say what the console should get.
         A caller can still opt out with capture:false. */
      var canCapture = opts.capture!==false && opts.kind!=='target' &&
                       ZS.live.online!==false;
      var html='';
      if(canCapture){
        injectPkLiveCSS();
        html += '<div class="pk-live" id="pk-live" role="status" aria-live="polite">'+pkLiveHTML('listening')+'</div>';
      }
      var PAGES = [], BY = {};
      function secHTML(sec){
        var sh = '';
        if(sec.h) sh += '<div class="pkh">'+esc(sec.h)+'</div>';
        /* D128's one line under a page's first header: what a tap on this
           page MEANS. sa-mnk.js writes it and escapes what it interpolates. */
        /* D285: the page's note is its "?" (bullets), not a paragraph */
        if(sec.note) sh += '<div class="pknote">'+helpHTML('pknote-'+(sec.pg || sec.h || 'pg').replace(/\W+/g, '-'),
          sec.h || 'This page', sec.note)+'</div>';
        sh += '<div class="pkgrid">'+sec.items.map(function(it){
          var cur = opts.current && it.g===opts.current;
          var aria = it.aria || it.lab;
          /* A TILE THAT SAYS THE SAME WORD TWICE. The face buttons draw a
             symbol and caption it ("✕" over "Cross"), but the shoulders,
             triggers, stick clicks and the touchpad draw their own letters —
             so those tiles rendered "L1" over "L1", "R2" over "R2", "PS" over
             "PS". Keep the caption (it is the word, and the accessible name
             is built from it) and drop the picture when the picture is only
             repeating it. */
          var art = btnArt(it.g);
          var dup = it.showLab && sameGlyphWord(art, it.lab);
          /* it.hint (D128) is the key or mouse button the config binds to
             this controller button, drawn as a sticker in the corner; the
             accessible name already says it in words */
          return '<button class="pk'+(it.wide||String(it.g).indexOf('wkey:')===0?' wide':'')+(cur?' cur':'')+
            (it.dim?' pkdim':'')+
            '" data-v="'+esc(JSON.stringify(it.v))+'" aria-label="'+esc(aria)+'" title="'+esc(aria)+'">'+
            (dup?'':art)+
            (it.showLab?'<span class="pklab">'+esc(it.lab)+'</span>':'')+
            (it.hint?'<span class="pkhint" aria-hidden="true">'+it.hint+'</span>':'')+'</button>';
        }).join('')+'</div>';
        return sh;
      }
      pickSections(opts.kind, opts.p).forEach(function(sec){
        var k = sec.pg || '';
        if(!BY[k]){ BY[k] = {n:k, h:''}; PAGES.push(BY[k]); }
        BY[k].h += secHTML(sec);
      });
      var deck = PAGES.length > 1 && !!ZS.deck;
      /* opts.page names the page to open on, over the remembered one: New
         Script asks for 'Controller' (owner, 2026-10-07: the pad buttons
         are "99.9% where people are clicking") */
      var startPg = PK_PAGE[opts.kind]||0;
      if(opts.page && BY[opts.page]) startPg = PAGES.indexOf(BY[opts.page]);
      if(deck){ ZS.deck.css(); html += ZS.deck.html('pk-deck', PAGES, startPg); }
      else html += PAGES.map(function(pg){ return pg.h; }).join('');
      var body = ZS.sheetOpen(opts.title||'Choose a button', html, function(){ finish(null); });
      if(deck) ZS.deck.wire(body, 'pk-deck', startPg, function(i){ PK_PAGE[opts.kind] = i; });
      body.querySelectorAll('.pk').forEach(function(b){
        b.addEventListener('click', function(){
          var v=null; try{ v=JSON.parse(b.dataset.v); }catch(e){}
          finish(v); ZS.sheetClose();
        });
      });
      /* the tile the press answered, so the name the toast says is the
         name the player would have tapped ("Alt", not "KEY_LEFTALT") */
      function tileFor(src){
        var hit = null;
        body.querySelectorAll('.pk').forEach(function(b){
          if(hit) return;
          var v=null; try{ v=JSON.parse(b.dataset.v); }catch(e){}
          if(v && v.source===src) hit = b;
        });
        return hit;
      }
      if(canCapture){
        listener = listenForPress(body, { mount: body.querySelector('#pk-live'), p: opts.p,
          onHeard: function(src, c){
            var g = capturedGlyph(c, opts.p);
            /* A Core sends the control's own name as its label (it has
               no table of people's words); the A7S sends a person's
               word. Prefer the tile's name, then a real label. */
            var tile = tileFor(src);
            var said = (tile && tile.getAttribute('aria-label')) ||
                       (c.label && c.label!==c.source ? c.label : srcNameOf(src));
            if(tile) tile.classList.add('cur');
            ZS.toast(said+' detected');
            finish({kind:'source', source:src, g:g, label:said});
            ZS.sheetClose();
          } });
        if(done) listener.stop();
