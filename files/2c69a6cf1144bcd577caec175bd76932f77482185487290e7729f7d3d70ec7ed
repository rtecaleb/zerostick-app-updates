/* sections/01-kit.js — the kit every screen is built from.
 *
 * HTML builders (sh, card, fld, toggle, slider, seg, stepper, dd, selFld, note,
 * btn, acc, door, pgTabsHTML...), the board binding B(path, scale) that makes a
 * control save itself into the config (phone.html's ZS.wire does the saving),
 * the "?" help chip and the "!" warning chip (D70), the pickers (pickButton with
 * press-to-bind D159, pickList, askPaste), button art (btnArt, glyFor, srcGly,
 * famGlyph), the live controller picture (padSVG, livePad, padArt), the aim
 * response curve drawing, the names of buttons and sources (srcNameOf, TGT_IDX,
 * PAD_SRC_CODE, PAD_IDX_TARGET, srcPickKind), and R, the table of screens
 * every later file adds its renderer to.
 *
 * Also offers on ZS:          ZS.helpHTML, ZS.warnHTML, ZS.warnText, ZS.warnList,
 *                             ZS.warnNotes, ZS.padFam, ZS.famGlyph, ZS.sameGlyphWord,
 *                             ZS.pickButton, ZS.btnArt, ZS.srcPickKind, ZS.pickList,
 *                             ZS.padSVG, ZS.livePad, ZS.padArt
 * Talks to:                   /capture/start | status | cancel (press-to-bind, pickButton),
 *                             /output/live (livePad, through devbar.js's shared cache)
 * Tests:                      test-render.js, test-core-capture.js, test-settings-icons.js, emulate-app.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('kit', function (SEC) {
  var ZS = window.ZS;
  var esc = ZS.esc;
  var ico = ZS.icoSVG;
  /* the icon PICTURES (D91, icons3d/): pic() is phone.html's <img> builder,
     guarded because test-account.js boots this file against a bare ZS mock
     that has no pic(). Every caller keeps its words — the picture is
     decoration, alt="" and aria-hidden, never the only signal. */
  function pic(name, px, cls){ return ZS.pic ? ZS.pic(name, px, cls) : ''; }
  function btnInner(icon, label){ return pic(icon, 18, 'sicon si-'+icon) + '<span>' + esc(label) + '</span>'; }
  /* a key with a picture before its word (the word is still the label) */
  function btnP(icon, label, kind, id){
    return '<button class="btn'+(kind?' '+kind:'')+'"'+(id?' id="'+id+'"':'')+'>'+btnInner(icon, label)+'</button>';
  }
  /* the pictures' credit row, in creditsHTML()'s own row shape. CC BY 3.0
     makes naming the artists a DUTY, not a courtesy: the sentence below is
     the wording game-icons.net asks for ("Icons made by {author}. Available
     on https://game-icons.net"), and tools/test-icons3d.js pins that every
     artist icons3d/LICENSE credits is named here. The notice itself, every
     artist's credit line and the CC BY 3.0 text travel in icons3d/LICENSE. */
  function picCreditsHTML(){
    if(!ZS.pic) return '';
    return '<div class="stat"><span>Icon pictures (the chrome marks on every screen)</span><b>game-icons.net · CC BY 3.0</b></div>'+
      '<div style="color:var(--muted);font-size:12px;line-height:1.6;margin-top:2px">'+
      'Icons made by Lorc, Delapouite, Sbed, Skoll, PriorBlue, Guard13007 and others. Available on https://game-icons.net, CC BY 3.0 '+
      '(the infinity sign is the site’s CC0 picture by Various artists). Each silhouette is rendered here in a brushed-chrome finish; '+
      'no shape was redrawn. Five shapes (once, keycap, thumbstick, plus, minus) are Kenney’s Input Prompts 1.5, CC0. '+
      'The licence notice, every artist’s credit line and the CC BY 3.0 text ship in icons3d/LICENSE</div>'+
      /* D239: the live DualSense drawing */
      '<div class="stat"><span>The live DualSense drawing</span><b>dualshock-tools · MIT</b></div>'+
      '<div style="color:var(--muted);font-size:12px;line-height:1.6;margin-top:2px">'+
      'dualsense-controller.svg from dualshock-tools, Copyright (c) 2024 the_al, MIT License.</div>';
  }

  /* ── section tints ────────────────────────────────────────────────
     The editor menu's five rows each wear a colour chip (phone.html's
     .ico-<sectionid> rules), and since 2026-08-18 each section's CONTENT
     carries that same identity: phone.html's openDetail stamps
     `data-tint="<sectionid>"` on #dbody for the five SECTIONS ids, and
     zs-kit.css §17 keys every tint hook (group headers, accordion icons,
     ON states) off that one attribute — no per-control markup. This table
     is this file's half of the contract: SUB-SCREENS reached through doors
     (Controller Feel, Keyboard Movement, Aim Speed Match, …) are part of
     their parent section's content, but openDetail only knows the five
     top-level ids — so the renderer wrapper beside `window.RENDERERS = R`
     re-stamps the parent's tint from this map in after(), when #dbody is
     in hand. The values ARE the five SECTIONS ids, so a screen can never
     wear another section's colour; a screen with no entry here (global,
     profiles, the wizard) stays neutral, exactly as openDetail left it.
     Decorative only: state still rides the `on` class + aria, and every
     label still says in words what the colour hints (docs/DESIGN.md —
     colour is never the only signal). */
  var TINT_OF = {
    overview:'overview', pcout:'overview', pairing:'overview', lighting:'overview',
    psnlink:'overview', rpsetup:'overview',
    aim:'aim', velocity:'aim', kbmove:'aim', gamepad:'aim', game:'aim',
    /* D163: Behavior wears Aim's gold, the way Auto Actions wears Smart
       Actions' rose (D127): it is how the aim and the walk FEEL, one room's
       subject in two screens, not a sixth subject */
    behavior:'aim', translation:'aim',
    bindings:'bindings',
    smart:'smart', roles:'smart', modifiers:'smart',
    vision:'vision'
  };

  /* ── kit builders ─────────────────────────────────────────────── */
  /* `kind` (optional) rides the header as a modifier class. Today the only
     value is 'danger', which swaps the corner bracket and the label from the
     screen's tint to the destructive red — so "Danger zone" stops wearing the
     same teal tick as "More board details" one row above it. */
  function sh(t, kind){ return '<div class="sh'+(kind?' '+kind:'')+'">'+esc(t)+'</div>'; }
  function card(inner){ return '<div class="grp-card">'+inner+'</div>'; }
  function toggle(on, nosave, b){ return '<span class="sw'+(on?' on':'')+'"'+(nosave?' data-nosave="1"':'')+(typeof bindAttr==='function'?bindAttr(b):'')+'></span>'; }
  function fld(label, control, sub, b){
    return '<div class="fld"><div class="flab">'+esc(label)+(b?bmark(b):'')+(sub?'<em>'+esc(sub)+'</em>':'')+'</div>'+control+'</div>';
  }
  /* ── board binding ────────────────────────────────────────────────
     Pass a spec as the LAST argument of any kit builder and the control stops
     being decoration: phone.html's saveV/loadV then write and read that path
     on the live config.

         slider('Inner deadzone', 0, 40, 8, '%', B('deadZones.leftInner', .01))

     Kept as a trailing optional argument on purpose, so none of the hundreds
     of existing call sites change. A control with no spec behaves exactly as
     it always did (local only) — which is still right for the screens that
     describe things the board has no field for. */
  function B(path, scale, opt){
    var o = opt || {};
    return { p:path, s:scale, t:o.t, mn:o.mn, mx:o.mx, map:o.map, dp:o.dp };
  }
  function bindAttr(b){
    if(!b || !b.p) return '';
    var a = ' data-bind="'+esc(b.p)+'"';
    if(b.s!=null && b.s!==1) a += ' data-bindscale="'+b.s+'"';
    if(b.t) a += ' data-bindtype="'+esc(b.t)+'"';
    if(b.mn!=null) a += ' data-bindmin="'+b.mn+'"';
    if(b.mx!=null) a += ' data-bindmax="'+b.mx+'"';
    if(b.map) a += " data-bindmap='"+JSON.stringify(b.map).replace(/'/g,'&#39;')+"'";
    /* dp (D191): the shown value is fixed to this many decimals ("67.5",
       "55.0"), as XIM shows its smoothing percentages. phone.html bindRead
       and the stepper's clampSet honour it. */
    if(b.dp!=null) a += ' data-binddp="'+b.dp+'"';
    return a;
  }
  /* a bound control earns a dot, so "settings marked ● save straight to your
     board" in the header is a promise the screen actually keeps */
  function bmark(b){ return b && b.p ? '<span class="livedot" title="saves to your board">●</span>' : ''; }

  function toggleFld(label, on, sub, nosave, b){
    return fld(label, toggle(on, nosave, b), sub, b);
  }
  /* nosave: the LAST argument, and only for sliders whose value is owned by the
     board and re-derived on every render. Without it wire() restores the local
     cache over the board-derived default and the screen shows a number the
     board does not hold (which then gets written back on the next nudge). */
  /* `div` (trailing, optional): the readout shows value ÷ div, so a control
     whose real domain runs BELOW one of its own units can still say what it
     holds. The slider's own value stays a whole number — a range input has
     no fractional steps worth trusting on a phone — and the writer divides
     by the same figure. Added for the target size ceiling, whose board-side
     floor is 0.001 of the screen: at whole percent that rounded to 0, the
     range's own min then clamped it to 2%, and the app printed a ceiling
     twenty times the one the config actually held. */
  function slider(label, min, max, val, unit, b, nosave, div){
    return '<div class="fld col"><div class="flab">'+esc(label)+bmark(b)+'<span class="rv"></span></div>'+
      '<input class="rng" type="range" min="'+min+'" max="'+max+'" value="'+val+'" data-unit="'+(unit||'')+'"'+
      (div > 1 ? ' data-div="'+div+'"' : '')+
      (nosave?' data-nosave="1"':'')+bindAttr(b)+'></div>';
  }
  /* `sub` (trailing, optional): a plain-English hint under the label. Safe for
     binding keys BY CONSTRUCTION — phone.html's labFor() reads
     flab.childNodes[0], the label's own text node, and the <em> lands after
     it; verified against keyFor() before any hint was added. */
  function seg(label, opts, idx, nosave, b, sub){
    return '<div class="fld col"><div class="flab">'+esc(label)+bmark(b)+(sub?'<em>'+esc(sub)+'</em>':'')+'</div><div class="seg2"'+(nosave?' data-nosave="1"':'')+bindAttr(b)+'>'+
      opts.map(function(o,i){ return '<button'+(i===(idx||0)?' class="on"':'')+'>'+esc(o)+'</button>'; }).join('')+'</div></div>';
  }
  /* attrs: extra attributes for the value element (e.g. the data-gapmin /
     data-suggest detent phone.html's stepper wiring honours), as a leading-
     space string. Trailing and optional so no existing call site changes. */
  function stepper(label, val, d, min, max, suffix, sub, b, attrs){
    return fld(label, svspan(val,min,max,suffix,d,b,attrs), sub, b);
  }
  function svspan(val,min,max,suf,d,b,attrs){
    return '<span class="stp"><button data-d="-'+d+'" aria-label="decrease">−</button><b class="sv" data-min="'+min+'" data-max="'+max+'"'+(suf?' data-suffix="'+esc(suf)+'"':'')+(attrs||'')+bindAttr(b)+'>'+val+'</b><button data-d="'+d+'" aria-label="increase">+</button></span>';
  }
  function dd(opts, sel, cls, nosave){
    return '<select class="sel'+(cls?' '+cls:'')+'"'+(nosave?' data-nosave="1"':'')+'>'+opts.map(function(o){ return '<option'+(o===sel?' selected':'')+'>'+esc(o)+'</option>'; }).join('')+'</select>';
  }
  function selFld(label, opts, idx, sub, nosave){
    return fld(label, '<select class="sel"'+(nosave?' data-nosave="1"':'')+'>'+opts.map(function(o,i){ return '<option'+(i===(idx||0)?' selected':'')+'>'+esc(o)+'</option>'; }).join('')+'</select>', sub);
  }
  function txtFld(label, val, nosaveCls){
    return '<div class="fld col"><div class="flab">'+esc(label)+'</div><input class="txt'+(nosaveCls?' '+nosaveCls:'')+'" '+(nosaveCls?'data-nosave="1" ':'')+'style="margin-top:10px" value="'+esc(val||'')+'"></div>';
  }
  /* note(t,'warn') paints the "!" chip (warnHTML below) unless `now` is
     set — `now` means "this sentence is the answer to a tap the player just
     made", and an answer must not hide behind a chip. */
  function note(t, kind, now){
    if(kind==='warn' && !now) return warnHTML(t);
    /* a full warn block (an answer to a tap, D70) opens on the warning
       picture where it used to open on a "⚠" character (D91); the words
       after it are untouched and still carry the meaning */
    if(kind==='warn'){
      var w = pic('warn', 16, 'sicon si-warn');
      if(w) t = String(t == null ? '' : t).replace(/^\s*\u26a0\uFE0F?\s*/, w+' ');
    }
    return '<div class="note'+(kind?' '+kind:'')+'">'+t+'</div>';
  }
  /* ── the "?" help chip (screen-map P1) ─────────────────────────────
     The redesign's one rule about words: a control gets a label and at most
     one short sub-line; anything longer moves behind this chip. The chip is
     a 28px ring with a 44px hit box (the ::after inset below), and the fold
     under it reuses .note so relocated text keeps the look it always had.

     OPEN STATE LIVES IN A MODULE-LEVEL SET, not in the DOM. Half the screens
     that use this are repainted by put() every 320 ms or re-rendered by a
     preset tap, and a class toggled on a repainted node is lost on the next
     poll — the exact bug hexOpen/whyOpen exist to prevent. HELP_OPEN is the
     same idiom, one Set for the whole app, keyed by the chip's own id.

     Wiring is ONE delegated document-level listener (qhWire), so a chip
     rendered into a poll-painted slot is as alive as one in static markup —
     nothing per-screen to remember, nothing wire() has to run before.
     smart-actions.js reaches this through ZS.helpHTML (exported below) so
     the two files can never grow two disagreeing chips. */
  var HELP_OPEN = new Set();
  var QH_CSS_ID = 'zs-qh-css', qhWired = false;
  function qhCss(){
    if(document.getElementById(QH_CSS_ID)) return;
    var s = document.createElement('style');
    s.id = QH_CSS_ID;
    s.appendChild(document.createTextNode(
      '.qhrow{display:flex;justify-content:flex-end;margin:4px 2px 0}'+
      '.qh{position:relative;width:28px;height:28px;border-radius:50%;'+
        'border:1px solid var(--line);background:transparent;color:var(--muted);'+
        'font-size:13.5px;font-weight:700;cursor:pointer;font-family:inherit;'+
        'display:inline-flex;align-items:center;justify-content:center}'+
      /* the 44px promise without 44px of layout */
      '.qh::after{content:"";position:absolute;inset:-8px}'+
      '.qh[aria-expanded="true"]{color:var(--accent);border-color:var(--accent)}'+
      '.qhfold[hidden]{display:none}'+
      /* D260: the explanation as points */
      '.qhlist{margin:2px 0 0;padding:0 0 0 18px;list-style:disc}'+
      '.qhlist li{margin:0 0 6px;padding-left:2px;line-height:1.45}'+
      '.qhlist li:last-child{margin-bottom:0}'+
      '.qhlist li::marker{color:var(--accent)}'));
    (document.head || document.documentElement).appendChild(s);
  }
  function qhToggle(id){
      var open = !HELP_OPEN.has(id);
      if(open) HELP_OPEN.add(id); else HELP_OPEN['delete'](id);
      document.querySelectorAll('[data-qh="'+id+'"]').forEach(function(c){
        c.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.querySelectorAll('[data-qhfold="'+id+'"]').forEach(function(f){
        if(open) f.removeAttribute('hidden'); else f.setAttribute('hidden','');
      });
  }
  ZS.qhToggle = function(id){ qhCss(); qhToggle(id); };
  function qhWire(){
    if(qhWired) return; qhWired = true;
    /* a "?" inside a row that opens something when tapped (a Script row):
       the "?" (and its open fold) answer first, in the capture phase, and
       the row never sees the tap (owner, 2026-10-14: script descriptions
       behind a "?") */
    document.addEventListener('click', function(e){
      var t = e.target && e.target.closest ? e.target : null;
      if(!t) return;
      var b = t.closest('[data-qh]');
      var inRow = t.closest('[role="button"], .saitem, .hmrow');
      if(b && inRow){ e.stopPropagation(); e.preventDefault(); qhToggle(b.getAttribute('data-qh')); return; }
      if(inRow && t.closest('.qhfold')){ e.stopPropagation(); }
    }, true);
    document.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('[data-qh]') : null;
      if(!b) return;
      var id = b.getAttribute('data-qh');
      var open = !HELP_OPEN.has(id);
      if(open) HELP_OPEN.add(id); else HELP_OPEN['delete'](id);
      /* every face of this chip in the document — both pager panes stay in
         the DOM, so an id can legally render twice */
      document.querySelectorAll('[data-qh="'+id+'"]').forEach(function(c){
        c.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.querySelectorAll('[data-qhfold="'+id+'"]').forEach(function(f){
        if(open) f.removeAttribute('hidden'); else f.setAttribute('hidden','');
      });
    });
  }
  /* D260 (owner, 2026-10-10: "when I click the question mark to explain it
     needs to be bullet points, not a paragraph - that's for every
     explanation - not so much paragraphs but more organized"): every "?"
     fold is a list, one point per sentence, built here so all ~45 callers
     change at once and a new explanation is a list by default. A sentence
     that opens with a bold word (<b>Inner</b> stops drift...) keeps it as
     the point's lead. A text that is already a list, or is one sentence,
     is left as it is. Splitting is done outside tags only, and never after
     an abbreviation or inside a number (2.5 s). */
  var HELP_ABBR = /(?:\be\.g|\bi\.e|\bvs|\betc|\bapprox|\bno|\bNo|\bfig|\bSt|\bDr|\bMr|\bMrs)\.$/;
  function helpPoints(text){
    var t = String(text == null ? '' : text);
    if(/<(ul|ol|li|table)\b/i.test(t)) return null;
    var parts = t.split(/(?:\s*<br\s*\/?>\s*)+/i), out = [];
    parts.forEach(function(par){
      var cur = '', depth = 0, i, c;
      for(i = 0; i < par.length; i++){
        c = par.charAt(i);
        if(c === '<') depth++;
        else if(c === '>') depth = Math.max(0, depth - 1);
        cur += c;
        if(!depth && (c === '.' || c === '?' || c === '!') && /\s/.test(par.charAt(i + 1) || '') &&
           !HELP_ABBR.test(cur)){
          /* the next real character: a capital, a digit, a quote or a tag */
          var rest = par.slice(i + 1).replace(/^\s+/, '');
          if(/^(<b>|<em>|<i>|[A-Z0-9"“‘(—])/.test(rest)){
            out.push(cur.trim()); cur = '';
          }
        }
      }
      /* a trailing closing tag that belongs to the last sentence */
      if(cur.trim()) out.push(cur.trim());
    });
    out = out.filter(function(x){ return x.replace(/<[^>]*>/g, '').trim().length > 1; });
    return out.length > 1 ? out : null;
  }
  ZS.helpPoints = helpPoints;
  function helpHTML(id, label, text){
    qhCss(); qhWire();
    var open = HELP_OPEN.has(id);
    var pts = helpPoints(text);
    var body = pts ? '<ul class="qhlist">' + pts.map(function(x){ return '<li>' + x + '</li>'; }).join('') + '</ul>' : text;
    return '<div class="qhrow"><button type="button" class="qh" data-qh="'+esc(id)+'"'+
      ' aria-expanded="'+(open?'true':'false')+'" aria-label="'+esc('Help: '+label)+'">?</button></div>'+
      '<div class="note qhfold" data-qhfold="'+esc(id)+'"'+(open?'':' hidden')+'>'+body+'</div>';
  }
  ZS.helpHTML = helpHTML;
  /* ── the "!" warning chip ─────────────────────────────────────────
     Owner, 2026-09-04: "make all the warnings with exclamation marks just
     yellow little exclamation marks — when you click it, it expands out
     saying the warning — instead of having the warning so big everywhere
     throughout the app." So note(t,'warn') no longer paints a full-width
     amber block: it paints a 28px amber ring with a "!" (44px hit box, the
     same ::after trick as the ? chip) and the old .note.warn block folded
     under it, hidden until tapped. Consecutive chips sit side by side —
     four board complaints used to be four stacked blocks (the 617px of
     amber warnList() above tells the story of) and are now four rings on
     one line.

     The signal is glyph + colour + an accessible name, never colour alone
     (DESIGN.md): the ring is --amber, the glyph is "!", the button is
     named "Warning", and aria-expanded says which state it is in. The
     fold keeps the .note.warn look, so an opened warning reads exactly as
     it always did.

     OPEN STATE LIVES IN A MODULE-LEVEL SET keyed by the chip's id, exactly
     like HELP_OPEN — half the screens that emit warnings are repainted on
     the poll, so a class on the node would vanish three times a second.
     note() never gave a warning an id, so the id is a hash of the text:
     the same sentence re-rendered is the same chip and stays open; a
     sentence that changes (a live number) is a new chip and starts closed,
     which is the honest default for new information. Callers that own a
     stable slot may pass their own id.

     WHAT DOES NOT COLLAPSE: a warning that is the ANSWER to something the
     player just did — "your board would not save that pack", the
     calibration line under the button just pressed. Hiding the result of a
     press behind a chip is a worse bug than a big block. Those sites call
     note(t,'warn',true) and keep the full block. The rule for a new site:
     did a tap cause this sentence? Then it is feedback, not a warning. */
  var WARN_OPEN = new Set();
  var WH_CSS_ID = 'zs-wh-css', whWired = false;
  function whCss(){
    if(document.getElementById(WH_CSS_ID)) return;
    var s = document.createElement('style');
    s.id = WH_CSS_ID;
    s.appendChild(document.createTextNode(
      '.wh{display:inline-block;vertical-align:top;margin:4px 8px 4px 0}'+
      '.wh.open{display:block;margin-right:0}'+
      '.whb{position:relative;width:28px;height:28px;border-radius:50%;padding:0;'+
        'border:1.5px solid var(--amber);background:rgba(227,179,65,.14);color:var(--amber);'+
        'font-size:15px;font-weight:800;line-height:1;cursor:pointer;font-family:inherit;'+
        'display:inline-flex;align-items:center;justify-content:center}'+
      /* the 44px promise without 44px of layout */
      '.whb::after{content:"";position:absolute;inset:-8px}'+
      /* open = solid amber, dark glyph (10:1) — the state is visible without the fold */
      '.whb[aria-expanded="true"]{background:var(--amber);color:#14161a}'+
      '.wh .whfold{margin-top:6px}'+
      '.whfold[hidden]{display:none}'));
    (document.head || document.documentElement).appendChild(s);
  }
  function whWire(){
    if(whWired) return; whWired = true;
    document.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('[data-wh]') : null;
      if(!b) return;
      var id = b.getAttribute('data-wh');
      var open = !WARN_OPEN.has(id);
      if(open) WARN_OPEN.add(id); else WARN_OPEN['delete'](id);
      /* every face of this chip — a pager keeps both panes in the DOM */
      document.querySelectorAll('[data-wh="'+id+'"]').forEach(function(c){
        c.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.querySelectorAll('[data-whwrap="'+id+'"]').forEach(function(w){
        if(open) w.classList.add('open'); else w.classList.remove('open');
      });
      document.querySelectorAll('[data-whfold="'+id+'"]').forEach(function(f){
        if(open) f.removeAttribute('hidden'); else f.setAttribute('hidden','');
      });
    });
  }
  /* djb2 over the sentence — short, stable, and two different warnings on
     one screen never share a chip */
  function whId(t){
    var h = 5381, i;
    for(i=0;i<t.length;i++) h = ((h*33) ^ t.charCodeAt(i)) >>> 0;
    return 'w'+h.toString(36);
  }
  function warnHTML(text, id){
    whCss(); whWire();
    /* the ring IS the glyph now — a "⚠" inside the fold would be two of them */
    var t = String(text == null ? '' : text).replace(/^\s*\u26a0\uFE0F?\s*/, '');
