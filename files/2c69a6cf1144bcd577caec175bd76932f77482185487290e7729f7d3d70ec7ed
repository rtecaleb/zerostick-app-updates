       is handed, so there is still one keyboard and one pad here. */
    if(window.ZS_SA_MNK && ZS_SA_MNK.ownsKind(kind))
      return ZS_SA_MNK.sections(kind, p||ZS.prof(ZS.activeId), pickSections);
    var t = outTable(p||ZS.prof(ZS.activeId));
    function pad(i, target){ return {g:t[i][1], lab:FRIENDLY[t[i][0]]||t[i][0], showLab:true, v:{kind:'pad', idx:i, target:target, g:t[i][1]}}; }
    if(kind==='target' || kind==='trigger'){
      /* XIM's four rows (D78), in the order the button screen's deck draws
         them (smart-actions.js PAD_TGT_GROUPS) — one order everywhere.
         `pg` is the sheet PAGE a section lands on (pickButton below). */
      var secs = [
        {h:'Triggers & bumpers', pg:'Buttons', items:[pad(6,'lt+'),pad(4,'l1'),pad(5,'r1'),pad(7,'rt+')]},
        {h:'Stick clicks & menu', pg:'Buttons', items:[pad(8,'l3'),pad(15,'select'),pad(14,'start'),pad(9,'r3')]},
        {h:'Face buttons', pg:'Buttons', items:[pad(0,'south'),pad(1,'east'),pad(2,'west'),pad(3,'north')]},
        {h:'D-pad', pg:'Buttons', items:[pad(10,'dpad_up'),pad(11,'dpad_down'),pad(12,'dpad_left'),pad(13,'dpad_right')]}
      ];
      if(kind==='target'){
        function stick(code){ var s=STICK_TGT[code]; return {g:s.g, lab:s.lab, showLab:true, v:{kind:'stick', target:code, g:s.g}}; }
        secs.push(
          {h:'Move (left stick)', pg:'Sticks', items:[stick('ly+'),stick('ly-'),stick('lx-'),stick('lx+')]},
          {h:'Aim (right stick)', pg:'Sticks', items:[stick('ry+'),stick('ry-'),stick('rx-'),stick('rx+')]});
        /* The GUIDE (Xbox / PS / Home) button. A real output on every
           backend (common/model.Button.GUIDE) that this grid simply never
           offered — which made "Esc opens the console dashboard", an
           accessibility essential, impossible to set up from the app. Not
           in outTable (a 16-entry pad map), so built by hand from the
           family art the Smart-Actions target pane already uses. */
        var gfam = (p && (p.platform==='ps5' || p.platform==='ps4')) ? 'ps' : 'xb';
        var gg = (window.ZSG && ZSG.outGlyph) ? ZSG.outGlyph('guide', gfam) : 'guide';
