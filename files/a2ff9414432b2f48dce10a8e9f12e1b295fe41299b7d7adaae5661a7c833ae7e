// Floating back button on the calibrator when it was opened from the
// ZeroStick Dongle screen (calibrator.html?from=dongle): goes back to
// dongle.html instead of the device list, and keeps the Bluetooth link
// (the dongle screen adopts it again). Same look as zs-home-fab.js. ES5.
(function () {
  "use strict";
  function add() {
    var b = document.createElement("button");
    b.setAttribute("aria-label", "Back to the dongle");
    b.style.cssText =
      "position:fixed;left:14px;bottom:calc(env(safe-area-inset-bottom,0px) + 14px);" +
      "z-index:100001;height:56px;padding:0 20px 0 14px;border-radius:28px;border:1px solid " +
      "rgba(111,155,255,.5);background:rgba(18,24,36,.94);color:#eef1f6;font:600 16px/1 " +
      "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;" +
      "box-shadow:0 4px 14px rgba(0,0,0,.4);display:flex;align-items:center;gap:8px;" +
      "-webkit-tap-highlight-color:transparent;";
    b.innerHTML =
      '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#eef1f6" ' +
      'stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M15 5l-7 7 7 7"/></svg>Dongle';
    b.addEventListener("click", function () {
      window.location.href = "dongle.html";
    });
    document.body.appendChild(b);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", add);
  } else {
    add();
  }
})();
