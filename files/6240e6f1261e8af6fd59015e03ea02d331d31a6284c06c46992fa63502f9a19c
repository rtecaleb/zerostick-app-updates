html body .sanewadv .sanewrow > .btn svg, html body .sanewadv .sanewrow > .btn img { width: 14px; height: 14px; opacity: .7; }
html body .sanewrow > .qhrow { margin: 0; flex: none; }
/* 2026-10-22 (owner: "in Advanced Script Maker the New script button should
   be front and center"): the main room's New script (.sanewmain) is the
   room's primary, full width, first; the quiet one above is a gun page's */
html body .sanewmain { margin: 2px 0 14px; }
html body .sanewmain .sanewrow { display: flex; align-items: center; gap: 10px; }
html body .sanewmain .sanewrow > .btn { flex: 1; min-height: 52px; font-size: 16px; margin: 0 !important; }
