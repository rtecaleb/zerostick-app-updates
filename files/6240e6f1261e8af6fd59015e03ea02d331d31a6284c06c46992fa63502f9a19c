  border-width: 2px !important; }
html body #sa-recoil.satop1 .satopt b { font-size: 22px; }
html body #sa-recoil.satop1 svg, html body #sa-recoil.satop1 img { width: 38px; height: 38px; }
html body #sa-recoil.satop1 .satopt em { color: inherit; opacity: .85; }
/* the sheen of "Paste ready-made script" is NOT here: this sheet stays
