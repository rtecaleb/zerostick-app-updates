/* Device's Connection line: the keyboard is wide, so its slot is too */
html body .ovconn-box .ovconn-icos img.ico3d-keycap { width: 34px; }
/* the "Showing Mouse & Keyboard" key of Aim and Mappings: the two pictures
   lead it, small */
html body .mkbhead { display: inline-flex; align-items: center; gap: 5px; font-style: normal; flex: none; }
