html body .saquickrow > .btn.saquick b { font-size: 14.5px; font-weight: 750; line-height: 1.15; }
html body .saquickrow > .btn.saquick svg, html body .saquickrow > .btn.saquick img { width: 26px; height: 26px;
  color: var(--zk-accent); }
