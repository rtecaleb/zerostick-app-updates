html body { --rec: #ff8f6b; --rec-wash: rgba(255,143,107,.12); --rec-edge: rgba(255,143,107,.55); }
html body.zs-light { --rec: #a8380f; --rec-wash: rgba(168,56,15,.08); --rec-edge: rgba(168,56,15,.50); }
html body .saroomtop { display: flex; flex-direction: column; gap: 10px; margin: 4px 0 14px; }
