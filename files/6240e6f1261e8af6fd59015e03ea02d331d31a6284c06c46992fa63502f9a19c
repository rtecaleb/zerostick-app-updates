html body #sa-record-seq.sarec img, html body #sa-record-seq.sarec svg { width: 28px; height: 28px; }
html body #sa-record-seq.sarec { min-height: 52px; font-weight: 700; background-color: var(--rec-wash) !important;
  border: 1px solid var(--rec-edge) !important; color: var(--rec) !important; }
html body #sa-record-seq.sarec svg, html body #sa-record-seq.sarec img { color: var(--rec); }
html body #sa-record-seq.sarec { padding: 10px 16px; }
html body #sa-record-seq.sarec .satopt em { color: inherit; opacity: .85; }
/* a gun page's three one-tap ready-mades, under the Lab */
