    if (k) { k.addEventListener('click', function () { setSlot(Number(k.getAttribute('data-slot'))); }); }
  }
  function advHTML() {
    if (inStudio()) { return ''; }
    /* helpHTML is the "?" row then its fold: the "?" sits beside the tag,
       the fold opens under the line */
    var help = ZS.helpHTML ? ZS.helpHTML('st-adv-help', 'EXO Studio', ADV_HELP) : '';
    var cut = help.indexOf('<div class="note qhfold"');
    var chip = cut > 0 ? help.slice(0, cut) : help, fold = cut > 0 ? help.slice(cut) : '';
    return '<div class="st-adv" id="st-adv" role="note" aria-labelledby="st-adv-title">' +
      '<div class="st-adv-top"><span class="st-adv-tag">Advanced · PC</span>' + chip + '</div>' +
      '<div class="st-adv-title" id="st-adv-title">' + esc(ADV_TITLE) + '</div>' +
      '<p class="st-adv-line" id="st-lead">' + esc(LEAD) + '</p>' + fold +
      '<a class="btn primary" id="st-learn" href="' + esc(LEARN_URL) + '" target="_blank" rel="noopener">' +
        'Learn about EXO Studio</a>' +
      '<p class="st-adv-url" id="st-learn-url">zerostickgaming.com/pages/exo-studio</p></div>';
  }
  function wireAdv(root) {
    var a = root && root.querySelector('#st-learn');
    if (a) {
      a.addEventListener('click', function (e) {
        if (e && e.preventDefault) { e.preventDefault(); }
        openLearn();
      });
    }
  }
  function wirePc(pc) {
    var o = pc.querySelector('#st-open');
    if (o) { o.addEventListener('click', openStudio); }
  }

  function render(p) {
    injectCss();
    S.slotErr = ''; S.pcSay = '';
    if (M()) { M().state().err.studio = ''; M().state().confirm = ''; }
    lastBody = ''; lastPc = '';
    fromStatus();
    /* the official wordmark (owner, 2026-10-10): dark-ground and light-ground
       versions, the theme shows one (zs-flat.css) */
    return { html: '<div id="studio-room"><div class="st-mark" aria-hidden="true">' +
      '<img class="st-wm st-wm-d" src="brand/zs-exo-studio-wordmark-dark.png" width="943" height="320" alt="">' +
      '<img class="st-wm st-wm-l" src="brand/zs-exo-studio-wordmark-light.png" width="943" height="320" alt=""></div>' +
      advHTML() +
      '<div id="st-body"></div><div id="st-pcbox"></div></div>', after: function (body) {
      body.setAttribute('data-tint', 'vision');
      ROOT = body.querySelector('#studio-room');
      wireAdv(ROOT);
      paint();
      if (online()) { readAll().then(schedule); }
      readPc();
    } };
  }

  /* the editor menu row's second line: from what /status already said */
  function hint() {
    var st = status(), on = null;
    if (st && typeof st.mode === 'string') { on = st.mode === 'studio'; }
    else if (st && st.studio && typeof st.studio.enabled === 'boolean') { on = st.studio.enabled; }
    if (on !== null) { return on ? 'On · CV scripts from your PC' : 'Off · CV scripts from your PC'; }
    return 'CV scripts from your PC';
  }

  /* the switch changed (here or in Legacy Devices): paint, and read the CV
     results the moment EXO Studio is on (nothing is asked while it is off) */
  if (M()) {
    M().onChange(function () {
      if (!ROOT || $('studio-room') !== ROOT) { return; }
      paint();
      if (enabled() && !S.gcv) { readGcv().then(paint); }
      if (!enabled() && S.gcv) { S.gcv = null; S.gcvErr = ''; paint(); }
    });
  }

  injectCss();
  if (!window.RENDERERS) { window.RENDERERS = {}; }
  window.RENDERERS.studio = render;

  window.ZSSTUDIO = {
    hint: hint,
    readsCv: readsCv,
    cvSlots: cvSlots,
    onPc: onPc,
    /* for the tests */
    state: function () { return S; },
    LEARN_URL: LEARN_URL,
    COPY: { title: ADV_TITLE, lead: LEAD, help: ADV_HELP, old: OLD_FW, getIt: GET_IT }
  };
}());
