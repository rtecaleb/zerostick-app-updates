/* smart-actions/17-editor-sheet.js — THE EDITOR SHEET: authoring one action.
 *
 * Everything for one action on one screen inside a sheet: steps, name, save.
 *
 * Tests: test-smart-actions.js, test-mnk-actions.js, test-smart-list.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('editor-sheet', function (SEC) {
  'use strict';
  /* from the parts before this one */
  var armConfirm = SEC.armConfirm, btn = SEC.btn, btnI = SEC.btnI, card = SEC.card,
      clamp = SEC.clamp, clone = SEC.clone, configNumberTop = SEC.configNumberTop,
      defaultStep = SEC.defaultStep, DPS_MAX = SEC.DPS_MAX, esc = SEC.esc,
      fallbackDist = SEC.fallbackDist, intOf = SEC.intOf, kbRow = SEC.kbRow,
      normStep = SEC.normStep, num = SEC.num, saveAll = SEC.saveAll,
      STEP_MS_CAP = SEC.STEP_MS_CAP, svspan = SEC.svspan, TAP_MS_MIN = SEC.TAP_MS_MIN,
      txtFld = SEC.txtFld, ZS = SEC.ZS, hasErrors = SEC.hasErrors, oneLiner = SEC.oneLiner,
      problems = SEC.problems, stepLine = SEC.stepLine, sicon = SEC.sicon,
      stepTile = SEC.stepTile, stripBoxHTML = SEC.stripBoxHTML, tileBody = SEC.tileBody,
      totalChip = SEC.totalChip, bindTileHTML = SEC.bindTileHTML,
      coloursHTML = SEC.coloursHTML, errorsHTML = SEC.errorsHTML,
      subLineHTML = SEC.subLineHTML, openStepSheet = SEC.openStepSheet,
      openTargetPane = SEC.openTargetPane, sheetPaint = SEC.sheetPaint,
      openRecorderSheet = SEC.openRecorderSheet, bindsLive = SEC.bindsLive,
      rowFor = SEC.rowFor, rowTarget = SEC.rowTarget,
      padSpecialsRowHTML = SEC.padSpecialsRowHTML,
      padTargetPageHTML = SEC.padTargetPageHTML, specialPageHTML = SEC.specialPageHTML,
      stickPageHTML = SEC.stickPageHTML, deckBodyHTML = SEC.deckBodyHTML,
      deckSegHTML = SEC.deckSegHTML, wireDeck = SEC.wireDeck,
      beginSequence = SEC.beginSequence;
  /* from parts after this one, bound once every part has run (never used
     while this part is running) */
  var openHelpersSheet, openRunsSheet, openTagSheet, openTimingSheet, openWhenSheet, draw,
      copyShare, retrigger, smartReturn;
  ZS_SMART_PARTS.after(function () {
    openHelpersSheet = SEC.openHelpersSheet;
    openRunsSheet = SEC.openRunsSheet;
    openTagSheet = SEC.openTagSheet;
    openTimingSheet = SEC.openTimingSheet;
    openWhenSheet = SEC.openWhenSheet;
    draw = SEC.draw;
    copyShare = SEC.copyShare;
    retrigger = SEC.retrigger;
    smartReturn = SEC.smartReturn;
  });

  /* ══════════════════════════════════════════════════════════════════
     THE EDITOR SHEET
     ══════════════════════════════════════════════════════════════════

     Everything for authoring ONE action, on one screen, inside a sheet
     over the button's own screen. Top to bottom:

       1  the TILE as the header — four tappable badges round the input's
          picture, the name under it, the live line under that
       2  one short line, and it is the only prose in the sheet
       3  the SEQUENCE STRIP, with a trailing ＋
       4  the selected step's one control
       5  the nav triple  ‹ ✕ ›
       6  the PALETTE, as swipeable pages with page names and dots
       7  Special actions in the same tile grammar
       8  errors, then Save / Add another / Copy / Delete

     WHY A SHEET, when the comment this replaces said it could not be one.
     That comment was right about the mechanism and wrong about the
     conclusion: phone.html's sheet host is a single element that SWAPS
     content and keeps a STACK of close callbacks, so a sub-chooser does
     not nest — it replaces, and comes back. Every sub-sheet below is
     handed a way back to this one instead of a hard close, which is the
     piece that was missing. The one hard-close route (ZS.pickButton) is
     covered by S.keepEditor.

     THE POLL RULE. draw() repaints the screen BEHIND the sheet and must
     never repaint the sheet body — a full repaint would reset the pager,
     the selection and the caret. S.sheetEditor is what tells it so; the
     only things allowed through while the sheet is open are the surgical
     updates in paintRunning(). */

  /* THE NAME BELONGS TO THE CONTROL THAT CHANGES IT, AND NOWHERE ELSE.
     The sheet header printed the sequence's name and then the tile printed it
     again five rows down — except the tile's copy is a BUTTON, the one that
     opens "Name and notes". Two identical strings, one of them tappable, and
     no way to tell which from looking. The header says which room you are in;
     the tile says, and edits, what this sequence is called. */
  function editorTitle(a) {
    return (a && a.id) ? 'Edit sequence' : 'New sequence';
  }

  /* which step the controls below are about. Always-on from the moment the
     sheet opens (the old strip left it at -1 until you tapped a tile). */
  function selIndex(S, a) {
    var n = a.steps.length;
    if (!n) return -1;
    var i = (S.sel == null) ? n - 1 : S.sel;
    return clamp(intOf(i, n - 1), 0, n - 1);
  }

  /* the ONE control the selected step actually has. A stepper, not a
     slider — a deliberate departure from XIM: wire() already gives .stp
     hold-to-repeat AND tap-to-type, which beats a slider thumb on
     precision, on touch size and on the keyboard. Everything a step can
     be is still one tap away behind "⋯ All settings". */
  /* THE SELECTED STEP'S ONE CONTROL, as ONE ROW — measured, not assumed.
     The first build used the file's own fld()/seg() kit, which stacks a
     label above a full-width control: 304px of sticky block, which pushed
     the palette entirely below the fold on a 375x812 screen (deck top 588
     in a 546px body, 2026-08-18, in a browser). That defeats the whole ask —
     "its all there and accesiable to make on one screen". So this row uses
     its own compact markup: an inline label, the control beside it, wrapping
     only when it must.

     A STEPPER, NOT A SLIDER — a deliberate departure from XIM. svspan()
     already emits `zsstep` and the whole file listens for it, and wire()
     gives .stp hold-to-repeat AND tap-to-type, which beats a slider thumb on
     precision, on touch size and on the keyboard. Nothing is lost: "⋯" on
     the nav row opens the full step sheet — combo targets, the angle dial,
     axis, keep-holding, and the up/down reorder. */
  function ctlSeg(opts, idx, id) {
    return '<div class="seg2" data-nosave="1" id="' + id + '">' +
      opts.map(function (o, i) {
        return '<button type="button"' + (i === (idx || 0) ? ' class="on"' : '') +
          '>' + esc(o) + '</button>';
      }).join('') + '</div>';
  }
  function ctlNum(label, val, d, min, max, suf, field) {
    return '<span class="saednum"><i>' + esc(label) + '</i>' +
      svspan(val, min, max, suf, d, field) + '</span>';
  }

  function stepCtlHTML(a, sel, p) {
    var s = a.steps[sel], h;
    if (!s) {
      /* THE ONE place a sentence is allowed on the authoring surface:
         there is no picture to read yet, and the way out is right below. */
      return '<div class="saedempty">Tap a button below to add the first step.</div>';
    }
    if (s.k === 'tap' || s.k === 'hold') {
      h = ctlSeg(['Tap', 'Hold'], s.k === 'hold' ? 1 : 0, 'sa-ctlmode') +
        (s.k === 'tap' ? ctlNum('for', s.ms, 10, TAP_MS_MIN, STEP_MS_CAP, 'ms', 'cms') : '');
    } else if (s.k === 'trig') {
      h = ctlSeg(['Pull', 'Keep pulled'], s.keep ? 1 : 0, 'sa-ctlkeep') +
        (s.keep ? '' : ctlNum('for', s.ms, 10, TAP_MS_MIN, STEP_MS_CAP, 'ms', 'cms'));
    } else if (s.k === 'wait') {
      h = ctlNum('Wait', s.ms, 10, 0, STEP_MS_CAP, 'ms', 'cms');
    } else if (s.k === 'stick' && num(s.dps, 0) > 0) {
      h = ctlNum('Turn', Math.round(num(s.dps, 0)), 5, 1, DPS_MAX, '°/s', 'cdps');     /* D189 */
    } else if (s.k === 'stick') {
      h = ctlNum('How far', Math.round(num(s.dist, 0) * 100), 5, 1, 100, '%', 'cdist');
    } else if (s.k === 'sens') {
      h = ctlNum('Speed', Math.round(num(s.scale, 1) * 100), 5, 0, 300, '%', 'cscale');
    } else if (s.k === 'swap') {
      h = ctlNum('for', s.ms, 100, 0, STEP_MS_CAP, 'ms', 'cms');
    } else if (s.k === 'move') {
      h = ctlNum('over', s.ms, 1, 0, STEP_MS_CAP, 'ms', 'cms');
    } else if (s.k === 'config') {
      h = ctlSeg(['Next', 'Before', 'Number'],
                 s.to === 'next' ? 0 : s.to === 'prev' ? 1 : 2, 'sa-ctlto') +
        (typeof s.to === 'number' ? ctlNum('#', s.to, 1, 1, configNumberTop(s.to), '', 'cto') : '');
    } else {
      /* a step from a newer board: say what it is, and let "⋯" carry it */
      h = '<span class="saedempty">' + esc(stepLine(s, sel, a.steps, p)) + '</span>';
    }
    return '<div class="saedctl">' + h + '</div>';
  }

  /* ‹ ✕ › ⇠ ⇢ ⋯  — 44x44 each, 8px apart, and every label names the position
     so the step count is not sighted-only. ✕ deletes with the existing undo
     toast; never a confirm dialog for a step you can put straight back.
     ⇠/⇢ move the selected step earlier or later (screen-map §5.3): reorder
     used to live ONLY inside the "⋯" step sheet, one tap further in, which
     is the wrong depth for the edit sequences need most often — "the wait
     goes before the press, not after". The step sheet keeps its own ↑/↓, so
     nothing moved out of reach; this pair is the shortcut on the surface
     where the strip is visible. "⋯" stays last: everything a step can be,
     one tap away. */
  function navHTML(a, sel) {
    var n = a.steps.length;
    var pos = n ? ' (step ' + (sel + 1) + ' of ' + n + ')' : '';
    function b(id, cls, glyph, say, off) {
      return '<button type="button" id="' + id + '"' + (cls ? ' class="' + cls + '"' : '') +
        (off ? ' aria-disabled="true"' : '') + ' aria-label="' + esc(say) + '">' + glyph + '</button>';
    }
    return '<div class="saednav">' +
      b('sa-prev', '', '‹', 'previous step' + pos, !(sel > 0)) +
      b('sa-delstep', 'rm', sicon('remove', 'x'), 'delete this step' + pos, !(n && a.steps[sel])) +
      b('sa-next', '', '›', 'next step' + pos, !(n && sel < n - 1)) +
      b('sa-mvearl', 'mv', sicon('left', '<'), 'move this step earlier' + pos, !(n && a.steps[sel] && sel > 0)) +
      b('sa-mvlate', 'mv', sicon('right', '>'), 'move this step later' + pos, !(n && a.steps[sel] && sel < n - 1)) +
      (n && a.steps[sel]
        ? b('sa-stepmore', 'more', sicon('more', '…'), 'all settings for this step' + pos, false)
        : '') +
      (n ? '<span class="saedpos" aria-hidden="true">' + (sel + 1) + '/' + n + '</span>' : '') +
      '</div>';
  }

  /* What the preset chips USED to carry, honestly labelled. They were never
     presets: one chip per sequence already saved on this input, wearing the
     same .safil class as the Ready-made family filter. Most buttons have one
     sequence, so most of the time this renders nothing — the same unset rule
     the tile badges follow. */
  function seqSwitchHTML(S, row) {
    if (!row || !row.acts || row.acts.length < 2) return '';
    var pos = 0, i;
    for (i = 0; i < row.acts.length; i++) if (row.acts[i].i === S.editIdx) pos = i;
    var nm = (row.acts[pos].a.name || 'Untitled');
    return '<div class="saedseqs">' +
      '<button type="button" id="sa-seqprev"' + (pos <= 0 ? ' aria-disabled="true"' : '') +
      ' aria-label="the sequence before this one on this button">‹</button>' +
      '<button type="button" id="sa-seqlist" aria-label="' +
      esc('sequence ' + (pos + 1) + ' of ' + row.acts.length + ' on this button: ' + nm +
          ' — see them all') + '">' + (pos + 1) + ' of ' + row.acts.length + ' · ' + esc(nm) +
      '</button>' +
      '<button type="button" id="sa-seqnext"' + (pos >= row.acts.length - 1 ? ' aria-disabled="true"' : '') +
      ' aria-label="the next sequence on this button">›</button></div>';
  }

  function editorBodyHTML(p, S, row) {
    var a = S.draft;
    var sel = selIndex(S, a);
    var run = S.running[a.id];
    var running = (run && run.step_index != null && !SEC.overlapsIn(a.steps)) ? run.step_index : -1;
    /* A step's target is an OUTPUT — what the CONSOLE receives — and the
       console receives a pad. TARGET_SECTIONS has no keys and parse_target
       throws one away, so a keyboard page HERE would be a lie. The owner's
       "you just swipe if you want keyboard buttons" is honoured where it is
       true: the TRIGGER picker has the QWERTY page, and it is reached by
       tapping the tile's centre art. */
    /* the Pad page carries the specials row (§5.2) ONLY here, in the editor:
       simple mode's gridHTML answers "what should this button send", where a
       Wait tile would be a control that does nothing — the class of bug this
       file exists to end */
    var pages = [
      { n: 'Pad', h: padTargetPageHTML(p) + padSpecialsRowHTML(a) },
      { n: 'Sticks', h: stickPageHTML(p) },
      { n: 'Special', h: specialPageHTML(a, p, S) }
    ];
    /* ONE clamp, derived from the pages that actually exist. wireEditor used
       to carry a second, hardcoded 0..2 of its own, so a fourth page would
       have restored to the wrong one — it now passes S.page straight through
       and lets wireDeck clamp against the real count. */
    var pg = clamp(intOf(S.page, 0), 0, pages.length - 1);
    return '<div class="saed" id="sa-edit">' +
      '<div class="saedhead">' +
      bindTileHTML(a, p, S, { size: 'head', interactive: true, row: row }) +
      '<div class="saedrail"><button type="button" id="sa-help" ' +
      'aria-label="helpers that build the steps for you">' + sicon('helpers', '?') + '</button></div></div>' +
      seqSwitchHTML(S, row) +
      '<div class="saedsay">Choose what this button should do.</div>' +
      /* the palette's PAGE NAMES join the sticky block, directly above the
         deck they name. Scrolled to the top they read as the palette's own
         header; scrolled down they are still there, which is the point. */
      '<div class="saedstick">' +
      stripBoxHTML(a, p, S, running, sel, rowTarget(row || {})) +
      stepCtlHTML(a, sel, p) +
      navHTML(a, sel) +
      deckSegHTML('sa-deck', pages, pg) + '</div>' +
      deckBodyHTML('sa-deck', pages, pg) +
      '<div class="saedfoot">' + errorsHTML(a, p, S, true) +
      btnI('ok', 'Save', 'primary', 'sa-save') +
      (row && row.acts && row.acts.length ? btnI('plus', 'Add another sequence', null, 'sa-another') : '') +
      btnI('copy', 'Copy', null, 'sa-copy') +
      btnI('delete', 'Delete this sequence', 'danger', 'sa-del') +
      '</div></div>';
  }

  /* the sheet host is open exactly when #sheetwrap carries `open` — the same
     rule phone.html uses to decide whether to reset its callback stack, so
     reading it here can never disagree with it */
  function sheetIsOpen() {
    var w = document.getElementById('sheetwrap');
    return !!(w && w.classList && w.classList.contains('open'));
  }

  function editorCloser(root, p, S) {
    return function () {
      /* a nested picker that hard-closes the host (ZS.pickButton) is not a
         dismissal — the caller is about to paint this sheet again */
      if (S.keepEditor) { S.keepEditor = false; return; }
      S.sheetEditor = false;
      if (S.unsaved) ZS.toast('That sequence had changes that were never saved');
      S.draft = null; S.editIdx = -1; S.mode = 'simple';
      S.unsaved = false; S.sel = null; S.step = null;
      draw(root, p);
    };
  }

  function openEditorSheet(root, p, S, row) {
    if (!S.draft) return null;
    /* the owner, 2026-10-20: a Script made in the Anti-Recoil Lab opens back
       in the Lab, on its model - not the editor's technical options */
    var d0 = S.draft;
    if (d0 && d0.fromTemplate === 'recoil-workshop' && d0.recoil && typeof d0.recoil === 'object' &&
        S.editIdx != null && S.editIdx >= 0 && SEC.openWorkshop && window.ZS_RECOIL) {
      var idx0 = S.editIdx;
      S.draft = null; S.editIdx = -1; S.mode = 'simple'; S.unsaved = false; S.sel = null; S.step = null;
      SEC.openWorkshop(root, p, S, idx0, true);
      return null;
    }
    S.mode = 'sequence';
    S.sheetEditor = true;
    var body = sheetPaint(editorTitle(S.draft), editorBodyHTML(p, S, row),
                          sheetIsOpen() ? undefined : editorCloser(root, p, S));
    wireEditor(body, root, p, S, row);
    /* the trip is over: any later close IS a dismissal */
    S.keepEditor = false;
    return body;
  }

  /* every sub-chooser comes back HERE rather than closing, so the draft
     survives a trip through a picker */
  function backToEditor(root, p, S) {
    /* the in-place editor (D79) has no sheet to come back to: close whatever
       is open and repaint the screen from the (written) draft */
    if (S.mode === 'smart') { smartReturn(root, p, S); return; }
    var row = rowFor(p, S, S.inputSrc) ||
      (S.pendingRow && S.pendingRow.source === S.inputSrc ? S.pendingRow : null);
    if (!S.draft) { S.sheetEditor = false; ZS.sheetClose(); draw(root, p); return; }
    openEditorSheet(root, p, S, row);
  }
  /* the tail every pill sheet used to end with. With the editor open it
     returns to the editor; on any other screen it behaves exactly as before. */
  function sheetDone(root, p, S) {
    return function () {
      if (S.sheetEditor) { backToEditor(root, p, S); return; }
      if (S.mode === 'smart') { smartReturn(root, p, S); return; }
      ZS.sheetClose();
      draw(root, p);
    };
  }

  function openNameSheet(root, p, S) {
    var a = S.draft, inp = null, nt = null;
    function commit() {
      if (inp) a.name = inp.value;
      if (nt) a.notes = nt.value;
      a.edited = true; S.unsaved = true;
    }
    var h = card(txtFld('Name', a.name, 'sa-name', 'e.g. Burst fire', 'so you can find it later') +
      txtFld('Notes', a.notes, 'sa-notes', 'anything you want to remember') +
      coloursHTML(a)) + btnI('ok', 'Done', 'primary', 'sa-nameok');
    var body = sheetPaint('Name and notes', h);
    inp = body.querySelector('.sa-name');
    nt = body.querySelector('.sa-notes');
    body.querySelectorAll('[data-col]').forEach(function (b) {
      b.addEventListener('click', function () {
        a.colour = b.dataset.col; a.edited = true; S.unsaved = true;
        body.querySelectorAll('[data-col]').forEach(function (x) { x.classList.toggle('on', x === b); });
      });
    });
    var ok = body.querySelector('#sa-nameok');
    if (ok) ok.addEventListener('click', function () { commit(); sheetDone(root, p, S)(); });
  }

  /* the list behind "2 of 4" — every sequence on this button, so a button
     with several is not a walk through arrows */
  function openSeqListSheet(root, p, S, row) {
    var h = '<div class="grp-card">' + row.acts.map(function (pair) {
      var on = pair.i === S.editIdx;
      return '<div class="hmrow' + (on ? ' on' : '') + '" data-goseq="' + pair.i +
        '" role="button" tabindex="0"><span class="hmdot"></span><span class="hmt">' +
        esc(pair.a.name || 'Untitled sequence') + SEC.descQH(pair.a, p) +
        '</span></div>';
    }).join('') + '</div>' + btn('Back', null, 'sa-seqx');
    var body = sheetPaint('Sequences on this button', h);
    var out = body.querySelector('#sa-seqx');
    if (out) out.addEventListener('click', function () { backToEditor(root, p, S); });
    body.querySelectorAll('[data-goseq]').forEach(function (el) {
      function go() {
        var i = +el.dataset.goseq;
        if (i === S.editIdx) { backToEditor(root, p, S); return; }
        if (S.unsaved) ZS.toast('The sequence you were editing had changes that were never saved');
        S.editIdx = i; S.draft = clone(S.actions[i]); S.unsaved = false; S.sel = null;
        backToEditor(root, p, S);
      }
      el.addEventListener('click', go); kbRow(el, go);
    });
  }

  function wireEditor(body, root, p, S, row) {
    var a = S.draft;
    var wrap = body.querySelector('#sa-edit') || body;
    function touch() { a.edited = true; S.unsaved = true; }
    function repaint() { openEditorSheet(root, p, S, row); }
    function selectStep(i) {
      S.sel = clamp(i, 0, Math.max(0, a.steps.length - 1));
      repaint();
    }
    function sel() { return selIndex(S, a); }

    /* the palette pages remember where you were, so a repaint does not
       throw you back to page 1 mid-build. NO SECOND CLAMP HERE: this one
       used to read `0, 2` while editorBodyHTML derived its bound from
       pages.length - 1, so a fourth page would have restored to page 3 in
       the markup and page 2 in the wiring. wireDeck already clamps against
       the pages it can actually see, which is the only count that is true. */
    wireDeck(body, 'sa-deck', intOf(S.page, 0), function (i) { S.page = i; });

    /* the pinned block's REAL height, handed to scroll-margin-top so a
       keyboard-focused palette key can never be scrolled underneath it
       (WCAG 2.4.11). Measured, not assumed — the block grows a row every
       time the sequence strip wraps. One layout read per repaint, and it is
       skipped entirely where offsetHeight is not real (the node harness). */
    var stickEl = body.querySelector('.saedstick');
    if (stickEl && wrap.style && wrap.style.setProperty) {
      var stickH = stickEl.offsetHeight;
      if (stickH > 0) wrap.style.setProperty('--sa-stick', (stickH + 8) + 'px');
    }

    /* ── one delegated listener for the whole sheet ──
       Everything below is re-rendered on nearly every interaction, so
       per-element listeners would have to be re-attached every time and a
       surgical repaint would silently drop them. */
    function addStep(st, at) {
      var norm = normStep(st);
      if (!norm) return;
      if (at == null || at > a.steps.length) at = a.steps.length;
      a.steps.splice(at, 0, norm);
      touch();
      S.sel = at;
      repaint();
      ZS.toast('Added: ' + stepLine(norm, at, a.steps, p));
    }
    function addTarget(code) {
      addStep((code === 'lt+' || code === 'rt+')
        ? { k: 'trig', t: [code], ms: 120, keep: false }
        : { k: 'tap', t: [code], ms: 80 });
    }

    wrap.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var el, i;

      el = t.closest('[data-slot]');
      if (el) {
        var slot = el.dataset.slot;
        if (slot === 'top') openWhenSheet(root, p, S);
        else if (slot === 'left') openRunsSheet(root, p, S);
        else if (slot === 'right') openTagSheet(root, p, S);
        else if (slot === 'bottom') openTimingSheet(root, p, S);
        else if (slot === 'name') openNameSheet(root, p, S);
        else if (slot === 'trigger') retrigger(root, p, S);
        return;
      }
      el = t.closest('[data-tile]');
      if (el) { selectStep(+el.dataset.tile); return; }
      el = t.closest('[data-gt]');
      if (el) { addTarget(el.dataset.gt); return; }
      el = t.closest('[data-cat]');
      if (el) {
        var k = el.dataset.cat;
        S.step = { i: a.steps.length, kind: k, draft: defaultStep(k, rowTarget(row)) };
        openStepSheet(p, S, true, root);
        return;
      }
      if (t.closest('#sa-gmore')) {
        openTargetPane(p, addTarget, function () { backToEditor(root, p, S); });
        return;
      }
      if (t.closest('#sa-addstep')) {
        /* the ＋ is the relationship made visible: it points at the palette,
           so it takes you there rather than guessing a step for you */
        var pgs = body.querySelectorAll('.sabpage'), first = null, pi;
        for (pi = 0; pi < pgs.length && !first; pi++) {
          if (pgs[pi].getAttribute('aria-hidden') === 'true') continue;
          first = pgs[pi].querySelector('.sabkey');
        }
        if (first && first.focus) { try { first.focus(); } catch (err) {} }
        if (first && first.scrollIntoView) { try { first.scrollIntoView({ block: 'center' }); } catch (err) {} }
        return;
      }
      if (t.closest('#sa-record')) {
        S.keepEditor = true;
        openRecorderSheet(root, p, S, { canAppend: a.steps.length > 0, apply: function (steps, mode) {
          var norm = steps.map(normStep).filter(function (s) { return !!s; });
          a.steps = mode === 'append' ? a.steps.concat(norm) : norm;
          touch(); S.sel = null;
          backToEditor(root, p, S);
          ZS.toast(mode === 'append' ? 'Steps added to the end' : 'The steps are now what you just did');
        } });
        return;
      }
      if (t.closest('#sa-help')) { openHelpersSheet(root, p, S); return; }
      if (t.closest('#sa-prev')) { if (sel() > 0) selectStep(sel() - 1); return; }
      if (t.closest('#sa-next')) { if (sel() < a.steps.length - 1) selectStep(sel() + 1); return; }
      el = t.closest('#sa-mvearl') || t.closest('#sa-mvlate');
      if (el) {
        /* the same swap the step sheet's ↑/↓ perform (its closure-private
           move() — which also has to commit that sheet's open draft, a
           concern that does not exist out here, so the swap is restated
           rather than reached for). The selection RIDES with the step:
           moving it and losing it would make the second tap move the
           neighbour. */
        i = sel();
        var jj = i + (el.id === 'sa-mvlate' ? 1 : -1);
        if (i < 0 || !a.steps[i] || jj < 0 || jj >= a.steps.length) return;
        var tmpStep = a.steps[jj]; a.steps[jj] = a.steps[i]; a.steps[i] = tmpStep;
        touch();
        S.sel = jj;
        repaint();
        return;
      }
      if (t.closest('#sa-delstep')) {
        i = sel();
        if (i < 0 || !a.steps[i]) return;
        var removed = a.steps.splice(i, 1)[0];
        touch();
        S.sel = Math.max(0, i - 1);
        repaint();
        ZS.toast('Step removed', { action: 'Undo', onAction: function () {
          /* only into the draft it came out of (audit m23): after a Save,
             `a` was the saved list entry, edited behind the save path */
          var d = S.draft;
          if (!d || d.id !== a.id) return;
          d.steps.splice(Math.min(i, d.steps.length), 0, removed);
          d.edited = true; S.unsaved = true;
          S.sel = i;
          if (S.sheetEditor) backToEditor(root, p, S);
        } });
        return;
      }
      if (t.closest('#sa-stepmore')) {
        i = sel();
        if (i < 0 || !a.steps[i]) return;
        S.step = { i: i, kind: a.steps[i].k, draft: clone(a.steps[i]) };
        openStepSheet(p, S, true, root);
        return;
      }
      if (t.closest('#sa-seqlist')) { openSeqListSheet(root, p, S, row); return; }
      el = t.closest('#sa-seqprev') || t.closest('#sa-seqnext');
      if (el) {
        var d = el.id === 'sa-seqnext' ? 1 : -1, pos = 0, j;
        for (j = 0; j < row.acts.length; j++) if (row.acts[j].i === S.editIdx) pos = j;
        var nxt = row.acts[pos + d];
        if (!nxt) return;
        if (S.unsaved) ZS.toast('The sequence you were editing had changes that were never saved');
        S.editIdx = nxt.i; S.draft = clone(S.actions[nxt.i]); S.unsaved = false; S.sel = null;
        backToEditor(root, p, S);
        return;
      }
      if (t.closest('#sa-another')) {
        if (S.unsaved) ZS.toast('The sequence you were editing had changes that were never saved');
        beginSequence(p, S, row);
        S.sel = null;
        backToEditor(root, p, S);
        return;
      }
      if (t.closest('#sa-copy')) {
        copyShare(a, 'Copied — send it to a friend and they can paste it onto any button.', p);
        return;
      }
    });

    /* ── the selected step's own control ── */
    wrap.addEventListener('zsstep', function (e) {
      var sv = e.target, f = sv && sv.dataset && sv.dataset.f;
      if (!f) return;
      var v = Math.round(num(sv.textContent, 0));
      var s = a.steps[sel()];
      if (f === 'cms' && s) s.ms = v;
      else if (f === 'cdist' && s) s.dist = clamp(v / 100, 0.01, 1);
      else if (f === 'cdps' && s) {
        s.dps = clamp(v, 1, DPS_MAX);          /* D189 */
        var fbs = fallbackDist(p, s);
        if (fbs != null) s.dist = fbs;
      }
      else if (f === 'cscale' && s) s.scale = clamp(v / 100, 0, 3);
      else if (f === 'cto' && s) s.to = clamp(v, 1, configNumberTop(s.to));
      else return;
      touch();
      liveEditor(body, p, S, row);
    });

    function segButtons(id, fn) {
      var g = body.querySelector('#' + id);
      if (!g) return;
      var bs = g.querySelectorAll('button');
      for (var i = 0; i < bs.length; i++) {
        (function (idx) { bs[idx].addEventListener('click', function () { fn(idx); }); })(i);
      }
    }
    segButtons('sa-ctlmode', function (i) {
      var s = a.steps[sel()];
      if (!s) return;
      if (i === 1 && s.k === 'tap') a.steps[sel()] = normStep({ k: 'hold', t: s.t.slice() });
      else if (i === 0 && s.k === 'hold') a.steps[sel()] = normStep({ k: 'tap', t: s.t.slice(), ms: 80 });
      touch(); repaint();
    });
    segButtons('sa-ctlkeep', function (i) {
      var s = a.steps[sel()];
      if (!s || s.k !== 'trig') return;
      s.keep = i === 1;
      touch(); repaint();
    });
    segButtons('sa-ctlto', function (i) {
      var s = a.steps[sel()];
      if (!s || s.k !== 'config') return;
      s.to = i === 0 ? 'next' : i === 1 ? 'prev' : 2;
      touch(); repaint();
    });

    /* ← / → on the strip do what the nav triple does, so the sequence is
       navigable without a pointer */
    var strip = body.querySelector('#sa-strip');
    if (strip) strip.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft' && sel() > 0) { e.preventDefault(); selectStep(sel() - 1); }
      else if (e.key === 'ArrowRight' && sel() < a.steps.length - 1) { e.preventDefault(); selectStep(sel() + 1); }
    });

    var save = body.querySelector('#sa-save');
    if (save) {
      save.disabled = hasErrors(a, p, S);
      save.addEventListener('click', function () {
        if (save.disabled) return;
        save.disabled = true;              /* one tap, one save */
        var ps = problems(a, p, S), i;
        for (i = 0; i < ps.length; i++) {
          if (ps[i].level === 'error') {
            ZS.toast(ps[i].msg, { ms: 5000 });
            liveEditor(body, p, S, row);
            return;
          }
        }
        a.edited = true;
        /* a COPY into the list (audit m23): the sheet's closures keep `a` */
        if (S.editIdx >= 0) S.actions[S.editIdx] = clone(a);
        else { S.actions.push(clone(a)); S.editIdx = S.actions.length - 1; }
        saveAll(p, S);
        S.unsaved = false;
        S.draft = clone(S.actions[S.editIdx]);
        backToEditor(root, p, S);
        ZS.toast(bindsLive(p) ? 'Saved to your board'
                              : 'Saved on this phone — it goes to your board the moment it is back');
      });
    }

    var del = body.querySelector('#sa-del');
    if (del) armConfirm(del, function () {
      if (S.editIdx < 0) {
        S.draft = null; S.sheetEditor = false; S.mode = 'simple'; S.unsaved = false;
        S.keepEditor = false;
        ZS.sheetClose();
        draw(root, p);
        return;
      }
      var i = S.editIdx, removed = S.actions.splice(i, 1)[0];
      saveAll(p, S);
      S.draft = null; S.editIdx = -1; S.mode = 'simple'; S.unsaved = false;
      S.sheetEditor = false; S.keepEditor = false;
      ZS.sheetClose();
      draw(root, p);
      ZS.toast('"' + ((removed && removed.name) || 'sequence') + '" deleted', {
        action: 'Undo', onAction: function () {
          S.actions.splice(i, 0, removed); saveAll(p, S); draw(root, p);
        }
      });
    });
  }

  /* replace one element with the HTML that redraws it. Not `el.outerHTML =
     html`: that setter is a browser convenience the headless harness's DOM
     does not carry (its outerHTML is a getter), and a surgical repaint that
     throws there takes the write after it down with it — the + key stepped
     the number and never saved. Insert-then-remove works on both. */
  function swapOuter(el, html) {
    if (!el || !el.parentNode) return;
    el.insertAdjacentHTML('beforebegin', html);
    el.parentNode.removeChild(el);
  }

  /* the surgical half: what a stepper tick or a live poll is allowed to
     touch while the sheet is open. Never the whole body. */
  function liveEditor(body, p, S, row) {
    if (!body || !S.draft) return;
    var a = S.draft;
    var i = selIndex(S, a);
    var tile = body.querySelector('.satile[data-tile="' + i + '"]');
    if (tile && a.steps[i]) {
      var t = stepTile(a.steps[i], p);
      tile.innerHTML = tileBody(t);
    }
    var tot = body.querySelector('#sa-strip .satot');
    if (tot) swapOuter(tot, totalChip(a));
    var er = body.querySelector('#sa-errors');
    if (er) swapOuter(er, errorsHTML(a, p, S, true));
    var sv = body.querySelector('#sa-save');
    if (sv) sv.disabled = hasErrors(a, p, S);
    var sub = body.querySelector('#sa-sub');
    if (sub) sub.innerHTML = subLineHTML(a, p, S, row);
  }

  /* what the other parts use from this one */
  SEC.backToEditor = backToEditor;
  SEC.ctlSeg = ctlSeg;
  SEC.openEditorSheet = openEditorSheet;
  SEC.openNameSheet = openNameSheet;
  SEC.openSeqListSheet = openSeqListSheet;
  SEC.selIndex = selIndex;
  SEC.seqSwitchHTML = seqSwitchHTML;
  SEC.sheetDone = sheetDone;
  SEC.sheetIsOpen = sheetIsOpen;
  SEC.swapOuter = swapOuter;
});
