/* shell/09-home.js — HOME.
 *
 * renderHome and everything on it: who is plugged in (the device pills, the
 * mouse's Check rate D188), what you are pressing right now, the gun that
 * is out and the Active Weapon card (D192, the AI Scripts it turns on),
 * Passthrough Mode on HOME, the calibration-running line (D202-D204), and
 * HOME's one entrance (homeEnter).
 *
 * PART OF THE APP SHELL: phone.html's one inline script until 2026-10-02,
 * now these consecutive files, loaded where it was. They are CLASSIC
 * scripts, as it was: every top-level function and var is a global the
 * other files (and devbar.js, sections/, smart-actions/) call by name, and
 * nothing here may use, while loading, a name a LATER shell file declares
 * (calls made after the page has loaded are fine). phone.html lists them.
 */
  /* ── HOME ──────────────────────────────────────────────────────── */
  /* the engine names its output driver "uinput"/"null" — say what that MEANS.
     "null" is not an error: the engine is running, nothing is plugged in to
     receive the inputs yet. Never show a user the word "null". */
  function backendText(b){
    var n = (b && b.name) || '';
    if(n==='null') return 'waiting for a console';
    if(!n) return 'checking output…';
    if(b && b.healthy===false) return esc(n)+' output — not healthy';
    return 'sending inputs';
  }
  window.ZS_backendText = backendText;
  /* The identity line under a config's name: the family mark, then the console
     and input NAMED IN TEXT. The mark is decorative here precisely because the
     words beside it already say it — a screen reader gets the sentence once,
     not a badge and then the same word again. Replaces the old pair of outline
     badges, whose colour was the only thing distinguishing them. */
  /* `short` swaps the console's full name for the badge word ("PlayStation 5"
     → "PS5"). The hero has 300px for this line and can afford the long name;
     a row in a sixteen-config list has 150px for a string that wants 188, so
     six of sixteen rows clipped mid-word at "… Mouse + Keyb…" — and that
     line is the only thing telling several similarly-named configs apart, so
     it was the worst possible thing to cut. The accessible label on the row
     is built separately and still says PlayStation 5 in full. */
  function idLine(p, short){
    var mk = window.ZSMARK
      ? '<span class="mk">'+ZSMARK.badge(markKey(p), {size:20, decorative:true})+'</span>' : '';
    var con = short ? ((PB[p.platform]&&PB[p.platform].t) || CON[p.platform] || p.platform)
                    : (CON[p.platform] || p.platform);
    /* .gm marks a game-bearing line: the one-line ellipsis contract must win
       even on the hero, whose gameless idline is allowed to wrap (see the
       .hero .idline .mt.gm rule in the style block above) */
    return '<span class="idline">'+mk+'<span class="mt'+(p.game?' gm':'')+'">'+
           esc(con)+' · '+esc(INP[p.input]||p.input)+
           /* the locked game rides the identity line; the .mt ellipsis rule
              (style block above) keeps a long name from wrapping the row */
           (p.game ? ' · '+esc(p.game) : '')+
           '</span></span>';
  }
  function kb(el){ el.setAttribute('tabindex','0');
    if(!el.hasAttribute('role')) el.setAttribute('role','button');
    el.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); el.click(); } }); }

  /* keep covered layers out of the tab order */
  var lastNavKey=null;   /* editor/detail open state at the last syncInert */
  function syncInert(){
    var ed=document.getElementById('editor'), dt=document.getElementById('detail');
    var edOpen=ed.classList.contains('open'), dtOpen=dt.classList.contains('open');
    /* REAL NAVIGATION DISMISSES THE TOAST. Keyed on the panel state, not on
       this call: sheetOpen/sheetClose run syncInert too, and a toast raised
       just before a sheet closes ("Up and down now matches…") must survive
       that. The first call (boot) only records the state. */
    var navKey=(edOpen?1:0)+'/'+(dtOpen?1:0);
    if(lastNavKey!==null && navKey!==lastNavKey) hideToast();
    lastNavKey=navKey;
    /* The depth cue: while any panel covers it, HOME recedes and dims (the
       .zs-covered CSS), then settles back as the panel slides away. Toggled
       here because this function already runs on every open AND every close
       — tap, swipe and spring all converge on the same back buttons — and
       never on the poll, which is the whole animation constraint in one
       line: this class can only ever change on real navigation. */
    var scr=document.querySelector('.screen');
    /* .zs-covered is the depth SETTLE, and it may only ever change on real
       navigation — a sheet is an overlay on the same screen, not a new one,
       so it deliberately does not toggle it. Only the inert half below
       follows the sheet. */
    if(scr) scr.classList.toggle('zs-covered', edOpen||dtOpen);
    /* THE TOAST'S BAND FOLLOWS THE SCREEN. HOME's foot is what is under a
       toast on HOME; the device bar is what is under one anywhere else, and
       it has its own 14px. Cleared rather than recomputed, so the value can
       never outlive the surface it was measured from. */
    if(scr){
      if(edOpen||dtOpen) scr.style.removeProperty('--toast-lift');
      else syncFootLift();
    }
    /* A SHEET IS MODAL. aria-modal alone does not stop a finger or a Tab
       reaching HOME and the app bar behind the scrim, so the layers a sheet
       covers go inert with it (WCAG 2.4.3 / 2.4.11: what is behind a modal is
       neither operable nor in the tab order). The trap in sheetOpen's keydown
       handler is the belt to this brace. */
    var sw=document.getElementById('sheetwrap');
    var shOpen = !!(sw && sw.classList.contains('open'));
    try{
      ed.inert = !edOpen || dtOpen;
      dt.inert = !dtOpen;
      document.getElementById('home').inert = edOpen || dtOpen || shOpen;
      document.querySelector('.appbar').inert = edOpen || dtOpen || shOpen;
    }catch(e){}
  }

  /* D348: HOME's Tournament chip. Its rule is injected once, from here, the
     way core-wifi.js carries its own; ink and edge are theme tokens so the
     light theme needs nothing of its own. */
  function tournChipHTML(){
    if(!document.getElementById('zs-tourn-css')){
      var s = document.createElement('style');
      s.id = 'zs-tourn-css';
      s.textContent =
        '.hs-tourn{display:flex;justify-content:center;margin-top:6px}'+
        '.tourn-chip{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;'+
        'border:1.5px solid var(--amber);border-radius:999px;background:var(--panel);'+
        'color:var(--text);font-size:12px;font-weight:700;letter-spacing:.02em}'+
        '.tourn-chip svg{width:13px;height:13px;flex:none;color:var(--amber)}';
      document.head.appendChild(s);
    }
    return '<div class="hs-sub hs-tourn"><span class="tourn-chip" id="hstourn" role="status" '+
      'aria-label="Tournament Mode is on: scripts, Smart Actions and AI are off">'+
      '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 1h8v2h2.5v1.5'+
      'A3.5 3.5 0 0 1 11.6 8 4 4 0 0 1 9 10v2h2v2H5v-2h2v-2a4 4 0 0 1-2.6-2A3.5 3.5 0 0 1 1.5 4.5V3H4z'+
      'M3 4.5A2 2 0 0 0 4.2 6.3 6 6 0 0 1 4 4.5zm10 0h-1a6 6 0 0 1-.2 1.8A2 2 0 0 0 13 4.5z"/></svg>'+
      'Tournament</span></div>';
  }

  function renderHome(){
    /* The stripe promises "this is the colour your pad glows", so it has to
       re-read lighting.color every draw — the Lighting screen's colour wheel
       changes that field too, and a promise that only held when you used the
       swatches would be worse than not making it. */
    PROFILES.forEach(function(p,i){
      if(LIVE.full[p.id]) p.color = profileColor(LIVE.full[p.id], i);
    });
    var a = prof(activeId);
    /* D435: HOME's ambient light wears the live config's colour */
    if(typeof zsAmbient === 'function') zsAmbient(a.color);
    var h = '';
    /* THE LIVE LINE LEFT THE HERO (owner, 2026-08-17: "board connected and
       sending inputs up 103 mins — that is a debug fact, maybe make it pop
       up if someone clicks board on the top right"). Online, the hero says
       what is PLAYING and nothing about the link; the link facts moved
       behind the ● board chip, which is now a real <button> opening
       openBoardSheet(). OFFLINE is different in kind and stays loud on the
       hero: amber guidance telling a user what to DO — check the power,
       check the Wi-Fi — is help, not telemetry. */
    /* ONE OFFLINE STATE (D192, the owner). HOME used to say it four times at
       once: the chip's "Offline", a "Can't reach your ZeroStick / check the
       Wi-Fi" paragraph, the weapon card's "can't read it" and the presses
       row's "Reconnect to see your presses". Now the chip IS the state
       ("EXO Core Offline") and ONE sentence sits under it: the fact that
       stops a player re-doing work they think was lost, then the one check
       that fits how THIS app reaches the hardware (linkVia), and no other. */
    var offline = (LIVE.online===false);
    var via = linkVia();
    var offMsg = 'Settings will sync automatically when your device reconnects.'+
      (via==='usb' && window.ZSHOST && ZSHOST.studio
         ? ' It is reached over EXO Studio’s USB connection: check its USB cable.'
       : via==='usb' ? ' Check its USB cable.'
       : via==='bluetooth' ? ' Check Bluetooth is on.'
       : ' Check it’s on the same Wi‑Fi as this device.');
    /* THE ONLY LIVE AFFORDANCE ON HOME. aria-haspopup says a dialog is behind
       it; aria-expanded says whether that dialog is open RIGHT NOW, and
       without it a screen-reader user pressing it twice is told nothing
       either time. It is written false here and flipped by sheetOpen /
       sheetClose, which are the only two places the sheet's state changes. */
    /* THE LINK LINE. The board chip used to be an eyebrow control on a row of
       its own ("ACTIVE CONFIG ........ * board"); it is a centred line under
       the device pills now, which is where the reference puts it and where
       the eye already is on the way down. Same <button>, same sheet, same
       aria contract - openBoardSheet() and the aria-expanded flip below are
       untouched, so the only thing that moved is the pixel. */
    /* D194: the line became the DEVICE CARD (the owner's mockup) - the EXO's
       picture, its name and state, its firmware, its mode and its link -
       and it is still this one <button>, so the sheet, the aria contract and
       the poll's re-pointing below are all unchanged. */
    /* THE NAME OVER THE PICTURE, CENTRED (the reference's shape, and the
       right one: the config's name is a title for the picture under it, not
       a row in a list). Under it, ONLY WHAT NOTHING ELSE SAYS (D192): the
       console is the badge on the picture and the input is the chip under
       it, so "PC \u00b7 Mouse + Keyboard \u00b7 <game>" said two of its three facts
       a second time. The game is the one left, and it goes too when the
       config's own name already says it. */
    var pb = PB[a.platform] || null;
    h += '<div class="hs-name">'+esc(a.name)+'</div>';
    var gameLine = a.game && String(a.name||'').toLowerCase().indexOf(String(a.game).toLowerCase()) < 0
      ? a.game : '';
    if(gameLine) h += '<div class="hs-sub">'+esc(gameLine)+'</div>';
    /* D300 amended: a config for an unfinished game says "Coming soon" here
       too. It keeps playing (nothing is sent to the device); without
       developer mode only its Settings refuse to open (openEditor). */
    var soonB = (window.ZS && ZS.configSoonBadge) ? ZS.configSoonBadge(a) : '';
    if(soonB) h += '<div class="hs-sub hs-soon">'+soonB+'</div>';
    /* D348: TOURNAMENT MODE is on (the Core's /status "tournament"): one
       small chip under the name, in words, so nobody wonders why a macro
       did nothing. Global Settings is where it is switched. */
    if(!offline && LIVE.status && LIVE.status.tournament === true) h += tournChipHTML();
    /* D124: a config listed without a readable copy says so where it is
       shown, and Settings is where the sentence and the way on are */
    if(a.unreadable) h += '<div class="hs-sub hs-warn">'+
      'Its settings cannot be opened here. Tap Settings to see why.</div>';

    /* THE PICTURE IS THE CENTRE BLOCK, with the door to its settings riding
       its foot, so it costs the photo no height. (The console badge that sat
       beside it left in D196: the device card says the mode.) */
    /* D205: born in its Navigate state, so a redraw never replays the fade */
    var navOnNow = navIsOn(navLive());
    h += '<div class="hs-art'+(navOnNow?' navon':'')+'" id="hsart" style="--cfg:'+esc(a.color||'#4a5568')+
           (pb?';--pc:'+pb.c:'')+'">'+
           /* the TALL picture: this box is taller than wide on a phone (D121) */
           artHTML(a, 300, {eager:true, shape:'tall'})+
           /* ONE ROW ALONG THE FOOT OF THE PICTURE: which console this drives,
              then the way into its settings. The settings control was a 44px
              puck in the far corner and read as decoration; owner, 2026-09-04:
              "make the settings thing way wider ... and is obvious you click
              that for settings". So it is a labelled pill that takes all the
              width the badge does not, which also puts the two controls in
              one line the eye reads left to right. */
           '<div class="hs-artfoot">'+
             '<button class="hs-cog" id="hscog" '+
               'aria-label="Settings for this config">'+
               icoSVG('sliders', 22)+'<span class="cw">Settings</span>'+
               '<span class="cv" aria-hidden="true">›</span>'+
             '</button>'+
           '</div>'+
           /* D205: PASSTHROUGH MODE ACTIVE over the greyed picture, with the
              way out; it swallows taps on the picture, but (D205 amended,
              owner) the Settings bar under it stays visible and opens
              Settings */
           navCoverHTML()+
         '</div>';

    /* D196 (owner): THE DEVICE CARD SITS UNDER THE PICTURE, where the
       input chip was. It now carries the console mode AND the input, so
       the picture's console badge and the chip under it both went: one
       place says what the device is doing. */
    h += '<div class="hs-link'+(offline?' off':'')+(navOnNow?' navon':'')+'">'+
           '<button class="lk '+(offline?'down':'up')+'" id="livechip" '+
             'aria-haspopup="dialog" aria-expanded="false" '+
             'aria-label="'+esc(linkChipLabel(!offline))+'">'+
             linkChipInner(!offline)+
           '</button>'+
           /* D343: the Wi-Fi light's own door, laid over the glyph (a
              button cannot hold a button); '' offline or without Wi-Fi */
           (!offline && window.ZS_WIFI && ZS_WIFI.hitHTML ? ZS_WIFI.hitHTML() : '')+
           (offline ? '<p class="hs-offmsg">'+esc(offMsg)+'</p>' : '')+
           /* D343: the Core's Wi-Fi row (core-wifi.js), on the card under
              its button; '' offline or on a Core without Wi-Fi */
           (!offline && window.ZS_WIFI ? ZS_WIFI.rowHTML() : '')+
         '</div>';
    /* D352: A RUNNING SCRIPT'S SCREEN (home-oled.js), under the device card,
       only while /status says a running script drew on it; '' otherwise (an
       older Core, no script, offline). The picture gives it the height. */
    if(!offline && window.ZS_HOLED) h += ZS_HOLED.cardHTML();

    var home = document.getElementById('home');
    /* A redraw is NOT an entrance. renderHome runs on the ~8s poll and on
       board events, and innerHTML makes every child brand-new — if the boot
       entrance class survived here, each refresh would replay the whole
       stagger and the screen would flicker constantly. Strip it first: a
       refresh may cut the entrance short, it can never replay it. Only
       homeEnter() — boot, once — ever puts it on. */
    /* D448 (owner: "it's all laggy"): THE POLL DOES NOT REBUILD WHAT IT
       WOULD BUILD AGAIN. The 8 s /status tick used to throw HOME away and
       parse it back from the same string, re-creating every picture (on a
       phone: a fresh decode of the game art) for no change at all. When the
       markup is the one this function wrote last and that DOM is still the
       one on screen, it is kept, with its handlers; the live painters below
       still run, so everything they own stays current. */
    var sameHome = home._zsHtml === h && home.firstChild && home.firstChild === home._zsFirst;
    if(!sameHome){
    home.classList.remove('zs-enter');
    home.innerHTML = h;
    home._zsHtml = h; home._zsFirst = home.firstChild;
    /* D352: the screen card is brand-new: repaint its last frame, keep its
       10 Hz poll running while it is on screen */
    if(window.ZS_HOLED) ZS_HOLED.wire();
    wireArt(home);        /* a 404'd photo becomes the family mark, never a
                             broken-image icon — this is the offline path */
    /* EDIT CONFIG HAS TWO HANDLES NOW and both are the same door: the pencil
       in the app bar (wired once at boot - it is static markup) and the gear
       on the picture. The full-width EDIT CONFIG slab is gone; the reference
       does not have one and it was eating 64px of the photo to say what the
       pencil says in 19. */
    var cogEl=document.getElementById('hscog');
    if(cogEl){ cogEl.addEventListener('click', function(){ openEditor(activeId); });
               if(window.ZSM && ZSM.pressable) ZSM.pressable(cogEl); }
    /* the ● board chip is the door to the board-facts sheet; a real <button>,
       so no kb() shim. Re-wired on every redraw because innerHTML above made
       it brand-new; the sheet itself lives in #sheetwrap, OUTSIDE #home, so
       the ~8s poll's redraw can never repaint it out from under a finger. */
    var lc=document.getElementById('livechip');
    if(lc){
      lc.addEventListener('click', function(){ openBoardSheet(lc); });
      /* D194: the card answers the finger on pointer-down (DESIGN.md, Press) */
      if(window.ZSM && ZSM.pressable) ZSM.pressable(lc);
      /* the box was rebuilt with the card: paint it now, whatever it held */
      paintHomeNavBox(true);
      /* THE POLL REPLACES THE CHIP WHILE THE SHEET IS OPEN. The sheet itself
         is safe — it lives in #sheetwrap, outside #home — but the button that
         opened it has just been thrown away and rebuilt, so the remembered
         opener is a detached node and the new chip says "closed" while the
         dialog is on screen. Re-point both at the chip that now exists: this
         is the one seam between the 8 s redraw and the popover, and it is
         cheap to hold here and invisible to fix anywhere else. */
      var swOpen=document.getElementById('sheetwrap');
      if(swOpen && swOpen.classList.contains('open') && sheetOpener &&
         sheetOpener.getAttribute && sheetOpener.getAttribute('id')==='livechip'){
        sheetOpener = lc;
        lc.setAttribute('aria-expanded','true');
      }
    }
    /* D343: the Wi-Fi row's door, re-wired every draw like the chip; and,
       while its sheet is open, the sheet's opener is the row that exists
       now (the chip's rule above) */
    if(window.ZS_WIFI){
      /* the row, the light's door and the first-run prompt (core-wifi.js) */
      if(ZS_WIFI.wireHome) ZS_WIFI.wireHome(home); else ZS_WIFI.wireRow(home);
      var swW=document.getElementById('sheetwrap');
      var opId = (sheetOpener && sheetOpener.getAttribute) ? sheetOpener.getAttribute('id') : '';
      /* connected, the row is gone (D343 amended): the light is the door */
      var wfNow = (opId==='hswifi' || opId==='hdwifihit') ?
        (document.getElementById(opId) || document.getElementById('hdwifihit')) : null;
      if(swW && swW.classList.contains('open') && wfNow){
        sheetOpener = wfNow;
        wfNow.setAttribute('aria-expanded','true');
      }
    }
    } else {
      /* kept: what the rebuild's wiring also did that is not about new
         nodes - the screen card's poll, and the Wi-Fi first-run prompt,
         which waits for a draw to come up (core-wifi.js) */
      if(window.ZS_HOLED) ZS_HOLED.wire();
      if(window.ZS_WIFI && ZS_WIFI.maybePrompt) ZS_WIFI.maybePrompt();
    }   /* end of the rebuild (D448) */
    /* The three doors live in the ⋯ menu now (see openMoreMenu), so HOME's
       only wiring is its one action. The tap handlers that used to live here
       — switch, reorder, edit, new — moved WITH their rows into R.profiles
       long before that; they are the same code, one screen along. */
    /* HOME is not the only screen drawing this array any more. Last, so the
       Configs panel — if that is what is open — is redrawn from the colours
       this function just re-read, never from yesterday's. */
    syncProfileList();
    /* the two live surfaces the poll also owns. Cheap, and they must agree
       with the config this draw just painted. */
    paintDevPills();
    paintHomeKeys();
    paintHomeNav();
    paintHomeGun();
    paintHomeCal();
    checkHomeCal();
  }

  /* == WHO IS PLUGGED IN, top middle ================================
     ONE PILL PER ATTACHED DEVICE, AND NOTHING FOR WHAT IS NOT (owner,
     2026-09-04: "you only show a mouse if a mouse is connected"). The first
     draft drew all three greyed out, which reads as "your keyboard is broken"
     rather than "you have not plugged one in" - a dim control is a control
     that failed, and this is an accessibility product where that difference
     costs a support ticket.

     Each pill is a real <button>, because the board's own answer to "what IS
     this thing" is worth a tap: openDevicesSheet() names what it recognised
     (an Xbox pad, a Ducky keyboard) rather than making the user infer it from
     an icon. That is the same reason the board chip is a button and not a dot.

     ZS.userDevices() is the device bar's own filtered list, not the raw
     enumeration - the board's ADC channels and its power button are not
     things anyone plugged in. */
  var PILL_KIND = {
    mouse:    { cls:'ms',  ico:'mouse',  lab:'Mouse' },
    keyboard: { cls:'kb',  ico:'keycap', lab:'Keyboard' },
    gamepad:  { cls:'pad', ico:'pad',    lab:'Controller' }
  };
  /* the order the row reads in, so plugging a mouse in never reshuffles the
     pills that were already there */
  var PILL_ORDER = ['mouse','keyboard','gamepad'];

  function homeDevices(){
    if(LIVE.online===false) return [];
    var raw = (window.ZS && ZS.devices) ? ZS.devices : null;
    if(!raw) return [];
    /* ZS.userDevices is devbar.js's own filter and it TAKES THE LIST - it
       drops the board's own evdev nodes (the A733's ADC channels, the PMIC
       power button) and collapses the three nodes one physical pad arrives
       as into one. Reusing it is the point: two copies of "what counts as a
       device someone plugged in" would drift the first time either was
       fixed, and this screen and the device bar must never disagree about
       how many controllers are attached. */
    return (window.ZS && ZS.userDevices) ? ZS.userDevices(raw) : raw;
  }
  /* attached devices, grouped into the three kinds the row can show */
  function pillGroups(){
    var out = {}, list = homeDevices(), i, d, k;
    for(i=0;i<list.length;i++){
      d = list[i];
      /* D217: a "not opened" interface is never a pill (ZS.userDevices
         already leaves it out; this is the same rule without devbar.js) */
      if(!d || d.connected===false || d.opened===false) continue;
      k = String(d.kind||'');
      if(!PILL_KIND[k]) continue;
      if(!out[k]) out[k] = [];
      out[k].push(d);
    }
    return out;
  }
  function paintDevPills(){
    var host = document.getElementById('devpills');
    if(!host) return;
    var groups = pillGroups(), h = '', names = [], i, k, g, n;
    for(i=0;i<PILL_ORDER.length;i++){
      k = PILL_ORDER[i];
      g = groups[k];
      if(!g || !g.length) continue;          /* not plugged in: draw nothing */
      n = PILL_KIND[k];
      names.push(g.length > 1 ? g.length+' '+n.lab.toLowerCase()+'s' : n.lab);
      /* D188: hold the MOUSE (about a second) for XIM's Mouse Sensor Test;
         said in its label, and the devices sheet's \u2022\u2022\u2022 is the same door
         without the hold */
      h += '<button class="dp '+n.cls+'" data-kind="'+k+'" '+
             'aria-label="'+esc(n.lab+(g.length>1?' \u00d7'+g.length:'')+
               ' \u2014 what the board recognised'+
               (k==='mouse' && window.ZS_MRATE ? '. Press and hold for the mouse sensor test' : ''))+'">'+
             /* D233 (owner): the pill is a PICTURE of what is plugged in -
                the PS5 pad for anything Sony, the Xbox pad for every other
                pad, the keyboard, the mouse (devbar.js ZS.devicePicFor) */
             ((window.ZS && ZS.devicePicFor && ZS.devicePicFor(g[0]))
               ? '<img class="dpic" src="'+esc(ZS.devicePicFor(g[0]))+'" alt="" aria-hidden="true">'
               : icoSVG(n.ico, 22))+
             (g.length>1 ? '<span class="dpn">'+g.length+'</span>' : '')+
           '</button>';
    }
    host.innerHTML = h;
    /* THE EMPTY ROW STILL SAYS SOMETHING, IN WORDS A PERSON USES (D192, the
       owner: "devices unknown" read as a debug variable). With nothing
       plugged into it, the middle of the bar names the HARDWARE this app is
       talking to ("EXO Core"); with no hardware at all it says exactly that,
       "No device connected". Never a raw key, never a status code. */
    var off = (LIVE.online===false);
    /* D257 (owner, 2026-10-09: "when nothing is plugged in it just says EXO
       Core - make it say nothing is plugged into the adapter, like the
       bottom of Settings"): the same words the device bar uses */
    if(!h){
      /* the device bar's look - a dot and the words - in red (owner,
