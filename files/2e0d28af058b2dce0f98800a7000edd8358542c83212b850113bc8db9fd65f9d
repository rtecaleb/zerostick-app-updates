  var noPicSince = 0;
  function noGamePicture(){
    var st = LIVE.status || {}, cap = st.capture || null;
    var sig = cap && String(cap.signal || '');
    var bad = productId() === 'core' && LIVE.online !== false && cap &&
              cap.owner !== 'parked' && cap.owner !== 'pc' &&
              (sig === 'flat' || sig === 'no frames');
    if(!bad){ noPicSince = 0; return false; }
    if(!noPicSince) noPicSince = Date.now();
    return Date.now() - noPicSince >= 10000;
  }
  /* the Core's screen state (firmware zs_textread_hunt.h, "screen" in the
     weapon block, Call of Duty configs only) in the card's words; '' when
     the Core says none, one this app does not know, or "nohud" (no weapon
