      h += '<span class="hs-key hs-stick" data-stick="'+sticks[i].id+'">'+
             '<svg viewBox="0 0 26 26" aria-hidden="true">'+
               '<circle class="sw" cx="13" cy="13" r="11.5"/>'+
               '<circle class="sd" cx="13" cy="13" r="4.5"/>'+
             '</svg>'+
             '<span class="kn">'+esc(sticks[i].name)+'</span>'+
           '</span>';
    }
    host.innerHTML = h;
    paintStickDots(host, sticks);
    /* aria-live is OFF (see the markup): a screen reader must not narrate
       every press of a game being played. The label carries the state for
       anyone who goes looking for it. */
    host.setAttribute('aria-label',
      names.length ? 'Pressing '+names.join(', ') : 'No buttons pressed');
    glideKeys(host, keysWas);
    syncFootLift();
  }

  /* WHICH STICKS ARE OUT OF THE MIDDLE. The feed is -1..1 with y rising
     UPWARD (the Core's convention, D246); a board that sends raw 16-bit
     counts is folded to the same range, as ds-live.js does. 0.2 of the
     throw is past any worn stick's drift at rest (a deadzone-less pad
     reads up to ~0.1) and well inside the first nudge a player makes. */
  var STICK_ON = 0.2;
  function stickUnit(v){
    v = +v || 0;
    if(Math.abs(v) > 1.5) v = v / 32767;
    return Math.max(-1, Math.min(1, v));
  }
  function homeSticks(st){
    var out = [];
    if(!st) return out;
    [['ls','L stick','Left stick',st.lx,st.ly],['rs','R stick','Right stick',st.rx,st.ry]]
      .forEach(function(s){
        var x = stickUnit(s[3]), y = stickUnit(s[4]);
        if(Math.sqrt(x*x + y*y) > STICK_ON) out.push({ id:s[0], name:s[1], word:s[2], x:x, y:y });
      });
    return out;
  }
  /* the dot rides 7 units from the middle of a 26-unit well at full throw;
     the picture's y runs DOWN, the Core's runs up */
  function paintStickDots(host, sticks){
    for(var i=0;i<sticks.length;i++){
      var box = host.querySelector('[data-stick="'+sticks[i].id+'"] .sd');
      if(box) box.setAttribute('transform',
        'translate('+(sticks[i].x*7).toFixed(1)+','+(-sticks[i].y*7).toFixed(1)+')');
    }
  }

  /* the words HOME uses for a key held in Passthrough mode, where the device
     card's navWord() is too terse ("Space") or names a pad button */
  var NAV_KEY_WORD = { KEY_SPACE:'Space bar', KEY_LEFTMETA:'Windows', KEY_RIGHTMETA:'Windows',
                       KEY_ESC:'Esc', KEY_ENTER:'Enter', KEY_BACKSPACE:'Backspace',
                       KEY_CAPSLOCK:'Caps Lock', KEY_TAB:'Tab',
                       KEY_UP:'Up', KEY_DOWN:'Down', KEY_LEFT:'Left', KEY_RIGHT:'Right',
                       BTN_LEFT:'Left click', BTN_RIGHT:'Right click', BTN_MIDDLE:'Middle click',
                       BTN_SIDE:'Mouse 4', BTN_EXTRA:'Mouse 5', BTN_BACK:'Mouse 4', BTN_FORWARD:'Mouse 5' };

  /* THE ROW ONLY MOVES FOR A SECOND ROW. One row of boxes always fits in
     the reserved height (CSS min-height), so a press inside it changes
     nothing around it. When the boxes wrap to a second row, or fall back to
     one, the foot glides between the two heights instead of jumping: the
     row is pinned at the height it had, then let go to its new one, and the
     inline height is dropped once it lands so the CSS owns it again. A new
     press mid-glide starts from wherever the row is (offsetHeight reads the
     transitioned value). Reduced motion: the CSS drops the transition, so
     it lands at once. */
  var keysGlideTimer = null;
  function glideKeys(host, from){
    if(!host || !host.style) return;
    host.style.height = '';
    var to = host.offsetHeight;
    if(!from || !to || from === to){
      if(host.classList) host.classList.remove('zs-growing');
      return;
    }
    host.classList.add('zs-growing');
    host.style.height = from + 'px';
    void host.offsetHeight;            /* commit the start before the change */
    host.style.height = to + 'px';
    if(keysGlideTimer) clearTimeout(keysGlideTimer);
    keysGlideTimer = setTimeout(function(){
      keysGlideTimer = null;
      host.classList.remove('zs-growing');
      host.style.height = '';
    }, 320);
  }

  /* == PASSTHROUGH MODE, ON HOME ========================================
     While it is on, the pad drives the console's MENUS instead of the game.
     That is a fact about what the adapter is doing right now, so it belongs
     on the screen that says what the adapter is doing - not only on the
     device bar, which HOME hides. Same source as the bar (ZS.navState), so
     the two can never disagree.

     AND IT SAYS WHAT TURNED IT ON. A player who hit the combo by accident is
     the whole reason this banner exists; "PASSTHROUGH MODE" alone tells them
     they are stuck without telling them the way out. `via` is the combo the
     board itself matched, named with the same glyph vocabulary the boxes
     below use, so the words match the buttons under their thumbs. */
  /* D200 (owner): THE BANNER IS GONE. "Remove the Passthrough mode banner that
     says Alt and M4": the device card says "Passthrough mode", the shortcut
     that turned it on and the yellow Turn off key, so a second line on HOME
     only repeated it. The element stays (other code measures the foot) and
     is simply kept hidden. */
  function paintHomeNav(){
    var el = document.getElementById('hsnav');
    if(!el || el.hidden) return;
    el.hidden = true; el.innerHTML = '';
    syncFootLift();
  }

  /* D203 (owner): A CALIBRATION RUNNING ON THE CORE. The Translation
     room's Calibrate card starts it, and it holds every input while it
     measures - but the Core keeps measuring if the app is closed, and the
     owner came back to a controller and mouse that "did nothing". HOME now
     asks GET /calibrate/status (a Core only, online only, at most once per
     few seconds on HOME's own redraws; every second while it is running and
     HOME is showing) and, while the state is "running", says so, shows the
     step and a Stop key that POSTs /calibrate/cancel. It never paints a
     guess: the line goes the moment the Core says anything but running. */
  var calHome = { d:null, at:0, inflight:false, busy:false, err:'', timer:null };
  function homeShowing(){
    var ed = document.getElementById('editor'), dt = document.getElementById('detail');
    return !(ed && ed.classList.contains('open')) && !(dt && dt.classList.contains('open'));
  }
  function checkHomeCal(force){
    if(calHome.inflight) return;
    if(productId() !== 'core' || LIVE.online === false){
      if(calHome.d){ calHome.d = null; paintHomeCal(); }
      return;
    }
    var now = Date.now();
    if(!force && calHome.at && now - calHome.at < 3000) return;
    calHome.at = now; calHome.inflight = true;
    api('/calibrate/status').then(function(j){
      calHome.inflight = false;
      calHome.d = (j && j.ok && j.data && j.data.state === 'running') ? j.data : null;
      if(!calHome.d){ calHome.busy = false; }
      paintHomeCal();
      clearTimeout(calHome.timer); calHome.timer = null;
      if(calHome.d) calHome.timer = setTimeout(function(){
        calHome.timer = null;
        if(homeShowing()) checkHomeCal(true);
      }, 1000);
    });
  }
  function paintHomeCal(){
    var el = document.getElementById('hscal');
    if(!el) return;
    var d = calHome.d;
    if(!d){
      if(!el.hidden || el.innerHTML){ el.hidden = true; el.innerHTML = ''; }
      calHome.err = '';
      return;
    }
    var steps = Math.max(0, Number(d.steps) || 0);
    /* the Core's step is the index of the step it is on (0 = the first) */
    var cur = Math.min(steps || 1, Math.max(1, (Number(d.step) || 0) + 1));
    var frac = d.totalMs > 0 ? Math.max(0, Math.min(1, (Number(d.doneMs) || 0) / d.totalMs))
             : steps ? (cur - 1) / steps : 0;
    el.hidden = false;
    el.innerHTML =
      '<span class="clt">'+
        '<span class="clh">Calibration running – your controller and mouse are paused</span>'+
        '<span class="cls">'+(steps ? 'Step '+cur+' of '+steps : 'Measuring')+
          (calHome.err ? ' · '+esc(calHome.err) : '')+'</span>'+
        '<span class="clbar" aria-hidden="true"><i style="width:'+Math.round(frac * 100)+'%"></i></span>'+
      '</span>'+
      '<button class="clstop" id="hscalstop" aria-label="Stop the calibration"'+
        (calHome.busy ? ' disabled' : '')+'>'+(calHome.busy ? 'Stopping…' : 'Stop')+'</button>';
    var b = document.getElementById('hscalstop');
    if(b) b.addEventListener('click', function(){
      if(calHome.busy) return;
      calHome.busy = true; calHome.err = ''; paintHomeCal();
      api('/calibrate/cancel', 'POST', {}).then(function(j){
        calHome.busy = false;
        if(!(j && j.ok)) calHome.err = 'It did not stop. Try again.';
        checkHomeCal(true);
      });
    });
  }

  /* IT CLEARS THE MARK, AND ONLY THE MARK. zs-fixes.css parks the toast in
     the bottom band on purpose - that band is ambient, so a toast there
     cannot cover a control; the worst it can do is hide status for three
     seconds. HOME's foot is ambient in exactly the same way (what you are
     pressing, and the mark), so that reasoning survives the redesign. What
     it must not do is land on the product's mark, which 14px did. Lifting by
     the WHOLE foot instead would push the toast onto the picture - covering
     the subject of the screen to protect a strip of ambient text. */
  function syncFootLift(){
    var scr = document.querySelector('.screen');
    /* the mark moved to the app bar's top left (D185), so the foot has no
       mark for a toast to land on and the default parking (14px) is right
       again; this stays for any build that still draws one down there */
    var mk  = document.querySelector('#hfoot #brand');
    if(scr && !mk && scr.style && typeof scr.style.removeProperty === 'function'){
      scr.style.removeProperty('--toast-lift');
    }
    if(!scr || !mk) return;
    /* offsetHeight, not getBoundingClientRect: this runs right after an
       innerHTML write and we want the laid-out box, not a transformed one. */
    var h = mk.offsetHeight;
    /* THE MARK IS AN IMAGE. On a cold start (the exe's fresh Edge profile)
       this can run before zs-logo.png has loaded, when the mark is a few
       pixels tall — and a lift measured from that lands the toast ON the
       logo. Re-measure when the picture arrives, and never lift by less
       than the logo's own 40px in the meantime. */
    var img = mk.querySelector('img');
    if(img && !(img.complete && img.naturalHeight > 0)){
      img.addEventListener('load', syncFootLift, { once: true });
    }
    if(h < 40) h = 40;
    /* the harness DOM has no setProperty; a browser always does */
    if(scr.style && typeof scr.style.setProperty === 'function'){
      scr.style.setProperty('--toast-lift', (h + 16) + 'px');
    }
  }

  /* HOME's one entrance. HOME has no data-ns to discriminate navigation
     from refresh, so the rule is held structurally instead: this is called
     from exactly one place — boot — and renderHome() strips the class on
     every redraw. Returning from a panel is NOT an entrance (the screen was
     visibly there beneath the panel the whole time); that case gets the
     .zs-covered depth settle in syncInert() instead. No reduced-motion
     check here on purpose: both signals — prefers-reduced-motion and
     body.a11y-motion — are checked LIVE by the CSS itself, which a cached
     JS answer could only ever get wrong. */
  var homeEnterTimer = null;
  function homeEnter(){
    var home = document.getElementById('home');
    home.classList.add('zs-enter');
    if(homeEnterTimer) clearTimeout(homeEnterTimer);
    /* the class must not outlive the entrance: a later redraw arriving
       while it was still on would replay the stagger on brand-new children.
       900ms clears the longest delay (.34s) plus the duration (.38s). */
    homeEnterTimer = setTimeout(function(){ home.classList.remove('zs-enter'); }, 900);
  }

