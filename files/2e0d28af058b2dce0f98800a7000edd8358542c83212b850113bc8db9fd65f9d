       one of the longer banner versions"): the wide banner (the gun scanned
       and named), half the card wide */
    var mark = '<img class="gi-pic" src="brand/zs-ai-scripts-banner.jpg" alt="" decoding="async" draggable="false">';
    return '<span class="gi" aria-hidden="true">'+mark+'</span>'+
      '<span class="gt"><span class="gl">Active weapon</span>'+
        /* 2026-10-23 (owner): the gun in hand's own small picture beside its
           name, only when the game's catalog has one */
        '<span class="gnrow"><span class="gn" role="status" aria-live="polite">'+esc(name)+'</span>'+
          (pic ? '<img class="gn-pic" src="'+esc(pic)+'" alt="" aria-hidden="true" decoding="async" draggable="false" '+
            'onerror="this.remove()">' : '')+'</span>'+
        (status ? '<span class="gs"><span class="gd" aria-hidden="true"></span>'+esc(status)+'</span>' : '')+
      '</span>';
