    var el = rec.el;
    var box = el.querySelector('#zslg-agree');
    var go = el.querySelector('#zslg-go');
    var said = el.querySelector('#zslg-said');
    function sync() { go.disabled = !box.checked; }
    box.addEventListener('change', sync);
    box.addEventListener('click', function () { setTimeout(sync, 0); });
    go.addEventListener('click', function () {
      if (!box.checked) { return; }
      accept();
      showing = null;
      close(rec);
    });
    el.querySelector('#zslg-no').addEventListener('click', function () {
      /* the way out: the app stays closed. The exe's window can usually be
         closed by the page; a phone (Android) leaves through Capacitor's
         App plugin; where neither works, say what to do. */
      said.textContent = 'ZeroStick EXO stays closed until you agree. Your EXO keeps working without the app. You can close this window, or read the documents and agree when you are ready.';
      var cap = window.Capacitor;
      try {
        if (cap && cap.isNativePlatform && cap.isNativePlatform() && cap.Plugins && cap.Plugins.App && cap.Plugins.App.exitApp) {
          cap.Plugins.App.exitApp();
          return;
        }
      } catch (e) {}
      try { if (window.close) { window.close(); } } catch (e) {}
    });
    showing = rec;
    return rec;
  }

  /* ── A-6: inside EXO Studio, waiting for its agreement ──────────────── */
  var waiting = null;
  function waitForHost() {
    if (waiting) { return waiting; }
    injectCSS();
    var el = document.createElement('div');
    el.className = 'zslg zslg-wait';
    el.id = 'zslg-wait';
    el.setAttribute('role', 'status');
    el.setAttribute('aria-live', 'polite');
    el.innerHTML = '<h1>Waiting for ' + esc(HOST_NAME) + '…</h1>' +
      '<p class="zslg-dim">Agree to the Terms of Use and the Privacy Policy in ' + esc(HOST_NAME) +
      ' and this opens by itself.</p>';
    document.body.appendChild(el);
    var rec = { el: el, prev: document.activeElement, onBack: null };
    layers.push(rec);
    waiting = rec;
    /* ask the host once; Studio may hand the agreement over right here */
