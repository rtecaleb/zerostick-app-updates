/* zs-legal.js — the first-run agreement and the legal documents, in the app
 * (D272). window.ZSLEGAL.
 *
 * The documents are legal/app/*.md, rendered by tools/gen-legal.js into
 * zs-legal-docs.js (window.ZSLEGALDOCS), which MUST load before this file.
 * Nothing here touches the network: the pages are in that one script.
 *
 *   ZSLEGAL.gate()             the agreement, when this person has not agreed
 *                              to the current Terms and Privacy Policy (run by
 *                              itself when the page loads; see skipReason)
 *   ZSLEGAL.show()             the agreement, now (the shots use it)
 *   ZSLEGAL.needsAcceptance()  true on a first run and whenever the Terms or
 *                              the Privacy Policy version changes
 *   ZSLEGAL.accept()           remembers what was agreed to, and when
 *   ZSLEGAL.openList()         Settings > Legal: every document, and the line
 *                              "You agreed on <date>"
 *   ZSLEGAL.openDoc(key)       one document ('terms', 'privacy', ...)
 *   ZSLEGAL.agreedLine()       that line, as text
 *   ZSLEGAL.showWait()         inside a host: the wait below, now (shots)
 *
 * FOR A HOST (D335 A-6, EXO Studio's MY-EXO-APP-HOOKS.md): window.zsLegal
 *   zsLegal.versions()         { terms, privacy }: what this app expects
 *   zsLegal.acceptFromHost(r)  r = { terms, privacy, at, host: 'studio' }:
 *                              stores it (the same record, with host) and
 *                              returns true; false for versions older than
 *                              this app's, another host, or no host here
 *
 * INSIDE EXO STUDIO (ZSHOST.hides('legalScreen')) THIS APP SHOWS NO TERMS
 * SCREEN OF ITS OWN: Studio's agreement covers both (owner, A-6). The app
 * counts as agreed only by a host record (host: 'studio') at this app's
 * versions or newer, handed over now or stored from an earlier start.
 * Without one it shows a plain "Waiting for EXO Studio..." layer and asks
 * the host once (window.zsHost.legalNeeded(versions), when Studio offers
 * it); acceptFromHost lifts that layer and the app carries on where it was,
 * no reload. Outside Studio a host record never counts: the person agrees
 * in the app itself, exactly as before (D335 A-6 says why).
 *
 * THE AGREEMENT (legal/app/WIRING.md section 2.1, after EXO Studio's
 * legal_ui.py): three short points, the two documents one tap away, an
 * UNTICKED box, Continue only once it is ticked, and a way out. Nothing is
 * pre-ticked or hidden. It gates the app's SCREENS only: the EXO itself
 * keeps working without the app ("nothing may stop a controller from
 * working").
 *
 * WHERE IT IS KEPT: localStorage 'zs-legal' (the EXO app's own namespace,
 * zs-*), { terms, privacy, at, app, history } (+ host: 'studio' when EXO
 * Studio's agreement was handed over, A-6). Factory reset keeps it
 * (22-global.js): erasing settings is not withdrawing an agreement.
 *
 * WHEN IT IS NOT SHOWN: only when the page was told so BEFORE this file ran,
 * by a harness that has no person in front of it (app-harness.js, the
 * screenshot run theme-shots.js): window.ZS_LEGAL_SKIP = '<who>'. A person
 * opening the app has no way to set that, so the real flow is unchanged.
 *
 * ES5, like every file the app loads (docs/DESIGN.md). One global. */
(function () {
  'use strict';

  var KEY = 'zs-legal';
  var DATA = window.ZSLEGALDOCS || { terms: '', privacy: '', docs: [] };
  /* A-6: hosted by EXO Studio, whose own agreement covers this app */
