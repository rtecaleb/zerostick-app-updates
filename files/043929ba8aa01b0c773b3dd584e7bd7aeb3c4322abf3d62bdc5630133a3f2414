  var HOSTED = !!(HZ && typeof HZ.hides === 'function' && HZ.hides('legalScreen'));
  var HOST_ID = HOSTED ? String(HZ.id || 'studio') : '';
  var HOST_NAME = HOSTED ? String(HZ.name || 'EXO Studio') : '';

  var POINTS = [
    'Your configs and game video stay on your EXO and in this app. We don’t collect your data.',
    'Using an adapter like the EXO online can break a game’s or console’s rules: a game can ban an account for it, and a console may block the device. Where you use it is your choice and your risk.',
    'You can read these any time in Settings › Legal.'
  ];

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
