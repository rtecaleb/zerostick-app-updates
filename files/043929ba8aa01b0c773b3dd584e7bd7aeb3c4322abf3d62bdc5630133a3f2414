    '.zslg-btn{flex:1;min-height:48px;border-radius:10px;font:inherit;font-size:16px;font-weight:600;cursor:pointer;' +
      'border:1px solid var(--zk-line,var(--line,#3a3e45));background:var(--zk-card2,var(--panel2,#1b1e22));color:var(--zk-text,var(--text,#eef1f4))}' +
    '.zslg-btn.pri{background:var(--zk-accent,var(--accent,#58a6ff));border-color:var(--zk-accent,var(--accent,#58a6ff));color:var(--zk-ink,var(--accent-ink,#06172e))}' +
    '.zslg-btn[disabled]{background:var(--zk-card2,var(--panel2,#1b1e22));border-color:var(--zk-line,var(--line,#3a3e45));color:var(--zk-dim,var(--muted,#9aa3ad));cursor:not-allowed}' +
    '.zslg-doc{max-width:720px;margin:0 auto;overflow-wrap:anywhere}' +
    '.zslg-doc h2{font-size:21px;line-height:1.25;margin:4px 0 12px}' +
    '.zslg-doc h3{font-size:17px;margin:22px 0 8px}' +
    '.zslg-doc h4,.zslg-doc h5{font-size:15px;margin:18px 0 6px}' +
    '.zslg-doc ul,.zslg-doc ol{margin:0 0 10px;padding-left:22px}' +
    '.zslg-doc li{margin:4px 0}' +
    '.zslg-doc blockquote{margin:0 0 14px;padding:10px 14px;border:1px solid var(--zk-line,var(--line,#3a3e45));border-radius:10px;' +
      'background:var(--zk-card,var(--panel,#26282d))}' +
    '.zslg-doc blockquote p:last-child{margin-bottom:0}' +
    '.zslg-doc code{font-family:ui-monospace,Consolas,monospace;font-size:13px}' +
    '.zslg-doc pre{white-space:pre-wrap;font-family:ui-monospace,Consolas,monospace;font-size:12px;line-height:1.45;' +
      'background:var(--zk-card,var(--panel,#26282d));border:1px solid var(--zk-line,var(--line,#3a3e45));border-radius:10px;padding:12px;margin:0 0 14px}' +
    '.zslg-doc .lg-tw{overflow-x:auto;margin:0 0 14px}' +
    '.zslg-doc table{border-collapse:collapse;width:100%;font-size:13px}' +
    '.zslg-doc th,.zslg-doc td{border:1px solid var(--zk-line,var(--line,#3a3e45));padding:6px 8px;text-align:left;vertical-align:top}' +
    '.zslg-doc th{background:var(--zk-card,var(--panel,#26282d))}' +
    '.zslg a{color:var(--zk-accent,var(--accent,#58a6ff));text-decoration:underline}' +
    '.zslg :focus-visible{outline:2px solid var(--zk-accent,var(--accent,#58a6ff));outline-offset:2px}' +
    /* A-6: the host's agreement is on its way. Flat, neutral, no motion */
