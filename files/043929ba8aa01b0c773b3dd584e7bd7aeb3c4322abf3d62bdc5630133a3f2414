  }
  function accept() {
    var old = accepted();
    var rec = { terms: DATA.terms, privacy: DATA.privacy, at: new Date().toISOString(), app: appVersion() };
    var hist = (old.history && old.history.slice) ? old.history.slice(-19) : [];
    if (old.terms) { hist.push(histOf(old)); }
    rec.history = hist;
    try { window.localStorage.setItem(KEY, JSON.stringify(rec)); } catch (e) { /* the screen still lets them in */ }
    return rec;
  }
  function histOf(old) {
    var h = { terms: old.terms, privacy: old.privacy || '', at: old.at || '', app: old.app || '' };
    if (old.host) { h.host = old.host; }
    return h;
  }
  /* A-6: EXO Studio hands over what was agreed in its own screen. Stored
     like the app's own agreement, plus host; Studio hands it on every
     start, so the same agreement again changes nothing. */
  function acceptFromHost(r) {
    if (!HOSTED || !r || typeof r !== 'object' || r.host !== HOST_ID) { return false; }
    if (typeof r.terms !== 'string' || typeof r.privacy !== 'string') { return false; }
    if (!verAtLeast(r.terms, DATA.terms) || !verAtLeast(r.privacy, DATA.privacy)) { return false; }
    var at = String(r.at || '');
    if (!/^\d{4}-\d{2}-\d{2}T/.test(at)) { at = new Date().toISOString(); }
    var old = accepted();
    var rec;
    if (old.host === HOST_ID && old.terms === r.terms && old.privacy === r.privacy) {
      rec = old;
    } else {
      rec = { terms: r.terms, privacy: r.privacy, at: at, app: appVersion(), host: HOST_ID };
      var hist = (old.history && old.history.slice) ? old.history.slice(-19) : [];
      if (old.terms) { hist.push(histOf(old)); }
      rec.history = hist;
      try { window.localStorage.setItem(KEY, JSON.stringify(rec)); } catch (e) { /* hostMem still lets them in */ }
    }
    hostMem = rec;
    if (waiting) { var w = waiting; waiting = null; close(w); }
    return true;
  }
  function skipReason() {
    var s = window.ZS_LEGAL_SKIP;
    return s ? String(s) : '';
  }
  function agreedLine() {
    var a = record();
    if (!a.at) {
      return HOSTED ? 'You have not agreed to the Terms of Use and the Privacy Policy in ' + HOST_NAME + ' yet.'
        : 'You have not agreed to the Terms of Use and the Privacy Policy on this device yet.';
    }
    var d = String(a.at).slice(0, 10);
    return 'You agreed ' + (HOSTED ? 'in ' + HOST_NAME + ' ' : '') + 'on ' + d +
      ' (Terms ' + a.terms + ', Privacy ' + a.privacy + ').' +
      (needsAcceptance() ? ' They have changed since.' : '');
  }

  /* ── the look: the 8K flat tokens (zs-flat.css, --zk-*); on the device
     list, which does not load it, that page's own copy of the same palette
     (--bg, --panel, ..., light and dark, devices.html); the dark values
     last, for a page with neither ── */
  var CSS =
    '.zslg{position:fixed;inset:0;z-index:2147483000;display:flex;flex-direction:column;' +
      'background:var(--zk-ground,var(--bg,#1b1d20));color:var(--zk-text,var(--text,#eef1f4));' +
      'font-family:inherit;font-size:15px;line-height:1.5;-webkit-text-size-adjust:100%}' +
    '.zslg *{box-sizing:border-box}' +
    '.zslg-bar{display:flex;align-items:center;gap:8px;padding:calc(10px + env(safe-area-inset-top,0px)) 12px 10px;' +
      'border-bottom:1px solid var(--zk-line,var(--line,#3a3e45));background:var(--zk-ground,var(--bg,#1b1d20))}' +
    '.zslg-bar h2{flex:1;margin:0;font-size:17px;font-weight:600;color:var(--zk-text,var(--text,#eef1f4))}' +
    '.zslg-back{min-width:44px;min-height:44px;border:1px solid var(--zk-line,var(--line,#3a3e45));border-radius:10px;' +
      'background:var(--zk-card2,var(--panel2,#1b1e22));color:var(--zk-text,var(--text,#eef1f4));font:inherit;font-size:15px;padding:0 12px;cursor:pointer}' +
    '.zslg-body{flex:1;overflow:auto;padding:16px 16px calc(24px + env(safe-area-inset-bottom,0px));-webkit-overflow-scrolling:touch}' +
    '.zslg-card{background:var(--zk-card,var(--panel,#26282d));border:1px solid var(--zk-line,var(--line,#3a3e45));border-radius:10px;padding:16px;margin:0 0 12px}' +
    '.zslg h1{font-size:22px;line-height:1.25;margin:4px 0 8px;font-weight:700;color:var(--zk-text,var(--text,#eef1f4))}' +
    '.zslg p{margin:0 0 10px}' +
    '.zslg-dim{color:var(--zk-dim,var(--muted,#9aa3ad));font-size:13px}' +
    '.zslg-pts{margin:0 0 12px;padding:0;list-style:none}' +
    '.zslg-pts li{padding:10px 0;border-top:1px solid var(--zk-line,var(--line,#3a3e45))}' +
    '.zslg-pts li:first-child{border-top:0}' +
    '.zslg-links{display:flex;flex-direction:column;gap:8px;margin:0 0 12px}' +
    '.zslg-row{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:10px 14px;' +
      'border:1px solid var(--zk-line,var(--line,#3a3e45));border-radius:10px;background:var(--zk-card2,var(--panel2,#1b1e22));' +
      'color:var(--zk-text,var(--text,#eef1f4));font:inherit;font-size:15px;text-align:left;cursor:pointer}' +
    '.zslg-row .zslg-go{color:var(--zk-dim,var(--muted,#9aa3ad));font-size:13px}' +
    '.zslg-check{display:flex;gap:12px;align-items:flex-start;padding:12px 0;cursor:pointer}' +
