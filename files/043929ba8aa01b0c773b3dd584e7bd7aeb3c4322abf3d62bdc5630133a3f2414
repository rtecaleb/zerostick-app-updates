      '<p class="zslg-dim" id="zslg-agreed">' + esc(agreedLine()) + '</p>', 'Back');
  }

  /* ── the agreement ────────────────────────────────────────────────── */
  var showing = null;
  function show() {
    if (showing) { return showing; }
    var upd = isUpdate();
    var body =
      '<div class="zslg-card">' +
        '<h1>' + (upd ? 'We updated our terms' : 'Welcome to ZeroStick EXO') + '</h1>' +
        '<p class="zslg-dim">' + (upd
          ? 'The Terms of Use or the Privacy Policy changed since you last agreed. Please read them and agree to keep using the app.'
          : 'Before you start, please read and agree to the Terms of Use and the Privacy Policy.') + '</p>' +
        '<ul class="zslg-pts">' + POINTS.map(function (p) { return '<li>' + esc(p) + '</li>'; }).join('') + '</ul>' +
        '<div class="zslg-links">' +
          '<button type="button" class="zslg-row" data-legal-doc="terms"><span>Terms of Use</span><span class="zslg-go">Read ›</span></button>' +
          '<button type="button" class="zslg-row" data-legal-doc="privacy"><span>Privacy Policy</span><span class="zslg-go">Read ›</span></button>' +
        '</div>' +
        '<label class="zslg-check"><input type="checkbox" id="zslg-agree" data-zslg-first>' +
          '<span>I agree to the Terms of Use and the Privacy Policy</span></label>' +
        '<div class="zslg-acts">' +
          '<button type="button" class="zslg-btn" id="zslg-no">Not now</button>' +
          '<button type="button" class="zslg-btn pri" id="zslg-go" disabled>Continue</button>' +
        '</div>' +
        '<p class="zslg-dim" id="zslg-said" role="status" aria-live="polite"></p>' +
      '</div>';
