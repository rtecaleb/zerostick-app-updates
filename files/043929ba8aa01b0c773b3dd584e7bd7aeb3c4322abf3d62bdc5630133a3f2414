      'padding:calc(24px + env(safe-area-inset-top,0px)) 24px calc(24px + env(safe-area-inset-bottom,0px))}' +
    '.zslg-wait h1{font-size:17px;font-weight:600;margin:0 0 6px}' +
    '.zslg-wait p{max-width:320px;margin:0}';

  function injectCSS() {
    if (document.getElementById('zslg-css')) { return; }
    var st = document.createElement('style');
    st.id = 'zslg-css';
    st.textContent = CSS;
    (document.head || document.body).appendChild(st);
  }

  /* ── layers: the agreement, the list, a document; each on top of the
     one before, each with its own way back ─────────────────────────── */
  var layers = [];
  function layer(id, title, bodyHTML, backLabel, onBack) {
    injectCSS();
    var el = document.createElement('div');
    el.className = 'zslg';
    el.id = id;
    el.setAttribute('role', 'dialog');
    el.setAttribute('aria-modal', 'true');
    el.setAttribute('aria-labelledby', id + '-t');
    el.innerHTML = '<div class="zslg-bar">' +
      (backLabel ? '<button type="button" class="zslg-back" data-zslg-back>' + esc(backLabel) + '</button>' : '') +
      '<h2 id="' + id + '-t">' + esc(title) + '</h2></div>' +
      '<div class="zslg-body">' + bodyHTML + '</div>';
    document.body.appendChild(el);
    var rec = { el: el, prev: document.activeElement, onBack: onBack };
    layers.push(rec);
    var b = el.querySelector('[data-zslg-back]');
    if (b) { b.addEventListener('click', function () { close(rec); }); }
    wireDocLinks(el);
    setTimeout(function () {
      var f = el.querySelector('[data-zslg-first]') || b || el.querySelector('button');
      try { if (f && f.focus) { f.focus(); } } catch (e) {}
    }, 0);
    return rec;
  }
  function close(rec) {
    var i = layers.indexOf(rec);
    if (i < 0) { return; }
    layers.splice(i, 1);
    if (rec.el.parentNode) { rec.el.parentNode.removeChild(rec.el); }
    try { if (rec.prev && rec.prev.focus) { rec.prev.focus(); } } catch (e) {}
    if (rec.onBack) { rec.onBack(); }
  }
  function top() { return layers.length ? layers[layers.length - 1] : null; }
  function wireDocLinks(el) {
    var as = el.querySelectorAll('[data-legal-doc]');
    for (var i = 0; i < as.length; i++) {
      (function (a) {
        a.addEventListener('click', function (e) {
          if (e && e.preventDefault) { e.preventDefault(); }
          openDoc(a.getAttribute('data-legal-doc'));
        });
      })(as[i]);
    }
  }
  if (typeof document !== 'undefined' && document.addEventListener) {
    document.addEventListener('keydown', function (e) {
      var t = top();
      if (!t) { return; }
      /* Escape leaves a document or the list; the agreement has no Escape */
      if (e.key === 'Escape' && t.el.querySelector('[data-zslg-back]')) { close(t); return; }
      /* Tab stays inside the top layer */
      if (e.key === 'Tab') {
        var all = t.el.querySelectorAll('button, input, a[href]'), f = [];
        for (var i = 0; i < all.length; i++) { if (!all[i].disabled) { f.push(all[i]); } }
        if (!f.length) { return; }
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }, true);
  }

  /* ── one document ─────────────────────────────────────────────────── */
  function openDoc(key) {
    var d = doc(key);
    if (!d) { return null; }
    var extra = '';
    /* the artwork credits the app already shows (ZSART) belong with the
       open-source list */
    if (key === 'notices' && window.ZSART && typeof window.ZSART.creditsHTML === 'function') {
      try { extra = '<h3>Artwork credits shown in the app</h3>' + window.ZSART.creditsHTML(); } catch (e) { extra = ''; }
    }
    return layer('zslg-doc-' + key, d.title,
      '<article class="zslg-doc" data-zslg-doc="' + esc(key) + '">' + d.html + extra + '</article>', 'Back');
  }

  /* ── Settings > Legal ─────────────────────────────────────────────── */
  function openList() {
    var rows = DATA.docs.map(function (d) {
      return '<button type="button" class="zslg-row" data-legal-doc="' + esc(d.key) + '">' +
