  function doc(key) {
    for (var i = 0; i < DATA.docs.length; i++) { if (DATA.docs[i].key === key) { return DATA.docs[i]; } }
    return null;
  }

  /* ── the record ─────────────────────────────────────────────────── */
  function accepted() {
    try {
      var raw = window.localStorage.getItem(KEY);
      var r = raw ? JSON.parse(raw) : null;
      return (r && typeof r === 'object') ? r : {};
    } catch (e) { return {}; }
  }
  /* A document version is its date, YYYY-MM-DD, and maybe a suffix
     ("2026-10-10-draft"). Newer = a later date; on the same date the plain
     version outranks a suffixed one (the final after its draft). Anything
     else is only "at least" when it is the same string. */
  function verAtLeast(have, want) {
    have = String(have == null ? '' : have); want = String(want == null ? '' : want);
    if (have === want) { return true; }
    var a = /^(\d{4}-\d{2}-\d{2})(.*)$/.exec(have), b = /^(\d{4}-\d{2}-\d{2})(.*)$/.exec(want);
    if (!a || !b) { return false; }
    if (a[1] !== b[1]) { return a[1] > b[1]; }
    return a[2] === '' && b[2] !== '';
