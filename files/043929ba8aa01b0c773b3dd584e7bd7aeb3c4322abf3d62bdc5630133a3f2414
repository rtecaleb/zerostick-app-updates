  }
  function covers(r) {
    if (HOSTED) { return !!r.host && verAtLeast(r.terms, DATA.terms) && verAtLeast(r.privacy, DATA.privacy); }
    return r.terms === DATA.terms && r.privacy === DATA.privacy;
