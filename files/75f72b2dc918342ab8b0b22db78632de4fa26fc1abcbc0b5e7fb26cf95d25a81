<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover">
<script>/* owner 2026-10-13: the app never zooms (iOS ignores user-scalable=no for pinch, so the gesture itself is refused; double-tap zoom is off in CSS) */(function(){function no(e){e.preventDefault();}document.addEventListener("gesturestart",no,{passive:false});document.addEventListener("gesturechange",no,{passive:false});document.addEventListener("touchmove",function(e){if(e.touches&&e.touches.length>1)e.preventDefault();},{passive:false});var st=document.createElement("style");st.textContent="html,body{-webkit-text-size-adjust:100%;text-size-adjust:100%}*{touch-action:manipulation}";var lastEnd=0;document.addEventListener("touchend",function(e){var n=Date.now();if(n-lastEnd<350&&!(e.target&&e.target.closest&&e.target.closest("button,a,input,textarea,select,label,summary,[role],[tabindex],[contenteditable]"))){e.preventDefault();}lastEnd=n;},{passive:false});document.addEventListener("dblclick",function(e){e.preventDefault();},{passive:false});document.head.appendChild(st);}());</script>
<meta name="theme-color" content="#080b11">
<meta name="description" content="Set up your ZeroStick EXO adapter from your phone over Bluetooth. No app to install.">
<title>ZeroStick EXO — connect from your phone</title>
<!-- Installable: on Android this can be added to the home screen and opens
     without browser chrome, which is as close to a native app as this needs
     to be. Web Bluetooth keeps working in a standalone PWA. -->
<link rel="manifest" href="zs-manifest.webmanifest">
<style>
  /* The palette, matching phone.html. Duplicated deliberately and kept short:
     this page must render correctly on the first paint, before any stylesheet
     has loaded, because it is the page somebody opens on mobile data while
     standing next to their console. */
  :root{
    --bg:#080b11; --panel:#0f151e; --panel2:#171f2b; --line:#212b39;
    --text:#e8f0f8; --muted:#8695a8; --accent:#2fd9ce; --accent-ink:#00201d;
    --amber:#e0a33a;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{
    margin:0;min-height:100vh;min-height:100dvh;background:
      radial-gradient(1100px 620px at 50% -12%, #111a25, #080b11 62%);
    color:var(--text);
    font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:calc(32px + env(safe-area-inset-top,0px)) 22px
            calc(32px + env(safe-area-inset-bottom,0px));
    text-align:center;gap:22px;
    -webkit-font-smoothing:antialiased;
  }
  .mark{color:var(--accent);display:flex;justify-content:center}
  h1{margin:0;font-size:26px;line-height:1.12;letter-spacing:-.028em;font-weight:800}
  .sub{margin:0;color:var(--muted);font-size:15px;max-width:32ch}
  .go{
    min-width:230px;padding:16px 26px;border:none;border-radius:15px;
    background:var(--accent);color:var(--accent-ink);
    font:inherit;font-weight:700;font-size:16px;letter-spacing:.004em;
    cursor:pointer;box-shadow:0 6px 22px rgba(47,217,206,.30);
    transition:transform 90ms cubic-bezier(.22,1,.36,1);
  }
  .go:active{transform:scale(.97)}
  .go[disabled]{opacity:.5;box-shadow:none;cursor:default}
  .why{
    color:var(--amber);font-size:14px;max-width:34ch;
    background:rgba(224,163,58,.09);border:1px solid rgba(224,163,58,.32);
    border-radius:13px;padding:14px 16px;text-align:left;
  }
  .why b{color:var(--text)}
  .steps{
    list-style:none;margin:0;padding:0;max-width:33ch;text-align:left;
    display:flex;flex-direction:column;gap:11px;
  }
  .steps li{display:flex;gap:12px;align-items:flex-start;font-size:14.5px;color:var(--muted)}
  .steps b{
    flex:none;width:23px;height:23px;border-radius:50%;margin-top:1px;
    background:var(--panel2);border:1px solid var(--line);color:var(--accent);
    font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;
  }
  .foot{color:#5a6779;font-size:12.5px;max-width:34ch;margin:0}
  .foot a{color:var(--muted)}
  @media (prefers-reduced-motion:reduce){ .go{transition:none} .go:active{transform:none;opacity:.7} }
</style>
</head>
<body>
  <div class="mark" id="mark"></div>
  <h1 id="title">Set up from your phone</h1>
  <p class="sub" id="sub">Connect straight to your ZeroStick over Bluetooth. Nothing to install.</p>

  <div id="action"></div>

  <ol class="steps" id="steps">
    <li><b>1</b><span>Power on the adapter and wait for its light.</span></li>
    <li><b>2</b><span>Tap <b>Connect</b>, then choose <b>ZeroStick EXO</b> when your phone asks.</span></li>
    <li><b>3</b><span>Your configs load, and every change saves straight to the adapter.</span></li>
  </ol>

  <p class="foot" id="foot">
    Bluetooth is for setting up. For playing, and for anything that moves a
    picture — the camera preview, config photos — use the desktop app: a radio
    link is far too slow for images.
  </p>

<script src="zs-mark.js"></script>
<!-- zs-ble.js takes its framing from zs-frame.js (shared with the Core's
     USB link) and refuses to load without it -->
<script src="zs-frame.js"></script>
<script src="zs-ble.js"></script>
<!-- The Core's binary profile (window.ZSPROFILE, D103). This page does not
     save configs, so nothing here calls it; it is loaded so that the mobile
     app ships the same set of files the desktop one does (sync-mobile.js
     cross-checks the two pages' references against its own whitelist). Sets
     one global, reads nothing. -->
<script src="zs-profile-encode.js"></script>
<script>
/* This page's whole job is to answer one question honestly before anybody
   wastes their time: CAN this phone do it?
   Web Bluetooth does not exist on iOS at all — not in Safari and not in
   Chrome, because every iOS browser is WebKit underneath. Showing a Connect
   button there would be a lie, so we show what to do instead. */
(function () {
  'use strict';

  try {
    document.getElementById('mark').innerHTML =
      window.ZSLOGO ? window.ZSLOGO.lockup({ height: 34 }) : 'ZeroStick EXO';
    var ico = document.createElement('link');
    ico.rel = 'icon';
    ico.href = window.ZSLOGO ? window.ZSLOGO.faviconURI() : '';
    document.head.appendChild(ico);
  } catch (e) { /* the headings still say what this is */ }

  var action = document.getElementById('action');

  function offer() {
    action.innerHTML =
      '<button class="go" id="go">Connect over Bluetooth</button>';
    document.getElementById('go').addEventListener('click', function () {
      /* The connect itself happens in phone.html. That is not a detour — a
         GATT link belongs to the page that opened it and would be dropped by
         navigating, so the pairing has to start on the page that keeps it. */
      location.href = 'phone.html?ble=1';
    });
  }

  function refuse(cap) {
    document.getElementById('title').textContent =
      cap.reason === 'noadapter' ? 'Bluetooth is off, or not fitted'
                                 : 'This device can’t use Bluetooth here';
    document.getElementById('sub').textContent = '';
    document.getElementById('steps').style.display = 'none';
    action.innerHTML = '<p class="why">' + cap.message + '</p>';
    document.getElementById('foot').innerHTML =
      cap.reason === 'ios'
        ? 'Everything still works from the <b>desktop app</b> over USB or Wi‑Fi — ' +
          'it has every feature this page would have had.'
        : 'The <b>desktop app</b> connects over USB and Wi‑Fi and has every feature.';
  }

  if (!window.ZSBLE) {
    refuse({ ok: false, reason: 'noscript',
             message: 'The Bluetooth script did not load.' });
    return;
  }

  /* Two questions, asked in order: can this BROWSER do it, and does this
     DEVICE actually have a radio. The second is async and used to be skipped
     — which is how this page came to show a Connect button on a desktop with
     no Bluetooth hardware at all. */
  var sync = window.ZSBLE.supported();
  if (!sync.ok) { refuse(sync); return; }

  action.innerHTML = '<button class="go" disabled>Checking Bluetooth…</button>';
  window.ZSBLE.available().then(function (cap) {
    if (cap.ok) { offer(); } else { refuse(cap); }
  });
})();
</script>
</body>
</html>
