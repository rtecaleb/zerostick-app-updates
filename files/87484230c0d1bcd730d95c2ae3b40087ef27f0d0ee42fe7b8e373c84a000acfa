/* sections/02-play-setup.js — what a config is played WITH and ON.
 *
 * The input type (controller / mouse and keyboard / both: inputSegHTML,
 * setInputType, srcPickKind lives in the kit) and "What you play on" (PLAY_FROM:
 * the platform and the console identity as one choice, playIndex, setPlayFrom).
 * Shared by Overview's Connection panel, the Aim page and the new-config wizard.
 * Profile fields: input, platform, output.console, output.identity.
 *
 * Tests:                      test-input-type.js, test-overview-xim.js, test-core-mode.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('play-setup', function (SEC) {
  /* from the files before this one */
  var esc = SEC.esc, helpHTML = SEC.helpHTML, ZS = SEC.ZS;

  /* ══ WHAT A CONFIG IS PLAYED WITH ═══════════════════════════════════
     Three values now, and the third is why this comment was rewritten.

     `inputType` used to decide only which TUNING sections this app drew. It
     now also decides which KEYBINDS a config shows: a Controller config draws
     no keyboard or mouse rows at all, a Mouse + Keyboard config draws no pad
     rows, and Joystick + Mouse draws both. ZS.inputShows() in phone.html is
     the ONE definition of that rule — this file, the Buttons screen in
     smart-actions.js and the board's schema.split_bindings() all ask it the
     same question about the same device classes.

     HIDING IS NOT DELETING, and nothing here may ever make it so. The
     bindings stay in the profile byte-for-byte; only what is DRAWN changes.
     Go Controller → Mouse + Keyboard → Controller and every pad remap is
     exactly where it was, because no code path on the way writes to
     `bindings` at all. The board keeps storing the hidden ones too, and
     refuses to RUN them, so a bind you cannot see can never fire in a game
     either (docs/DECISIONS.md D32).

     What it still does NOT gate: mouse MOTION, and the pad's own sticks. Two
     generations of that existed and both were worse than none — a
     "Controller" config once silenced a plugged-in mouse (it aimed nothing
     and said nothing), and a "Mouse + Keyboard" config once silenced the
     pad's sticks. Caleb's instruction is that mouse mode opens the mouse
     options, it does not turn the controller off. Pad and mouse are one
     virtual controller (the board sums both into the same stick), so both are
     simply live, always; a resting pad is handled by its rest deadzone, not
     by a gate on another screen. See inputs/manager.py for the whole story. */

  /* The selector itself, so Overview and Aim draw the SAME control and a new
     option can never appear on one and not the other. It is the app's own
     .seg2 — a wrapping flex row, so three buttons need no new CSS and nothing
     to keep in step — and the choice travels in data-v, never in the button's
     words: the words are Caleb's and may be reworded, the wire value may not
     (it is in every profile forever). `sub` is the optional <em> hint seg()
     draws, so this can stand in for a seg() call without losing its line. */
  /* `help` (trailing, optional — screen-map §2): renders the migration essay
     behind a "?" chip under the seg. Only Overview passes it, which is what
     makes the essay have ONE home; nothing else about the control changes,
     so every other caller behaves exactly as it always did. */
  /* D237 (owner, 2026-10-09: "shouldn't we just autodetect what's plugged
     in and show the settings for that"). A config's input type FOLLOWS what
     is plugged in unless the player picked one by hand:
       a pad only                      -> Controller
       a mouse and/or a keyboard only  -> Mouse + Keyboard
       a pad and a mouse               -> Joystick + Mouse
     Nothing plugged in (or not known yet) changes nothing. Whether the
     player chose by hand is the config's own `inputAuto` since the
     2026-10-10 overhaul (M19, below); the switch is written through
     setInputType as a tap on the selector is. */
  function detectedInput(){
    var c = ZS.deviceClasses ? ZS.deviceClasses() : null;
    if(!c) return null;
    var pad = !!c.controller, m = !!c.mouse, k = !!c.keyboard;
    if(pad && m) return 'stick_mouse';
    if(pad) return 'controller';
    if(m || k) return 'mnk';
    return null;
  }
  /* M19 (audit 2026-10-10): WHERE THE "BY HAND" CHOICE LIVES. It lived
     only in this install's store, so the same config on the player's other
     phone or PC (or after a reinstall) was auto again and flipped back what
     they had chosen. It is now IN THE CONFIG, as `inputAuto` (true = follows
     what is plugged in, false = chosen by hand), written with the input
     type itself; both the A7S schema and the Core's SOURCE sidecar keep a
     top-level field they do not know. The store key stays as the answer for
     a config that has no field yet (made before this) and for a choice made
     while the board was away. A tap waiting for its save wins over both. */
  var autoPending = {};          /* config id -> the choice a save is carrying */
  function inputAuto(p){
    if(!p) return true;
    if(Object.prototype.hasOwnProperty.call(autoPending, p.id)) return autoPending[p.id];
    var doc = ZS.live && ZS.live.full && ZS.live.full[p.id];
    if(doc && typeof doc.inputAuto === 'boolean') return doc.inputAuto;
    return !(ZS.store && ZS.store.vals && ZS.store.vals['inputManual|'+p.id] === '1');
  }
  function setInputAuto(p, on){
    if(!ZS.store || !ZS.store.vals) return;
    if(on) delete ZS.store.vals['inputManual|'+p.id];
    else ZS.store.vals['inputManual|'+p.id] = '1';
    if(ZS.persistStore) ZS.persistStore();
  }
  /* one pass: the active config and the one open in the editor follow the
     devices, once what is plugged in has held still for a moment (a pad
     arrives as several nodes; a replug blinks).
     M20 (audit 2026-10-10): LOSING a device waits longer (5 s) than gaining
     one (1.5 s), so a wireless mouse dozing off or a replug does not flip a
     config and cost a config write each way; and a pass never closes what
     the player has open: while a sheet is up it waits and looks again. */
  var AUTO_GAIN_MS = 1500, AUTO_LOSS_MS = 5000, AUTO_SHEET_MS = 2000;
  var autoSeen = null, autoTimer = null;
  function inputHas(v){
    return { pad: v==='controller' || v==='stick_mouse', mouse: v==='mnk' || v==='stick_mouse' };
  }
  function autoLoses(from, to){
    if(!from || !to) return false;
    var a = inputHas(from), b = inputHas(to);
    return (a.pad && !b.pad) || (a.mouse && !b.mouse);
  }
  function sheetIsOpen(){
    var w = document.getElementById('sheetwrap');
    return !!(w && w.classList && w.classList.contains('open'));
  }
  function autoApplyAll(d){
    if(sheetIsOpen()){
      clearTimeout(autoTimer); autoTimer = setTimeout(autoInputPass, AUTO_SHEET_MS); return;
    }
    [ZS.activeId, ZS.editId].forEach(function(id, i, all){
      if(!id || all.indexOf(id) !== i) return;
      var p = ZS.prof && ZS.prof(id);
      /* D470: a Native Mouse & Keyboard config never follows what is plugged in */
      if(p && !p.unreadable && inputAuto(p) && !nativeOn(p) && p.input !== d) setInputType(p, d, {auto:true});
    });
  }
  function autoInputPass(){
    if(window.ZS_NO_AUTOINPUT) return;     /* the test harness's switch */
    var d = detectedInput();
    if(d !== autoSeen){
      var wait = autoLoses(autoSeen, d) ? AUTO_LOSS_MS : AUTO_GAIN_MS;
      autoSeen = d; clearTimeout(autoTimer); autoTimer = setTimeout(autoInputPass, wait); return;
    }
    if(!d) return;
    autoApplyAll(d);
  }
  /* devbar.js loads AFTER the sections (phone.html), so the hook is taken
     when it exists, not at load (D239: this is why auto-detect never ran) */
  (function hook(){
    if(ZS.onDevicesChange){ ZS.onDevicesChange(autoInputPass); autoInputPass(); return; }
    setTimeout(hook, 300);
  })();
  /* opening a config applies what is plugged in at once, without the wait */
  ZS.autoInputNow = function(){
    if(window.ZS_NO_AUTOINPUT) return;
    var d = detectedInput();
    if(!d) return;
    autoSeen = d;
    autoApplyAll(d);
  };
  ZS.detectedInput = detectedInput;
  ZS.inputAuto = inputAuto;

  /* D470 rule A: Native Mouse & Keyboard (native-kbm.js) is a KIND of
     config, fixed when it is made (the wizard's red answer), never a choice
     here. A native config shows no overrides at all, only that it is
     native; a controller config keeps Auto and the three types, and under
     them a row that opens the wizard with the red answer lit. */
  function nativeOn(p){ return !!(window.ZSNATIVE && ZSNATIVE.on(p)); }
  function inputSegHTML(p, sub, help){
    if(nativeOn(p)){
      return '<div class="fld col"><div class="flab">What you play with'+
             (sub?'<em>'+esc(sub)+'</em>':'')+'</div>'+ZSNATIVE.deviceRowHTML(p)+'</div>';
    }
    var opts = ZS.INPUT_TYPES, i, h = '', auto = inputAuto(p), det = detectedInput();
    /* D237: Auto first, and on unless the player chose by hand */
    h += '<button data-v="auto"'+(auto?' class="on"':'')+'>Auto'+
         (auto && det ? ' · '+esc(ZS.INP[det]) : '')+'</button>';
    for(i=0;i<opts.length;i++){
      h += '<button data-v="'+esc(opts[i])+'"'+(!auto && p.input===opts[i]?' class="on"':'')+'>'+
           esc(ZS.INP[opts[i]])+'</button>';
    }
    return '<div class="fld col"><div class="flab">What you play with'+
           (sub?'<em>'+esc(sub)+'</em>':'')+'</div>'+
           '<div class="seg2 inputseg" data-nosave="1">'+h+'</div>'+
           (window.ZSNATIVE ? ZSNATIVE.deviceRowHTML(p) : '')+'</div>'+
           (help ? helpHTML('ov-input', 'What you play with', inputWhatText(p)) : '');
  }
  /* What the CURRENT choice shows and hides, in Caleb's words. This is the
     answer to "where did my keyboard rows go?" — and it is the only place
     the app promises out loud that a hidden bind is still saved. Without
     that sentence, hiding and deleting look identical from the outside. It
     lives behind Overview's "?" chip now (rule 4: the promise is reference,
     not feedback), but the words are unchanged. */
  function inputWhatText(p){
    var pad = ZS.inputShows(p.input,'controller'), mk = ZS.inputShows(p.input,'mouse');
    if(pad && mk)
      return '<b>Joystick + Mouse</b> — the <b>Buttons</b> screen shows everything: every pad '+
             'button and every key and mouse button. Mouse aim tuning and stick tuning are both '+
             'on the <b>Aim</b> screen.';
    if(pad)
      return '<b>Controller</b> — the <b>Buttons</b> screen shows your pad only. Keyboard and '+
             'mouse binds are <b>hidden and cannot be edited</b> here, and your board will not '+
             'run them. They are <b>still saved</b>, and every one of them comes back the moment '+
             'you pick <b>Joystick + Mouse</b>.';
    return '<b>Mouse + Keyboard</b> — the <b>Buttons</b> screen shows your keys and mouse buttons '+
           'only. Pad remaps are <b>hidden and cannot be edited</b> here, and your board will not '+
           'run them. They are <b>still saved</b>, and come back the moment you pick '+
           '<b>Joystick + Mouse</b>. A plugged-in controller <b>still works</b> — its buttons do '+
           'what they say on the pad.';
  }
  function wireInputSeg(root, p){
    var seg = root.querySelector('.inputseg');
    if(!seg) return;
    seg.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){
        /* D237: Auto hands the choice back to what is plugged in */
        if(b.dataset.v === 'auto'){
          setInputAuto(p, true);
          var d = detectedInput();
          setInputType(p, (d && d !== p.input) ? d : p.input, {manual:false});
          return;
        }
        setInputAuto(p, false);
        setInputType(p, b.dataset.v, {manual:true});
      });
    });
    /* D470: "Native Mouse & Keyboard is chosen when you make a profile" */
    var nb = root.querySelector('#nk-make');
    if(nb) nb.addEventListener('click', function(){ if(ZS.newConfigNative) ZS.newConfigNative(); });
  }


  /* ── "What you play on" ───────────────────────────────────────────
     ONE control over the two fields that decide where the inputs go: the
     config's console (glyphs, translator defaults) and its output backend
     (the actual wire). They were never choosable together — platform only in
     the new-config wizard, backend only on a screen that is no longer in the
     menu — so a config could not be re-pointed at a different console at all.
     Each row is a real, implemented path; nothing here advertises a backend
     the schema would refuse (profiles/schema.OUTPUT_BACKENDS). */
  /* WHERE you play — the platform, and nothing else. "PC — keyboard & mouse"
     was briefly a fifth row here and it was the wrong shape: becoming a
     keyboard and mouse is not a platform, it is a temporary mode Passthrough Mode
     switches you into and out of. WHAT you play WITH is the separate Inputs
     control below. */
  /* The wired rows are named after what the adapter IS on that console
     (D93, 2026-09-08): P5General is the Besavior donor the PS5 path signs in
     through (proven on a PS5 that night). Xbox is the same adapter with the
     player's own Xbox controller as the donor, proven on an Xbox on
     2026-09-30 (D157/D158: the Core picks the Pico's mode from the config's
     console, and the donor's buttons go through the Core). PS4 is never
     set: GP2040's PS4 mode can sign with a key file, which is computing an
     auth answer (CLAUDE.md rule 6), so the Core sends nothing for it and the
     Pico refuses it (D157). M12 (audit 2026-10-10): its row is gated
     (ps4Wired) so a Core does not offer it; "ps4" stays in the board's
     CONSOLES so an old config still reads. */
  var PLAY_FROM = [
    /* `feature` names the row in the product gate (phone.html PRODUCTS,
       D102). A row whose feature the product lacks is not offered at all
       (PS4 on a Core), UNLESS it is `soon` (D286): then it is offered for
       its SETUP only — the player can step onto it and do the steps, but it
       never becomes the config's way of playing until the product can run
       it (playSoon). Rows without a feature are every product's. */
    /* `pic` (owner, 2026-10-10): the logo the owner chose for each way of
       playing, in brand/consoles/. A pair {light, dark} is a line icon that
       needs a dark ink on the light theme and a light ink on the dark one.
       PS4 has none yet: it keeps the plug. */
    /* D286 (owner, 2026-10-13): "as a connection method you need to add PS5
       Remote Play, NOT RECOMMENDED but works". The recommended rows come
       first and Remote Play is LAST, with `notRec` naming why it is not
       recommended wherever the row is drawn. */
    /* D399 (owner, 2026-10-16): the PS5 row is called PlayStation 5, with
       the dongle it needs on a small second line (`sub`, drawn under the
       name wherever the row is), and wears the PlayStation mark instead of
       a photo of the P5General. Its id (platform ps5, backend pico) is
       unchanged, so every PS5 config still lands on it. */
    {t:'PlayStation 5',   sub:'P5General dongle needed', platform:'ps5', backend:'pico',
      pic:{light:'brand/consoles/playstation-ink-dark.webp', dark:'brand/consoles/playstation-ink-light.webp'}},
    {t:'Xbox',            platform:'xbox', backend:'pico', pic:'brand/consoles/xbox.webp'},
    {t:'PS4',             platform:'ps4',  backend:'pico', feature:'ps4Wired'},
    {t:'PC',              platform:'pc',   backend:'xinput', pic:'brand/consoles/pc.webp'},
    /* D349 (Zen Studio parity): the Pico's other stock no-auth modes, and
       Mirror (follow the pad's own family; pico_mode.h has the rule). Core
       only (moreOutputs): the A7S agent has no such Pico switch. Xbox 360
       wears the Xbox mark; Mirror has no logo and keeps the plug.
       D399: Nintendo Switch 2 is its own console value ("switch2") that the
       Core plays exactly as Switch (the same Pico Switch mode). Newest
       Nintendo first, then the Switch, PS3 and Xbox 360. The Switch,
       Switch 2 and PS3 marks are the official logos from Wikimedia Commons
       (brand/consoles/SOURCES.md), a dark and a light ink each. */
    {t:'Nintendo Switch 2', platform:'switch2', backend:'pico', feature:'moreOutputs',
      pic:{light:'brand/consoles/switch2-ink-dark.webp', dark:'brand/consoles/switch2-ink-light.webp'}},
    {t:'Nintendo Switch', platform:'switch', backend:'pico', feature:'moreOutputs',
      pic:{light:'brand/consoles/switch-ink-dark.webp', dark:'brand/consoles/switch-ink-light.webp'}},
    {t:'PS3',             platform:'ps3',    backend:'pico', feature:'moreOutputs',
      pic:{light:'brand/consoles/ps3-ink-dark.webp', dark:'brand/consoles/ps3-ink-light.webp'}},
    {t:'Xbox 360',        platform:'x360',   backend:'pico', feature:'moreOutputs', pic:'brand/consoles/xbox.webp'},
    {t:'Mirror',          platform:'mirror', backend:'pico', feature:'moreOutputs'},
    {t:'PS5 Remote Play', platform:'ps5',  backend:'remoteplay', feature:'remotePlay', soon:true,
      notRec:'Not recommended — works, but adds delay',
      pic:{light:'brand/consoles/ps5-remote-play-ink-dark.webp', dark:'brand/consoles/ps5-remote-play-ink-light.webp'}}
  ];
  /* where the Remote Play row is, so nothing has to know its position */
  var RP_ROW = (function(){
    for(var i=0;i<PLAY_FROM.length;i++) if(PLAY_FROM[i].backend==='remoteplay') return i;
    return -1;
  })();
  /* a way of playing's logo at `px`, or '' when it has none (decorative:
     the row's words always name it). The light/dark pair is switched by
     CSS on body.zs-light, so a theme change needs no redraw. */
  function consolePic(row, px){
    var pc = row && row.pic;
    if(!pc) return '';
    var one = function(src, cls){
      return '<img class="cpic'+(cls?' '+cls:'')+'" src="'+src+'" width="'+px+'" height="'+px+'" alt="" aria-hidden="true">';
    };
    return typeof pc === 'string' ? one(pc, '') : one(pc.dark, 'cpic-d') + one(pc.light, 'cpic-l');
  }
  function lacksFeature(i){
    var o = PLAY_FROM[i];
    return !!(o && o.feature && ZS.productHides && ZS.productHides(o.feature));
  }
  /* is this row one the product on the other end does not have at all? */
  function playHidden(i){
    return lacksFeature(i) && !PLAY_FROM[i].soon;
  }
  /* D286: a row the product cannot RUN yet but whose setup it offers (PS5
     Remote Play on a Core): listed, steppable, never the config's way of
     playing (playIndex skips it, setPlayFrom refuses it) */
  function playSoon(i){
    return lacksFeature(i) && !!PLAY_FROM[i].soon;
  }
  /* the neighbour the carousel's ‹ › lands on: the next row in `dir` that the
     product lists (a `soon` row included), or -1 at the end. Indexes stay
     PLAY_FROM's own, so PLAY_WHY and PLAY_PRESENTS keep lining up by
     position. */
  function playStep(idx, dir){
    for(var i = idx + dir; i >= 0 && i < PLAY_FROM.length; i += dir){
      if(!playHidden(i)) return i;
    }
    return -1;
  }
  var PLAY_WHY = [
    '<b>PlayStation 5</b> (with the <b>P5General</b> dongle) — the board feeds the RP2040, which '+
    'plugs into the PS5 with the Besavior P5General as the donor that answers the console’s '+
    'authentication. Wired, the lowest delay of the PlayStation paths, and proven on a PS5 on '+
    '2026-09-08. The P5General comes in the box with every ZeroStick that plays on a PS5.',
    '<b>Xbox</b> — the same wired adapter, with your own Xbox Series or One controller plugged '+
    'into it as the donor that answers the console’s sign-in. Its buttons go through ZeroStick '+
    'too, so your scripts and remaps apply to it.',
    '<b>PS4</b> — not supported. The PS4’s wired mode would mean the adapter answering the '+
    'console’s sign-in itself, and ZeroStick only ever lets a real controller answer it.',
    '<b>PC</b> — the board shows up to Windows as an Xbox 360 controller. Nothing to '+
    'authenticate, so it is the simplest and quickest path, and the one to test feel on. '+
    'Turn on Passthrough Mode and it becomes a keyboard and mouse instead, so one set of '+
    'peripherals drives both.',
    /* D399 */
    '<b>Nintendo Switch 2</b> — the same wired Switch controller mode as the Nintendo Switch row: '+
    'the Switch 2 takes Nintendo Switch controllers, including wired ones, so no donor is needed. '+
    'Plug the adapter into the dock’s USB port. Rumble, motion controls and the Switch 2’s own '+
    'new buttons are not carried on this path. Not yet tested on a Switch 2.',
    /* D349 */
    '<b>Nintendo Switch</b> — the wired adapter shows up to the Switch as a wired controller. '+
    'The Switch asks nothing of a wired pad to sign in, so no donor is needed: plug the adapter '+
    'into the dock’s USB port. Rumble and motion controls are not carried on this path.',
    '<b>PS3</b> — the wired adapter shows up to a PlayStation 3 as a wired controller. The PS3 '+
    'asks nothing of a wired pad to sign in, so no donor is needed. Rumble and motion controls '+
    'are not carried on this path.',
    '<b>Xbox 360</b> — the wired adapter shows up as a wired Xbox 360 controller. '+
    '<b>Xbox 360 output: for PCs and devices that accept a 360 pad.</b> An Xbox 360 console itself '+
    'needs a licensed controller’s authentication, which this mode does not do — ZeroStick never '+
    'answers a console’s sign-in itself.',
    '<b>Mirror</b> — the adapter becomes whatever your controller is. A <b>DualSense or DualShock 4</b> '+
    'plays on the <b>PlayStation 5</b> path with the P5General (never PS4: that would mean the adapter answering the '+
    'PS4’s sign-in itself), an <b>Xbox One or Series</b> controller on the <b>Xbox</b> path, an '+
    '<b>Xbox 360</b> pad as Xbox 360, a <b>Switch Pro</b> as Nintendo Switch, a <b>DualShock 3</b> as '+
    'PS3, and anything else (another pad, or only a keyboard and mouse) as <b>PC</b>. Plugging in a '+
    'controller of a different kind restarts the adapter in that mode (about a second); unplugging '+
    'keeps the mode. The PS5 and Xbox paths still need their donor plugged into the adapter.',
    /* D286: the last row, and honest about why */
    '<b>PS5 Remote Play</b> — <b>not recommended, but it works.</b> Your adapter connects to '+
    'your PS5 over your home network the way the PlayStation Remote Play app does, signed in '+
    'as your own PlayStation account, and sends your inputs into that session. No cable to the '+
    'console and no P5General needed, but Remote Play adds its own delay on top of everything '+
    'the adapter does, and it depends on your network. For the quickest PS5 path use '+
    '<b>PlayStation 5</b> with the P5General.'
  ];
  function playIndex(p, full){
    var be = (full && full.output && full.output.backend) || '';
    var i;
    for(i=0;i<PLAY_FROM.length;i++){
      /* a row this product has not got, or can only set up (D286) */
      if(playHidden(i) || playSoon(i)) continue;
      if(PLAY_FROM[i].platform===p.platform && PLAY_FROM[i].backend===be) return i;
    }
    /* Backend not one of the four (an older config, or a hand-set backend):
       fall back to the row that at least matches the console, so the strip
       never lights nothing and a tap still means what it says. */
    for(i=0;i<PLAY_FROM.length;i++){
      if(playHidden(i) || playSoon(i)) continue;
      if(PLAY_FROM[i].platform===p.platform) return i;
    }
    for(i=0;i<PLAY_FROM.length;i++) if(PLAY_FROM[i].platform==='pc') return i;
    return 0;
  }
  /* Writes BOTH fields, because they are one decision. The console changes
     which glyphs the app draws, so the open screen is redrawn after.
     m5 (audit 2026-10-10): the local platform used to change even when the
     board refused or was away, and nothing replayed it, so the app showed a
     console the board (which picks the Pico's mode from it, D157) was not
     set to. Now it changes only with the board: shown at once, put back if
     the save is refused. Offline it is not changed at all. It still saves
     at once rather than waiting for Save (a D257 exception for the owner to
     confirm: docs/overhaul/app-sections.md). */
  function setPlayFrom(p, idx){
    var o = PLAY_FROM[idx];
    if(!o) return;
    /* D286: never point a config at a way of playing the adapter cannot run
       — on a Core that would stop sending to the console. Its setup opens
       instead (Overview's panel shows the row and the door). */
    if(playSoon(idx)) return;
    if(!(ZS.live.online!==false && ZS.live.full[p.id])){
      ZS.toast('Your board is offline — connect it to change where you play');
      return;
    }
    var was = p.platform;
    p.platform = o.platform;
    ZS.putProfile(p.id, function(f){
      f.console = o.platform;
      if(!f.output) f.output = {};
      f.output.backend = o.backend;
    }).then(function(j){
      if(j && j.ok){ ZS.toast('Now playing from '+o.t); return; }
      /* the refusal was already said by the save itself (putProfile /
         the Core's save); this only puts the screen back */
      if(p.platform === o.platform){
        p.platform = was;
        ZS.saveProfiles();
        ZS.redrawOpenScreen();
      }
    });
    ZS.saveProfiles();
    ZS.redrawOpenScreen();
  }

  /* opt.auto   a switch auto-detect made (M20): it saves at once (the
               board must run the binds for what is plugged in, so this is
               a deliberate exception to D257's Save key, and it never
               touches the queue: a fresh board copy keeps staged edits on
               top, adoptBoard), and it closes nothing the player has open
     opt.manual true/false: a tap on the selector, which also records in
               the config whether the type is chosen by hand (M19)        */
  function setInputType(p, v, opt){
    opt = opt || {};
    /* D470 rule B: a Native Mouse & Keyboard config's controller side
       (inputType, inputAuto, Turn assist) is never written, by a tap, by
       auto-detect or by anything else that comes through here */
    if(nativeOn(p)) return;
    var flag = (typeof opt.manual === 'boolean') ? !opt.manual : null;   /* the inputAuto to record */
    var doc = ZS.live.full[p.id];
    var flagChanges = flag !== null && !(doc && doc.inputAuto === flag);
    if(p.input===v && !flagChanges){ if(flag !== null) ZS.redrawOpenScreen(); return; }
    var typeChanges = p.input !== v;
    p.input = v;
    if(ZS.live.online!==false && doc){
      if(flag !== null) autoPending[p.id] = flag;
      ZS.putProfile(p.id, function(f){
        f.inputType = v;
        if(flag !== null) f.inputAuto = flag;
        /* D280: a config that now has a mouse gets Turn assist on X, the
           first time and only where X is free */
        if(window.ZS_SMART && typeof ZS_SMART.seedTurnAssist === 'function') ZS_SMART.seedTurnAssist(p, f);
      }).then(function(){ delete autoPending[p.id]; }, function(){ delete autoPending[p.id]; });
    } else if(typeChanges) {
      ZS.toast('Your board is offline \u2014 this switch has not reached it yet');
    }
    if(!typeChanges){ ZS.redrawOpenScreen(); return; }
    /* A sheet open on a bind this switch is about to hide would otherwise sit
       there over a screen that no longer lists it, still writing to a row the
       user can no longer reach. Close it BEFORE the redraw, not after. An
       automatic switch never gets here with a sheet open (autoApplyAll waits
       for it to close), so this only ever closes on the player's own tap. */
    if(!opt.auto && ZS.sheetClose) ZS.sheetClose();
    ZS.saveProfiles();                       /* persists PROFILES + redraws home */
    if(ZS.editId===p.id) ZS.openEditor(p.id); /* section list is gated on input */
    ZS.redrawOpenScreen();
  }

  /* what the other screen files use from this one */
  SEC.PLAY_FROM = PLAY_FROM;
  SEC.consolePic = consolePic;
  SEC.PLAY_WHY = PLAY_WHY;
  SEC.inputSegHTML = inputSegHTML;
  SEC.playHidden = playHidden;
  SEC.playSoon = playSoon;
  SEC.RP_ROW = RP_ROW;
  SEC.playIndex = playIndex;
  SEC.playStep = playStep;
  SEC.setPlayFrom = setPlayFrom;
  SEC.wireInputSeg = wireInputSeg;
});
