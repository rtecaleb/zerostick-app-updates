           sends a whole new picture over a link that carries about 90 KB a
           second, so the next is asked for after CORE_SHOT_GAP, not 33 ms. */
        nextFrame(coreShot ? CORE_SHOT_GAP : 33);
      });
      im.addEventListener('error', function(){
        framePend = false;
        imgOk = false;
        paint();
        nextFrame(900);
      });
    }

    /* ── switching the picture off, and back on ──────────────────────
       Two halves, and they are not the same half:
         1. this app stops ASKING for frames. Instant, ours alone, and it
            happens before any reply comes back;
         2. the adapter is told to stop MAKING them. That is the half that
            hands the time to the target-finding, and it can fail.
       If the second half fails the first still stands and the screen says so,
       because a switch that quietly does nothing is worse than no switch. */

    /* The board is the truth. Called on every status answer, so a picture
       switched off on another phone — or by the adapter restarting — shows up
       here without anybody tapping anything. The local echo wins only while a
       change of ours is in flight, otherwise a status reply that was sent
       before the board applied it flicks the switch back under the finger. */
    function adoptPreview(){
      if(picBusy || !st) return;
      var first = !picKnown;          /* the first answer starts the poller */
      var q = st.preview;
      var was = pic.enabled;
      /* An adapter that reports `enabled` is one that understands these
         settings, so everything it says about them is the truth. An older one
         still reports a `width` — the width its encoder happens to be using —
         and adopting THAT would drag the size choice back to 640 a third of a
         second after it was made, even though on those adapters the width in
         the frame request is what actually decides. Seed from it once, then
         leave the choice alone. Measured against the real board on
         2026-08-10, which reports {encoder, pilAvailable, lastEncodeMs,
         width} and nothing else. */
      var newish = !!(q && typeof q.enabled === 'boolean');
      if(q && typeof q === 'object'){
        if(newish){ pic.enabled = q.enabled; picOld = false; }
        if(newish || first){
