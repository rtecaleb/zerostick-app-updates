    /* ── one pointer story for finger and mouse ─────────────────────
       Pointer events where they exist (every phone browser this app runs in,
       and the packaged exe), mouse + touch where they do not. The gesture is
       tracked on the DOCUMENT once it starts, not on the box, so dragging a
       corner past the edge of the picture keeps working instead of dropping
       the moment the finger leaves the element it started on. */
    var HASP = !!window.PointerEvent;
    function ptOf(e){
      var t = (e.touches && e.touches[0]) ||
              (e.changedTouches && e.changedTouches[0]) || e;
      return {cx:t.clientX, cy:t.clientY};
    }
    /* where in the PICTURE the finger is, 0..1, clamped */
    function normOf(e){
      var r = stage.getBoundingClientRect();
      if(!r.width || !r.height) return null;
      var pt = ptOf(e);
      return {x: cv01((pt.cx - r.left) / r.width),
              y: cv01((pt.cy - r.top) / r.height),
              cx: pt.cx, cy: pt.cy};
    }

    /* A TAP on the picture. Left as a plain click listener, not folded into
