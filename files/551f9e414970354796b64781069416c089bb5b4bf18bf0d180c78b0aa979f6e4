    /* Bind the door to a freshly-opened sheet body. wire() ran long before
       this body existed, so everything — including the accordions — is
       wired here. The element vars are re-assigned on every open; the state
       stays in the enclosing closure. */
    function bindPackDoor(body){
      pkBody   = body;
      pkBlankEl= body.querySelector('#cv-blank');
      pkList   = body.querySelector('#cv-pklist');
      pkErrEl  = body.querySelector('#cv-pkerr');
      pkNameEl = body.querySelector('#cv-pkname');
      pkSaveEl = body.querySelector('#cv-pksave');
      pkReplace = ''; pkDelArm = '';
      if(pkSaveEl) pkSaveEl.addEventListener('click', pkDoSave);
      if(pkNameEl) pkNameEl.addEventListener('keydown', function(e){
        if(e.key !== 'Enter') return;
        e.preventDefault();          /* don't submit anything enclosing */
        pkDoSave();
      });
      /* Typing a different name takes Replace back off the button, so it can
         never write over a pack the user has stopped naming. */
      if(pkNameEl) pkNameEl.addEventListener('input', function(){
        if(pkReplace){ pkDisarm(); pkSay(''); }
