    }
    return '<div class="'+cls+'"'+(ghost?'':' data-ri="'+i+'"')+
      ' style="left:'+cvPct(q[0])+';top:'+cvPct(q[1])+';width:'+cvPct(q[2])+
      ';height:'+cvPct(q[3])+'">'+tag+handles+'</div>';
  }

  /* The state line: the BRAND'S RETICLE, a headline, and a sentence with no
     jargon in it. The reticle is the crosshair from the logo doing its actual
     job — idle when nothing is watched, rotating while the detector hunts,
     ring closed with the centre dot when a target is held (zs-mark.js
     reticle(); the states are built and colour-independent, and reduced
     motion swaps the spin for a breathe via zs-brand.css). The generic
     coloured dot it replaces survives only as the fallback for a build that
     ships without zs-mark.js.

     NEVER MOTION ALONE: the headline and sentence beside it say the same
     thing in words ("Not watching your screen yet" / "Watching" / "Target
     seen"), and the reticle itself carries an aria-label naming its state.

     Poll-safety is the caller's put(): identical state = identical HTML =
     the node is left alone and the scanning loop runs on across polls; a
     state flip recreates the node, which is exactly what fires the built
     .zs-ret-lock dot pop at the true acquisition moment. */
  function cvSayCard(s, ret){
    var col = s.t==='good' ? 'var(--green)' : s.t==='warn' ? 'var(--amber)'
            : s.t==='ok'   ? 'var(--accent)' : 'var(--grey)';
    var mark;
    if(window.ZSLOGO && ZSLOGO.reticle){
      var rWord = ret==='locked' ? 'target held' : ret==='scanning' ? 'scanning' : 'idle';
      mark = '<span style="flex:none;margin-top:1px">'+
        ZSLOGO.reticle({size:22, state:(ret||'idle'), label:'reticle — '+rWord})+'</span>';
    } else {
      mark = '<span style="flex:none;width:11px;height:11px;border-radius:50%;margin-top:4px;'+
        'background:'+col+';box-shadow:0 0 0 4px '+
        (s.t==='good'?'rgba(63,185,80,.16)':s.t==='warn'?'rgba(210,153,34,.16)':
         s.t==='ok'?'rgba(88,166,255,.14)':'transparent')+'"></span>';
    }
    return '<div class="vizbox" style="padding:13px 14px;display:flex;gap:11px;'+
        'align-items:flex-start;text-align:left">'+
      mark+
      '<span style="min-width:0"><b style="display:block;font-size:15px;'+
        'font-weight:700">'+esc(s.h)+'</b>'+
      '<span style="display:block;color:var(--muted);font-size:12.5px;'+
        'line-height:1.5;margin-top:3px">'+esc(s.s)+'</span></span></div>'+
      (s.q && ZS.helpHTML ? ZS.helpHTML('cv-state-'+s.t, s.h, esc(s.s+' '+s.q)) : '');
  }

  /* The four rungs Caleb asked for. The last one is NOT hard-coded either way:
     it reads whatever the board reports about its aim step. A board that has
     no aim step says so and the rung stays grey; a board that has one gets to
     light it. The app never claims an ability on the board's behalf. */
  function cvRungs(reached, assist){
    var known = !!assist;
    var rows = [['Capture card','something is plugged in'],
                ['Watching','a picture is coming in'],
                ['Target seen','it found your colour'],
                ['Aim help', !known ? 'your adapter isn’t reporting this'
                   : assist.killed ? 'your board switched it off after a problem'
                   : assist.enabled === false ? 'your board has it, switched off'
                   : assist.active ? 'nudging your aim now'
                   : 'ready, not nudging right now']];
    return '<div class="vizbox" style="padding:12px 14px">'+
      rows.map(function(r, i){
        var last = (i === 3);
        var on = last ? !!(known && assist.active) : (i < reached);
        var col = (last && !known) ? 'var(--grey)' : (on ? 'var(--green)' : 'var(--muted)');
        return '<div style="display:flex;align-items:flex-start;gap:10px;'+
            (i?'margin-top:9px':'')+'">'+
          '<span style="flex:none;width:16px;height:16px;border-radius:50%;margin-top:1px;'+
            'border:2px solid '+col+';background:'+(on?'var(--green)':'transparent')+
            ';box-shadow:'+(on?'0 0 0 3px rgba(63,185,80,.16)':'none')+'"></span>'+
          '<span style="min-width:0"><b style="font-size:13.5px;font-weight:600;color:'+
            ((last&&!known)?'var(--grey)':(on?'var(--text)':'var(--muted)'))+'">'+esc(r[0])+'</b>'+
          '<em style="display:block;font-style:normal;font-size:11.5px;color:var(--muted);'+
            'margin-top:1px">'+esc(r[1])+'</em></span></div>';
      }).join('')+'</div>';
  }

  /* ── THE RELEASE-TIMING CONTROL'S MEASURED CONSTANTS ──────────────────
     One knob: profile.vision.shotAssist.aimOffsetMs, in milliseconds, 1:1
     with the wall clock. predict.py:1164 builds the release instant as

         deadline = t_cross - lat / 1000.0 + cfg.aim_offset_ms / 1000.0

     and `deadline` is an ABSOLUTE instant on the monotonic clock, so adding a
     bigger number moves the release FURTHER INTO THE FUTURE. +20 lets go
     20 ms LATER (a longer arrow), -20 lets go 20 ms EARLIER. Thumb right =
     later. That sign is pinned on the board by
     test_the_aim_offset_is_a_separate_signed_nudge, and it must never be
     inverted anywhere in this chain.

     THE USER-FACING MAPPING IS THE OPPOSITE OF THAT SIGN, which is why it is
     printed on the card in 2K's own two phrases rather than left for anyone
     to derive: 2K says "Slightly LATE" -> he let go too late -> he needs
     EARLIER -> minus. 2K says "Slightly EARLY" -> plus.

     RT_STEP is 5 ms and it is not a guess. docs/reference/nba2k26/README.md
     measures 2K26's arrow at 242 px/s over a 95 px span and concludes in as
     many words: "the release-timing control needs steps of about 5 ms —
     anything coarser cannot address the inside of the window at all — and
     +-100 ms of trim is the right range: 2.7 window widths either side".
     Cross-checked against the other estimate in the tree (predict.py:155-158,
     ~300-330 ms of fill on fast/contested shots): the green window is 28.5 ms
     at the fast end and 37.3 ms at the slow one, so one 5 ms nudge is between
     a fifth and a seventh of the window either way. The step survives the
     disagreement between the two measurements, which is why it is the number
     we ship, and from dead centre it takes 3-4 notches to walk from the
     middle of the green to its edge — one notch can never throw a shot from
     inside the window to outside it.

     A 1 ms step - which is what this control had until now, because slider()
     emits no step attribute and HTML defaults it to 1 - moves the release by
     a quarter of a pixel of arrow. That is under the meter reader's own
     1.17 px mean error and under the output leg's measured fire sigma of
     1.8 ms: 201 detents of which ~190 are indistinguishable from their
     neighbours.

     RT_WINDOW_MS is the FALLBACK only. The board publishes the real number as
     shotAssist.shot.plan.windowMs on any ok plan and rtPaint prefers it — the
     window really is narrower on a contested pull-up than on a set shot, and
     a picture that pretended otherwise would be lying quietly. While the
     fallback is in use the label says "about", and it never says anything
     else.                                                                  */
  var RT_STEP      = 5;      /* ms per nudge                                */
  /* predict.SHOT_NUMS' own aimOffsetMs bound, and it is +-300 rather than
     +-100 because ONLINE PLAY IS A DIFFERENT RIG, not a fine adjustment to
     this one: 2K's servers add delay on top of the capture-and-output chain
     the trim was measured against, and at +-100 the owner ran out of range
     with every shot still landing late. At 5 ms a nudge that is 120 detents
     end to end, which is why the +/- keys are not the only way in — the value
     is tap-to-type and the track drags coarsely. */
  var RT_LIMIT     = 300;
  /* ── MEASURE MY DELAY (D90) — the numbers the one-tap measurement sends ──
     The board's D89 contract bounds presses to 1..20 and gapMs to 500..5000;
     eight presses a second and a half apart is the plan's own recipe (§5b
     step 1 asked for eight, ten seconds apart, on the PC; a phone tap gets
     the same eight, closer together, because nobody is typing between
     them). The poll is the recorder's 250 ms. MD_DEFAULT_MS is the number
     the schema ships in every profile (profiles/schema.py, `latencyMs: 90`)
     and the 2K pack ships the same, so a config still on it has "the
     default guess" and nothing more — the delay line says exactly that. */
  var MD_PRESSES    = 8;
  var MD_GAP_MS     = 1500;
  var MD_POLL_MS    = 250;
  var MD_DEFAULT_MS = 90;
  /* the output path in words, from the status's `backend` — the two paths
     the plan compares, and an honest generic for anything else */
  function mdPathWords(be){
    be = String(be == null ? '' : be);
    if(be === 'remoteplay') return 'over Remote Play';
    if(be === 'pico') return 'over the USB adapter';
    if(!be) return '';
    return 'over the '+be+' output';
  }
  function mdToday(){
    var d = new Date();
    function two(n){ return (n < 10 ? '0' : '')+n; }
    return d.getFullYear()+'-'+two(d.getMonth()+1)+'-'+two(d.getDate());
  }
  var RT_WINDOW_MS = 35;     /* fallback green-window width, 28.5..37.3     */
  var RT_X0 = 20, RT_XW = 260;          /* the ruler, in SVG units          */
  function rtX(ms){
    var c = Math.max(-RT_LIMIT, Math.min(RT_LIMIT, ms));
    return RT_X0 + (c + RT_LIMIT) / (2 * RT_LIMIT) * RT_XW;
  }
  /* the sentence the value is READ as — never a bare signed number, on the
     card or in the screen reader. "+20" and "20" are the same string once a
     minus sign has been dropped by a font, a screen reader or a squint. */
  function rtSay(v){
    return v === 0 ? 'right when it computed'
         : (v > 0 ? v + ' ms later' : (-v) + ' ms earlier');
  }

  /* ── THE PICTURE: a RULER IN MILLISECONDS, not a drawing of the meter ──
     WHAT IT ANSWERS: "how much is 5 ms?" and "how far have I moved?". Both
     are questions about the units under his thumb, so the axis is those
     units. Nothing here is derived from a fit, so it is correct on the first
     frame with no shot ever taken and it tracks the thumb exactly 1:1.

     THE ARROW-SHAPED DRAWING THAT WAS DESIGNED FIRST IS NOT BUILT, AND MUST
     NOT BE. Its scale came from lastHoldMs / growAtFrac, but lastHoldMs is
     press-to-release WALL TIME: it contains the gather, the capture chain and
     aimOffsetMs itself. Dragging the slider would therefore rescale the
     drawing and spring the marker back toward the centre — the control would
     fight the finger. Its basis had already drifted 552 -> 698 ms inside one
     20-shot tape on the owner's own board.

     WHAT IT DELIBERATELY DOES NOT SHOW: where the green is. The board does
     not know. 68.5 ms of the assumed 90 ms latency is unattributed — the
     capture card, the display chain and the output backend, which the board
     says outright it cannot time. The owner's trim is -55 ms, which almost
     certainly means his true rig delay is ~145 ms, not 90; a green band
     pinned to zero would draw him 37 ms "outside the green" while he is
     greening. So the window appears only as a BRACKET THAT TRAVELS WITH THE
     MARKER — a ruler legend saying how wide a green window is in these units
     — and never as a target with an inside and an outside.

     At a 340 px card the ruler is ~295 CSS px, one 5 ms notch is 7.4 px, and
     the 11-unit text renders at ~12.5 CSS px, above the 11 px caption floor.

     aria-hidden, and not apologetically: the stepper announces the value and
     rtSay() puts it in words. A second announcer would double every nudge. */
  function rtRulerSVG(v, winMs, winIsGuess){
    var x = rtX(v), half = (winMs / 2) / RT_LIMIT * (RT_XW / 2);
    var bl = Math.max(RT_X0, x - half), br = Math.min(RT_X0 + RT_XW, x + half);
    var lx = Math.max(76, Math.min(224, x));
    var t = '';
    [-300, -150, 0, 150, 300].forEach(function(m){
      var tx = rtX(m).toFixed(1);
      t += '<line x1="'+tx+'" y1="'+(m===0?22:26)+'" x2="'+tx+'" y2="'+
           (m===0?38:34)+'" stroke="var(--muted)" stroke-width="'+
           (m===0?1.5:1)+'"/>';
    });
    return '<svg viewBox="0 0 300 68" aria-hidden="true" focusable="false">'+
      '<line x1="'+RT_X0+'" y1="30" x2="'+(RT_X0+RT_XW)+'" y2="30" '+
        'stroke="var(--line)" stroke-width="1.5"/>'+ t +
      '<text x="'+RT_X0+'" y="16" fill="var(--muted)" font-size="11">← earlier</text>'+
      '<text x="'+(RT_X0+RT_XW)+'" y="16" text-anchor="end" '+
        'fill="var(--muted)" font-size="11">later →</text>'+
      /* the value: a rule THROUGH the ruler with a triangular cap, so it is a
         shape and not only a hue — never colour alone (docs/DESIGN.md) */
      '<path d="M'+(x-5).toFixed(1)+',6 L'+(x+5).toFixed(1)+',6 L'+
        x.toFixed(1)+',13 Z" fill="var(--tint,#6f9bff)"/>'+
      '<line x1="'+x.toFixed(1)+'" y1="13" x2="'+x.toFixed(1)+
        '" y2="41" stroke="var(--tint,#6f9bff)" stroke-width="2"/>'+
      /* the legend bracket — HOW WIDE a green window is, in these units */
      '<path d="M'+bl.toFixed(1)+',46 v5 M'+bl.toFixed(1)+',48.5 H'+
        br.toFixed(1)+' M'+br.toFixed(1)+',46 v5" fill="none" '+
        'stroke="var(--muted)" stroke-width="1"/>'+
      '<text x="'+lx.toFixed(1)+'" y="64" text-anchor="middle" '+
        'fill="var(--muted)" font-size="11">'+
        (winIsGuess ? 'about ' : '')+Math.round(winMs)+
        ' ms — one green window</text>'+
      '</svg>';
  }

  /* The control's own stylesheet, the id-guarded idiom cvCss()/pgCss() use:
     injected once per document, never per render. --tint/--tint-wash resolve
     from #dbody[data-tint="vision"] (zs-kit.css §17) exactly the way the
     region boxes above do, and carry that tint's own literal as the fallback
     for a stage rendered outside the tinted subtree. */
  var RT_CSS_ID = 'zs-rt-css';
  function rtCss(){
    if(document.getElementById(RT_CSS_ID)) return;
    var s = document.createElement('style'); s.id = RT_CSS_ID;
    s.appendChild(document.createTextNode([
      /* SOLID inset, not another translucent pane: the owner's "real visual
         distinction between cards, not everything the same shade of dark
         blue", answered with a material step rather than a sixth hue —
         docs/DESIGN.md, "never stack a light translucent surface on
         another". */
      '#cv-rt{background:var(--panel2);border:1px solid var(--line);',
        'border-radius:14px;padding:12px 12px 14px;margin:12px 0 4px}',
      '#cv-rt .rtfld{padding:0;border:0}',
      '#cv-rt .rtpic{margin:8px 0 10px}',
      '#cv-rt .rtpic svg{display:block;width:100%;height:auto}',
      '#cv-rt .rtkeys{display:flex;justify-content:center;margin:2px 0 10px}',
      '#cv-rt .rtkeys .stp{transform:scale(1.12);transform-origin:center}',
      '#cv-rt .rtrng{width:100%;margin-top:0}',
      '#cv-rt .rtends{display:flex;justify-content:space-between;gap:12px;',
        'margin-top:10px}',
      '#cv-rt .rtends span{display:block;max-width:47%;color:var(--muted);',
        'font-size:11px;line-height:1.4;letter-spacing:.004em}',
      '#cv-rt .rtends span+span{text-align:right}',
      '#cv-rt .rtends b{display:block;color:var(--text);font-size:12.5px;',
        'font-weight:600;letter-spacing:0}',
      '#cv-rt .rtreset{display:block;width:100%;margin-top:12px;',
        'min-height:44px;border:1px solid var(--line);',
        'border-radius:var(--r-ctl,12px);background:transparent;',
        'color:var(--muted);font-size:12.5px;cursor:pointer;',
        'font-family:inherit}',
      '#cv-rt .rtreset[disabled]{opacity:.4;cursor:default}',
      /* PRESS FEEDBACK, on pointer-down. docs/DESIGN.md: "anything a finger
         can touch" answers immediately, and "the moment it waits for touch-up,
         directness falls off a cliff". These two are the only controls in the
         block the kit does not already cover — the .stp keys ride
         `.stp button:active` and zs-motion's pressable() SEL, the range has a
         real thumb — so without these lines a full-width 44 px button and
         five tappable dots were the only dead-feeling things on the card.
         Same travel the kit uses: .972 for a wide control, .90 for a small
         square one. A `[disabled]` reset must not dip; it did nothing. */
      '#cv-rt .rtreset:not([disabled]):active{transform:scale(.972);',
        'background:var(--panel)}',
      '#cv-rt-out .rtdot:active{transform:scale(.9)}',
      /* THE OUTCOME BLOCK. "It let go for you" and "it stood back" must not
         be the same object: one is the feature working, the other is the
         feature declining to act, and they call for opposite responses. Fill
         AND wording differ, never the fill alone. */
      '#cv-rt-out .rtcard{border-radius:14px;padding:10px 12px;margin:10px 0 0;',
        'border:1px solid var(--line);background:var(--panel2)}',
      '#cv-rt-out .rtcard.fired{border-color:var(--tint,#6f9bff);',
        'background:var(--tint-wash,rgba(111,155,255,.14))}',
      '#cv-rt-out .rtcard.stood{background:transparent}',
      '#cv-rt-out .rtcard b{display:block;font-size:13.5px}',
      '#cv-rt-out .rtcard em{display:block;font-style:normal;color:var(--muted);',
        'font-size:11.5px;margin-top:3px}',
      /* THE GAP IS 38 px AND THAT IS ARITHMETIC, NOT TASTE. A 14 px cap with
         an ::after inset of -15px has a 44 px hit box, so two neighbouring
         caps 8 px apart would have hit boxes OVERLAPPING by 22 px — exactly
         the defect ibGap() was written for, where a tap in the seam
         hit-tested to whichever ::after painted last. 44 + 8 = 52 px between
         centres, minus the 14 px cap, is 38 px of flex gap; five dots then
         span 222 px, which fits a 340 px card with room over. */
      '#cv-rt-out .rtdots{display:flex;gap:38px;align-items:center;',
        'flex-wrap:wrap;margin:10px 0 0;padding:0 2px}',
      '#cv-rt-out .rtdot{position:relative;flex:none;width:14px;height:14px;',
        'border-radius:50%;padding:0;box-sizing:border-box;',
        'border:1.5px solid var(--muted);background:transparent;cursor:pointer}',
      '#cv-rt-out .rtdot::after{content:"";position:absolute;inset:-15px}',
      '#cv-rt-out .rtdot.on{border-color:var(--tint,#6f9bff);',
        'background:var(--tint,#6f9bff)}',
      '#cv-rt-out .rtlab{display:block;color:var(--muted);font-size:11.5px;',
        'margin-top:12px}',
      '#cv-rt-out .rtsum{display:block;color:var(--muted);font-size:11.5px;',
        'margin-top:10px}',
      'body.a11y-big #cv-rt .rtkeys .stp{transform:scale(1.2)}',
      'body.a11y-big #cv-rt-out .rtdot{width:18px;height:18px}',
      /* THE DELAY LINE + MEASURE MY DELAY (D90): the line under the outcome
         block, and the sheet's own pieces. Tokens only; the big readout is
         tabular so a changing number never reflows its row (DESIGN.md). */
      '#cv-delay .dlline{color:var(--muted);font-size:12.5px;line-height:1.5;',
        'margin:10px 2px 0}',
      '#cv-delay .dlline b{color:var(--text,#e6edf3);font-variant-numeric:tabular-nums}',
      '#cv-delay .btn{margin-top:10px}',
      '.mdl .mdl-p{font-size:14px;line-height:1.5;margin:8px 0 10px}',
      '.mdl .mdl-p .gly-deco{display:inline-block;vertical-align:middle;',
        'width:22px;height:22px;margin:0 3px}',
      '.mdl .mdl-big{font-size:22px;font-weight:700;text-align:center;',
        'font-variant-numeric:tabular-nums;margin:10px 0 6px}',
      '.mdl .mdl-samples{color:var(--muted);font-size:12.5px;line-height:1.5;',
        'text-align:center;font-variant-numeric:tabular-nums;margin-bottom:6px}',
      /* the "measuring" dot breathes; the words carry the state on their own
         (never colour or motion alone), and Reduce Motion stills it */
      '.mdl .mdl-dot{display:inline-block;width:10px;height:10px;border-radius:50%;',
        'background:var(--accent);margin-right:8px;vertical-align:middle;',
        'animation:zs-mdl-pulse 1.2s ease-in-out infinite}',
      '@keyframes zs-mdl-pulse{0%,100%{opacity:.35}50%{opacity:1}}',
      'body.a11y-motion .mdl .mdl-dot{animation:none}',
      '@media (prefers-reduced-motion:reduce){.mdl .mdl-dot{animation:none}}'
    ].join('')));
    (document.head || document.documentElement).appendChild(s);
  }

  /* Everything live on this screen. Three self-pacing loops (a JSON status
     poll, the picture itself, and — only when the board has one — the region
     reader) and the things the user can do: turn it on, tap a colour, widen
     the match, draw a box, move it, resize it, name it, teach it, delete it.
     Every one of them is a real call to the board.

     The picture loop is paced by each frame actually landing rather than by a
     fixed interval, so a slow link makes the preview slower instead of piling
     up requests the board has to answer. Asking faster than the board makes
     pictures is nearly free too: the ask carries the name of the frame we
     already hold, and the board answers "still that one" in a few dozen bytes
     with no picture attached. It never re-encodes, and now it never re-sends
     either. */
  /* The open screen's "app came back" listener, one at a time. Each visit
     added its own and only took it off on the NEXT visibilitychange, so an
     app never put away (the exe's window, a phone on a stand) kept every
     visit's listener, and with it that visit's whole screen, for as long as
     it ran (the stress run's soak, 2026-10-02: +1 per visit). */
  var cvOnVisible = null;
  /* the open screen's two delegated listeners on #dbody (see onPlayChip) */
  var cvRootKeys = null;
  function dropRootKeys(){
    if(!cvRootKeys) return;
    cvRootKeys.root.removeEventListener('click', cvRootKeys.click);
    cvRootKeys.root.removeEventListener('keydown', cvRootKeys.key);
    cvRootKeys = null;
  }
  function wireCv(root, p){
    var stage = root.querySelector('#cv-stage');
    if(!stage) return;
    cvCss();
    rtCss();
    var im    = root.querySelector('#cv-frame');
    var ovl   = root.querySelector('#cv-ovl');
    var boxEl = root.querySelector('#cv-boxes');
    var hint  = root.querySelector('#cv-hint');
    var fpsEl = root.querySelector('#cv-fps');
    var armEl = root.querySelector('#cv-arm');
    var sayEl = root.querySelector('#cv-say');
    var rungEl= root.querySelector('#cv-rungs');
    var actEl = root.querySelector('#cv-act');
    var profEl= root.querySelector('#cv-prof');
    var modeEl= root.querySelector('#cv-mode');
    var listEl= root.querySelector('#cv-boxlist');
    var calEl = root.querySelector('#cv-cal');
    var picEl = root.querySelector('#cv-pic');
    var budgetEl = root.querySelector('#cv-budget');
    /* the two statically-rendered groups the game profile gates by
       style.display — the picAcc idiom, never a removal: the controls stay
       in the DOM, wired, for every config whose vision block uses them */
    var gAim   = root.querySelector('#cv-g-aim');
    var gModel = root.querySelector('#cv-g-model');
    var modelStatEl = root.querySelector('#cv-modelstat');
    /* the shot assist's two halves: the switch + landed readout on Play,
       the timing trim + caution on Tune — one gate covers both */
    var gShot     = root.querySelector('#cv-g-shot');
    var gShotTune = root.querySelector('#cv-g-shottune');
    var shotStatEl = root.querySelector('#cv-shotstat');
    var shotLineEl = root.querySelector('#cv-shotline');
    /* THE RELEASE-TIMING CONTROL, and the per-shot outcome under it. Both
       live INSIDE #cv-g-shot but OUTSIDE #cv-shotstat: that slot is
       put()-repainted every 320 ms, and a repaint would replace the node a
       finger is dragging. #cv-rt is written once, by render, and only ever
       updated field by field from rtPaint(); #cv-rt-out is a slot like any
       other, so it may repaint freely. */
    var rtBox   = root.querySelector('#cv-rt');
    var rtSv    = rtBox && rtBox.querySelector('.sv');
    var rtRng   = rtBox && rtBox.querySelector('.rtrng');
    var rtPicEl = root.querySelector('#cv-rt-pic');
    var rtRvEl  = rtBox && rtBox.querySelector('.rv');
    var rtReset = root.querySelector('#cv-rt-reset');
    var rtOutEl = root.querySelector('#cv-rt-out');
    /* the delay line + the Measure my delay key (D90): a slot, repainted
       freely; the tap is delegated from the wrapper (mdOpen below) */
    var delayEl = root.querySelector('#cv-delay');
    var rtWinMs = 0;      /* the last ok plan's windowMs; 0 = never seen one */
    var rtPutT  = null;   /* the one coalescing timer                        */
    var rtLast  = '';     /* the ruler markup on screen, so a repaint of the
                             identical picture writes nothing                */
    /* THE TIMING SHAPE's three display gates: the whole aim-help block
       (its header, note and card), the truth ladder + honest line, and the
       Reach & tracking accordion — all aim machinery a timing-only pack
       never runs. Same picAcc idiom as everything above: display toggles,
       never removal, and the accordion is found by the data-key acc()
       stamped on it so the two can never drift apart. */
    var gAimWrap = root.querySelector('#cv-g-aimwrap');
    var gLadder  = root.querySelector('#cv-g-ladder');
    var reachAcc = root.querySelector('.acc[data-key="cvreach"]');
    /* the one colour-only control living INSIDE the shared Reach & tracking
       accordion. No markup change — it is found by its label, exactly the
       way after()'s slider scan finds it to wire it, so the two can never
       drift apart. The static HTML is already in root at wireCv time. */
    var bigFld = null;
    root.querySelectorAll('.rng').forEach(function(rng){
      var f = rng.closest ? rng.closest('.fld') : null;
      var fl = f && f.querySelector('.flab');
      var lab = (fl && fl.childNodes[0] && fl.childNodes[0].textContent || '').trim();
      if(lab === 'Ignore things bigger than') bigFld = f;
    });
    /* the static accordion shell around #cv-pic (rendered by R.vision on the
       Advanced tab) — hidden when there is no capture card, because "The
       picture" with nothing inside it would be an empty drawer */
    var picAcc = picEl && picEl.closest ? picEl.closest('.acc') : null;
    /* the typed-colour accordion inside #cv-cal. Its open state lives HERE,
       not in the DOM: calHtml() is repainted whenever the target changes, and
       a class the user toggled on a repainted node would be lost. wire()'s
       accordion pass can never reach it either (it runs before the slot has
       content), so its header is delegated below like everything in #cv-cal. */
    var hexOpen = false;
    /* the "Why it did that" drawer inside #cv-shotstat, for exactly the same
       reason: that slot is repainted every 320 ms, so a class the user
       toggled on a repainted node would be lost on the next poll */
    var whyOpen = false;

    var dbody = document.getElementById('dbody');
    var myNs  = dbody ? dbody.dataset.ns : '';
    var st = null;        /* the last /vision/status payload, or null */
    var asked = false;    /* the board has answered at least once */
    var imgOk = false;    /* a frame really arrived AND decoded */
    var tap = null;       /* {x,y,at} of a recent tap, for the pin */
    var busy = false;     /* a start/stop/target call is in flight */
    var statusT = null, frameT = null, regT = null;
    var lastHtml = {};    /* per slot, so a poll does not churn the DOM */

    /* ── the picture's settings ──────────────────────────────────────
       These belong to the BOARD, not to this app. status().preview is the
       truth and everything here is an echo of it, adopted on every poll —
       so an app opened fresh, or opened after the adapter restarted, shows
       what the adapter is really doing instead of a hopeful default. The
       local value wins only for the moment a change of ours is in flight.

       `enabled` starts true because that is the board's own default; the
       first status answer replaces it either way. */
    var pic = {enabled:true, width:640, grey:false};
    var picKnown = false; /* the board has answered once about the preview */
    var picBusy = false;  /* a /vision/preview call is in flight */
    var picOld  = false;  /* this adapter is old: it has no /vision/preview */
    var picSaid = '';     /* ...and this is what it said when it refused */
    /* a frame has been asked for and has not landed yet. frameT alone cannot
       tell you this: between asking for a frame and the picture landing there
       is no timer pending, and without this flag "start the poller if it is
       idle" reads that gap as idle and fires a second request. */
    var framePend = false;

    /* ── what picture is on screen, and how we know it is still current ──
       picTag is the adapter's ETag for the bytes currently displayed. The
       adapter names every preview frame, and the name changes only when the
       picture really changes — so when the name comes back the same, the
       bytes we already have ARE the current frame and there is nothing to
       redraw. That is the whole saving: the app asks ~30 times a second, the
       adapter makes ~3 pictures a second, and the other 27 answers are now a
       header and no image at all.
       picUrl is the blob: URL behind <img>, kept only so it can be handed
       back — one per picture, and leaking 50 KB thirty times a second would
       be a worse bug than the one this fixes.
       An adapter too old to send a name leaves picTag '' forever, every
       answer counts as new, and the screen behaves exactly as it did before
       any of this existed. */
    var picTag = '';
    var picUrl = '';
    var picShownW = 0;    /* the width the picture on screen was asked at */

    /* The boxes, and everything about how they are being edited. Deep-copied
       out of the cached profile on purpose: a drag mutates these forty times a
       second, and mutating the app's copy of the board's profile in place
       would leave the cache showing an edit that the board rejected. */
    var regs = JSON.parse(JSON.stringify(cvRegionsOf(visionOf(p))));
    var sel = -1;                 /* which box is selected, -1 for none */
    var mode = 'colour';          /* 'colour' = tap picks a colour, 'box' = draw */
    var drag = null;              /* the gesture in flight */
    var ghost = null;             /* the rectangle being drawn right now */
    var armTeach = -1;            /* index of the box waiting for a colour tap */
    /* THE SHOT-METER TEACH FLOW (hand level). null, or {phase, rect}:
         phase 'box'  — the user drags a box on the picture. It is a box to
                        LOOK IN, not a box that is the meter: 2K draws the
                        meter above the player's head, so it walks about, and
                        the honest instruction is "draw round the part of the
                        screen it moves in". SAME drag/move/resize gestures
                        the region boxes use. Nothing is sent yet.
         phase 'bar'  — the user taps the METER BAR itself. This is the
                        colour the board HUNTS for, and it is what lets the
                        box be big. Sent WITH the rect in one POST, because
                        the board's ceiling on the rect depends on whether a
                        bar colour came with it (15% pinned, 40% searching) —
                        two calls would get the big box refused on the way in.
         phase 'zone' — the user taps the GREEN BAND. This is what it
                        RELEASES on. POST …/teach {zone}.
       Both taps read the chroma off the BOARD's own live frame at that point
       (never an app-side canvas sample — the board's pixels are the ones the
       reader will see).
       The answer's data.meter is SAVED INTO THE PROFILE (the regions idiom:
       applied live by the route, persisted by this caller). Teaching never
       touches `enabled` — a pack stays disarmed until the switch is thrown. */
    var shotTeach = null;
    var shotBusy = false;         /* a teach POST is in flight */
    var SHOT_RI = 98;             /* the meter box's data-ri — never a region index */

    /* what the BOARD says about the boxes. reader===null means "we have not
       asked yet", false means "this adapter has no region reader" — and the
       difference is the difference between a spinner and a lie. */
    var reader = null, readerWhy = '', regState = {}, regBudget = null;

    function alive(){
      var d = document.getElementById('dbody');
      return !!(d && d.dataset.ns === myNs && d.contains(stage));
    }
    function stopAll(){
      if(statusT){ clearTimeout(statusT); statusT = null; }
      if(frameT){ clearTimeout(frameT); frameT = null; }
      if(regT){ clearTimeout(regT); regT = null; }
      /* FLUSH THE PENDING NUDGE. rtQueue() coalesces at 350 ms so a
         hold-repeat is one PUT and not fourteen; without this line, tapping
         Back inside that window would silently drop the write and the screen
         he just left would be the only place his change ever existed. */
      if(rtPutT) rtCommit();
      /* the screen is gone: so is its listener (cvOnVisible, above) */
      document.removeEventListener('visibilitychange', onVisible);
      if(cvOnVisible === onVisible) cvOnVisible = null;
      if(cvRootKeys && cvRootKeys.click === onPlayChip) dropRootKeys();
    }
    function put(el, key, html){
      if(!el || lastHtml[key] === html) return;
      lastHtml[key] = html;
      el.innerHTML = html;
    }
    function fmtOf(){
      return (st && st.format && st.format.fourcc) ? st.format.fourcc : 'these';
    }
    /* The BOARD's copy of this config's vision block, falling back to the
       offline store — the pkVision idiom hoisted up where paint() can reach
       it. The discriminator, the profile button and the pack door all read
       THIS, never the render-time snapshot, because applying a pack (or
       Blank, from any phone) rewrites the board's copy behind the app. */
    function cvVis(){ return visionOf(p) || {}; }

    /* Three different questions about the stage, deliberately kept apart —
       they used to be one flag (`canSee`) and that flag meant "an <img>
       loaded", which stops being the same question the moment the picture can
       be switched off:

         picOff()  — the user has switched the picture off.
         canSee()  — a real photo is on screen. Only this may gate anything
                     that reads a PIXEL: tapping a colour, teaching a box.
         canMark() — the stage is worth drawing on. With the picture off it
                     still has the shape of the screen, so the boxes and the
                     marks are still in the right place — which is how you can
                     watch it finding targets without paying for the picture. */
    function picOff(){ return pic.enabled === false; }
    function canSee(){ return !!(st && st.running && imgOk && !picOff()); }
    function canMark(){ return !!(st && st.running && (imgOk || picOff())); }

    /* ── what to say, in one place ──────────────────────────────── */
    function say(){
      if(!asked && ZS.live.online !== false){
        return {t:'off', h:'Asking your adapter…',
                s:'Finding out whether a capture card is plugged in.'};
      }
      if(ZS.live.online === false || !st){
        return {t:'off', h:'Can’t reach your adapter',
                s:'The app is not talking to your ZeroStick right now, so there is nothing it can show you. Check it is powered and on the same network.'};
      }
      if(!st.available){
        return {t:'warn', h:'No capture card',
                s:'Plug an HDMI capture stick into the adapter’s USB port and run your console through it. Until then there is no picture to look at.'};
      }
      /* "not watching at all" and "watching, with the picture hidden" are two
         different things, and this used to call the first one "the picture is
         off" — the exact words the new Show the picture switch uses. Two
         switches with one name is how a screen becomes unusable, so the
         watching one is now described as watching. */
      if(!st.running){
        return {t:'off', h:'Not watching your screen yet',
                s:'Start watching to see what your adapter sees.',
                /* D285: the why is the "?" under the status box */
                q:'It runs on a strict slice of the board, so it can never slow your controller down.'};
      }
      /* With the picture switched off there is no <img> to load, so "no
         picture coming in" would be this screen accusing the HDMI cable of
         something the user did on purpose. */
      if(!imgOk && !picOff()){
        return {t:'warn', h:'No picture coming in',
                s:'The capture card is there, but nothing is arriving on its HDMI input. Check the cable from your console into the card.'};
      }
      if(armTeach >= 0 && regs[armTeach]){
        return {t:'ok', h:'Tap the thing you want it to notice',
                s:'Tap inside the “'+String(regs[armTeach].name||'area')+'” box, on the colour you want it to watch for.'};
      }
      var d = st.detect || {}, det = st.lastDetection;
      /* BLANK — no game selected. Honest about both halves: the config
         carries nothing game-specific, AND the eyes are not claimed to be
         off — detection on/off belongs to Start/Stop, and a colour-less
         running watcher still hunts the board's built-in red preset. */
      var bTools = cvToolsOf(cvVis());
      /* AN INSTALLED PACK WITH NO COLOUR TAUGHT is not "no game selected" —
         it is one tap short of working, and the adapter is meanwhile hunting
         its factory red. Saying so is the difference between a screen that
         looks broken and a screen with a next step. */
      if(bTools.colourPending && !bTools.colour){
        return {t:'warn', h:'Watching — no colour taught yet',
                s:'Your pack is installed and set up, but the colour it '+
                  'hunts is yours to teach — until you do, your adapter is '+
                  'looking for its factory red. Go to Tune and tap an enemy '+
                  'marker on the picture.'};
      }
      if(!bTools.colour && !bTools.model){
        /* A TIMING pack IS a game selection — "no game selected" here was
           the aim shape leaking onto the timing screen, telling the owner
           to pick the profile he was already inside. */
        if(bTools.shot){
          return {t:'ok', h:'Watching — shot timing',
                  s:'This config reads the shot meter instead of hunting a '+
                    'colour. The Shot assist card is the whole story: it lets '+
                    'go of your shoot button '+releaseSay()+'.'};
        }
        return {t:'ok', h:'Watching — no game selected',
                s:'Your adapter has nothing game-specific to hunt. Start/Stop still '+
                  'controls the watching itself. Pick a game profile above to give '+
                  'it something to find.'};
      }
      if(!d.enabled){
        return {t:'ok', h:'Watching your screen',
                s:'Your adapter is watching, but what the card sends cannot be searched for a colour — it is sending '+fmtOf()+' frames.'};
      }
      if(det && det.found){
        if((Number(det.areaFrac)||0) > 0.35){
          return {t:'warn', h:'That colour is nearly the whole screen',
                  s:'It matches about '+Math.round(det.areaFrac*100)+'% of the picture, so it is not telling you where anything is. Tap something that stands out from what is behind it.'};
        }
        return {t:'good', h:'Target seen', s:'It is '+cvWhere(det.x, det.y)+'.'};
      }
      if(det && det.error){
        return {t:'ok', h:'Watching', s:String(det.error)};
      }
      return {t:'ok', h:'Watching',
              s:'Looking for '+((d.target && d.target.label) || 'your colour')+
                '. Nothing matching it on screen yet.'};
    }

    /* The honest line, and the reason it is painted from status rather than
       written into the page: whether the board has an aim step is the board's
       fact, not the app's. If it does not report one, this says so plainly
       instead of implying a feature; if it starts reporting one, this stops
       claiming it is missing without anybody editing this sentence. */
    /* ── THE 52-WORD PARAGRAPH THAT SAID WHAT THE LADDER ALREADY SAID ─────
       Owner, 2026-08-28: "WALLS OF TEXT at the top of screens before any
       control … DELETE over explain. A note that restates its label dies."
       This one restated the four-rung ladder six pixels above it, rung for
       rung: cvRungs already prints "Aim help — your adapter isn't reporting
       this / your board switched it off after a problem / your board has it,
       switched off / ready, not nudging right now" and this paragraph then
       wrote each of those out again in prose. Measured before: 52 words in
       the normal case, and it was the last thing on the tab.

       Three things survived the cut, and only one of them is a sentence:

       1. THE SCOPE DISCLAIMER — "what works today" is real, and it is the
          textbook "?" chip: a consequence you want available, never a
          paragraph you must read past to reach a control.
       2. A LIVE DEAD END WORTH SHOUTING ABOUT. Aim help on + "How much it
          helps" at 0 renders a config that looks completely set up and can
          never move the stick — the installed CoD Colour pack ships
          assist.strength 0, so this is the state the app was actually in
          while it printed the calm sentence "It only ever nudges — at most
          0% of a full stick push", which reads as a typo rather than as the
          dead end it is. That is a consequence, so it is a warning.
       3. The abnormal board states stay as warnings, but only as the part
          the ladder cannot carry: what to DO about it.

       Everything else is gone. The ladder is the answer to "is it working?";
       this slot is now only for what the ladder cannot say. */
    function honestHtml(){
      var a = aimState();
      var chip = helpHTML('cv-scope', 'What this screen can show you',
        'Your adapter watches your screen and finds the colour you chose — that '+
        'much you can see happening in the picture above. Whether a nudge '+
        'actually reached your stick is the adapter’s own report: the last '+
        'rung above lights when it says so, and stays grey when it says nothing.');
      if(!a) return chip;
      if(a.killed){
        return note('⚠ Your adapter switched aim help off by itself after a '+
          'problem. Restart the adapter to get it back.', 'warn')+chip;
      }
      if(a.enabled === false){
        return note('⚠ Aim help is switched off on your adapter, so nothing here '+
          'is reaching your sticks. Your settings are saved and waiting.', 'warn')+chip;
      }
      /* THE 0% DEAD END — see (2) above, and read the control it names.
         This quoted aiAdjustment.maxMagnitude, which is not what the slider
         writes and, on the vision-service shape, was not even present — so it
         read 0 forever and shouted "0%" under a slider showing 100%. It reads
         `strength` now, the number that slider owns, and stays silent when
         the board has not reported one rather than guessing zero. */
      var s = a.strength;
      if(typeof s === 'number' && Math.round(s*100) === 0){
        return note('⚠ Aim help is on but “How much it helps” is 0%, so it can '+
          'never move the stick. Raise it above 0.', 'warn')+chip;
      }
      return chip;
    }

    /* Whether the adapter is nudging anyone's aim is the ADAPTER's fact, and it
       is reported in two places as this grows: the vision service's own status
       once it has one, and the engine's bounded-adjustment gate, which exists
       today. Prefer the first, fall back to the second, claim nothing if
       neither is there. */
    /* ── TWO SOURCES, TWO SHAPES — NORMALISE OR LIE ────────────────────
       Reviewer, 2026-08-28. This returned whichever raw object it found, and
       the two are NOT the same shape. The engine's gate
       (status.aiAdjustment) is flat: {enabled, killed, maxMagnitude}. The
       vision service's report (vision/status .assist) puts those same three
       on a nested `holder`, and puts the SETTINGS on `config` — its own top
       level has no `killed` and no `maxMagnitude` at all.

       Every caller below reads a.killed / a.enabled / a.maxMagnitude flat, so
       whenever the vision service was attached — i.e. whenever Screen Assist
       is actually running — `a.killed` was undefined (the "switched itself
       off" warning could never fire) and `a.maxMagnitude` was undefined,
       which `Number()||0` turned into a hard 0. That printed
       "«How much it helps» is 0%, so it can never move the stick" underneath
       a slider reading 100%, on the flagship config, permanently.

       So the shape is flattened here, once, and `strength` — the number the
       "How much it helps" slider actually writes and shows
       (vision.assist.strength) — comes along, because that is the control the
       warning names. maxMagnitude is a different cap on a different screen
       and must never be quoted as this one. */
    function aimState(){
      if(st && st.assist){
        var a = st.assist, h = a.holder || {}, c = a.config || {};
        return {
          enabled: (a.enabled !== undefined ? a.enabled : h.enabled),
          killed: h.killed,
          maxMagnitude: (h.maxMagnitude !== undefined ? h.maxMagnitude : c.maxMagnitude),
          strength: c.strength
        };
      }
      var s = ZS.live.status;
      return (s && s.aiAdjustment) ? s.aiAdjustment : null;
    }

    /* ── what the board says about one box ───────────────────────────
       Three sources, in order of how much they prove:
         1. the region reader's own answer, when the adapter has one;
         2. for an "ignore" box, the board's OWN exclusion list read back out
            of /vision/status — the rectangle is in it or it is not;
         3. nothing, and it says so.                                        */
    function resultOf(r, i){
      var kind = cvKindOf(r);
      if(!kind){
        return {chip:'not set up', tone:'w',
                line:'This box does not do anything yet — tap it and choose what it should watch.'};
      }
      if(kind === 'ignore'){
        var ex = (st && st.detect && st.detect.filters && st.detect.filters.exclude) || null;
        if(!ex){
          return {chip:'', tone:'',
                  line:'Start watching and your adapter will tell you whether it is skipping this area.'};
        }
        for(var k=0;k<ex.length;k++){
          if(cvRectEq(cvRect(r.rect), ex[k])){
            return {chip:'ignored', tone:'g', hit:false,
                    line:'Your adapter is skipping this box right now. That is not a '+
                         'guess — it is in the list of areas your adapter says it ignores.'};
          }
        }
        return {chip:'not yet', tone:'w',
                line:'Your adapter has not picked this box up yet. It reads the boxes when the config is applied, so switch to this config (or stop and start watching) and check again.'};
      }
      if(reader === false){
        return {chip:'waiting', tone:'w',
                line:'Your adapter cannot read areas yet — it can only skip them. '+(readerWhy||'')};
      }
      if(reader === null){
        return {chip:'…', tone:'', line:'Asking your adapter about this box…'};
      }
      var s = regState[r.id];
      if(!s){
        return {chip:'waiting', tone:'w',
                line:'Your adapter has not reported anything for this box yet.'};
      }
      var chip = s.label ? String(s.label)
               : (typeof s.value === 'number' ? Math.round(s.value*100)+'%' : 'watching');
      var hit = !!(s.label || (typeof s.value === 'number' && s.value >= 0.5));
      var line = s.reason ? String(s.reason)
        /* s.label is the board's own word for what it matched. When a box
           is switched off that word is the literal state name "off", and the
           sentence came out as ‘It is seeing “off” in this box.’ — which
           reads as a bug, because it is one. Say the state. */
        : (s.label
             ? (/^(off|none|idle|disabled)$/i.test(String(s.label))
                  ? 'This box is switched off, so nothing is being read from it.'
                  : 'It is seeing “'+s.label+'” in this box.')
             : 'It is watching this box.');
      if(s.starved){
        line += ' It is only getting to this box '+cvNum(s.updateHz,1)+
                ' times a second — you have asked it to watch more than it can keep up with.';
      }
      return {chip:chip, tone:hit?'g':'', hit:hit, line:line};
    }

    /* What the #cv-cal slot paints when the config is Blank: never an empty
       hole, always the two ways out — pick a game profile, or start your own
       tuning by tapping a colour (rememberTarget writes vision.target, the
       tools flip, and the colour group replaces this on the next paint). */
    function cvHintCard(){
      return note('<b>No pack in use.</b> Pick a game profile to unlock its '+
           'tuning — or tap the colour you want hunted on the picture above '+
           'to start your own.')+
        '<button class="btn primary" data-cvprof="1" style="margin-top:8px">'+
          'Choose a game profile</button>';
    }

    /* THE STATUS CHIP (screen-map §6): "Start watching my screen" has ONE
       home — the Play tab's #cv-toggle — and every other pane that used to
       grow its own copy of the button now says the state and jumps the
       pager instead. One control, one code path, no twins; the chip is a
       tapper row wired by [data-cvplay] delegation in wireCv, which clicks
       the Play tab the same way a finger would. */
    /* A Core has no Start/Stop routes: its capture runs whenever a source is
       there (audit m48), so every "start it" door says that instead. */
    function noStartStop(){ return !!(ZS.productHides && ZS.productHides('visionStartStop')); }
    function startWatchingCard(why){
      if(noStartStop()){
        return '<div class="grp-card"><div class="lrow"><span class="src">Not watching'+
          '<em style="display:block;font-weight:400;font-style:normal;color:var(--muted);'+
          'font-size:11.5px;white-space:normal;line-height:1.4">'+esc(why)+
          ' It starts by itself once your capture card has a picture.</em></span></div></div>';
      }
      return '<div class="grp-card"><div class="lrow tapper" role="button" tabindex="0" '+
        'data-cvplay="1" aria-label="Not watching — start on the Play tab">'+
        '<span class="src">Not watching'+
        '<em style="display:block;font-weight:400;font-style:normal;color:var(--muted);'+
        'font-size:11.5px;white-space:normal;line-height:1.4">'+esc(why)+
        ' Start it on the <b>Play</b> tab.</em></span>'+
        '<span class="rt"><span class="arrow">›</span></span></div></div>';
    }

    /* ── the calibration block ──────────────────────────────────── */
    function calHtml(){
      /* THE GAME-PROFILE GATE, first: colour tuning belongs to a config
         whose vision block actually carries a colour. Blank paints the hint
         card in this same slot (the never-empty rule); a model-only pack
         paints nothing here — its knobs live in the Trained model card —
         and so does a TIMING-only pack: its knobs live in the Shot assist
         timing card, and "No pack in use" over a pack that is very much in
         use was this slot calling the owner's config Blank. */
      var tools = cvToolsOf(cvVis());
      /* ...and an INSTALLED-BUT-UNTAUGHT colour pack is the one config that
         needs this slot MOST: teaching the colour is the only thing left to
         do, and hiding the teaching card behind "is a colour already taught"
         made a freshly installed pack a dead end. */
      if(!tools.colour && !tools.colourPending){
        return (tools.model || tools.shot) ? '' : cvHintCard();
      }
      /* ONE offline story per screen: the stage's #cv-hint owns "can't reach
         your adapter", so this Tune-tab slot answers with what to DO about it
         instead of a twin copy of the same box. While the very first status
         ask is still in flight it stays quiet rather than flashing an offline
         note that may be wrong 200 ms later; and with no capture card at all
         the state card already says so, so this says nothing. */
      if(!asked && ZS.live.online !== false) return '';
      if(ZS.live.online === false || !st){
        return note(noStartStop() ? 'Teaching needs your adapter. Reconnect it.'
          : 'Teaching needs your adapter. Reconnect, then press '+
            '“Start watching my screen” on the Play tab.');
      }
      if(!st.available) return '';
      if(!st.running){
        /* THE TAB'S OWN FIRST MOVE, INSTEAD OF DIRECTIONS TO ANOTHER TAB.
           Measured at 375x812 this was the worst screen left in the app —
           39.9% of the viewport one flat colour, no solid role fill anywhere
           in its scroll extent — and the reason is in the sentence it used to
           print: every tool on Tune is dead until the adapter is watching,
           and the screen answered that by telling you to go and press a
           button somewhere else. The button comes here. Same POST, same
           board state, same wording for the button's own label as the Play
           tab's (labels are an API) — it is #cv-toggle's twin, not a second
           control, which is why it carries data-cvgo rather than that id and
           why paint() re-renders it from the board like everything else. */
        return startWatchingCard(
          'Nothing to tune until your adapter is watching.');
      }
      var d = st.detect || {};
      if(!d.enabled){
        return note('A colour cannot be picked out of '+esc(fmtOf())+' frames — there is '+
          'no way to look inside them without a JPEG decoder. The picture still works.','warn');
      }
      var t = d.target || {};
      var ri = cvRadiusIdx(t.radius);
      var presets = (st.presets || []).map(function(pr){
        return '<button data-cvp="'+esc(pr.id)+'" style="flex:none;min-width:0;padding:9px 11px">'+
          '<span style="display:inline-block;width:10px;height:10px;border-radius:3px;'+
            'vertical-align:-1px;margin-right:6px;background:#'+cvHex(pr.color)+'"></span>'+
          esc(pr.label)+'</button>';
      }).join('');
      return sh('What it is looking for')+
        /* ONE short line, in the pane where the tap happens. The pack's own
           long explanation stays in the pack card; this says what is true
           here and what to do about it. */
        /* "nothing else needs setting up" is a promise this card cannot keep
           and must not make blind. A pack may ship DISARMED — the CoD pack's
           own description says so in as many words: "it ships at 0%, try 60%"
           — and a player who teaches the colour, turns aim help on and then
           feels nothing has been handed the exact "you havent changed shit"
           experience this screen exists to prevent. So the second half of the
           sentence is asked of the config, not assumed. */
        (tools.colourPending
          ? (function(){
              var av = (cvVis() || {}).assist || {};
              var armed = !(av.strength === 0 || av.strength === undefined);
              return note('<b>This pack ships without a colour.</b> Tap an enemy marker '+
                'on the picture above and it learns yours'+
                (armed
                  ? ' — nothing else on this pack needs setting up.'
                  : '. This pack also arrives <b>turned down to zero</b>: once the colour '+
                    'is taught, raise <b>How much it helps</b> on Play or it will find '+
                    'your target and do nothing.'), 'warn');
            }())
          : '')+
        card('<div class="stat"><span>Colour</span><b>'+
          '<span style="display:inline-block;width:14px;height:14px;border-radius:4px;'+
            'vertical-align:-2px;margin-right:7px;border:1px solid rgba(255,255,255,.25);'+
            'background:#'+cvHex(t.swatch)+'"></span>'+esc(t.label || '—')+'</b></div>')+
        /* 44 WORDS, OF WHICH SEVEN WERE THE INSTRUCTION. The rest argued the
           case for tapping over typing — which is a real reason, and real
           reasons go behind the chip. The instruction stays in front because
           nothing else on this card tells you the picture is tappable. */
        note('With <b>Pick a colour</b> chosen above, <b>tap the picture</b> on the '+
             'thing you want it to notice.')+
        helpHTML('cv-tapvstype', 'Tapping the picture',
          'Tapping takes the colour as your capture card really sees it, which is '+
          'rarely the code the game sent — so it beats typing even when you know '+
          'the code. If you do know it, “Type the colour instead” is just below.')+
        /* ...but if you KNOW the code, typing it must be possible. A game that
           documents its enemy colour, or a setting copied from someone else's
           config, is a perfectly good starting point to then refine by tapping.
           It is the ALTERNATIVE path though, so it folds into an accordion —
           tapping the picture stays the one at full rank. The accordion's
           open class comes from hexOpen (module state above), and its header
           is delegated from calEl like everything in this slot. */
        '<div class="acc'+(hexOpen?' open':'')+'" id="cv-hexacc">'+
        '<div class="ah" role="button" tabindex="0" aria-expanded="'+(hexOpen?'true':'false')+'">'+
          '<span class="aicon">'+ico('code', 20)+'</span>Type the colour instead'+
          '<span class="chev">›</span></div>'+
        '<div class="ab">'+
        card('<div class="fld col"><div class="flab">Or type the colour code</div>'+
          '<div style="display:flex;gap:8px">'+
          /* min-width:0 on the field and width:auto on the button, and BOTH are
             load-bearing. `.btn` is display:block;width:100% (phone.html), so a
             flex:0 0 auto button resolves its basis to the FULL row and refuses
             to shrink — measured 285px of a 285px row, leaving the input 24px
             wide and 60px tall. It looked like a dead control; there was simply
             nowhere to type. A flex item also defaults to min-width:auto, which
             stops it shrinking below its content, so the field needs the 0 to
             give the row somewhere to take space from. The picker row at ~4844
             already does it this way. */
          '<input class="txt" id="cv-hex" data-nosave="1" inputmode="latin" '+
            'autocomplete="off" spellcheck="false" maxlength="9" '+
            'placeholder="DF00FF" aria-label="enemy colour as a hex code" '+
            'style="flex:1 1 auto;min-width:0;text-transform:uppercase">'+
          '<button class="btn" id="cv-hexgo" '+
            'style="flex:0 0 auto;width:auto">Use it</button>'+
          '</div></div>')+
        '</div></div>'+
        '<div class="vizbox" style="padding:12px 14px">'+
          '<div style="font-size:13.5px;font-weight:600">How close the colour has to be</div>'+
          '<div class="seg2">'+CV_RADII.map(function(r, i){
            return '<button data-cvr="'+r[0]+'"'+(i===ri?' class="on"':'')+'>'+esc(r[1])+'</button>';
          }).join('')+'</div>'+
          /* the always-on gloss under the segment becomes the chip: the three
             option names are the label, and what to do when the lighting
             changes is the consequence you go looking for */
          helpHTML('cv-radius', 'How close the colour has to be',
            '<b>Exact</b> matches only that colour. <b>Loose</b> also matches '+
            'near-misses — go looser if it loses the target when the lighting '+
            'changes.')+
          (presets ? '<div style="font-size:13.5px;font-weight:600;margin-top:14px">'+
              'Or start from a common one</div><div class="seg2">'+presets+'</div>' : '')+
        '</div>';
    }

    /* ── the picture's own switches ──────────────────────────────────
       Painted from `pic`, which is painted from the board — never from what
       was tapped. Built by hand rather than with toggleFld()/seg() because
       phone.html's wire() runs ONCE, before this screen's after() hook, so a
       control re-drawn on every poll would never be wired by it: this screen's
       own delegated listeners own these, exactly as they own the mode bar.

       No frames-per-second figure is promised anywhere in here. What the
       target-finding gets back depends on how hot the board is and what else
       it is doing, and an invented number would be the first thing on this
       screen to be wrong. */
    function picHtml(){
      var on = !picOff();
      var idx = cvPicSizeIdx(pic.width);
      /* The whole row and the switch inside it carry the SAME data-cvpic, so
         one closest() lookup answers "what was tapped" whether the finger
         landed on the switch or anywhere along the row. */
      var sw = function(id, on2, label){
        return '<span class="sw'+(on2?' on':'')+'" data-cvpic="'+id+'" role="switch" '+
          'tabindex="0" data-nosave="1" aria-checked="'+(on2?'true':'false')+'" '+
          'aria-label="'+esc(label)+'"></span>';
      };
      /* margin-top by hand: the kit's spacing rule is `.vizbox + .grp-card`,
         and this card lives inside its own #cv-pic slot so it is not that
         card's sibling. Without this it butts straight against the picture. */
      var h = '<div class="grp-card" style="margin-top:12px'+
          (picBusy?';opacity:.55':'')+'">'+
        '<div class="fld tapper" data-cvpic="show">'+
          '<div class="flab">Show the picture'+
            /* the fear this switch has to answer in its own sub-line: aim
               help does NOT stop with the preview — detection reads the raw
               frame from the card, and the board saves the encoding work */
            '<em>aim help keeps working with it off — the adapter saves '+
            'the effort</em></div>'+
          sw('show', on, 'show the picture')+
        '</div>';
      if(on){
        h += '<div class="fld col"><div class="flab">How big to send it</div>'+
            '<div class="seg2" data-nosave="1">'+CV_PIC_SIZES.map(function(s, i){
              return '<button data-cvpw="'+s[0]+'"'+(i===idx?' class="on"':'')+'>'+
                esc(s[1])+'</button>';
            }).join('')+'</div></div>'+
          '<div class="fld tapper" data-cvpic="grey">'+
            '<div class="flab">Black and white'+
              '<em>cheaper for the adapter — changes nothing it finds</em></div>'+
            sw('grey', !!pic.grey, 'black and white picture')+
          '</div>';
      }
      /* KEEP THESE FRAMES (2026-08-19: 'just add a button so i can take a
         screenshot in the app and it saves it for you') lived here. It is a
         tool for whoever is debugging the detector, so since D223 it is in
         Global Settings > Developer (a dev build only), with its wiring. */
      h += '</div>';

      /* the three explanatory notes this card used to stack became ONE "?"
         (screen-map §6 Advanced) — the switch sub-lines carry the short
         version, the fold carries the mechanism */
      h += helpHTML('cv-pichelp', 'The picture',
        'Turning the picture off does <b>not</b> switch anything else off — detection reads '+
        'the raw frame from the capture card, and this preview exists only so <i>you</i> can '+
        'watch. A smaller picture is less work to make and send; it does not change what the '+
        'adapter can see. Black and white is cheaper to make and changes nothing about what '+
        'it finds.');

      if(picOld){
        h += note('<b>Your adapter did not understand that.</b> Its software has no off switch for '+
          'the picture: this app has stopped asking, but the adapter is still making them — '+
          'update it.'+
          (picSaid ? '<br>It said: “'+esc(picSaid)+'”.' : ''), 'warn');
      }
      return h;
    }

    /* picRowHtml — the Play-tab twin of the picture switch — is GONE
       (screen-map §6): the preview has ONE home now, the Advanced "The
       picture" fold (#cv-pic), which also inherited the Keep-these-frames
       burst button. One switch, one painter, nothing to keep in step. */

    /* ── the game-profile button, the top of Play ─────────────────── */
    /* Which game this config is tuned for, read from the discriminator —
       never from anything a poll invents, so identical profile state paints
       an identical string and put()'s cache leaves the node alone. */
    function profArt(vis, tools){
      if(tools.colour && vis.target && typeof vis.target === 'object' &&
         (vis.target.swatch || vis.target.color)){
        return '<span style="flex:none;display:inline-block;width:18px;height:18px;'+
          'border-radius:5px;border:1px solid rgba(255,255,255,.25);'+
          'background:#'+cvHex(vis.target.swatch || vis.target.color)+'"></span>';
      }
      if(window.ZSLOGO && ZSLOGO.reticle){
        return '<span style="flex:none;display:flex" aria-hidden="true">'+
          ZSLOGO.reticle({size:20,
            state:(tools.colour || tools.model || tools.shot) ? 'locked' : 'idle'})+'</span>';
      }
      return '<span style="flex:none;width:18px;height:18px;border-radius:5px;'+
        'border:1px solid var(--line)"></span>';
    }
    /* the shelf cache may name a pack that only wrote its id — a lookup,
       not a fetch, so a not-yet-loaded shelf costs '' and the name upgrades
       in one cache-guarded repaint when the list lands */
    function pkNameById(id){
      if(!id || !pkAll) return '';
      for(var i=0;i<pkAll.length;i++){
        if(pkAll[i] && pkAll[i].id === id) return String(pkAll[i].name || '');
      }
      return '';
    }
    function profIdentity(){
      var vis = cvVis(), tools = cvToolsOf(vis);
      /* the SHOT tool counts: a shot-timing pack with no colour and no
         model is a pack in use, and this button calling it "Blank" was the
         door denying the very pack behind it */
      /* ...and so does an installed colour pack that has not been taught its
         colour yet. Calling THAT "Blank — no pack in use" was the door
         denying a pack the owner had installed thirty seconds earlier. */
      if(!tools.colour && !tools.colourPending && !tools.model && !tools.shot){
        /* "no PACK in use", not "no game selected" — the config's own game
           identity (the one-way latch) now owns the word "game" on this
           screen, and one word doing two jobs is how a screen stops being
           readable (task #150 / game-lock spec §6) */
        return {name:'Blank', sub:'no pack in use — tap to choose',
                chips:[], art: profArt(vis, tools)};
      }
      var chips = [];
      if(tools.shot)   chips.push('timing');   /* timing first, here too */
      if(tools.colour) chips.push('colour');
      /* WORDS, not a colour or a missing chip: the state is "the colour tool
         is here and it has no colour", and the chip says exactly that. */
      else if(tools.colourPending) chips.push('colour — untaught');
      if(tools.model)  chips.push('model');
      var name = vis.packName || pkNameById(vis.packId) || vis.name || '';
      if(!name){
        return {name:'Custom tuning', sub:'tuned by hand — tap to change',
                chips:chips, art: profArt(vis, tools)};
      }
      return {name:String(name),
              sub:(tools.colourPending && !tools.colour
                    ? 'installed — teach it the colour on Tune'
                    : (vis.game ? 'for '+vis.game+' — tap to change'
                                : 'tap to change')),
              chips:chips, art: profArt(vis, tools)};
    }
    function profChips(list){
      var h = '', i;
      for(i=0;i<list.length;i++){
        h += '<span style="font-size:11px;font-weight:600;border:1px solid var(--line);'+
          'border-radius:999px;padding:2px 8px;margin-left:6px;color:var(--muted);'+
          'vertical-align:1px">'+esc(list[i])+'</span>';
      }
      return h;
    }
    function profHtml(){
      /* THE DOOR HAS TO LOOK LIKE A DOOR (task #150): an eyebrow naming what
         the button IS, and a trailing chevron — without them this read as a
         status header and nobody found the pack shelf behind it. Both
         additions are visual only: the eyebrow is aria-hidden because the
         aria-label already opens with "game profile", so announced text is
         unchanged to the byte. */
      var pi = profIdentity();
      return '<button class="pbtn" data-cvprof="1" style="display:flex;'+
        'align-items:center;width:100%;min-height:56px;justify-content:flex-start;'+
        'text-align:left" aria-label="game profile: '+esc(pi.name)+' — '+
        esc(pi.sub)+'">'+
        pi.art+
        '<span style="min-width:0;flex:1;margin-left:10px">'+
          '<span aria-hidden="true" style="display:block;font-size:10px;'+
            'font-weight:700;letter-spacing:.09em;color:var(--muted)">GAME PROFILE</span>'+
          '<b style="display:block;font-size:15px">'+esc(pi.name)+
            profChips(pi.chips)+'</b>'+
          '<span style="display:block;color:var(--muted);font-size:12px;'+
            'margin-top:1px">'+esc(pi.sub)+'</span>'+
        '</span>'+
        '<span aria-hidden="true" style="flex:none;margin-left:8px;'+
          'color:var(--muted);font-size:19px">›</span></button>';
    }

    /* ── the trained model's live line, painted from status ───────── */
    function modelStatHtml(){
      var m = st && st.model;
      if(!m || typeof m !== 'object' || !m.configured) return '';
      var name = (m.spec && m.spec.name) ? String(m.spec.name) : 'trained model';
      var h = '<div class="stat"><span>Model</span><b>'+esc(name)+'</b></div>'+
        '<div class="stat"><span>State</span><b>'+
        (m.ready ? 'ready'+(m.runtime ? ' · '+esc(String(m.runtime)) : '')
                 : 'not loaded')+'</b></div>';
      var said = m.loadError || m.warning;
      if(said) h += note(esc(String(said)), 'warn');
      return h;
    }

    /* ── WHICH KIND OF METER THIS CONFIG HAS, and the words that go with
       it. Two of the three reads have a GREEN BAND — a marker sliding along
       a track, or a fill whose leading edge is the reading — and the whole
       setup story was written for them: draw a box, tap the bar, tap the
       green. The third, "grow", has no band and no track. 2K26's meter is an
       arrow that LENGTHENS beside the player: the board measures how long the
       magenta body gets and divides by the meter's full length (meter.py's
       `_read_grow` never looks at a zone colour at all). Every sentence that
       says "green" is a lie on that config — it sends the owner hunting for a
       colour that is not part of his setup — so each one asks here first.
       Profile-side, like cvToolsOf: the read comes from the config's own
       meter block, so a status poll can never change the wording. */
    function meterOf(){
      var vv = cvVis();
      var sa = (vv.shotAssist && typeof vv.shotAssist === 'object')
                ? vv.shotAssist : {};
      return (sa.meter && typeof sa.meter === 'object') ? sa.meter : {};
    }
    function growMeter(){ return meterOf().read === 'grow'; }
    /* what the release is aimed AT, in words that are true for this meter */
    function releaseSay(){
      return growMeter() ? 'at the right moment' : 'at the green';
    }

    /* ── the shot assist's landed readout ───────────────────────────
       Two boards report on one feature and this card shows both honestly:
       the ACTION side (ZS.live.status.shotAssist — the holder: did it fire,
       what declined, the learned latency) and the VISION side
       (st.shotAssist — the service: is a meter taught, why not).

       THE MILLISECOND LINE IS THE SCHEDULER'S, NOT THE METER'S. lastErrorMs
       is how long after the planned instant the release actually went out —
       the board's own errorMsMeaning field spells this out — and the meter
       verdict is a WORD from the game's own feedback text. Printing a
       meter-error millisecond here would be a fabricated number: the board
       cannot measure one, so this card does not show one. */
    var SHOT_STATE_WORDS = {
      idle: 'waiting for a shot',
      tracking: 'watching the meter',
      armed: 'watching the meter',
      released: 'let go for you',
      declined: 'stood back — your own timing applied',
      calibrating: 'learning this rig'
    };
    /* ── THE TWO NUMBERS A "GROW" METER IS ACTUALLY READ BY ─────────
       `spanFrac` and `growAtFrac` had no control and no readout anywhere in
       this app, and they are the entire reading: the board divides the taught
       colour's run by `spanFrac` to get "how far through the shot you are",
       and lets go at `growAtFrac` along that length. A pack whose `spanFrac`
       was measured on somebody else's capture reads every meter as
       half-grown and never fires — and until now that was invisible from the
       phone, because the card said "taught ✓" and stopped. Two rows are all
       it takes to make the wrong number visible.

       READ-ONLY on purpose. The board has no route that MEASURES a span (the
       teach endpoint takes a box and two colours and nothing else), so a
       number typed in here would be a guess wearing a measurement's clothes
       — and this card's whole rule is that it never shows a number the board
       cannot stand behind. Seeing it is what was missing; changing it needs
       a way to measure it first.

       Said as percentages of what the eye can see, not as frame fractions:
       the meter's length is a share of the screen's width (or its height, on
       a vertical meter), and the release point is a share of the meter. */
    function growNumsHtml(){
      if(!growMeter()) return '';
      var m = meterOf();
      var span = Number(m.spanFrac);
      var side = m.axis === 'y' ? 'height' : 'width';
      var at = typeof m.growAtFrac === 'number' ? m.growAtFrac : 1.0;
      var half = (typeof m.growWidthFrac === 'number' ? m.growWidthFrac : 0.08) / 2;
      var h = '<div class="stat"><span>A full meter is</span><b>'+
        (span >= 0.01
          ? esc(String(Math.round(span * 100)))+'% of the screen’s '+side
          : 'not measured yet')+'</b></div>';
      /* the release point only means something once there is a length for it
         to be a fraction OF */
      if(span >= 0.01){
        h += '<div class="stat"><span>It lets go at</span><b>'+
          esc(String(Math.round(at * 100)))+'% grown — anywhere from '+
          esc(String(Math.round(Math.max(0, at - half) * 100)))+'% to '+
          esc(String(Math.round((at + half) * 100)))+'%</b></div>';
      }
      return h;
    }
    /* THE HOLDER'S OWN STATUS, named once. /status's `shotAssist` IS
       ShotAssistHolder.status() (core/engine.py), so it is the ACTION side's
       report — state, counts, reasons, the latch and the tape. Two renderers
       read it now (this card and the release-timing outcome block), and two
       copies of the same expression is how two renderers come to disagree. */
    function shotHolder(){
      return (ZS.live.status && ZS.live.status.shotAssist &&
              typeof ZS.live.status.shotAssist === 'object')
             ? ZS.live.status.shotAssist : null;
    }
    function shotStatHtml(){
      var vv = cvVis();
      if(!cvToolsOf(vv).shot) return '';
      var hs = shotHolder();
      var vs = (st && st.shotAssist && typeof st.shotAssist === 'object')
               ? st.shotAssist : null;
      if(!hs){
        /* the config asks for it and the board has never mentioned it —
           an adapter from before the feature. Say so, never guess. */
        return note('Your adapter hasn’t reported a shot assist yet — it '+
                    'may need a software update before this switch can do '+
                    'anything.', 'warn');
      }
      /* ── WHOSE LATENCY NUMBER IS THE TRUE ONE. A STOPGAP, NAMED AS ONE ──
         `holder.calibrating` is true and `holder.latencyMs` is 0.0
         PERMANENTLY on the board as it stands: actions/shot_assist.py sets
         the flag at construction, its only writer is note_latency(), and
         note_latency's only caller is the verdict path in service.py — which
         can never run while feedbackRegion is "". So this card was printing
         "Calibrating — still learning this rig's delay" directly above a
         manual timing control, which is the one pairing that would make the
         whole feature read as broken, and "This rig runs behind by 0 ms"
         beside it.
         The VISION side's LatencyTrim.to_dict() (st.shotAssist.latency) is
         the honest copy of both numbers, so prefer it and fall back to the
         holder's for an adapter too old to send it.
         THE REAL FIX IS ONE LINE ON THE BOARD: service.py should call
         holder.note_latency(trim.latency_ms, trim.calibrating) at configure
         time, so /status and /vision/status agree for every consumer —
         including the PC dashboard, which reads /status and cannot see the
         vision copy at all. Delete this fallback when that lands. */
      var lat = (vs && vs.latency && typeof vs.latency === 'object')
                ? vs.latency : null;
      var latMs = (lat && typeof lat.latencyMs === 'number') ? lat.latencyMs
                : (typeof hs.latencyMs === 'number' ? hs.latencyMs : null);
      var calib = lat ? !!lat.calibrating : !!hs.calibrating;
      var h = '';
      var word = SHOT_STATE_WORDS[String(hs.state)] || String(hs.state || '—');
      h += '<div class="stat"><span>Right now</span><b>'+esc(word)+'</b></div>';
      if(calib){
        h += '<div class="stat"><span>Calibrating</span>'+
             '<b>still learning this rig’s delay</b></div>';
      }
      if(hs.warning) h += note('⚠ '+esc(String(hs.warning)), 'warn');
      /* the meter, in the BOARD's own words: vs.taught is the vision
         service's fact, vs.reason its own sentence about what to do next —
         and the "teach me" line is now a button that starts the hand flow
         on the picture above. */
      if(vs && typeof vs.taught === 'boolean'){
        h += '<div class="stat"><span>Meter</span><b>'+
             (vs.taught ? 'taught ✓' : 'not taught yet')+'</b></div>';
      }
      h += growNumsHtml();
      /* ── "CAN'T SEE IT" AND "SAW IT, DIDN'T FIRE" ARE DIFFERENT THINGS ──
         and only the first one is something you can go and fix. A card that
         reports a fit problem when the truth is that the taught colour is
         not on screen sends the user to tune the wrong thing, and this is
         the person the whole product is for. The board reports the two
         separately (vision status meter.found / meter.notFoundWhy is stage
         1; hs.lastReason is a GATE, which only means anything about a meter
         the board could see), so this shows them separately too. */
      var vm = (vs && vs.meter && typeof vs.meter === 'object') ? vs.meter : null;
      if(vm && vm.hunting){
        h += '<div class="stat"><span>Finding the meter</span><b>'+
             (vm.found === false ? 'can’t see it in your box'
              : vm.found === true ? 'found it ✓'
              : 'nothing to find yet — take a shot')+'</b></div>';
        if(vm.found === false && vm.notFoundWhy){
          h += note('<b>It cannot see the meter in your box.</b> '+
                    esc(String(vm.notFoundWhy))+'<br>Nothing is being '+
                    'touched — your own timing is what applied.', 'warn');
        } else if(vm.found === true && hs.lastReason && !(hs.declined === 0)){
          h += note('<b>It found the meter and stood back.</b> '+
                    esc(String(hs.lastReason))+' — your own release is what '+
                    'happened, which is the safe answer.');
        }
      }
      if(vs && vs.reason) h += note(esc(String(vs.reason)));
      h += shotTeachHtml(vs);

      /* ── "WHY IT DID THAT" — THE DRAWER ──────────────────────────────
         Everything below this line is a number that explains a shot AFTER
         the fact. It used to be the top of the card, in front of the one
         control the owner steers with, and one of those numbers was actively
         misleading him: "Last release went out N ms after the planned moment"
         was printed unconditionally, so a value from a fired shot sat there
         through the next seven declines looking like a fresh reading. Worse,
         the payload's own errorMsMeaning says it is loop quantisation and
         "not how early or late you were on the meter" — which is exactly what
         a man tuning his release timing would read it as.

         So it folds away. The per-shot outcome block above (#cv-rt-out) is
         what answers "what just happened"; this is what answers "and why".
         The two WARN notes stay outside the drawer, above: a warning nobody
         opened the drawer to find is a warning that did not happen. */
      var why = '';
      if(typeof hs.lastErrorMs === 'number'){
        why += '<div class="stat"><span>Last release went out</span><b>'+
               esc(String(Math.round(hs.lastErrorMs)))+
               ' ms after the planned moment</b></div>'+
               note('That is the loop’s own rounding — how long after the '+
                    'instant it planned the release actually went out. It is '+
                    '<b>not</b> how early or late you were on the meter; only '+
                    '2K can tell you that.');
      }
      if(hs.lastVerdict){
        why += '<div class="stat"><span>The game called it</span><b>'+
               esc(hs.lastVerdict === 'green' ? 'green ✓'
                   : 'slightly '+String(hs.lastVerdict)+
                     ' — the timing is being nudged')+'</b></div>';
      }
      /* "the release window", not "the green window": on a 2K26-style meter
         there is no green band at all — the window is a stretch of the
         meter's own length — and the phrase has to be true of both kinds,
         because it is the same windowHitRate either way. */
      if(typeof hs.windowHitRate === 'number'){
        why += '<div class="stat"><span>Landed in the release window</span><b>'+
               esc(String(Math.round(hs.windowHitRate * 100)))+
               '% of graded shots</b></div>';
      }
      why += '<div class="stat"><span>Shots it stood back from</span><b>'+
             esc(String(typeof hs.declined === 'number' ? hs.declined : '—'))+
             '</b></div>';
      /* Only when something WAS stood back from. The holder has a measured
         bug (its verifier's own finding) where a successful release leaves
         lastReason reading "too late to help" — G8 fires on the frames after
         commitment and note_declined overwrites the field. Until the board
         side roots that out, a reason with zero declines is noise, and
         labelling a perfect shot "too late to help" is worse than a blank
         row. The row already belongs to the declines count above anyway. */
      var vmWhy = vm && !vm.found && vm.notFoundWhy;
      if((hs.lastReason && !(hs.declined === 0)) || vmWhy){
        why += '<div class="stat"><span>Why, last time</span>'+
               '<b style="font-size:12px;max-width:62%;text-align:right">'+
               esc(String(vmWhy || hs.lastReason))+'</b></div>';
      }
      /* THE LEARNED LATENCY IS A RELATIONSHIP, NOT A SECOND KNOB, and it is
         worded as one. It is the pack's rig-independent starting point, its
         SENSE IS INVERTED relative to the release timing above (latency up =
         earlier; the trim up = later), and a control on it would appear inert
         anyway — service.py rebinds the trim rather than rebuilding it, so
         the learned value survives a profile edit. Two ms numbers presented
         as two knobs on one visible card would contradict each other. */
      if(latMs !== null){
        why += '<div class="stat"><span>Before your nudge</span><b>it lets go '+
               esc(String(Math.round(latMs)))+
               ' ms early to cover this rig</b></div>'+
               note('That number is the board’s own starting point for your '+
                    'capture card and display. <b>When it lets go</b>, above, '+
                    'rides on top of it.');
      }
      if(typeof hs.windowHitRate === 'number'){
        why += note('“Landed in the release window” is all the board can see — '+
                    'whether the ball went in is the game’s own maths, and '+
                    'this card never claims it.');
      }
      /* The accordion is hand-rolled rather than acc()'d for one reason: this
         is a put()-repainted slot, so wire()'s accordion pass — which runs
         before the slot has any content — can never reach it. Its open state
         therefore lives in the module var whyOpen and its header is delegated
         from shotStatEl, exactly the way #cv-hexacc is from calEl. */
      h += '<div class="acc'+(whyOpen?' open':'')+'" id="cv-shotwhy">'+
           '<div class="ah" role="button" tabindex="0" aria-expanded="'+
             (whyOpen?'true':'false')+'">Why it did that'+
             '<span class="chev">›</span></div>'+
           '<div class="ab">'+why+'</div></div>';
      return h;
    }

    /* the teach flow's own controls — a pure function of (shotTeach,
       shotBusy, vs.taught), so the status poll repaints byte-identical
       state and put()'s cache leaves the card alone */
    /* The board's own two ceilings on the search box, mirrored here ONLY to
       tell the truth about a drag while it is happening. The board is still
       the gate — this never clamps and never blocks the send; a box that is
       too big gets the board's own sentence back, verbatim. Saying the number
       out loud as the finger moves is the difference between "it did not
       work" and "that is 47%, the most is 40%". */
    var SHOT_MAX_SEARCH = 0.40;   /* meter.MAX_SEARCH_AREA_FRAC */
    var SHOT_MAX_PINNED = 0.15;   /* meter.MAX_METER_AREA_FRAC  */
    function shotBoxLine(){
      if(!shotTeach) return '';
      var q = cvRect(shotTeach.rect), a = q[2]*q[3];
      var pct = Math.round(a*100);
      if(a > SHOT_MAX_SEARCH){
        return note('That box is <b>'+pct+'% of your screen</b> — the most it '+
                    'will take is '+Math.round(SHOT_MAX_SEARCH*100)+'%. Make '+
                    'it a bit smaller before you go on.', 'warn');
      }
      if(a > SHOT_MAX_PINNED){
        return note('That box is <b>'+pct+'% of your screen</b>. That is fine '+
                    'once you have tapped the meter bar on the next step — '+
                    'that colour is what lets it hunt inside a box this big.');
      }
      return note('That box is <b>'+pct+'% of your screen</b>.');
    }

    /* HOW MANY STEPS THERE ARE DEPENDS ON THE METER, and saying "of 3" on a
       meter with two steps is the same lie as asking for a green band that
       does not exist. A marker or an edge meter is taught in three: the box,
       the bar's colour, the green band it releases on. A "grow" meter has no
       band — the board reads how long the bar gets — so teaching its colour
       IS the last step, and the flow finishes there rather than sending the
       user to tap a colour nothing will ever read (meter.py's `_read_grow`
       does not look at `zone`, and `MeterConfig.taught` for a grow meter asks
       only for the bar colour and a measured length). */
    function shotSteps(){ return growMeter() ? 2 : 3; }
    function shotTeachHtml(vs){
      if(shotTeach){
        var n = shotSteps();
        /* A grow meter's flow never reaches the zone phase — shotColourTap
           finishes at the bar. If one ever turns up anyway (a config that
           changed kind mid-teach, a phase left behind by an older build), the
           bar step is the truthful thing to draw; the green one would be the
           exact instruction this whole change exists to stop giving. */
        var phase = (n === 2 && shotTeach.phase === 'zone') ? 'bar'
                                                            : shotTeach.phase;
        if(phase === 'box'){
          return note('<b>Step 1 of '+n+' — draw where to watch.</b> Drag a box on the '+
                 'picture above round the part of your screen the shot meter moves '+
                 'about in. It does not have to be tight: your meter sits above your '+
                 'player’s head, so it travels with him. Drag the middle to move the '+
                 'box, a white dot to resize it, or draw a fresh one.')+
            shotBoxLine()+
            '<button class="btn primary" id="cv-shot-next">'+
            'That’s where to watch — next</button>'+
            '<button class="btn" id="cv-shot-cancel">Cancel teaching</button>';
        }
        if(phase === 'bar'){
          return note('<b>Step '+(n===2?'2 of 2 — tap the meter itself.':
                                          '2 of 3 — tap the meter bar.')+'</b> '+
                 'Take a shot so the meter is on screen, then tap the '+
                 '<b>bar itself</b> on the picture above — '+
                 (n===2 ? 'the coloured part of the meter. That colour is the '+
                          'whole reading: your adapter measures how far it has '+
                          'grown and lets go when it is far enough.'
                        : 'the coloured strip, not the green part. That colour '+
                          'is how your adapter finds the meter wherever you '+
                          'are standing.'))+
            (shotBusy ? '<button class="btn" disabled>Reading…</button>' : '')+
            /* "my meter never moves" pins the box AND teaches no colour, and a
               grow meter is read by its colour — offering it there would be
               offering a way to finish with nothing to measure. */
            (n===2 ? '' : '<button class="btn" id="cv-shot-pin"'+(shotBusy?' disabled':'')+'>'+
                          'Skip — my meter never moves</button>')+
            '<button class="btn" id="cv-shot-cancel">Cancel teaching</button>';
        }
        return note('<b>Step 3 of 3 — tap the green.</b> Take a shot so the meter '+
               'shows its <b>green band</b>, then tap that green band on the picture '+
               'above. That is the colour it lets go on. Your adapter reads both '+
               'colours off its own screen at the exact spots you tapped.')+
          (shotBusy ? '<button class="btn" disabled>Reading…</button>' : '')+
          '<button class="btn" id="cv-shot-cancel">Cancel teaching</button>';
      }
      return btn(vs && vs.taught ? 'Teach the meter again' : 'Teach it the meter',
                 vs && vs.taught ? '' : 'primary', 'cv-shot-teach');
    }

    /* ── the hand-level line at the top of the Shot assist card ──────
       The owner's ask, verbatim: "what button to hold and realease when".
       The REAL button of the pad in your hands (glyphs.js), and the
       SENTENCE carries the whole meaning — the glyph is decorative inside
       an aria-hidden wrapper (RULE ZERO: ZSG.glyph ships its own role=img
       label, and without the wrapper a screen reader would say the button's
       name twice). A pure function of (profile button, pad family), painted
       through put() every poll, so moving the button on Tune or swapping
       the pad updates this sentence within a poll and an unchanged poll
       writes nothing. */
    function shotLineHtml(){
      var vv = cvVis();
      if(!cvToolsOf(vv).shot) return '';
      var sa = (vv.shotAssist && typeof vv.shotAssist === 'object')
                ? vv.shotAssist : {};
      var code = (typeof sa.button === 'string' && sa.button) ? sa.button : 'west';
      var fam = ZS.padFam ? ZS.padFam(p) : 'xb';
      var name = (window.ZSG && ZSG.label) ? ZSG.label(code, fam) : code;
      var art = window.ZSG
        ? '<span class="gly-deco" aria-hidden="true" style="flex:none;'+
          'width:24px;height:24px">'+ZSG.glyph(code, fam)+'</span>'
        : '';
      return '<div style="display:flex;align-items:center;gap:9px;'+
        'padding:2px 0 10px">'+art+
        '<span style="font-size:13.5px;line-height:1.45">Hold <b>'+esc(name)+
        '</b> to shoot — your adapter lets go '+
        (growMeter() ? 'for you' : 'at the green')+'.</span></div>';
    }

    /* ── THE DELAY LINE (D90): what the board plans with, and where it came
       from. One sentence, painted every poll.

       THE NUMBER is the vision side's LatencyTrim.latencyMs (st.shotAssist
       .latency) — that IS what the predictor subtracts (service.py: latency_ms
       = trim.latency_ms) — and, before the board has answered, the config's
       own vision.shotAssist.latencyMs, which is what the trim starts from.
       The holder's copy on /status is not read here: it is the stale display
       the card's stopgap above already documents (0.0 and "calibrating"
       forever on the live board).

       THE SOURCE is derived from what the board exposes TODAY and nothing
       invented: the trim's `verdicts` count and its `startedAtMs` say
       whether the game's early/late text has moved the number ("learned
       from your shots"); the schema's shipped 90 says "the default guess";
       any other number was set in the config and the board keeps no record
       of when or over which path — so the line says exactly that. The one
       provenance the app CAN state is its own: an Apply from the Measure my
       delay sheet remembers {ms, date, backend} on this phone, and the line
       reads "measured <date> over <path>" only while the config still holds
       that very number and the trim has not learned past it. When the board
       grows a provenance field, read it here and delete the local memory. */
    function delayLineHtml(){
      var vv = cvVis();
      if(!cvToolsOf(vv).shot) return '';
      var sa = (vv.shotAssist && typeof vv.shotAssist === 'object')
                ? vv.shotAssist : {};
      var cfg = (typeof sa.latencyMs === 'number') ? sa.latencyMs : null;
      var vs = (st && st.shotAssist && typeof st.shotAssist === 'object')
               ? st.shotAssist : null;
      var lat = (vs && vs.latency && typeof vs.latency === 'object')
                ? vs.latency : null;
      var now = (lat && typeof lat.latencyMs === 'number') ? lat.latencyMs : cfg;
      if(typeof now !== 'number'){
        return '<div class="dlline">Your adapter has not said what delay it '+
               'plans with yet.</div>';
      }
      var started = (lat && typeof lat.startedAtMs === 'number') ? lat.startedAtMs : cfg;
      var learned = !!lat && ((Number(lat.verdicts) || 0) > 0 ||
                    (typeof started === 'number' &&
                     Math.round(lat.latencyMs) !== Math.round(started)));
      /* THE BOARD'S OWN PROVENANCE, when it sends one (D89): the trim's
         `seed` — {ms, source: profile|learned|measured, backend, profileMs}
         — says what this session's number STARTED as and over which output.
         It carries no date; the app's memory of its own Apply supplies that,
         and only while the seed is the very number it applied. A board from
         before D89 sends no seed block and the memory stands on its own. */
      var seed = (lat && lat.seed && typeof lat.seed === 'object') ? lat.seed : null;
      var mem = ZS.store.vals['delaymeasured|'+p.id];
      var memHit = !!(mem && typeof mem.ms === 'number' && Math.round(mem.ms) === Math.round(now));
      var src;
      if(learned){
        src = 'learned from your shots'+
              (typeof started === 'number' ? ' (started at '+Math.round(started)+' ms)' : '');
      } else if(seed && seed.source === 'measured'){
        src = 'measured'+(memHit && mem.at ? ' '+esc(String(mem.at)) : '')+
              ' '+esc(mdPathWords(seed.backend || (memHit ? mem.backend : '')) || 'on this adapter');
      } else if(seed && seed.source === 'learned'){
        src = 'remembered from your earlier shots'+
              (seed.backend ? ' '+esc(mdPathWords(seed.backend)) : '');
      } else if(memHit){
        /* an older board with no seed block: the app's own memory of its
           Apply, and only while the number the running assist reports is
           still that very number */
        src = 'measured '+esc(String(mem.at || ''))+
              (mem.backend ? ' '+esc(mdPathWords(mem.backend)) : '');
      } else if(Math.round(now) === MD_DEFAULT_MS){
        src = 'the default guess';
      } else {
        src = 'set in this config — your adapter keeps no record of how';
      }
      /* the config holds a number the running assist has not read yet (an
         edit the board has not re-configured on): say both, never pretend
         the one is the other. With a seed block the number the trim READ
         from the config is `seed.profileMs`; without one, only the live
         number can stand in for it. */
      var read = (seed && typeof seed.profileMs === 'number') ? seed.profileMs : now;
      var lag = (!learned && typeof cfg === 'number' && Math.round(cfg) !== Math.round(read))
        ? ' This config says '+Math.round(cfg)+' ms; the running assist has not picked it up yet.'
        : '';
      var trim = Math.round(Number(sa.aimOffsetMs) || 0);
      return '<div class="dlline">Plans with a delay of <b>'+Math.round(now)+
        ' ms</b> — '+src+'.'+lag+
        (trim ? ' Your nudge of '+(trim > 0 ? '+' : '−')+Math.abs(trim)+
                ' ms sits on top.' : '')+'</div>';
    }
    /* the slot: the line, then the one key. A 44 px .btn (--btn-min), named
       for what it does; aria-expanded so the sheet's opener bookkeeping
       (ZS.sheetOpen's fourth argument) can say the sheet is up. */
    function delayHtml(){
      if(!cvToolsOf(cvVis()).shot) return '';
      /* the product gate (phone.html PRODUCTS, D102): a Core has no shot
         meter to time, so there is no delay to measure */
      if(ZS.productHides && ZS.productHides('measureDelay')) return '';
      return delayLineHtml()+
        '<button type="button" class="btn" id="cv-measure" aria-haspopup="dialog" '+
        'aria-expanded="false">Measure my delay</button>';
    }

    /* ── MEASURE MY DELAY (D90): one tap, against the board's D89 contract ──
         POST /measure/delay/start {button, presses, gapMs} → {ok, state}
         GET  /measure/delay/status → FLAT {ok, state: idle|running|done|
              failed, backend, button, pressesDone, pressesWanted, samplesMs,
              medianMs, p90Ms, suggestedLatencyMs, currentLatencyMs, error}
         POST /measure/delay/apply {} → {ok, latencyMs}  (refused unless done)
         POST /measure/delay/cancel → {ok, state: 'idle'}
       The board presses the shot button itself, a few times with a pause
       between, and times the meter's first change on its own capture — the
       press-to-pixel number docs/CV-LATENCY-PLAN.md says is the one unknown
       that decides everything, measured in the game, without the PC.

       NOTHING IS WRITTEN UNTIL APPLY. start, status and cancel touch no
       profile, the app sends no PUT of its own at any step, and the only
       write is the board's, on apply — after which the app RE-READS the
       profile rather than guessing what changed. Closing the sheet any way
       (×, scrim, Escape, Cancel) cancels a running measurement. Refusals and
       failures are the board's own sentence, shown in full because they
       answer a tap (D70's one exception); the wired-path caveat is advisory
       and folds into the chip. A board too old to know the route says so in
       the sheet and nothing throws. */
    var MD = null;   /* the open sheet's state, or null */
    function mdOpen(opener){
      if(ZS.live.online === false){
        ZS.toast('Your board is offline — measuring needs the board'); return;
      }
      if(MD) return;
      var M = MD = {phase:'ask', backend:'', res:null, timer:null, closed:false};
      ZS.sheetOpen('Measure my delay', mdAsking(), function(){
        M.closed = true;
        if(M.timer){ clearTimeout(M.timer); M.timer = null; }
        if(M.phase === 'running') ZS.api('/measure/delay/cancel', 'POST', {});
        if(MD === M) MD = null;
      }, opener);
      mdFetchState();

      /* the shot button, named and drawn in the family of the pad in your
         hands — the same translation shotLineHtml makes */
      function mdButton(){
        var vv = cvVis();
        var sa = (vv.shotAssist && typeof vv.shotAssist === 'object') ? vv.shotAssist : {};
        var code = (typeof sa.button === 'string' && sa.button) ? sa.button : 'west';
        var fam = ZS.padFam ? ZS.padFam(p) : 'xb';
        var name = (window.ZSG && ZSG.label) ? ZSG.label(code, fam) : code;
        var art = window.ZSG
          ? '<span class="gly-deco" aria-hidden="true">'+ZSG.glyph(code, fam)+'</span>'
          : '';
        return {code: code, name: name, html: art+'<b>'+esc(name)+'</b>'};
      }
      /* which path the presses go out over: the status's word first, the
         running config's own backend before the board has said */
      function mdCfgBackend(){
        var f = ZS.live.full[ZS.activeId] || ZS.live.full[p.id] || {};
        return (f.output && f.output.backend) || '';
      }
      function mdPath(){ return mdPathWords(M.backend || mdCfgBackend()); }
      function mdPaint(html){
        var sb = document.getElementById('sheetbody');
        if(!sb || M.closed) return;
        sb.innerHTML = '<div class="mdl">'+html+'</div>';
        var b;
        if((b = sb.querySelector('#md-start'))) b.addEventListener('click', mdStart);
        if((b = sb.querySelector('#md-again'))) b.addEventListener('click', function(){
          M.phase = 'ask'; mdPaint(mdAsking()); mdFetchState();
        });
        if((b = sb.querySelector('#md-apply'))) b.addEventListener('click', mdApply);
        if((b = sb.querySelector('#md-cancel'))) b.addEventListener('click', mdCancel);
        if((b = sb.querySelector('#md-done'))) b.addEventListener('click', function(){
          ZS.sheetClose();
        });
      }
      function mdSetText(id, text){
        var el = document.getElementById(id);
        if(el) el.textContent = text;
      }
      function mdAsking(){
        return '<p class="mdl-p">Asking your adapter…</p>'+btn('Cancel', '', 'md-cancel');
      }
      function mdIntro(){
        var b = mdButton();
        var runName = '';
        if(ZS.activeId && ZS.activeId !== p.id){
          var ap = ZS.live.full[ZS.activeId];
          runName = String((ap && ap.name) || ZS.activeId);
        }
        return '<p class="mdl-p">Your adapter will press '+b.html+' '+MD_PRESSES+
          ' times, with a pause between, and time how long each shot takes to '+
          'show on your screen.</p>'+
          '<p class="mdl-p">Be on the practice court with nobody guarding you, '+
          'and keep your hands off the pad. Nothing changes until you tap '+
          '<b>Use it</b> at the end.</p>'+
          '<div class="stat"><span>Goes out</span><b>'+esc(mdPath() || 'through your adapter')+'</b></div>'+
          (runName
            ? note('This measures the config your adapter is running now — <b>'+
                   esc(runName)+'</b> — not this one.', 'warn')
            : '')+
          btn('Start', 'primary', 'md-start')+btn('Cancel', '', 'md-cancel');
      }
      function mdProgWords(j){
        return 'Press '+(Number(j.pressesDone) || 0)+' of '+
               (Number(j.pressesWanted) || MD_PRESSES);
      }
      function mdSamplesWords(j, lead){
        var s = Array.isArray(j.samplesMs) ? j.samplesMs : [];
        if(!s.length) return 'Waiting for the first shot…';
        var out = [], i;
        for(i = 0; i < s.length; i++) out.push(String(Math.round(Number(s[i]) || 0)));
        return (lead || 'So far: ')+out.join(', ')+' ms';
      }
      function mdProgress(j){
        return '<p class="mdl-p"><span class="mdl-dot" aria-hidden="true"></span>'+
          'Measuring — hands off the pad.</p>'+
          '<div aria-live="polite">'+
            '<div class="mdl-big" id="md-prog">'+esc(mdProgWords(j))+'</div>'+
            '<div class="mdl-samples" id="md-samples">'+esc(mdSamplesWords(j))+'</div>'+
          '</div>'+
          btn('Cancel', '', 'md-cancel');
      }
      /* the result in plain words: the median is "about", the spread is the
         distance from the median to the 90th percentile, said as "give or
         take" — the two numbers the contract carries, no third invented */
      function mdResult(j, refusal){
        var med = Number(j.medianMs), p90 = Number(j.p90Ms);
        var n = Array.isArray(j.samplesMs) ? j.samplesMs.length : 0;
        var spread = (isFinite(p90) && isFinite(med)) ? Math.round(Math.abs(p90 - med)) : null;
        var use = Number(j.suggestedLatencyMs);
        if(!isFinite(use)) use = med;
        var cur = Number(j.currentLatencyMs);
        var h = '<p class="mdl-p">Your shots take about <b>'+Math.round(med)+
          ' ms</b> to show on screen'+
          (spread !== null ? ', give or take '+spread : '')+'.</p>'+
          '<div class="mdl-samples">'+esc(mdSamplesWords(j, n+' shot'+(n === 1 ? '' : 's')+': '))+'</div>'+
          '<div class="stat"><span>Your adapter plans with</span><b>'+
            (isFinite(cur) ? Math.round(cur)+' ms now' : 'not reported')+'</b></div>'+
          '<div class="stat"><span>Measured</span><b>'+esc(mdPath() || 'through your adapter')+'</b></div>';
        if(refusal) h += note('<b>It would not take that.</b> '+esc(String(refusal)), 'warn', true);
        h += btn('Use '+Math.round(use)+' ms', 'primary', 'md-apply')+btn('Cancel', '', 'md-cancel');
        return h;
      }
      function mdApplied(ms, nudgeReset){
        return '<p class="mdl-p">Done — your adapter now plans with <b>'+Math.round(ms)+
          ' ms</b>.'+
          /* said only when the re-read PROVED it: the board's apply puts the
             user trim back to 0 because the measured number now carries the
             transport the trim was standing in for (D89) */
          (nudgeReset ? ' Your nudge went back to 0 — the measured delay replaces it.' : '')+
          ' Take a few shots; the early/late text keeps tuning it from here.</p>'+
          btn('Done', 'primary', 'md-done');
      }
      /* the config's own trim, from the app's copy of the running profile */
      function mdTrimOf(){
        var f = ZS.live.full[ZS.activeId || p.id] || {};
        var sa = (f.vision && f.vision.shotAssist && typeof f.vision.shotAssist === 'object')
                  ? f.vision.shotAssist : {};
        return Math.round(Number(sa.aimOffsetMs) || 0);
      }
      function mdFailed(err){
        var e = String(err || '');
        var h = /unknown route/i.test(e)
          ? note('<b>Your adapter does not have this yet.</b> It needs the '+
                 'software update that adds the delay measurement.', 'warn', true)
          : note('<b>It could not finish.</b> '+esc(e || 'Your adapter gave no reason.'),
                 'warn', true);
        return h+btn('Try again', 'primary', 'md-again')+btn('Cancel', '', 'md-cancel');
      }
      function mdRefused(err){
        return note('<b>It would not start.</b> '+esc(String(err || 'Your adapter gave no reason.')),
                    'warn', true)+
          btn('Try again', 'primary', 'md-again')+btn('Cancel', '', 'md-cancel');
      }
      function mdSchedule(){
        if(M.closed) return;
        M.timer = setTimeout(mdPoll, MD_POLL_MS);
      }
      function mdFetchState(){
        ZS.api('/measure/delay/status').then(function(j){
          if(M.closed) return;
          if(!j || !j.ok){ M.phase = 'failed'; mdPaint(mdFailed(j && j.error)); return; }
          M.backend = String(j.backend || mdCfgBackend() || '');
          if(j.state === 'running'){
            M.phase = 'running'; mdPaint(mdProgress(j)); mdSchedule(); return;
          }
          if(j.state === 'done'){ M.phase = 'done'; M.res = j; mdPaint(mdResult(j)); return; }
          M.phase = 'intro'; mdPaint(mdIntro());
        });
      }
      function mdStart(){
        var b = mdButton();
        var k = document.getElementById('md-start');
        if(k) k.disabled = true;
        ZS.api('/measure/delay/start', 'POST',
               {button: b.code, presses: MD_PRESSES, gapMs: MD_GAP_MS}).then(function(j){
          if(M.closed) return;
          if(!j || !j.ok){ M.phase = 'refused'; mdPaint(mdRefused(j && j.error)); return; }
          M.phase = 'running';
          mdPaint(mdProgress({pressesDone: 0, pressesWanted: MD_PRESSES, samplesMs: []}));
          mdSchedule();
        });
      }
      function mdPoll(){
        M.timer = null;
        if(M.closed || M.phase !== 'running') return;
        ZS.api('/measure/delay/status').then(function(j){
          if(M.closed || M.phase !== 'running') return;
          /* one dropped poll is not a failed measurement; ask again */
          if(!j || !j.ok){ mdSchedule(); return; }
          if(j.state === 'running'){
            /* the two lines move IN PLACE — a repaint four times a second
               would steal the Cancel key's focus (the recorder's rule) */
            mdSetText('md-prog', mdProgWords(j));
            mdSetText('md-samples', mdSamplesWords(j));
            mdSchedule(); return;
          }
          if(j.state === 'done'){ M.phase = 'done'; M.res = j; mdPaint(mdResult(j)); return; }
          M.phase = 'failed';
          mdPaint(mdFailed(j.state === 'failed'
            ? j.error : 'the measurement was cancelled on your adapter'));
        });
      }
      /* re-read the profile the board wrote (the RUNNING one — the board
         measures and applies on the config it is playing, which may not be
         the one this card is about), so the delay line reads the board's
         own number rather than a guess at what apply did */
      function mdRefresh(done){
        var ids = [ZS.activeId || p.id];
        if(p.id !== ids[0]) ids.push(p.id);
        var left = ids.length;
        function one(id){
          ZS.api('/profiles/'+encodeURIComponent(id)).then(function(f){
            if(f && f.ok && f.data) ZS.live.full[id] = f.data;
          })['catch'](function(){}).then(function(){
            if(--left === 0 && done) done();
          });
        }
        var i;
        for(i = 0; i < ids.length; i++) one(ids[i]);
      }
      function mdApply(){
        var k = document.getElementById('md-apply');
        if(k) k.disabled = true;
        ZS.api('/measure/delay/apply', 'POST', {}).then(function(j){
          if(M.closed) return;
          if(!j || !j.ok){ mdPaint(mdResult(M.res || {}, (j && j.error) || 'no reason given')); return; }
          M.phase = 'applied';
          var ms = Number(j.latencyMs);
          /* the date is the one thing the board's own provenance (the trim's
             seed block) does not carry, so the app remembers its own Apply */
          var pid = ZS.activeId || p.id;
          ZS.store.vals['delaymeasured|'+pid] = {ms: ms, at: mdToday(), backend: M.backend};
          ZS.persistStore();
          var trimBefore = mdTrimOf();
          mdRefresh(function(){
            if(M.closed) return;
            mdPaint(mdApplied(ms, trimBefore !== 0 && mdTrimOf() === 0));
            paint();
          });
        });
      }
      function mdCancel(){
        /* every step's Cancel posts cancel — a sheet on the intro step has
           nothing running, and the board answers idle either way. The phase
           moves first so the sheet's onClose does not post a second one. */
        M.phase = 'cancelled';
        ZS.api('/measure/delay/cancel', 'POST', {});
        ZS.sheetClose();
      }
    }
    if(delayEl) delayEl.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('#cv-measure') : null;
      if(!b) return;
      mdOpen(b);
    });

    /* ── the mode bar, right under the picture ──────────────────── */
    function modeHtml(){
      /* THE TIMING SHAPE: a shot-timing pack has no colour to pick, so the
         seg would be one live button and one trap — and a stray "Pick a
         colour" tap writing vision.target would quietly flip this config
         into the aim layout. mode is forced to 'box' at wire time for the
         same reason, which keeps the pack's watched boxes draggable; the
         hint below tells the truth about exactly that. Painted differently
         rather than display-gated because this slot is already a pure
         function repainted through put()'s byte-compare cache. */
      var mTools = cvToolsOf(cvVis());
      if(mTools.shot && !mTools.colour && !mTools.colourPending && !mTools.model){
        return '<div style="color:var(--muted);font-size:11.5px;line-height:1.5;'+
          'margin-top:7px;text-align:left;padding:0 2px">'+
          (picOff()
            ? 'The picture is off. You can still drag the boxes this pack reads — '+
              'the black area keeps the shape of your screen. Turn it back on to '+
              'teach the meter.'
            : 'This pack reads your screen through the boxes below — drag the '+
              'middle of one to move it, a white dot to resize it. Teaching the '+
              'meter starts from the Shot assist card on Play.')+
          '</div>';
      }
      return '<div class="seg2" id="cv-modeseg" style="margin-top:2px">'+
          '<button data-cvm="colour"'+(mode==='colour'?' class="on"':'')+'>Pick a colour</button>'+
          '<button data-cvm="box"'+(mode==='box'?' class="on"':'')+'>Draw boxes</button>'+
        '</div>'+
        '<div style="color:var(--muted);font-size:11.5px;line-height:1.5;margin-top:7px;'+
          'text-align:left;padding:0 2px">'+
        (picOff()
          /* Honest about the ONE thing that stops working, and about the one
             that does not: the stage still keeps the shape of your screen, so
             a box drawn on it lands where you put it. Picking a colour is
             tapping a thing you can see, and there is nothing to see. */
          ? 'The picture is off. You can still draw, move and resize boxes — the '+
            'black area keeps the shape of your screen. Picking a colour means '+
            'tapping the thing you want it to notice, so turn the picture back on '+
            'for that.'
          : mode==='box'
          ? 'Drag on the picture to draw a box. Drag the middle of a box to move it, '+
            'drag a white dot to resize it, and tap a box to name it.'
          /* "Tap the picture on the colour you want your adapter to hunt for"
             was the FIRST of two sentences saying that on this tab — the
             card 150px below says it again, beside the Colour swatch it
             actually changes, which is where an instruction belongs. What
             only this strip can say is what switching modes costs you, and
             the answer is nothing: your boxes are still there. */
          : 'Your boxes stay put while you are picking a colour.')+
        '</div>';
    }

    /* ── the box list, under the picture ────────────────────────── */
    function boxListHtml(){
      var head = sh('Areas you are watching');
      var intro;
      if(ZS.live.online === false){
        /* pullRegions never asks an offline board, so reader stays null —
           without this branch the "asking…" spinner below would spin forever
           at a board that is not being asked anything */
        intro = note('Your adapter is offline. Boxes are saved in this config '+
                     'and will come back when it reconnects.');
      } else if(reader === false){
        /* one line of live capability + a "?" for the mechanism (screen-map
           §6) — the WARN half is state, the teaching half folds */
        intro = note('This adapter can <b>ignore</b> boxes; <b>watching</b> kinds need a region '+
            'reader it does not have yet.', 'warn')+
          helpHTML('cv-boxcap', 'What a box does',
            '<b>What a box does here today:</b> your adapter <b>skips</b> that part of the '+
            'screen when it hunts for your colour, so a red health bar stops looking like an '+
            'enemy. Each box below says whether your adapter picked it up. <b>Watching</b> a '+
            'box — for a colour, a word, a number — needs a region reader this adapter does '+
            'not have yet, so those choices stay switched off.');
      } else if(reader === null){
        /* a real wait, so the brand's scanning reticle stands in for a plain
           "loading" line — the words still say it (never motion alone), and
           put()'s cache keeps this node stable across polls so the loop runs */
        intro = note(
          (window.ZSLOGO && ZSLOGO.reticle
            ? '<span style="display:inline-block;vertical-align:-4px;margin-right:7px">'+
              ZSLOGO.reticle({size:18, state:'scanning', label:'asking your adapter'})+'</span>'
            : '')+
          'Asking your adapter what it can do with these boxes…');
      } else {
        /* DELETED, not folded: every row below carries its own live status
           chip ("ignored", "not set up", what it is seeing), and the boxes
           are drawn on the picture above with the same names. This sentence
           restated both. The good-news case needs no prose at all — the
           warn and waiting cases above still do, because those say something
           the rows cannot. */
        intro = '';
      }
      var rows = regs.map(function(r, i){
        var kind = cvKindOf(r);
        var row = cvKindRow(kind || 'ignore');
        var res = resultOf(r, i);
        var what = kind === 'ignore'
          ? 'Ignore this area — '+cvPurposeLabel(String(r.purpose||'').toLowerCase())
          : (kind ? row[1] : 'Not set up yet');
        /* P7: the kind's art before its words — the taught swatch for a
           colour box (dashed-empty until taught), a muted icon otherwise */
        var sw = cvKindArt(kind, r);
        return '<div class="vizbox" data-cvrow="'+i+'" style="padding:11px 12px;'+
            'text-align:left;margin-top:8px;cursor:pointer'+
            (i===sel?';outline:2px solid var(--accent)':'')+'">'+
          '<div style="display:flex;gap:10px;align-items:flex-start">'+
            '<span style="flex:none;width:11px;height:11px;border-radius:3px;margin-top:4px;'+
              'background:'+(res.tone==='g'?'var(--green)':res.tone==='w'?'var(--amber)':'var(--grey)')+'"></span>'+
            '<span style="min-width:0;flex:1">'+
              '<b style="display:block;font-size:14px;font-weight:700">'+esc(r.name||'Area')+
                (res.chip?' <span style="font-weight:600;font-size:11.5px;color:var(--muted)">— '+esc(res.chip)+'</span>':'')+'</b>'+
              '<span style="display:block;color:var(--muted);font-size:12px;margin-top:2px">'+
                sw+esc(what)+'</span>'+
              '<span style="display:block;color:var(--muted);font-size:11.5px;'+
                'line-height:1.5;margin-top:4px">'+esc(res.line)+'</span>'+
            '</span>'+
            '<button class="ib" data-cvedit="'+i+'" aria-label="settings for '+
              esc(r.name||'this area')+'" style="flex:none">›</button>'+
          '</div></div>';
      }).join('');
      if(!rows){
        rows = '<div class="ph" style="margin-top:8px">No boxes yet. Choose '+
          '<b>Draw boxes</b> above the picture and drag a box around the thing you '+
          'care about.</div>';
      }
      var add = regs.length >= CV_MAX_REGIONS
        ? note('That is as many boxes as your adapter will take ('+CV_MAX_REGIONS+
               '). Delete one before adding another.', 'warn')
        : addbtn('Draw a new box', 'cv-addbox');
      return head + intro + rows + add;
    }

    /* The ms-budget card, split out of boxListHtml so it can live alone in
       the Advanced tab's #cv-budget slot — a workload number means nothing
       to an average user and does not belong beside the boxes they drag.
       Offline or stopped it paints NOTHING (the pane's static lead note
       carries it), and put()'s cache keeps the poll from churning the DOM. */
    function budgetHtml(){
      if(ZS.live.online === false || !st) return '';
      /* THE 211px OF DEAD SPACE AT THE FOOT OF ADVANCED. Stopped, this pane
         was a lead note, one accordion row and then a quarter of the screen
         of nothing — a screen saying it has nothing to offer. It has exactly
         one thing to offer in that state and it is the same one Tune has:
         start watching, and these numbers begin to exist. The card says what
         will appear rather than pretending the pane is finished. */
      if(!st.running){
        return st.available
          ? startWatchingCard('Workload numbers are measured off real frames — '+
              'none exist until it watches.')
          : '';
      }
      /* budgetMs > 0 too (audit m48): a Core sends budgetMs 0, and "0% of
         what it has time for" was a number made up from nothing */
      if(reader && regBudget && typeof regBudget.usedMs === 'number' &&
         regBudget.budgetMs > 0){
        /* "5.14 ms of 5.9 ms" told the user two numbers and what neither of
           them was. The question a person has here is "is it coping?", and
           the percentage answers it; the milliseconds stay as the detail
           underneath for anyone who wants them. */
        var usedPct = Math.round((regBudget.usedMs / regBudget.budgetMs) * 100);
        return card('<div class="stat"><span>How hard it is working</span><b>'+
          usedPct+'% of what it has time for</b></div>'+
          '<div class="stat"><span>Time spent on each frame</span><b>'+
          esc(cvNum(regBudget.usedMs,2))+' ms of '+esc(cvNum(regBudget.budgetMs,1))+
          ' ms</b></div>'+
          (regBudget.deferred ? '<div class="stat"><span>Left until the next frame</span>'+
            '<b class="warn">'+esc(String(regBudget.deferred))+'</b></div>' : ''));
      }
      return '';
    }

    /* ── paint ──────────────────────────────────────────────────── */
    function paintBoxes(){
      if(!boxEl) return;
      /* canMark, not canSee: with the picture off the stage is a black box of
         the right shape, and a box dragged on it still lands where it is put.
         Refusing to let it be dragged would leave a dead rectangle instead.
         CV_TAB too: teaching and drawing are the Tune tab's tools, so outside
         Tune the boxes are a pure readout — no grab cursor, no stolen
         touch-action, and the stage scrolls like any other picture. */
      /* the shot-meter teach flow owns the stage while its BOX phase is
         armed — from any tab, because the user started it from a button and
         the banner carries the cancel; in the ZONE phase the layer goes
         inert again so the tap can reach the stage */
      var live = (shotTeach && shotTeach.phase === 'box')
        ? canMark()
        : (mode==='box' && canMark() && armTeach < 0 && CV_TAB === 'Tune');
      boxEl.className = live ? 'live' : '';
      /* The page must still scroll when a finger lands on the picture. Taking
         touch-action away is what makes a drag a drag rather than a scroll, so
         it is taken ONLY while boxes are being drawn — never while the picture
         is just being looked at. */
      stage.style.touchAction = live ? 'none' : 'pan-y';
      var h = '', i;
      for(i=0;i<regs.length;i++) h += cvBoxHtml(regs[i], i, sel, resultOf(regs[i], i), false);
      /* the meter box rides the SAME renderer as the region boxes — handles
         in the box phase, plain outline while the green band is being tapped */
      if(shotTeach){
        h += cvBoxHtml({name:'Shot meter', rect:shotTeach.rect}, SHOT_RI,
                       shotTeach.phase === 'box' ? SHOT_RI : -3, null, false);
      }
      if(ghost) h += cvBoxHtml({name:'', rect:ghost}, -1, -2, null, true);
      put(boxEl, 'boxes', h);
    }
    function paint(){
      var run = !!(st && st.running);
      var see = canSee();
      var mark = canMark();
      var det = st && st.lastDetection;
      var found = !!(run && det && det.found);
      var s = say();
      /* Are frames reaching the adapter? With the picture on, an <img> that
         loaded proves it. With the picture off there is no <img>, so ask the
         board for its own capture rate instead — the same fact, one step
         closer to the hardware. */
      var flowing = see || (picOff() && run && (Number(st.fps) || 0) > 0);

      var pin = (tap && (Date.now() - tap.at) < 2500) ? tap : null;
      put(ovl, 'ovl', cvOverlay(det, pin, mark,
                                (st && st.assist && st.assist.config) || null,
                                (st && st.tracking) || null));
      paintBoxes();

      if(im){
        im.style.visibility = see ? 'visible' : 'hidden';
        im.style.cursor = see ? 'crosshair' : 'default';
      }
      /* THE MESSAGE WAS UNDER THE OVERLAY. #cv-boxes and #cv-ovl are the last
         two children of the stage, so they paint ON TOP of #cv-hint — and
         with no picture to draw on, a green "Area 1" rectangle and its label
         were rendered straight across the middle of "Can't reach your
         adapter", which made the one sentence explaining the empty stage
         unreadable. A region box is a region OF something; with nothing
         there, it stands down (zs-fixes.css § LANE 1.5). */
      var stg = im && im.parentNode;
      if(stg && stg.setAttribute) stg.setAttribute('data-nopic', see ? '0' : '1');
      if(hint){
        hint.style.display = see ? 'none' : '';
        /* A calm sentence, never a broken-image icon and never a blank hole.
           Short on purpose: the stage is small on a phone, and the long
           explanation lives under the switch where there is room for it. */
        hint.textContent = picOff()
          ? (run ? 'Picture off — your adapter is still watching. Tap to turn '+
                   'the picture on.'
                 : 'Picture off. Start watching below when you want it back.')
          : s.h + ' — ' + s.s;
      }
      if(fpsEl){
        if(run){
          fpsEl.style.display = '';
          /* "60 fps · looks 52.7×/s" is two rates and a multiplication sign
             floating over the picture. The words say what each number is. */
          /* A BENCH CORE's pictures are built into its firmware (D118), and
             the one line that sits ON the picture says so first, so a test
             picture can never be read as the console's. The picture itself
             carries the same words across its top. */
          fpsEl.textContent = (st.synthetic ? 'TEST PICTURES, not your screen · ' : '')+
                              cvNum(st.fps, 0)+' pictures a second · checks '+
                              cvNum(st.processedFps, 0)+' of them';
        } else fpsEl.style.display = 'none';
      }
      if(armEl){
        if(shotTeach && see){
          armEl.style.display = '';
          armEl.textContent = shotTeach.phase === 'box'
            ? 'Draw where the shot meter moves about — or tap here to cancel'
            : shotTeach.phase === 'bar'
            ? 'Tap the METER BAR itself — or tap here to cancel'
            : 'Tap the GREEN BAND on the meter — or tap here to cancel';
        } else if(armTeach >= 0 && regs[armTeach] && see){
          armEl.style.display = '';
          armEl.textContent = 'Tap the colour inside “'+
            String(regs[armTeach].name||'this box')+'” — or tap here to cancel';
        } else armEl.style.display = 'none';
      }

      put(picEl, 'pic', (st && st.available) ? picHtml() : '');
      if(picAcc) picAcc.style.display = (st && st.available) ? '' : 'none';
      /* The reticle's state, from the same status the whole screen paints
         from: stopped = idle, hunting = scanning, detection held = locked.
         The first "asking your adapter…" round trip shows scanning too — the
         app IS looking. Derived here, next to `found`, so the mark and the
         overlay can never disagree about whether something is held. */
      var ret = (!st || !st.running)
        ? ((!asked && ZS.live.online !== false) ? 'scanning' : 'idle')
        : ((found || (st.tracking && st.tracking.lockedId)) ? 'locked' : 'scanning');
      /* ONE offline story per screen: the stage's #cv-hint owns "can't reach
         your adapter" (the same rule calHtml and the pack list follow), so
         when that is the state, the say card answers with what it MEANS here
         instead of stacking a word-for-word twin of the stage's box on top
         of it. The ○ mark matches Overview's offline stat — never the mark
         alone, the words carry it. */
      if(ZS.live.online === false || (asked && !st)){
        put(sayEl, 'say', note('○ Offline — reconnect to use Screen Assist. '+
          'Everything you set below is kept in this config.'));
      } else {
        put(sayEl, 'say', cvSayCard(s, ret));
      }
      put(rungEl, 'rungs', cvRungs(!st || !st.available ? 0 : (!flowing ? 1 : (found ? 3 : 2)),
                                   aimState()));
      put(modeEl, 'mode', modeHtml());
      put(root.querySelector('#cv-honest'), 'honest', honestHtml());

      /* This button starts and stops the WATCHING — the capture card, the
         detector, the aim assist, all of it. It used to be called "Turn the
         picture on/off", which is now the name of a different switch that
         only hides the preview, so it says what it really does. */
      var label = busy ? 'Working…'
                : (run ? 'Stop watching my screen' : 'Start watching my screen');
      if(noStartStop()){
        /* a Core: no button that would call routes it does not have (m48) */
        put(actEl, 'act', (!st || !st.available) ? '' :
          note(run ? 'Watching your screen. It runs by itself while your capture card has a picture.'
                   : 'Not watching yet. It starts by itself once your capture card has a picture.'));
      } else {
        put(actEl, 'act', '<button class="btn'+(run||busy?'':' primary')+'" id="cv-toggle"'+
          ((busy || !st || !st.available) ? ' disabled' : '')+'>'+esc(label)+'</button>');
      }
      /* the two Play universals + the profile button, every poll — all three
         paint pure functions of stable state, so put()'s cache makes an
         unchanged poll write nothing */
      put(profEl, 'prof', profHtml());
      put(modelStatEl, 'modelstat', modelStatHtml());
      put(shotLineEl, 'shotline', shotLineHtml());
      put(shotStatEl, 'shotstat', shotStatHtml());
      /* THE REAL GREEN-WINDOW WIDTH, taken opportunistically off any ok plan.
         plan.windowMs is zero while the board is idle, so this only ever gets
         BETTER — it never falls back to the estimate once a real number has
         been seen in this session, and the ruler's label drops its "about"
         the moment it does. The window really is narrower on a contested
         pull-up than on a set shot; a picture that pretended otherwise would
         be lying quietly.
         rtPaint() reads the LIVE .sv, so a poll landing mid-drag redraws the
         legend around wherever the thumb is and cannot fight the finger. */
      var rtPlan = (st && st.shotAssist && st.shotAssist.shot &&
                    st.shotAssist.shot.plan) || null;
      if(rtPlan && rtPlan.ok && +rtPlan.windowMs > 0 &&
         Math.abs(+rtPlan.windowMs - rtWinMs) > 1){
        rtWinMs = +rtPlan.windowMs; rtPaint();
      }
      put(rtOutEl, 'rtout', rtOutHtml());
      put(delayEl, 'delay', delayHtml());
      put(listEl, 'list', boxListHtml());
      put(budgetEl, 'budget', budgetHtml());
      put(calEl, 'cal', calHtml());
      applyGates();
    }

    /* ── the game-profile gates on statically-rendered groups ────────
       Display toggles, never removal: the controls stay in the DOM and stay
       wired for every config whose vision block uses them — gating what is
       VISIBLE by what the active vision config actually uses is the point.
       Compared before written, so an unchanged gate writes nothing. */
    function gateEl(el, show){
      if(!el || !el.style) return;
      var want = show ? '' : 'none';
      if(el.style.display !== want) el.style.display = want;
    }
    function applyGates(){
      var tools = cvToolsOf(cvVis());
      /* THE TIMING SHAPE: shot with neither colour nor model. The aim-help
         card, the truth ladder and the reach geometry are aim machinery a
         timing pack never runs — noise, by the owner's own words — so they
         hide as a set. Mixed packs (timing + colour) keep everything and
         only reorder below. */
      var timingOnly = tools.shot && !tools.colour && !tools.model &&
                       !tools.colourPending;
      /* THE COLOUR TOOL IS PRESENT WHETHER OR NOT IT HAS BEEN TAUGHT. These
         two are the colour hunt's own geometry, and a pack ships values for
         both — hiding them until a colour is tapped hid the pack's own
         settings from the person who had just installed it. */
      var colourTool = tools.colour || tools.colourPending;
      gateEl(gAim, colourTool);        /* marker-height geometry is colour's */
      gateEl(gModel, tools.model);
      gateEl(bigFld, colourTool);      /* the colour blob filter's slider */
      /* the shot assist's two halves; a Core never shows them whatever the
         pack says (the product gate, phone.html PRODUCTS, D102) */
      var shotHere = tools.shot && !(ZS.productHides && ZS.productHides('shotAssist'));
      gateEl(gShot, shotHere);
      gateEl(gShotTune, shotHere);
      gateEl(gAimWrap, !timingOnly);   /* Aim help: header, note and card */
      gateEl(gLadder, !timingOnly);    /* the truth ladder + honest line */
      gateEl(reachAcc, !timingOnly);   /* the Reach & tracking accordion */
      /* THE ORDER half: for a timing-only pack the Shot assist card IS the
         screen, so it rides directly under the game-profile button and the
         two universals (before the state card); a mixed pack shows both,
         timing first (before Aim help); anything else keeps today's order
         exactly (its home slot, before the ladder). A DOM move, never a
         re-render — the group keeps its switch wiring and put() caches —
         and the guard means an unchanged poll touches nothing. */
      var slot = timingOnly ? sayEl : (tools.shot ? gAimWrap : gLadder);
      /* parentNode must be TRUTHY, not merely equal: a headless harness that
         answers queries with detached stubs hands back null === null */
      if(gShot && slot && gShot.parentNode &&
         gShot.parentNode === slot.parentNode &&
         gShot.nextElementSibling !== slot){
        slot.parentNode.insertBefore(gShot, slot);
      }
    }

    /* ── the three loops ────────────────────────────────────────── */
    function pullStatus(){
      if(!alive()){ stopAll(); return; }
      /* A phone in a pocket is not polled — but the FIRST answer is always
         fetched, so the screen is already right the moment it is looked at
         rather than sitting on "asking…" until a poll happens to land. */
      if(document.hidden && asked){ statusT = setTimeout(pullStatus, 1500); return; }
      if(ZS.live.online === false){
        st = null; imgOk = false; asked = true; paint();
        statusT = setTimeout(pullStatus, 1500);
        return;
      }
      ZS.api('/vision/status').then(function(j){
        if(!alive()){ stopAll(); return; }
        asked = true;
        st = (j && j.ok) ? j.data : null;
        if(!st || !st.running) imgOk = false;
        adoptPreview();
        paint();
        statusT = setTimeout(pullStatus, (st && st.running) ? 320 : 1600);
      })['catch'](function(){
        if(!alive()){ stopAll(); return; }
        asked = true; st = null; imgOk = false; paint();
        statusT = setTimeout(pullStatus, 2000);
      });
    }
    /* The region reader. Asked for ONCE up front; if the adapter has no such
       route it is never asked again, because a 404 every 400 ms is noise, and
       the honest sentence it produces does not change. */
    function pullRegions(){
      if(!alive()){ stopAll(); return; }
      if(reader === false) return;
      /* Same rule as the status poll: a phone in a pocket is not polled, but
         the FIRST answer is always fetched. Without that, opening the tab in a
         background window left every box saying "asking your adapter…" — which
         is the one thing this screen is not allowed to do. */
      if(ZS.live.online === false || (document.hidden && reader !== null)){
        regT = setTimeout(pullRegions, 1500); return;
      }
      ZS.api('/vision/regions').then(function(j){
        if(!alive()){ stopAll(); return; }
        if(j && j.ok && j.data){
          reader = true;
          var list = (j.data.regions && j.data.regions.length !== undefined)
                     ? j.data.regions : [];
          var next = {}, i;
          for(i=0;i<list.length;i++) if(list[i] && list[i].id) next[list[i].id] = list[i];
          regState = next;
          regBudget = {budgetMs:j.data.budgetMs, usedMs:j.data.usedMs,
                       deferred:j.data.deferred};
          paint();
          regT = setTimeout(pullRegions, (st && st.running) ? 400 : 1600);
          return;
        }
        /* A board that has the route but is unhappy still counts as having
           one — only "there is no such route here" retires the poll. */
        var err = String((j && j.error) || '');
        if(/unknown route|no vision support|not found/i.test(err)){
          reader = false;
          readerWhy = err ? 'Your adapter said: “'+err+'”.' : '';
          paint();
          return;
        }
        reader = true; regState = {};
        paint();
        regT = setTimeout(pullRegions, 2000);
      })['catch'](function(){
        if(!alive()){ stopAll(); return; }
        regT = setTimeout(pullRegions, 2500);
      });
    }
    /* Coming back to the app must not cost a poll interval of staleness. */
    function onVisible(){
      if(!alive()){
        document.removeEventListener('visibilitychange', onVisible);
        stopAll(); return;
      }
      /* Only chase a frame if the board has already told us it is making one.
         Before that, the status call below is what decides. */
      if(!document.hidden){ statusSoon(); if(picKnown) frameSoon(80); }
    }
    if(cvOnVisible) document.removeEventListener('visibilitychange', cvOnVisible);
    cvOnVisible = onVisible;
    document.addEventListener('visibilitychange', onVisible);
    function statusSoon(){
      if(statusT) clearTimeout(statusT);
      statusT = setTimeout(pullStatus, 120);
    }
    function stopFrames(){
      if(frameT){ clearTimeout(frameT); frameT = null; }
    }
    /* OFF means nothing is scheduled — not a slower poll. A slower poll still
       makes the adapter encode a picture, and encoding it is the entire cost
       we are trying to give back to the target-finding. This is the one gate:
       every path that would ask for a frame goes through here. */
    /* nextFrame, unless a request is already on its way (m50, audit
       2026-10-10): that one schedules the next itself when it lands, and a
       second ask is a duplicate ~50 KB transfer over the serial link. The
       callers that come from outside the loop (back to the app, Start/Stop)
       use this; the loop itself uses nextFrame. */
    function frameSoon(gap){
      if(framePend) return;
      nextFrame(gap);
    }
    function nextFrame(gap){
      stopFrames();
      if(picOff()) return;
      frameT = setTimeout(pullFrame, gap);
    }
    /* Let go of the picture on screen and the memory behind it. */
    function releasePicture(){
      if(picUrl){
        try{ URL.revokeObjectURL(picUrl); }catch(e){}
        picUrl = '';
      }
      picTag = '';
      picShownW = 0;
    }

    /* ── asking for one frame ────────────────────────────────────────────
       THERE IS NO "?t="+Date.now() ON THIS URL ANY MORE, and that is the
       point. A cache-buster makes every request a different address, so the
       adapter can never recognise one as "the frame you already have" and has
       to send the whole ~50 KB JPEG back every time — about 1.5 MB/s of
       identical bytes, off a board whose spare time belongs to the aim
       assist. With one stable address the adapter can answer "same picture"
       in a few dozen bytes.

       What keeps the picture FRESH now that the address never changes is the
       adapter's ETag, not the URL: every answer names the bytes it is about,
       we send that name back on the next ask, and the adapter compares it
       against the frame it is holding RIGHT NOW. A new frame has a new name,
       so it always arrives in full. There is no interval, no guess and no
       staleness window — the check happens on the board, per request, against
       the live frame. The old cache-buster could only ever ask "give me
       something new"; this asks "is what I have still what you have", which
       is the question we actually needed answered.

       fetch() rather than assigning <img>.src, and that part is not
       cosmetic — it was measured (Chrome, 2026-08-14): assigning the SAME
       src 19 times produced 19 load events and exactly ONE network request.
       The browser holds decoded images in its own list and hands the element
       straight back the one it already has, so with the cache-buster gone an
       <img>-driven loop would have frozen on the first frame it ever saw.
       fetch with cache:'no-cache' always goes to the network, and always goes
       conditionally (measured: 5 asks, 5 conditional requests, 5 answers of
       "same picture"). It also works whether or not the reply's Cache-Control
       survives whatever is between us and the board.

       The width is asked for here as well as posted to /vision/preview: an
       older adapter only reads it from this query, a newer one holds it as a
       setting, and sending the same number both ways keeps them agreeing.
       Black-and-white is a board setting only — it changes how the picture is
       MADE, so there is nothing to ask for in the URL. */
    /* Can this browser hand us the bytes and let us put them on screen
       ourselves? The whole scheme depends on it: we have to hold the picture
       to be able to say "still showing that one". A browser that cannot make
       an object URL cannot be given bytes for an <img>, so there the only way
       to show a picture is to let the element fetch it — and, per the
       measurement above, the only way to make the element fetch again is a
       changing address. That is the old behaviour, kept whole below, because
       a working preview matters more than a saving. */
    function canHoldFrames(){
      return typeof fetch === 'function' &&
             typeof Blob !== 'undefined' &&
             typeof URL !== 'undefined' &&
             typeof URL.createObjectURL === 'function' &&
             typeof URL.revokeObjectURL === 'function';
    }

    /* ── a Core's picture is a SCREENSHOT, fetched in pieces (D118) ──────
       A Core cannot answer /vision/frame with a picture: its link to this app
       is JSON text lines (a serial console, or Bluetooth) and one reply is at
       most 8 KB, while a 720p screenshot is tens of kilobytes. So it freezes
       the current frame and answers with a header saying so
       ({encoding:'jpeg-chunks', data:{id, bytes, crc32, chunks, ...}}), and
       the picture comes back piece by piece. ZSSERIAL.pullShot fetches the
       pieces, puts them together and refuses a torn picture by its CRC; this
       function hands the result to the SAME <img> the EXO's frames land in,
       so the crop, the boxes and the teaching (patchOf) all work on it
       unchanged.

       It is a SCREENSHOT, not a live preview, and it is paced like one: the
       next is asked for CORE_SHOT_GAP after this one is on screen, not 33 ms
       later. At ~1 s a picture over the serial link, a live loop would keep
       the link busy for ever and starve the status polls this screen runs
       on. What the owner sees is also exactly what patchOf teaches from, for
       as long as it is on screen, which is the property teaching needs.

       Taken only when the answer SAYS it is this shape: an EXO answers with
       image bytes and never reaches this branch. */
    var CORE_SHOT_GAP = 5000;
    var coreShot = false;      /* the picture on screen is a Core's screenshot */
    function pullCoreShot(r, want){
      return r.json().then(function(j){
        if(!alive()){ stopAll(); return; }
        var Z = window.ZSSERIAL;
        if(!j || !j.data || !Z || typeof Z.pullShot !== 'function' ||
           j.encoding !== Z.SHOT_ENCODING){
          throw new Error((j && j.error) || 'the adapter did not send a picture');
        }
        var h = j.data;
        return Z.pullShot(function(path){
          return fetch('/agent'+path, {cache:'no-cache'}).then(function(x){ return x.json(); });
        }, h).then(function(bytes){
          if(!alive()){ stopAll(); return; }
          /* switched off while the pieces were arriving: drop it, as the
             EXO branch drops a frame that lands late */
          if(picOff()){ framePend = false; return; }
          var was = picUrl;
          picUrl = URL.createObjectURL(new Blob([bytes], {type:'image/jpeg'}));
          picTag = 'core:'+h.id+':'+h.crc32;
          picShownW = want;
          coreShot = true;
          im.src = picUrl;
          if(was){ try{ URL.revokeObjectURL(was); }catch(e){} }
        });
      });
    }

    function pullFrame(){
      frameT = null;
      if(!alive()){ stopAll(); return; }
      if(picOff()) return;
      if(document.hidden || !st || !st.running){ nextFrame(700); return; }
      var want = pic.width;
      var url = '/agent/vision/frame?width='+want;
      framePend = true;
      if(!canHoldFrames()){
        /* The old road. The cache-buster is REQUIRED here and only here:
           without something holding the bytes for us, a stable address would
           freeze on the first frame. Costs the full picture every time, which
           is what this browser can do. */
        picShownW = want;
        im.src = url + '&t=' + Date.now();
        return;
      }
      fetch(url, {cache:'no-cache'})
        .then(function(r){
          if(!alive()){ stopAll(); return; }
          if(picOff()){ framePend = false; return; }
          if(!r.ok) throw new Error('adapter answered '+r.status);
          /* A CORE answers in JSON (see pullCoreShot); an EXO in image bytes. */
          var ct = (r.headers && r.headers.get && r.headers.get('Content-Type')) || '';
          if(/json/i.test(ct)) return pullCoreShot(r, want);
          var tag = r.headers.get('ETag') || '';
