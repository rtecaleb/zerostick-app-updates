  var CV_TAB = 'Play';
  R.vision = function(p){
    pgCss();
    var v = visionOf(p);
    var asNow = (v && v.assist) || {};
    /* `typeof`, not `||`, and every number on this screen has to use it: a
       stored strength of 0 is a real setting — "on, and helping by nothing" —
       and `|| 0.35` threw it away and drew the slider at 35%. The value the
       screen shows must be the value the board holds, or the first nudge
       writes back a number nobody chose. The neighbours below were already
       written this way; these two were the survivors. */
    var strength = Math.round((typeof asNow.strength === 'number'
                    ? asNow.strength : 0.35) * 100);
    var actNow = (v && v.assist && v.assist.activation) || 'ads';
    var reach = typeof asNow.window === 'number' ? asNow.window : 0.12;
    var dz    = typeof asNow.deadZone === 'number' ? asNow.deadZone : 0.012;
    var reachPct = Math.round(reach * 100);
    var dzPct    = Math.round(dz * 100);
    var modeNow = asNow.mode === 'lock' ? 'lock' : 'assist';

    /* THE SNAP KNOBS. Four numbers decide whether the assist feels instant or
       mushy and not one of them had a control, so the only way to chase a
       sluggish lock was "How much it helps" — which is not the field that was
       sluggish. Measured on the owner's own board: smoothingMs 75 is an
       exponential slew with a 75 ms time constant, about five frames to get
       most of the way there, and minHits 2 spends two more frames before a
       track counts at all. Inverted where plain English disagrees with the
       stored direction, the same idiom as "How much it takes over". */
    var smMs = typeof asNow.smoothingMs === 'number' ? asNow.smoothingMs : 75;
    var snapPct = Math.max(0, Math.min(100, Math.round(100 - (smMs / 2))));
    var vScale = typeof asNow.verticalScale === 'number'
                   ? asNow.verticalScale : 0.6;
    var vScalePct = Math.round(vScale * 100);
    var trkNow = (v && v.tracking && typeof v.tracking === 'object')
                   ? v.tracking : {};
    var minHitsNow = typeof trkNow.minHits === 'number' ? trkNow.minHits : 2;
    var tgtNow = (v && v.target && typeof v.target === 'object') ? v.target : {};
    var tolNow = typeof tgtNow.radius === 'number' ? tgtNow.radius : 45;
    var offY = (v && typeof v.offsetY === 'number') ? v.offsetY : 0;
    var offXFrac = (v && typeof v.offsetXFrac === 'number') ? v.offsetXFrac : 0;
    var aimIdx = AIM_POINTS.reduce(function(best, a, i){
      return Math.abs(a.offsetY - offY) < Math.abs(AIM_POINTS[best].offsetY - offY)
        ? i : best;
    }, 0);
    /* SPEED lives on aiAdjustment.maxMagnitude, not in the vision
       block: it is the same number the engine's holder and the
       pipeline clamp against, and giving the assist a second copy is
       how the two end up disagreeing. */
    var aiNow = (ZS.live.full[p.id] || {}).aiAdjustment || {};
    var leadMs = Math.round(((typeof asNow.leadSeconds === 'number'
                    ? asNow.leadSeconds : 0)) * 1000);
    var bigFilt = (v && v.filters && typeof v.filters === 'object') ? v.filters : {};
    /* TENTHS OF A PERCENT, because whole percent could not say what this
       field holds. The board's own domain for maxAreaFrac is 0.001..1.0 —
       a tenth of a percent to the whole screen — and a colour pack for a
       12 px dot sits at the floor. At whole percent 0.001 rounded to 0, the
       range input's min then clamped the thumb to 2, and the screen printed
       a ceiling TWENTY TIMES the one the config actually held; one touch of
       it wrote that lie back. The slider's steps are tenths, `data-div` puts
       the decimal point back in the readout, and editBiggest divides by the
       same 1000. */
    var bigTenths = Math.max(1, Math.min(1000, Math.round(
                      (typeof bigFilt.maxAreaFrac === 'number'
                        ? bigFilt.maxAreaFrac : 0.25) * 1000)));
    var speedPct = Math.round(((typeof aiNow.maxMagnitude === 'number'
                    ? aiNow.maxMagnitude : 0.2)) * 100);
    /* INVERTED on purpose. The board stores playerAuthority = "how much of the
       stick your own thumb takes back", so 0.7 means the assist surrenders 70%
       the moment you touch it — which reads as "the aim assist gave up" rather
       than as a number anyone chose. The slider asks the question the user is
       actually asking: how much should it take over. 100% here is authority
       0.0, the assist never yielding. */
    var takeoverPct = Math.round((1 - (typeof asNow.playerAuthority === 'number'
                    ? asNow.playerAuthority : 0.7)) * 100);
    var reachIdx = REACH_PRESETS.reduce(function(best, r, i){
      return Math.abs(r.window - reach) < Math.abs(REACH_PRESETS[best].window - reach)
        ? i : best;
    }, 0);

    /* THE PACKS LIVE BEHIND THE GAME-PROFILE BUTTON NOW (2026-08-15).
       packSection(), the shelf, the save door and their wiring all moved
       into wireCv's pack door (openProfSheet/bindPackDoor): the sheet is
       pull-built on open, so the status poll and the ~8s refresh can never
       reset the picker. Nothing was removed — every control, id and label
       carried over verbatim; only the door into them changed. */

    /* the shot assist's hand-facing settings, read from the config.
       DEFINED BEFORE hPlay ON PURPOSE: the Play card's switch reads shotOn,
       and this block used to sit after hPlay was built — var hoisting made
       shotOn `undefined` at build time, so a config whose assist was ON
       re-rendered with the switch drawn OFF.
       TRIM is the profile's own vision.shotAssist.aimOffsetMs — the rig's
       adjustment on top of the pack's latencyMs starting point, which is
       deliberately NOT surfaced here (the board learns it by itself from the
       game's early/late text). CAUTION is confidenceSigmas: how many sigmas
       of the fit's own uncertainty must fit inside the green window before
       it will commit — presented as three named choices, never as a sigma,
       clamped by predict.py to 0.5..4.0 either way. */
    var saNow = (v && v.shotAssist && typeof v.shotAssist === 'object')
                 ? v.shotAssist : {};
    var shotOn = saNow.enabled === true;                 /* default OFF */
    /* WHICH KIND OF METER, at render time. wireCv has growMeter() for the
       slots it repaints every poll; this is the same question asked once, for
       the labels that are written into the page. Both read the config's own
       meter block, so they cannot disagree. */
    var growNow = !!(saNow.meter && typeof saNow.meter === 'object' &&
                     saNow.meter.read === 'grow');
    /* clamped to RT_LIMIT, the ruler's own bound. This read ±100 from before
       the trim was widened to ±300 (commit c666ed8 moved the bound in both
       board tables, RT_LIMIT and the ruler, and missed this line), so the
       owner's stored −255 rendered as −100 and ONE tap of − would have
       written −105 back over it. Found on the live board, 2026-09-06. */
    var trimNow = Math.max(-RT_LIMIT, Math.min(RT_LIMIT,
                    Math.round(Number(saNow.aimOffsetMs) || 0)));
    var sigNow = Number(saNow.confidenceSigmas);
    var cautionIdx = !(sigNow > 0) ? 1
                   : (sigNow >= 2.5 ? 0 : (sigNow <= 1.6 ? 2 : 1));

    /* THE TIMING SHAPE (2026-08-17, the owner's complaint verbatim: "it
       shouldbe timing and what button to hold and realease when"). A config
       whose pack's ONLY tool is the shot assist gets a screen about THAT —
       which button is held, that the board lets it go for him, teach,
       trim — and the aim-help machinery (strength, reach, truth ladder)
       disappears as the noise it is there. The render decides WORDING here;
       wireCv's applyGates decides visibility and order live; both read the
       same discriminator (cvToolsOf, profile-side pure) so they can never
       disagree. A colour/model config renders today's layout unchanged. */
    var toolsNow = cvToolsOf(v);
    var timingOnlyNow = toolsNow.shot && !toolsNow.colour && !toolsNow.model &&
                        !toolsNow.colourPending;

    /* WHICH BUTTON TO HOLD — vision.shotAssist.button, the button the
       holder watches and releases. The board bounds it to its own Button
       enum; every option offered below is one of those codes, drawn as the
       REAL button of the pad in your hands (the gp-off chip idiom: the
       glyph decorates inside an aria-hidden wrapper — RULE ZERO, ZSG.glyph
       carries its own role=img label and would otherwise announce every
       name twice — while the printed name and aria-pressed carry the
       meaning). An off-list value arriving from a pack is still shown and
       stays selected rather than vanishing. */
    var shotBtnNow = (typeof saNow.button === 'string' && saNow.button)
                      ? saNow.button : 'west';
    function shotBtnRow(selCode){
      var codes = ['west', 'south', 'east', 'north', 'l1', 'r1', 'l3', 'r3'];
      if(codes.indexOf(selCode) < 0) codes.unshift(selCode);
      var fam = ZS.padFam ? ZS.padFam(p) : 'xb';
      var h = '', i, c, on, name, art;
      for(i = 0; i < codes.length; i++){
        c = codes[i];
        on = c === selCode;
        name = (window.ZSG && ZSG.label) ? ZSG.label(c, fam) : c;
        /* SOME GLYPHS ARE LETTERS, and those must not be drawn beside their
           own name. Half of this row's art is a lettered pill or a lettered
           circle — glyphSVG draws "LB", "L3", "A" as <text> — so art+name
           printed L1L1, R1R1, L3L3, R3R3 on a DualSense and AA, BB, XX, YY,
           L3LS, R3RS on an Xbox pad. The shapes (Cross, Circle, Square,
           Triangle, the d-pad) carry no letters and are worth having beside
           the name, so the test is on the art itself rather than on a second
           copy of glyphs.js's tables: if it already says the word, the word
           is what we keep, in the pad's own vocabulary (ZSG.label — an
           Xbox l3 is "LS", which the art spells "L3"). */
        art = window.ZSG
          ? '<span class="gly-deco" aria-hidden="true" '+
            'style="width:18px;height:18px">'+ZSG.glyph(c, fam)+'</span>'
          : '';
        if(art.indexOf('<text') >= 0) art = '';
        h += '<button data-sabtn="'+esc(c)+'" aria-pressed="'+(on?'true':'false')+'" '+
          'style="flex:0 0 auto;width:auto;display:inline-flex;align-items:center;'+
          'gap:6px;padding:7px 11px;font-size:12.5px;border-radius:9px;cursor:pointer;'+
          'border:1px solid '+(on?'var(--accent)':'var(--line)')+';'+
          'background:'+(on?'rgba(47,217,206,.12)':'var(--bg2, #161b22)')+';'+
          'color:'+(on?'var(--accent)':'var(--fg, #e6edf3)')+'">'+
          art+esc(name)+'</button>';
      }
      return h;
    }

    /* THE TABS ARE THE ORGANIZATION (2026-08-15). The stage stays ABOVE them
       — it is the proof and the teach surface, so no one tab may own it —
       and the strip is the kit's .subtabs, sticky under the header. Every
       pane renders ONCE; a tab tap only flips .pgoff (pgCss/wirePgTabs), so
       wireCv's node references and its three loops survive every flip, and
       slots on hidden panes still take their poll updates.
         Play     — the average user's whole journey: state, Start/Stop,
                    Aim help, game packs, the truth ladder.
         Tune     — what it hunts for and where it looks (the colour tools:
                    the owner's named demotion), where it aims, reach.
         Advanced — the picture's cost switches and workload numbers.
       Every control keeps its exact label and stays in the DOM, which is
       what the wiring below finds them by — nothing about after() changed
       except the aim-help scoping and the tab wiring. */
    var hPlay =
      /* THE GAME PROFILE FIRST, then the two universals that exist in EVERY
         profile state — Start/Stop and the Picture switch — then the state
         card. The profile button (painted by wireCv) shows the active game
         pack's name, or Blank; tapping it opens the pack door, which is
         where the whole shelf lives now. Reordering these blocks is safe:
         every slot div is painted by wireCv through its id, and the
         aim-help wiring is scoped to #cv-aimhelp, not to document order. */
      '<div id="cv-prof"></div>'+
      '<div id="cv-act"></div>'+
      /* #cv-picrow left Play for the Advanced picture fold (screen-map §6) —
         Play's height budget is spent on the things a player touches
         mid-game, and the preview switch is housekeeping */
      '<div id="cv-say"></div>'+
      /* the button-versus-toggle confusion, answered where it happens — and
         wherever there is a shot assist, the second switch he is looking for
         is the SHOT assist's. Selected on tools.shot, not on timingOnly: a
         config that carries a shot meter AND a colour still has a Shot assist
         switch, and pointing that owner at Aim help sends him to the one
         control that does not govern the thing he is asking about. (It was
         also selected on the discriminator this whole session was about —
         so the config that most needed this sentence got the other one.) */
      /* IT EXPLAINS A REAL CONSEQUENCE, SO IT BECOMES A CHIP RATHER THAN
         DYING (owner, 2026-08-28: "A note that restates its label dies; a
         note that explains a real consequence becomes a '?' chip"). One
         switch is global and one is per-config, which nothing on the screen
         says and nobody would guess — but it is not something you must read
         to press the button it sits under. The two branches also collapse to
         one sentence with the switch's own name spliced in, so the fact is
         stated once instead of twice. */
      helpHTML('cv-twoswitches', 'Two switches, two scopes',
        '“Start watching my screen” turns your adapter’s eyes on for <b>every</b> '+
        'config. The <b>'+(toolsNow.shot ? 'Shot assist' : 'Aim help')+'</b> switch '+
        'below decides whether <b>this</b> config acts on what they see.')+

      /* the timing shape's display gate round the whole aim-help block —
         header, card and all (applyGates, the picAcc idiom: the controls
         stay in the DOM, wired, for every config whose vision block uses
         them; a timing-only pack just does not look at them) */
      '<div id="cv-g-aimwrap">'+
      /* AIM HELP, split by how often you touch it (2026-08-14). This was ONE
         card of thirteen controls — the biggest wall in the app — with the
         on/off switch and the expert geometry at equal rank. Now: the common
         path (on, how much, when, gentle-vs-lock) here on Play; where it
         aims and the reach-and-tracking geometry on Tune.

         The old TRAP here is DEFUSED: the master toggle used to be wired as
         the first `.fld .sw` on the screen, which only worked because every
         slot above it happened to be empty at after() time. It is now scoped
         to this #cv-aimhelp wrapper (the #ov-kill idiom), so the tab layout
         does not depend on slot-emptiness ordering. */
      sh('Aim help')+
      '<div id="cv-aimhelp">'+
      /* THE LABEL SAYS WHAT THE SWITCH ACTUALLY OWNS. It writes
         `vision.enabled`, which gates the AIM assist and nothing else — the
         shot assist is configured from `vision.shotAssist` and never reads
         it (core/stages.py) — so "Use Screen Assist in this config" plus
         "turn the whole thing on or off" promised a master switch that does
         not exist, and turning it off left a shot assist still firing. The
         sub-line goes with it: the title is the whole sentence now. */
      card(toggleFld('Use aim help in this config', !(v && v.enabled===false),
            null, true)+
        slider('How much it helps', 0, 100, strength, '%', null, true)+
        slider('How fast it snaps', 0, 100, snapPct, '%', null, true)+
        seg('How it helps', ['Gentle assist','Lock on'],
            modeNow === 'lock' ? 1 : 0, true)+
        helpHTML('cv-aimmode', 'How it helps',
          '<b>Gentle assist</b> fades to nothing as the target centres, so it never '+
          'fights your thumb — but a big reach spreads it thin. <b>Lock on</b> pulls at '+
          'full strength the whole way; use it with a big reach.'))+
      /* the rarely-touched activation choice folds (screen-map §6): it stays
         INSIDE #cv-aimhelp so the label-keyed select wiring still finds it,
         and inside the timing-only display gate with the rest */
      acc('Aim help details','sliders',
        selFld('When it works',
          ['All the time','Only firing from the hip','Only while aiming','Only while shooting'],
          Math.max(0, ['always','hip','ads','fire'].indexOf(actNow)),
          'most people leave this on “while aiming”', true)+
        slider('Up and down reach', 10, 100, vScalePct, '%', null, true)+
        slider('Sightings before it locks', 1, 6, minHitsNow, '', null, true)+
        slider('Colour tolerance', 10, 120, tolNow, '', null, true),
        false, 'cvaimdet')+
      '</div>'+
      '</div>'+
      /* SHOT ASSIST — the hand-level half: the on/off switch and the landed
         readout. Gated by applyGates on cvToolsOf().shot (a pack that
         carries a shot assist), the picAcc idiom: stays in the DOM, wired,
         shown only when the config really has one. The RELEASE TIMING now
         lives here too — see #cv-rt below; Tune keeps the button picker and
         the caution seg. For a timing-only pack applyGates also
         MOVES this whole group to the top of Play (under the universals) —
         a DOM move, so the switch wiring and the slot caches ride along.
         #cv-shotline is the hand-level sentence — which button, in the
         glyphs of the pad in your hands — painted by wireCv's shotLineHtml
         so a button change or a pad swap updates it on the next poll. */
      '<div id="cv-g-shot">'+
      sh('Shot assist')+
      card('<div id="cv-shotline"></div>'+
        /* "at the green" is only true of a meter that HAS a green band. On
           2K26's the board measures how long the arrow gets, and a switch
           promising a green the owner cannot find is the label sending him
           to look for one. */
        toggleFld(growNow ? 'Let go at the right moment'
                          : 'Take the shot at the green', shotOn,
            'starts OFF', true)+

        /* ── THE RELEASE TIMING ──────────────────────────────────────────
           The owner's ask, verbatim: "let me have a slider to adjust when it
           relsases so i cna fine tune it". PROMOTED from Tune, not a new
           field: the same vision.shotAssist.aimOffsetMs the "Release timing
           trim" slider owned, through the same profile PUT. It moved because
           with minVerdicts 0 and an empty feedbackRegion the automatic
           learner will never move latencyMs again — this is now the ONLY way
           the timing can be corrected, and a screen does not bury its only
           steering wheel behind a tab called Tune. He also cannot converge a
           control he has to swipe away from to see the result of.

           It sits OUTSIDE #cv-shotstat on purpose: that slot is
           put()-repainted every 320 ms and a repaint mid-drag would replace
           the node under the finger and kill the gesture.

           THREE WAYS IN and one writer. The +/- keys are the primary control
           (a tap, and 44 px of it); the number between them is TYPEABLE,
           which is how a hand with limited fine motor control gets from 0 to
           -55 in one go instead of eleven taps; the track is the coarse drag
           he asked for. All three land on rtSet().

           data-nosave on both: the board owns this value and it is re-derived
           on every render, so phone.html's local cache must not restore a
           number the board does not hold and then write it back. */
        '<div id="cv-rt">'+
          '<div class="fld col rtfld">'+
            '<div class="flab">When it lets go'+
              '<em>nudge it until 2K stops calling you early or late</em>'+
              '<span class="rv"></span></div>'+
            '<div id="cv-rt-pic" class="rtpic"></div>'+
            '<div class="rtkeys">'+
              svspan(trimNow, -RT_LIMIT, RT_LIMIT, ' ms', RT_STEP, null,
                     ' data-nosave="1"')+
            '</div>'+
            /* step="5" with min="-100" makes only multiples of 5 valid, so a
               stored off-grid -18 would render the THUMB at -20. That is why
               the .sv is the authoritative readout and the range is only the
               thumb: .sv always shows the true stored value, the thumb may
               sit up to 2.5 ms away, and nothing is written on render. */
            '<input class="rng rtrng" type="range" min="-'+RT_LIMIT+'" '+
              'max="'+RT_LIMIT+'" step="'+RT_STEP+'" '+
              'value="'+(Math.round(trimNow/RT_STEP)*RT_STEP)+'" '+
              'data-nosave="1" aria-label="When it lets go, in milliseconds '+
              'either side of the moment it computed">'+
            /* 2K'S OWN TWO PHRASES. They are the words on his screen, so they
               are the only vocabulary that needs no teaching — and the
               mapping is the INVERSE of the raw sign (later on the ruler =
               a bigger aimOffsetMs = a LONGER arrow, which is what fixes a
               "Slightly Early"), so it must be printed rather than left for
               him to derive. He will get it wrong otherwise. */
            '<div class="rtends">'+
              '<span><b>Earlier</b>if 2K keeps saying “Slightly Late”</span>'+
              '<span><b>Later</b>if 2K keeps saying “Slightly Early”</span>'+
            '</div>'+
            '<button type="button" class="rtreset" id="cv-rt-reset">'+
              'Back to the moment it computed</button>'+
          '</div>'+
        '</div>'+
        /* the per-shot outcome + the last-five dots, painted from the
           holder's tape by wireCv. Outside #cv-shotstat for the same reason
           the control is. */
        '<div id="cv-rt-out"></div>'+
        /* THE DELAY LINE AND THE ONE-TAP MEASUREMENT (D90). One poll-painted
           slot: the delay the board plans with and where it came from
           (delayLineHtml), then the 44 px "Measure my delay" key that opens
           the sheet. Painted through put() like #cv-rt-out, so the number
           follows the board; the tap is delegated from this wrapper, so a
           repaint replaces the key and never the listener. */
        '<div id="cv-delay"></div>')+
      note('It only ever <b>lets go</b> of a button you are holding — <b>off means off</b>, even mid-shot.')+
      /* ONE FOLD holds everything else about the feature (screen-map §6 /
         rule 6): the live stats + why-drawer slot, AND the button picker +
         caution seg that used to live across the pager on Tune — the whole
         shot assist is one card + one fold now. #cv-g-shottune keeps its id
         so applyGates' display gate still covers it, and every control in
         it is label-scanned, so the move costs no wiring. */
      acc('Tuning & stats','sliders',
        '<div id="cv-shotstat"></div>'+
        '<div id="cv-g-shottune">'+
        sh('Which button, and how careful')+
        card('<div class="fld col"><div class="flab">Button to hold'+
            '<em>the shoot button — it lets go of this one for you</em></div>'+
            '<div id="cv-shotbtn" style="display:flex;flex-wrap:wrap;gap:8px;'+
            'margin-top:10px">'+shotBtnRow(shotBtnNow)+'</div></div>'+
          seg('How sure before it acts', ['Strict','Normal','Loose'], cautionIdx,
              true, null,
              'how certain the meter reading must be before it takes the shot')+
          helpHTML('cv-caution', 'How sure before it acts',
            '<b>Strict</b> — acts only when almost certain, so it hands more shots back to you. '+
            '<b>Normal</b> — about 95% sure before it acts; the factory setting. '+
            '<b>Loose</b> — acts on rougher readings, more of them off-centre.'))+
        '</div>',
        false, 'cvshottune')+
      '</div>'+
      /* the truth ladder — Play's troubleshooting footer instead of the
         first fold's squatter. Wrapped for the timing gate with the honest
         line: the ladder's last rung and the whole honest card are about
         the AIM step, which a timing-only pack does not run — the Shot
         assist card's landed readout is that shape's honesty. */
      '<div id="cv-g-ladder">'+
      sh('Is it working?')+
      '<div id="cv-rungs"></div>'+
      /* The honest line about what these settings do and do not do. It is
         filled in from the board's own status — see honestHtml(). */
      '<div id="cv-honest"></div>'+
      '</div>';

    /* the trained model's two hand-facing settings, read from the config */
    var mdl = (v && v.model && typeof v.model === 'object') ? v.model : {};
    var mdlScore = Math.round(((typeof mdl.scoreThreshold === 'number')
                    ? mdl.scoreThreshold : 0.35) * 100);
    var mdlAimIdx = mdl.aimAt === 'head' ? 0 : 1;

    /* (the shot assist's hand-facing settings — saNow, shotOn, trimNow,
       cautionIdx — are defined ABOVE hPlay now: the Play switch reads them) */

    var hTune =
      /* the two lead paragraphs died (screen-map §10) — the controls say
         what the tab is, and the not-watching state paints its own chip
         into #cv-cal. One line stays for the timing shape, because that
         pane would otherwise open on colour language it does not use. */
      (timingOnlyNow
        ? note('Everything here tunes the shot assist.')
        : '')+
      '<div id="cv-mode"></div>'+
      '<div id="cv-cal"></div>'+
      /* THE TRAINED MODEL CARD — rendered always, shown only when the active
         vision config's model is enabled (wireCv's applyGates display
         toggle, the picAcc idiom). The labels are NEW names, not renames:
         the model's confidence and aim point never had controls before. */
      '<div id="cv-g-model">'+
      sh('Trained model')+
      card('<div id="cv-modelstat"></div>'+
        slider('How sure it must be', 10, 90, mdlScore, '%', null, true)+
        /* "Chest", not "Body". The colour half of this same tab offers
           Head / Chest for the identical decision; two words for one place,
           on one screen, is how a user learns the app is unreliable. The
           written value is still model.aimAt = 'body'. */
        seg('Aim the model at', ['Head','Chest'], mdlAimIdx, true)+
        helpHTML('cv-model', 'Trained model',
          'The model rides in with a game pack. Only two parts are meant for hands: how sure '+
          'a sighting must be, and where in the player to aim.'))+
      '</div>'+
      /* THE SHOT ASSIST'S TUNE HALF IS GONE FROM TUNE (screen-map §6 / rule
         6): the button picker and the caution seg moved into the Play
         card's "Tuning & stats" fold, so the whole feature lives on one
         card — and the relocation-apology note died with the split it
         apologised for. */
      '<div id="cv-boxlist"></div>'+
      /* "Where it aims" is marker-height geometry — the colour hunt's. It
         stays in the DOM for every config (the wiring below finds it by
         label) and applyGates only shows it when the config carries a
         colour; the model's aim point lives in the model card above. */
      '<div id="cv-g-aim">'+
      sh('Where it aims')+
      card(seg('Aim at', AIM_POINT_NAMES, aimIdx, true)+
        /* "14 marker heights ÷ 10" put a division sign in a readout and left
           the user to do the sum. The value is tenths of a marker height, so
           say tenths. Left/right genuinely IS a fraction of the screen — a
           different quantity, honestly labelled — but neither of them makes
           anyone divide anything now. */
        slider('Fine tune up / down', 0, 50, Math.round(offY * 10),
               ' tenths of a marker', null, true)+
        slider('Fine tune left / right', -20, 20, Math.round(offXFrac * 100),
               '% of screen', null, true)+
        helpHTML('cv-aimat', 'Where it aims',
          'A nametag floats above a player, so <b>Aim at</b> moves the aim point down to the '+
          'head or the body. Measured in <b>marker heights</b>, not pixels.'))+
      '</div>'+
      /* HOW FAR IT REACHES. Without these the assist silently ignores
         anything more than a hand's width from the crosshair, and there was
         no way to see that, let alone change it. Expert geometry, so it is
         disclosed — the preset seg and both sliders it re-drives by label
         live INSIDE this same accordion, so they can never disagree. */
      acc('Reach & tracking','target',
        seg('How far it reaches', REACH_NAMES, reachIdx, true)+
        slider('Reach', 2, 150, reachPct, '% of screen', null, true)+
        slider('Leave alone when this close', 0, 50, dzPct, '% of screen',
               null, true)+
        slider('How fast it moves your aim', 1, 100, speedPct, '%',
               null, true)+
        slider('How much it takes over', 0, 100, takeoverPct, '%', null, true)+
        slider('Aim ahead of moving targets', 0, 300, leadMs, ' ms', null, true)+
        slider('Ignore things bigger than', 1, 1000, bigTenths, '% of screen',
               null, true, 10)+
        helpHTML('cv-reach', 'Reach & tracking',
          '<b>How much it takes over</b> — 100% keeps helping while you move the stick, 0% '+
          'steps aside. <b>How fast it moves your aim</b> — if the crosshair swims around an '+
          'enemy, bring it down. <b>Reach</b> — how far from your crosshair a target still '+
          'counts. <b>Leave alone when this close</b> stops it fighting you once you are on '+
          'target.'),
        false, 'cvreach');

    var hAdvanced =
      /* the lead note doubles as the pane's never-empty guarantee: with no
         capture card the picture accordion below hides itself */
      note('Housekeeping and workload numbers. Nothing here changes how the '+
           'assist feels.')+
      /* The accordion SHELL is static HTML on purpose: picHtml() repaints
         only the #cv-pic slot inside it on every poll, so the open/closed
         state the user chose survives — repainting the accordion itself
         would slam it shut every 320 ms. wire() runs before the slots fill,
         which is also why the shell (unlike anything inside a slot) gets its
         header toggle wired for free. Its visibility is driven from paint():
         no capture card = no picture to have switches for. */
      acc('The picture', 'cast', '<div id="cv-pic"></div>', false, 'cvpic')+
      /* the ms-budget card, painted by wireCv's budgetHtml() */
      '<div id="cv-budget"></div>';

    var html =
      sh('What your adapter sees')+
      cvStageHtml()+
      pgTabsHTML('cvtabs', ['Play','Tune','Advanced'], CV_TAB, 'Screen Assist sections')+
      pgPane('cvpage', 'data-cvpg', 'Play', CV_TAB, hPlay)+
      pgPane('cvpage', 'data-cvpg', 'Tune', CV_TAB, hTune)+
      pgPane('cvpage', 'data-cvpg', 'Advanced', CV_TAB, hAdvanced);

    return { html: html, after: function(root){
      wireCv(root, p);
      /* the tabs: flip-only; CV_TAB makes the choice survive the re-render a
         pack apply/install triggers. A flip never re-renders, so the frame
         loop, the fps chip and every put() cache carry straight on. */
      wirePgTabs(root, 'cvtabs', 'cvpage', 'data-cvpg', function(pg){ CV_TAB = pg; });
      /* System B's review/install flow, the link checker, and the pack
         shelf's wiring all moved into wireCv's pack door (bindPackDoor):
         those elements are rendered inside the game-profile sheet now, so
         this scope's querySelector could never find them — the exact trap
         that once left the typed-colour "Use it" button dead. The
         typed-colour field is wired beside the other #cv-cal delegates in
         wireCv for the same reason. */

      /* The aim-help settings. They exist with or without a pack — "how much"
         and "when" are the user's preference, not the pack's — so editing one
         with nothing installed creates the block rather than doing nothing.

         The change is applied to the board's OWN copy of the vision block and
         touches only the two fields these controls own. The block also holds
         the board's target rules, the boxes and the tracker tuning; sending a
         rebuilt one would either wipe them or be rejected whole. */
      function editAssist(change, said, skipAssistDefaults){
        function apply(block){
          /* skipAssistDefaults — see editShot() below. The aim-help defaults
             belong to the aim-help controls; a caller that owns a shotAssist
             field must not materialise an `assist` block the config never
             had, because on a TIMING-ONLY pack (Caleb's shape) that block is
             not even on screen. */
          if(!skipAssistDefaults){
            block.assist = block.assist || {};
            if(typeof block.assist.strength !== 'number') block.assist.strength = 0.35;
            if(!block.assist.activation) block.assist.activation = 'ads';
          }
          change(block);
        }
        /* Offline, this joins the Save queue instead of a phone-only copy
           nothing ever sent (M21); visionWrite says which happened. */
        visionWrite(p, function(f){
          if(!f.vision || typeof f.vision !== 'object') f.vision = {enabled:true};
          apply(f.vision);
        }).then(function(j){
          var cur = ZS.live.full[p.id];
          if(j && j.ok && cur && cur.vision) v = cur.vision;
          visionSaid(j, said);
        });
      }
      /* THE SHOT ASSIST'S OWN WRITER. Same PUT, same board's-own-copy rule,
         one difference: it does not invent an aim-help block. editAssist's
         apply() unconditionally sets assist.strength 0.35 and
         assist.activation 'ads', so on a timing-only pack the FIRST nudge of
         the release timing would materialise an aim assist the owner never
         chose — controls that are not even on his screen, quietly written
         into his config by a control that is. Everything that owns a
         vision.shotAssist field goes through here. */
      function editShot(change, said){ return editAssist(change, said, true); }
      /* The master toggle, scoped to its own wrapper — the #ov-kill idiom.
         It used to be "the first .fld .sw in root", which only worked while
         every slot above it happened to be empty at after() time; the tab
         layout must not depend on slot-emptiness ordering. */
      var sw = root.querySelector('#cv-aimhelp .fld .sw');
      if(sw) sw.addEventListener('click', function(){
        var on = sw.classList.contains('on');
        /* the toast says the same thing the label does — this switch is aim
           help's, not the whole feature's */
        editAssist(function(n){ n.enabled = on; },
                   on ? 'Aim help on' : 'Aim help off');
      });
      /* The shot assist's master switch — scoped to its own wrapper exactly
         like the one above. It owns ONE field, vision.shotAssist.enabled,
         and the board's stage is what makes off safe AND immediate: the
         release latch has an off-switch exit on the same tick (off means
         off — said on the card), and an enabled assist with an untaught
         meter declines with a named reason rather than guessing. */
      var swShot = root.querySelector('#cv-g-shot .fld .sw');
      if(swShot) swShot.addEventListener('click', function(){
        var on = swShot.classList.contains('on');
        editShot(function(n){
          if(!n.shotAssist || typeof n.shotAssist !== 'object'){
            n.shotAssist = {};
          }
          n.shotAssist.enabled = on;
        }, on ? 'Shot assist on — it lets go at the moment it computes'
              : 'Shot assist off — off means off, even mid-shot');
      });
      /* THE BUTTON PICKER — vision.shotAssist.button through the same
         profile PUT path as the release timing (editShot): one field,
         nothing else. Delegated from the row's own wrapper so the in-place
         innerHTML repaint replaces the chips, never the listener; the
         Play card's sentence follows on the next poll (shotLineHtml). */
      var shotBtnBox = root.querySelector('#cv-shotbtn');
      if(shotBtnBox) shotBtnBox.addEventListener('click', function(e){
        var b = e.target && e.target.closest ? e.target.closest('[data-sabtn]') : null;
        if(!b) return;
        var code = b.getAttribute('data-sabtn');
        if(!code) return;
        shotBtnBox.innerHTML = shotBtnRow(code);
        var said = (window.ZSG && ZSG.label)
          ? ZSG.label(code, ZS.padFam ? ZS.padFam(p) : 'xb') : code;
        editShot(function(n){
          if(!n.shotAssist || typeof n.shotAssist !== 'object'){
            n.shotAssist = {};
          }
          n.shotAssist.button = code;
        }, 'Shot button: '+said);
      });
      /* One handler for every slider on this card: the label says which
         field it owns. `reach` and the dead zone are fractions of the
         screen on the board, percentages here, because "12% of the screen"
         is a thing you can picture and 0.12 is not. */
      /* aiAdjustment is a sibling of vision on the profile, so this one
         cannot go through editAssist(). Same put-the-board's-own-copy rule:
         touch the single field this control owns and nothing else. */
      function editSpeed(pct){
        var mag = Math.max(0.01, Math.min(1.0, pct / 100));
        /* Offline this used to toast "Saved — kept on this phone" and keep
           nothing at all (M21). Now it queues for Save, or says it could not. */
        visionWrite(p, function(f){
          if(!f.aiAdjustment || typeof f.aiAdjustment !== 'object'){
            f.aiAdjustment = {enabled:true};
          }
          f.aiAdjustment.maxMagnitude = mag;
          /* A speed of zero-with-the-switch-on is a config that looks live
             and does nothing, which is the failure this whole screen has
             been about. Asking for speed means asking for it to work. */
          f.aiAdjustment.enabled = true;
        }).then(function(j){ visionSaid(j, ''); });
      }

      /* The size ceiling is a FILTER, not an assist setting — it decides
         what counts as a target at all, before the assist ever sees it. Same
         job as the reference script's "ignore objectives". */
      /* TENTHS of a percent in, a fraction of the screen out — see bigTenths
         in the render above. The floor is the BOARD's own (0.001, from
         detect.py's _FILTER_NUMS), not a number this screen invented: the old
         0.02 floor here is what made the control unable to hold a dot pack's
         ceiling even if the display had been right. */
      function editBiggest(tenths){
        var frac = Math.max(0.001, Math.min(1.0, tenths / 1000));
        editAssist(function(n){
          n.filters = n.filters || {};
          n.filters.maxAreaFrac = frac;
          if(typeof n.filters.minAreaFrac === 'number' &&
             n.filters.minAreaFrac >= frac){
            n.filters.minAreaFrac = frac / 10;   /* the board rejects min>=max */
          }
        });
      }

      var RNG_FIELDS = {
        'How fast it moves your aim': null,   /* handled by editSpeed */
        'How much it helps': function(n, pct){
          n.assist.strength = Math.max(0, Math.min(1, pct / 100));
        },
        /* INVERTED, like "How much it takes over": the slider asks how FAST
           it snaps, the board stores how LONG the slew takes. 100% -> 0 ms,
           the pull arriving whole on the frame after the sighting. Bounded
           0..500 by assist.py's ASSIST_NUMS, and the *2 keeps the whole
           usable range (0-200 ms) on the track rather than squeezing it into
           the bottom fifth. */
        'How fast it snaps': function(n, pct){
          n.assist.smoothingMs = Math.max(0, Math.min(500, (100 - pct) * 2));
        },
        /* verticalScale shortens the vertical half of the reach, so a low
           value is why a target dead above the crosshair is ignored while the
           same distance sideways is caught. assist.py bounds it 0..1. */
        'Up and down reach': function(n, pct){
          n.assist.verticalScale = Math.max(0, Math.min(1, pct / 100));
        },
        /* track.py bounds minHits 1..30. At 1 the first sighting is a track;
           every step above that is one more frame of delay before the assist
           may touch the stick, bought against one more frame of proof that
           the blob is real. */
        'Sightings before it locks': function(n, hits){
          n.tracking = (n.tracking && typeof n.tracking === 'object')
            ? n.tracking : {};
          n.tracking.minHits = Math.max(1, Math.min(30, Math.round(hits)));
        },
        /* The chroma gate, clamped 1..255 by detect.py. It needs a control
           because a game that draws its outline SEE-THROUGH does not put the
           colour you picked on the wire: what reaches the capture card is
           that colour blended with whatever is behind it. Measured on the
           owner's own frames, the rendered purple sat 55 counts away from the
           one he set in the menu, against a radius of 45 - so the detector
           scanned a million pixels and matched none of them. */
        'Colour tolerance': function(n, r){
          n.target = (n.target && typeof n.target === 'object') ? n.target : {};
          n.target.radius = Math.max(1, Math.min(255, Math.round(r)));
        },
        /* Inverted: the slider asks how much it TAKES OVER, the board stores
           how much the thumb takes BACK. 100% -> playerAuthority 0.0, which is
           the assist never standing down. See takeoverPct above. */
        'How much it takes over': function(n, pct){
          n.assist.playerAuthority =
            Math.max(0, Math.min(1, 1 - (pct / 100)));
        },
        'Reach': function(n, pct){
          n.assist.window = Math.max(0.02, Math.min(1.5, pct / 100));
          /* The board rejects the whole profile if the dead zone is not
             smaller than the reach, so keep it below rather than letting a
             drag produce a save that silently fails. */
          if(typeof n.assist.deadZone === 'number' &&
             n.assist.deadZone >= n.assist.window){
            n.assist.deadZone = Math.max(0, n.assist.window * 0.5);
          }
        },
        'Fine tune up / down': function(n, pct){
          n.offsetY = Math.max(0, Math.min(5, pct / 10));
        },
        'Fine tune left / right': function(n, pct){
          n.offsetXFrac = Math.max(-0.5, Math.min(0.5, pct / 100));
        },
        'Aim ahead of moving targets': function(n, pct){
          n.assist.leadSeconds = Math.max(0, Math.min(0.5, pct / 1000));
        },
        'Leave alone when this close': function(n, pct){
          var w = typeof n.assist.window === 'number' ? n.assist.window : 0.12;
          n.assist.deadZone = Math.max(0, Math.min(0.5, Math.min(pct / 100,
                                                                w * 0.9)));
        },
        /* The trained model's confidence gate. Clamped to the schema's own
           scoreThreshold bounds (0.01..0.99, _VISION_MODEL_NUMS); editAssist
           mutates f.vision, and `model` lives inside it. */
        'How sure it must be': function(n, pct){
          n.model = (n.model && typeof n.model === 'object') ? n.model : {};
          n.model.scoreThreshold = Math.max(0.01, Math.min(0.99, pct / 100));
        }
        /* NO ENTRY FOR THE RELEASE TIMING. It used to live here as "Release
           timing trim", a plain slider() on Tune writing aimOffsetMs on
           `change`. It is now #cv-rt on Play, with its own three-ways-in
           wiring and its own coalescing writer (rtSet/rtCommit) — and it must
           NOT also be reachable from this generic scan, or a drag would write
           twice through two different paths. The scan is label-keyed and the
           new control's label ("When it lets go") is deliberately absent from
           this table, so its .rtrng falls through to the `if(!set) return`
           below and only rtSet ever writes the field. */
      };
      root.querySelectorAll('.rng').forEach(function(rng){
        var f=rng.closest('.fld'), fl=f&&f.querySelector('.flab');
        var lab=(fl && fl.childNodes[0] && fl.childNodes[0].textContent||'').trim();
        if(lab === 'Ignore things bigger than'){
          rng.addEventListener('change', function(){
            editBiggest(+rng.value || 0);
          });
          return;
        }
        if(lab === 'How fast it moves your aim'){
          rng.addEventListener('change', function(){
            editSpeed(+rng.value || 0);
          });
          return;
        }
        var set=RNG_FIELDS[lab];
        if(!set) return;
        rng.addEventListener('change', function(){
          editAssist(function(n){ set(n, +rng.value||0); });
        });
      });

      /* The named steps. Setting both fields together is the point — a big
         reach with the default hair-thin dead zone is the setting that makes
         the assist feel like it is wrestling you. */
      root.querySelectorAll('.seg2').forEach(function(seg2){
        var f=seg2.closest('.fld'), fl=f&&f.querySelector('.flab');
        var segLab=(fl&&fl.childNodes[0]&&fl.childNodes[0].textContent||'').trim();
        if(segLab === 'How it helps'){
          seg2.querySelectorAll('button').forEach(function(b, i){
            b.addEventListener('click', function(){
              seg2.querySelectorAll('button').forEach(function(o){
                o.classList.remove('on');
              });
              b.classList.add('on');
              editAssist(function(n){
                n.assist.mode = i === 1 ? 'lock' : 'assist';
              }, i === 1 ? 'Lock on' : 'Gentle assist');
            });
          });
          return;
        }
        /* The shot assist's caution — three named choices over ONE bounded
           number. confidenceSigmas is how many sigmas of the fit's own
           uncertainty must fit inside the green window before it commits
           (predict.py clamps it to 0.5..4.0; the schema bounds it the same
           way). Strict 3.0, Normal 2.0 (the factory default), Loose 1.2 —
           never shown as a sigma, because "how sure before it acts" is the
           question being asked. */
        if(segLab === 'How sure before it acts'){
          seg2.querySelectorAll('button').forEach(function(b, i){
            b.addEventListener('click', function(){
              var sig = [3.0, 2.0, 1.2][i];
              if(sig === undefined) return;
              seg2.querySelectorAll('button').forEach(function(o){
                o.classList.remove('on');
              });
              b.classList.add('on');
              /* editShot, not editAssist (m49, audit 2026-10-10): this owns a
                 shotAssist field, and editAssist would write an aim-assist
                 block into a timing-only pack */
              editShot(function(n){
                if(!n.shotAssist || typeof n.shotAssist !== 'object'){
                  n.shotAssist = {};
                }
                n.shotAssist.confidenceSigmas = sig;
              }, i === 0 ? 'Strict — it will hand more shots back to you'
               : i === 2 ? 'Loose — it will act on rougher readings'
                         : 'Normal caution');
            });
          });
          return;
        }
        /* the model's aim point — wired exactly as the colour "Aim at" seg
           is, writing the one field it owns through editAssist */
        if(segLab === 'Aim the model at'){
          seg2.querySelectorAll('button').forEach(function(b, i){
            b.addEventListener('click', function(){
              seg2.querySelectorAll('button').forEach(function(o){
                o.classList.remove('on');
              });
              b.classList.add('on');
              editAssist(function(n){
                n.model = (n.model && typeof n.model === 'object') ? n.model : {};
                n.model.aimAt = i === 0 ? 'head' : 'body';
              }, i === 0 ? 'Aiming the model at heads'
                         : 'Aiming the model at bodies');
            });
          });
          return;
        }
        if(segLab === 'Aim at'){
          seg2.querySelectorAll('button').forEach(function(b, i){
            b.addEventListener('click', function(){
              var pt = AIM_POINTS[i];
              if(!pt) return;
              seg2.querySelectorAll('button').forEach(function(o){
                o.classList.remove('on');
              });
              b.classList.add('on');
              root.querySelectorAll('.rng').forEach(function(rng){
                var fl2 = rng.closest('.fld');
                var l2 = fl2 && fl2.querySelector('.flab');
                var t2 = (l2 && l2.childNodes[0] &&
                          l2.childNodes[0].textContent || '').trim();
                if(t2 !== 'Fine tune up / down') return;
                rng.value = Math.round(pt.offsetY * 10);
                rng.dispatchEvent(new Event('input'));
              });
              editAssist(function(n){ n.offsetY = pt.offsetY; },
                         'Aiming at: ' + pt.name);
            });
          });
          return;
        }
        if(segLab !== 'How far it reaches') return;
        seg2.querySelectorAll('button').forEach(function(b, i){
          b.addEventListener('click', function(){
            var pre = REACH_PRESETS[i];
            if(!pre) return;
            seg2.querySelectorAll('button').forEach(function(o){
              o.classList.remove('on');
            });
            b.classList.add('on');
            /* Move the two sliders with it, so the screen never shows a
               number that is not what the board was just told. */
            root.querySelectorAll('.rng').forEach(function(rng){
              var fld=rng.closest('.fld'), lb=fld&&fld.querySelector('.flab');
              var t=(lb&&lb.childNodes[0]&&lb.childNodes[0].textContent||'').trim();
              if(t === 'Reach') rng.value = Math.round(pre.window * 100);
              else if(t === 'Leave alone when this close')
                rng.value = Math.round(pre.deadZone * 100);
              else return;
              rng.dispatchEvent(new Event('input'));   // repaint the readout
            });
            editAssist(function(n){
              n.assist.window = pre.window;
              n.assist.deadZone = pre.deadZone;
            }, 'Reach: ' + pre.name);
          });
        });
      });
      root.querySelectorAll('select.sel').forEach(function(sel){
        var opts=[].map.call(sel.options,function(o){return o.text;}).join();
        if(opts.indexOf('Only while aiming')<0) return;
        sel.addEventListener('change', function(){
          var keys=['always','hip','ads','fire'];
          editAssist(function(n){ n.assist.activation = keys[sel.selectedIndex] || 'ads'; });
        });
      });

    }};
  };

  /* what the other screen files use from this one */
  SEC.cvToolsOf = cvToolsOf;
});
