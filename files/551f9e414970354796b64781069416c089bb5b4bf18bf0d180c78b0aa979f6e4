       preventDefault, so tapping and SCROLLING both still work over the
       picture. Only "Draw boxes" mode takes the page's touch away, and only
       while it is chosen. */
    function onClick(e){
      if(!st || !st.running) return;
      /* THE SHOT-METER TEACH FLOW owns the stage while it is armed — from
         any tab: the user started it from its own button, the banner offers
         the cancel, and nothing here can fall through to the colour teach
         below. */
      if(shotTeach){
        if(e.target && e.target.id === 'cv-arm'){ shotTeach = null; paint(); return; }
        if(shotTeach.phase === 'box') return;    /* box phase: taps are drag ends */
        if(shotBusy) return;
        if(picOff() || !imgOk){
          ZS.toast('Turn the picture on first — the colour is a thing you tap');
          return;
        }
        var nz = normOf(e);
        if(!nz) return;
        shotColourTap(shotTeach.phase, nz.x, nz.y);
        return;
      }
      /* In box mode a tap is the end of a drag, and a drag still works with
         the picture off — so this test comes before the picture one. */
      if(mode === 'box' && armTeach < 0) return;
      /* The stage's deliberate off state answers a tap by turning the
         picture back on — the hint above says exactly that, and it works
         from any tab because it is not a teach gesture. (The stopped state
         already returned above; its hint points at Start instead.) */
      if(picOff()){ setPicEnabled(true); return; }
      /* TEACHING LIVES ON THE TUNE TAB. A stray tap on the picture from Play
         must not silently re-teach the hunt colour — for the person this
         product is for, a stray tap is an ordinary event, not a rarity. One
         toast per gesture: the box path never reaches here (returned above,
         its own gate toasts at pointerdown), so this is the click gesture's
         only toast. The one thing still allowed is cancelling an armed teach
         from its own banner. */
      if(CV_TAB !== 'Tune'){
        if(armTeach >= 0 && e.target && e.target.id === 'cv-arm'){
          armTeach = -1; paint(); return;
        }
        ZS.toast('Colour and box teaching is on the Tune tab');
        return;
      }
      /* Picking a colour means tapping the thing you want it to notice, and
         there is nothing to tap at. Say so; a tap that vanishes silently is
         how a screen teaches somebody that it is broken. */
      if(picOff()){
        ZS.toast('Turn the picture on first — picking a colour means tapping the '+
                 'thing you want your adapter to notice.', {ms:5000});
        return;
      }
      if(!imgOk) return;
      var tgt = e.target;
      if(armTeach >= 0){
        if(tgt && tgt.id === 'cv-arm'){ armTeach = -1; paint(); return; }
        var na = normOf(e);
        if(!na) return;
        teachColourAt(armTeach, na.x, na.y);
        return;
      }
      if(mode === 'box') return;      /* in box mode a tap is a drag's end */
      var n = normOf(e);
      if(!n) return;
      /* unchanged behaviour: a tap on the picture teaches the hunt colour */
      tap = {x:n.x, y:n.y, at:Date.now()};
      paint();
      setTarget({x: Math.round(n.x*10000)/10000, y: Math.round(n.y*10000)/10000},
                'Learned that colour');
    }
    stage.addEventListener('click', onClick);

    function onDown(e){
      /* canMark, not imgOk: boxes are geometry, and the stage keeps the shape
         of the screen with the picture off, so drawing and moving them still
         does exactly what it says. */
      if(!canMark()) return;
      /* the meter box, in the teach flow's box phase — the SAME drag kinds
         (move / handle-resize / draw-new) the region boxes use, applied to
         shotTeach.rect and never saved as a region */
      if(shotTeach && shotTeach.phase === 'box'){
        if(e.button !== undefined && e.button !== 0) return;
        var sn = normOf(e);
        if(!sn) return;
        var sTgt = e.target;
        var sH = sTgt && sTgt.closest ? sTgt.closest('[data-hz]') : null;
        var sB = sTgt && sTgt.closest ? sTgt.closest('[data-ri]') : null;
        if(sH && sB && +sB.getAttribute('data-ri') === SHOT_RI){
          drag = {kind:sH.getAttribute('data-hz'), i:SHOT_RI, shot:true,
                  from:sn, orig:cvRect(shotTeach.rect), moved:false};
        } else if(sB && +sB.getAttribute('data-ri') === SHOT_RI){
          drag = {kind:'move', i:SHOT_RI, shot:true, from:sn,
                  orig:cvRect(shotTeach.rect), moved:false};
        } else {
          drag = {kind:'new', i:SHOT_RI, shot:true, from:sn, orig:null, moved:false};
          ghost = [sn.x, sn.y, 0, 0];
        }
        e.preventDefault();
        startTracking();
        return;
      }
      if(mode !== 'box' || armTeach >= 0) return;
      /* the pointerdown half of the Tune gate: a drag that would draw or
         move a box is refused before it starts, with one toast for the whole
         gesture (onUp sees drag === null and does nothing; onClick returns
         silently in box mode, so this cannot double) */
      if(CV_TAB !== 'Tune'){
        ZS.toast('Colour and box teaching is on the Tune tab');
        return;
      }
      if(e.button !== undefined && e.button !== 0) return;
      var n = normOf(e);
      if(!n) return;
      var tgt = e.target;

      var hEl = tgt && tgt.closest ? tgt.closest('[data-hz]') : null;
      var bEl = tgt && tgt.closest ? tgt.closest('[data-ri]') : null;
      if(hEl && bEl){
        drag = {kind:hEl.getAttribute('data-hz'), i:+bEl.getAttribute('data-ri'),
                from:n, orig:cvRect(regs[+bEl.getAttribute('data-ri')].rect), moved:false};
      } else if(bEl){
        var bi = +bEl.getAttribute('data-ri');
        if(sel !== bi){ sel = bi; paint(); }
        drag = {kind:'move', i:bi, from:n, orig:cvRect(regs[bi].rect), moved:false};
      } else {
        if(regs.length >= CV_MAX_REGIONS){
          ZS.toast('That is as many boxes as your adapter will take');
          return;
        }
        drag = {kind:'new', i:-1, from:n, orig:null, moved:false};
        ghost = [n.x, n.y, 0, 0];
      }
      e.preventDefault();
      startTracking();
    }

    function onMove(e){
      if(!drag) return;
      var n = normOf(e);
      if(!n) return;
      if(Math.abs(n.cx - drag.from.cx) > 4 || Math.abs(n.cy - drag.from.cy) > 4)
        drag.moved = true;
      e.preventDefault();
      if(drag.kind === 'new'){
        ghost = [Math.min(drag.from.x, n.x), Math.min(drag.from.y, n.y),
                 Math.abs(n.x - drag.from.x), Math.abs(n.y - drag.from.y)];
        paintBoxes();
        return;
      }
      var o = drag.orig, dx = n.x - drag.from.x, dy = n.y - drag.from.y;
      var q;
      if(drag.kind === 'move'){
        q = [o[0]+dx, o[1]+dy, o[2], o[3]];
        q[0] = Math.max(0, Math.min(1-o[2], q[0]));
        q[1] = Math.max(0, Math.min(1-o[3], q[1]));
      } else {
        var x0 = o[0], y0 = o[1], x1 = o[0]+o[2], y1 = o[1]+o[3];
        var k = drag.kind;
        if(k.indexOf('w') >= 0) x0 = Math.min(x1 - CV_MIN_SIDE, cv01(o[0]+dx));
        if(k.indexOf('e') >= 0) x1 = Math.max(x0 + CV_MIN_SIDE, cv01(o[0]+o[2]+dx));
        if(k.indexOf('n') >= 0) y0 = Math.min(y1 - CV_MIN_SIDE, cv01(o[1]+dy));
        if(k.indexOf('s') >= 0) y1 = Math.max(y0 + CV_MIN_SIDE, cv01(o[1]+o[3]+dy));
        q = [x0, y0, x1-x0, y1-y0];
      }
      if(drag.shot){ if(shotTeach) shotTeach.rect = cvRect(q); }
      else if(regs[drag.i]) regs[drag.i].rect = cvRect(q);
      paintBoxes();
    }

    function onUp(e){
      stopTracking();
      var d = drag;
      drag = null;
      if(!d) return;
      /* the meter box: commit the gesture to shotTeach.rect and stop — it is
         never a region, so no saveRegions and no naming sheet */
      if(d.shot){
        if(d.kind === 'new'){
          var sg = ghost;
          ghost = null;
          if(shotTeach && sg && sg[2] >= CV_MIN_SIDE && sg[3] >= CV_MIN_SIDE){
            shotTeach.rect = cvRect(sg);
          }
        }
        /* a full paint, not just the boxes: the card under the picture says
           how big the box the finger just drew is, and a number that only
           catches up on the next poll is a number the user does not trust */
        paint();
        return;
      }
      if(d.kind === 'new'){
        var g = ghost;
        ghost = null;
        if(!g || g[2] < CV_MIN_SIDE || g[3] < CV_MIN_SIDE){
          /* too small to be a box — treat it as "nothing here", which is the
             gesture that clears the selection */
          if(sel >= 0){ sel = -1; paint(); } else paintBoxes();
          return;
        }
        addRegion(cvRect(g));
        return;
      }
      if(!d.moved && d.kind === 'move'){
        openRegionSheet(d.i);
        return;
      }
      saveRegions('Box moved');
    }

    var tracking = false;
    function startTracking(){
      if(tracking) return;
      tracking = true;
      if(HASP){
        document.addEventListener('pointermove', onMove, {passive:false});
        document.addEventListener('pointerup', onUp);
        document.addEventListener('pointercancel', onUp);
      } else {
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
        document.addEventListener('touchmove', onMove, {passive:false});
        document.addEventListener('touchend', onUp);
        document.addEventListener('touchcancel', onUp);
      }
    }
    function stopTracking(){
      if(!tracking) return;
      tracking = false;
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerup', onUp);
      document.removeEventListener('pointercancel', onUp);
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onUp);
      document.removeEventListener('touchcancel', onUp);
    }
    if(HASP) stage.addEventListener('pointerdown', onDown);
    else {
      stage.addEventListener('mousedown', onDown);
      stage.addEventListener('touchstart', onDown, {passive:false});
    }

    /* ── creating, naming, teaching, deleting ───────────────────── */
    function addRegion(rect){
      var taken = {}, i;
      for(i=0;i<regs.length;i++) if(regs[i].id) taken[regs[i].id] = 1;
      var name = 'Area '+(regs.length+1);
      regs.push({ id: cvRegId(name, taken), name: name, rect: rect,
                  purpose: 'custom' });
      sel = regs.length - 1;
      paint();
      saveRegions('');
      openRegionSheet(sel);
    }

    /* The colour is read off the PICTURE, in the app, not asked of the board.
       That is deliberate on two counts: the frame on screen is the frame the
       adapter is looking at, so the pixel really is the right one; and the
       board's only "read a colour" route also CHANGES the colour it hunts for,
       so borrowing it here would silently re-aim the whole detector every time
       somebody taught a box. A median of a small patch, for the same reason
       sample_point() takes one: a finger lands on an edge as often as not, and
       the mean of two colours is a third colour that is on screen nowhere. */
    function teachColourAt(i, x, y){
      var r = regs[i];
      armTeach = -1;
      if(!r){ paint(); return; }
      var q = cvRect(r.rect);
      if(x < q[0] || x > q[0]+q[2] || y < q[1] || y > q[1]+q[3]){
        ZS.toast('Tap inside the box you are teaching');
        armTeach = i; paint(); return;
      }
      var hex = sampleHexAt(x, y);
      if(!hex){
        ZS.toast('Couldn’t read the colour there — try again');
        paint(); return;
      }
      r.colour = r.colour || {};
      r.colour.hex = hex;
      if(typeof r.colour.tolerance !== 'number') r.colour.tolerance = 45;
      tap = {x:x, y:y, at:Date.now()};
      paint();
      saveRegions('Learned that colour for “'+String(r.name||'this box')+'”');
    }
    function sampleHexAt(x, y){
      try{
        var w = im.naturalWidth, h = im.naturalHeight;
        if(!w || !h) return '';
        var px = Math.max(0, Math.min(w-1, Math.round(x*w)));
        var py = Math.max(0, Math.min(h-1, Math.round(y*h)));
        var n = 7;
        var sx = Math.max(0, Math.min(w-n, px - 3));
        var sy = Math.max(0, Math.min(h-n, py - 3));
        var cvs = document.createElement('canvas');
        cvs.width = n; cvs.height = n;
        var ctx = cvs.getContext('2d');
        if(!ctx) return '';
        ctx.drawImage(im, sx, sy, n, n, 0, 0, n, n);
        var d = ctx.getImageData(0, 0, n, n).data;
        var rs = [], gs = [], bs = [], k;
        for(k=0;k<d.length;k+=4){ rs.push(d[k]); gs.push(d[k+1]); bs.push(d[k+2]); }
        function mid(a){ a.sort(function(p,q){ return p-q; }); return a[a.length>>1]|0; }
        function hx(v){ var s = v.toString(16).toUpperCase(); return s.length<2?'0'+s:s; }
        return hx(mid(rs))+hx(mid(gs))+hx(mid(bs));
      } catch(e){ return ''; }
    }


    /* ── tying Smart Actions to a taught picture (D110) ──────────────────
       The owner's ask, in his words: "make it where the cv tab can connect to
       smart actions, in the cv tab you can have parameters to turn on certain
       smart actions like tying them to guns". So a `match` box's taught
       pictures each carry a list of Smart Action ids, and when the adapter
       sees that picture those actions are the armed ones.

       WHERE IT LIVES. In the config, under the picture it belongs to:
       vision.regions[i].match.templates[j].actions. That is the same place
       the picture itself lives, so one save carries both and there is no
       second thing to keep in step. The board reads it out of the profile's
       VISION section (D110) and nothing new goes over the wire.

       THE IDS, NOT THE NAMES. A Smart Action's id is stable and its name is
       whatever the owner typed today; the encoder turns an id into the index
       the device actually uses. Storing a name here would break the moment
       somebody renamed an action, which is the one thing people do to their
       macros. */

    /* The kind block's own templates list, created only when something is
       about to be written into it. Reading never adds a block, because an
       empty `match:{templates:[]}` appearing in a config nobody edited is a
       diff that means nothing. */
    function tplList(r, make){
      var kind = cvKindOf(r);
      if(kind !== 'match' && kind !== 'digits') return [];
      var block = r[kind];
      if(block && typeof block === 'object' && Array.isArray(block.templates)){
        return block.templates;
      }
      if(Array.isArray(r.templates)) return r.templates;
      if(!make) return [];
      if(!block || typeof block !== 'object'){ block = r[kind] = {}; }
      block.templates = [];
      return block.templates;
    }

    /* Every name this box knows, the config's first and then any the adapter
       reports that the config has not caught up with. BOTH, because they come
       apart in a way a person would otherwise have to guess at: a picture
       taught a moment ago is on the adapter before the config has been saved,
       and a config restored onto a fresh adapter has names the adapter has
       never seen. */
    function taughtLabels(r, i){
      var out = [], seen = {}, j;
      var list = tplList(r, false);
      for(j=0;j<list.length;j++){
        var lab = String((list[j] && list[j].label) || '').trim();
        if(lab && !seen[lab]){ seen[lab] = 1; out.push(lab); }
      }
      var live = regState[r.id] && regState[r.id].taught;
      if(Array.isArray(live)){
        for(j=0;j<live.length;j++){
          var l2 = String(live[j] || '').trim();
          if(l2 && !seen[l2]){ seen[l2] = 1; out.push(l2); }
        }
      }
      return out;
    }

    /* THE PICTURE ITSELF, cropped out of the frame on screen and shrunk to
       the 32x16 greyscale patch a Core's matcher compares (D110).

       WHY THE APP AND NOT THE BOARD. An EXO teaches its own kind of picture
       (a binarised ink bitmap, whatever size the crop was) and keeps it on
       the board; a Core reads a different thing entirely and reads it out of
       the CONFIG, so the config has to carry it and the app is the only place
       that has both the frame and the box. The maths is
       ZSPROFILE.visionPatchFrom, which is corner_read's own downscaler,
       because a different rounding rule here would make every taught picture
       slightly wrong in a way no field comparison would ever show.

       Returns '' when there is no picture to crop, and '' is not a failure:
       the picture was still taught on the adapter that has one, and the
       encoder is what says plainly that a Core cannot use it. */
    function patchOf(rect){
      try{
        var w = im.naturalWidth, h = im.naturalHeight;
        if(!w || !h || !imgOk) return '';
        if(!window.ZSPROFILE || typeof ZSPROFILE.visionPatchFrom !== 'function') return '';
        var cvs = document.createElement('canvas');
        cvs.width = w; cvs.height = h;
        var ctx = cvs.getContext('2d');
        if(!ctx) return '';
        ctx.drawImage(im, 0, 0, w, h);
        var d = ctx.getImageData(0, 0, w, h).data;
        var gray = new Array(w*h);
        /* Rec. 601 luma, the same weighting every capture chip and every
           JPEG decoder in this path already uses to make a Y plane. The
           board's frames arrive as luma already; this is how a colour
           preview is turned into the same thing. */
        for(var k=0, q=0; k<d.length; k+=4, q++){
          gray[q] = (d[k]*77 + d[k+1]*150 + d[k+2]*29) >> 8;
        }
        return ZSPROFILE.visionPatchFrom(gray, w, h, rect) || '';
      } catch(e){ return ''; }
    }

    function tplFor(r, label, make){
      var list = tplList(r, make);
      for(var j=0;j<list.length;j++){
        if(list[j] && String(list[j].label||'').trim() === label) return list[j];
      }
      if(!make) return null;
      var made = {label: label};
      list.push(made);
      return made;
    }

    /* Which Smart Actions one picture turns on. The adapter's own answer wins
       when the config has nothing to say, so a config saved by an older app
       still shows what the adapter is doing rather than an empty list. */
    function actionsFor(r, label){
      var t = tplFor(r, label, false);
      if(t && Array.isArray(t.actions)) return t.actions.slice(0);
      var live = regState[r.id] && regState[r.id].actions;
      if(live && Array.isArray(live[label])) return live[label].slice(0);
      return [];
    }

    /* The Smart Actions this config has, as {id, name}.

       TWO SOURCES, MERGED, and both are needed. smart-actions.js owns the
       editor's list and publishes it as ZS.saState, which is where an action
       the owner made a minute ago lives; but that list is only filled in when
       the Mappings screen itself has been opened (its hydrate() runs in
       render()), and somebody who came straight here would otherwise be told
       this config has no macros when it plainly does. So the CONFIG's own
       accessibilityActions are read too, and anything the editor has not
       caught up with is added. Neither list is rebuilt here: two copies of
       one person's macros would drift on the first rename. */
    function smartActions(){
      var out = [], seen = {}, j;

      /* `auto`: a weapon's Auto Action (D122). Named here, so a picture's
         row can say what it turns on; never offered in the picker below,
         because the Auto Actions tab is the one place that ties those. */
      function add(id, name, auto){
        if(!id || seen[id]) return;
        seen[id] = 1;
        out.push({id: id, name: String(name||'').trim() || 'Untitled Script', auto: !!auto});
      }
      try {
        var S = (typeof ZS.saState === 'function') ? ZS.saState(p) : null;
        var list = (S && Array.isArray(S.actions)) ? S.actions : [];
        for(j=0;j<list.length;j++){ if(list[j]) add(list[j].id, list[j].name); }
      } catch(e){ /* a config with no Smart Actions is an empty list, not a fault */ }
      var full = (ZS.live && ZS.live.full && ZS.live.full[p.id]) || p;
      var board = (full && Array.isArray(full.accessibilityActions))
        ? full.accessibilityActions : [];
      for(j=0;j<board.length;j++){ if(board[j]) add(board[j].id, board[j].name, !!board[j].auto); }
      return out;
    }

    function actionNames(ids){
      var all = smartActions(), out = [], j, k;
      for(j=0;j<ids.length;j++){
        var nm = null;
        for(k=0;k<all.length;k++) if(all[k].id === ids[j]) nm = all[k].name;
        /* An id with no action behind it is shown as the id. It means the
           macro was deleted, and saying so beats hiding it: the encoder
           refuses a picture that names an action the config does not have. */
        out.push(nm || ids[j]);
      }
      return out;
    }

    /* The picker: one row per Smart Action, on or off for this picture.
       Sequential sheets, the way every other door in this tab works: this one
       closes and re-opens the area's sheet when it is done. */
    function openActionSheet(i, label){
      var r = regs[i];
      if(!r) return;
      var all = smartActions().filter(function(a){ return !a.auto; });
      var chosen = actionsFor(r, label);
      var on = {};
      var j;
      for(j=0;j<chosen.length;j++) on[chosen[j]] = 1;

      var rows = all.map(function(a){
        return '<button class="pk'+(on[a.id]?' on':'')+'" data-saact="'+esc(a.id)+'"'+
          ' style="display:block;width:100%;text-align:left;padding:11px 12px;margin-top:7px">'+
          '<b style="display:block;font-size:14px">'+esc(a.name)+'</b>'+
          '<span style="display:block;color:var(--muted);font-size:11.5px;'+
            'margin-top:2px">'+(on[a.id] ? 'on while this is on screen'
                                         : 'not tied to this one')+'</span>'+
          '</button>';
      }).join('');

      var body = all.length
        ? note('Tick the Scripts that should be ON while your adapter sees '+
               '<b>'+esc(label)+'</b>. Everything else you have tied to this box '+
               'goes off at the same moment. A macro you tie to nothing here is '+
               'left alone and keeps working the way your config says.')+
          '<div id="cv-actpick">'+rows+'</div>'
        : note('This config has no Scripts yet. Make one on the Mappings '+
               'screen first and it will show up here.', 'warn');

      var sb = ZS.sheetOpen(label, body, function(){ paint(); });
      /* THE LISTENER GOES ON A FRESH ELEMENT, NOT ON THE SHEET BODY. There is
         one #sheetbody in the whole app and sheetOpen only replaces its
         innerHTML, so a listener put on it survives every later sheet and
         stacks up. On a toggle that is fatal: two handlers turn a tie on and
         straight back off, which looks exactly like the tap not working. The
         wrapper below is built fresh on every open, so its listeners go with
         it. */
      var pick = sb.querySelector('#cv-actpick');
      if(pick) pick.addEventListener('click', function(e){
        var t = e.target && e.target.closest ? e.target.closest('[data-saact]') : null;
        if(!t) return;
        var id = t.getAttribute('data-saact');
        var now = actionsFor(r, label);
        var at = now.indexOf(id);
        if(at >= 0) now.splice(at, 1); else now.push(id);
        /* Written into the config, under the picture, and saved through the
           one path every other region edit uses. */
        tplFor(r, label, true).actions = now;
        saveRegions('Saved');
        ZS.sheetClose();
        openActionSheet(i, label);
      });
    }

    function openRegionSheet(i){
      var r = regs[i];
      if(!r) return;
      sel = i; paint();
      var kind = cvKindOf(r);
      var res = resultOf(r, i);
      var pur = String(r.purpose||'').toLowerCase();
      var kinds = CV_KINDS.map(function(row){
        var need = row[3];
        var off = need && reader !== true;
        return '<button class="pk'+(row[0]===kind?' on':'')+'" data-cvk="'+row[0]+'"'+
          (off?' disabled':'')+
          ' style="display:block;width:100%;text-align:left;padding:11px 12px;margin-top:7px'+
            (off?';opacity:.5':'')+'">'+
          '<b style="display:block;font-size:14px">'+cvKindArt(row[0], r)+esc(row[1])+
            (off?' <span style="font-weight:600;font-size:11px;color:var(--amber)">— your adapter can’t do this yet</span>':'')+
          '</b>'+
          '<span style="display:block;color:var(--muted);font-size:11.5px;line-height:1.5;'+
            'margin-top:2px">'+esc(row[2])+'</span></button>';
      }).join('');
      var purposes = CV_PURPOSES.map(function(pp){
        return '<button data-cvpur="'+pp[0]+'"'+(pp[0]===pur?' class="on"':'')+'>'+
          esc(pp[1])+'</button>';
      }).join('');
      var teach = '';
      if(kind === 'colour'){
        var sw = (r.colour && r.colour.hex)
          ? '<span style="display:inline-block;width:16px;height:16px;border-radius:5px;'+
            'vertical-align:-3px;margin-right:8px;border:1px solid rgba(255,255,255,.25);'+
            'background:#'+cvHex(r.colour.hex)+'"></span>' : '';
        teach = sh('Teach it')+
          card('<div class="stat"><span>Colour it watches for</span><b>'+sw+
            ((r.colour && r.colour.hex) ? 'learned' : 'not taught yet')+'</b></div>')+
          note('Point your game at the thing, then tap <b>Show it the colour</b> and '+
               'tap that colour inside the box on the picture. You never type a colour code.')+
          btn('Show it the colour','primary','cv-teachcol');
      } else if(kind === 'match' || kind === 'digits'){
        /* the weapon the Auto Actions tab sent the player here to teach, if
           any (D122): its name is filled in and said, so one tap teaches it */
        var autoAsk = (kind === 'match' && window.ZSAUTO && ZSAUTO.asking) ? ZSAUTO.asking(p) : null;
        teach = sh('Teach it')+
          (reader === true
            ? (autoAsk && autoAsk.say ? note(autoAsk.say) :
               autoAsk ? note('Teaching the <b>'+esc(autoAsk.name)+'</b> for Auto Actions. Hold it '+
                   'in the game so its name is in the box, then tap <b>Show it this one</b>.') : '')+
              note('Get the thing you want it to know on screen — the gun, the mode — '+
                   'so it fills the box. Type what you call it, then tap <b>Show it this '+
                   'one</b>. Do that once for each one.')+
              card('<div class="fld col"><div class="flab">What is on screen right now?</div>'+
                '<input class="txt" id="cv-tplname" data-nosave="1" maxlength="28" '+
                'value="'+esc(autoAsk ? autoAsk.label : '')+'" '+
                'placeholder="e.g. Sniper" aria-label="name for what is on screen"></div>')+
              btn('Show it this one','primary','cv-teachtpl')+
              note('Draw the box with a clear margin around the words. A box drawn tight '+
                   'against the text is the one thing that makes this stop working.','warn')
            : note('Teaching needs your adapter’s region reader, which it does not have '+
                   'yet. Nothing is saved half-done in the meantime.', 'warn'));
      }
      /* WHAT EACH TAUGHT PICTURE TURNS ON. Only for a `match` box, and only
         once something has been taught, because a list of nothing is a row
         that teaches a person nothing. */
      var ties = '';
      if(kind === 'match'){
        var labs = taughtLabels(r, i);
        if(labs.length){
          /* THE SAME .pk ROW THE KIND PICKER ABOVE USES, deliberately: it is
             already on this screen twice, it puts the name and what it does on
             two lines without clipping either, and the WHOLE row is the target
             rather than a 38px chevron beside it. This product's users are the
             reason that matters. */
          ties = sh('What each one turns on')+
            '<div id="cv-ties">'+labs.map(function(lab){
              var names = actionNames(actionsFor(r, lab));
              return '<button class="pk" data-cvact="'+esc(lab)+'"'+
                ' style="display:block;width:100%;text-align:left;padding:11px 12px;'+
                  'margin-top:7px">'+
                '<b style="display:block;font-size:14px">'+esc(lab)+'</b>'+
                '<span style="display:block;color:var(--muted);font-size:11.5px;'+
                  'line-height:1.5;margin-top:2px">'+
                (names.length ? esc(names.join(', '))
                              : 'nothing tied to it yet')+
                '</span></button>';
            }).join('')+
            '</div>'+
            note('Tie your Scripts to the things this box reads. When your '+
                 'adapter sees one of them, the macros you tied to it turn on and '+
                 'the ones you tied to the others turn off. A macro you have not '+
                 'tied to anything here is never touched.');
        } else if(reader === true){
          ties = sh('What each one turns on')+
            note('Teach it something first, above. Then you can tie your Smart '+
                 'Actions to each one, so the right macros come on by themselves '+
                 'when that gun is in your hands.');
        }
      }
      /* The whole sheet sits in a wrapper built fresh on every open (B2,
         audit 2026-10-10): the tap handler below goes on it, NOT on the
         shared #sheetbody, which keeps every listener ever added. A body
         listener made each earlier box sheet answer this one's taps, so a
         tap here rewrote other boxes (a gun-name box lost its kind) and sent
         one PUT per stacked listener. Same rule as #cv-actpick above. */
      var body = '<div id="cv-rsheet">'+
        '<div class="fld col"><div class="flab">What do you call it?</div>'+
          '<input class="txt" id="cv-rname" data-nosave="1" maxlength="28" '+
          'value="'+esc(r.name||'')+'" aria-label="name for this area"></div>'+
        sh('What should your adapter do with it?')+
        kinds+
        (kind === 'ignore'
          ? sh('Which bit of the screen is it?')+
            '<div class="seg2">'+purposes+'</div>'+
            note('Only these names count as HUD, and only HUD boxes get skipped — so this is what '+
                 'makes the box real.')
          : '')+
        teach+
        ties+
        sh('What your adapter says about it right now')+
        card('<div class="stat"><span>State</span><b>'+esc(res.chip||'—')+'</b></div>')+
        note(esc(res.line))+
        btn('Delete this box','danger','cv-rdel')+
        '</div>';
      var sb = ZS.sheetOpen('This area', body, function(){ paint(); });
      var rsheet = sb.querySelector('#cv-rsheet');
      var nm = sb.querySelector('#cv-rname');
      if(nm) nm.addEventListener('change', function(){
        var v = (nm.value||'').trim().slice(0,28);
        regs[i].name = v || ('Area '+(i+1));
        saveRegions('Renamed');
      });
      if(rsheet) rsheet.addEventListener('click', function(e){
        var t = e.target && e.target.closest ? e.target.closest('[data-cvk],[data-cvpur]') : null;
        if(!t) return;
        if(t.hasAttribute('data-cvk')){
          var k = t.getAttribute('data-cvk');
          if(k === 'hunt'){
            /* The search area is a purpose, and there can only be ONE — the
               scan can express one rectangle, and quietly searching the union
               of several would be a third behaviour nobody asked for. Demote
               any other hunt box rather than leaving two and letting the
               board pick. */
            delete regs[i].kind;
            regs[i].purpose = 'hunt';
            for(var q=0;q<regs.length;q++){
              if(q !== i && String(regs[q].purpose||'').toLowerCase() === 'hunt'){
                regs[q].purpose = 'custom';
              }
            }
          } else if(k === 'ignore'){
            delete regs[i].kind;
            var cur = String(regs[i].purpose||'').toLowerCase();
            var ok = false, z;
            for(z=0;z<CV_PURPOSES.length;z++) if(CV_PURPOSES[z][0]===cur) ok = true;
            if(!ok || cur === 'hunt') regs[i].purpose = 'ammo';
          } else {
            regs[i].kind = k;
            regs[i].purpose = 'custom';
          }
          saveRegions('Saved');
          ZS.sheetClose();
          openRegionSheet(i);
          return;
        }
        regs[i].purpose = t.getAttribute('data-cvpur');
        saveRegions('Saved');
        ZS.sheetClose();
        openRegionSheet(i);
      });
      /* On the ties block itself rather than on the sheet body: #sheetbody is
         one element for the whole app and keeps every listener ever put on
         it (see openActionSheet). */
      var tieBox = sb.querySelector('#cv-ties');
      if(tieBox) tieBox.addEventListener('click', function(e){
        var t = e.target && e.target.closest ? e.target.closest('[data-cvact]') : null;
        if(!t) return;
        ZS.sheetClose();
        openActionSheet(i, t.getAttribute('data-cvact'));
      });
      var tc = sb.querySelector('#cv-teachcol');
      if(tc) tc.addEventListener('click', function(){
        if(!st || !st.running || !imgOk){
          ZS.toast('Turn the picture on first'); return;
        }
        armTeach = i;
        shotTeach = null;   /* one armed teach at a time */
        ZS.sheetClose();
        paint();
      });
      var tt = sb.querySelector('#cv-teachtpl');
      if(tt) tt.addEventListener('click', function(){
        var f = sb.querySelector('#cv-tplname');
        var lab = ((f && f.value) || '').trim().slice(0, 28);
        if(!lab){ ZS.toast('Type what it is first'); if(f) f.focus(); return; }
        teachTemplate(i, lab, tt);
      });
      var del = sb.querySelector('#cv-rdel');
      if(del) armConfirm(del, function(){
        var gone = JSON.parse(JSON.stringify(regs[i]));
        regs.splice(i, 1);
        if(sel >= regs.length) sel = regs.length - 1;
        ZS.sheetClose();
        saveRegions('');
        ZS.toast('Box deleted', {action:'Undo', onAction:function(){
          regs.splice(i, 0, gone);
          sel = i;
          saveRegions('Box back');
        }});
      });
    }

    /* Teaching a template is the board's job: it has the frame in the format
       it can actually read, and the app only has a JPEG of it. So this asks,
       and reports exactly what came back — including the board's own warning
       that two things look too alike. */
    function teachTemplate(i, label, btnEl){
      var r = regs[i];
      if(!r) return;
      /* A CORE IS TAUGHT HERE, NOT OVER THE LINK (D110, D122). It reads its
         pictures out of the config and has no teach route (it answers 501),
         so asking it would lose the picture. The crop below is the whole
         teach, and saving the config is how the Core learns it. */
      if(ZS.productId && ZS.productId() === 'core'){
        if(!patchOf(cvRect(r.rect))){
          ZS.toast('There is no picture to learn from yet. Wait for the screenshot, then try again.');
          return;
        }
        keepTaught(i, label, null);
        return;
      }
      if(btnEl){ btnEl.disabled = true; btnEl.textContent = 'Looking…'; }
      function done(){
        if(btnEl){ btnEl.disabled = false; btnEl.textContent = 'Show it this one'; }
      }
      ZS.api('/vision/regions/'+encodeURIComponent(r.id)+'/teach', 'POST',
             {label: label}).then(function(j){
        done();
        if(j && j.ok){
          keepTaught(i, label, j);
        } else {
          ZS.toast((j && j.error) || 'Your adapter could not learn that');
        }
      })['catch'](function(){ done(); ZS.toast('Couldn’t reach your adapter'); });
    }
    /* What a teach leaves behind. `j` is an EXO's answer, or null on a Core.
       AND KEEP THE PICTURE IN THE CONFIG TOO (D110). The board has its own
       copy in its own form; this is the 32x16 greyscale one a Core reads out
       of the profile, cropped from the very frame that was on screen when the
       button was pressed. Written whether or not this adapter is a Core: it
       costs 683 characters and it is what lets a config made on an EXO be
       carried to one. When the Auto Actions tab sent the player here, that
       tab makes the picture its weapon's and takes them back (D122). */
    function keepTaught(i, label, j){
      var r = regs[i];
      var rect = cvRect(r.rect);
      var patch = patchOf(rect);
      if(patch){
        var t = tplFor(r, label, true);
        t.patch = patch;
        if(window.ZSAUTO && ZSAUTO.taught) ZSAUTO.taught(p, t, {img: im, rect: rect, regions: regs});
        saveRegions('');
      }
      /* The board is the one that can tell whether two of these look too
         alike, because it is the one comparing them. Say what it said. */
      var warn = j && j.data && (j.data.warning || j.data.reason);
      ZS.toast('Learned “'+label+'”'+(warn ? ' — '+warn : ''),
               warn ? {ms:7000} : undefined);
      ZS.sheetClose();
      if(window.ZSAUTO && ZSAUTO.after && ZSAUTO.after(p)) return;
      ZS.openDetail({id:'vision', lab:'Screen Assist'}, p);
    }

    /* ── the shot-meter teach flow's writes ─────────────────────────────
       POST /vision/shot-assist/teach is the regions idiom: the board applies
       what it was shown LIVE and answers with data.meter — the block THIS
       caller saves into the profile, so the config stays the source of
       truth across a restart. Teaching never touches `enabled`: an
       installed pack stays disarmed until the user throws the switch. */
    function shotSaveMeter(meter){
      if(!meter || typeof meter !== 'object') return;
      meter = JSON.parse(JSON.stringify(meter));
      /* applied live either way; the poll re-syncs, so only a write the app
         had to queue or could not keep is worth a word (M21) */
      visionWrite(p, function(f){
        if(!f.vision || typeof f.vision !== 'object') f.vision = {enabled:false};
        if(!f.vision.shotAssist || typeof f.vision.shotAssist !== 'object'){
          f.vision.shotAssist = {};
        }
        f.vision.shotAssist.meter = meter;
      }).then(function(j){
        if(j && (j.staged || j.away)) visionSaid(j, 'Meter taught');
      });
    }
    /* ── THE RELEASE-TIMING CONTROL ──────────────────────────────
       ONE WRITER. The stepper (a bubbling `zsstep`), the track (input /
       change) and the reset all land on rtSet(); rtPaint() is the only thing
       that writes the readout, the thumb and the picture. Two controls on one
       value that each paint their own readout is exactly how the two come to
       disagree on the next repaint.

       It lives in wireCv rather than in R.vision's after() because paint()
       has to hand it the board's real window width and stopAll() has to flush
       its pending write — both are wireCv's, and a control split across two
       closures is a control whose halves can drift.                        */

    /* The write. Modelled on shotSaveMeter() beside it, and deliberately NOT
       on editAssist(): editAssist's apply() unconditionally fills in
       assist.strength 0.35 and assist.activation 'ads', so on a TIMING-ONLY
       pack — Caleb's shape, where no aim-help control is even on screen —
       the first nudge of the release timing would materialise an aim assist
       he never chose. This touches exactly one field.

       aimOffsetMs reaches the running predictor on the NEXT SHOT:
       service.py rebuilds ShotPredictor(shot_cfg) on every configure,
       unguarded. There is nothing to restart and nothing to re-teach. */
    function shotSaveTrim(ms, said){
      var val = Math.max(-RT_LIMIT, Math.min(RT_LIMIT, Math.round(ms)));
      visionWrite(p, function(f){
        if(!f.vision || typeof f.vision !== 'object') f.vision = {enabled:false};
        if(!f.vision.shotAssist || typeof f.vision.shotAssist !== 'object'){
          f.vision.shotAssist = {};
        }
        f.vision.shotAssist.aimOffsetMs = val;
      }).then(function(j){ visionSaid(j, said); });
    }

    /* THE .sv IS THE AUTHORITATIVE VALUE, not the range. step="5" with
       min="-100" makes only multiples of 5 valid on the track, so an older
       off-grid −18 would render the THUMB at −20 while the true stored value
       is −18. Reading the number back out of the .sv means the readout is
       always the truth, the thumb is only ever a thumb, and nothing is
       written on render. */
    function rtVal(){
      var v = rtSv ? parseFloat(rtSv.textContent || '0') : 0;
      if(isNaN(v)) v = 0;
      return Math.max(-RT_LIMIT, Math.min(RT_LIMIT, Math.round(v)));
    }
    function rtPaint(){
      var v = rtVal();
      /* the readout is a SENTENCE, never a bare signed number */
      if(rtRvEl) rtRvEl.textContent = rtSay(v);
      /* THE SAME SENTENCE ON THREE NODES, because three different readers ask
         three different nodes for it, and two of them were saying nothing or
         saying it wrong.
         - the .rv above is what a pair of eyes reads;
         - the TRACK is the only node in this control with a NATIVE ARIA
           VALUE. Without aria-valuetext a screen reader arrowing it announces
           "minus 55" — the bare signed number this control may never be read
           as, and the one place the app cannot control the wording unless it
           writes this attribute. Checked against the rendered element: the
           range carried an aria-label and no valuetext;
         - the .sv keeps aria-valuetext for the day its role is upgraded, but
           it is a TAP-TO-TYPE target and phone.html's kb() therefore gives it
           role="button" — and aria-valuetext is IGNORED on a button. Read
           back off the live DOM, the stepper announced "edit When it lets go"
           and no number at all, so on the one control a hand with limited
           fine motor control reaches for first, the value has to ride in the
           accessible NAME as well. The +/- keys keep the labels labFor()
           wrote at wire time ("decrease When it lets go"); they are named for
           what they DO, and the value they land on is on the .sv beside
           them. */
      if(rtRng) rtRng.setAttribute('aria-valuetext', rtSay(v));
      if(rtSv){
        rtSv.setAttribute('aria-valuetext', rtSay(v));
        rtSv.setAttribute('aria-label',
                          'When it lets go, ' + rtSay(v) + ' — tap to type');
      }
      if(rtReset) rtReset.disabled = (v === 0);
      /* the thumb follows the number; it may sit up to half a step away if an
         off-grid value was loaded, and that is invisible and fine */
      if(rtRng){
        var grid = String(Math.round(v / RT_STEP) * RT_STEP);
        if(rtRng.value !== grid) rtRng.value = grid;
      }
      var h = rtRulerSVG(v, rtWinMs > 0 ? rtWinMs : RT_WINDOW_MS,
                         !(rtWinMs > 0));
      if(h !== rtLast){ rtLast = h; if(rtPicEl) rtPicEl.innerHTML = h; }
    }
    /* ONE PUT PER GESTURE. Hold-repeat fires up to 14 steps a second and the
       profile store is a file on a microSD card. Every path lands in this
       350 ms coalescer — under the stepper's own 400 ms hold-repeat delay, so
       a single tap still saves immediately as far as a hand can tell. */
    function rtCommit(){
      if(rtPutT){ clearTimeout(rtPutT); rtPutT = null; }
      var v = rtVal();
      shotSaveTrim(v, 'Letting go ' + rtSay(v));
    }
    function rtQueue(){
      if(rtPutT) clearTimeout(rtPutT);
      rtPutT = setTimeout(rtCommit, 350);
    }
    function rtSet(v, commit){
      if(!rtSv) return;
      var n = Math.max(-RT_LIMIT, Math.min(RT_LIMIT, Math.round(v)));
      /* THE EARLY RETURN STILL REPAINTS, and that is not tidiness.
         phone.html's generic `input.rng` wiring shares this field's `.rv`
         with us and writes a BARE NUMBER into it on every `input` — it was
         wired first (wire() runs before after()), so on any `input` where the
         track's new value already equals the .sv, this function would return
         before rtPaint() and leave "-20" standing where "20 ms earlier"
         belongs. Measured in the harness: a no-op input on a -20 value turned
         the sentence back into a signed integer, which is the one thing the
         readout may never be — "+20" and "20" are the same string once a
         minus sign is dropped by a font, a squint or a screen reader. Paint,
         then leave; what the guard is FOR is not queueing a second PUT for a
         value that did not move. */
      if(n === rtVal() && !commit){ rtPaint(); return; }
      rtSv.textContent = String(n);
      rtPaint();
      if(commit) rtCommit(); else rtQueue();
    }
    /* The kit's stepper does the stepping, the clamping, the hold-repeat and
       — the affordance that matters most to a hand with limited fine motor
       control — the TAP-TO-TYPE, which is the one-tap route from 0 to −55
       instead of eleven presses. It announces itself with a bubbling
       `zsstep`, the same hook the mouse calibration already listens on. */
    if(rtSv) rtSv.addEventListener('zsstep', function(){ rtPaint(); rtQueue(); });
    if(rtRng){
      /* `input` tracks the finger and only queues; `change` is the end of the
         gesture and commits. A drag therefore writes once, at the end. */
      rtRng.addEventListener('input',  function(){ rtSet(+rtRng.value || 0, false); });
      rtRng.addEventListener('change', function(){ rtSet(+rtRng.value || 0, true); });
    }
    if(rtReset) rtReset.addEventListener('click', function(){
      if(rtVal() !== 0) rtSet(0, true);
    });
    /* the dots are delegated from their own slot, so a repaint replaces the
       dots and never the listener — the #cv-shotbtn idiom */
    if(rtOutEl) rtOutEl.addEventListener('click', function(e){
      var d = e.target && e.target.closest ? e.target.closest('[data-rtwhy]') : null;
      if(!d) return;
      ZS.toast(d.getAttribute('data-rtwhy') || '', {ms:4200});
    });
    /* First paint, at wire time and with no board answer yet: the ruler is
       correct on frame one because nothing in it is derived from a fit. It
       also overwrites the ".rv" that phone.html's own input.rng wiring filled
       with a bare number a moment ago — wire() runs before after(), so this
       is the last word on that node. */
    rtPaint();

    /* ── WHAT THE LAST SHOT DID ────────────────────────────────
       A pure function of the holder's own tape, so put()'s cache leaves it
       alone on an unchanged poll and a seq that goes BACKWARDS (a reconfigure
       resets the counter) simply re-derives from the new tape rather than
       needing a reset of its own.

       "IT LET GO FOR YOU" AND "IT STOOD BACK" ARE NOT THE SAME OBJECT. They
       call for opposite responses from him — one is the feature working, the
       other is his own thumb having been what counted — so they differ in
       fill, in border and in words, never in hue alone.

       A DECLINE NEVER SHOWS A RELEASE TIME. The tape carries holdMs: null on
       a decline for exactly this reason (actions/shot_assist.py), and a
       millisecond next to "it stood back" would be a number from some
       earlier shot.

       AND THE CARD NEVER SAYS HOW EARLY OR LATE HE WAS. lastErrorMs is loop
       quantisation — measured on his board at 0.07..6.41 ms, mean 2.8 — and
       the payload's own errorMsMeaning says in as many words that it is "not
       how early or late you were on the meter". Only 2K knows that, so only
       2K's own words are quoted here.

       THE THIRD STATE, "it could not see the meter", is deliberately NOT
       drawn here: #cv-shotstat already carries the board's own sentence for
       it ("It cannot see the meter in your box" + notFoundWhy) immediately
       below, and two cards saying one thing is worse than one. So while the
       reader is blind the STOOD-BACK card is suppressed and the explanation
       is left to the note that has the words for it.
       A taped RELEASE still draws its card even then, and that is on
       purpose: `blind` is about NOW (the live meter read), the tape entry is
       about a shot that already happened, and "it let go for you" was true
       when it was written. Suppressing it would hide a fact to tidy up a
       layout. */
    function rtOutHtml(){
      if(!cvToolsOf(cvVis()).shot) return '';
      var hs = shotHolder();
      if(!hs) return '';
      var tape = Array.isArray(hs.tape) ? hs.tape : [];
      if(!tape.length) return '';
      var vs = (st && st.shotAssist && typeof st.shotAssist === 'object')
               ? st.shotAssist : null;
      var vm = (vs && vs.meter && typeof vs.meter === 'object') ? vs.meter : null;
      var blind = !!(vm && vm.found === false);
      var h = '', i;

      /* CAN THE TIMING HELP YET — COMPUTED, NEVER HARD-CODED. Every design
         lane wrote a doom line from a 3-of-41 reading; by the time this
         shipped it was 14 of the last 20, and a line that says "the timing
         below cannot help" to a man it is already helping is worse than no
         line at all. So it is derived from the LAST TEN tape entries and it
         disappears by itself the moment the reader improves. Under five
         shots there is nothing to have an opinion about. */
      var last10 = tape.slice(-10), fired10 = 0;
      for(i=0;i<last10.length;i++) if(last10[i].outcome === 'released') fired10++;
      if(last10.length >= 5 && fired10 < 4){
        /* THE REASON IS COUNTED OVER THE SAME TEN SHOTS THE SENTENCE IS
           ABOUT. hs.reasons is the holder's CUMULATIVE counter — on the
           owner's board that is 70 declines, most of them from before the
           reader was taught — so reading the top key out of it could name a
           reason that has not happened once in the ten shots the line in
           front of it is describing. The whole point of computing this line
           from the last ten (rather than hard-coding the 3-of-41 doom every
           design lane wrote) is defeated if the half after the dash is still
           a lifetime total. The tape carries each decline's own reason, so
           count those; the cumulative dict is only the fallback for a tape
           whose declines somehow carry no reason at all. */
        var top = '', topN = 0, rk, tally = {}, tr;
        for(i=0;i<last10.length;i++){
          if(last10[i].outcome === 'released') continue;
          tr = String(last10[i].reason || '');
          if(!tr) continue;
          tally[tr] = (tally[tr] || 0) + 1;
        }
        for(rk in tally){
          if(Object.prototype.hasOwnProperty.call(tally, rk) &&
             tally[rk] > topN){ topN = tally[rk]; top = rk; }
        }
        if(!top && hs.reasons && typeof hs.reasons === 'object'){
          for(rk in hs.reasons){
            if(Object.prototype.hasOwnProperty.call(hs.reasons, rk) &&
               hs.reasons[rk] > topN){ topN = hs.reasons[rk]; top = rk; }
          }
        }
        h += note('It only let go on <b>'+fired10+' of your last '+
                  last10.length+'</b> shots — the timing below cannot help '+
                  'until it can see the meter.'+
                  (top ? ' Most common reason: '+esc(String(top))+'.' : ''),
                  'warn');
      }

      /* the last shot itself */
      var lastE = tape[tape.length - 1];
      if(lastE && lastE.outcome === 'released'){
        var held = typeof lastE.holdMs === 'number'
          ? (Math.round(lastE.holdMs) / 1000).toFixed(2) + ' s' : '';
        h += '<div class="rtcard fired"><b>It let go for you.</b>'+
             (held ? '<em>held your button for '+esc(held)+'</em>' : '')+
             '</div>'+
             note('<b>Only 2K can tell you if that was early or late.</b> If it '+
                  'keeps saying “Slightly Late”, nudge <b>−</b>. '+
                  '“Slightly Early”, nudge <b>+</b>.');
      } else if(lastE && !blind){
        h += '<div class="rtcard stood">'+
             '<b>It stood back — your own timing is what counted.</b>'+
             (lastE.reason ? '<em>'+esc(String(lastE.reason))+'</em>' : '')+
             '</div>';
      }

      /* LAST 5 SHOTS — newest on the right. This replaces the cumulative
         "Shots it stood back from: 70" counter, which was unactionable and
         dominated by history from before the reader was tuned: 70 declines
         while 14 of the last 20 were released is a number that tells him the
         opposite of the truth. Filled = let go for you, hollow = stood back;
         the sentence beside it carries the same fact in words, because the
         fill alone would be colour doing the whole job. */
      var last5 = tape.slice(-5), fired5 = 0, dots = '';
      for(i=0;i<last5.length;i++){
        var e = last5[i], on = e.outcome === 'released';
        if(on) fired5++;
        var why = String(e.reason || (on ? 'let go for you' : 'stood back'));
        dots += '<button type="button" class="rtdot'+(on?' on':'')+'" '+
                'data-rtwhy="'+esc(why)+'" title="'+esc(why)+'" '+
                'aria-label="'+esc((on ? 'let go for you' : 'stood back')+
                                   ' — '+why)+'"></button>';
      }
      h += '<span class="rtlab">Last '+last5.length+' shots</span>'+
           '<div class="rtdots">'+dots+'</div>'+
           '<span class="rtsum">'+fired5+' of your last '+last5.length+
           ' '+(fired5 === 1 ? 'was' : 'were')+' let go for you</span>';
      return h;
    }

    function shotTeachStart(){
      if(!canSee()){
        ZS.toast('Start watching my screen and turn the picture on first — '+
                 'teaching means pointing at your own meter', {ms:5000});
        return;
      }
      var vv2 = cvVis();
      var m2 = (vv2.shotAssist && vv2.shotAssist.meter &&
                typeof vv2.shotAssist.meter === 'object') ? vv2.shotAssist.meter : {};
      armTeach = -1;   /* one armed teach at a time */
      /* A box to LOOK IN, so the default is the middle of the screen and
         not a strip: a first-timer's meter is somewhere near their player,
         and a box they have to enlarge before it can possibly work is a
         first step that teaches them the feature is broken. 30% of the
         screen, inside the board's 40% search ceiling. Whatever they taught
         last time still wins. */
      shotTeach = { phase:'box',
                    rect: cvRect(Array.isArray(m2.rect) ? m2.rect
                                                        : [0.22, 0.24, 0.56, 0.54]) };
      paint();
    }
    /* One sender for all three steps. `body` is whatever this step teaches;
       `next` is the phase to move to, or null to finish. The board's OWN
       sentence comes back either way and is shown verbatim — it names the
       problem ("the search box covers 47% of the screen — the most is 40%")
       better than any paraphrase could, and a silent clamp would leave the
       user believing they drew what they asked for. */
    function shotSend(body, next){
      if(!shotTeach || shotBusy) return;
      shotBusy = true;
      paint();
      ZS.api('/vision/shot-assist/teach', 'POST', body)
        .then(function(j){
          shotBusy = false;
          if(!shotTeach){ paint(); return; }
          if(!j || j.ok === false){
            ZS.toast((j && j.error) || 'Your adapter could not take that',
                     {ms:6500});
            paint();
            return;
          }
          if(j.data && j.data.meter) shotSaveMeter(j.data.meter);
          if(next){ shotTeach.phase = next; }
          else { shotTeach = null; }
          if(j.message) ZS.toast(String(j.message), {ms:6000});
          paint(); statusSoon();
        })['catch'](function(){
          shotBusy = false;
          ZS.toast('Couldn’t reach your adapter');
          paint();
        });
    }
    /* Step 2 or step 3: a tap on the picture. The BAR tap carries the rect
       with it, because the board's ceiling on the rect depends on the bar
       colour arriving in the same call. */
    function shotColourTap(phase, x, y){
      var q2 = cvRect(shotTeach.rect);
      if(x < q2[0] || x > q2[0]+q2[2] || y < q2[1] || y > q2[1]+q2[3]){
        ZS.toast(phase === 'bar' ? 'Tap inside the box — on the meter’s bar'
                                 : 'Tap inside the box — on the green band');
        return;
      }
      tap = {x:x, y:y, at:Date.now()};
      var pt = {x: Math.round(x*10000)/10000, y: Math.round(y*10000)/10000};
      /* A grow meter has nothing after the bar: the colour it was just given
         is what gets measured, so the flow ENDS here (next = null) instead of
         moving to a green-band step whose answer the board would store and
         never read. */
      if(phase === 'bar') shotSend({rect: q2, bar: pt}, growMeter() ? null : 'zone');
      else shotSend({zone: pt}, null);
    }
    /* "My meter never moves": send the rect on its own, which is the old
       pinned meter. The board answers with its 15% sentence if the box is too
       big for that, which is exactly the right thing to hear. */
    function shotPinBox(){
      shotSend({rect: cvRect(shotTeach.rect)}, 'zone');
    }
    /* the card's buttons repaint on every poll, so they are delegated —
       the picRow idiom */
    if(shotStatEl) shotStatEl.addEventListener('click', function(e){
      var t = e.target && e.target.closest
        ? e.target.closest('#cv-shot-teach,#cv-shot-next,#cv-shot-pin,'+
                           '#cv-shot-cancel') : null;
      if(!t || t.disabled) return;
      if(t.id === 'cv-shot-teach'){ shotTeachStart(); return; }
      if(t.id === 'cv-shot-next'){ shotTeach.phase = 'bar'; paint(); return; }
      if(t.id === 'cv-shot-pin'){ shotPinBox(); return; }
      shotTeach = null; shotBusy = false; paint();
    });

    /* One writer for the whole list. MERGE, never replace: the board keeps its
       own keys inside `vision` and validates the block whole, so sending a
       rebuilt one either throws its values away or gets rejected outright. */
    function saveRegions(said){
      var copy = JSON.parse(JSON.stringify(regs));
      /* No in-flight guard here on purpose: putProfile() already serialises
         writes per profile, and a guard that dropped the second call would
         throw away wherever the finger finished. Offline, visionWrite queues
         the boxes for Save rather than promising a replay (M21). */
      visionWrite(p, function(f){
        if(!f.vision || typeof f.vision !== 'object') f.vision = {enabled:false};
        f.vision.regions = copy;
        /* the Auto Actions ties follow the pictures (D125): a gun picture
           deleted here must take its pairs off the operator's picture
           too, or the Core would run them on the operator alone */
        if(window.ZSAUTO && ZSAUTO.retie) ZSAUTO.retie(f);
      }).then(function(j){
        visionSaid(j, said);
        statusSoon();
        paint();
      });
    }

    /* ── THE ONE WRITE THAT CAN CHANGE THE SHAPE OF THIS SCREEN ──────
       `vision.target` is the colour tool, and cvToolsOf reads it to decide
       whether this config is about aim help or about shot timing. So a stray
       write here does not just teach a colour — it re-lays the whole screen,
       un-hiding thirteen aim controls on a config that never runs the aim
       assist. That is exactly what happened to the owner's 2K26 config.
       Two refusals, and they answer different halves of it:
         * a config whose ONLY tool is the shot assist has no colour to hunt
           and no screen to show one on, so nothing may write one;
         * on a MIXED config (a pack with a colour AND a shot meter) the
           colour is real and re-teaching it must keep working — but the
           meter's OWN bar colour is still not it, so that one tap is refused
           by chroma even there.
       Checked at WRITE time, not at sheet-open time. The `mode = 'box'` guard
       further down only runs when the sheet opens and only while the config
       is already timing-only, so it can prevent the flip and can never undo
       one; this can. Returns a sentence to say, or '' to go ahead. */
    function targetRefusal(target){
      var vv = cvVis(), tl = cvToolsOf(vv);
      if(!tl.shot) return '';
      /* colourPending counts here too: a pack that declares a colour and has
         not been taught one is a config whose whole next step is teaching it,
         so the refusal must not fire on the very tap it is waiting for. */
      if(!tl.colour && !tl.colourPending && !tl.model){
        return 'This config reads the shot meter — it doesn’t hunt a colour.';
      }
      var mt = (vv.shotAssist && vv.shotAssist.meter &&
                typeof vv.shotAssist.meter === 'object') ? vv.shotAssist.meter : null;
      if(target && sameChroma(target, mt && mt.bar)){
        return 'That is the shot meter’s own colour — teach it from the Shot '+
               'assist card, not as something to aim at.';
      }
      return '';
    }
    /* The colour has to be SAVED, not just sent.
       POST /vision/target changes what the running detector hunts, and that is
       all it does — the value lives in VisionService RAM. The config keeps its
       own vision.target, and _configure_assist seeds from that on every profile
       apply and every restart. Nothing here ever wrote it, so a tapped or typed
       colour was live-only: restart the adapter, switch config, or save
       anything else on this screen, and the board went back to whatever the
       config said — for this profile, {"preset":"red"}. It read as "the aimbot
       works sometimes", because half the time it was hunting red.

       The board's ANSWER is what gets saved, not the request: it comes back as
       {u, v, radius, minLuma, maxLuma, ...}, which is what the detector
       actually resolved, and build_target() accepts that shape straight back —
       so the profile stores the real chroma pair rather than a hex string that
       would have to be re-derived. Same reason saveRegions stores the board's
       geometry rather than the finger's. */
    function rememberTarget(target){
      if(!target || typeof target !== 'object') return;
      if(targetRefusal(target)) return;
      target = JSON.parse(JSON.stringify(target));
      /* PRESET MUST BE CLEARED, and leaving it out is not enough.
         build_target() reads `preset` BEFORE u/v and returns early on it, so a
         surviving "red" beats the chroma pair we just measured. It survives
         because schema.migrate() deep-fills vision.target from the default
         profile — whose target is {"preset":"red"} — so writing a preset-less
         object still comes back merged WITH one. Measured: saving #FF2CC8 gave
         {"preset":"red","u":170,"v":221,...,"swatch":"FF2CC8"}, which resolves
         to red. An explicit empty string is falsy to `if preset:` on the board
         and survives the merge, so u/v wins. */
      if(typeof target.u === 'number' && typeof target.v === 'number'){
        target.preset = '';
      }
      /* live target still applied either way; only a queued or lost save
         is worth a word (M21) */
      visionWrite(p, function(f){
        if(!f.vision || typeof f.vision !== 'object') f.vision = {enabled:true};
        f.vision.target = target;
      }).then(function(j){
        if(j && (j.staged || j.away)) visionSaid(j, 'Colour learned');
      });
    }

    function setTarget(body, said){
      if(busy) return;
      /* The live POST is refused too, not only the save: sending it would set
         the running detector hunting a colour this config has no use for, and
         the next status poll would then report a hunt nobody asked for. Said
         out loud — a tap that vanishes silently is how a screen teaches
         somebody that it is broken. */
      var no = targetRefusal(null);
      if(no){ ZS.toast(no, {ms:5000}); return; }
      busy = true; paint();
      ZS.api('/vision/target', 'POST', body).then(function(j){
        busy = false;
        if(j && j.ok){
          if(st && j.data && j.data.target){
            st.detect = st.detect || {};
            st.detect.target = j.data.target;
            st.detect.enabled = true;
          }
          rememberTarget(j.data && j.data.target);
          ZS.toast(said);
        } else {
          ZS.toast((j && j.error) || 'The board could not use that');
        }
        paint(); statusSoon();
      })['catch'](function(){
        busy = false; paint();
        ZS.toast('Couldn’t reach your adapter');
      });
    }

    /* START/STOP THE WATCHING — ONE PATH, TWO FACES.
       Play's #cv-toggle and the [data-cvgo] twin startWatchingCard() puts on
       Tune and Advanced are the same control drawn twice; they must never be
       able to disagree, so they share this function and the `busy` guard that
       stops a second tap (on either face) sending a second POST. */
    function toggleWatching(){
      if(busy || !st || !st.available || noStartStop()) return;
      var run = !!st.running;
      busy = true; paint();
      ZS.api('/vision/'+(run ? 'stop' : 'start'), 'POST', {}).then(function(j){
        busy = false;
        if(j && j.ok) ZS.toast(run ? 'Stopped watching your screen'
                                   : 'Watching your screen');
        else ZS.toast((j && j.error) || 'The board could not do that');
        if(run) imgOk = false;
        paint(); statusSoon(); frameSoon(400);
      })['catch'](function(){
        busy = false; paint();
        ZS.toast('Couldn’t reach your adapter');
      });
    }
    if(actEl) actEl.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('#cv-toggle') : null;
      if(b) toggleWatching();
    });
    /* the old [data-cvgo] button twins were replaced by the [data-cvplay]
       status chip (screen-map §6 — Start-watching has ONE home): a chip tap
       jumps the pager to Play by clicking the tab the way a finger would,
       and the button there is the only thing that ever POSTs. Delegated
       from the screen root because the chip lives in poll-painted slots. */
    /* `root` is #dbody, which every screen shares and nothing ever replaces:
       a listener put on it stays until it is taken off. These two were put on
       at every visit and never taken off, so each visit's pair (and the whole
       screen they close over) lived for the rest of the session and ran on
       every tap on every screen after it (the stress run's soak, 2026-10-02:
       +2 listeners and a screen's worth of heap per visit). One pair at a
       time now (cvRootKeys), taken off by stopAll() when the screen is gone. */
    function onPlayChip(e){
      var b = e.target && e.target.closest ? e.target.closest('[data-cvplay]') : null;
      if(!b) return;
      var tab = root.querySelector('#cvtabs button[data-pg="Play"]');
      if(tab) tab.click();
    }
    function onPlayKey(e){
      if(e.key!=='Enter' && e.key!==' ') return;
      var b = e.target && e.target.closest ? e.target.closest('[data-cvplay]') : null;
      if(!b) return;
      e.preventDefault(); b.click();
    }
    dropRootKeys();
    cvRootKeys = { root: root, click: onPlayChip, key: onPlayKey };
    root.addEventListener('click', onPlayChip);
    root.addEventListener('keydown', onPlayKey);

    /* The picture's switches. Delegated, because picHtml() re-draws them on
       every poll — the same reason the mode bar is delegated. */
    /* "Keep these frames" (POST /vision/snapshot) moved to Global Settings
       > Developer with D223: sections/22-global.js. */

    function wirePicSlot(el){
      if(!el) return;
      el.addEventListener('click', function(e){
        var t = e.target;
        if(!t || !t.closest) return;
        var sz = t.closest('[data-cvpw]');
        if(sz){ setPicWidth(parseInt(sz.getAttribute('data-cvpw'), 10)); return; }
        /* the row and the switch inside it carry the same attribute, so a tap
           anywhere along the row counts */
        var row = t.closest('[data-cvpic]');
        if(!row) return;
        var which = row.getAttribute('data-cvpic');
        if(which === 'show') setPicEnabled(picOff());
        else if(which === 'grey') setPicGrey(!pic.grey);
      });
      /* The switches take focus, so they have to take a key too — wire()
         runs once, before this screen exists, so it never sees them. The
         size choices are real <button>s and already answer Enter and Space
         by themselves; adding them here would fire each choice twice. */
      el.addEventListener('keydown', function(e){
        var k = e.key;
        if(k !== 'Enter' && k !== ' ' && k !== 'Spacebar') return;
        var sw2 = e.target;
        if(!sw2 || !sw2.classList || !sw2.classList.contains('sw')) return;
        e.preventDefault();
        sw2.click();          /* one path for finger and keyboard */
      });
    }
    wirePicSlot(picEl);

    /* The game-profile button — and the Tune hint's twin, which lives in the
       poll-painted #cv-cal slot, so both are delegated by the same
       data-cvprof attribute. */
    function onProfTap(e){
      var b = e.target && e.target.closest ? e.target.closest('[data-cvprof]') : null;
      if(b) openProfSheet();
    }
    if(profEl) profEl.addEventListener('click', onProfTap);
    if(calEl) calEl.addEventListener('click', onProfTap);

    if(modeEl) modeEl.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('[data-cvm]') : null;
      if(!b) return;
      mode = b.getAttribute('data-cvm');
      if(mode !== 'box'){ sel = -1; armTeach = -1; }
      paint();
    });

    if(listEl) listEl.addEventListener('click', function(e){
      var t = e.target && e.target.closest ? e.target.closest('#cv-addbox,[data-cvedit],[data-cvrow]') : null;
      if(!t) return;
      if(t.id === 'cv-addbox'){
        if(regs.length >= CV_MAX_REGIONS){
          ZS.toast('That is as many boxes as your adapter will take'); return;
        }
        mode = 'box';
        /* A first box has to exist before it can be dragged — dropping the
           user straight into "now draw one" with nothing on screen is the
           step people get stuck on. So make one in the middle and let them
           move it, which is the same gesture either way. */
        addRegion(cvRect([0.36, 0.36, 0.28, 0.24]));
        return;
      }
      var idx = t.hasAttribute('data-cvedit') ? +t.getAttribute('data-cvedit')
                                              : +t.getAttribute('data-cvrow');
      if(idx >= 0 && regs[idx]) openRegionSheet(idx);
    });

    if(calEl) calEl.addEventListener('click', function(e){
      var el = e.target && e.target.closest ? e.target.closest('[data-cvr],[data-cvp]') : null;
      if(!el) return;
      if(el.getAttribute('data-cvr')){
        setTarget({radius: parseInt(el.getAttribute('data-cvr'), 10)}, 'Colour match changed');
      } else {
        setTarget({preset: el.getAttribute('data-cvp')}, 'Now looking for that colour');
      }
    });

    /* Typed colour — DF00FF, #DF00FF and 0xDF00FF all mean the same thing,
       because those are the three ways games and configs write it.

       This belongs HERE, next to the other #cv-cal delegates, and putting it
       anywhere else is what broke it: the handler used to live in R.vision,
       a different function with a different `root`, so its
       root.querySelector('#cv-hexgo') found nothing — #cv-hex is rendered by
       calHtml(), which only this scope owns. The `if(hexGo)` guard turned that
       miss into silence, so the field accepted typing and the button did
       nothing at all: no request, no error, no toast. Delegation also survives
       calHtml() being re-run on every poll, which a direct binding would not.

       The colour that comes BACK is the one to trust, not the one typed: the
       detector matches on U/V chroma only, so status() reports the swatch that
       actually round-tripped. */
    if(calEl) calEl.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('#cv-hexgo') : null;
      if(b) useTypedHex();
    });
    if(calEl) calEl.addEventListener('keydown', function(e){
      if(e.key !== 'Enter') return;
      var f = e.target && e.target.closest ? e.target.closest('#cv-hex') : null;
      if(!f) return;
      e.preventDefault();                 /* don't submit anything enclosing */
      useTypedHex();
    });
    /* The typed-colour accordion's header. Delegated for the same reason the
       hex button is (this slot repaints; wire() ran before it existed), and
       it does TWO things beyond toggling the class: it keeps hexOpen in step
       so the next calHtml() renders the state the user chose, and it refreshes
       put()'s cache for this slot so the very next poll does not see "html
       changed" and rebuild the node out from under a finger typing a code. */
    function hexAccToggle(ah){
      var accEl = ah.parentElement;
      hexOpen = !accEl.classList.contains('open');
      accEl.classList.toggle('open', hexOpen);
      ah.setAttribute('aria-expanded', hexOpen ? 'true' : 'false');
      lastHtml['cal'] = calHtml();
    }
    if(calEl) calEl.addEventListener('click', function(e){
      var ah = e.target && e.target.closest ? e.target.closest('#cv-hexacc > .ah') : null;
      if(ah) hexAccToggle(ah);
    });
    if(calEl) calEl.addEventListener('keydown', function(e){
      if(e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
      var ah = e.target && e.target.closest ? e.target.closest('#cv-hexacc > .ah') : null;
      if(!ah) return;
      e.preventDefault();
      hexAccToggle(ah);
    });
    /* THE "WHY IT DID THAT" DRAWER, the same idiom for the same reason: it
       lives inside #cv-shotstat, which put() repaints every 320 ms, so
       wire()'s accordion pass ran long before it existed and a class toggled
       on the node would be gone on the next poll. Keeping whyOpen in step is
       what makes the state survive; refreshing put()'s cache for the slot is
       what stops that very next poll rebuilding the node under the finger. */
    function whyAccToggle(ah){
      var accEl = ah.parentElement;
      whyOpen = !accEl.classList.contains('open');
      accEl.classList.toggle('open', whyOpen);
      ah.setAttribute('aria-expanded', whyOpen ? 'true' : 'false');
      lastHtml['shotstat'] = shotStatHtml();
    }
    if(shotStatEl) shotStatEl.addEventListener('click', function(e){
      var ah = e.target && e.target.closest ? e.target.closest('#cv-shotwhy > .ah') : null;
      if(ah) whyAccToggle(ah);
    });
    if(shotStatEl) shotStatEl.addEventListener('keydown', function(e){
      if(e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
      var ah = e.target && e.target.closest ? e.target.closest('#cv-shotwhy > .ah') : null;
      if(!ah) return;
      e.preventDefault();
      whyAccToggle(ah);
    });
    function useTypedHex(){
      var hexIn = calEl && calEl.querySelector('#cv-hex');
      if(!hexIn) return;
      var raw = String(hexIn.value || '').trim()
                  .replace(/^0[xX]/, '').replace(/^#/, '');
      if(!/^[0-9a-fA-F]{6}$/.test(raw)){
        ZS.toast('That is not a colour code — six letters or numbers, like DF00FF');
        return;
      }
      setTarget({color: raw.toUpperCase()}, 'Now looking for that colour');
    }

    /* ── THE GAME-PROFILE SHEET — the pack door ─────────────────────────
       Everything pack-shaped lives behind the profile button now: the
       Blank pseudo-pack, the shelf, the save door, and System B's
       link-install manager. The sheet is PULL-BUILT on open and repainted
       only by pkPaint(), so the status poll and the ~8s refresh can never
       reset it — the same guarantee the region sheet already relies on.

       This machinery used to live in R.vision's after(); it moved HERE
       because the profile button is painted and delegated by this scope,
       and the two-tap plumbing (data-pkuse / data-pkdel), the board-answer
       shelf, and the save-over-a-name arm all carry over verbatim. State
       survives across sheet opens in this closure; the board's list is
       re-asked on every open because the board is the truth. */
    var pkBody   = null;   /* the sheet body the door was last bound to */
    var pkBlankEl= null;
    var pkList   = null;
    var pkErrEl  = null;
    var pkNameEl = null;
    var pkSaveEl = null;
    var pkAll    = null;   /* the board's list, or null until it answers */
    var pkWhy    = '';     /* ...and why, when there will not be one */
    var pkBusy   = false;  /* a pack/Blank call is in flight */
    var pkReplace = '';    /* one tap away from writing over this pack */
    var pkDelArm  = '';    /* ...and one tap away from deleting this one */
    var pending  = null;   /* a fetched-but-not-installed System B manifest */

    /* Two liveness questions, kept apart on purpose. The screen outliving
       the sheet is the NORMAL case (apply closes the sheet, then re-renders
       the screen), so callbacks that finish an apply check only the screen;
       callbacks that would paint INTO the sheet check the door too. */
    function pkScreenAlive(){
      var d = document.getElementById('dbody');
      return !!(d && d.dataset.ns === myNs);
    }
    function pkDoorAlive(){
      return pkScreenAlive() &&
        !!(pkBody && pkList && pkBody.contains && pkBody.contains(pkList));
    }
    function pkSay(html, kind){
      if(pkErrEl) pkErrEl.innerHTML = html ? note(html, kind || '') : '';
    }
    /* A number, or the default. The `null` guard is load-bearing: a config
       written by an older board carries `"marker": null, "offsetYFrac":
       null`, and Number(null) is 0 — so without it a missing colour width
       would be saved as a tolerance of ZERO, which matches almost nothing. */
    function pkNum(n, dflt){
      if(n === null || n === undefined || n === '') return dflt;
      n = Number(n);
      return (n === n && n !== Infinity && n !== -Infinity) ? n : dflt;
    }
    function pkOffline(){
      return ZS.live.online === false || !ZS.live.full[p.id];
    }
    /* ── the config's locked game vs a pack's own game ──────────────────
       COSMETIC, normalised, and shown-but-warned only: never hidden, never
       blocked (game-lock spec §6). Pack `game` strings come from
       heterogeneous sources, so exact-match filtering would imprison
       tinkerers on false negatives — and applying a pack never changes the
       config's identity anyway; packs are revertible tuning. */
    function profGameNow(){
      return String((ZS.live.full[p.id] && ZS.live.full[p.id].game) || p.game || '');
    }
    function gameMismatchLine(pkGame){
      var mine = profGameNow(), theirs = String(pkGame || '');
      if(!mine || !theirs || normGame(mine) === normGame(theirs)) return '';
      return '<div style="color:var(--muted);font-size:12px;line-height:1.55;'+
        'margin-top:6px">Made for <b>'+esc(theirs)+'</b> — this config is locked to <b>'+
        esc(mine)+'</b>. You can still use it; it just may not match what’s on '+
        'screen.</div>';
    }

    /* The search box lives in the config's regions as the one rectangle
       marked purpose:"hunt" — the last one wins, exactly as the board's
       detect.hunt_rect_from_regions decides it. */
    function pkHuntBox(vis){
      var list = (vis && Array.isArray(vis.regions)) ? vis.regions : [];
      var box = null, i, r;
      for(i=0;i<list.length;i++){
        r = list[i];
        if(!r || typeof r !== 'object') continue;
        if(String(r.purpose || '').toLowerCase() !== 'hunt') continue;
        if(!Array.isArray(r.rect) || r.rect.length !== 4) continue;
        box = [pkNum(r.rect[0], 0), pkNum(r.rect[1], 0),
               pkNum(r.rect[2], 0), pkNum(r.rect[3], 0)];
      }
      return box;
    }
    function pkBuild(name, id){
      var vis = cvVis();
      var t = (vis.target && typeof vis.target === 'object') ? vis.target : {};
      var f = (vis.filters && typeof vis.filters === 'object') ? vis.filters : {};
      var m = (vis.model && typeof vis.model === 'object') ? vis.model : {};
      var pack = {
        name: name,
        fusion: vis.fusion || 'either',
        mergeRadius: pkNum(vis.mergeRadius, 0.06),
        /* THE COLOUR AS THE ADAPTER REALLY HOLDS IT. A colour tapped on
           the picture is stored as raw chroma (u, v) — that is what the
           detector matches on — and this config on this board is exactly
           that shape: no `color`, an empty `preset`, and a `swatch` that is
           only a picture of it. Reading `color` alone would have saved a
           pack with no colour at all, and the board would have answered
           "this pack has neither a colour nor a model enabled". */
        colour: {
          enabled: !!(t.color || t.preset ||
                      (typeof t.u === 'number' && typeof t.v === 'number')),
          target: t.color || t.swatch || '',
          preset: t.preset || '',
          tolerance: pkNum(t.radius, 45),
          minLuma: pkNum(t.minLuma, 40),
          maxLuma: pkNum(t.maxLuma, 250),
          marker: vis.marker || 'outline',
          offsetX: pkNum(vis.offsetX, 0),
          offsetY: pkNum(vis.offsetY, 0),
          offsetXFrac: pkNum(vis.offsetXFrac, 0),
          offsetYFrac: pkNum(vis.offsetYFrac, 0)
        },
        /* THE SIX THAT DECIDE WHETHER THE COLOUR IS EVER CALLED A TARGET,
           and the reason this card exists rather than a rename of the old
           one. Measured on this adapter: with the stock 3.5 and 0.0002 it
           found a target in 0% of frames and threw away 10 blobs out of
           12; with 40 and 0.00002 it found one in 19 frames out of 22. A
           pack that saves the colour and not these saves the half that was
           never the problem. */
        filters: {
          minAreaFrac: pkNum(f.minAreaFrac, 0.0002),
          maxAreaFrac: pkNum(f.maxAreaFrac, 0.25),
          minFill: pkNum(f.minFill, 0.10),
          minAspect: pkNum(f.minAspect, 0.12),
          maxAspect: pkNum(f.maxAspect, 3.5),
          textGap: pkNum(f.textGap, 0)
        },
        model: {
          enabled: !!m.enabled,
          name: m.name || '', path: m.path || '',
          runtime: m.runtime || 'auto',
          inputW: pkNum(m.inputW, 320), inputH: pkNum(m.inputH, 320),
          cropFrac: pkNum(m.cropFrac, 0.35),
          scoreThreshold: pkNum(m.scoreThreshold, 0.35),
          nmsIou: pkNum(m.nmsIou, 0.45),
          aimFrac: pkNum(m.aimFrac, 0.32),
          headFrac: pkNum(m.headFrac, 0.12),
          aimAt: m.aimAt === 'head' ? 'head' : 'body'
        }
      };
      if(typeof t.u === 'number' && typeof t.v === 'number'){
        pack.colour.u = t.u;
        pack.colour.v = t.v;
      }
      if(Array.isArray(m.classIds)) pack.model.classIds = m.classIds;
      if(Array.isArray(m.labels)) pack.model.labels = m.labels;
      var box = pkHuntBox(vis);
      if(box) pack.box = box;
      if(id) pack.id = id;      /* replacing, so keep the board's own id */
      return pack;
    }
    /* What a saved pack does, in sentences. Numbers where a number is the
       only honest answer, words everywhere else. */
    function pkWords(pk){
      var c = pk.colour || {}, f = pk.filters, box = pk.box, out = [];
      var mk = esc(c.marker || 'mark'), oy;
      if(c.enabled){
        out.push('<span style="display:inline-block;width:12px;height:12px;'+
          'border-radius:4px;vertical-align:-1px;margin-right:6px;'+
          'border:1px solid rgba(255,255,255,.25);background:#'+
          cvHex(c.target)+'"></span>Looks for this colour on the '+mk);
        oy = Number(c.offsetY) || 0;
        if(oy > 0) out.push('Aims '+cvNum(oy, 1)+' '+mk+' heights below it');
      }
      if(pk.model && pk.model.enabled){
        out.push('Also runs the trained model '+esc(pk.model.name || 'it names'));
      }
      if(f){
        out.push('Counts something as a target when it is at most <b>'+
          cvNum(f.maxAspect, 1)+'×</b> wider than it is tall and covers at '+
          'least <b>'+cvNum((Number(f.minAreaFrac) || 0) * 100, 4)+'%</b> of the screen');
        if((Number(f.textGap) || 0) > 0){
          out.push('Joins letters up, so a name reads as one mark');
        }
      } else {
        out.push('This pack was saved before shape rules were kept, so using '+
                 'it leaves this config’s own rules exactly as they are');
      }
      if(box && box.length === 4){
        out.push('Searches only a box '+
          cvWhere(box[0] + box[2] / 2, box[1] + box[3] / 2)+
          ', about '+cvNum(box[2] * box[3] * 100, 0)+'% of the screen');
      }
      if(pk.requires) out.push('Needs in game: <b>'+esc(pk.requires)+'</b>');
      return out;
    }
    /* Blank, first in the sheet — a built-in pseudo-pack the app applies.
       It NEVER deletes or overwrites a saved pack, and never touches the
       boxes or the assist feel; the copy says so, and says out loud that
       Start/Stop — not Blank — owns whether the adapter watches at all. */
    function blankRowHtml(){
      var vis = cvVis(), tools = cvToolsOf(vis);
      /* an installed-but-untaught colour pack is NOT Blank — Blank is still
         offered on it (it clears the pack's tools), it just is not "in use now" */
      var blank = !tools.colour && !tools.colourPending && !tools.model;
      var h = '<div class="vizbox" style="padding:12px 14px;text-align:left">'+
        '<b style="font-size:14px">Blank'+(blank
          ? ' <span style="font-weight:600;font-size:11.5px;color:var(--green)">'+
            '— in use now</span>' : '')+'</b>'+
        '<div style="color:var(--muted);font-size:12px;line-height:1.55;margin-top:5px">'+
          'No pack in use. Turns the colour hunt and the trained model off '+
          'for this config. Your boxes, your aim feel and your saved packs '+
          'are not touched — and Start/Stop still controls the watching '+
          'itself.</div>'+
        '<button class="btn" data-pkblank="1" style="margin-top:10px"'+
          ((pkBusy || blank) ? ' disabled' : '')+'>Use Blank</button>'+
        '</div>';
      var stash = (vis.blankStash && typeof vis.blankStash === 'object')
        ? vis.blankStash : null;
      if(blank && stash && (stash.target || stash.modelEnabled)){
        h += '<div class="vizbox" style="padding:12px 14px;text-align:left;margin-top:8px">'+
          '<b style="font-size:14px">What Blank replaced</b>'+
          '<div style="color:var(--muted);font-size:12px;line-height:1.55;margin-top:5px">'+
            'The tuning this config carried before Blank — put it back in '+
            'one tap.</div>'+
          '<button class="btn" data-pkunblank="1" style="margin-top:10px"'+
            (pkBusy ? ' disabled' : '')+'>Put it back</button></div>';
      }
      return h;
    }
    function pkPaint(){
      if(pkBlankEl) pkBlankEl.innerHTML = blankRowHtml();
      if(!pkList) return;
      if(pkAll === null){
        /* the scanning reticle is the section's loading mark — words too,
           never motion alone; the warn case is not a wait, so no reticle */
        pkList.innerHTML = note(pkWhy ||
          ((window.ZSLOGO && ZSLOGO.reticle
            ? '<span style="display:inline-block;vertical-align:-4px;margin-right:7px">'+
              ZSLOGO.reticle({size:18, state:'scanning', label:'asking your adapter'})+'</span>'
            : '')+
           'Asking your adapter which game packs you have saved…'),
          pkWhy ? 'warn' : '');
        return;
      }
      if(!pkAll.length){
        pkList.innerHTML = note('<b>No game packs yet.</b> Get one game working, then type a name '+
          'below and tap <b>Save</b>.');
        return;
      }
      /* WHICH ONE IS IN USE. The only thing that is knowable is which pack
         was last put ON this config: the board writes its id into the
         config when it applies one. It is NOT a promise that the settings
         still match — tap a new colour on the picture and they do not — so
         the label says what actually happened and no more. */
      var applied = String(cvVis().packId || '');
      var html = '', i, pk, mark, chips;
      for(i=0;i<pkAll.length;i++){
        pk = pkAll[i];
        mark = (pk.id && pk.id === applied)
          ? '<span style="font-weight:600;font-size:11.5px;color:var(--green)">'+
            ' — last put on this config</span>' : '';
        /* which tools the pack carries, as words — the same chips the
           profile button wears, from fields the list already carries */
        chips = [];
        if(pk.colour && pk.colour.enabled) chips.push('colour');
        if(pk.model && pk.model.enabled) chips.push('model');
        html += '<div class="vizbox" style="padding:11px 12px;text-align:left;margin-top:8px">'+
          '<b style="display:block;font-size:14px">'+esc(pk.name || pk.id)+
            profChips(chips)+mark+'</b>'+
          '<div style="color:var(--muted);font-size:12px;line-height:1.55;margin-top:5px">'+
            pkWords(pk).join('<br>')+'</div>'+
          gameMismatchLine(pk.game)+
          '<div style="display:flex;gap:8px;margin-top:10px">'+
            '<button class="btn" data-pkuse="'+esc(pk.id)+'" style="width:auto;flex:1 1 auto"'+
              (pkBusy ? ' disabled' : '')+'>Use these settings</button>'+
            '<button class="btn danger" '+
              'data-pkdel="'+esc(pk.id)+'" style="width:auto;flex:0 0 auto"'+
              (pkBusy ? ' disabled' : '')+'>'+
              (pkDelArm === pk.id ? 'Tap again to delete' : 'Delete')+'</button>'+
          '</div></div>';
      }
      pkList.innerHTML = html;
    }
    function pkLoad(){
      /* nothing to ask a Core for (m47): an empty shelf, no request */
      if(noBoardPacks()){ pkAll = []; pkWhy = ''; pkPaint(); return; }
      if(pkOffline()){
        pkAll = null;
        pkWhy = 'Your adapter keeps this list. Reconnect to see and use your '+
                'saved packs — nothing can be saved or used while it is away.';
        pkPaint();
        return;
      }
      ZS.api('/vision/packs').then(function(j){
        if(!pkScreenAlive()) return;
        if(!j || j.ok === false || !Array.isArray(j.data)){
          pkAll = null;
          pkWhy = 'Your adapter did not send a list of game packs'+
            ((j && j.error) ? ': '+esc(String(j.error)) : '')+'. Nothing was changed.';
        } else {
          pkAll = j.data;
          pkWhy = '';
        }
        if(pkDoorAlive()) pkPaint();
        /* the profile button may have been waiting on this list for a
           pack's name — one cache-guarded repaint, not churn */
        paint();
      });
    }
    function pkByName(name){
      var i, want = String(name).toLowerCase(), list = pkAll || [];
      for(i=0;i<list.length;i++){
        if(String(list[i].name || '').toLowerCase() === want) return list[i];
      }
      return null;
    }
    function pkById(id){
      var i, list = pkAll || [];
      for(i=0;i<list.length;i++) if(list[i].id === id) return list[i];
      return null;
    }
    function pkDisarm(){
      pkReplace = '';
      if(pkSaveEl) pkSaveEl.textContent = 'Save';
    }
    /* Everything the board said about a refusal, in its own words. It
       answers a rejected pack with a generic `error` and the sentences that
       matter in `errors`, so a screen that reads only the first one shows
       "vision pack rejected" and leaves the user with nothing to act on. */
    function pkWhyNot(j){
      var list = (j && Array.isArray(j.errors)) ? j.errors : [];
      if(list.length){
        return list.map(function(s){ return String(s); }).join('; ');
      }
      return String((j && j.error) || 'it did not answer');
    }
    function pkDoSave(){
      if(pkBusy) return;
      var name = String((pkNameEl && pkNameEl.value) || '').replace(/^\s+|\s+$/g, '');
      if(!name){
        pkSay('Type a name for this game pack first — something like '+
              '“BO2 nametags”, so you know which is which later.', 'warn');
        if(pkNameEl) try{ pkNameEl.focus(); }catch(e){}
        return;
      }
      if(pkOffline()){
        pkSay('Game packs are saved on your adapter, and the app is not talking to it '+
              'right now. Nothing was saved.', 'warn');
        return;
      }
      /* Without the list there is no way to know whether this name is
         already taken, and saving anyway would quietly leave two packs
         with the same name on the shelf. */
      if(pkAll === null){
        pkSay('Still asking your adapter which game packs you have — tap '+
              '<b>Save</b> again in a moment.', 'warn');
        pkLoad();
        return;
      }
      /* SAVING OVER A NAME SAYS SO. Same name = same pack to the board (it
         makes the id from the name), so a silent save would replace a pack
         that took a session to get right. */
      var same = pkByName(name);
      if(same && pkReplace !== same.id){
        pkReplace = same.id;
        if(pkSaveEl) pkSaveEl.textContent = 'Replace';
        pkSay('You already have a game pack called “'+esc(same.name)+'”. Tap '+
              '<b>Replace</b> to write over it with what this config is looking for '+
              'now, or type a different name to keep both.', 'warn');
        setTimeout(function(){
          if(pkDoorAlive() && pkReplace === same.id){ pkDisarm(); pkSay(''); }
        }, 8000);
        return;
      }
      pkBusy = true;
      if(pkSaveEl) pkSaveEl.disabled = true;
      pkPaint();
      ZS.api('/vision/packs', 'POST', pkBuild(name, same ? same.id : '')).then(function(j){
        pkBusy = false;
        pkDisarm();
        if(pkSaveEl) pkSaveEl.disabled = false;
        if(!pkDoorAlive()) return;
        if(!j || j.ok === false){
          /* THE BOARD'S OWN WORDS, not a paraphrase — and the useful ones
             are in `errors`, not `error`. A refused pack answers
             {error:"vision pack rejected", errors:["a vision pack needs a
             name", …]}, so showing `error` alone would print the one
             sentence that explains nothing. */
          pkSay('Your adapter would not save that game pack: '+
                esc(pkWhyNot(j))+'. Nothing was lost — the name you typed is '+
                'still there, so you can change it and try again.', 'warn');
          pkPaint();
          return;
        }
        var w = (j.warnings && j.warnings.length)
          ? '<br>Your adapter also said: '+j.warnings.map(function(s){
              return esc(String(s));
            }).join('; ')
          : '';
        pkSay('Saved “'+esc((j.data && j.data.name) || name)+'”. This config was not '+
              'changed — the pack is a copy you can put on any config.'+w, w ? 'warn' : '');
        if(pkNameEl) pkNameEl.value = '';
        pkLoad();
      });
    }
    function pkUse(id){
      if(pkBusy) return;
      var pk = pkById(id);
      if(!pk){
        pkSay('That game pack is not on your adapter any more.', 'warn');
        pkLoad();
        return;
      }
      if(pkOffline()){
        pkSay('The app is not talking to your adapter right now, so nothing was '+
              'changed.', 'warn');
        return;
      }
      pkBusy = true;
      pkPaint();
      pkSay('Putting “'+esc(pk.name || id)+'” on this config…');
      /* Land any debounced slider edit of THIS config first. The board is
         about to write the same document, and a queued write still holding
         a pre-apply copy would put the old numbers straight back — measured
         happening to a calibration pack on this board. */
      ZS.flushProfileWrites(p.id).then(function(){
        return ZS.api('/vision/packs/'+encodeURIComponent(id)+'/apply', 'POST',
                      {profileId: p.id});
      }).then(function(j){
        pkBusy = false;
        if(!pkScreenAlive()) return;
        if(!j || j.ok === false){
          if(pkDoorAlive()){
            pkSay('Your adapter would not use that game pack: '+
                  esc(pkWhyNot(j))+'. Nothing was changed.', 'warn');
            pkPaint();
          }
          return;
        }
        /* Re-read the config: the board has just rewritten it, and every
           screen in this app draws from that cache. */
        ZS.api('/profiles/'+encodeURIComponent(p.id)).then(function(f){
          if(f && f.ok && f.data) ZS.live.full[p.id] = f.data;
          ZS.toast('Now using “'+(pk.name || id)+'”');
          if(!pkScreenAlive()) return;
          /* Close the picker, then redraw the whole screen so the settings
             show the pack's numbers instead of the ones it replaced. */
          ZS.sheetClose();
          ZS.openDetail({id:'vision', lab:'Screen Assist'}, p);
        });
      });
    }
    function pkDrop(id){
      if(pkBusy) return;
      if(pkDelArm !== id){
        pkDelArm = id;
        pkPaint();
        pkSay('That will delete the game pack from your adapter. This config keeps '+
              'the settings it has — deleting a pack never changes a config.', 'warn');
        setTimeout(function(){
          if(pkDoorAlive() && pkDelArm === id){ pkDelArm = ''; pkSay(''); pkPaint(); }
        }, 6000);
        return;
      }
      pkDelArm = '';
      pkBusy = true;
      pkPaint();
      ZS.api('/vision/packs/'+encodeURIComponent(id), 'DELETE').then(function(j){
        pkBusy = false;
        if(!pkDoorAlive()) return;
        if(!j || j.ok === false){
          pkSay('Your adapter would not delete that game pack: '+
                esc(pkWhyNot(j))+'.', 'warn');
          pkPaint();
          return;
        }
        pkSay('Deleted. This config was not changed.');
        pkLoad();
      });
    }

    /* ── Blank: an app-side vision edit, never a board pack ─────────────
       A board-side pack with colour.enabled=false simply OMITS its target,
       and the old colour survives the board's merge — so Blank cannot be
       expressed as a pack. It writes the config directly, through the same
       putProfile/vision channel the packs use (saveVision), and touches
       ONLY the tool flags and identity: never the boxes, never the assist
       feel, never vision.enabled (the Aim-help master switch is FEEL),
       never the saved packs, never System B's installed manifest. */
    function applyBlank(){
      if(pkBusy) return;
      if(pkOffline()){
        pkSay('The app is not talking to your adapter right now, so nothing '+
              'was changed.', 'warn');
        return;
      }
      pkBusy = true;
      pkPaint();
      ZS.flushProfileWrites(p.id).then(function(){       /* same reason as pkUse */
        var vis = JSON.parse(JSON.stringify(cvVis()));
        var stash = {
          target: (vis.target && typeof vis.target === 'object' &&
                   cvToolsOf(vis).colour) ? vis.target : null,
          modelEnabled: !!(vis.model && vis.model.enabled)
        };
        if(vis.model && typeof vis.model === 'object'){
          /* keep name/path/runtime so "put it back" can re-enable it */
          vis.model.enabled = false;
        }
        vis.packId = '';
        vis.packName = '';
        vis.blankStash = stash;
        /* {preset:''} and NOT {} — the board's schema.migrate() deep-fills
           an empty target back to the default {"preset":"red"} (the exact
           trap rememberTarget documents), while an explicit falsy preset
           survives the merge and build_target() accepts it. The whole
           block, not a bare patch, so the offline copy saveVision stores
           stays a complete vision block. */
        vis.target = {preset: ''};
        saveVision(p, vis, function(ok){
          pkBusy = false;
          if(!ok){
            if(pkDoorAlive()){
              pkSay('Your adapter would not take that. Nothing was changed.', 'warn');
              pkPaint();
            }
            return;
          }
          ZS.toast('Blank — no game selected');
          if(!pkScreenAlive()) return;
          ZS.sheetClose();
          ZS.openDetail({id:'vision', lab:'Screen Assist'}, p);
        });
      });
    }
    function applyUnblank(){
      if(pkBusy) return;
      if(pkOffline()){
        pkSay('The app is not talking to your adapter right now, so nothing '+
              'was changed.', 'warn');
        return;
      }
      var cur = cvVis();
      var stash = (cur.blankStash && typeof cur.blankStash === 'object')
        ? cur.blankStash : {};
      if(!stash.target && !stash.modelEnabled) return;
      pkBusy = true;
      pkPaint();
      ZS.flushProfileWrites(p.id).then(function(){
        var vis = JSON.parse(JSON.stringify(cvVis()));
        var st2 = (vis.blankStash && typeof vis.blankStash === 'object')
          ? vis.blankStash : {};
        if(st2.target && typeof st2.target === 'object') vis.target = st2.target;
        if(vis.model && typeof vis.model === 'object'){
          vis.model.enabled = !!st2.modelEnabled;
        }
        vis.blankStash = {};
        saveVision(p, vis, function(ok){
          pkBusy = false;
          if(!ok){
            if(pkDoorAlive()){
              pkSay('Your adapter would not take that. Nothing was changed.', 'warn');
              pkPaint();
            }
            return;
          }
          ZS.toast('Put back what Blank replaced');
          if(!pkScreenAlive()) return;
          ZS.sheetClose();
          ZS.openDetail({id:'vision', lab:'Screen Assist'}, p);
        });
      });
    }

    /* ── System B: the link-install manager, verbatim from after() ────── */
    function showReview(m, src){
      pending = { manifest:m, source:src };
      var caps = (m.capabilities||[]).map(function(c){
        var L = CAP_LABEL[c]||[c,''];
        return '<div class="stat"><span>'+esc(L[0])+
          (L[1]?'<em style="display:block;color:var(--muted);font-size:11px;font-style:normal">'+esc(L[1])+'</em>':'')+
          '</span><b class="ok">✓</b></div>';
      }).join('') || '<div class="stat"><span>No special abilities declared</span><b>—</b></div>';
      var host=''; try{ host = new URL(src.url).hostname; }catch(e){ host = src.url; }
      var rev = document.getElementById('cv-review');
      if(!rev) return;
      rev.innerHTML =
