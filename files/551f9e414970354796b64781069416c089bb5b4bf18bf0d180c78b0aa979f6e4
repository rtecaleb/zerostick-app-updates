              installed:true, bytes:j.payload.bytes, sha256:j.payload.sha256,
              fetchedAt:j.payload.fetchedAt });
            saveVision(p, next, function(){
              ZS.toast('File downloaded and checked ('+bytesLabel(j.payload.bytes)+')');
              ZS.sheetClose();
              ZS.openDetail({id:'vision', lab:'Screen Assist'}, p);
            });
          })
          .catch(function(){ pay.disabled=false; pay.textContent='Download the pack’s file'; ZS.toast('That download failed'); });
      });
      var upd = body.querySelector('#cv-update');
      if(upd && vv.source && vv.source.url) upd.addEventListener('click', function(){
        upd.disabled=true; upd.textContent='Checking…';
