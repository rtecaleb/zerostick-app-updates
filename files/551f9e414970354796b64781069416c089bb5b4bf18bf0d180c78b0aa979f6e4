       on/off state and cannot fight a change made somewhere else. */
    /* `undo` puts the local echo back when the board will not take the change.
       It is passed for the settings the app cannot honour on its own — black
       and white is made ON the adapter, so a refused change means it did not
       happen and the switch must not sit there claiming it did. It is NOT
       passed for the on/off switch (this app really has stopped asking) or
       for the size (the width in the frame request decides it either way). */
    function setPreview(body, said, undo){
      if(picBusy) return;
      picBusy = true;
      paint();
      ZS.api('/vision/preview', 'POST', body).then(function(j){
        picBusy = false;
        if(j && j.ok){
          picOld = false; picSaid = '';
          var q = (j.data && (j.data.preview || j.data)) || null;
          if(q && typeof q === 'object'){
            if(typeof q.enabled === 'boolean') pic.enabled = q.enabled;
            if(typeof q.width === 'number' && q.width > 0) pic.width = Math.round(q.width);
            if(typeof q.grey === 'boolean') pic.grey = q.grey;
          }
          if(picOff()) dropPicture(); else resumeFrames();
          if(said) ZS.toast(said);
        } else {
          if(undo) undo();
          var err = String((j && j.error) || '');
          /* An adapter old enough not to have this route cannot be made to
             stop encoding. Say exactly that — the app has still stopped
             asking, which is real but is not the whole saving. */
          if(/unknown route|not found|no such|no vision support/i.test(err)){
            picOld = true; picSaid = err;
            ZS.toast('Your adapter did not understand that — read the note under '+
                     'the switch', {ms:6000});
          } else {
            ZS.toast(err || 'Your adapter could not do that');
          }
        }
        paint(); statusSoon();
      })['catch'](function(){
        picBusy = false;
        if(undo) undo();
        ZS.toast('Couldn’t reach your adapter — this app has stopped asking for '+
                 'pictures either way', {ms:6000});
        paint();
      });
    }

    function setPicEnabled(on){
      if(picBusy) return;
      /* Local first, and deliberately: the poller must stop on the tap, not
         when the board gets round to answering. status() corrects this if the
         board disagrees. */
      pic.enabled = !!on;
      if(on) resumeFrames(); else dropPicture();
      paint();
      setPreview({enabled: !!on},
                 on ? 'Picture on'
                    : 'Picture off — the adapter puts that work into the aim assist');
    }
    function setPicWidth(w){
      if(picBusy || !(w > 0) || w === pic.width) return;
      pic.width = w;
      paint();
      setPreview({width: w}, 'Picture size changed');
    }
    function setPicGrey(g){
      if(picBusy) return;
      var was = !!pic.grey;
      pic.grey = !!g;
      paint();
      setPreview({grey: !!g}, g ? 'Black and white — cheaper to make'
                                : 'Colour picture',
                 function(){ pic.grey = was; });
