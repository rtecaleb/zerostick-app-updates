        check.disabled = true; check.textContent = 'Checking the link…';
        fetch('/api/cv/manifest?url='+encodeURIComponent(url))
          .then(function(r){ return r.json(); })
          .then(function(j){
            check.disabled=false; check.textContent='Check this link';
            if(!j.ok){ ZS.toast(j.error||'That link didn’t work'); return; }
            showReview(j.manifest, j.source);
          })
          .catch(function(){
            check.disabled=false; check.textContent='Check this link';
            ZS.toast('Couldn’t check that link');
          });
      });
      var vv = cvVis();
      var pay = body.querySelector('#cv-payload');
      if(pay && vv.payload && vv.payload.url) pay.addEventListener('click', function(){
        pay.disabled=true; pay.textContent='Downloading…';
        fetch('/api/cv/payload?url='+encodeURIComponent(vv.payload.url))
          .then(function(r){ return r.json(); })
          .then(function(j){
            pay.disabled=false; pay.textContent='Download the pack’s file';
            if(!j.ok){ ZS.toast(j.error||'That download failed'); return; }
            /* if the pack said what the file should be, make sure it matches */
            if(vv.payload.sha256 && j.payload.sha256 !== vv.payload.sha256){
              ZS.toast('That file doesn’t match what the pack described — not installed');
