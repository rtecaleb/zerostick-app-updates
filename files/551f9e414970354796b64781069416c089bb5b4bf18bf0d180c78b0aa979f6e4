    function installPending(){
      if(!pending) return;
      var m = pending.manifest, src = pending.source;
      function ownObj(o){
        return (o && typeof o === 'object' && !Array.isArray(o))
          ? JSON.parse(JSON.stringify(o)) : null;
      }
      var vis = {
        enabled: true,
        name: m.name || 'Vision pack',
        publisher: m.publisher || '',
        game: m.game || '',
        version: m.version || '',
        capabilities: Array.isArray(m.capabilities)? m.capabilities : [],
        capture: m.capture || {width:1280, height:720, fps:60},
        tracking: m.tracking || {mode:'off'},
        /* no `regions` here: they are JOINED with the owner's boxes on the
           board's own copy, in saveVision's `after` below (M20) */
        assist: m.assist || {strength:0.35, activation:'ads'},
        payload: m.payload ? {url:m.payload.url, sha256:m.payload.sha256||'',
                              bytes:m.payload.bytes||0, kind:m.payload.kind||'model',
                              installed:false} : null,
        source: {url: src.url, sha256: src.sha256, bytes: src.bytes, fetchedAt: src.fetchedAt}
      };
      /* The rest of what a real pack ships. These were silently DROPPED for
         months — the manifest validated, the board's schema would have stored
         them, and this allowlist threw them away, so nothing the pack said
         about its colour, its rejects, its model or its shot assist ever
         reached the profile. Copied only when the manifest carries them, so a
         pack that says nothing cannot clear what a hand taught (saveVision
         merges by key). `target` in particular is load-bearing: the 2K pack
         ships {preset:""} EXPLICITLY, because migrate()'s deep-fill would
         otherwise leave the board hunting the default red on a basketball
         court. */
      var tgt = ownObj(m.target);   if(tgt) vis.target = tgt;
      var rej = ownObj(m.reject);   if(rej) vis.reject = rej;
      var mdl = ownObj(m.model);    if(mdl) vis.model = mdl;
      /* THE SHAPE RULES — the same omission as `target`, one screen further
         in. A colour pack is two halves: what colour, and what shape counts
         as a target. `target` was rescued above; `filters` was not, so every
         number a pack said about how small, how square and how solid its
         marker is — and whether the crosshair rule applies at all — landed in
         the manifest, validated, and was thrown away here. For a marker that
         is a small dot that is the WHOLE pack: the stock floor (minAreaFrac
         0.0002) rejects a 12 px dot as sensor noise and the stock crosshair
         rule (0.03 / 0.004) rejects it as the reticle, so a colour pack for a
         dot installed cleanly and then found nothing, with no way to see why.

         MERGED KEY BY KEY, not replaced — the same rule the board already
         applies to its own packs (vision/packs.merge_vision: "`filters` and
         `model` are merged KEY BY KEY, so a pack's shape rules land without
         wiping aimX, aimY, crosshairRadius or the user's `exclude` list").
         saveVision merges only by TOP-LEVEL key, so assigning the pack's
         block here replaced the whole thing — and `exclude` is the one entry
         in it that is not a pack author's number at all. It is where the
         areas the OWNER told his adapter to skip end up, and installing a
         pack silently threw them away. The two install paths now agree. */
      var flt = ownObj(m.filters);
      if(flt){
        var curF = cvVis().filters;
        curF = (curF && typeof curF === 'object' && !Array.isArray(curF))
                 ? curF : {};
        var merged = {}, fk;
        for(fk in curF) if(Object.prototype.hasOwnProperty.call(curF, fk)){
          merged[fk] = curF[fk];
        }
        for(fk in flt) if(Object.prototype.hasOwnProperty.call(flt, fk)){
          merged[fk] = flt[fk];
        }
        /* ...and `exclude` is a UNION rather than an override, because both
           lists mean the same conservative thing — "do not look here". The
           pack knows the game's HUD; the owner knows his own capture. The
           board caps the list at 16, so this does too, pack first. */
        merged.exclude = cvMergeExclude(flt.exclude, curF.exclude);
        vis.filters = merged;
      }
      /* Installing a pack IS un-blanking: Blank's stash must not outlive it,
         or the next config would still read as "Blank is standing over this"
         (cvBlankStanding) and the pack's own colour tool would go unseen. */
      vis.blankStash = {};
      /* How the two detectors are combined, how close counts as one player,
         and where to aim relative to what was found. All four offsets are
         copied whenever the manifest names them — including a 0 — because
         they are the one part of a pack that STACKS with a control the user
         has already moved: the Aim point buttons write vision.offsetY, and a
         pack that could not say "no marker offset, I aim with assist.aimY"
         would silently inherit whatever the last pack's aim point was. */
      if(typeof m.fusion === 'string' && m.fusion) vis.fusion = m.fusion;
      if(typeof m.mergeRadius === 'number') vis.mergeRadius = m.mergeRadius;
      ['offsetX','offsetY','offsetXFrac','offsetYFrac'].forEach(function(k){
        if(typeof m[k] === 'number') vis[k] = m[k];
      });
      if(typeof m.requires === 'string' && m.requires) vis.requires = m.requires;
      var sa = ownObj(m.shotAssist);
      if(sa){
        /* THE INSTALLER IS THE SAFETY GATE, not the shipped JSON. The board's
           schema deliberately accepts a shotAssist with enabled:true and a
           pack-supplied zone (unknown-key tolerance is what lets a newer
           pack install on an older board), so a hostile manifest could
           otherwise arrive armed and taught and clear a button 456 ms into a
           hold. Forcing these two on the way in makes "a pack arrives OFF
           and UNTAUGHT" a property of every install, not a courtesy of one
           file. The user turns it on themselves, and teaches the meter on
           their OWN capture — nothing about a 2K meter's position, size or
           colour is the same for two people anyway. */
        sa.enabled = false;
        sa.meter = (sa.meter && typeof sa.meter === 'object' &&
                    !Array.isArray(sa.meter)) ? sa.meter : {};
        sa.meter.zone = {};
        /* ...and the bar colour, for the same reason plus one: a
           pack-supplied `bar` raises the ceiling on `meter.rect` from 15% of
           the screen to 40%, so leaving it through would let a manifest carry
           a search box onto a board that has been taught nothing. Both
           colours are the user's to teach, on their own capture. */
        sa.meter.bar = {};
        vis.shotAssist = sa;
      }
      /* The pack's boxes join the owner's (cvMergeRegions) on the copy the
         write is built on, and only when the manifest names any: a pack that
         says nothing about boxes leaves them all alone. The Auto Actions ties
         follow the boxes, exactly as saveRegions does it (D125). */
      var packRegs = Array.isArray(m.regions) ? m.regions : null;
      var fit = {};
      saveVision(p, vis, function(ok, j){
        /* boxes the cap kept out are said, never dropped in silence */
        var said = '“'+vis.name+'” installed' + (fit.dropped > 0
          ? ' — '+fit.dropped+' of its boxes did not fit (the most is '+CV_MAX_REGIONS+
            '). Delete a box you no longer use and install it again'
          : '');
        if(ok && j && j.staged) visionSaid(j, said);
        else if(ok) ZS.toast(said, fit.dropped > 0 ? {ms:9000} : undefined);
        else ZS.toast((j && j.error) || 'Not installed — your adapter didn’t take it', {ms:6000});
        ZS.sheetClose();
        ZS.openDetail({id:'vision', lab:'Screen Assist'}, p);
      }, function(f){
        if(packRegs) f.vision.regions = cvMergeRegions(packRegs, f.vision.regions,
                                                       vis.name, fit);
        if(window.ZSAUTO && ZSAUTO.retie) ZSAUTO.retie(f);
      });
    }
    /* The pack manager, unchanged in what it does — now the sheet's tail.
       Rebuilt from the BOARD's copy on every open, so a pack installed or
       removed from another phone shows true. */
    function packSection(){
