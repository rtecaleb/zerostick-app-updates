          if(typeof q.grey === 'boolean') pic.grey = q.grey;
        }
      }
      picKnown = true;
      /* An adapter that reports nothing about the preview is an adapter that
         is making one — that was the only behaviour before this existed — so
         no block at all leaves `pic` on its defaults and the picture starts. */
      if(pic.enabled){ if(first || !was) resumeFrames(); }
      else if(first || was) dropPicture();
    }

