      if(ZS.productHides && ZS.productHides('visionPacks')) return;
      var t0 = cvToolsOf(cvVis());
      if(t0.colour || t0.colourPending || t0.model || t0.shot) return;
      var rg0 = cvVis().regions || [];
      for(var ri0 = 0; ri0 < rg0.length; ri0++){
        var k0 = rg0[ri0] && rg0[ri0].kind;
