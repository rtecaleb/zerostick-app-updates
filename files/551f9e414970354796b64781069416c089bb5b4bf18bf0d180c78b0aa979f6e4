    (function(){
      var flagKey = 'cvIntro|'+p.id;
      if(ZS.store.vals[flagKey]) return;
      if(ZS.live.online === false || !ZS.live.full[p.id]) return;
      /* Not on a Core (audit m47): its sheet has no pack shelf to introduce,
