          return r.blob().then(function(b){
            if(!alive()){ stopAll(); return; }
            /* A frame already in flight when the picture was switched off
               still lands. Drop it rather than putting it on screen. */
            if(picOff()){ framePend = false; return; }
            var was = picUrl;
            picUrl = URL.createObjectURL(b);
            picTag = tag;
            picShownW = want;
            coreShot = false;
            /* the <img> load/error handlers below carry on from here — they
               size the stage and schedule the next ask, exactly as before */
            im.src = picUrl;
            if(was){ try{ URL.revokeObjectURL(was); }catch(e){} }
          });
        })['catch'](function(){
          if(!alive()){ stopAll(); return; }
