/* devices.js — THE device registry.
 *
 * The one place in the app that lists ZeroStick products. The picker
 * (devices.html) reads this; nothing else in the app knows what products exist.
 *
 * Adding a product = one entry here + one page at `href`. That is the whole
 * plug-in story, on purpose: the interface between the shell and a product is
 * a URL, not an API, so a broken product cannot take another one down, and a
 * product page can be built without editing a single line of phone.html.
 *
 * Fields:
 *   id       stable forever — it is the localStorage['zs-device'] value. Never rename.
 *   name     big text on the row; also the product page's appbar title
 *   kind     one word before the status: Adapter, Controller
 *   tagline  one line, plain English, what it does for you
 *   href     page under public/ — relative, no leading slash
 *   accent   #rrggbb — 4px left rule + art tint
 *   art      key into ZS_DEVICE_ART
 *   pic      optional { loop, still }: the product's own photo, drawn the way
 *            HOME's device card draws it (flush left, full height, its light
 *            spilling into the tile) in place of the line glyph
 *   status   'ready' (tappable, counts toward auto-open) | 'soon' (never probed,
 *            never auto-opened. Greyed and inert, unless it has `about`)
 *   about    optional, on a 'soon' product: the key of a summary sheet in
 *            devices.html (EXO_ABOUT). The tile is then a button that opens
 *            it, chip "Coming soon" (D271)
 *   devUnlock optional, on a 'soon' product: the localStorage key that, set
 *            to '1', makes it count as 'ready' on THIS device (the hidden
 *            developer unlock, D271). A soft, client-side gate, not security
 *   probe    optional same-origin GET; {ok:true} within 2.5 s → "connected"
 *
 * Deliberately absent: sections, renderers, schema, transport. The shell never
 * renders a product's section, so it must never be told about one. If a field
 * would only ever be read by the product's own page, it does not belong here.
 *
 * ES5 only (dashboard/public rule): var, function, string concatenation.
 */
window.ZS_DEVICES = [
  {
    /* TWO PRODUCTS, AND ONLY TWO (owner, 2026-10-10, D264): "add it in the
       device list as an option, and remove all the other coming-soon
       options, so in the device list those are the two." The EXO (A7S),
       ZS 8K RTE and MAX 5 tiles, all 'soon', came out. Their pages and code
       are untouched (phone.html still opens as the EXO's page, max5.html is
       still in public/) - only the doors are gone.

       With two 'ready' products the picker auto-opens the REMEMBERED one
       (localStorage zs-device, which phone.html writes on every load), so an
       existing owner still lands straight in this app, and only a first
       launch, or ?pick=1, shows the list.

       THE CORE (D102): the ESP32-P4 adapter, the first product out. It is
       the SAME page as the EXO, opened as the Core's: phone.html reads
       ?core=1 to name itself, and once the Core answers /status with
       product "core" the page hides the screens the Core lacks (the product
       gate in phone.html). On a PC the page connects over USB (Web Serial,
       zs-serial.js, D104). Inside the phone app it opens as ?ble=1, the
       Bluetooth page, exactly as the phone app's own home screen did before
       this list replaced it (D264).

       No probe: the Core answers over a cable the picker cannot open
       without a user gesture, not over HTTP. Omitted probe means no dot at
       all, which is the honest result.

       D441 (2026-10-23): the Detected / Not detected pill in devices.html is
       NOT this probe. It looks without a gesture where a platform allows it
       (on a PC the USB port this app was already granted, in the phone app
       a short Bluetooth scan when Bluetooth is already allowed) and shows
       nothing where it cannot tell.

       COMING SOON (owner, 2026-10-10, D271): "Make the ZeroStick EXO say
       coming soon, and if someone clicks it, it pops up a summary of the
       product ... I want a way to bypass the coming-soon device ... because
       it is under development and not meant to be open to the public." The
       tile is named ZeroStick EXO (the id stays core, it is stored), its
       chip says Coming soon and a tap opens the summary sheet in
       devices.html. Ten taps on the sheet picture within five seconds set
       devUnlock to 1 on this device and open the app as before. phone.html
       checks the same key in its head and sends a locked visitor back here.
       A soft gate in the page, not security.

       NO SEMICOLON IN THIS COMMENT: tools/test-max5.js reads this file as
       JSON by cutting it at the first one. NO APOSTROPHE IN A VALUE either. */
    id:      'core',
    name:    'ZeroStick EXO',
    kind:    'Adapter',
    tagline: 'Any controller, any console, plus AI that sees your game',
    href:    'phone.html?core=1',
    nativeHref: 'phone.html?ble=1',
    accent:  '#8ea3bd',
    art:     'core',
    /* the owner's own photo of the unit, the same pair HOME's device card
       uses (D194 and D202): the RGB loop, and the still for Reduce Motion */
    pic:     { loop: 'brand/zs-exo-device-loop.webp', still: 'brand/zs-exo-device.jpg' },
    status:  'soon',
    about:   'exo',
    devUnlock: 'zs-exo-dev'
  },
  {
    /* THE ZEROSTICK CALIBRATION DONGLE (D264): the Bluetooth dongle that
       ships with the DualSense Edge stick modules. Calibrate the sticks,
       set up the stick flex, Recoil and Aim (Script Edition), firmware
       updates. Its screens came from the phone app (zerostick-app 2bba734)
       and live in public/dongle/, a SEPARATE app that shares no script,
       stylesheet, global, storage key or Bluetooth link with this one
       (dongle/README.md, tools/test-dongle-isolation.js). This href is the
       ONLY link between the two.

       THE TILE OPENS THE WIFI CALIBRATOR (owner, 2026-10-10): most players
       have that one and the new Bluetooth dongle has not launched, so the
       href is dongle/calibrator.html, which joins the WiFi calibrator with
       no chooser and links to dongle.html for the new (all black) one.

       No probe: neither answers this page over HTTP. The D441 Detected pill
       asks the exe whether the WiFi calibrator network is in sight
       (/zs/wifi/scan) and listens for the Bluetooth dongle, with code of its
       own in devices.html that shares nothing with dongle/.

       Its picture (owner, 2026-10-10) is the owner photo of the WiFi calibrator on
       black, the device list copy in brand/devices/ (the dongle app keeps its
       own copy in its own folder, D264). No loop, so it is always the still. */
    id:      'dongle',
    name:    'ZeroStick Calibrator',
    kind:    'Accessory',
    /* 2026-10-23 (owner, via the DSE session): calibration only, no stick
       flex or Recoil & Aim mentioned on this device */
    tagline: 'Calibrate DualSense and DualSense Edge sticks',
    href:    'dongle/calibrator.html',
    accent:  '#58a6ff',
    art:     'dongle',
    pic:     { still: 'brand/devices/zs-dongle.webp' },
    status:  'ready',
    /* D445 (owner, 2026-10-23): "they always have to choose what calibrator
       they have", by its picture, EVERY time the tile is tapped. The tile
       opens a chooser (devices.html) instead of a page, and the list never
       auto-opens a calibrator from memory. The WiFi one (blue board) is the
       calibrator page; the new Bluetooth one (black board, the DSE session's
       3D render on black) is dongle.html. */
    choose: [
      { id: 'wifi', name: 'ZeroStick Legacy Calibrator', sub: 'Blue board · connects over WiFi',
        pic: 'brand/devices/zs-dongle.webp', href: 'dongle/calibrator.html' },
      /* not out yet (owner, 2026-10-23): greyed, "Coming soon"; ten quick
         taps open it anyway so the owner can test it (devices.html) */
      { id: 'bt', name: 'ZeroStick Calibrator 2.0', sub: 'Black board · connects over Bluetooth',
        pic: 'brand/devices/zs-dongle-bt.webp', href: 'dongle/dongle.html', soon: true }
    ]
  }
];

/* Self-contained art. Deliberately NOT consoleArt() from phone-sections.js:
   that file is 265 KB and assumes window.ZS exists. The picker has to boot
   with nothing but itself, so it carries its own two drawings.
   stroke:currentColor throughout — the row tints these with the product accent. */
window.ZS_DEVICE_ART = {
  /* adapter: a small box bridging a controller side and a console side */
  exo:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '<rect x="12" y="17" width="24" height="17" rx="4"/>' +
      '<path d="M12 25.5 H6"/><path d="M36 25.5 H42"/>' +
      '<circle cx="6" cy="25.5" r="2.2"/>' +
      '<path d="M40 21 h3 v9 h-3"/>' +
      '<circle cx="19" cy="25.5" r="2"/>' +
      '<path d="M27 22.5 v6 M24 25.5 h6"/>' +
      '<path d="M18 12.5 A9 9 0 0 1 30 12.5" opacity=".55"/>' +
    '</svg>',
  /* the Core: the same adapter box as the EXO, with a USB plug in place of
     the radio arc, because on a PC that cable IS how you reach it. Kept
     distinct from the EXO's drawing so the two adapters tell apart at a
     glance in the picker. */
  core:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '<rect x="12" y="17" width="24" height="17" rx="4"/>' +
      '<path d="M12 25.5 H6"/><path d="M36 25.5 H42"/>' +
      '<circle cx="6" cy="25.5" r="2.2"/>' +
      '<path d="M40 21 h3 v9 h-3"/>' +
      '<circle cx="19" cy="25.5" r="2"/>' +
      '<path d="M27 22.5 v6 M24 25.5 h6"/>' +
      '<path d="M20.5 8.5 h7 v4 h-7 z M24 12.5 v4.5" opacity=".55"/>' +
    '</svg>',
  /* the Calibration Dongle: the bare board the phone app's home tile drew
     (zerostick-app www/index.html, our own art) - the USB-A plug on the left
     that goes into the console or a charger, the board, its chip and the
     socket the controller's cable plugs into. Scaled from that 24 grid. */
  dongle:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '<path d="M3.4 20.2h7.8v7.6H3.4z"/><path d="M6 22.8v2.4"/>' +
