      '<path d="M31.6 19.4v9.2M37 19.4v9.2"/>' +
    '</svg>',
  /* controller: DualSense-ish silhouette — the 8K RTE is that shell */
  pad:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '<path d="M17 16 h14 c4.4 0 7 3.2 8 8 l2.2 9.4 c.7 3.1-1.2 5.4-3.9 5.4 ' +
        'c-2.1 0-3.3-1.3-4.6-3.1L31 33 H17 l-1.7 2.7 C14 37.5 12.8 38.8 10.7 38.8 ' +
        'c-2.7 0-4.6-2.3-3.9-5.4 L9 24 c1-4.8 3.6-8 8-8 Z"/>' +
      '<path d="M15 23.5 v5 M12.5 26 h5"/>' +
      '<circle cx="32" cy="23.8" r="1.5"/><circle cx="35.5" cy="27.4" r="1.5"/>' +
