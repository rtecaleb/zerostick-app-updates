/* shell/10-editor.js — the editor of one config: its rooms.
 *
 * The list of rooms (Overview, Aim, Translation, Scripts, Mappings, AI
 * Scripts, Screen Assist...: renderEdMenu), the editor of a config whose
 * copy could not be read (D124), and the back key.
 *
 * PART OF THE APP SHELL: phone.html's one inline script until 2026-10-02,
 * now these consecutive files, loaded where it was. They are CLASSIC
 * scripts, as it was: every top-level function and var is a global the
 * other files (and devbar.js, sections/, smart-actions/) call by name, and
 * nothing here may use, while loading, a name a LATER shell file declares
 * (calls made after the page has loaded are fine). phone.html lists them.
 */
  /* ── EDITOR (one flat list of five) ────────────────────────────── */
  /* No tiers, no group headings, no "more in Advanced" — five rows, always
     the same five, in SECTIONS order. */
  /* THE EDITOR OF A CONFIG WHOSE COPY COULD NOT BE READ (D124). Its rooms are
     not drawn: every one of them edits the document, and there is no
     document to edit, so each would show made-up values and save nowhere.
     What is drawn instead is the one sentence that says what is wrong, and
     what still works without a copy: playing it, starting a fresh config
     from the same game pack (when its game is known, from the blob's IDENT
     section), and deleting it to free the slot. */
  function renderUnreadable(m, p){
    var pk = (window.ZSPACKS && p.game) ? ZSPACKS.ofConfig({game:p.game}) : null;
    var canCopy = !!(pk && window.ZS && ZS.addProfile && LIVE.online!==false &&
                     Object.keys(LIVE.full).length);
    var h = '<div class="note warn" id="ed-unreadable" role="status">'+esc(p.unreadable)+'</div>';
    if(p.id !== activeId) h += '<button class="btn primary" id="ed-u-play">Play this config</button>';
    if(canCopy) h += '<button class="btn" id="ed-u-copy">Start a new copy from '+esc(pk.name)+'</button>';
    h += '<button class="btn danger" id="ed-u-del">Delete it from the Core</button>';
    m.innerHTML = h;
    var play = document.getElementById('ed-u-play');
    if(play) play.addEventListener('click', function(){
      var prev = activeId;
      activeId = p.id; persist(); renderHome();
      api('/profiles/'+encodeURIComponent(p.id)+'/activate', 'POST', {}).then(function(j){
        if(j.ok){ toast('"'+p.name+'" is now live on the board'); renderEdMenu(p); return; }
        activeId = prev; persist(); renderHome();
        toast('Board kept its config: '+(j.error||'switch failed'), {ms:7000});
      });
    });
    var copy = document.getElementById('ed-u-copy');
    if(copy) copy.addEventListener('click', function(){
      var name = (p.name+' (new)').slice(0, 96);
      var id = (p.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,24)||'config')+
               '-'+Math.random().toString(36).slice(2,6);
      copy.disabled = true;
      ZS.addProfile({ id:id, name:name, platform:p.platform, input:p.input,
                      game:pk.name, pack:pk.id, color:p.color,
                      prepare: ZS.packPrepare ? ZS.packPrepare(pk, p.input) : null },
        function(ok){
          copy.disabled = false;
          if(ok){ openEditor(id); toast('"'+name+'" made from '+pk.name+'. The old one is still on the Core.', {ms:7000}); }
        });
    });
    /* Two taps, because it cannot be undone: the first says what the second
       will do, and it goes back to itself if the second never comes. */
    var del = document.getElementById('ed-u-del'), armed = null;
    if(del) del.addEventListener('click', function(){
      if(!armed){
        del.textContent = 'Tap again to delete it';
        armed = setTimeout(function(){ armed = null; del.textContent = 'Delete it from the Core'; }, 4000);
        return;
      }
      clearTimeout(armed); armed = null;
      ZS.deleteProfile(p.id, function(ok){
        if(!ok) return;
        closeEditor();
        toast('"'+p.name+'" deleted');
      });
    });
  }
  function renderEdMenu(p){
    var m = document.getElementById('edmenu'); m.innerHTML='';
    if(p && p.unreadable){ renderUnreadable(m, p); m.scrollTop=0; return; }
    var shown = 0;   /* stagger by DRAWN position, so a gated-out row can
                        never leave a hole in the rhythm */
    var lastGrp = '';
    SECTIONS.forEach(function(s){
      if(s.menu===false) return;
      if(!gateOK(s.gate,p)) return;
      /* D406: a row's own test of the config (Auto green only on NBA 2K,
         AI Scripts never there) */
      if(typeof s.show==='function' && !s.show(p)) return;
      /* the product gate (PRODUCTS above): a Core has no Screen Assist, so
         its door is not drawn; on an EXO this refuses nothing */
      if(productHides(s.id)) return;
      if(s.id==='vision' && productHides('visionMenu')) return;
      /* the group heading (D228), drawn only above the first row of a group
         that is actually shown */
      if(s.grp && s.grp!==lastGrp){
        var gh=document.createElement('div'); gh.className='edgrp'; gh.setAttribute('role','heading'); gh.setAttribute('aria-level','2');
        gh.textContent=s.grp; gh.setAttribute('data-grp', s.grp); m.appendChild(gh); lastGrp=s.grp;
      }
      var hint = typeof s.hint==='function'? s.hint(p) : s.hint;
      /* D233: a door's picture may depend on what is plugged in (Mappings) */
      var img = typeof s.img==='function' ? s.img(p) : s.img;
      var row=document.createElement('div'); row.className='item'+(s.gate?' gated':'')+(img?' has-pic':'');
      /* THE ROOM RIDES THE ROW, NOT JUST THE CHIP (2026-08-18). data-room is
         the same id the chip's ico-* class already carries — it is added as an
         ATTRIBUTE rather than a second class precisely because class names are
         an API here: nothing that selects .item / .ico / .ico-<id> can see this
         and no test's selector changes. What it buys is the whole row: the
         style block at the foot of this file hangs the room's 3px rail off one
         attribute, so the five doors are tellable apart without any of them
         being loud. (That block used to hang a per-room card fill and a solid
         per-room chip off it too — that is the "cluttered mess" this pass took
         back out; see §2 there.)

         NO ROW IS PROMOTED ANY MORE. `.lead` used to be added here to give the
         first drawn row the app's primary-button face. A table of contents has
         five equal doors and none of them is an action, so painting one like a
         button only said the other four were lesser. The class is not added
         and its rules are deleted; nothing else read it. */
      row.setAttribute('data-room', s.id);
      /* D433: the group rides the row, so the simple menu can fold Advanced */
      row.setAttribute('data-grp', s.grp || 'top');
      /* zs-in entrance is safe here and ONLY here: renderEdMenu is called
         from openEditor() alone — real navigation, never the ~8s poll — so
         the rows may rise in without ever replaying on a refresh. The
         delay rides inline because it is per-row data, not a style rule. */
      row.classList.add('zs-in');
      row.style.animationDelay = (70 + shown*45) + 'ms';
      shown++;
      /* the icon chip wears the section's tint (see the ico-* CSS); the id
         IS the class, so a section can never wear another section's colour.
         A section whose TITLE already says the whole thing returns '' for its
         hint and gets no second line at all — an empty .hint is display:none,
         so the row keeps its rhythm instead of reserving a blank line. */
      /* a door may wear a real picture instead of an icon (owner,
         2026-10-02: the Device door shows the ZS EXO itself) */
      /* EXO Studio's door wears the same wordmark (the ZS mark and the name)
         that heads the EXO Studio room (owner, 2026-10-13: "the EXO Studio
         logo on the Advanced tab should be the EXO Studio name and logo that
         is used when you click it"). The name stays in .lab for screen
         readers and every selector that reads it; the picture is the ink for
         the theme (zs-flat.css §18). */
      if(s.id==='studio'){
        /* owner, 2026-10-13: the wordmark sits in the picture slot on the
           left, centred, and the right side reads like every other door:
           his title, then the hint. "EXO Studio" stays in the name a screen
           reader hears and in .lab for every selector that reads it. */
        row.classList.add('studio-wm');
        /* D345 (owner, 2026-10-14: "needs to be more obvious"): a small
           "Advanced · PC" tag over the title says it from the menu too */
        row.setAttribute('aria-label', s.lab+': AI and Console Vision. Advanced, needs a PC'+(hint?'. '+hint:''));
        row.innerHTML='<span class="ico ico-studio ico-img st-row-pic">'+
            '<img class="st-row-wm st-wm-d" src="brand/zs-exo-studio-wordmark-dark.png" width="943" height="320" alt="" aria-hidden="true"></span>'+
          '<span class="t"><span class="st-row-tag" aria-hidden="true">Advanced · PC</span>'+
          '<div class="lab st-row-title">AI and Console Vision</div>'+
          '<div class="hint">'+(hint?esc(hint):'')+'</div></span><span class="chev">›</span>';
        row.addEventListener('click', function(){ openDetail(s, p); }); kb(row);
        m.appendChild(row);
        advRow(row);
        return;
      }
      row.innerHTML='<span class="ico ico-'+s.id+(img?' ico-img':'')+'">'+
        (img ? '<picture>'+(s.imgStill ? '<source media="(prefers-reduced-motion: reduce)" srcset="'+esc(s.imgStill)+'">' : '')+
                 '<img class="ico-pic" src="'+esc(img)+'" alt="" aria-hidden="true"></picture>' : icoSVG(s.ico, 26))+'</span><span class="t"><div class="lab">'+esc(s.lab)+'</div><div class="hint">'+(hint?esc(hint):'')+'</div></span><span class="chev">›</span>';
      row.addEventListener('click', function(){ openDetail(s, p); }); kb(row);
      m.appendChild(row);
      advRow(row);
    });
    edSimpleFoot(m, p);
    m.scrollTop=0;
  }
  /* D433 (owner, 2026-10-22): THE SIMPLE MENU. By default the menu is just
     Device and the Essentials (Aim, Mappings, AI Scripts), as big picture
     doors that share the whole screen; under them, this config's picture,
     whether the EXO is online and the console; and one small Advanced
     button at the foot. Advanced grows the menu into the full list (the
     Essentials shrink to rows, the headings and the Advanced rooms rise
     in), and Advanced again folds it back. Nothing is removed: every room
     is in the DOM in both, only folded. The choice is this viewer's
     (localStorage), simple until they pick Advanced. */
  var ED_ADV_KEY = 'zs.menuAdvanced';
  function edAdvOn(){ try{ return localStorage.getItem(ED_ADV_KEY)==='1'; }catch(e){ return false; } }
  function advRow(row){
    if(row.getAttribute('data-grp')==='Advanced' && !edAdvOn()) row.setAttribute('inert', '');
  }
  function edSimpleFoot(m, p){
    var adv = edAdvOn();
    m.classList.toggle('edsimple', !adv);
    var online = !(LIVE && LIVE.online===false);
    /* the owner, 2026-10-22: "make the Apex Legends art cover the whole
       bottom half, just the artwork like the main menu, and display the
       banners across it": the config's own picture (HOME's), full bleed,
       with the EXO's state and the console as a banner across its top and
       the config's name as one across its foot */
    var st = document.createElement('div');
    st.className = 'edstat'; st.id = 'edstat';
    st.setAttribute('aria-hidden', adv ? 'true' : 'false');
    var gameLine = p.game && String(p.name||'').toLowerCase().indexOf(String(p.game).toLowerCase()) < 0 ? p.game : '';
    st.innerHTML = '<span class="edstat-pic">'+artHTML(p, 300, {shape:'panel'})+'</span>'+
      '<span class="edstat-top">'+
        '<span class="edstat-chip"><i class="edstat-dot'+(online?' on':'')+'" aria-hidden="true"></i>'+
          (online ? 'EXO online' : 'EXO offline')+'</span>'+
        (CON[p.platform] ? '<span class="edstat-chip">'+esc(CON[p.platform])+'</span>' : '')+
      '</span>'+
      '<span class="edstat-foot"><span class="edstat-name">'+esc(shownName(p.name))+'</span>'+
        (gameLine ? '<span class="edstat-game">'+esc(shownName(gameLine))+'</span>' : '')+'</span>';
    m.appendChild(st);
    if(typeof wireArt==='function') wireArt(st);
    /* D435: the screen's ambient light takes this config's colour */
    zsAmbient(p.color);
    /* D435: every row knows its place in the cascade, so the Advanced
       morph can stagger (CSS reads --ai / --ei; one number per row) */
    var advRows = Array.prototype.filter.call(m.querySelectorAll('.item'), function(r){ return r.getAttribute('data-grp')==='Advanced'; });
    advRows.forEach(function(r, i){ r.style.setProperty('--ai', String(i)); });
    Array.prototype.forEach.call(m.querySelectorAll('.edgrp'), function(g, i){ g.style.setProperty('--ai', String(i)); });
    /* the Advanced control says what is behind it (D435): "Translation,
       Script Maker and 2 more", read from the rows actually drawn */
    var names = advRows.map(function(r){
      if(r.getAttribute('data-room')==='studio') return 'EXO Studio';
      var l = r.querySelector('.lab'); return l ? String(l.textContent||'').replace(/^Advanced\s+/, '') : '';
    }).filter(Boolean);
    var sub = names.length > 2 ? names.slice(0, 2).join(', ')+' and '+(names.length-2)+' more' : names.join(' and ');
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'edadv'; b.id = 'edadv';
    b.setAttribute('aria-expanded', adv ? 'true' : 'false');
    /* 2026-10-23: the owner's glowing teal chip (Downloads, "advaned tab
       logo.png", cropped square) is Advanced's mark */
    b.innerHTML = '<span class="edadv-ico edadv-pic" aria-hidden="true"><img src="brand/zs-advanced-chip.jpg" alt="" width="160" height="160"></span>'+
      '<span class="edadv-t"><span class="edadv-lab">Advanced</span>'+
        (sub ? '<span class="edadv-sub edadv-more">'+esc(sub)+'</span>' : '')+
        '<span class="edadv-sub edadv-less">Fold back to the simple menu</span></span>'+
      '<svg class="edadv-chev" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4"/></svg>';
    b.addEventListener('click', function(){
      var on = !m.classList.contains('edsimple');
      on = !on;
      try{ localStorage.setItem(ED_ADV_KEY, on ? '1' : '0'); }catch(e){}
      /* a tap before the first measure landed: take it now (D448) */
      if(on && !m._edRowOK) edFixRows(m, true);
      edMorphFx(m, b, on);
      m.classList.toggle('edsimple', !on);
      b.setAttribute('aria-expanded', on ? 'true' : 'false');
      st.setAttribute('aria-hidden', on ? 'true' : 'false');
      Array.prototype.forEach.call(m.querySelectorAll('.item[data-grp="Advanced"]'), function(r){
        if(on) r.removeAttribute('inert'); else r.setAttribute('inert', '');
      });
      if(!on){ if(m.scrollTo) m.scrollTo({top:0, behavior:'smooth'}); else m.scrollTop = 0; }
    });
    if(window.ZSM && ZSM.pressable) ZSM.pressable(b);
    m.appendChild(b);
    edFlare(m);
    edFixRows(m);
    /* and once the editor's slide-in has finished: the first open of this
       size takes its real measure here, never during the slide (D448) */
    setTimeout(function(){ if(m._edSure !== edRowKey(m)){ edFixRows(m, true); m._edSure = m._edKey; } }, 600);
  }
  /* D435 (owner, 2026-10-22: "fade the screen ... light at the top, slowly
     to darkish, animated slightly but subtle"; "ambience in the app"): the
     ambient light behind HOME, this menu and every room is CSS (zs-fixes.css
     "D435"); its one input is the config's colour, set once on the screen
     so every panel inherits it. A colour that is not a plain #hex is left
     out and the light stays the brand's. */
  function zsAmbient(color){
    var sc = typeof document !== 'undefined' && document.querySelector ? document.querySelector('.screen') : null;
    if(!sc || !sc.style || typeof sc.style.setProperty !== 'function') return;
    if(/^#[0-9a-f]{3,8}$/i.test(String(color||''))) AMB.base = color;
    ambPalette(sc);
  }
  /* D436 (owner, 2026-10-22: "make it breathe more colour, for example
     Warzone has the blue moving background; every 10 seconds let it fade
     into a new colour, slowly, constantly"): the two lights walk through
     the config's game's own colours, taken once from its picture (a 24 x 24
     sample: the strongest hues, at an even brightness), plus the config's
     colour. A new colour every 10 s; the change itself is a 6 s CSS
     transition of two registered colour properties (zs-fixes.css "D436"),
     so nothing runs per frame in script. Stopped under Reduce Motion (the
     system's or the app's switch) and while the app is hidden. */
  var AMB = { base: '', pal: [], key: '', i: 0, timer: 0 };
  function ambReduced(){
    try{
      if(document.body && document.body.classList.contains('a11y-motion')) return true;
      return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    }catch(e){ return false; }
  }
  function ambHex(r, g, b){
    return '#'+[r, g, b].map(function(v){ v = Math.max(0, Math.min(255, Math.round(v))); return (v < 16 ? '0' : '')+v.toString(16); }).join('');
  }
  /* hue (0..360) at an even, glowing lightness and saturation */
  function ambFromHue(h){
    var s = .72, l = .56, c = (1 - Math.abs(2*l - 1))*s, x = c*(1 - Math.abs((h/60)%2 - 1)), m = l - c/2, r=0, g=0, b=0;
    if(h < 60){ r=c; g=x; } else if(h < 120){ r=x; g=c; } else if(h < 180){ g=c; b=x; }
    else if(h < 240){ g=x; b=c; } else if(h < 300){ r=x; b=c; } else { r=c; b=x; }
    return ambHex((r+m)*255, (g+m)*255, (b+m)*255);
  }
  function ambHues(img){
    var cv = document.createElement('canvas'); cv.width = cv.height = 24;
    var cx = cv.getContext && cv.getContext('2d'); if(!cx) return [];
    cx.drawImage(img, 0, 0, 24, 24);
    var d = cx.getImageData(0, 0, 24, 24).data, bins = [], i;
    for(i = 0; i < 12; i++) bins.push(0);
    for(i = 0; i < d.length; i += 4){
      var r = d[i]/255, g = d[i+1]/255, b = d[i+2]/255, mx = Math.max(r,g,b), mn = Math.min(r,g,b), ch = mx - mn;
      if(ch < .18 || mx < .2) continue;               /* greys, black, white: no hue */
      var h = mx === r ? ((g - b)/ch + 6) % 6 : mx === g ? (b - r)/ch + 2 : (r - g)/ch + 4;
      bins[Math.floor(h*2) % 12] += ch*mx;            /* vivid and bright counts most */
    }
    var order = bins.map(function(w, k){ return { w: w, k: k }; })
      .filter(function(o){ return o.w > 0; }).sort(function(a, b){ return b.w - a.w; });
    var out = [], used = {};
    order.forEach(function(o){
      if(out.length >= 4 || used[o.k] || used[(o.k+1)%12] || used[(o.k+11)%12]) return;   /* distinct hues */
      used[o.k] = 1; out.push(ambFromHue(o.k*30 + 15));
    });
    return out;
  }
  function ambPalette(sc){
    var ed = document.getElementById('editor');
    var pid = (ed && ed.classList && ed.classList.contains('open') && editId) ? editId : activeId;
    var p = (typeof prof === 'function' && pid) ? prof(pid) : null;
    var src = (p && window.ZSPACKS && ZSPACKS.artFor) ? (ZSPACKS.artFor(p, 'panel') || ZSPACKS.artFor(p, 'tall')) : '';
    var key = src+'|'+AMB.base;
    if(key === AMB.key) return;
    AMB.key = key;
    var fallback = [AMB.base || '#6f9bff', '#6f9bff', '#a371f7', '#3fb6c8'];
    AMB.pal = fallback;
    ambStart(sc);
    if(!src || typeof Image === 'undefined') return;
    var img = new Image();
    img.onload = function(){
      if(AMB.key !== key) return;
      var hs = [];
      try{ hs = ambHues(img); }catch(e){ hs = []; }
      if(hs.length) AMB.pal = (AMB.base ? [AMB.base] : []).concat(hs);
      ambStep(sc);
    };
    img.src = src;
  }
  /* 2026-10-23 (D443): a change of colour is a breath on opacity (the
     GPU's job, no repaint): the lights fade out, take the next colours while
     unseen, and fade back in. The first paint and Reduce Motion just set
     the colours. */
  function ambSet(sc){
    var n = AMB.pal.length;
    sc.style.setProperty('--amb-cfg', AMB.pal[AMB.i]);
    sc.style.setProperty('--amb-cyc', AMB.pal[(AMB.i + 1) % n]);
  }
  function ambStep(sc, breathe){
    var n = AMB.pal.length; if(!n) return;
    AMB.i = (AMB.i + 1) % n;
    if(!breathe || !sc.classList || ambReduced()){ ambSet(sc); return; }
    clearTimeout(AMB.t1); clearTimeout(AMB.t2);
    sc.classList.add('amb-slow', 'amb-swap');
    AMB.t1 = setTimeout(function(){
      ambSet(sc);
      sc.classList.remove('amb-swap');
      AMB.t2 = setTimeout(function(){ sc.classList.remove('amb-slow'); }, 2600);
    }, 2500);
  }
  function ambStart(sc){
    if(AMB.timer) return;
    ambStep(sc);
    AMB.timer = setInterval(function(){
      if(document.hidden || ambReduced()) return;
      ambStep(sc, true);
    }, 10000);
  }
  /* D435: the Advanced morph's light. The layout itself is CSS transitions
     (they turn round mid-way from wherever they are, so a second tap
     reverses it); this adds what a transition cannot: a bloom of light out
     of the button that was pressed (cause, then effect, on the same frame
     as the tap), and the ambient light swelling for a moment. Web
     Animations on transform and opacity only; a new tap cancels the last
     bloom and starts its own. Reduce Motion (either signal): none of it,
     the menu cross-fades. */
  var edBloomAnim = null, edBloomEl = null, edFlareT = 0;
  function edMorphFx(m, b, opening){
    var calm = document.body.classList.contains('a11y-motion') ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var ed = document.getElementById('editor');
    if(calm || !ed || !ed.getBoundingClientRect || !b.getBoundingClientRect) return;
    var bloom = edBloomEl;
    if(!bloom || bloom.parentNode !== ed){
      bloom = edBloomEl = document.createElement('span'); bloom.className = 'edbloom'; bloom.setAttribute('aria-hidden', 'true');
      ed.appendChild(bloom);
    }
    var er = ed.getBoundingClientRect(), br = b.getBoundingClientRect();
    bloom.style.left = Math.round(br.left - er.left + br.width/2)+'px';
    bloom.style.top = Math.round(br.top - er.top + br.height/2)+'px';
    if(edBloomAnim && edBloomAnim.cancel) edBloomAnim.cancel();
    if(typeof bloom.animate === 'function'){
      /* opening: the light rises out of the button and up the screen;
         closing: it gathers back towards the button */
      edBloomAnim = bloom.animate(opening ? [
        { transform:'translate(-50%,-50%) scale(.15)', opacity:0 },
        { transform:'translate(-50%,-50%) scale(1.1)', opacity:1, offset:.28 },
        { transform:'translate(-50%,-50%) scale(3.2)', opacity:0 }
      ] : [
        { transform:'translate(-50%,-50%) scale(2.6)', opacity:0 },
        { transform:'translate(-50%,-50%) scale(1.2)', opacity:.85, offset:.55 },
        { transform:'translate(-50%,-50%) scale(.2)', opacity:0 }
      ], { duration: opening ? 760 : 620, easing:'cubic-bezier(.22,1,.36,1)' });
    }
    ed.classList.add('edflare');
    clearTimeout(edFlareT);
    edFlareT = setTimeout(function(){ ed.classList.remove('edflare'); }, 520);
  }
  /* THE FULL MENU LOOKS EXACTLY AS IT DID (owner, 2026-10-22: "keep the
     same sizing as last time"). Its rows share the menu's height (D230); the
     Advanced button under them would have taken its share. So the row height
     the full list has WITHOUT the strip and the button is measured once,
     with no transitions, and the rows are pinned to it; the button sits just
     below them. Measured again when the window changes size. */
  /* D438 (owner, 2026-10-23: "when you click them, that's the glowing effect
     in the background"): pressing a door lights the menu's ground in that
     door's colour, centred where it is, while its room opens in the same
     colour. Wired once per menu element; the light is .edflare in #editor. */
