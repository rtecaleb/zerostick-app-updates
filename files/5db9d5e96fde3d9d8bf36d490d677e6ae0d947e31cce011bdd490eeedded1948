/* zs-ble-embed.js - the calibrator opened INSIDE the dongle hub (one page:
 * dongle.html shows calibrator.html?from=dongle&embed=1 in a full-screen
 * frame) uses the hub's Bluetooth link instead of its own. A page change
 * drops a Web Bluetooth connection on the PC (and the browser cannot get the
 * device back without the chooser), so the link must live in the page that
 * stays: the hub.
 *
 * Loaded right AFTER js/hid-ble.js on calibrator.html: when embedded, it
 * replaces window.ZSHIDBLE with the parent's, through a thin wrapper. The
 * wrapper copies bytes across: the frame has its own Uint8Array, so the
 * calibrator's `instanceof Uint8Array` checks fail on the parent's arrays
 * (and the other way round), and a callback into this frame must stop once
 * the frame is gone. ES5.
 */
(function () {
  'use strict';
  var embedded = /[?&]embed=1(&|$)/.test(location.search);
  var P = null;
  try { P = embedded && window.parent !== window && window.parent.ZSHIDBLE; } catch (e) { P = null; }
  if (!P) { return; }

  var alive = true;
  window.addEventListener('pagehide', function () { alive = false; });

  function here(v) {                  /* parent's bytes -> this frame's */
    if (v && typeof v === 'object' && typeof v.length === 'number' && typeof v.byteLength === 'number') {
      var out = new Uint8Array(v.length), i;
      for (i = 0; i < v.length; i++) { out[i] = v[i]; }
      return out;
    }
    return v;
  }
  function there(v) {                 /* this frame's bytes -> a plain array */
    if (v && typeof v === 'object' && typeof v.byteLength === 'number') {
      var b = v.buffer ? new Uint8Array(v.buffer, v.byteOffset || 0, v.byteLength) : new Uint8Array(v);
      return Array.prototype.slice.call(b);
    }
    return v;
  }
  function guard(fn) {
    return function () { if (alive && fn) { return fn.apply(null, Array.prototype.map.call(arguments, here)); } };
  }

  var W = {}, k;
  for (k in P) {
    if (!Object.prototype.hasOwnProperty.call(P, k)) { continue; }
    if (typeof P[k] !== 'function') { W[k] = P[k]; continue; }
    W[k] = (function (name) {
      return function () {
        var args = Array.prototype.map.call(arguments, function (a) {
          return typeof a === 'function' ? guard(a) : there(a);
        });
        var r = P[name].apply(P, args);
        return (r && typeof r.then === 'function') ? Promise.resolve(r).then(here) : here(r);
      };
    })(k);
  }
  W.embedded = true;
  window.ZSHIDBLE = W;
})();
