  }

  function closeSession() {
    S.gen++;
    stop8k();
    if (S.watch) { clearInterval(S.watch); S.watch = null; }
    if (S.open) {
      S.open = null;
      api('/padcal/close', 'POST', {});
    }
    try { delete window.ZSPadCalBridge; } catch (e) { window.ZSPadCalBridge = undefined; }
  }

  /* ═══════════════════════════════════════════════ the screen ══ */
  function render(p) {
    injectCss();
    S.p = p || S.p;
