      : 'Heads up: your console may still see this controller while you calibrate.';
    /* D414: the held line shares its row with the ?, and the frame is sized
       to exactly what is left of the screen (fitFrame), so the app's page
       does not scroll round it: only the site scrolls, like a page of its own */
    var hp = help(), cut = hp.indexOf('<div class="note qhfold"');
    r.innerHTML = '<div class="zkcard pcal-card pcal-sonyhead"><div class="pcal-head">' + PAD_ICON +
      '<div class="pcal-t"><b id="pcal-title">' + esc(od.title || 'Controller') + '</b><span id="pcal-sub" class="pcal-held">' +
      esc(held) + '</span></div>' + (cut > 0 ? hp.slice(0, cut) : hp) + '</div>' + (cut > 0 ? hp.slice(cut) : '') + '</div>' +
      '<iframe class="pcal-frame" id="pcal-frame" title="Controller calibration" src="' + FRAME_SRC + '"></iframe>' +
      ((Z().devMode && Z().devMode()) ? '<p class="pcal-link" id="pcal-link">' + esc(linkName()) + '</p>' : '') +
      '<p class="pcal-credit">Calibration screens: dualshock-tools, MIT licence, © 2024 the_al</p>';
    if (gen !== S.gen) return;
    fitFrame();
    r.addEventListener('click', function () { setTimeout(fitFrame, 60); });
    if (!S.fitWired) {
      S.fitWired = true;
      if (window.addEventListener) window.addEventListener('resize', function () { if ($('pcal-frame')) fitFrame(); });
    }
  }

  /* the frame takes what is left of the screen under the head, above the
     credit line and the app's bottom bar (never less than a phone's worth) */
  function fitFrame() {
    var f = $('pcal-frame'), d = $('dbody');
    if (!f || !d || !d.getBoundingClientRect) return;
    /* the always-on bar (.devbar) lies over the page's foot. Its reserve
       (--dvb-h) is roomier than the bar, so while the site is framed the
       page keeps only what the bar really covers (--pcal-padb, CSS above) */
    var dr = d.getBoundingClientRect(), bar = document.querySelector('.devbar');
    var br = bar && bar.offsetHeight ? bar.getBoundingClientRect() : null;
    var cover = br && br.top < dr.bottom ? dr.bottom - br.top : 0;
    if (d.style && d.style.setProperty) d.style.setProperty('--pcal-padb', Math.ceil(cover + 10) + 'px');
    var cs = window.getComputedStyle ? getComputedStyle(d) : null;
    var padB = cs ? parseFloat(cs.paddingBottom) || 0 : 0;
    var top = f.getBoundingClientRect().top - dr.top + d.scrollTop;
    var after = 0, n = f.nextElementSibling;
    while (n) { after += (n.offsetHeight || 0) + 8; n = n.nextElementSibling; }
    var h = Math.floor(d.clientHeight - top - after - padB);
    if (!(h > 0)) return;
    f.style.height = Math.max(420, h) + 'px';
  }

  /* ══════════════════════════════════════ a ZS 8K: its own wizard ══ */
  function stop8k() {
    if (S.z && S.z.timer) clearTimeout(S.z.timer);
    if (S.z) S.z.dead = true;
    S.z = null;
  }

  function show8k(od, gen) {
    var C = window.ZS8KCAL;
    stop8k();
    var z = S.z = { gen: gen, mode: 'home', cal: C.def(), saved: false, dirty: false, info: null,
                    v: null, btn: 0, hold: {}, wiz: null, trig: null, fine: 'center', stick: 'L',
                    circ: null, raw: null, state: '', stateKind: '', timer: null, dead: false,
                    fails: 0, od: od, view: 'normal', cd: { L: [], R: [] } };
    setState('zs8k');
    Promise.all([api('/padcal/zs8k/info'), api('/padcal/zs8k/cal')]).then(function (a) {
      if (z.dead) return;
      z.info = dataOf(a[0]);
      var c = dataOf(a[1]);
      if (c && c.cal && c.cal.length >= 12) { z.cal = C.fill(c.cal); z.saved = true; }
      draw8k();
      poll8k();
    });
    draw8k();
  }

  function zsub(z) {
    var i = z.info || {};
    var bits = [];
    if (z.od.zs8k && z.od.zs8k.mode) bits.push(z.od.zs8k.mode + ' mode');
    if (i.fw) bits.push('firmware ' + i.fw);
    bits.push(z.saved ? 'calibration saved on the controller' : 'factory calibration');
    return bits.join(' · ');
  }
  function key(sym) { return '<span class="pcal-key" aria-hidden="true">' + sym + '</span>'; }

  /* D414: the 8K's screens wear the dualshock-tools look - its Joystick Info
     card (both sticks in one 300 x 150 drawing, LX/LY/RX/RY under it, Normal
     / 10x zoom / Check circularity), its step sheets (title, words, progress,
     the button that moves on at the foot) and its finetune cards (a stick per
     card, the numbers round the drawing, the readouts under it). The
     drawing is the site's own (pad-dial.js); the steps, words and buttons
     are still the 8K's own wizard's. */
  function canvasHTML(id, w, h, cls) {
    return '<canvas id="' + id + '" class="' + (cls || '') + '" width="' + (w * 2) + '" height="' + (h * 2) +
      '" data-w="' + w + '" data-h="' + h + '" style="aspect-ratio:' + w + '/' + h + '"></canvas>';
  }
  function readHTML(names, pre) {
    return '<div class="pb-reads">' + names.map(function (n) {
      return '<div><span>' + n + ':</span><pre id="' + (pre || 'pcal-') + n.toLowerCase() + '"></pre></div>';
    }).join('') + '</div>';
  }
  function joyCardHTML() {
    var z = S.z;
    var modes = [['normal', 'Normal'], ['zoom', '10x zoom'], ['circ', 'Check circularity']];
    return '<div class="pb-card"><div class="pb-head">' + CROSSHAIR + 'Joystick Info</div>' +
      '<div class="pb-body">' + canvasHTML('pcal-js', 300, 150, 'pb-joy') +
      readHTML(['LX', 'LY', 'RX', 'RY']) +
      '<div class="pb-seg sm" role="radiogroup" aria-label="Display mode options">' + modes.map(function (m) {
        return '<button type="button" role="radio" aria-checked="' + (z.view === m[0]) + '" data-pcv="' + m[0] + '"' +
          (z.view === m[0] ? ' class="on"' : '') + '>' + m[1] + '</button>';
      }).join('') + '</div>' + trigHTML() + '</div></div>';
  }
  function trigHTML() {
    return '<div class="pcal-trig"><b>L2</b><div class="pcal-bar"><i id="pcal-l2"></i></div><span id="pcal-l2n"></span></div>' +
      '<div class="pcal-trig"><b>R2</b><div class="pcal-bar"><i id="pcal-r2"></i></div><span id="pcal-r2n"></span></div>';
  }
  function stateHTML(z) {
    return '<div class="pcal-state' + (z.stateKind ? ' ' + z.stateKind : '') + '" id="pcal-state">' +
      esc(z.state || (z.dirty ? 'Not saved yet' : '')) + '</div>';
  }
  /* a step, the way the site's modals look: title, body, the buttons at the foot */
  function sheetHTML(title, body, foot) {
    return '<div class="pb-sheet"><div class="pb-sh-head">' + esc(title) + '</div>' +
      '<div class="pb-sh-body">' + body + '</div><div class="pb-sh-foot">' + foot + '</div></div>';
  }
  function progHTML(withText) {
    return '<div class="pb-prog"><i id="pcal-prog"></i></div>' +
      (withText ? '<div class="pb-progt">Progress: <span id="pcal-progn">0%</span></div>' : '');
  }
  /* one finetune card: the stick's numbers round its drawing, LX/LY under it */
  function fineCardHTML(sd) {
    var z = S.z, m = window.ZS8KCAL.FMAP[sd];
    var inp = function (pos, i, lab) {
      return '<label class="pb-ft-' + pos + '"><span>' + lab + '</span><input inputmode="numeric" aria-label="' +
        (sd === 'L' ? 'Left' : 'Right') + ' ' + lab + '" data-pcf="' + i + '" value="' + z.cal[i] + '"></label>';
    };
    var grid = z.fine === 'center'
      ? inp('top', m[1], 'Y') + inp('left', m[0], 'X')
      : inp('top', m[5], 'Top') + inp('left', m[2], 'Left') + inp('right', m[3], 'Right') + inp('bottom', m[4], 'Bottom');
    var off = z.fine === 'circ' && z.circ && z.circ[sd] != null ? ' · off by ' + z.circ[sd] + '%' : '';
    return '<div class="pb-card pb-stick' + (z.stick === sd ? ' on' : '') + '" data-stick="' + sd + '">' +
      '<div class="pb-head">' + (sd === 'L' ? 'Left stick' : 'Right stick') + '<span class="pb-off">' + esc(off) + '</span></div>' +
      '<div class="pb-body"><div class="pb-ftgrid">' + grid +
      '<div class="pb-ft-center">' + canvasHTML('pcal-f' + sd, 210, 210, 'pb-ftc') + '</div></div>' +
      readHTML(sd === 'L' ? ['LX', 'LY'] : ['RX', 'RY']) + '</div></div>';
  }
  var CROSSHAIR = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
    '<circle cx="12" cy="12" r="8"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/></svg>';

  function draw8k() {
    var z = S.z, r = $('pcal');
    if (!z || !r) return;
    var h = headHTML('ZS 8K', zsub(z)) +
      '<p class="pcal-held">' + esc(z.od.held ? 'Your console can’t see this controller while Calibration is open.'
        : 'Heads up: your console may still see this controller while you calibrate.') + '</p>';
    if (z.mode === 'home') {
      h += '<div class="pb-stack">' +
          '<button type="button" class="pb-btn" data-pc="calib">' + key('○') + 'Calibrate sticks</button>' +
          '<button type="button" class="pb-btn" data-pc="range">Range only</button>' +
          '<button type="button" class="pb-btn" data-pc="fine">Fine-tune</button>' +
          '<button type="button" class="pb-btn" data-pc="trig">Calibrate triggers</button>' +
          '<div class="pb-hint">Pad shortcuts: <b>○</b> calibrate sticks · <b>✕</b> save. Range and fine-tune open from these buttons only</div>' +
          '<hr class="pb-hr">' +
          '<button type="button" class="pb-btn ok" data-pc="save">' + key('✕') + 'Save to controller</button>' +
        '</div>' + stateHTML(z) + joyCardHTML() + help();
    } else if (z.mode === 'wizard' && z.wiz && z.wiz.stage === 'hands') {
      h += sheetHTML('Step 1: hands off',
        '<p class="pcal-msg">Take both hands off the controller. The stick centres are being measured.</p>' +
        '<div class="pcal-count" id="pcal-count">' + z.wiz.left + '</div>' + progHTML(false),
        '<button type="button" class="pb-btn ghost" data-pc="cancel">' + key('○') + 'Cancel</button>');
    } else if (z.mode === 'wizard' && z.wiz && z.wiz.stage === 'range') {
      h += sheetHTML('Step 2: spin the sticks',
        '<p class="pcal-msg"><b class="pb-pulse">Slowly roll both sticks in full circles, a few times each way, until the bar fills.</b></p>' +
        '<div class="pb-range"><div>' + canvasHTML('pcal-rL', 150, 150, 'pb-rc') + '</div><div>' + canvasHTML('pcal-rR', 150, 150, 'pb-rc') + '</div>' +
        readHTML(['LX', 'LY']) + readHTML(['RX', 'RY']) + '</div>' + progHTML(true),
        '<button type="button" class="pb-btn ghost" data-pc="cancel">' + key('○') + 'Cancel</button>');
    } else if (z.mode === 'trig') {
      h += sheetHTML('Calibrate triggers',
        '<p class="pcal-msg">Hands off both triggers for a second, then squeeze each one all the way a few times.</p>' + trigHTML(),
        '<button type="button" class="pb-btn ghost" data-pc="cancel">' + key('○') + 'Cancel</button>' +
        '<button type="button" class="pb-btn" data-pc="trigdone">' + key('✕') + 'Done</button>');
    } else if (z.mode === 'fine') {
      h += sheetHTML('Fine-tune',
        '<div class="pb-seg pcal-seg" role="tablist"><button type="button" data-pcm="center"' + (z.fine === 'center' ? ' class="on"' : '') + '>Centre</button>' +
        '<button type="button" data-pcm="circ"' + (z.fine === 'circ' ? ' class="on"' : '') + '>Roundness</button></div>' +
        '<div class="pb-alert">' + (z.fine === 'center'
          ? 'Press the d-pad to move the dot onto the cross. Tap a stick to choose it.'
          : 'Hold the stick toward an edge, then up or left grows that edge, down or right shrinks it, until the line meets the circle.') + '</div>' +
        fineCardHTML('L') + fineCardHTML('R') + stateHTML(z),
        '<button type="button" class="pb-btn quiet" data-pc="range">Re-spin range</button>' +
        '<button type="button" class="pb-btn quiet" data-pc="centres">Re-do centres</button>' +
        '<button type="button" class="pb-btn ghost" data-pc="home">' + key('○') + 'Done</button>' +
        '<button type="button" class="pb-btn ok" data-pc="save">' + key('✕') + 'Save to controller</button>');
    } else {
      h += sheetHTML('Calibrated', '<div class="pcal-count">✓</div><p class="pcal-msg" style="text-align:center">Calibrated. Opening fine-tune…</p>', '');
    }
    r.innerHTML = h;
    Array.prototype.forEach.call(r.querySelectorAll('[data-pc]'), function (b) {
      b.addEventListener('click', function () { act(b.getAttribute('data-pc')); });
    });
    Array.prototype.forEach.call(r.querySelectorAll('[data-pcm]'), function (b) {
      b.addEventListener('click', function () { z.fine = b.getAttribute('data-pcm'); draw8k(); });
    });
    /* the display modes start their drawing over, the site's way (resetStickDiagrams) */
    Array.prototype.forEach.call(r.querySelectorAll('[data-pcv]'), function (b) {
      b.addEventListener('click', function () { z.view = b.getAttribute('data-pcv'); z.cd = { L: [], R: [] }; draw8k(); });
    });
    Array.prototype.forEach.call(r.querySelectorAll('.pb-stick'), function (b) {
      b.addEventListener('click', function (e) {
        if (e.target && e.target.tagName === 'INPUT') return;
        if (z.mode === 'fine' && z.stick !== b.getAttribute('data-stick')) { z.stick = b.getAttribute('data-stick'); draw8k(); }
      });
    });
    Array.prototype.forEach.call(r.querySelectorAll('[data-pcf]'), function (inp) {
      inp.addEventListener('change', function () {
        z.cal[+inp.getAttribute('data-pcf')] = Math.max(0, Math.min(4095, parseInt(inp.value, 10) || 0));
        z.circ = window.ZS8KCAL.circBins(z.cal, z.raw);
        z.dirty = true;
        z.state = '';
        paint8k();
      });
    });
    paint8k();
  }

  function act(what) {
    var z = S.z, C = window.ZS8KCAL;
    if (!z) return;
    var now = Date.now();
    if (what === 'calib') { z.wiz = C.wizard('hands', null, now); z.mode = 'wizard'; }
    else if (what === 'range') { z.wiz = C.wizard('range', z.mode === 'fine' ? 'fine' : null, now); z.mode = 'wizard'; }
    else if (what === 'centres') { z.wiz = C.wizard('hands', 'fine', now); z.mode = 'wizard'; }
    else if (what === 'fine') { z.mode = 'fine'; z.circ = C.circBins(z.cal, z.raw); }
    else if (what === 'trig') { z.trig = C.trigStart(); z.mode = 'trig'; }
    else if (what === 'trigdone') { if (z.trig) { C.trigDone(z.trig, z.cal); z.dirty = true; } z.mode = 'home'; }
    else if (what === 'cancel') { z.mode = z.wiz && z.wiz.returnTo === 'fine' ? 'fine' : 'home'; z.wiz = null; z.trig = null; }
    else if (what === 'home') { z.mode = 'home'; }
    else if (what === 'save') { save8k(); return; }
    z.state = '';
    z.stateKind = '';
    draw8k();
  }

  function save8k() {
    var z = S.z;
    if (!z) return;
    z.state = 'Saving…';
    z.stateKind = '';
    paintState();
    api('/padcal/zs8k/save', 'POST', { cal: z.cal.slice(0, 28) }).then(function (j) {
      if (z.dead) return;
      var d = dataOf(j);
      if (d && d.saved) {
        z.dirty = false;
        z.saved = true;
        if (d.cal && d.cal.length >= 12) z.cal = window.ZS8KCAL.fill(d.cal);
        z.state = d.verified ? 'Saved on the controller ✓' : 'Saved, but the controller read back something else. Save again.';
        z.stateKind = d.verified ? 'ok' : 'bad';
      } else {
        z.state = (j && j.error) || 'The controller did not save. Try again.';
        z.stateKind = 'bad';
      }
      draw8k();
    });
  }
  function paintState() {
    var el = $('pcal-state');
    if (el && S.z) { el.textContent = S.z.state; el.className = 'pcal-state' + (S.z.stateKind ? ' ' + S.z.stateKind : ''); }
  }

  function poll8k() {
    var z = S.z;
    if (!z || z.dead) return;
    if (!onScreen()) { closeSession(); return; }
    api('/padcal/zs8k/raw').then(function (j) {
      if (z.dead) return;
      var d = dataOf(j);
      if (d && d.v) { z.fails = 0; tick8k(d.v, +d.btn || 0); }
      else if (/unplugged|went quiet|Open calibration/.test(String(j && j.error))) {
        stop8k();
        message('ZS 8K', 'The controller was unplugged or the screen was idle too long. Plug it back in and check again.', true);
        return;
      } else z.fails++;
      z.timer = setTimeout(poll8k, slow() ? 110 : 30);
    });
  }

  function tick8k(v, btn) {
    var z = S.z, C = window.ZS8KCAL, now = Date.now();
    var prev = z.btn;
    z.v = v;
    z.btn = btn;
    var keys = C.pressed(prev, btn);
    if (z.mode === 'wizard' && z.wiz) {
      var before = z.wiz.stage;
      C.wizTick(z.wiz, v, z.cal, now);
      if (z.wiz.raw.L.length) z.raw = z.wiz.raw;
      if (keys.indexOf('circle') >= 0) { act('cancel'); return; }
      if (z.wiz.stage !== before) {
        z.dirty = true;
        if (z.wiz.stage === 'done') {
          z.circ = C.circBins(z.cal, z.raw);
          var back = z.wiz.returnTo;
          z.mode = back === 'fine' ? 'fine' : 'done';
          z.wiz = null;
          draw8k();
          if (z.mode === 'done') {
            setTimeout(function () { if (S.z === z && z.mode === 'done') { z.mode = 'fine'; draw8k(); } }, 1100);
          }
          return;
        }
        draw8k();
        return;
      }
    } else if (z.mode === 'trig' && z.trig) {
      C.trigTick(z.trig, v);
      if (keys.indexOf('cross') >= 0) { act('trigdone'); return; }
      if (keys.indexOf('circle') >= 0) { act('cancel'); return; }
    } else if (z.mode === 'fine') {
      var dirs = C.dpad(z.hold, btn, now);
      var changed = false;
      dirs.forEach(function (d) { if (C.fineStep(z.cal, z.fine, z.stick, d, v)) changed = true; });
      if (changed) {
        z.dirty = true;
        z.state = '';
        if (z.fine === 'circ') z.circ = C.circBins(z.cal, z.raw);
        Array.prototype.forEach.call(document.querySelectorAll('#pcal [data-pcf]'), function (inp) {
          if (document.activeElement !== inp) inp.value = z.cal[+inp.getAttribute('data-pcf')];
        });
        paintState();
      }
      if (keys.indexOf('cross') >= 0) { save8k(); return; }
      if (keys.indexOf('circle') >= 0) { act('home'); return; }
    } else if (z.mode === 'home') {
      if (keys.indexOf('circle') >= 0) { act('calib'); return; }
      if (keys.indexOf('cross') >= 0) { save8k(); return; }
    }
    paint8k();
  }

  /* the live parts, without rebuilding the screen */
  function paint8k() {
    var z = S.z, C = window.ZS8KCAL;
    if (!z) return;
    if (z.wiz) {
      var pr = $('pcal-prog'), ct = $('pcal-count'), pn = $('pcal-progn');
      if (pr) pr.style.width = Math.round(z.wiz.pct) + '%';
      if (ct) ct.textContent = z.wiz.left;
      if (pn) pn.textContent = Math.round(z.wiz.pct) + '%';
    }
    if (z.v) {
      [0, 1].forEach(function (i) {
        var bar = $(i ? 'pcal-r2' : 'pcal-l2'), n = $(i ? 'pcal-r2n' : 'pcal-l2n');
        var pct = z.mode === 'trig' && z.trig
          ? Math.max(0, Math.min(1, (z.v[4 + i] - z.trig.rest[i]) / Math.max(1, C.trigPressed(z.trig, i) - z.trig.rest[i])))
          : C.trigPct(z.cal, z.v, i);
        if (bar) bar.style.width = Math.round(pct * 100) + '%';
        if (n) n.textContent = Math.round(pct * 100) + '%';
      });
    }
    paintSticks();
  }

  /* where a stick is, the site's way round: x right, y DOWN, -1..1 */
  function sitePt(side) {
    var z = S.z, C = window.ZS8KCAL;
    if (!z || !z.v) return { x: 0, y: 0 };
    var raw = C.pairOf(z.v, side);
    var n = C.nrmPt(z.cal, raw[0], raw[1], side);
    return { x: n[0], y: -n[1] };
  }
  /* the 8K's roundness map (its 48 sectors, y up) as the site's (y down) */
  function siteBins(side) {
    var z = S.z, N = window.ZSDIAL.N;
    if (!z || !z.circ || !z.circ.bins || !z.circ.bins[side]) return [];
    var b = z.circ.bins[side], out = [];
    for (var j = 0; j < N; j++) out.push(b[(N - j) % N] || 0);
    return out;
  }
  function dark() { return true; }   /* D444: the app is dark only */
  function ctxOf(id) {
    var cv = $(id);
    if (!cv || !cv.getContext) return null;
    var g = cv.getContext('2d');
    if (!g) return null;
    var w = +cv.getAttribute('data-w') || cv.width, h = +cv.getAttribute('data-h') || cv.height;
    if (g.setTransform) g.setTransform(cv.width / w, 0, 0, cv.height / h, 0, 0);
    g.clearRect(0, 0, w, h);
    return { g: g, w: w, h: h };
  }
  function setText(id, t) { var el = $(id); if (el) el.textContent = t; }

  function paintSticks() {
    var z = S.z, D = window.ZSDIAL;
    if (!z || !D) return;
    var L = sitePt('L'), R = sitePt('R'), dk = dark(), c;
    if (z.mode === 'home') {
      /* the site's Joystick Info: refresh_stick_pos's geometry, 1:1 */
      if (z.view === 'circ' && z.v) { D.collect(z.cd.L, L.x, L.y); D.collect(z.cd.R, R.x, R.y); }
      c = ctxOf('pcal-js');
      if (c) {
        var sz = 60, yb = 15 + sz, hb = 20 + sz, zoom = z.view === 'zoom';
        D.draw(c.g, hb, yb, sz, L.x, L.y, { dark: dk, zoom: zoom, circ: z.view === 'circ' ? z.cd.L : null });
        D.draw(c.g, c.w - hb, yb, sz, R.x, R.y, { dark: dk, zoom: zoom, circ: z.view === 'circ' ? z.cd.R : null });
      }
      var p = z.view === 'zoom' ? 3 : 2;
      setText('pcal-lx', D.str(L.x, p)); setText('pcal-ly', D.str(L.y, p));
      setText('pcal-rx', D.str(R.x, p)); setText('pcal-ry', D.str(R.y, p));
    } else if (z.mode === 'wizard' && z.wiz && z.wiz.stage === 'range') {
      /* the site's range sheet: two plain dials, two decimals */
      [['L', L], ['R', R]].forEach(function (s) {
        var k = ctxOf('pcal-r' + s[0]);
        if (k) D.draw(k.g, k.w / 2, k.h / 2, 60, s[1].x, s[1].y, { dark: dk });
      });
      setText('pcal-lx', D.str(L.x, 2)); setText('pcal-ly', D.str(L.y, 2));
      setText('pcal-rx', D.str(R.x, 2)); setText('pcal-ry', D.str(R.y, 2));
    } else if (z.mode === 'fine') {
      /* the site's finetune: centre = the 10x zoom, roundness = the sector
         map with its % figure; the stick being tuned is highlighted */
      [['L', L], ['R', R]].forEach(function (s) {
        var k = ctxOf('pcal-f' + s[0]);
        if (k) {
          var r = k.w / 2 - 5;
          D.draw(k.g, r + 5, r + 5, r, s[1].x, s[1].y, z.fine === 'circ'
            ? { dark: dk, circ: siteBins(s[0]), highlight: z.stick === s[0] }
            : { dark: dk, zoom: true, highlight: z.stick === s[0] });
        }
        setText('pcal-' + s[0].toLowerCase() + 'x', D.str(s[1].x, 3));
        setText('pcal-' + s[0].toLowerCase() + 'y', D.str(s[1].y, 3));
      });
    }
  }
  /* the screen's renderer, and the button the Aim screen draws */
  window.RENDERERS = window.RENDERERS || {};
  window.RENDERERS[SCREEN] = render;
  window.ZSPADCAL = {
    buttonHTML: buttonHTML,
    wire: wire,
    open: open,
    close: closeSession,
    /* for tests */
    _state: function () { return S; },
    _act: act,
    _tick: function (v, btn) { if (S.z) tick8k(v, btn); }
  };
})();
