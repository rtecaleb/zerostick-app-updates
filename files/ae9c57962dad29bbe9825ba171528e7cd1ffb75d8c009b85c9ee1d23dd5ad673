    if (!S.watch) {
      /* the screen can close without the back key (HOME, another screen):
         the pad goes back to the console as soon as this screen is gone */
      S.watch = setInterval(function () { if (!onScreen()) closeSession(); }, 1000);
    }
    api('/padcal/pad').then(function (j) {
      if (gen !== S.gen || !onScreen()) return;
      var d = dataOf(j);
      if (!d) {
        setState('old');
