  function message(title, text, retry) {
    var r = $('pcal');
    if (!r) return;
    r.innerHTML = headHTML(title, '') +
      '<div class="zkcard"><p class="pcal-msg">' + esc(text) + '</p>' +
      (retry ? '<div class="pcal-row" style="margin-top:12px"><button type="button" class="btn" id="pcal-again">Check again</button></div>' : '') +
      '</div>' + help();
