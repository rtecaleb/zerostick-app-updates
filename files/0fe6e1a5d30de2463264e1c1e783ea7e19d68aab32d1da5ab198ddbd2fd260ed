<script>
  // The gboot() function is auto-called when the core.js module loads

  // ── Update Mode (reachable from the language dropdown) ─────────────────
  //  Shows a "you probably don't need this" warning, then opens the board's
  //  firmware update page (PIN-protected, has its own Back button).
  window.zsUpdateMode = function () {
    // NOTE: this draws its own warning panel instead of using confirm(),
    // because the captive-portal mini browser on iPhone/Android silently
    // BLOCKS confirm()/alert() popups (tapping would just do nothing).
    var old = document.getElementById('zsUpdModal');
    if (old) old.remove();
    var d = document.createElement('div');
    d.id = 'zsUpdModal';
    d.style.cssText = 'position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;padding:20px;';
    d.innerHTML = '<div style="background:#fff;color:#222;border-radius:12px;max-width:340px;padding:22px;text-align:center;">' +
      '<h5 style="margin-top:0">UPDATE MODE</h5>' +
      '<p>This is for <b>firmware updating ONLY</b>.<br>Ignore this unless a firmware update is needed.</p>' +
      '<button id="zsUpdGo" style="background:#0d6efd;color:#fff;border:0;border-radius:8px;padding:12px 26px;margin:6px;font-size:1em;">Continue</button>' +
      '<button id="zsUpdNo" style="background:#6c757d;color:#fff;border:0;border-radius:8px;padding:12px 26px;margin:6px;font-size:1em;">Back</button></div>';
    document.body.appendChild(d);
    document.getElementById('zsUpdNo').onclick = function () { d.remove(); };
    document.getElementById('zsUpdGo').onclick = function () {
      window.location.href = 'http://192.168.4.1/update';
    };
  };
</script>
