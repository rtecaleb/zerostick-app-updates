/* sections/12-translation.js — the Translation tab (D164, D178, D275).
 *
 * R.translation, top to bottom (D337, owner 2026-10-14; was D275): TWO
 * sections.
 *   BEHAVIOR SIMULATION  one card: Left stick movement, Right stick look,
 *                        and Script timing beside the Scripts picture
 *                        (11-kbmove-behavior.js behaviorHTML; it was two
 *                        sections, "Natural timing" the second); then, on
 *                        a mouse config, Keyboard movement (D375, from the
 *                        Aim page): an EXO's door to R.kbmove, a Core's one
 *                        stickMerge choice (trKbHTML)
 *   CALIBRATION          the Game translator card (which translator the
 *                        mouse uses: the game's measured model from its
 *                        pack, zs-aim-model.js, or the standard one; Restore
 *                        swaps resolvedAimModel with previousAimModel) with
 *                        Sync to game (the game's frame rate, D164), the
 *                        in-game settings to match, Velocity calibration (the
 *                        customer's, D284), and the "DEV ONLY — USE FOR
 *                        LOGIC" fold holding the owner's curve calibration
 *                        (Calibrate, D172) and the Manual calibration (D181)
 *                        (13-calibrate.js and 14-manual-cal.js, hung off
 *                        trWire). The fold is still the gate: shut by
 *                        default, red, "for the ZeroStick team".
 * The Speed curve, Smoothness and
 * Start-up feel live on the Aim page's mouse card (10-aim.js), the in-game
 * deadzone is a calibration's to measure (D172, D284).
 *
 * Screens (window.RENDERERS):  R.translation
 * Tests:                      test-translation-tab.js, test-aim-model.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('translation', function (SEC) {
  /* from the files before this one */
  var B = SEC.B, card = SEC.card, esc = SEC.esc, R = SEC.R,
      seg = SEC.seg, sh = SEC.sh, ZS = SEC.ZS, note = SEC.note,
      behaviorHTML = SEC.behaviorHTML, helpHTML = SEC.helpHTML,
      door = SEC.door, wireDoors = SEC.wireDoors, behaviorWire = SEC.behaviorWire;
  /* from files after this one, bound once every file has run (never used
     while this file is loading) */
  var calWire, velWire, openCoreVcal, msWire, msStored;
  ZS_SECTIONS.after(function () {
    calWire = SEC.calWire;
    velWire = SEC.velWire;
    openCoreVcal = SEC.openCoreVcal;
    /* D397: Measure this game (13b-measure.js) */
    msWire = SEC.msWire;
    msStored = SEC.msStored;
  });

  /* ── Translation (D164, reordered D275, regrouped D337) — "how the mouse
     becomes a stick in THIS game". On a Core it stands where Screen Assist
     stood (that row is hidden there, not deleted: PRODUCTS.core.lacks
     'visionMenu'). D337 (owner, 2026-10-14): two section headers, no more:
     "Behavior simulation" and "Calibration"; each part of Calibration names
     itself with a title inside its own card (trCardTitle), not a header.
       Behavior          Left stick movement, Right stick look, and Script
                         timing in ms beside the Scripts picture (D163,
                         D275, D337) - first, the owner's call
     CALIBRATION:
       Game translator   which game's aim model runs (a game pack's aimModel,
                         docs/AIM-MODEL.md), switched on or back to the
                         standard one in one tap, and Sync to game (the
                         game's own stick rate, which the pack names: the
                         "what fps do you play at" the owner asked about;
                         zs_mouse.c averages the output over one game frame,
                         nothing else reads it, D337)
       Set these in game the in-game settings the model assumes, plainly
       Velocity calibration  the customer's (D284): the dead zone and the
                         speed at their sensitivity, the curve kept
       DEV ONLY fold     the owner's curve calibration (D172) and the
                         Manual calibration (D181), shut by default
     D275 took the "More translation settings" fold apart, one home per
     field: Smoothness was mouseTranslation.smoothing, the SAME field the Aim
     page's Smoothing presets and Custom Precision write, so it is only
     there; the Speed curve (mouseTranslation.curve / curvePoints /
     curveGrid) fought the Aim page's Hip curve buttons for the same fields,
     so the grid editor replaced those buttons on the Aim page's mouse card;
     Start-up feel (restEaseMs) sits beside Feel on that card, the start of
     a movement beside its stop. The In-game deadzone stepper is gone: the
     field (mouseTranslation.gameDeadzone) stays in saved configs and the
     encoders still honour it (withGameDeadzone), but Calibrate measures the
     zone and a measured translator ignores a typed one. No unit or maths
     word on any label. */
  /* D178: mouseTranslation.previousAimModel is the translator "Use this
     translator" replaced: the resolved model it carried, or 'standard' when
     the config ran the standard one. Restore swaps the two, so a second tap
     puts the calibrated one back. */
  /* a translator's name as a player reads it: the first BO2 measurement was
     named for the owner's own run */
  /* D402: a stored name from before the rename reads without XIM */
  function trName(s){
    var t = String(s).replace("measured on the owner's game", 'measured');
    return (window.ZSAIMMODEL && ZSAIMMODEL.displayName) ? ZSAIMMODEL.displayName(t) : t;
  }
  function trPrevName(prev){
    return (prev && typeof prev === 'object') ? trName(prev.name || 'game translator') : 'standard';
  }
  function trSwapPrevious(f){
    if(!f.mouseTranslation) f.mouseTranslation = {};
    var mt = f.mouseTranslation, prev = mt.previousAimModel;
    var cur = (mt.resolvedAimModel && typeof mt.resolvedAimModel === 'object') ? mt.resolvedAimModel : 'standard';
    if(prev === undefined || prev === null) return false;
    if(prev && typeof prev === 'object') mt.resolvedAimModel = prev;
    else delete mt.resolvedAimModel;
    mt.previousAimModel = cur;
    return true;
  }
  /* D394: a pack may carry one translator per in-game curve option
     (aimVariants). The model is the variant this config runs (by its
     numbers, for its console), else the pack's default. */
  function trModelOf(p, mt){
    var pk = (window.ZSPACKS && ZSPACKS.ofConfig) ? ZSPACKS.ofConfig(p) : null;
    /* D397: a translator this player's Core MEASURED on their own game
       (Measure this game, at their settings, on this console) is the
       game's translator from then on, ahead of the pack's: the packs'
       numbers are published settings and XIM's tables (D394), estimates
       of this player's game. The pack's variants stay one tap away. */
    var mine = (pk && msStored) ? msStored(pk.id, p.platform) : null;
    if(mine) return { pack: pk, model: mine.model, variant: null, onDevice: true };
    if(!(pk && pk.aimModel)) return null;
    if(mt === undefined){
      var full = (ZS.live && ZS.live.online!==false && ZS.live.full) ? ZS.live.full[p.id] : null;
      mt = (full && full.mouseTranslation) || {};
    }
    var v = (window.ZSAIMMODEL && ZSAIMMODEL.activeVariant) ? ZSAIMMODEL.activeVariant(pk, mt, p.platform) : null;
    return { pack: pk, model: v ? v.aimModel : pk.aimModel, variant: v };
  }
  /* D394: "Your aim curve in the game": one button per variant, the running
     one pressed; a tap puts that variant's translator on */
  function trVariantsHTML(found, p, mt){
    var vs = (found && window.ZSAIMMODEL) ? ZSAIMMODEL.variantsOf(found.pack) : [];
    if(vs.length < 2) return '';
    var act = ZSAIMMODEL.activeVariant(found.pack, mt, p.platform);
    var setting = vs[0].setting || 'Aim curve';
    return '<div class="trvar" role="group" aria-label="'+esc(setting)+' in the game" style="margin:12px var(--sp-3,16px) 0">'+
      '<div class="xsub" style="margin-bottom:6px">'+esc(setting)+' in the game</div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:8px">'+
      vs.map(function(v){
        var on = !!act && act.key === v.key;
        return '<button type="button" class="btn '+(on?'primary':'ghost')+'" data-trvar="'+esc(v.key)+'" aria-pressed="'+
          (on?'true':'false')+'" style="flex:1 1 0;width:auto;min-width:88px;margin:0;padding-left:8px;padding-right:8px">'+
          esc(v.label)+'</button>';
      }).join('')+'</div></div>';
  }
  /* D394: each sight's aiming speed beside the reference sight's */
  function trSightsHTML(model){
    if(!(model && Array.isArray(model.sights) && model.sights.length)) return '';
    return card(trCardTitle('Sight speeds')+model.sights.map(function(s){
        return '<div class="stat"><span>'+esc(s.name)+'</span><b>'+Math.round(s.adsScale*100)+' %</b></div>';
      }).join('')+
      helpHTML('tr-sights', 'Sight speeds', 'How fast the game turns while aiming through each sight, '+
        'as a share of the first one, at the field of view in Set these in the game. '+
        'Your Core cannot see which sight is up, so it aims as the first one; a zoomed sight turns slower in the game itself.'));
  }
  /* D337: a part of the Calibration section names itself inside its card,
     so the screen carries one "Calibration" header, not four */
  function trCardTitle(t){
    return '<div class="trcard-title" style="padding:13px var(--sp-3,16px) 2px;font-weight:650;'+
      'font-size:15px;letter-spacing:var(--tr-body,0);color:var(--text)">'+esc(t)+'</div>';
  }
  /* D337 (owner, 2026-10-14: "select what fps you are playing the game at,
     idk why you need to know that"): the answer, first in the "?", the
     sentences that were already there kept after it */
  var TR_SYNC_HELP =
    'Why it asks: a game reads your stick once per frame, 60 or 120 times a second. '+
    'Set this to the frame rate you play at and your Core averages your mouse over each frame, '+
    'so the game sees the whole frame\u2019s movement instead of a random slice of it. '+
    'Off is fine for most players. It only changes this smoothing: calibration and the translator do not use it. '+
    'Matches how often the game reads the stick. '+
    'Evens out tiny steps the game would otherwise catch at random. '+
    'Adds about half a frame of delay, and never costs distance: a movement still turns all the way. '+
    'This is the one frame-sync setting: it replaced Classic smoothing\u2019s Synch on the Aim page.';
  /* D375 (owner, 2026-10-14: "you have a lot of options, like WASD feel
     too, in Aim that don't belong there; that's already in Translation"):
     KEYBOARD MOVEMENT (WASD walking, keyboardMovement.*, R.kbmove) moved
     here from the Aim page's ••• fold, under Behavior simulation, whose
     Left stick movement is the walk's feel. Only on a config with a mouse
     (where Aim offered it). On a Core only stickMerge of that block runs
     (zs_apply.h KBDMOVE_RAMP: the ramp is not ported), so a Core gets that
     one choice here, its words behind the "?", and no door to a screen of
     sliders that would do nothing; an EXO gets the door, unchanged. Same
     field, same map as R.kbmove's own control, so the two cannot disagree. */
  var TR_KB_MERGE_HELP =
    'Only matters when a controller is plugged in too, and you walk with the keyboard. '+
    '<b>Whichever is pushed further</b> stops a resting controller stick bending your walk; '+
    '<b>Add them together</b> lets the two fight. '+
    'How smoothly the keys walk is <b>Left stick movement</b> above.';
  function trKbHTML(p){
    if(!ZS.inputShows(p.input, 'mouse')) return '';
    if(ZS.mnkConnected() === false){
      return card(trCardTitle('Keyboard movement').replace('class="trcard-title"', 'class="trkb-title"')+
        ZS.mnkTagHTML()+ZS.mnkOffHTML('Keyboard movement settings'));
    }
    if(ZS.productHides && ZS.productHides('kbmoveRamp')){
      /* its own title class: trcard-title names Calibration's parts */
      return card(trCardTitle('Keyboard movement').replace('class="trcard-title"', 'class="trkb-title"')+
        seg('If a controller stick is plugged in too', ['Whichever is pushed further','Add them together'], 0, false,
          B('keyboardMovement.stickMerge', 1,
            {t:'str', map:{'Whichever is pushed further':'strongest','Add them together':'sum'}}))+
        helpHTML('tr-kbmerge', 'Keyboard movement', TR_KB_MERGE_HELP));
    }
    return door('kbmove', 'Keyboard Movement', 'Keyboard movement',
      'smooth WASD walking — run ramp, diagonals, turn assist', 'keycap');
  }
  R.translation = function(p){
    var full = (ZS.live.online!==false ? ZS.live.full[p.id] : null) || {};
    var mt = full.mouseTranslation || {};
    var found = trModelOf(p, mt);
    var model = found && found.model;
    var on = !!(model && window.ZSAIMMODEL && ZSAIMMODEL.isActive(model, mt, p.platform));
    var carried = mt.resolvedAimModel;
    var using = on ? model.name
      : (carried && typeof carried === 'object' && carried.name) ? carried.name
      : 'Standard (works with any game)';
    /* the first BO2 measurement was named for the owner's own run; a
       customer reads "your game" */
    using = trName(using);
    var older = !!(model && window.ZSAIMMODEL && ZSAIMMODEL.isOlder && ZSAIMMODEL.isOlder(model, mt, p.platform));
    var unsure = on ? model.needsCalibration : !!(carried && carried.needsCalibration);
    /* D258 (owner, 2026-10-09: "the Translation tab has a whole lot of
       explanations that should be in question marks instead that open up"):
       every sentence that explains is behind a "?" (D236); what is left on
       the screen is the controls and their values */
    var h =
      /* D275: Behavior simulation first (owner); D337: Natural timing's
         Script timing is inside it */
      behaviorHTML(p)+
      /* D375: Keyboard movement, from the Aim page */
      trKbHTML(p)+
      /* D337 (owner): the Game translator, the frame rate, Velocity
         calibration and Curve calibration are ONE group, "Calibration" */
      /* 2026-10-22 (owner: "for calibration say all those settings in red,
         this is really advanced, not recommended unless you know what you
         are doing ... a clear gap between the simulation / translation
         stuff and the calibration settings") */
      '<div class="tr-adv" id="tr-adv">'+
      sh('Calibration')+
      '<div class="tr-advhead"><span class="tr-advbang" aria-hidden="true">!</span>'+
        '<div class="tr-advsay"><b>Advanced.</b> This is really advanced. Not recommended unless you know what you are doing.</div></div>'+
      card(trCardTitle('Game translator')+
        '<div class="stat"><span>Using</span><b id="tr-using">'+esc(using)+'</b></div>'+
        (model && !on
          ? '<button class="btn primary" id="tr-use" style="margin-top:10px">'+
              (older ? 'Update to the latest '+esc(found.pack.name)+' translator'
                     : 'Use the '+esc(found.pack.name)+' translator')+'</button>'
          : '')+
        (on || (carried && typeof carried === 'object')
          ? '<button class="btn ghost" id="tr-standard" style="margin-top:10px">Use the standard translator instead</button>'
          : '')+
        /* D178: the translator a calibration replaced, one tap back */
        (mt.previousAimModel !== undefined && mt.previousAimModel !== null
          ? '<button class="btn ghost" id="tr-restore" style="margin-top:10px">Restore previous translator ('+
              esc(trPrevName(mt.previousAimModel))+')</button>'
          : '')+
        trVariantsHTML(found, p, mt)+
        helpHTML('tr-what', 'Game translator', 'How your mouse becomes a stick in this game.'+
          (!model && !on ? ' There is no game translator for this game yet, so the standard one is used.' : '')+
          (unsure ? ' Its numbers come from published game settings and player measurements. '+
            'Velocity calibration needs a game whose curve has been measured.' : ''))+
        /* D164 Synchronize: the game's own stick rate is a property of the
           game, which the pack names, so it stays with the translator */
        seg('Sync to game', ['Off', '60', '120'], 0, false,
          B('mouseTranslation.syncHz', 1, {t:'str', map:{'Off':0, '60':60, '120':120}}),
          (model && model.stickHz ? 'this game: '+model.stickHz : ''))+
        helpHTML('tr-sync', 'Sync to game', TR_SYNC_HELP))+
      ((model && model.gameSettings && model.gameSettings.length)
        ? card(trCardTitle('Set these in the game')+model.gameSettings.map(function(g){
            return '<div class="stat"><span>'+esc(g.setting)+'</span><b>'+esc(g.value)+'</b></div>';
          }).join(''))
        : '')+
      trSightsHTML(model)+
      /* MEASURE THIS GAME (D397): the Core drives the stick through a sweep
         and measures the whole curve itself (13b-measure.js msWire fills
         it); above Velocity calibration, which only rescales a curve */
      card(trCardTitle('Measure this game')+
        '<div id="tr-measure" aria-live="polite" style="padding:4px var(--sp-3,16px) 12px">'+
        '<div class="xsub">Checking whether this Core can measure games…</div></div>')+
      /* VELOCITY CALIBRATION (D284, the customer's): the game's curve is
         already measured (the preset's, or a curve calibration's); the Core
         measures only the dead zone and how fast this player's sensitivity
         turns, and scales the curve to it. Greyed, with one sentence, when
         the game's curve has not been measured. velWire fills it. */
      card(trCardTitle('Velocity calibration')+
        '<div id="tr-velocity" aria-live="polite" style="padding:4px var(--sp-3,16px) 12px">'+
        '<div class="xsub">Checking whether this Core can calibrate…</div></div>'+
        /* D186: a mouse config's DPI under 3200 (or not known) gets the
           owner's advice here too, OUTSIDE #tr-velocity (velWire refills
           that), because a calibration's numbers are only as fine as the
           mouse's steps. A note, never a block. */
        ((ZS.inputShows(p.input, 'mouse') && window.ZS_DPI && ZS_DPI.wantsAdvice(mt.dpi))
          ? '<div id="tr-dpiadvice" style="padding:0 var(--sp-3,16px) 12px">'+helpHTML('tr-dpi', 'Mouse DPI', esc(ZS_DPI.advice))+'</div>'
          : ''))+
      trDevFold()+
      '</div>';
    return { html: h, after: function(root){ trWire(root, p, found, trMeasured(found, mt, p.platform)); } };
  };

  /* D284 (owner, 2026-10-13): CURVE CALIBRATION IS THE OWNER'S. The full
     Calibrate (D172, it measures the curve's shape) and the Manual
     calibration (D181) sit in ONE fold, closed by default, its header in
     the error red: "DEV ONLY — USE FOR LOGIC". The owner runs them once per
     game at a LOW in-game sensitivity and ships the curve in the game
     preset; customers use Velocity calibration above. The fold is open or
     shut per viewer (localStorage, as D281's Scripts list: storage that is
     missing or throws just means shut). The title row is a real button
     (aria-expanded), the body a `hidden` region. */
  var DEV_FOLD_KEY = 'zs.devCalOpen';
  function trDevOpen(){
    try { return window.localStorage.getItem(DEV_FOLD_KEY) === '1'; } catch (x) { return false; }
  }
  function trDevSet(open){
    try { window.localStorage.setItem(DEV_FOLD_KEY, open ? '1' : '0'); } catch (x) {}
  }
  /* D284 follow-up (owner, 2026-10-13): the fold STAYS where customers can
     see it (the product launches as a beta), but it must be unmistakably
     not theirs. Under the red header, shown even when it is shut, one plain
     line says who it is for and what to use instead; inside, before the
     tools, a plain warning (an answer to the tap that opened the fold, so
     a full block, D70) that a run replaces the game's curve, can make aim
     worse, and that Restore (the Game translator card's "Restore previous
     translator", which both runs feed through previousAimModel) puts the
     old one back. */
  var DEV_FOLD_WHO = 'For the ZeroStick team. Not needed to play: use Velocity calibration above.';
  var DEV_FOLD_WARN = 'Running these replaces this game’s aim curve and can make your aim worse. '+
    'To undo it, tap Restore previous translator under Game translator.';
  function trDevFold(){
    var open = trDevOpen();
    /* the house danger card (zs-fixes.css .acc[data-key=danger]): a red
       edge, and the header in --red-ink, the red made to be read as text
       (--red itself is 3.8:1 on a dark card, under AA) */
    return '<div class="grp-card trdev" id="tr-dev" style="border-color:rgba(207,63,69,.48);'+
        'border-left:3px solid var(--btn-3-bg,#cf3f45)">'+
      '<button type="button" class="trdev-hd" id="tr-devhd" aria-controls="tr-devbody" aria-describedby="tr-devwho" aria-expanded="'+
        (open ? 'true' : 'false')+'" style="display:flex;align-items:center;justify-content:space-between;gap:12px;'+
        'width:100%;background:none;border:0;margin:0;padding:13px var(--sp-3,16px) 4px;font:inherit;'+
        'text-align:left;cursor:pointer;color:var(--red-ink)">'+
        /* D337: shut, the fold still names what it holds, so the
           Calibration group visibly carries Curve calibration beside
           Velocity calibration (the owner: "include velocity and curve
           together in that group"); the gate itself is unchanged */
        '<span style="display:flex;flex-direction:column;gap:3px;min-width:0">'+
          '<b style="color:var(--red-ink);letter-spacing:.02em">DEV ONLY — USE FOR LOGIC</b>'+
          '<span class="trdev-what" style="color:var(--text);font-weight:650;font-size:15px">Curve calibration</span></span>'+
        '<i class="trdev-chev" aria-hidden="true" style="font-style:normal;color:var(--muted);flex:none;'+
          'transition:transform var(--t-quick,170ms) var(--ease-settle,ease-out);'+
          'transform:rotate('+(open ? 90 : 0)+'deg)">›</i></button>'+
      '<div class="xsub" id="tr-devwho" style="padding:0 var(--sp-3,16px) 13px">'+esc(DEV_FOLD_WHO)+'</div>'+
      '<div id="tr-devbody" class="trdev-body"'+(open ? '' : ' hidden')+'>'+
        '<div id="tr-devwarn" style="padding:0 var(--sp-3,16px) 4px">'+note(esc(DEV_FOLD_WARN), 'warn', true)+'</div>'+
        /* CALIBRATE (D172): the Core turns the game's camera itself,
           watches its capture card, and writes this game's model in the
           same format (docs/AIM-MODEL.md), the game's deadzone included.
           The card fills itself from /calibrate/status (calWire); until
           then it says it is looking. */
        trCardTitle('Curve calibration')+
        '<div id="tr-calibrate" aria-live="polite" style="padding:4px var(--sp-3,16px) 12px">'+
          '<div class="xsub">Checking whether this Core can calibrate…</div></div>'+
        /* MANUAL CALIBRATION (D181): back, in the fold (D284). It was taken
           off this screen on 2026-10-01 ("the user will just run
           Calibrate"); its sheet and the Core's routes never left. */
        trCardTitle('Manual calibration')+
        '<div style="padding:4px var(--sp-3,16px) 14px">'+
          '<button class="btn ghost" id="tr-vcal">Manual calibration</button></div>'+
      '</div></div>';
  }
  function trDevWire(root){
    var hd = root.querySelector('#tr-devhd'), body = root.querySelector('#tr-devbody');
    if(!hd || !body) return;
    hd.addEventListener('click', function(){
      var open = hd.getAttribute('aria-expanded') !== 'true';
      hd.setAttribute('aria-expanded', open ? 'true' : 'false');
      if(open) body.removeAttribute('hidden'); else body.setAttribute('hidden', '');
      var ch = hd.querySelector('.trdev-chev');
      if(ch) ch.style.transform = 'rotate('+(open ? 90 : 0)+'deg)';
      trDevSet(open);
    });
  }
  /* D284: the game's MEASURED curve, as a resolved model, or null: the
     config's own translator when it is measured (a preset's or a curve
     calibration's, needsCalibration false), else the game preset's model
     when that one is measured. Velocity calibration scales nothing else. */
  function trMeasured(found, mt, platform){
    var r = mt && mt.resolvedAimModel;
    if(r && typeof r === 'object' && r.needsCalibration === false && r.generic !== true &&
       r.hip && typeof r.hip === 'object') return r;
    if(found && found.model && found.model.needsCalibration === false && window.ZSAIMMODEL){
      var rm = ZSAIMMODEL.resolve(found.model, mt || {}, platform);
      if(rm && rm.hip) return rm;
    }
    return null;
  }

  function trWire(root, p, found, measured){
    trDevWire(root);
    /* D375: the Keyboard Movement door (an EXO's) */
    wireDoors(root, p);
    /* D376: Behavior simulation's stick carousel and its low-value chips */
    behaviorWire(root);
    if(msWire) msWire(root, p, found);
    velWire(root, p, found, measured);
    calWire(root, p, found);
    /* D181: the manual calibration, under Calibrate */
    var vc = root.querySelector('#tr-vcal');
    if(vc) vc.addEventListener('click', function(){ openCoreVcal(p, found); });
    var use = root.querySelector('#tr-use');
    if(use) use.addEventListener('click', function(){
      use.disabled = true;
      ZS.putProfileDebounced(p.id, function(f){
        if(!f.mouseTranslation) f.mouseTranslation = {};
        var rm = ZSAIMMODEL.resolve(found.model, f.mouseTranslation, p.platform);
        if(rm) f.mouseTranslation.resolvedAimModel = rm;
        /* the player's choice: the D394 migration never overrides it */
        if(rm && ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(f.mouseTranslation, 'game translator', found.variant ? found.variant.key : '');
      });
      if(ZS.toast) ZS.toast(found.pack.name+' translator on');
      setTimeout(function(){ if(ZS.redrawOpenScreen) ZS.redrawOpenScreen(); }, 900);
    });
    /* D394: a variant's button puts that variant's translator on */
    root.querySelectorAll('[data-trvar]').forEach(function(b){
      b.addEventListener('click', function(){
        if(!found || b.getAttribute('aria-pressed') === 'true') return;
        var key = b.getAttribute('data-trvar');
        var v = ZSAIMMODEL.variantsOf(found.pack).filter(function(x){ return x.key === key; })[0];
        if(!v) return;
        b.disabled = true;
        ZS.putProfileDebounced(p.id, function(f){
          if(!f.mouseTranslation) f.mouseTranslation = {};
          var rm = ZSAIMMODEL.resolve(v.aimModel, f.mouseTranslation, p.platform);
          if(rm) f.mouseTranslation.resolvedAimModel = rm;
          /* the in-game curve the player picked (aimVariant), kept */
          if(rm && ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(f.mouseTranslation, 'in-game curve '+v.label, v.key);
        });
        if(ZS.toast) ZS.toast(found.pack.name+' translator on: '+v.label);
        setTimeout(function(){ if(ZS.redrawOpenScreen) ZS.redrawOpenScreen(); }, 900);
      });
    });
    var rst = root.querySelector('#tr-restore');
    if(rst) rst.addEventListener('click', function(){
      rst.disabled = true;
      ZS.putProfileDebounced(p.id, function(f){
        if(trSwapPrevious(f) && ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(f.mouseTranslation, 'restore previous translator');
      });
      if(ZS.toast) ZS.toast('Previous translator back on');
      setTimeout(function(){ if(ZS.redrawOpenScreen) ZS.redrawOpenScreen(); }, 900);
    });
    var std = root.querySelector('#tr-standard');
    if(std) std.addEventListener('click', function(){
      std.disabled = true;
      ZS.putProfileDebounced(p.id, function(f){
        if(f.mouseTranslation){
          delete f.mouseTranslation.resolvedAimModel;
          if(ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(f.mouseTranslation, 'standard translator');
        }
      });
      if(ZS.toast) ZS.toast('Standard translator on');
      setTimeout(function(){ if(ZS.redrawOpenScreen) ZS.redrawOpenScreen(); }, 900);
    });
  }

  /* what the other screen files use from this one */
  SEC.trModelOf = trModelOf;
  SEC.trName = trName;
  SEC.trMeasured = trMeasured;
  SEC.trSwapPrevious = trSwapPrevious;
});
