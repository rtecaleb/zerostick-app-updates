          'Copied '+pack.id+'’s max-sens speeds. Paste them to Claude, or run set-pack-aim-model.js --speeds.',
          'Copy failed — this device did not allow it');
      });
    }
    function copyForPreset(d){
      var b = box.querySelector('#cal-copy'), say = box.querySelector('#cal-preset-say');
      if(b) b.disabled = true;
      ZS.api('/calibrate/model').then(function(j){
        if(!alive()) return;
        if(b) b.disabled = false;
        var got = calPackModel(j && j.ok ? j.data : null, pack, d, new Date().toISOString().slice(0, 10));
        if(got.problem){
          if(say) say.innerHTML = note(esc(got.problem), 'warn', true);
          return;
        }
        if(say) say.textContent = '';
        copyText(JSON.stringify(got.model, null, 2)+'\n',
          'Copied '+pack.id+'’s curve. Paste it to Claude, or run set-pack-aim-model.js.',
          'Copy failed — this device did not allow it');
