/* sections/13-calibrate.js — Calibrate: the Core measures the game itself (D172, D178, D187),
 * and Velocity calibration, the customer's (D284).
 *
 * D284 (owner, 2026-10-13): Calibrate is the owner's CURVE calibration, in
 * the Translation tab's "DEV ONLY — USE FOR LOGIC" fold; velWire is the
 * customer's card above it: POST /calibrate/start {mode:"velocity", the
 * measured curve's points}, the same status / model / cancel routes, and
 * "Use these speeds" writes the measured dead zone and turn rates into the
 * measured model it started from (velApply), the old one kept for Restore.
 * Each card shows only its own mode's run (status.mode).
 *
 * calWire: start, cancel and poll a calibration on the Core, show its phases
 * (CAL_PHASE) and what it found (calLawLines: the turn ramp and the diagonals),
 * and "Use it", which writes mouseTranslation.resolvedAimModel and keeps the
 * old one as previousAimModel. Firmware: main/zs_run_calib.c, components/zs_calib.
 *
 * After a curve calibration, "Copy for the game preset" (D284) copies the
 * Core's model as a game pack's aimModel (calPackModel) for
 * tools/set-pack-aim-model.js to write into game-packs/<id>.json.
 *
 * Also offers on ZS:          ZS.calLawLines, ZS.calPackModel
 * Core / board routes:        /calibrate/cancel, /calibrate/model, /calibrate/start,
 *                             /calibrate/status
 * Tests:                      test-translation-tab.js (against fixtures/core-calib.json and
 *                             core-calib-velocity.json), test-set-pack-aim-model.js
 *
 * D218: in GPC mode and in EXO Studio's mode the Core's capture is parked
 * and it refuses every calibration start (409 "Switch to normal mode to
 * calibrate."), so the card says that and offers no start (calParked).
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('calibrate', function (SEC) {
  /* from the files before this one */
  var esc = SEC.esc, note = SEC.note, ZS = SEC.ZS, trName = SEC.trName,
      trMeasured = SEC.trMeasured, trSwapPrevious = SEC.trSwapPrevious, helpHTML = SEC.helpHTML,
      copyText = SEC.copyText, txtFld = SEC.txtFld;

  /* ── CALIBRATE (D172) ─────────────────────────────────────────────
     The Core runs the whole thing: it levels the view, turns it at about
     forty stick positions, times whole turns, looks up and down, does the
     same aiming down sights, and fits the model (components/zs_calib). This
     card asks, follows (GET /calibrate/status every 600 ms while it is on
     screen), shows the numbers, and on "Use this translator" fetches
     /calibrate/model and saves it as the config's translator through the
     same resolve() a game pack's model goes through. */
  /* THE OWNER'S ORDER (D178, docs/AIM-MODEL.md "How Calibrate measures"):
     1 the floor and the sky, 2 timing floor to sky, 3 level, 4 the dead zone,
     5 turning, 6 up-and-down speed, 7 all of it aiming down sights, 8 level
     and let go. The words say which, plainly. */
  var CAL_PHASE = {
    rest: 'Getting ready', noise: 'Watching the picture hold still',
    clamp: 'Finding the floor and the sky', sweep: 'Timing floor to sky',
    level: 'Levelling the view', yaw: 'Turning', turn360: 'Timing full turns',
    ramp: 'Turning at full stick', diag: 'Checking the dead zone\u2019s shape',
    dzprobe: 'Finding the dead zone', dzfine: 'Finding the dead zone', dzconfirm: 'Checking the dead zone again',
    pitch: 'Looking up and down', kick: 'Measuring recoil', 'return': 'Levelling the view',
    land360: 'Timing full turns',
    /* D187 */
    rhold: 'Timing the turn ramp', dburst: 'Checking diagonals'
  };
  function calPhase(d){
    var w = CAL_PHASE[d.kind] || 'Measuring';
    var x = Math.abs(d.rx || 0), y = Math.abs(d.ry || 0);
    if(d.kind === 'yaw' || d.kind === 'ramp' || d.kind === 'land360' || d.kind === 'rhold')
      w += ' at '+Math.round(x * 100)+'% stick';
    if(d.kind === 'dzprobe' || d.kind === 'dzfine' || d.kind === 'dzconfirm')
      w += (y > x ? ' (up and down)' : ' (left and right)')+' at '+Math.round(Math.max(x, y) * 100)+'% stick';
    if(d.kind === 'sweep') w = 'Looking down to the floor at '+Math.round(y * 100)+'% stick';
    if(d.kind === 'clamp') w = (d.ry < 0 ? 'Looking all the way down' : 'Looking all the way up');
    return (d.group === 1 ? 'Aiming down sights: ' : '')+w;
  }
  function calBar(frac){
    var pct = Math.max(0, Math.min(100, Math.round(frac * 100)));
    return '<div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="'+pct+
      '" style="height:8px;border-radius:4px;background:var(--line);overflow:hidden;margin:10px 0 6px">'+
      '<div style="height:100%;width:'+pct+'%;background:var(--accent);border-radius:4px;'+
      'transition:width .5s"></div></div>';
  }
  function calNum(v, dp){ var n = Number(v); return isFinite(n) ? n.toFixed(dp || 0) : '\u2013'; }
  /* D187: what Calibrate found about the game's TURN RAMP and HOW IT
     COMBINES THE TWO AXES (result.ramp, result.axes), one plain sentence
     each, "Label: what it means". Nothing when the Core did not measure it
     (or is older and does not say): an older Core's result has no such
     objects, and its card is unchanged. */
  function calLawLines(r){
    var out = [];
    if(!r || typeof r !== 'object') return out;
    var rp = r.ramp, ax = r.axes;
    if(rp && typeof rp === 'object' && rp.measured){
      out.push(rp.present
        ? 'Turn ramp: '+calNum(Number(rp.toFullMs) / 1000, 2)+' s to full speed ('+calNum(rp.gain, 2)+
          'x after holding) - corrected'
        : 'Turn ramp: none - nothing to correct');
    }
    if(ax && typeof ax === 'object' && ax.measured){
      var shape = { axial: 'square - diagonals corrected', radial: 'round',
        mixed: 'mixed (round + square) - diagonals corrected' }[ax.shape];
      if(shape) out.push('Dead zone shape: '+shape);
      var comb = { perAxis: 'each axis turns on its own - corrected',
        radial: 'turn like a circle - already right',
        unknown: 'the game\u2019s curve is straight there, so they already match' }[ax.combine];
      if(comb) out.push('Diagonals: '+comb);
    }
    return out;
  }
  ZS.calLawLines = calLawLines;
  function calLaw(r, dim){
    return calLawLines(r).map(function(t){
      var at = t.indexOf(': ');
      return '<div class="stat cal-law"><span>'+esc(t.slice(0, at))+'</span><b'+
        (dim ? ' style="opacity:.55"' : '')+'>'+esc(t.slice(at + 2))+'</b></div>';
    }).join('');
  }
  /* D218: GPC mode or EXO Studio has the Core's capture parked (the Core's
     own /status): no calibration can start, so none is offered */
  function calParked(){ return !!(window.ZSMODES && ZSMODES.parked && ZSMODES.parked()); }
  function calParkedHTML(){
    return '<div class="note" id="cal-parked" role="status" style="margin-top:10px">'+
      esc((window.ZSMODES && ZSMODES.CAL_PARKED) || 'Switch to normal mode to calibrate')+'</div>';
  }
  /* ── COPY FOR THE GAME PRESET (D284) ──────────────────────────────────
     The customer's help promises "The ZeroStick team measures each game once
     and adds it to the game's preset." After a curve calibration this turns
     the Core's model (GET /calibrate/model) into EXACTLY what a game pack's
     `aimModel` holds (cod-bo2.json's shape): the pack's id, a name for
     players, needsCalibration false, a first `sources` line with the date
     and the run's numbers, then the Core's own sources; the preset's
     gameSettings and stickHz when the Core's model has none. The owner pastes
     it to Claude, or saves it and runs tools/set-pack-aim-model.js, which
     checks it again and writes it into game-packs/<id>.json.
     Only the Core's model will do. A config's saved translator (resolve()'s
     form) cannot be turned back into a preset losslessly: it drops the
     sources, the in-game settings, the stick rate and the turn's climb
     (accel), and a velocity-calibrated one is scaled to one player. */
  var CAL_PRESET_GONE = 'Your Core no longer has this run’s curve. A config’s saved translator can’t '+
    'be turned back into a preset exactly (it keeps no record of the run), so run Curve calibration again '+
    'and copy straight after.';
  function calPackModel(m, pack, d, date){
    if(!m || typeof m !== 'object') return { problem: CAL_PRESET_GONE };
    if(!pack || !pack.id) return { problem: 'This config has no game preset to add the curve to.' };
    var words = [String(m.name || '')].concat((m.sources || []).map(function(s){ return String((s && s.what) || ''); }));
    if(words.some(function(w){ return /velocity calibrated/i.test(w); }))
      return { problem: 'Your Core’s last run was a velocity calibration, not a curve calibration. Run Curve calibration.' };
    if(m.id !== pack.id)
      return { problem: 'Your Core’s last run was for “'+String(m.id)+'”, not '+pack.name+
        '. Run Curve calibration on this config.' };
    if(m.needsCalibration !== false) return { problem: 'Your Core’s model is not a measured one.' };
    var old = (pack.aimModel && typeof pack.aimModel === 'object') ? pack.aimModel : null;
    var hip = m.hip || {}, ads = m.ads || {};
    var adsYaw = (ads.turnRate && ads.turnRate.yaw) || (ads.inherit === 'hip' && hip.turnRate ? hip.turnRate.yaw : null);
    var r = (d && d.result) || {};
    var bits = [];
    if(d && d.frames > 0) bits.push(d.frames+' capture frames');
    if(hip.turnRate) bits.push('full stick '+calNum(hip.turnRate.yaw, 1)+' deg/s, up and down '+calNum(hip.turnRate.pitch, 1));
    if(adsYaw) bits.push('aiming '+calNum(adsYaw, 1)+' deg/s');
    if(typeof hip.deadzone === 'number') bits.push('dead zone '+calNum(hip.deadzone * 100, 1)+' %');
    if(Number(r.hfov) > 0) bits.push('field of view '+calNum(r.hfov, 1)+' deg');
    var out = {
      format: m.format, id: pack.id,
      name: pack.name+', measured by the ZeroStick team',
      needsCalibration: false,
      sources: [{ what: 'Curve calibration for the game preset on '+date+' (D284, the DEV ONLY fold’s Curve '+
        'calibration, "Copy for the game preset"): '+bits.join(', ')+'. Velocity calibration scales it to each '+
        'player’s sensitivity.' }].concat(JSON.parse(JSON.stringify(m.sources || [])))
    };
    var gs = Array.isArray(m.gameSettings) && m.gameSettings.length ? m.gameSettings
      : (old && Array.isArray(old.gameSettings) && old.gameSettings.length ? old.gameSettings : null);
    if(gs) out.gameSettings = JSON.parse(JSON.stringify(gs));
    var hz = m.stickHz !== undefined ? m.stickHz : (old ? old.stickHz : undefined);
    if(hz !== undefined) out.stickHz = hz;
    out.hip = JSON.parse(JSON.stringify(m.hip));
    out.ads = JSON.parse(JSON.stringify(m.ads));
    var errs = window.ZSAIMMODEL ? ZSAIMMODEL.validate(out) : ['zs-aim-model.js did not load'];
    if(errs.length) return { problem: 'The measured curve is not usable: '+errs[0] };
    return { model: out };
  }
  ZS.calPackModel = calPackModel;

  /* ── COPY MAX-SENS SPEEDS FOR THE GAME PRESET (D284, the owner's plan) ──
     The preset ships at MAX in-game sensitivity, so a customer at max needs
     no calibration at all. The owner measures the curve's SHAPE at a low
     sensitivity (above: Copy for the game preset), then sets the game to max
     and runs Velocity calibration; after that run passes, the fold offers
     this. It carries the PRESET's measured shape (never the run's) with the
     run's dead zone and turn rates per mode, the sensitivity and dead zone
     the owner says it was measured at (gameSettings rows), and a dated
     source line, wrapped as {zerostickPresetSpeeds: 1, pack, measuredAt,
     aimModel} so tools/set-pack-aim-model.js knows it is SPEEDS for an
     existing shape. Refused: no measured curve in the preset yet (a velocity
     run is never a shape), another game's run, a run that scaled a different
     curve from the preset's (it was not started on the preset's shape), a
     missing sensitivity. */
  var CAL_SPEEDS_TAG = 'Max-sens speeds for the game preset';
  function calPts(m){
    var c = m && m.curve;
    return (c && c.type === 'points' && Array.isArray(c.points)) ? c.points : null;
  }
  function calMerged(model, name){
    var m = model && model[name] ? JSON.parse(JSON.stringify(model[name])) : {};
    if(name === 'ads' && m.inherit === 'hip' && model.hip){
      var out = JSON.parse(JSON.stringify(model.hip)), k;
      for(k in m){ if(k !== 'inherit') out[k] = m[k]; }
      return out;
    }
    return m;
  }
  function calSameCurve(a, b){
    var pa = calPts(a), pb = calPts(b);
    if(!pa || !pb) return JSON.stringify((a && a.curve) || null) === JSON.stringify((b && b.curve) || null);
    if(pa.length !== pb.length) return false;
    for(var i = 0; i < pa.length; i++){
      if(Math.abs(pa[i][0] - pb[i][0]) > 1e-3 || Math.abs(pa[i][1] - pb[i][1]) > 1e-3) return false;
    }
    return true;
  }
  /* a gameSettings row set to {setting, value}: the row whose name matches
     `re` (or the same name) takes the new value; none = a new row */
  function calSetRow(rows, re, row){
    if(!row || !row.value) return rows;
    var i, hit = -1;
    for(i = 0; i < rows.length; i++){
      if(rows[i].setting === row.setting || re.test(rows[i].setting)){ hit = i; break; }
    }
    if(hit >= 0) rows[hit] = { setting: rows[hit].setting, value: row.value };
    else rows.push({ setting: row.setting, value: row.value });
    return rows;
  }
  var CAL_SENS_RE = /sensitiv/i, CAL_DZ_RE = /dead ?zone/i;
  function calRowOf(pack, re){
    var gs = pack && pack.aimModel && Array.isArray(pack.aimModel.gameSettings) ? pack.aimModel.gameSettings : [];
    for(var i = 0; i < gs.length; i++) if(re.test(gs[i].setting)) return gs[i];
    return null;
  }
  function calSpeedsModel(vm, pack, d, date, at){
    if(!vm || typeof vm !== 'object') return { problem: 'Your Core no longer has this run’s speeds. Run Velocity calibration again and copy straight after.' };
    if(!pack || !pack.id) return { problem: 'This config has no game preset to add the speeds to.' };
    var old = pack.aimModel;
    if(!old || typeof old !== 'object' || old.needsCalibration !== false)
      return { problem: pack.name+'’s preset has no measured curve yet, and a velocity run is never a curve. '+
        'Run Curve calibration at a low sensitivity and add its shape to the preset first.' };
    if(vm.id !== pack.id)
      return { problem: 'Your Core’s last run was for “'+String(vm.id)+'”, not '+pack.name+'.' };
    var words = [String(vm.name || '')].concat((vm.sources || []).map(function(s){ return String((s && s.what) || ''); }));
    if(!words.some(function(w){ return /velocity calibrated/i.test(w); }))
      return { problem: 'Your Core’s last run was not a velocity calibration.' };
    var vh = calMerged(vm, 'hip'), va = calMerged(vm, 'ads');
    var adsMeasured = !(d && d.result && d.result.velocity && d.result.velocity.ads === false) &&
      !!(va.turnRate && typeof va.deadzone === 'number');
    var oh = calMerged(old, 'hip'), oa = calMerged(old, 'ads');
    var adsOwn = JSON.stringify([oa.deadzone, oa.curve, oa.turnRate]) !== JSON.stringify([oh.deadzone, oh.curve, oh.turnRate]);
    if(!calSameCurve(vh, oh) || (adsOwn && adsMeasured && !calSameCurve(va, oa)))
      return { problem: 'This run scaled a different curve from '+pack.name+'’s preset. Use the '+pack.name+
        ' translator on this config, then run Velocity calibration again.' };
    var sens = at && at.sensitivity, dz = at && at.deadzone;
    if(!sens || !String(sens.value || '').trim())
      return { problem: 'Say which in-game sensitivity this was measured at.' };
    if(!(vh.turnRate && typeof vh.deadzone === 'number')) return { problem: 'The run’s speeds are missing.' };
    var out = JSON.parse(JSON.stringify(old));
    out.hip.deadzone = vh.deadzone;
    out.hip.turnRate = { yaw: vh.turnRate.yaw, pitch: vh.turnRate.pitch };
    if(typeof vh.accel === 'number') out.hip.accel = vh.accel;
    var ay, ap, az;
    if(adsMeasured){ ay = va.turnRate.yaw; ap = va.turnRate.pitch; az = va.deadzone; }
    else if(adsOwn){
      /* aiming not measured this time: the same speed-up as hip (velApply) */
      ay = oa.turnRate.yaw * (oh.turnRate.yaw > 0 ? vh.turnRate.yaw / oh.turnRate.yaw : 1);
      ap = oa.turnRate.pitch * (oh.turnRate.pitch > 0 ? vh.turnRate.pitch / oh.turnRate.pitch : 1);
      az = vh.deadzone;
    }
    if(ay !== undefined && out.ads){
      out.ads.deadzone = az;
      out.ads.turnRate = { yaw: Math.round(ay * 10) / 10, pitch: Math.round(ap * 10) / 10 };
    }
    var rows = JSON.parse(JSON.stringify(old.gameSettings || []));
    calSetRow(rows, CAL_SENS_RE, { setting: String(sens.setting || 'Look sensitivity'), value: String(sens.value).trim() });
    if(dz && String(dz.value || '').trim())
      calSetRow(rows, CAL_DZ_RE, { setting: String(dz.setting || 'Stick dead zone'), value: String(dz.value).trim() });
    out.gameSettings = rows;
    var at1 = String(sens.setting || 'Look sensitivity')+' '+String(sens.value).trim()+
      (dz && String(dz.value || '').trim() ? ', '+String(dz.setting || 'Stick dead zone')+' '+String(dz.value).trim() : '');
    out.sources = [{ what: CAL_SPEEDS_TAG+': velocity calibration on '+date+' at '+at1+' (D284): dead zone '+
      calNum(vh.deadzone * 100, 1)+' %, full stick '+calNum(vh.turnRate.yaw, 1)+' deg/s, up and down '+
      calNum(vh.turnRate.pitch, 1)+(ay !== undefined ? ', aiming '+calNum(ay, 1)+' deg/s'+(adsMeasured ? '' : ' (scaled with hip)') : '')+
      '. The curve’s shape is the preset’s, kept; a player at this sensitivity needs no calibration.' }]
      .concat((vm.sources || []).filter(function(s){ return s && /velocity calibrated/i.test(String(s.what)); }))
      .concat((old.sources || []).filter(function(s){
        var w = String((s && s.what) || '');
        return w.indexOf(CAL_SPEEDS_TAG) !== 0 && !/^Velocity calibrated on device/i.test(w);
      }));
    var errs = window.ZSAIMMODEL ? ZSAIMMODEL.validate(out) : ['zs-aim-model.js did not load'];
    if(errs.length) return { problem: 'The measured speeds are not usable: '+errs[0] };
    return { model: {
      zerostickPresetSpeeds: 1, pack: pack.id,
      measuredAt: { sensitivity: { setting: String(sens.setting || 'Look sensitivity'), value: String(sens.value).trim() },
        deadzone: dz && String(dz.value || '').trim() ? { setting: String(dz.setting || 'Stick dead zone'), value: String(dz.value).trim() } : null },
      aimModel: out } };
  }
  ZS.calSpeedsModel = calSpeedsModel;

  function calWire(root, p, found){
    var box = root.querySelector('#tr-calibrate');
    if(!box) return;
    var timer = null;
    /* the config's game preset, with or without a curve yet (found is only
       a preset that already carries one): its id goes to the Core, so the
       model comes back named for the preset it belongs in (D284) */
    var pack = (found && found.pack) ||
      ((window.ZSPACKS && ZSPACKS.ofConfig) ? ZSPACKS.ofConfig(p) : null);
    var packId = pack ? (pack.id || 'game') : 'game';
    var gameName = pack ? pack.name : 'this game';
    function alive(){ return document.body.contains(box); }
    function later(ms){ clearTimeout(timer); timer = setTimeout(poll, ms); }
    function btn(id, cls, text){ return '<button class="btn '+cls+'" id="'+id+'" style="margin-top:10px">'+esc(text)+'</button>'; }
    function on(id, fn){ var b = box.querySelector('#'+id); if(b) b.addEventListener('click', fn); }
    function idle(extra){
      if(calParked()){
        box.innerHTML =
          helpHTML('cal-what', 'Calibrate', 'Measures '+esc(gameName)+' through your capture card, '+
            'so its translator turns exactly as far as your hand.')+calParkedHTML();
        return;
      }
      box.innerHTML =
        '<div class="xsub" style="margin-bottom:6px">About eight minutes.</div>'+
        helpHTML('cal-what', 'Calibrate', 'Measures '+esc(gameName)+' through your capture card, '+
          'so its translator turns exactly as far as your hand. About eight minutes.')+
        '<div class="stat"><span>1</span><b>Open a private match, alone, with nothing in your way</b></div>'+
        '<div class="stat"><span>2</span><b>Stand in open space with detail all round you (not up against a wall)</b></div>'+
        '<div class="stat"><span>3</span><b>Gun out, aim assist off, then don\u2019t touch the controller, mouse or keys</b></div>'+
        /* D275 (owner, 2026-10-10): "Your in-game deadzone (optional)" is
           gone - Calibrate measures the deadzone itself. A number typed
           before (mouseTranslation.gameDeadzone) stays in the config and
           the encoders still use it until a measured translator replaces
           it; it is no longer asked for or compared here. */
        (extra || '')+
        btn('cal-start', 'primary', 'Calibrate');
      on('cal-start', start);
    }
    /* D182: the first visible movement, when it differs from the measured
       zone (the game creeps just past its edge). D275 dropped the typed
       number's comparison with the Calibrate card's input. */
    function dzCheck(r){
      var m = Number(r.deadzone), lad = Number(r.zoneLadder);
      if(!isFinite(m)) return '';
      if(isFinite(lad) && lad > 0 && Math.abs(lad - m) >= 0.01)
        return '<div class="xsub" style="margin:6px 0">Dead zone found by carrying the turn rates down to '+
          'zero turn; the first visible movement was at '+calNum(lad * 100, 1)+'%, where the game barely creeps.</div>';
      return '';
    }
    /* THE OWNER (2026-10-01): a 3 second countdown before it starts, so
       there is time to take the hands off the controller and mouse. Leaving
       the screen during the countdown starts nothing. */
    function start(){
      var b = box.querySelector('#cal-start');
      if(b) b.disabled = true;
      var n = 3;
      function tick(){
        if(!alive()) return;
        if(n > 0){
          if(b) b.textContent = 'Hands off... ' + n;
          n--;
          setTimeout(tick, 1000);
          return;
        }
        if(b) b.textContent = 'Starting...';
        go();
      }
      tick();
    }
    function go(){
      ZS.api('/calibrate/start', 'POST', { id: packId, name: gameName+' (measured on your game)',
        date: new Date().toISOString().slice(0, 10) })
        .then(function(j){
          if(!alive()) return;
          if(!j || !j.ok){
            idle(note((j && j.error) || 'The Core did not start the calibration.', 'warn', true));
            return;
          }
          render(j);
          later(600);
        });
    }
    function useIt(){
      var b = box.querySelector('#cal-use');
      if(b) b.disabled = true;
      ZS.api('/calibrate/model').then(function(j){
        if(!alive()) return;
        var m = j && j.ok ? j.data : null;
        if(m && found && found.model && Array.isArray(found.model.gameSettings) &&
           (!m.gameSettings || !m.gameSettings.length)){
          m.gameSettings = found.model.gameSettings;   /* what the numbers assume in the game */
        }
        var errs = (m && window.ZSAIMMODEL) ? ZSAIMMODEL.validate(m) : ['no model'];
        if(errs.length){
          if(b) b.disabled = false;
          ZS.toast && ZS.toast('The measured model was not usable: '+errs[0]);
          return;
        }
        ZS.putProfileDebounced(p.id, function(f){
          if(!f.mouseTranslation) f.mouseTranslation = {};
          var rm = ZSAIMMODEL.resolve(m, f.mouseTranslation);
          if(!rm) return;
          /* D178: keep what it replaces, so Restore is one tap */
          var cur = f.mouseTranslation.resolvedAimModel;
          f.mouseTranslation.previousAimModel = (cur && typeof cur === 'object') ? cur : 'standard';
          f.mouseTranslation.resolvedAimModel = rm;
          if(ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(f.mouseTranslation, 'curve calibration');
        });
        ZS.toast && ZS.toast('Measured translator on');
