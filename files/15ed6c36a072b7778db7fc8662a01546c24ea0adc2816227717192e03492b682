    /* D178: A RUN THAT FAILED A CHECK is shown, said plainly, and never
       offered: the Core will not hand its model out either (409). */
    function rejected(d){
      var probs = Array.isArray(d.problems) && d.problems.length ? d.problems
        : [d.fitWhy || d.why || 'The calibration did not finish.'];
      box.innerHTML =
        '<div class="stat"><span>This run can\u2019t be used</span><b style="color:var(--amber)">Not saved</b></div>'+
        '<div class="xsub" style="margin:6px 0">'+esc(probs[0])+'</div>'+
        (probs.length > 1
          ? '<div class="xsub" style="margin-bottom:6px;opacity:.75">Also: '+probs.slice(1).map(esc).join(' ')+'</div>'
          : '')+
        note('Something blocked the view or moved. Stand in open space, aim assist off, don\u2019t touch '+
             'the controller, and try again. Your translator was not changed.', 'warn', true)+
        (d.result ? calRows(d.result, nowNumbers(), true)+calLaw(d.result, true)+dzCheck(d.result) : '')+
        (calParked() ? calParkedHTML() : btn('cal-again', 'primary', 'Measure again'));
