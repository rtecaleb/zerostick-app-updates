  /* ── VELOCITY CALIBRATION (D284) ─────────────────────────────────────
     The CUSTOMER's calibration. The owner measures each game's curve once
     (Curve calibration, in the DEV ONLY fold, at a low in-game sensitivity)
     and ships it in the game preset. A player's sensitivity and in-game
     dead zone are their own, so this measures only those: the dead zone,
     looks down and up, and turns at two sticks, about a minute (two with
     aiming down sights), and the Core SCALES the saved curve to them
     (POST /calibrate/start {mode:"velocity", the curve's points}). It never
     refits the curve's shape; when the game turns differently from its
     saved curve it still saves and says so.
     `measured` is the game's measured model (12-translation.js trMeasured):
     without one the card is greyed with one sentence and starts nothing. */
  var VEL_NONE = 'This game’s curve hasn’t been measured yet.';
  /* a mode's curve as the points the Core keeps: [share of the travel
     above the dead zone, share of full turn], rising, at most 16. A lut's
     own points; a power or linear curve sampled. */
  function velCurve(m){
    var out = [], i;
    if(m && m.curve === 'lut' && Array.isArray(m.points) && m.points.length){
      m.points.forEach(function(q){
        var u = Number(q[0]), y = Number(q[1]);
        var last = out[out.length - 1];
        if(u > 0 && u <= 1 && y > 0 && y <= 1 && (!last || (u > last[0] && y > last[1]))) out.push([u, y]);
      });
      return out.slice(-16);
    }
    for(i = 1; i <= 12; i++){
      var uu = i / 12, yy = ZSAIMMODEL.fracOfStick(Object.assign({}, m, { deadzone: 0 }), uu);
      if(yy > 0 && (!out.length || yy > out[out.length - 1][1])) out.push([uu, yy]);
    }
    return out;
  }
  /* aiming is measured only when the model has an aiming mode of its own
     (D284): one whose numbers differ from hip's */
  function velAdsOwn(r){
    var h = r && r.hip, a = r && r.ads;
    if(!h || !a) return false;
    return JSON.stringify([a.deadzone, a.vx, a.vy, a.curve, a.exp, a.points || []]) !==
      JSON.stringify([h.deadzone, h.vx, h.vy, h.curve, h.exp, h.points || []]);
  }
  function velBaseName(r, found){
    if(found && found.pack && found.pack.name) return found.pack.name;
    return String((r && r.name) || 'This game').replace(/\s*\([^)]*\)\s*$/, '').replace(/\s*\([^)]*\)\s*$/, '') || 'This game';
  }
  /* the start request: the curve the Core keeps, and what it shipped with */
  function velBody(r, found){
    var b = {
      mode: 'velocity', id: r.translator || (found && found.pack && found.pack.id) || 'game',
      name: velBaseName(r, found)+' (velocity calibrated)',
      date: new Date().toISOString().slice(0, 10),
      zone: r.hip.deadzone, hipCurve: velCurve(r.hip), hipYaw: r.hip.vx, hipPitch: r.hip.vy,
      /* the timed sticks stay under the game's turn ramp (D284 stress
         review); 0 = no ramp, the sticks may go to 95 % */
      rampThreshold: (r.hip.ramp && r.hip.ramp.threshold > 0) ? r.hip.ramp.threshold : 0
    };
    if(velAdsOwn(r)){
      b.adsCurve = velCurve(r.ads);
      b.adsYaw = r.ads.vx;
      b.adsPitch = r.ads.vy;
    }
    return b;
  }
  /* one mode of the resolved model with the measured dead zone and rates;
     a measured axes law keeps its round / square split (D187) */
  function velMode(m, dz, vx, vy){
    var old = m.deadzone;
    m.deadzone = dz;
    m.vx = vx;
    m.vy = vy;
    if(m.axes && typeof m.axes === 'object'){
      var a = m.axes;
      if(!(a.dzAxial > 0)){ a.dzRadial = dz; a.dzAxial = 0; }
      else if(!(a.dzRadial > 0)){ a.dzRadial = 0; a.dzAxial = dz; }
      else {
        a.dzAxial = old > 0 ? Math.min(dz, a.dzAxial * dz / old) : a.dzAxial;
        a.dzRadial = a.dzAxial < 1 ? (dz - a.dzAxial) / (1 - a.dzAxial) : 0;
      }
    }
  }
  /* The new translator: the measured model it was started from, every
     field kept (curve, ramp, axes law, game id), only the dead zone and
     the turn rates the Core measured. Exposed for the tests. */
  function velApply(base, m, found){
    var rm = JSON.parse(JSON.stringify(base));
    var adsOwn = velAdsOwn(base);
    velMode(rm.hip, m.hip.deadzone, m.hip.turnRate.yaw, m.hip.turnRate.pitch);
    if(m.ads && m.ads.turnRate && typeof m.ads.deadzone === 'number'){
