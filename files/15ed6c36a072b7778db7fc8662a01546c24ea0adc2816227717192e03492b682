  ZS.velBody = velBody;

  /* D218's parked line, with an id of its own (the fold's card has one too) */
  function velParked(){ return calParkedHTML().replace('id="cal-parked"', 'id="vel-parked"'); }

  /* THE CUSTOMER'S WORDS (D284 follow-up, owner 2026-10-13: "make it
     perfect"). A controller player who is not technical reads this card,
     so: one short line on the card, the why behind the ? (helpHTML, D258),
     steps as a numbered list, numbers in plain units, and every result
     says in a sentence what changed. The shape check is the TEAM's signal
     that the game's SAVED curve is off at this sensitivity; the customer is
     never told (owner 2026-10-13): the speeds save and "Put the old speeds
     back" is their whole answer. */
  var VEL_INTRO = 'Matches your aim to your in-game sensitivity and dead zone.';
  var VEL_HELP = 'Your Core turns your view a few times and watches it through your capture card. '+
    'It measures how fast your in-game sensitivity turns and where your dead zone starts. '+
    'Only those change. How aim builds up from slow to fast stays as the game was measured. '+
    'Run it again whenever you change your in-game sensitivity or dead zone. '+
    'It never presses fire.';
  var VEL_NONE_HELP = 'The ZeroStick team measures each game once and adds it to the game’s preset. '+
    'Until this game has one, the standard translator is used and this stays off.';
  var VEL_STOP_HOW = 'To stop: tap Stop, or hold Start / Menu (or Esc) for a second.';
