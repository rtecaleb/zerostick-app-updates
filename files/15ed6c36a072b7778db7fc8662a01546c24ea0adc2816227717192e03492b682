  function velPct(v){ var n = Number(v) * 100; return (Math.abs(n - Math.round(n)) < 0.05 ? n.toFixed(0) : n.toFixed(1))+'%'; }

  function velWire(root, p, found, measured){
    var box = root.querySelector('#tr-velocity');
    if(!box) return;
    var timer = null, lastState = null, misses = 0;
    var ads = !!measured && velAdsOwn(measured);
    function alive(){ return document.body.contains(box); }
    function later(ms){ clearTimeout(timer); timer = setTimeout(poll, ms); }
    function btn(id, cls, text, off){
      return '<button class="btn '+cls+'" id="'+id+'" style="margin-top:10px"'+(off ? ' disabled' : '')+'>'+esc(text)+'</button>';
    }
    function on(id, fn){ var b = box.querySelector('#'+id); if(b) b.addEventListener('click', fn); }
    function line(t, id, top){
      return '<div class="xsub"'+(id ? ' id="'+id+'"' : '')+' style="margin:'+(top ? '10px' : '0')+' 0 6px">'+t+'</div>';
    }
    function intro(){
      return line(esc(VEL_INTRO)+' '+(ads ? 'About two minutes.' : 'About a minute.'))+
        helpHTML('vel-what', 'Velocity calibration', VEL_HELP);
    }
    function steps(){
      return '<ol class="vel-steps" style="margin:8px 0 2px;padding:0 0 0 20px;font-size:13px;line-height:1.5;color:var(--text)">'+
        '<li style="margin:0 0 6px">Stand still in a quiet spot, like a private match or the firing range.</li>'+
        '<li style="margin:0 0 6px">Make sure no enemies are in view.</li>'+
        '<li style="margin:0">Tap Start, then put your controller down. It’s paused while your Core measures.</li></ol>';
    }
    /* `extra` sits above the Start key; `off` greys Start with a reason
       already said in `extra` (offline, another calibration running) */
    function idle(extra, off){
      if(!measured){
        /* nothing to scale: greyed, one plain sentence, no start; the
           why behind the ? */
        box.innerHTML =
          '<div id="vel-none" aria-disabled="true" style="opacity:.55">'+
            line(esc(VEL_NONE))+
            btn('vel-start', 'ghost', 'Start', true)+'</div>'+
          helpHTML('vel-none-why', 'Why this is off', VEL_NONE_HELP);
        return;
      }
      if(calParked()){
        box.innerHTML = intro()+velParked();
        return;
      }
      /* a Start that cannot be pressed drops to the secondary face (zs-kit
         section 7, "never dim a primary": the flat skin paints every
         primary blue, disabled or not) */
      box.innerHTML = intro()+steps()+(extra || '')+btn('vel-start', off ? 'ghost' : 'primary', 'Start', !!off);
      on('vel-start', start);
    }
    /* the owner's 3 second countdown, as Calibrate's. Every key in the card
       is off while it counts, and the one tapped says the count (Start or
       Measure again). Leaving the screen during it starts nothing. */
    function start(e){
      var b = (e && e.currentTarget) || box.querySelector('#vel-start');
      [].forEach.call(box.querySelectorAll('button.btn'), function(x){ x.disabled = true; });
      var n = 3;
