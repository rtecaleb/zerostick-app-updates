    }
    /* the run's numbers already ARE the translator in use (after "Use
       these speeds" the card is drawn again over the same finished run) */
    function applied(r){
      var mh = measured.hip;
      return !!mh && typeof r.deadzone === 'number' && typeof r.yaw === 'number' &&
