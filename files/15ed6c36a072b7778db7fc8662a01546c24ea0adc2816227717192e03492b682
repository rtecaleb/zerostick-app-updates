    }
    /* New beside Now, in fixed right-aligned columns so the numbers line up
       at 393 px; Now in the label grey (DESIGN.md: no grey by opacity) */
    function rows(r, one){
      var mh = measured.hip, ma = measured.ads;
      var COL = 'flex:none;width:4.6em;text-align:right';
      function val(v, unit, dp, scale){
        return (v === null || v === undefined) ? '–' : calNum(v * (scale || 1), dp)+unit;
      }
      function row(label, nv, ov, unit, dp, scale){
        return '<div class="stat vel-row"><span style="flex:1;min-width:0">'+esc(label)+'</span>'+
          '<b style="'+COL+'">'+val(nv, unit, dp, scale)+'</b>'+
          (one ? '' : '<b style="'+COL+';color:var(--muted)">'+val(ov, unit, dp, scale)+'</b>')+'</div>';
      }
      return (one ? '' : '<div class="stat vel-row"><span style="flex:1"></span>'+
          '<b class="xsub" style="'+COL+'">New</b><b class="xsub" style="'+COL+';color:var(--muted)">Now</b></div>')+
        row('Dead zone', r.deadzone, mh.deadzone, '%', 1, 100)+
        row('Turn speed', r.yaw, mh.vx, '°/s', 0)+
        row('Up and down', r.pitch, mh.vy, '°/s', 0)+
        (ads ? row('Aiming', velAdsNew(r), ma ? ma.vx : null, '°/s', 0) : '');
    }
    /* aiming's new speed: measured, or (a run that did not measure it,
       result.velocity.ads false) the same speed-up as hip, as velApply
       saves it; never the 0 an unmeasured mode reports */
    function velAdsNew(r){
      var mh = measured.hip, ma = measured.ads;
      var took = !(r.velocity && r.velocity.ads === false) && r.adsYaw > 0;
      if(took) return r.adsYaw;
      return (ma && mh.vx > 0 && r.yaw > 0) ? ma.vx * r.yaw / mh.vx : null;
    }
    /* what changed, in two plain sentences: the speed and the dead zone */
    function summary(r){
      var mh = measured.hip, out = [];
      if(mh.vx > 0 && r.yaw > 0){
        var pc = Math.round((r.yaw / mh.vx - 1) * 100);
        out.push(Math.abs(pc) < 2 ? 'Your turn speed already matches.'
          : 'Your game turns '+Math.abs(pc)+'% '+(pc > 0 ? 'faster' : 'slower')+' than your aim is set up for.');
      }
      if(typeof r.deadzone === 'number' && typeof mh.deadzone === 'number'){
        out.push(Math.abs(r.deadzone - mh.deadzone) < 0.005 ? 'Your dead zone already matches.'
          : 'Your dead zone is '+(r.deadzone > mh.deadzone ? 'bigger' : 'smaller')+': '+
            velPct(r.deadzone)+' instead of '+velPct(mh.deadzone)+'.');
      }
      return '<div id="vel-sum" style="font-size:13px;line-height:1.5;color:var(--text);margin:0 0 6px">'+
        out.map(function(t){ return '<div>'+esc(t)+'</div>'; }).join('')+'</div>';
    }
    function useIt(){
      var b = box.querySelector('#vel-use');
      if(b){ b.disabled = true; b.textContent = 'Saving…'; }
      ZS.api('/calibrate/model').then(function(j){
        if(!alive()) return;
        var m = j && j.ok ? j.data : null;
        if(!m || !m.hip || !m.hip.turnRate || typeof m.hip.deadzone !== 'number'){
          if(b){ b.disabled = false; b.textContent = 'Use these speeds'; }
          ZS.toast && ZS.toast('Your Core didn’t send the speeds. Try again.');
          return;
        }
        ZS.putProfileDebounced(p.id, function(f){
          if(!f.mouseTranslation) f.mouseTranslation = {};
          var mt = f.mouseTranslation;
          /* the measured model as it is NOW in the config (it may have
             changed since the card was drawn), else the one drawn */
          var base = trMeasured(found, mt, p.platform) || measured;
          var was = mt.resolvedAimModel;
          /* D178/D181: keep what it replaces, so Restore is one tap */
          mt.previousAimModel = (was && typeof was === 'object') ? was : 'standard';
          mt.resolvedAimModel = velApply(base, m, found);
          if(ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(mt, 'velocity calibration');
        });
        ZS.toast && ZS.toast('Your speeds are on');
        setTimeout(function(){ if(ZS.redrawOpenScreen) ZS.redrawOpenScreen(); }, 900);
      });
    }
    /* Restore, right where the player just changed it: the same one-tap
       swap as the Game translator card's "Restore previous translator"
       (D178, 12-translation.js trSwapPrevious) */
    function restore(){
      var b = box.querySelector('#vel-restore');
      if(b) b.disabled = true;
      ZS.putProfileDebounced(p.id, function(f){
        if(trSwapPrevious(f) && ZSAIMMODEL.markChoice) ZSAIMMODEL.markChoice(f.mouseTranslation, 'restore previous translator');
      });
      ZS.toast && ZS.toast('Your old speeds are back');
      setTimeout(function(){ if(ZS.redrawOpenScreen) ZS.redrawOpenScreen(); }, 900);
    }
    function done(d){
      var r = d.result || {};
      /* the shape check (r.velocity.shapeOk) is the TEAM's signal, never
         the player's (owner 2026-10-13: "we don't need the customer to be
         that informed"): the speeds still save, and "Put the old speeds
         back" is the player's whole answer if aim feels off */
      var prev = cur().previousAimModel;
      if(applied(r)){
        box.innerHTML =
          '<div class="stat" id="vel-on"><span>Your speeds are on</span><b class="ok">✓ In use</b></div>'+
          rows(r, true)+
          (prev !== undefined && prev !== null
            ? line('Aim feels worse? Put the old speeds back.', 'vel-undo', true)+btn('vel-restore', 'ghost', 'Put the old speeds back')
            : '')+
          (calParked() ? velParked() : btn('vel-again', 'ghost', 'Measure again'));
        on('vel-restore', restore);
        on('vel-again', start);
        return;
      }
      box.innerHTML =
        line('Measured. Every check passed.')+
        summary(r)+
        rows(r, false)+
        line('Use these speeds to match them. Nothing else in your setup changes.', '', true)+
        btn('vel-use', 'primary', 'Use these speeds')+
        (calParked() ? velParked() : btn('vel-again', 'ghost', 'Measure again'));
      on('vel-use', useIt);
      on('vel-again', start);
    }
    /* a run that failed its checks (done, not fit) or that the Core gave up
       on (failed): said plainly, nothing saved; the Core's own words (which
       can be technical) behind the ? */
    function rejected(d){
      var failed = d.state === 'failed';
      var probs = Array.isArray(d.problems) && d.problems.length ? d.problems
        : [d.fitWhy || d.why || 'The calibration did not finish.'];
      box.innerHTML =
        '<div class="stat"><span>'+(failed ? 'It stopped before the end' : 'This run can’t be used')+'</span>'+
          '<b style="color:var(--amber)">Not saved</b></div>'+
        (failed && d.why ? line(esc(d.why)) : '')+
        note(esc(failed ? 'Check your capture card shows the game, then try again. Your speeds were not changed.'
          : 'Something moved or blocked the view. Stand still in a quiet spot with no enemies in view, '+
            'don’t touch the controller, and try again. Your speeds were not changed.'), 'warn', true)+
        (failed ? '' : helpHTML('vel-why', 'What your Core saw', probs.map(esc).join(' ')))+
        (calParked() ? velParked() : btn('vel-again', 'primary', 'Measure again'));
      on('vel-again', start);
    }
    function cancelRun(){
      var b = box.querySelector('#vel-cancel');
      if(b){ b.disabled = true; b.textContent = 'Stopping…'; }
      ZS.api('/calibrate/cancel', 'POST', {}).then(function(){ later(200); });
    }
    function lostReply(j){
      if(!j) return true;
      var e = String(j.error || (j.errors && j.errors[0]) || '');
      return ZS.live.online === false || /unreachable|timed? ?out|usb request failed|no answer|abort/i.test(e);
    }
    /* M27: one lost reply is not "no calibration" (as Calibrate's). A run
       we know is going keeps its Stop; with no run going, the card says the
       Core is not answering and greys Start (no Stop for nothing). */
    function waiting(){
      misses++;
      if(lastState !== 'running'){
        idle(line(esc(ZS.live.online === false
          ? 'Your Core isn’t connected. Connect it to calibrate.'
          : 'No answer from your Core just now. Asking again…'), 'vel-wait', true), true);
        later(Math.min(1000 * misses, 5000));
        return;
      }
      if(!box.querySelector('#vel-wait')){
        box.innerHTML =
          '<div class="stat"><span>Measuring</span><b>…</b></div>'+
          line('', 'vel-wait')+
          line(esc(VEL_STOP_HOW))+
          btn('vel-cancel', 'ghost', 'Stop');
        on('vel-cancel', cancelRun);
      }
      var w = box.querySelector('#vel-wait');
      if(w) w.textContent = 'No answer from your Core just now. Asking again…';
      later(Math.min(1000 * misses, 5000));
    }
    function render(j){
      if(!measured){ idle(''); return; }
      if(!j || !j.ok){
        if(lastState === 'running' || lostReply(j)){ waiting(); return; }
        box.innerHTML = line('This Core can’t calibrate yet. Update its firmware to use velocity calibration.');
        return;
      }
      misses = 0;
      var d = j.data || {};
      /* the owner's curve calibration is the fold's card, not this one's;
         while it runs, this card waits for it */
      if(d.mode !== 'velocity'){
        lastState = null;
        if(d.state === 'running'){
          idle(line('Another calibration is running. Start is ready again when it finishes.', '', true), true);
          later(2000);
        } else idle('');
        return;
      }
      lastState = d.state || null;
      if(d.state === 'running'){
        var left = velLeft(d);
        box.innerHTML =
          '<div class="stat"><span style="flex:1;min-width:0">'+esc(calPhase(d))+'</span>'+
            (left ? '<b id="vel-left" style="flex:none">'+esc(left)+'</b>' : '')+'</div>'+
          calBar(d.totalMs ? d.doneMs / d.totalMs : 0)+
          line('Your controller is paused. Fire is never pressed.')+
          line(esc(VEL_STOP_HOW))+
          btn('vel-cancel', 'ghost', 'Stop');
        on('vel-cancel', cancelRun);
        return;
      }
      if(d.state === 'done' && d.fitOk){ done(d); return; }
      if(d.state === 'done' && !d.fitOk && d.fitWhy){ rejected(d); return; }
      if(d.state === 'done' && !d.fitOk && !d.fitWhy){
        box.innerHTML = '<div class="stat"><span>Working out your speeds</span><b>…</b></div>';
        later(800);
        return;
      }
      if(d.state === 'failed'){ rejected(d); return; }
      /* stopped: said plainly, not a warning (nothing went wrong) */
      if(d.state === 'cancelled'){ idle(note('Stopped. Your speeds were not changed.')); return; }
      idle('');
    }
    function poll(){
      if(!alive()){ clearTimeout(timer); return; }
      if(!measured){ idle(''); return; }
      ZS.api('/calibrate/status').then(function(j){
        if(!alive()) return;
        render(j);
        if(j && j.ok && j.data && j.data.state === 'running' && j.data.mode === 'velocity') later(600);
      });
    }
    poll();
  }

  /* what the other screen files use from this one */
  SEC.calWire = calWire;
  SEC.velWire = velWire;
  SEC.calParked = calParked;
  SEC.calParkedHTML = calParkedHTML;
});
