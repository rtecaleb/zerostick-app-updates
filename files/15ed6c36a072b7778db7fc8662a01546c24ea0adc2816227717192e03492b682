          '<b>node dashboard/tools/set-pack-aim-model.js '+esc(pack.id)+' &lt;file&gt; --speeds</b>.</div>'+
        '<div class="xsub" id="cal-speeds-say" role="status" style="margin-top:6px"></div></div>';
    }
    function copySpeeds(d){
      var b = box.querySelector('#cal-speeds'), say = box.querySelector('#cal-speeds-say');
      var sIn = box.querySelector('input.cal-sens'), dIn = box.querySelector('input.cal-sensdz');
      var sr = calRowOf(pack, CAL_SENS_RE), dr = calRowOf(pack, CAL_DZ_RE);
      var at = {
        sensitivity: { setting: sr ? sr.setting : 'Look sensitivity', value: sIn ? String(sIn.value || '') : '' },
        deadzone: { setting: dr ? dr.setting : 'Stick dead zone', value: dIn ? String(dIn.value || '') : '' }
      };
      if(b) b.disabled = true;
