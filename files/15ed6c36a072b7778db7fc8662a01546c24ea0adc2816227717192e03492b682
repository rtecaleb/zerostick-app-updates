        txtFld('In-game '+(sr ? sr.setting.toLowerCase() : 'sensitivity')+' it was measured at',
          sr ? sr.value : '', 'cal-sens')+
        txtFld('In-game '+(dr ? dr.setting.toLowerCase() : 'dead zone')+' (optional)', dr ? dr.value : '', 'cal-sensdz')+
