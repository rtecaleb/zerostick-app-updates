        row('Dead zone', r.deadzone, now.deadzone, '%', 1, 100)+
        row('Full-stick turn', r.yaw, now.yaw, '\u00b0/s', 0)+
        row('Up and down', r.pitch, now.pitch, '\u00b0/s', 0)+
        row('Aiming down sights', r.adsYaw, now.adsYaw, '\u00b0/s', 0)+
        row('Field of view', r.hfov, null, '\u00b0', 0);
    }
