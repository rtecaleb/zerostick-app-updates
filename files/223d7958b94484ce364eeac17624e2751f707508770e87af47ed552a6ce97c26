{
  "zerostickGamePack": 1,
  "id": "pubg",
  "name": "PUBG: Battlegrounds",
  "aliases": [
    "PUBG",
    "PlayerUnknown's Battlegrounds",
    "Battlegrounds"
  ],
  "version": 1,
  "status": "calibrated",
  "aiScripts": false,
  "art": null,
  "aimPreset": null,
  "aimModel": {
    "format": "zs-aim-model/1",
    "id": "pubg",
    "name": "PUBG (Default)",
    "needsCalibration": false,
    "sources": [
      {
        "what": "D394: imported 2026-10-15 from XIM game id 4321 (PUBG, curves PUBG-ADS-P4.8 / PUBG-ADS-X1.11 / PUBG-Hip-P4.9 / PUBG-Hip-X1.10). XIM MATRIX game-support repository (XIMR-20260914-114333.ximmr, the owner's own downloaded copy), statically extracted 2026-10-15 to Replica\\xim-matrix\\replica\\extracted\\games_full.json. Only the plaintext type-130 config and the type-150/151 scalars are used; the encrypted curve bodies (types 138-141) were not decrypted (D394). The owner states the use is lawyer-approved (the extraction README, \"Boundary note\")."
      },
      {
        "what": "Turn speeds as XIM measured them (deg/s at full stick, at the gameSettings values): hip 403, aiming 123 on PS4; Xbox One hip 403, aiming 123 (XIM record types 150 / 151)."
      },
      {
        "what": "Up/down speed is a PRIOR, not in XIM's plaintext: pitch = 1 x yaw hip, 1 x aiming (Vertical Sensitivity Multiplier 100)."
      },
      {
        "what": "Dead zone 0.12 is a PRIOR, not in XIM's plaintext (not published; the engine's generic zone)."
      },
      {
        "what": "Curve shape is a PRIOR, not in XIM's plaintext (not published; linear, as the engine assumes for any game). XIM keeps its shapes in encrypted records that were not decrypted."
      }
    ],
    "gameSettings": [
      {
        "setting": "General Sensitivity",
        "value": "Highest"
      },
      {
        "setting": "Vertical Sensitivity Multiplier",
        "value": "100"
      },
      {
        "setting": "ADS 1x Sensitivity",
        "value": "Highest"
      }
    ],
    "stickHz": 60,
    "hip": {
      "deadzone": 0.12,
      "deadzoneShape": "radial",
      "curve": {
        "type": "linear"
      },
      "turnRate": {
        "yaw": 403,
        "pitch": 403
      },
      "ramp": null,
      "dampingMs": 0,
      "turnRateByConsole": {
        "playstation": {
          "yaw": 403,
          "pitch": 403
        },
        "xbox": {
          "yaw": 403,
          "pitch": 403
        }
      }
    },
    "ads": {
      "inherit": "hip",
      "turnRate": {
        "yaw": 123,
        "pitch": 123
      },
      "turnRateByConsole": {
        "playstation": {
          "yaw": 123,
          "pitch": 123
        },
        "xbox": {
          "yaw": 123,
          "pitch": 123
        }
      }
    }
  },
  "notes": "PUBG: Battlegrounds: pack made by import-xim-translators.js (D394) for a game whose turn speeds XIM's data carries. No art yet.",
  "smartActions": [
    {
      "template": "toggleads",
      "enabled": false
    }
  ],
  "config": {},
  "inputs": {
    "controller": {
      "calibrated": false,
      "why": "No measured stick settings for PUBG: Battlegrounds are in the repo yet. This block sets nothing, so a controller config starts on the same neutral 1:1 stick every new config gets.",
      "config": {}
    },
    "mnk": {
