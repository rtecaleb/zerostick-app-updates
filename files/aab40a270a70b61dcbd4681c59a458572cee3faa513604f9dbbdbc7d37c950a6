/* smart-actions/16-buttons.js — the Buttons list (Mappings): what you press, what the console gets.
 *
 * One row per input, the row's sequence (D82), the input screen of one button,
 * and starting a sequence from a button.
 *
 * Tests: test-smart-actions.js, test-input-type.js, test-game-packs.js
 *
 * ONE PART OF THE SCRIPTS EDITOR (2026-10-02: smart-actions.js, split into
 * parts). smart-actions.js is the loader and explains the rules: the parts
 * run in order inside ZS_SMART_PARTS.run(), strict mode as before, and share
 * names only through the lists at the top and the bottom of each part.
 */
ZS_SMART_PARTS.add('buttons', function (SEC) {
  'use strict';
  /* from the parts before this one */
  var addbtn = SEC.addbtn, arr = SEC.arr, card = SEC.card, clone = SEC.clone,
      esc = SEC.esc, haveClass = SEC.haveClass, isPadSource = SEC.isPadSource,
      newAction = SEC.newAction, normAction = SEC.normAction, note = SEC.note, sh = SEC.sh,
      tgtName = SEC.tgtName, tgtSvg = SEC.tgtSvg, ZS = SEC.ZS, oneLiner = SEC.oneLiner,
      MARK_TARGET = SEC.MARK_TARGET, sicon = SEC.sicon, stripHTML = SEC.stripHTML,
      tileHTML = SEC.tileHTML, totalSay = SEC.totalSay, totalChip = SEC.totalChip, boardWord = SEC.boardWord,
      deadNote = SEC.deadNote, deadParts = SEC.deadParts, firedNote = SEC.firedNote,
      notSaved = SEC.notSaved, syncBadge = SEC.syncBadge,
      workshopOffered = SEC.workshopOffered, bindTileHTML = SEC.bindTileHTML,
      repeatBadge = SEC.repeatBadge, bindsLive = SEC.bindsLive, bindsOf = SEC.bindsOf,
      inputsFor = SEC.inputsFor, packLayout = SEC.packLayout,
      padRowsWanted = SEC.padRowsWanted, rowArt = SEC.rowArt, rowCaption = SEC.rowCaption,
      rowName = SEC.rowName, rowTarget = SEC.rowTarget, sameLayout = SEC.sameLayout,
      srcShown = SEC.srcShown, gridHTML = SEC.gridHTML;
  /* from parts after this one, bound once every part has run (never used
     while this part is running) */
  var draw, smartBodyHTML;
  ZS_SMART_PARTS.after(function () {
    draw = SEC.draw;
    smartBodyHTML = SEC.smartBodyHTML;
  });

  /* ══ the Buttons list ═════════════════════════════════════════════ */

  /* ── ONE SCRIPT ROW (D338) ──
     Owner (2026-10-14, the Scripts fold on Mappings): "it just looks bad
     and not formal or nice". The row it replaces drew the trigger cell, a
     colour dot, "▸▸", the name and two marks on one line, the "?" alone on
     a second, the 84x56 binding tile and the switch on a third (with the
     left of that line empty) and the step strip on a fourth. Now it is a
     list row like every other one in the app:
       left    the Script's picture (its Ready-made's own icon, or the
               editor's) on a square in the Script's colour
       middle  the name with its "?" beside it; under it, in the muted ink,
               the key that starts it (its own small picture), how it runs
               and how long it takes, and its tags (the four badges the
               binding tile carried, now as words); under that the steps,
               small, in the same column
       right   the on/off switch and the chevron, centred on the row
     The "?" opens its points under the text column, not across the row. */
  /* the key that starts a Script, as a small picture and its word, both
     in THIS config's console's names (D239: LB on Xbox, L1 on PlayStation);
     a picture that already is the word (the LB glyph) goes without it */
  function trigKeyHTML(src, p) {
    var art = SEC.srcArt(src), word = String(SEC.srcName(src)).replace(/ key$/, '');
    if (p && SEC.srcClass(src) === 'controller' && window.ZSG && typeof ZSG.glyph === 'function') {
      var fam = (p.platform === 'ps5' || p.platform === 'ps4') ? 'ps5' : 'xbox';
      art = ZSG.glyph(src, fam);
      word = ZSG.label(src, fam);
    }
    return '<span class="glyimg">' + art + '</span>' + (sameWord(art, word) ? '' : '<b>' + esc(word) + '</b>');
  }
  function scriptPicHTML(a) {
    var id = SEC.tplIdOf ? SEC.tplIdOf(a) : '', t = null;
    (SEC.TEMPLATES || []).forEach(function (x) { if (!t && x && x.id === id) t = x; });
    var pic = (t && t.ico && SEC.ico) ? SEC.ico(t.ico, 26) : '';
    if (!pic && ZS.icoSVG) pic = ZS.icoSVG('editor', 26);
    return '<span class="saseqpic" aria-hidden="true" style="--sacol:' + esc(a.colour || 'var(--accent)') + '">' +
      pic + '</span>';
  }
  /* ZS.helpHTML is a "?" row followed by its fold; the row wants the "?"
     beside the name and the fold under the text, so the two are parted */
  function splitQH(html) {
    var s = String(html || ''), at = s.indexOf('<div class="note qhfold"');
    if (at < 0) return { chip: s, fold: '' };
    var chip = s.slice(0, at).replace(/^<span class="sadesc">/, '');
    var fold = s.slice(at).replace(/<\/span>\s*$/, '');
    return { chip: chip, fold: fold };
  }
  function seqLineHTML(pair, ri, p, S, row) {
    var a = pair.a, line = oneLiner(a, p), dead = deadNote(a, p, S), rb = repeatBadge(a);
    var nm = a.name || 'Untitled sequence';
    var unbound = !!(a.trigger && a.trigger.unbound);
    var src = unbound ? '' : (row && row.source) || (SEC.emitSource(p, a.trigger) || '');
    var off = a.enabled === false;
    var qh = splitQH(SEC.descQH(a, p));
    /* the key that starts it: its own picture, small, and its name; with
       none, the ✕ that opens the key picker (the cell it always was) */
    var key = src
      ? '<span class="saseqkey">' + trigKeyHTML(src, p) + '</span>'
      : '<span class="saseqkey nokey"><span class="sacell nosrc" data-fix="1" role="button" tabindex="0" ' +
        'aria-label="no button starts this yet — pick one">✕</span><b>No key yet</b></span>';
    var bs = SEC.bindBadges ? SEC.bindBadges(a) : {};
    var tags = ['top', 'left', 'right', 'bottom'].map(function (k) {
      var b = bs[k];
      return b ? '<span class="saseqtag" title="' + esc(b.s) + '">' + b.m + '<i>' + esc(b.w) + '</i></span>' : '';
    }).join('');
    /* a dead Script on no key says so with the ✕ above, not twice */
    var deadLine = unbound ? '' : dead;
    return '<div class="lrow saitem seqline saseq' + (dead ? ' sabroken' : '') + (off ? ' saoffrow' : '') +
      '" data-row="' + ri + '" data-act="' + pair.i + '" role="button" tabindex="0" aria-label="' +
      esc(nm + ' — ' + line + totalSay(a) + ' It ' + rb.say + '.' +
          (off ? ' Switched off.' : '') + (dead ? ' Will not fire.' : '')) + '">' +
      scriptPicHTML(a) +
      '<span class="src saseqtx">' +
        '<span class="saseqhd"><span class="saseqnm">' + esc(nm) + '</span>' +
          (off ? '<span class="tag saoff">off</span>' : '') + syncBadge(a, p, S) +
          (qh.chip ? '<span class="saseqq">' + qh.chip + '</span>' : '') + '</span>' +
        '<span class="saseqsub" aria-hidden="true">' + key +
          (a.steps.length ? totalChip(a) : '') + tags + firedNote(a, p, S) + '</span>' +
        deadLine +
        (a.steps.length ? '<span class="saseqsteps">' + rowStripHTML(a, p, 5) + '</span>' : '') +
        qh.fold +
      '</span>' +
      '<span class="rt">' +
      '<span class="sw' + (a.enabled ? ' on' : '') + '" data-en="' + pair.i +
      '" data-nosave="1" role="switch" aria-checked="' + (a.enabled ? 'true' : 'false') +
      '" tabindex="0" aria-label="' + esc(nm + ' — on or off') + '"></span>' +
      '<span class="chev">›</span></span></div>';
  }

  /* A GLYPH THAT IS JUST THE LABEL IS NOT A GLYPH. ZSG draws the face buttons
     as symbols (✕ ◯ □ △) but the shoulders, triggers and stick clicks as
     their own letters, so a bumper row rendered "L1 → L1 L1 default": the
     picture, the picture's caption, and the caption. Face rows never did this
     ("✕ → ✕ Cross"), so the list was inconsistent as well as repetitive.
     Compare the glyph's text to the label and drop the picture when it is
     saying the same word — the label is the half a screen reader reads. */
  function sameWord(svg, name) {
    var g = String(svg || '').replace(/<[^>]*>/g, '').replace(/\s+/g, '').toUpperCase();
    var n = String(name || '').replace(/\s+/g, '').toUpperCase();
    return !!g && g === n;
  }

  /* ── one row: what you PRESS on the left, what the console GETS on the
     right (D78). XIM's Bindings row on our model: a square SOURCE cell —
     the player's own key, click or pad button, framed in its device
     family's colour — and beside it the TARGET's picture and name. The
     frame is decoration over art that already says what it is (a keycap
     drawn as a keycap, a pad button as a pad button); nothing here is
     colour-alone. The two columns keep their meanings even on an unchanged
     pad row ("[✕] ✕ Cross · default"): left is always the input, right is
     always the output, which is what lets the list be scanned rather than
     read. (The 2026-08-28 review dropped the second picture on identity
     rows when the row was "picture → picture"; with fixed columns the
     repetition is the grammar, and the "default" tag still says why.) */
  function srcCellHTML(row, p) {
    if (!row || !row.source) {
      /* XIM's big X: an output nothing drives yet. It is the door to
         "press the control you want to bind" — the same picker the row
         already reaches through its ▲ notice (data-fix → retrigger →
         pickTrigger, whose "Press it and I'll find it" arms the board's
         /capture). No new backend call. */
      return '<span class="sacell nosrc" data-fix="1" role="button" tabindex="0" ' +
        'aria-label="no button starts this yet — pick one">✕</span>';
    }
    var fam = (row.kind === 'controller' && window.ZSG && ZSG.family) ? String(ZSG.family() || '') : '';
    /* D239 (owner, 2026-10-09: "show RB as RB, or R1 as R1, by default"): a
       pad button is drawn the way THIS config's console names it - R1 on a
       PS4/PS5 config, RB on Xbox and PC - so a default row reads R1 -> R1 */
    var art = rowArt(row);
    if (p && row.kind === 'controller' && window.ZSG && typeof ZSG.glyph === 'function') {
      fam = (p.platform === 'ps5' || p.platform === 'ps4') ? 'ps5' : 'xbox';
      art = ZSG.glyph(row.neutral || row.source, fam);
    }
    return '<span class="sacell k-' + esc(row.kind || 'unknown') + (fam ? ' fam-' + esc(fam) : '') +
      '" aria-hidden="true"><span class="glyimg">' + art + '</span></span>';
  }
  /* ── THE ROW SHOWS THE SEQUENCE (D82) ──
     Owner (2026-09-05): "when it is a smart action it should show the smart
     action it is, by showing the sequence that it can, in the box of that
     button that was made." XIM's list draws a smart button's row as a strip
     of small step icons with their timings and a ••• at the end, where a
     plain row shows the target picture. So a row with a sequence puts the
     sequence's NAME where the target name sits and, under it, a ONE-LINE
     strip of the same tiles the editor's box draws (the target's picture
     through the art hubs, or the kind's icon; the number under it in the
     box's own units: ms, %, ×), at 38×40. The strip is cut by COUNT, not by
     clipping: ROW_FIT tiles fit beside the 44 px cell in the 393 px list
     (measured), so past that the last slot is a ••• tile that says how
     many more, and the row never wraps or scrolls sideways. A second
     sequence on the button is a "+1 more" tag after the strip, which costs
     the strip one tile of room; the panel's "1 of 2 ›" takes it from there.
     The strip is aria-hidden — the row's own label says the sequence in
     words — and the tap still opens the panel in editor mode (D81). */
  var ROW_FIT = 5;
  function rowStripHTML(a, p, fit) {
    var steps = a.steps, n = steps.length, i, body = '';
    if (!n) return '';
    var show = n > fit ? fit - 1 : n, hidden = n - show;
    for (i = 0; i < show; i++) body += tileHTML(steps[i], i, steps, p, {});
    if (hidden > 0) {
      body += '<span class="satile rowmore" title="' +
        esc(hidden + ' more step' + (hidden > 1 ? 's' : '') + ' — open the button to see them all') + '">' +
        '<span class="satart">' + sicon('more', '…') + '</span>' +
        '<span class="satbadge">+' + hidden + '</span></span>';
    }
    return '<span class="sastrip rowstrip" aria-hidden="true">' + body + '</span>';
  }
  /* `o.state` (the Smart mappings rows, D85) adds what the old Yours cards
     showed that matters: an "off" tag beside a switched-off sequence's
     name (the editor's On/Off does the writing) and the D70 "!" chip —
     never red prose — when the board says it will not fire, its fold
     carrying the one-tap fix. The Mappings list's own rows stay as D82
     drew them. */
  /* D256: a Rapid fire Script (the Ready-made turbo: a pull of RT, then a
     wait, the same length, repeated while held). Its speed is taps a
     second; ms per half = 1000 / (2 * taps). */
  function turboOf(a) {
    if (!a || !Array.isArray(a.steps) || a.steps.length !== 2) return false;
    var id = SEC.tplIdOf ? SEC.tplIdOf(a) : '';
    return id === 'turbo' && a.steps[0].k === 'trig' && a.steps[1].k === 'wait';
  }
  function turboTaps(a) {
    var ms = Math.max(1, +a.steps[0].ms || 40);
    return Math.max(2, Math.min(33, Math.round(1000 / (2 * ms))));
  }
  function turboSliderHTML(a, ai) {
    var v = turboTaps(a);
    return '<span class="saturbo" data-noswipe="1"><span class="saturbol">Speed <b data-turbov="' + ai + '">' + v +
      ' taps/s</b></span><input class="saturborng" type="range" min="2" max="33" step="1" value="' + v +
      '" data-turbo="' + ai + '" data-nosave="1" aria-label="Rapid fire speed, taps a second"></span>';
  }
  SEC.turboOf = turboOf;
  /* D270 (owner, 2026-10-10: "Aim assist booster gets a Strength slider so
     people can turn it up and down; Anti-recoil gets a pull-down Strength
     slider"): the D256 pattern for the two aim Ready-mades. The row IS its
     strength, the stick % every one of its stick steps pushes:
       aimboost  eight right-stick steps round a circle, each `dist`
       recoil    one right-stick step straight down, its `dist`
     Recognised by the template AND the shape, so a Script the player has
     reshaped in the editor keeps its tiles. */
  var STRENGTH = {
    aimboost: { min: 2, max: 25, lab: 'Strength', say: 'Aim assist booster strength, percent' },
    recoil: { min: 3, max: 60, lab: 'Pull down', say: 'Anti-recoil pull-down strength, percent' }
  };
  function strengthOf(a) {
    if (!a || !Array.isArray(a.steps) || !a.steps.length) return null;
    var id = SEC.tplIdOf ? SEC.tplIdOf(a) : '';
    var sticks = a.steps.every(function (s) { return s && s.k === 'stick' && s.stick === 'right' && !(+s.dps > 0); });
    if (!STRENGTH[id] || !sticks) return null;
    if (id === 'aimboost' && a.steps.length !== 8) return null;
    if (id === 'recoil' && !(a.steps.length === 1 && +a.steps[0].angle === 270)) return null;
    return id;
  }
  function strengthPct(a) {
    return Math.round(Math.max(0, Math.min(1, +a.steps[0].dist || 0)) * 100);
  }
  function strengthSliderHTML(a, ai) {
    var id = strengthOf(a), k = STRENGTH[id], v = Math.max(k.min, Math.min(k.max, strengthPct(a)));
    return '<span class="saturbo" data-noswipe="1"><span class="saturbol">' + k.lab + ' <b data-strengthv="' + ai +
      '">' + v + '%</b></span><input class="saturborng" type="range" min="' + k.min + '" max="' + k.max +
      '" step="1" value="' + v + '" data-strength="' + ai + '" data-nosave="1" aria-label="' + k.say + '"></span>';
  }
  SEC.strengthOf = strengthOf;
  SEC.STRENGTH = STRENGTH;
  function enSwitchHTML(pair) {
    var a = pair.a, on = a.enabled !== false;
    return '<span class="sw' + (on ? ' on' : '') + '" data-en="' + pair.i +
      '" data-nosave="1" role="switch" aria-checked="' + (on ? 'true' : 'false') +
      '" tabindex="0" aria-label="' + esc('Script ' + (a.name || 'Untitled Script') + ' — on or off') + '"></span>';
  }
  function inputRowHTML(row, ri, p, S, o) {
    o = o || {};
    /* `o.act` (Smart mappings, D127): this row is ONE action, not the
       button's first, so a button carrying three draws three rows and the
       one just made is never hidden behind "+2 more". data-sact is what
       wireList opens, in the editor, on exactly that action. */
    var one = o.act || null;
    var tgt = rowTarget(row), nm = rowName(row);
    /* D338: a button that sends nothing says "Not bound" at its row */
    var unb = SEC.rowUnbound ? SEC.rowUnbound(row) : false;
    var isDef = !row.plainBind && !unb;
    var chord = row.chordBinds.length, acts = one ? 1 : row.acts.length;
    /* D244 (owner, 2026-10-09: "in Mappings there shouldn't be any macros or
       scripts - B can only be B, one button at a time ... a script can be
       used to disable a mapping because the function is replaced, so add an
       indicator ... and show the scripts in the Scripts tab below"). On the
       Mappings list (o.plain) a button with a Script is drawn as its plain
       mapping, marked as taken over; the Script is a row in the Scripts card. */
    /* A Script switched OFF does not take the button over (owner, D255
       confirmed 2026-10-10: "if the script gets disabled, the mapping is no
       longer replaced by the script, so remove that message"): the Core
       never runs it (it packs only enabled actions), so the row is the plain
       mapping, with no "Replaced" line and no View script key, and both come
       back the moment the Script is switched on. */
    var onActs = (o.plain && !one && acts)
      ? row.acts.filter(function (pair) { return pair.a.enabled !== false; }) : [];
    var takenBy = onActs.length
      ? onActs.map(function (pair) { return pair.a.name || 'Untitled Script'; }) : null;
    var takenAct = takenBy ? onActs[0].i : -1;
    if (o.plain && !one && acts) acts = 0;
    var what = tgt ? tgtName(tgt, p) : 'nothing on its own';
    var chordEm = chord ? '<em>+' + chord + ' shift-layer job' + (chord > 1 ? 's' : '') + '</em>' : '';
    /* the Scripts card's own on/off (owner, 2026-10-10: "each script have an
       enable and disable switch on it"): the kit's .sw, on a row that is ONE
       action. Off = the action's `enabled` false, which the Core keeps in the
       config and never runs (zs_act_config.c packs only enabled actions). */
    var swAct = (o.state && one) ? one : null;
    var swOff = !!swAct && swAct.a.enabled === false;
    var head = '<div class="lrow inrow' + (acts ? ' hasseq' : '') + (swOff ? ' saoffrow' : '') + '" data-row="' + ri +
      '" data-act="-1"' + (one ? ' data-sact="' + one.i + '"' : '') +
      ' data-src="' + esc(row.source || '') + '" role="button" tabindex="0" ';
    if (acts) {
      var a = one ? one.a : row.acts[0].a, more = acts - 1, seqName = a.name || 'Untitled Script';
      var off = !!o.state && a.enabled === false;
      var dead = o.state ? deadParts(a, p, S) : null;
      var gone = one ? notSaved(a, p, S) : '';
      /* D134: a scoped room's chips for this action ("Linked: 12 guns",
         its rarity), with their words for a screen reader */
      var tags = (one && S.scope && S.scope.rowTags) ? S.scope.rowTags(a.id) : null;
      return head + 'aria-label="' + esc(nm + ' runs ' + seqName + ' — ' + oneLiner(a, p) +
          (off ? ' Switched off.' : '') + (dead ? ' Will not fire.' : '') +
          (gone ? ' Not saved on your ' + boardWord() + '.' : '') +
          (tags && tags.say ? ' ' + tags.say : '') +
          (more ? ' Plus ' + more + ' more Script' + (more > 1 ? 's' : '') + '.' : '') +
          ' Tap to change it.') + '">' +
        srcCellHTML(row, p) +
        '<span class="src satgt"><span class="intn">' + esc(seqName) +
        (off ? ' <span class="tag saoff">off</span>' : '') +
        (gone ? ' <span class="tag saoff sanotsaved">not saved</span>' : '') + '</span>' +
        (tags && tags.html ? '<span class="sarowtags" aria-hidden="true">' + tags.html + '</span>' : '') +
        /* D256 (owner: "instead of showing me the keybind RT and the timer,
           just have a slider where I can slide the speed"): a Rapid fire row
           is its speed - taps a second, both of its step times at once */
        /* the owner, 2026-10-20: a Lab Script's row says what tapping does,
           not its moves (tapping opens the Lab on its model) */
        (a.fromTemplate === 'recoil-workshop' && a.recoil && typeof a.recoil === 'object'
          ? '<span class="sarowseq"><em class="sarowlab">Adjust recoil control</em>' :
         turboOf(a) ? turboSliderHTML(a, one ? one.i : row.acts[0].i) :
         strengthOf(a) ? strengthSliderHTML(a, one ? one.i : row.acts[0].i) :
        '<span class="sarowseq">' + rowStripHTML(a, p, more ? ROW_FIT - 1 : ROW_FIT)) +
        (more ? '<em class="sarowmore">+' + more + ' more</em>' : '') + '</span>' + chordEm +
        (dead ? '<span class="sarowwarn">' +
          (ZS.warnHTML ? ZS.warnHTML('Will not fire — ' + esc(dead.msg) + dead.fix, 'sa-dead-' + a.id)
                       : note('Will not fire — ' + esc(dead.msg) + dead.fix, 'warn')) + '</span>' : '') +
        (gone ? '<span class="sarowwarn">' +
          (ZS.warnHTML ? ZS.warnHTML('Not saved on your ' + boardWord() + ': ' + esc(gone), 'sa-gone-' + a.id)
                       : note('Not saved on your ' + boardWord() + ': ' + esc(gone), 'warn')) + '</span>' : '') +
        '</span><span class="rt">' + (swAct ? enSwitchHTML(swAct) : '') + '<span class="chev">›</span></span></div>';
    }
    var notBound = unb && !takenBy;
    return head.replace('class="lrow inrow', 'class="lrow inrow' + (takenBy ? ' satakenrow' : '') +
        (notBound ? ' sanotboundrow' : '')) +
      'aria-label="' + esc(notBound
        ? nm + ' is not bound: pressing it sends nothing' +
          (chord ? ' on its own (it has ' + chord + ' shift-layer job' + (chord > 1 ? 's' : '') + ')' : '') +
          '. Tap to bind it.'
        : nm + ' does ' + what +
        (isDef ? ' — this is the normal behaviour' : '') +
        (takenBy ? '. Not active: the Script ' + takenBy.join(', ') + ' takes this button over' : '') +
        '. Tap to change it.') + '">' +
      srcCellHTML(row, p) +
      '<span class="src satgt">' +
      (tgt ? '<span class="glyimg tgtcell">' + tgtSvg(tgt, p) + '</span>' +
             '<span class="intn">' + esc(tgtName(tgt, p)) + '</span>'
           : notBound ? '<span class="sanotbound">Not bound</span>'
           : '<span class="intn" style="color:var(--muted)">nothing on its own</span>') +
      (takenBy ? '<em class="sataken" aria-hidden="true">Replaced by Script: ' + esc(takenBy.join(', ')) + '</em>' : '') +
      chordEm +
      /* D255 (owner, 2026-10-09: "change the off button to a View script
         button that teleports you to that script, exactly where it is") */
      '</span><span class="rt">' + (takenBy
        ? '<button type="button" class="saviewscript" data-viewscript="' + takenAct + '" aria-label="' +
            esc('View the Script ' + takenBy[0]) + '">View script</button>'
        : (isDef ? '<span class="tag">default</span>' : '')) +
      '<span class="chev">›</span></span></div>';
  }

  /* the app's word for this config's input type, never the wire value */
  function inputWord(p) {
    return (ZS.INP && ZS.INP[p.input]) || String(p.input || '');
  }
  /* D287: what each key and mouse button on the keyboard drawing does, from
     the same model the rows are drawn from. A Script that is switched on
     marks its key as a Script (it takes the key over, D244); otherwise the
     key's plain binding, with the target's own picture. */
  function kbdKeys(p, S, model) {
    var out = {};
    model.rows.concat(model.orphans).forEach(function (r) {
