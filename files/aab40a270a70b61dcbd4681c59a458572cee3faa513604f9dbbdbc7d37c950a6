     Authoring a sequence is NOT here — it is the editor sheet below, over
     this screen. (The comment this replaces argued the editor could not be
     a sheet because its sub-pickers need the sheet host. That was right
     about the mechanism and wrong about the conclusion: phone.html's host
     SWAPS content and keeps a stack of close callbacks, so a sub-chooser
     replaces the editor and comes back — see openEditorSheet.) */

  function pillHTML(id, label, value, aria) {
    return '<button type="button" class="sapill" id="' + id + '" aria-label="' +
      esc(aria || (label + ': ' + value)) + '"><i>' + esc(label) + '</i>' +
      '<b>' + esc(value) + '</b><span class="pchev">▾</span></button>';
  }

  var BEHAVE = [
    { k: 'hold', n: 'While I hold it', s: 'the normal way — it is down while your finger is down' },
    { k: 'toggle', n: 'On, then off', s: 'press once for on, press again for off. Nothing to keep held.' },
    { k: 'tap', n: 'Only a quick tap', s: 'a quick tap sends it; holding it can do something else' },
    { k: 'long_press', n: 'Only a long hold', s: 'nothing happens until you have held it for a moment' }
  ];
  /* D283: the short words the Activation row's picker wears beside the
     trigger ("while held ▾"); the sheet keeps the full ones */
  var BEHAVE_SHORT = { hold: 'while held', toggle: 'on, then off', tap: 'quick tap', long_press: 'long hold' };
  function behaveOf(row) {
    var m = row.plainBind ? row.plainBind.b.mode : 'hold';
    for (var i = 0; i < BEHAVE.length; i++) if (BEHAVE[i].k === m) return i;
    return 0;
  }

  /* The four word-pills that used to sit here in sequence mode — Runs, Tag,
     Timing, Helpers — are GONE. Position now carries their meaning: they are
     the four badges round the input's picture on the binding tile, in the
     editor sheet. A pill had to spell out its own label because a wrapping
     row says nothing about what a pill IS; that row is what read as clutter. */
  function inputHeadHTML(p, S, row) {
    var pills = pillHTML('sa-behave', 'Behaves', BEHAVE[behaveOf(row)].n,
                         'how this button behaves: ' + BEHAVE[behaveOf(row)].n);
    /* With a real binding, the key IMAGE is the "move this to a different
       key" control — tap the key to change the key. A seeded pad default
       has no binding to move, so it stays a plain picture. */
    /* D128: RT in a Mouse + Keyboard config is "whatever you have bound to
       RT", named and drawn as the output it is, never "R2 pulled on your
       pad" (sa-mnk.js rowWords; null for every other row) */
    var hw = window.ZS_SA_MNK ? ZS_SA_MNK.rowWords(p, row) : null;
    var art;
    if (row.plainBind && !(SEC.rowUnbound && SEC.rowUnbound(row))) {
      art = '<button type="button" class="sahart saswap" id="sa-move" aria-label="' +
        esc(rowName(row) + ' — tap to move this job to a different ' +
            (isPadSource(row.source) ? 'button' : 'key')) + '">' +
        rowArt(row) + '<span class="saswapchip" aria-hidden="true">⇄</span></button>';
    } else {
      art = '<div class="sahart">' + (hw && hw.art ? hw.art : rowArt(row)) + '</div>';
    }
    /* a ROW, not a column (2026-09-04): 48px art beside the caption and
       the Behaves pill. The stacked head was 172px of a 600px window on a
       screen the owner asked to fit without scrolling. */
    /* XIM's top strip (D78): the input's picture, its NAME and what it is
       ("a key on your keyboard"), and the one control the engine has for
       how the input behaves — bindings[].mode (hold / toggle / tap /
       long_press), the Behaves pill. XIM draws an activation slider here;
       a binding has no such field (profiles/schema.py bindings[]), so
       nothing is drawn for it — never a control that writes nothing. */
    /* THE PANEL'S × (D81): the sub-menu is a pop-up panel over the list
       and XIM draws its close key at the panel's top-left — so it is the
       first thing in the head row, before the picture. #sap-title is
       where focus lands when the panel opens (the dialog's own name, as
       the kit's sheet focuses its heading): the first thing spoken is the
       input, not "Close". */
    /* THE ACTIVATION, AT THE TOP (owner, 2026-10-07: "then you put the LT
       button logo at the top as activation"). While a script is being
       built (S.mode 'smart') the picture in the head is the button that
       STARTS it, so it says so: a quiet "Activation" over the name and a
       thin accent ring round the real art (DESIGN.md: a ring marks, it
       never recolours the drawing). The plain mapping head is unchanged. */
    var act = S.mode === 'smart';
    /* D280 (owner, 2026-10-13: Turn assist "available for users to
       rebind"): while a Script is open, its Activation picture IS the
       control that changes the key that starts it (the same picker as the
       ✕ of an unattached Script, press-to-bind and all). Moving a plain
       binding to another key stays on Mappings, where the job is the
       binding's. */
    if (act && S.draft) {
      art = '<button type="button" class="sahart saswap" id="sa-retrig" aria-label="' +
        esc((S.draft.trigger && S.draft.trigger.unbound ? 'not on a key yet' : rowName(row)) +
            ' — tap to choose the key or button that starts this Script') + '">' +
        (hw && hw.art ? hw.art : rowArt(row)) + '<span class="saswapchip" aria-hidden="true">⇄</span></button>';
    }
    if (act) art = art.replace('class="sahart', 'class="sahart sahact');
    /* D232 (owner, 2026-10-07: "the name should be at the top middle and the
       LT button should be smaller when it's the activation button"). A
       script's head is two rows: ✕, the NAME centred, a spacer the ✕'s
       width; then the activation, small, with its words and Behaves. The
       name button is the one the editor already wires (#sx-name). */
    if (act && S.draft) {
      var nm = (S.draft.name || '').trim();
      /* D283 (owner, 2026-10-13): ONE Activation row. The trigger is drawn
         once (the rebind picture, D280); "Activation · LT · LT on your pad"
         stays for a screen reader in #sap-title, which is where focus lands
         when the panel opens, and is hidden from the eye. Beside the
         trigger, the compact behaviour picker (the same #sa-behave, the
         same choices); the On and Tag chips at the row's right end. */
      var bi = BEHAVE[behaveOf(row)];
      var picker = '<button type="button" class="sapill sxbeh" id="sa-behave" aria-label="' +
        esc('how this button behaves: ' + bi.n) + '"><b>' + esc(BEHAVE_SHORT[bi.k] || bi.n) +
        '</b><span class="pchev" aria-hidden="true">▾</span></button>';
      var chips = SEC.sxChipsHTML ? SEC.sxChipsHTML(S.draft) : '';
      return '<div class="sahead sahrow sxtop">' +
        '<button type="button" class="sapx" id="sap-close" aria-label="' +
          esc('close — back to ' + (S.home === 'inputs' ? 'Mappings' : 'Advanced Script Maker')) + '">✕</button>' +
        '<div class="sxtopname"><button type="button" class="sabname' + (nm ? '' : ' ph') + '" id="sx-name" aria-label="' +
          esc((nm ? 'named ' + nm : 'not named yet') + ' — name, notes and colour') + '">' +
          esc(nm || 'Name it') + '</button></div><span class="sxtopsp" aria-hidden="true"></span></div>' +
        /* D480: one plain sentence saying what the Script does, then the
           When card: the Activation row and how it plays (#sx-when) */
        (SEC.seqSwitchHTML ? SEC.seqSwitchHTML(S, row) : '') +
        (SEC.sxSummaryHTML ? SEC.sxSummaryHTML(p, S, row) : '') +
        '<section class="sxcard sxwhen" aria-label="When"><h3 class="sxch"><span>When</span><em>what starts it, and how it plays</em></h3>' +
        '<div class="sahead sahrow saactivation sxact">' +
        '<div class="sahname visually-hidden" id="sap-title" tabindex="-1">' +
          '<i class="saheye">Activation</i><b>' + esc(hw ? hw.name : rowName(row)) + '</b>' +
          '<span class="sahcap">' + esc(hw ? hw.cap : rowCaption(row)) + '</span></div>' +
        art + picker + '<span class="sxsp"></span>' + chips + '</div>' +
        (SEC.sxWhenHTML ? SEC.sxWhenHTML(S.draft) : '') + '</section>';
    }
    return '<div class="sahead sahrow' + (act ? ' saactivation' : '') + '">' +
      '<button type="button" class="sapx" id="sap-close" aria-label="' +
        esc('close — back to ' + (S.home === 'inputs' ? 'Mappings' : 'Advanced Script Maker')) + '">✕</button>' + art +
      '<div class="sahtext"><div class="sahname" id="sap-title" tabindex="-1">' +
        (act ? '<i class="saheye">Activation</i>' : '') + '<b>' +
        esc(hw ? hw.name : rowName(row)) + '</b>' +
      '<span class="sahcap">' + esc(hw ? hw.cap : rowCaption(row)) + '</span></div>' +
      '<div class="sapills">' + pills + '</div></div></div>';
  }

  /* whenCardHTML and seqChipsHTML lived here and are GONE.

     WHEN was a narrow prose column beside a wide dropdown — a four-words-per-
     line ribbon on the authoring surface. It is now the tile's TOP badge
     (glyph + one word) opening openWhenSheet, which is where the sentence
     between named options actually earns its place. The per-option threshold
     stepper moved into that sheet with it: how long counts as "held" is a
     property OF THE OPTION, not of the screen.

     THE "PRESET CHIPS" were never presets. seqChipsHTML drew one chip per
     sequence ALREADY SAVED on this input, labelled with the action's name —
     and buildTemplate copies a CONSTANT name per template ("Rapid fire",
     "Jump shot"), so a document switcher wore the clothes of a template
     gallery, in the same .safil class as the Ready-made family filter. The
     owner read it exactly right: "we dont need jump shot rapid fire etc on
     there, we are creating our own, those are in the presets."
     The capability it carried is seqSwitchHTML — "‹ 2 of 4 › Rapid fire" in
     the editor sheet, and only when there IS more than one. "＋ Another" is
     now a foot button beside Save, where a creation action belongs. */

  /* ONE SCREEN, NO SCROLL (2026-09-04). Owner: "this sub button tab when
     you click shouldn't be so big, it shouldn't have a scroll up and down —
     scale it all way smaller to fit without scrolling." Measured before:
     1388px of content in a 600px window — head 172, lead 40, header 14,
     card 72, deck 640, note 44, three 52px buttons. What went, and why each
     could: the lead sentence ("Right now Cross does Cross…") — the "Send
     this instead" pill already says what the button does and the head says
     which button; the "What it does" header — one card needs no heading;
     the "want it to do more than one thing…" note — the button under it
     says the same in three words. What shrank: the head is a row, the
     deck's tiles are 40px with 20px art (the .sasimple rules), and the foot
     is the primary button over a PAIR — Paste and Back-to-normal side by
     side, still 44px tall (the DESIGN.md target); their full sentences
     survive as accessible names. Sequences already on the button still
     list under the deck; that is the one case that may scroll. */
  function simpleBodyHTML(p, S, row) {
    var tgt = rowTarget(row), nm = rowName(row);
    var unb = SEC.rowUnbound ? SEC.rowUnbound(row) : false;
    /* XIM's sub-menu, top to bottom (D78): the instruction; the CURRENT
       output big — it is the pill that opens the full target list (stick
       directions, the full pulls, the two Extras); the six-page target
       deck; the sequences already on this button; then "✕ Delete Binding"
       and the Smart Actions Editor placeholder. XIM's output-strength
       slider is NOT drawn: a target is "rt+", the full pull, and nothing
       in the schema scales it. Built to fit 393×852 in app mode without
       scrolling — measured, see D78; the sequence list is the one part
       that may push it over. */
    var h = '<p class="saxlead" id="sa-lead">Choose what it should send.</p>' +
      '<button type="button" class="saxcur" id="sa-tgt" aria-label="' +
        esc('sends ' + (tgt ? tgtName(tgt, p) : 'nothing') + (unb ? ' (not bound)' : '') +
            ' — every other choice, as a list') + '">' +
        '<span class="glyimg">' + (tgt ? tgtSvg(tgt, p) : '') + '</span>' +
        /* D338: a button that sends nothing reads "Not bound" here as on its row */
        '<span class="saxcurt"><i>Sends</i><b>' + esc(tgt ? tgtName(tgt, p) : unb ? 'Not bound' : 'nothing yet') + '</b></span>' +
        '<span class="pchev">▾</span></button>' +
      gridHTML(p, S);
    /* The "move to a different key" control is the key image in the header
       (#sa-move, inputHeadHTML) — the owner asked for it ON the key. */

    /* NO SEQUENCE LIST HERE ANY MORE (D81). XIM's rule: once a button has
       a Smart Action its sub-menu IS the editor — draw() opens a button
       that carries one straight into smart mode, so this plain body is
       only ever drawn for a button with none (and, dimmed and inert,
       behind the Smart Actions screen's own sequence sheet). The list
       that used to sit under the deck was D78's one scrolling exception;
       it had nothing left to list. */
    /* No "Build a sequence", no Paste, no Copy here (owner, 2026-09-04:
       "build a sequence shouldn't exist here — that is what Smart Actions
       are for"). "✕ Delete Binding" is XIM's word for the way back to
       normal — the same dropBinding — and it only shows when there is a
       binding to drop. */
    /* D344 (owner: "I unbound B from everything and it still sent B"):
       two ways out, side by side, and a "?" that says which is which.
       Delete Binding drops the binding, so the button is back to its
       default (a pad button sends itself). Unbind writes the button's
       binding as target "none": the Core then sends nothing for it. Offered
       for a control that has a default to stop (a pad button), and not
       while it is already unbound. */
    var canUnbind = !!row.defTarget && !unb;
    if (row.plainBind || canUnbind) {
      h += '<div class="safoot saunbindfoot">' +
        (row.plainBind
          ? '<button class="btn danger" id="sa-reset" aria-label="' +
            esc('delete this binding — ' + nm + ' goes back to its default' +
                (row.defTarget ? ', ' + tgtName(row.defTarget, p) : '')) + '">' + sicon('delete') +
            '<span>Delete Binding</span></button>' : '') +
        (canUnbind
          ? '<button class="btn" id="sa-unbind" aria-label="' +
            esc('unbind ' + nm + ' — it sends nothing') + '">' + sicon('block') +
            '<span>Unbind (send nothing)</span></button>' : '') +
        '</div>' +
        (typeof ZS.helpHTML === 'function'
          ? '<div class="saunbindq">' + ZS.helpHTML('sa-unbind-help', 'Delete Binding and Unbind',
              '<b>Delete Binding</b> puts ' + esc(nm) + ' back to its default' +
              (row.defTarget ? ': it sends ' + esc(tgtName(row.defTarget, p)) + ' again' : '') + '. ' +
              (row.defTarget ? '<b>Unbind</b> makes ' + esc(nm) + ' send nothing at all; its row says Not bound. ' : '') +
              'To bind it again, pick what it should send above.') + '</div>'
          : '');
    }
    /* THE DOOR (D79). It was the placeholder D78 asked for ("we will expand
       on that later"); the owner came back the same day with XIM's editor
       screenshots: "when you click that smart actions button it takes the
       sub menu and keeps it in place but transforms it with these added
       options". So it transforms THIS screen in place (S.mode = 'smart',
       smartBodyHTML) — no navigation, no sheet. Plain mode stays
       authoring-free and no-scroll (D72/D78); the editor mode is where
       authoring lives on this screen. */
    /* D244: Mappings is one button -> one button; Scripts are made in the
       Scripts room, so neither door is on a Mappings button */
    var onMappings = S.home === 'inputs' && !S.scope && !window.ZS_MAPPINGS_SCRIPTS;
    if (!onMappings) h += '<div class="saxbar"><button type="button" class="btn" id="sa-smarted" ' +
      'aria-label="Scripts Editor — build what this button does, step by step">' + MARK_TARGET +
      '<span>Scripts Editor</span></button></div>';
    /* D170: on the button that FIRES, the Recoil Workshop is the other way
       to give it a Smart Action */
    if (!onMappings && tgt === 'rt+' && workshopOffered(p)) {
      h += '<div class="saxbar"><button type="button" class="btn" id="sa-recoilws" ' +
        'aria-label="Anti-Recoil Lab — trace this gun’s recoil and pull against it">' + sicon('helpers') +
        '<span>Anti-Recoil Lab</span></button></div>';
    }
    return h;
  }

  /* ONE panel, two bodies. Plain mode is XIM's mapping sub-menu (D78) and
     does not scroll. The Smart Actions Editor (D79) is the SAME panel —
     the same head — with the body under the head transformed in place
     (S.mode === 'smart'); that one scrolls inside the panel. Since D81 the
     whole thing is a pop-up over the list (panelDraw), and a button that
     already has a Smart Action is only ever drawn in editor mode. The
     editor SHEET (S.mode === 'sequence') still exists for the Smart
     Actions screen's own rows; draw() opens it above the panel. */
  function inputScreenHTML(p, S, row) {
    /* .sasimple scopes the no-scroll budget (CSS) to this screen alone —
       the editor sheet's palette keeps its 46px tiles, it scrolls anyway.
       .saxed is the editor in place: the same tile sizes, and it may scroll. */
    if (S.mode === 'smart' && S.draft) {
      /* D480: the Scripts room's rose tint (zs-kit section 17) */
      return '<div class="sasimple saxed" data-tint="smart">' + inputHeadHTML(p, S, row) + smartBodyHTML(p, S, row) + '</div>';
    }
    return '<div class="sasimple">' + inputHeadHTML(p, S, row) + simpleBodyHTML(p, S, row) + '</div>';
  }

  /* ── starting a sequence from a button (§the transformation) ───── */
  function beginSequence(p, S, row) {
    var target = rowTarget(row) || 'south';
    var a = newAction();
    a.trigger.src = row.actSrc;      /* the literal control this row IS */
    a.trigger.follow = null;
    /* NO NAME. "R2 sequence" is a name nobody chose, and it is why the list
       read like machine output. Blank is safe by design: problems() WARNS on
       an empty name and never errors (1310–1313 — "a beginner who has just
       built a sequence from a button should not be stopped at the door by a
       naming rule"), and toBoard falls back to the id. The tile shows a
       "Name it" placeholder, which is an invitation rather than a default. */
    a.name = '';
    /* Step 1 is seeded from what this button already sends — XIM seeds the
       same first tile, and it means the sequence starts out doing what the
       button did, so nothing is lost by pressing the button.

       THE BINDING IS NOT DELETED, and that is the one place reading the
       engine pays off. sequences.py's set_takeover consumes the physical
       control for the length of a run, but ONLY when the action's own steps
       drive the same target. So R1→Square plus a sequence that taps Square
       cannot double up; R1→Square plus a sequence that pushes a stick keeps
       the binding working during the run, which is exactly what anti-recoil
       on the fire button needs. Deleting it would break the second case and
       gain nothing in the first. */
    /* The trailing Wait is load-bearing twice over: in turbo it is the gap
       that makes the loop a SERIES of presses instead of one gapless hold
       (the editor already warns about wait-less loops), and in the once
       modes it is harmless. Without it the seeded action's entire output
       was a single 80 ms tap of the very control the player was already
       pressing — set_takeover swallowed it and the action looked dead in
       four of the five When modes (2026-08-04 audit). */
    a.steps = (target === 'lt+' || target === 'rt+')
      ? [{ k: 'trig', t: [target], ms: 120, keep: false }, { k: 'wait', ms: 80 }]
      : [{ k: 'tap', t: [target], ms: 80 }, { k: 'wait', ms: 80 }];
    S.draft = normAction(a);
    S.editIdx = -1;
    S.mode = 'sequence';
    S.unsaved = true;
    S.sel = null;                /* the last real step, chosen by selIndex */
    S.page = 0;                  /* the palette opens on Pad */
  }

  /* Open a button's screen. With an action index it also opens the EDITOR
     SHEET over it — draw() is the one place that happens, so every route in
     (a list row, the pad picture, a paste, a template's Add) lands the same
     way and none of them has to know about the sheet. */
  function openInput(root, p, S, row, actIdx) {
    S.inputSrc = row.source;
    S.screen = 'input';
    S.step = null;
    S.unsaved = false;
    S.sel = null;                 /* the selection belongs to a draft */
    S.page = 0;                   /* and so does the palette page */
    if (actIdx != null && actIdx >= 0 && S.actions[actIdx]) {
      S.editIdx = actIdx;
      S.draft = clone(S.actions[actIdx]);
      S.mode = 'sequence';
    } else {
      S.editIdx = -1;
      S.draft = null;
      S.mode = 'simple';
    }
    draw(root, p);
  }

  /* what the other parts use from this one */
  SEC.BEHAVE = BEHAVE;
  SEC.beginSequence = beginSequence;
  SEC.behaveOf = behaveOf;
  SEC.inputRowHTML = inputRowHTML;
  SEC.inputScreenHTML = inputScreenHTML;
  SEC.inputWord = inputWord;
  SEC.inputsHTML = inputsHTML;
  SEC.openInput = openInput;
  SEC.sameWord = sameWord;
  SEC.seqLineHTML = seqLineHTML;
  SEC.srcCellHTML = srcCellHTML;
});
