/* game-settings-games.js - D468: each game's OWN in-game settings, for the
   form game-settings.js draws (window.ZSGAMESCHEMA).

   Owner, 2026-10-24: "make sure all game settings that it asks for make sense
   according to the settings in that game." And: every game's settings page
   has two tabs, Controller and Keyboard & Mouse (Native Mouse & Keyboard:
   a keyboard and mouse on the Core reach the game as a real keyboard and
   mouse; the scripts and AI still run on top of it).

   A game is { name, ctl, kbm, src }:
     ctl / kbm  a tab: { fields, model(v), help }
       fields   what the game's own menu calls each setting, in its order:
                { k, lab, say, help, type: 'num' | 'sel' | 'key',
                  min, max, step, int, dflt, need, when, old, opts }
                  dflt  the game's FACTORY default, only when a source says so;
                        a blank field with a dflt reads as the default
                  need  false: may be left blank (dflt, or nothing)
                  when  { k, v: [..] }: shown only when field k is one of v
                        (Apex's ALC fields, Fortnite's Advanced ones)
                  old   the D431 key (sensX, sensY, ads, deadzone,
                        deadzoneMax, curve) a v1 save is read back from
                  type 'key': a keybind (Keyboard & Mouse tab), stored in
                        gameSettings.kbm.keys under k
       model(v) the game's numbers -> the D432 scaling model:
                  controller { sensX, sensY, ads, adsY?, deadzone,
                               deadzoneMax, curve }
                  keyboard   { sensX, sensY, ads, dpi }
                One sensitivity in the game -> both X and Y. A game with no
                ADS slider -> ads 1. A game with no deadzone slider -> its
                published or measured zone, fixed (it is the same for the
                maker and the player, so it never changes a script).
     src        where the names, ranges and defaults come from (the report in
                docs/DECISIONS.md D468 has the table and confidence).

   Numbers: a range or default is written only when a source gives it.
   Unknown ranges have no max; unknown defaults have no dflt (the field shows
   an example instead). The aim research is
   ZeroStick Model Library/AIM-CURVES-RESEARCH.md (2026-10-23). */
(function (root) {
  'use strict';

  function n(v, d) { var x = Number(v); return isFinite(x) ? x : d; }
  function ext(a, b) { for (var x in b) { if (Object.prototype.hasOwnProperty.call(b, x)) { a[x] = b[x]; } } return a; }
  function ratio(a, b) { a = n(a, NaN); b = n(b, NaN); return (b > 0 && isFinite(a)) ? a / b : 1; }

  /* ── shared field makers ───────────────────────────────────────────── */
  function num(k, lab, say, o) {
    var f = { k: k, lab: lab, say: say, type: 'num', min: 0, need: true };
    for (var x in o) { if (Object.prototype.hasOwnProperty.call(o, x)) { f[x] = o[x]; } }
    return f;
  }
  function sel(k, lab, say, opts, o) {
    var f = { k: k, lab: lab, say: say, type: 'sel', opts: opts, need: true };
    for (var x in o) { if (Object.prototype.hasOwnProperty.call(o, x)) { f[x] = o[x]; } }
    /* `dflt` given = the game's own default (labelled so); none given = the
       first option is only where the list starts, not a claim */
    f.known = (o && o.known != null) ? !!o.known : f.dflt != null;
    if (f.dflt == null) { f.dflt = opts[0][0]; }
    return f;
  }
  /* D469: a controller profile's gun buttons: which button changes gun.
     Stored in gameSettings.pad.binds as button ids (padBinds()). `known`
     only where the game's default layout is certain. */
  var PAD_BTNS = [['north', 'Y / Triangle'], ['rb', 'RB / R1'], ['lb', 'LB / L1'], ['east', 'B / Circle'], ['west', 'X / Square'],
                  ['south', 'A / Cross'], ['dup', 'D-pad up'], ['ddown', 'D-pad down'], ['dleft', 'D-pad left'], ['dright', 'D-pad right'],
                  ['rs', 'R3 (right stick click)'], ['ls', 'L3 (left stick click)'], ['rt', 'RT / R2'], ['lt', 'LT / L2']];
  function padBind(k, lab, dflt, known, help) {
    return sel(k, lab, 'Controller button', PAD_BTNS, { dflt: dflt, known: known, bind: true, need: false, help: help });
  }
  /* Y / Triangle switches weapon by default in these (High); elsewhere the
     list starts there but claims nothing */
  var Y_KNOWN = /^(cod-|apex-legends$|rainbow-six-siege$|battlefield-6$|halo-infinite$|destiny-2$)/;
  var SWAP_ANY = [padBind('swap', 'Switch Weapon', 'north', false,
    'The controller button that changes gun. The Core reads it to know which gun you hold.')];
  var SWAP_Y = [padBind('swap', 'Switch Weapon', 'north', true,
    'Switch Weapon is the button that changes gun on a controller (Y / Triangle unless you moved it). The Core reads it to know which gun you hold.')];
  function key(k, lab, dflt, help) { return { k: k, lab: lab, type: 'key', dflt: dflt, need: false, help: help }; }
  var ONOFF = [['off', 'Off'], ['on', 'On']];

  /* the Keyboard & Mouse tab's mouse DPI: the mouse's own, not the game's */
  var DPI = num('dpi', 'Mouse DPI', 'Your mouse’s own DPI', {
    min: 50, max: 64000, step: 50, int: true, dflt: 800,
    help: 'DPI is set on the mouse (its button or its software), not in the game. 800 is the most common.'
  });

  /* keybinds every shooter has. TODO(D466, core/hotbar-keybinds): these are
     the keys the Core's keybind -> slot system reads (which key equips which
     gun slot). They are stored in gameSettings.kbm.keys as KeyboardEvent.code
     names (Digit1, KeyE, WheelUp, WheelDown, Mouse4, Mouse5) by
     ZSGAMESET.hotbarKeys(p); the wire to the Core is the hotbar agent's to
     add, nothing here sends them. Controller-side hotbar binds (Rust's and
     Fortnite's cycle buttons) wait for that branch's fields too. */
