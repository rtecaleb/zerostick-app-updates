        }
        var h = APEX_HIP[n(v.look, 3) - 1] || APEX_HIP[2], a = apexAds(n(v.lookAds, 3));
        return { sensX: h[0], sensY: h[1], ads: ratio(a[0], h[0]), adsY: ratio(a[1], h[1]),
                 deadzone: APEX_DZ[v.lookDz] == null ? 10 : APEX_DZ[v.lookDz], deadzoneMax: 100, curve: v.curve || 'classic' };
      }
    },
    kbm: {
