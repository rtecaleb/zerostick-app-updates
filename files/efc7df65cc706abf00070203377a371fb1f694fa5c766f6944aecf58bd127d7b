  /* ── Call of Duty (one form, each game's scale) ────────────────────── */
  var COD_CURVES = [['standard', 'Standard'], ['linear', 'Linear'], ['dynamic', 'Dynamic']];
  function codCtl(o) {
    return {
      fields: [
        num('hs', 'Horizontal Stick Sensitivity', 'Looking left and right', { min: o.min, max: o.max, step: o.step, dflt: o.dflt, old: 'sensX',
          help: o.scaleHelp }),
        num('vs', 'Vertical Stick Sensitivity', 'Looking up and down', { min: o.min, max: o.max, step: o.step, dflt: o.dflt, old: 'sensY' }),
        num('ads', 'ADS Sens. Multiplier', 'While aiming down sights (Low Zoom)', { min: 0, max: 2, step: 0.01, dflt: 1, old: 'ads',
          help: 'ADS Sens. Multiplier: 1.00 means aiming turns at the same rate as your stick sensitivity. If Custom Sensitivity Per Zoom is on, use your Low Zoom value.' }),
        sel('curve', 'Aim Response Curve Type', 'How the stick builds speed', COD_CURVES, { old: 'curve', dflt: 'standard',
          help: 'Standard is the game’s default. Linear turns in a straight line with the stick, which is what the Core’s scripts are made on. Dynamic starts fast and eases.' }),
        num('dzMin', 'Right Stick Min', 'Deadzone: the aim stick’s inner zone', { max: 99, step: 1, int: true, dflt: o.dzMin, old: 'deadzone',
          help: 'Deadzone Inputs > Right Stick Min: how far the aim stick moves before the game turns at all.' + (o.dzHelp ? ' ' + o.dzHelp : '') }),
        num('dzMax', 'Right Stick Max', 'Deadzone: where the stick counts as full', { min: 1, max: 99, step: 1, int: true, dflt: 99, need: false, old: 'deadzoneMax',
          help: 'Right Stick Max: where the game treats the stick as fully pushed. 99 is the default.' })
      ],
      model: function (v) {
        return { sensX: v.hs, sensY: v.vs, ads: v.ads, deadzone: v.dzMin, deadzoneMax: v.dzMax == null ? 99 : v.dzMax, curve: v.curve };
      }
    };
  }
  function codKbm(o) {
    return {
      fields: [
        num('mSens', 'Mouse Sensitivity', 'In Mouse settings', { min: 0.01, max: 100, step: 0.01, dflt: o && o.mDflt, need: true,
          help: 'Mouse Sensitivity, from the game’s Mouse settings.' }),
        num('mAds', 'ADS Sens. Multiplier', 'Mouse, while aiming (Low Zoom)', { min: 0, max: 2, step: 0.01, dflt: 1, need: false }),
        DPI,
        num('fov', 'Field of View', 'Graphics > View', { min: 60, max: 120, step: 1, int: true, dflt: 80, need: false,
          help: 'Field of View changes how far a mouse move turns you while aiming. 80 is the default.' })
      ].concat(slotKeys(['Primary Weapon', 'Secondary Weapon'])).concat(WHEEL).concat([
        key('interact', 'Interact', 'KeyF')
      ]),
      model: function (v) { return { sensX: v.mSens, sensY: v.mSens, ads: v.mAds == null ? 1 : v.mAds, dpi: v.dpi }; }
    };
  }
  var COD_NEW = {
    min: 0, max: 4, step: 0.01, dflt: 1,
    scaleHelp: 'Since Black Ops 6 Season 1 Reloaded (Dec 2024) the stick sensitivity is a decimal from 0.00 to 4.00; 4.00 is the old “20”.'
  };
  var COD_SRC = [
    'ZeroStick Model Library/AIM-CURVES-RESEARCH.md §2-4 (0.0-4.0 scale, Right Stick Min/Max, ADS 1.00)',
        'https://www.dexerto.com/call-of-duty/best-controller-settings-black-ops-6-2884192/'
  ];
  function cod(name, o) {
    return { name: name, ctl: codCtl(o), kbm: codKbm(o), src: COD_SRC, kbmConsole: true };
  }

  /* ── the games ─────────────────────────────────────────────────────── */
  var G = {};

  G['cod-bo7'] = cod('Black Ops 7', ext({ dzMin: 10, dzHelp: 'Black Ops 7 has been measured at 10.' }, COD_NEW));
  G['cod-bo6'] = cod('Black Ops 6', ext({ dzMin: 10 }, COD_NEW));
  G['cod-warzone'] = cod('Warzone', ext({ dzMin: 10, dzHelp: 'Warzone uses its host game’s menu (Black Ops 7 now, Modern Warfare 4 from its Season 1).' }, COD_NEW));
  G['cod-mw4'] = cod('Modern Warfare 4', ext({ dzMin: 15, dzHelp: 'Modern Warfare 4 ships with Right Stick Min at 15.' }, COD_NEW));
  G['cod-mw3'] = cod('Modern Warfare III', { min: 1, max: 20, step: 0.01, dflt: 6, dzMin: 10,
    scaleHelp: 'Modern Warfare III uses the 1 to 20 scale.' });

  /* Black Ops II: one Look Sensitivity, no ADS slider, and no deadzone
     setting on a console (the game's own 0.20). Plutonium on PC has one. */
  G['cod-bo2'] = {
    name: 'Black Ops II',
    ctl: {
      fields: [
        sel('where', 'Where you play', 'Console, or PC through Plutonium', [['console', 'Console (PS3, Xbox 360, Xbox backward compatible)'], ['plutonium', 'PC (Plutonium)']],
          { help: 'On a console Black Ops II has no deadzone setting: the game’s own is 0.20 of the stick. Plutonium on PC has a deadzone slider.' }),
        num('look', 'Look Sensitivity', 'One setting for both directions', { min: 1, max: 14, step: 1, int: true, old: 'sensX',
          help: 'Look Sensitivity runs from 1 to 14 (14 is Insane). It turns left/right and up/down alike, and aiming down sights follows it.' }),
        num('dzMin', 'Stick deadzone', 'Plutonium’s menu, in percent', { max: 100, step: 1, dflt: 20, need: false, old: 'deadzone',
          when: { k: 'where', v: ['plutonium'] },
          help: 'Plutonium’s stick deadzone in percent. The game’s default is 20.' })
      ],
      model: function (v) {
        return { sensX: v.look, sensY: v.look, ads: 1, deadzone: v.where === 'plutonium' ? n(v.dzMin, 20) : 20, deadzoneMax: 100, curve: '' };
      }
    },
    kbm: {
      fields: [
