        DPI,
        num('fov', 'Field of View', 'Plutonium allows 65 to 120', { min: 65, max: 120, step: 1, int: true, dflt: 65, need: false })
      ].concat(slotKeys(['Primary weapon', 'Secondary weapon'])).concat(WHEEL).concat([key('interact', 'Use', 'KeyF')]),
      model: function (v) { return { sensX: v.mSens, sensY: v.mSens, ads: 1, dpi: v.dpi }; }
    },
    src: ['AIM-CURVES-RESEARCH.md §5: the 1-14 scale (Medium), gpad_stick_deadzone_min 0.20 (High)',
          'https://forum.plutonium.pw/topic/14420/stick-deadzone-options'],
    kbmConsole: false
  };

  /* Apex Legends: Classic menus (1-8 presets, five curves, Look Deadzone
     None/Small/Large) or Advanced Look Controls (its own fields). The
     presets ARE turn speeds (looksensitivity.txt), so the model uses them. */
  var APEX_HIP = [[50, 50], [80, 50], [160, 120], [240, 200], [380, 240], [450, 300], [500, 500], [500, 500]];
  /* ADS presets: only 3 (110/75) and 7, 8 (500/500) are published
     (looksensitivity_zoomed.txt); the rest scale the hip preset by
     preset 3's ADS share. Low until measured. */
  var APEX_ADS = { 3: [110, 75], 7: [500, 500], 8: [500, 500] };
  function apexAds(i) { return APEX_ADS[i] || [APEX_HIP[i - 1][0] * 110 / 160, APEX_HIP[i - 1][1] * 75 / 120]; }
  var APEX_DZ = { none: 2, small: 10, large: 20 };
  G['apex-legends'] = {
    name: 'Apex Legends',
    ctl: {
      fields: [
        sel('alc', 'Advanced Look Controls', 'Controller > Advanced Look Controls', ONOFF,
          { dflt: 'off', help: 'Advanced Look Controls off: the game uses Look Sensitivity 1 to 8 and a Response Curve. On: it uses its own Yaw/Pitch speeds, Deadzone, Outer Threshold and Response Curve number, and only those count.' }),
        num('look', 'Look Sensitivity', '1 to 8', { min: 1, max: 8, step: 1, int: true, dflt: 3, old: 'sensX', when: { k: 'alc', v: ['off'] },
          help: 'Look Sensitivity 1 to 8; 3 is the default. Each step is a fixed turn speed in the game’s own table.' }),
        num('lookAds', 'Look Sensitivity (ADS)', '1 to 8', { min: 1, max: 8, step: 1, int: true, dflt: 3, when: { k: 'alc', v: ['off'] } }),
        sel('curve', 'Response Curve', 'How the stick builds speed',
          [['classic', 'Classic'], ['steady', 'Steady'], ['fineaim', 'Fine Aim'], ['highvel', 'High Velocity'], ['linear', 'Linear']],
          { dflt: 'classic', when: { k: 'alc', v: ['off'] }, help: 'Classic is the default (speed grows with the square of the push). Steady is gentler (cube), Linear is a straight line.' }),
        sel('lookDz', 'Look Deadzone', 'The aim stick’s inner zone', [['small', 'Small'], ['none', 'None'], ['large', 'Large']],
          { dflt: 'small', when: { k: 'alc', v: ['off'] }, help: 'Small is the default. The game does not publish their sizes; the Core uses about 2 %, 10 % and 20 %.' }),
        num('dz', 'Deadzone', 'ALC, in percent', { max: 50, step: 2.5, dflt: 15, old: 'deadzone', when: { k: 'alc', v: ['on'] },
          help: 'ALC Deadzone, 0 to 50 %; 15 % is the default.' }),
        num('outer', 'Outer Threshold', 'ALC, in percent', { min: 1, max: 30, step: 1, dflt: 2, when: { k: 'alc', v: ['on'] },
          help: 'Outer Threshold: how close to the edge counts as a full push. 1 to 30 %, default 2 %.' }),
        num('alcCurve', 'Response Curve', 'ALC, a number', { max: 30, step: 1, int: true, dflt: 10, when: { k: 'alc', v: ['on'] },
          help: 'The ALC Response Curve number; 10 is the default. 0 is the straightest.' }),
        num('yaw', 'Yaw Speed', 'ALC, left and right', { max: 500, step: 10, dflt: 160, old: 'sensX', when: { k: 'alc', v: ['on'] } }),
        num('pitch', 'Pitch Speed', 'ALC, up and down', { max: 500, step: 10, dflt: 120, old: 'sensY', when: { k: 'alc', v: ['on'] } }),
        num('extraYaw', 'Turning Extra Yaw', 'ALC, extra speed at a full push', { max: 250, step: 10, dflt: 220, when: { k: 'alc', v: ['on'] },
          help: 'Turning Extra adds speed only near a full push, after the ramp-up time. Scripts make small pushes, so the Core scales them without it.' }),
        num('extraPitch', 'Turning Extra Pitch', 'ALC', { max: 250, step: 10, dflt: 0, when: { k: 'alc', v: ['on'] } }),
        num('adsYaw', 'ADS Yaw Speed', 'ALC, while aiming', { max: 500, step: 10, dflt: 110, when: { k: 'alc', v: ['on'] } }),
        num('adsPitch', 'ADS Pitch Speed', 'ALC, while aiming', { max: 500, step: 10, dflt: 75, when: { k: 'alc', v: ['on'] } })
