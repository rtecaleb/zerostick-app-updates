        num('fov', 'Field of View', 'Video settings', { min: 70, max: 110, step: 1, int: true, need: false })
      ].concat(slotKeys(['Equip Weapon 1', 'Equip Weapon 2'])).concat([key('holster', 'Holster Weapons', 'Digit3')]).concat(WHEEL)
        .concat([key('interact', 'Interact / Pick Up', 'KeyE')]),
      model: function (v) { return { sensX: v.mSens, sensY: v.mSens, ads: v.mAds == null ? 1 : v.mAds, dpi: v.dpi }; }
