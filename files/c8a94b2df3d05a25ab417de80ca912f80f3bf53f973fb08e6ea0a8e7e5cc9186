    var h = '<div class="grp-card ovcard ov-helpcard" id="ov-ratecard">'+
      '<div class="ovcard-t">Update Rate</div>'+
      helpHTML('ov-rate', 'Update rate',
        (mouseCfg ? RATE_MOUSE_HELP+' ' : '')+
        '<b>250 is what a real PlayStation controller does</b> — '+(mouseCfg ? 'the right pace for a controller config. '
          : 'leave it there unless you have a reason. ')+
