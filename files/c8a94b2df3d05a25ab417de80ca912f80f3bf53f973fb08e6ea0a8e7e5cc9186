      btns.forEach(function(b){
        b.addEventListener('click', function(){
          paintArrows();
          /* the data-bind does the writing; this only stops the explanation
             line showing the OLD rate while the write is in flight */
          var sub = root.querySelector('#rate-sub');
          if(sub) sub.innerHTML = rateSubHTML(rateIndex(RATE_MAP[b.textContent]));
          var el = root.querySelector('#rate-live');
          if(el && p.id===ZS.activeId && ZS.live.online!==false){
