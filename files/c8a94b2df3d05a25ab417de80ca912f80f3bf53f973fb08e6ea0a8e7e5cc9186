  function ovWireConnPanel(sb, p, ns){
    var panel = sb.querySelector('.ovpanel');
    if(!panel) return;
    /* rpAcctPaint's alive() reads root.dataset.ns, so the panel carries the
       screen's namespace exactly as #dbody does */
    panel.dataset.ns = ns;
    ZS.wire(panel, ns);
    var full = ZS.live.full[p.id];
    var st = ZS.live.status;
    var live = ZS.live.online!==false && st;

    /* ‹ › over PLAY_FROM: writes BOTH fields through setPlayFrom (console +
       backend, one decision), which redraws the page underneath; the panel
       is redrawn here because which blocks it holds depends on the answer. */
    var car = panel.querySelector('#ov-playcar');
    if(car) car.querySelectorAll('.arr').forEach(function(b){
      b.addEventListener('click', function(){
        var real = playIndex(p, ZS.live.full[p.id]);
        /* D286: stepping from a set-up-only row the panel is SHOWING, not
           from the config's own row */
        var idx = (OV_PLAY_PREVIEW && OV_PLAY_PREVIEW.pid===p.id) ? OV_PLAY_PREVIEW.idx : real;
        /* the same neighbour the arrow was drawn for (playStep skips the
           rows the product lacks); -1 is the end of the strip */
        var nx = playStep(idx, b.getAttribute('data-d')==='1' ? 1 : -1);
        if(nx<0) return;
        OV_PLAY_PREVIEW = null;
        if(playSoon(nx)){
          /* shown, not chosen: the config stays on its own row (setPlayFrom
             refuses this one), and the panel holds the setup door */
          OV_PLAY_PREVIEW = { pid: p.id, idx: nx };
          ovOpenConnPanel(p, null, nx);
          return;
        }
        if(nx===real){ ovOpenConnPanel(p, null); return; }
        setPlayFrom(p, nx);
        /* the board's copy lands on the put's turn; paint the pick now so
           neither the carousel nor the card face shows the old word under a
           finger, then once more from the board's truth */
        ovOpenConnPanel(p, null, nx);
