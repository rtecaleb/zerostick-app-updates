  }
  /* Aiming Stick Upscaling (D190, automatic since D277) has NO card (owner,
     2026-10-14: "the user doesn't need to know that happens in the
     background, only we do"). The Core still does it on a PlayStation while
     the player aims and shoots (pico_upscale.c), so recoil scripts work the
     same on every console; /status picoLink.stickUpscale still reports it. */
  /* `forceIdx` (optional): a PLAY_FROM row just picked, whose write is still
     in flight — the panel draws that row and its blocks now rather than the
     cached backend, so the carousel never shows the old word under a finger. */
  function ovConnPanelHTML(p, forceIdx){
    var st = ZS.live.status;
    var live = ZS.live.online!==false && st;
    var out = live ? (st.outputBackend||{}) : null;
    var full = ZS.live.full[p.id];
