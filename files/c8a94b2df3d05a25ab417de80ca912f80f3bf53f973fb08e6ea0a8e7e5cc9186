/* sections/09-overview.js — the Overview screen (XIM's "Edit Config" page, D84).
 *
 * The banner, the name + colour card (the colour carousel colCarHTML/wireColCar
 * is shared with the wizard, D120), Game Settings, the Connection panel (play
 * from, update rate, Mouse DPI D289; Aiming Stick Upscaling D190/D277 has no card since 2026-10-14), the photo key and the ••• menu
 * (rename, duplicate, paste, share, delete). Polls /status for the live parts.
 *
 * Screens (window.RENDERERS):  R.overview
 * Also offers on ZS:          ZS.ovConnPanelHTML, ZS.ovOpenConnPanel, ZS.ovMoreHTML,
 *                             ZS.ovDuplicate
 * Core / board routes:        /lightbar, /output/enabled, /profiles, /ps5/enabled
 * Tests:                      test-overview-xim.js, test-aim-stance.js, test-rate-selector.js, test-stick-upscale.js, test-config-photos.js, test-device-dpi.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('overview', function (SEC) {
  /* from the files before this one */
  var acc = SEC.acc, accHint = SEC.accHint, armConfirm = SEC.armConfirm,
      askPaste = SEC.askPaste, B = SEC.B, btn = SEC.btn, card = SEC.card, door = SEC.door,
      esc = SEC.esc, helpHTML = SEC.helpHTML, ico = SEC.ico, LB_COLORS = SEC.LB_COLORS,
      liveOutput = SEC.liveOutput, livePad = SEC.livePad, note = SEC.note,
      padArt = SEC.padArt, pic = SEC.pic, R = SEC.R, screenLive = SEC.screenLive,
      seg = SEC.seg, sh = SEC.sh, toggleFld = SEC.toggleFld, txtFld = SEC.txtFld,
      warnNotes = SEC.warnNotes, wireDoors = SEC.wireDoors, ZS = SEC.ZS,
      inputSegHTML = SEC.inputSegHTML, PLAY_FROM = SEC.PLAY_FROM, PLAY_WHY = SEC.PLAY_WHY,
      consolePic = SEC.consolePic,
      playHidden = SEC.playHidden, playIndex = SEC.playIndex, playStep = SEC.playStep,
      playSoon = SEC.playSoon, RP_ROW = SEC.RP_ROW,
      setPlayFrom = SEC.setPlayFrom, wireInputSeg = SEC.wireInputSeg,
      GAME_TR = SEC.GAME_TR, RATE_CHOICES = SEC.RATE_CHOICES,
      RATE_LABELS = SEC.RATE_LABELS, RATE_MAP = SEC.RATE_MAP, RATE_MOUSE_HELP = SEC.RATE_MOUSE_HELP, rateIndex = SEC.rateIndex,
      rateOf = SEC.rateOf, ratePaint = SEC.ratePaint, rateSubHTML = SEC.rateSubHTML,
      isScratchConfig = SEC.isScratchConfig, openGameAdopt = SEC.openGameAdopt,
      ovGameOf = SEC.ovGameOf, packOfConfig = SEC.packOfConfig, calCount = SEC.calCount,
      rpAcctPaint = SEC.rpAcctPaint, gamePreset = SEC.gamePreset;

  /* ── Overview — XIM Matrix's "Edit Config" page, on the owner's screenshots (D84, 2026-09-05) ──
     Owner, verbatim: "the overview tab needs to be more like this: move the
     controller into a collapsible menu in advanced somewhere, and have it be
     at the top, front and center, the gamepack (like this one is MW2 in the
     photo), and then below that the config name and color, and below that we
     don't need aiming sources, just have the connection method tab like ours
     but make it look more like the screenshot … and obviously keep the
     connect PlayStation 5 settings there for when someone is on PS5 for
     remote play, and info; and remove the 'adapter is sending inputs' option
     to advanced, deep into settings, because it's rare anyone would ever
     want that off, they would just unplug it."

     TOP TO BOTTOM, and where every old control went (nothing was deleted;
     tools/test-overview-xim.js holds the inventory and refuses a loss):
       1. THE GAME BANNER (#ov-banner) — the game this config is for, set
          large over a picture. The picture is, first, the player's OWN
          photo, the one the config photo picker keeps in the app and never
          sends to the adapter (ZS.openPhotoSheet, D120); failing that, the
          GAME PACK'S picture, which
          is the publisher's artwork (D116, the owner's call, which reversed
          D84's "never a publisher's box art" for configs made from a pack);
          failing that, our own art: the config's colour as a dark gradient
          with the game's initial engraved behind the name. Every picture
          sits under a scrim so the words stay legible. The camera key in
          the corner is #id-photo, the same control the old This-config card
          had. Tapping the banner IS the way to set the game: a config made
          before game packs opens the one-time "Choose a game" sheet
          (openGameAdopt, the board's one-way latch); a config that has its
          game opens Match Your Game (R.game, aim presets for it); Default
          never latches and a scratch config chose no game, so both open the
          presets.
       2. NAME AND COLOUR (#ov-idcard) — the name big and centred over a rule
          (edited under ••• → Name, the same .id-name field as before), the
          ‹ swatch › colour carousel, then Duplicate and •••. THE CAROUSEL
          WRITES A REAL FIELD: lighting.color, the same block R.lighting
          writes and the same /lightbar route, so the mark in your list and
          the light on your pad follow it exactly as XIM's config colour
          drives the MATRIX's light. R.lighting keeps on/off, brightness and
          rainbow behind ••• → Light bar.
       3. GAME SETTINGS (#ov-gamecard) — the game row with its lock (the
          one-way latch, D-schema v9), the adopt-once button on a gameless
          config, the aim-preset row (a door to R.game), and for a mouse
          config the in-game requirement that is really written down: the
          calibration pack's own "only true at" line when it has one, else
          the honest cm/360 sentence, with the Aim Speed Match door under
          it. Draws only what exists — no STANDARD pill was invented.
       4. CONNECTION METHOD (#ov-conn) — the boxed line (#ov-connbox) names
          where the inputs go and what you play with, and opens THE PANEL;
          under it "What you play with" (.inputseg) — its ONLY home (screen
          map §12), on the page so the page owns it, not the sheet.
          THE PANEL (ovConnPanel, the kit's sheet): "Console Connection" as a
          ‹ › carousel over PLAY_FROM (setPlayFrom writes console + backend,
          the same write path the seg used) with a line saying what the
          board presents as; the PlayStation 5 block on Remote Play (the PSN
          account row, the Remote Play switch — unchanged in function); the
          wired-adapter / Xbox / PC notes.
       3b. UPDATE RATE (#ov-ratecard) and, on a mouse config, MOUSE DPI
          (#ov-dpicard), on the page between the name-and-colour card and
          Connection Method (D340, owner 2026-10-14; they were inside the
          panel until then). The rate is a ‹ 250 Hz › carousel whose arrows
          step the SAME bound .seg2 (output.rateHz), so the binding, the
          truth line and the honest copy are untouched.
       5. The D70 warning chips, live feedback, on the page.
       6. ADVANCED (an acc(), closed by default): the controller picture and
          its live line, "Sending to the console" — the kill switch, binding
          and words unchanged — the PC-only What-the-game-sees door and the
          Controllers & pairing door.
       The card's keys (D263, owner 2026-10-10: "the More tab should be one
          that opens, not a sub menu ... copy and paste buttons need to be more
          out there in the Device tab"): Duplicate, Copy, Paste and More. More
          opens IN PLACE under them (ovMore, no sheet): Name, Description (it
          shows under the name on this card - "where is that description even
          seen?"), Copy summary, Light (the Lighting door, and on a Core that
          reads it, the controller / EXO colours), and the Danger zone. */
  var ovPollTimer = null;
  /* OV_TAB is kept as a module var because Global Settings ▸ Performance
     still sets it to 'Advanced' before opening this screen (its door to the
     update rate). There is no pager any more: 'Advanced' now means "scroll
     to the Update Rate card" (D340: on the page, no longer in the
     Connection panel), and it resets after. */
  var OV_TAB = 'Now';
  /* the Advanced fold's open state, per config, so a redraw (input type,
     play-from, the 8 s poll's repaint) keeps it where the finger left it */
  var OV_ADV_OPEN = {};
  /* The Connection panel is a sheet, and two things inside it close the
     sheet and redraw this screen (the PSN account picker on its pick, and
     "add another account" on its way to the psnlink screen). The player
     opened those FROM the panel, so the panel comes back when the screen
     does. Consumed by the next render. */
  var OV_REOPEN_CONN = false;
  /* D263: More is open under the card's keys, per config, so the poll's
     repaint keeps it where the finger left it */
  var OV_MORE_OPEN = {};
  /* the config the open panel belongs to (null = no panel); the poll paints
     #rate-live only while the panel is open for the running config */
  var OV_CONN_FOR = null;
  /* D286: the set-up-only row the panel's carousel is showing ({pid, idx}),
     or null when it shows the config's own row */
  var OV_PLAY_PREVIEW = null;

  /* ── small helpers ─────────────────────────────────────────────── */

  /* the same rule phone.html's gameInitial() applies to the tile monogram */
  function ovInitial(s){
    s = String(s == null ? '' : s).replace(/^\s+/, '').replace(/^(the|a|an)\s+/i, '');
    var m = /[A-Za-z0-9]/.exec(s);
    return m ? m[0].toUpperCase() : '';
  }
  /* the photo key's camera: the set's picture (D91 — it was our own stroke
     drawing until the owner asked for real pictures everywhere) */
  function ovCameraSVG(){ return pic('photo', 24); }
  /* the device marks the connection line wears: what you play WITH */
  function ovInputIcons(p, px){
    var h = '';
    if(ZS.inputShows(p.input, 'mouse')) h += ico('mouse', px) + ico('keycap', px);
    if(ZS.inputShows(p.input, 'controller')) h += ico('pad', px);
    return h;
  }
  /* what the board PRESENTS AS, per PLAY_FROM row — the panel's one line */
  var PLAY_PRESENTS = [
    /* D399 (owner): the dongle is in the box, said plainly on the row */
    'Presents as a licensed pad to your PS5 through the wired adapter and the P5General dongle. '+
    'The P5General is included with every ZeroStick PS5-compatible device.',
    'Presents as a licensed pad to the Xbox through the wired adapter.',
    'Presents as a licensed pad to the PS4 through the wired adapter.',
    'Presents as an Xbox 360 controller to Windows.',
    /* D399 */
    'Presents as a wired Nintendo Switch controller to your Nintendo Switch 2.',
    /* D349 */
    'Presents as a wired controller to your Nintendo Switch.',
    'Presents as a wired controller to your PS3.',
    'Presents as a wired Xbox 360 controller to a PC or a device that accepts one.',
    'Presents as the console your controller belongs to.',
    'Presents as a DualSense to your PS5 over Remote Play.'
  ];
  /* The D90 honesty chip that lived here (PICO_UNPROVEN_WARN, "Not yet proven
     on a PS5", 2026-09-06) was RETIRED on 2026-09-08 (D92 addendum 4): that
     night the wired path was witnessed end to end on the PS5 — the A7S's
     frames over the UART at 1.5 Mbps, the Pico signing in through the
     Besavior, the console obeying (STATUS 2026-09-08). Nothing draws a warning
     for the wired adapter any more; the ov-pico "?" help describes it. */
  /* the solid light-bar colours the carousel steps through — the same list
     R.lighting draws, minus Rainbow (a mode, not a colour; it stays there) */
  function ovColorList(){
    var out = [], i;
    for(i=0;i<LB_COLORS.length;i++) if(LB_COLORS[i].v!=='rainbow') out.push(LB_COLORS[i]);
    return out;
  }
  function ovColorIndex(hex){
    var list = ovColorList(), i, h = String(hex||'').replace('#','').toLowerCase();
    for(i=0;i<list.length;i++) if(list[i].v===h) return i;
    return -1;
  }
  /* The colour the carousel SHOWS and steps from: the pad light's own field
     (lighting.color) when the board holds it, else the list mark. The two
     agree after any step here; before one they can differ (a config that
     never chose gets the schema's blue on the pad and a palette mark in the
     list), and the control must show the field it writes. R.lighting's
     colour row reads the same field, so the door "set on Overview" is true. */
  function ovColorCurrent(p){
    var full = ZS.live.online!==false ? ZS.live.full[p.id] : null;
    var lg = (full && full.lighting) || {};
    if(typeof lg.color==='string' && /^[0-9a-fA-F]{6}$/.test(lg.color)) return '#'+lg.color.toLowerCase();
    return p.color || '';
  }

  /* ── the banner ────────────────────────────────────────────────── */
  function ovBannerHTML(p, full){
    var game = ovGameOf(p, full);
    /* the player's choice, kept with the picture in the app (D120) */
    var kind = ZS.photoKind ? ZS.photoKind(p.id) : ((full && full.artwork && full.artwork.kind) || '');
    var photo = (ZS.hasPhoto && ZS.hasPhoto(p.id) && kind!=='mark' && ZS.photoURL) ? ZS.photoURL(p.id) : '';
    /* the game pack's picture (D116) stands in for a photo the player has
       not taken; it is only offered once it has actually loaded */
    if(!photo && window.ZSPACKS) photo = ZSPACKS.artFor({ pack: p.pack, gamePack: full && full.gamePack, game: game }, 'wide');
    var isDefault = p.id==='default';
    var scratch = !game && isScratchConfig(p, full);
    var title = game || (isDefault ? 'Any game' : (scratch ? 'Your own config' : 'No game yet'));
    var cap = game
      ? 'Tap for aim presets made for it'
      : (isDefault ? 'The Default config stays general. Tap for aim presets.'
         : scratch ? 'Started from scratch, with no game. Tap for aim presets.'
                   : 'Tap to choose the game this config is for');
    var initial = ovInitial(game || p.name);
    return '<div class="ovbanwrap">'+
      '<button type="button" class="ovban'+(photo?' photo':'')+'" id="ov-banner" '+
        'style="--cfg:'+esc(p.color||'#4a5568')+'" '+
        'aria-label="'+esc((game ? 'Game: '+game : title)+' — '+cap)+'">'+
        /* THE PICTURE WHOLE, THE WORDS UNDER IT (D121). The banner used to
           cover-crop the wide art to its own ~2.9:1 box and then write the
           game's name across the middle of it, which is where most games
           keep their title. Now the picture sits at its own wide shape,
           contained over a blurred copy of itself (so a 16:9 banner or a
           square photo is whole too), and the words sit on that blurred
           ground below it, behind their own scrim. Nothing covers the art. */
        (photo
          ? '<img class="ovban-bg" src="'+esc(photo)+'" alt="" aria-hidden="true">'+
            '<span class="ovban-pic"><img class="ovban-img" src="'+esc(photo)+'" alt=""></span>'
          : (initial ? '<span class="ovban-mono" aria-hidden="true">'+esc(initial)+'</span>' : ''))+
        '<span class="ovban-txt">'+
          (photo ? '<span class="ovban-scrim" aria-hidden="true"></span>' : '')+
          '<b>'+esc(title)+'</b><em>'+esc(cap)+'</em></span>'+
      '</button>'+
      '<button type="button" class="ovban-photo" id="id-photo" '+
        'aria-label="'+(ZS.hasPhoto && ZS.hasPhoto(p.id) ? 'Change photo' : 'Add a photo')+'">'+
        ovCameraSVG()+'</button>'+
      '</div>'+
      ovStatusHTML(p, full);
  }
  /* D394: the game's status in words, one small line under the banner
     ("Ready to use", "Calibration done · AI scripts waiting", "Not
     started"); nothing for a config with no game */
  function ovStatusHTML(p, full){
    var words = ZS.configStatusWords ? ZS.configStatusWords({ pack: p.pack, gamePack: full && full.gamePack,
      game: ovGameOf(p, full) }) : '';
    if(!words) return '';
    return '<div class="ov-status" id="ov-status" style="margin:6px 2px 0;font-size:12.5px;color:var(--muted)">'+
      esc(words)+'</div>';
  }

  /* ── THE CONFIG COLOUR CAROUSEL: one control, two homes ─────────────
     D84 made Overview's ‹ swatch › the one control over lighting.color. D120
     puts the SAME control in the new-config wizard, beside the name, so the
     colour is chosen as the config is made (the owner, 2026-09-23: "make
     sure they get to choose the colour for the profile, as the final EXO
     will have an onboard LED light"). Same list (ovColorList, the solid
     light-bar colours), same markup, same wiring, so a player who learns it
     in one place already knows it in the other. What a pick DOES is the
     caller's: Overview writes the stored config (ovSetColor), the wizard
     only remembers the choice until Create.

     `cur` is '#rrggbb' or ''. A colour off the list reads "Your colour". */
  function colCarName(cur){
    var i = ovColorIndex(cur);
    return i>=0 ? ovColorList()[i].t : 'Your colour';
  }
  function colCarHTML(id, cur){
    var list = ovColorList();
    var idx = ovColorIndex(cur);
    var swatch = idx>=0 ? list[idx].css : (cur||'#4a5568');
    var name = colCarName(cur);
    return '<div class="smcar ovcol" id="'+esc(id)+'" data-noswipe="1">'+
        '<button type="button" class="arr" data-d="-1" aria-label="previous colour">‹</button>'+
        /* the swatch is the wheel's face: a tap opens the native colour
           picker for a colour off the seven-list. This is the ONE "any
           colour" in the app since R.lighting's wheel folded into it (D84
           follow-up, 2026-09-05); a wheel pick goes through the caller's
           onPick exactly as the arrows do, so each home keeps one writer. */
        '<button type="button" class="ovsw" aria-label="'+esc('Colour: '+name+' — tap for any colour')+'" '+
          'style="background:'+esc(swatch)+'"></button>'+
        '<input type="color" class="ovpick" value="'+esc(/^#[0-9a-f]{6}$/i.test(cur) ? cur : '#0080ff')+'" '+
          'tabindex="-1" aria-hidden="true" data-nosave="1">'+
        '<button type="button" class="arr" data-d="1" aria-label="next colour">›</button>'+
      '</div>';
  }
  /* The arrows step the list; a colour that is not on it (the wheel, or the
     palette fallback) steps onto the list from either end. The wheel fires
     onPick(c, false) as it moves and onPick(c, true) when it settles; the
     arrows always commit. The swatch and the hidden input are repainted
     HERE, after onPick, so the caller only paints what is its own. */
  function wireColCar(cc, cur, onPick){
    /* the colour this control believes in, kept here: a write the caller
       debounces must not make two quick taps step from the same spot */
    var curCol = cur;
    function paint(c){
      curCol = '#'+c.v;
      var sw = cc.querySelector('.ovsw');
      if(sw){ sw.style.background = c.css; sw.setAttribute('aria-label', 'Colour: '+c.t+' — tap for any colour'); }
      var pk = cc.querySelector('.ovpick');
      if(pk) pk.value = '#'+c.v;
    }
    cc.querySelectorAll('.arr').forEach(function(b){
      b.addEventListener('click', function(){
        var list = ovColorList();
        var i = ovColorIndex(curCol);
        var d = b.getAttribute('data-d')==='1' ? 1 : -1;
        var nx = i<0 ? (d>0 ? 0 : list.length-1) : (i+d+list.length)%list.length;
        var c = list[nx];
        onPick(c, true);
        paint(c);
      });
    });
    var swb = cc.querySelector('.ovsw'), pick = cc.querySelector('.ovpick');
    if(swb && pick){
      swb.addEventListener('click', function(){ pick.click(); });
      function fromWheel(commit){
        var hex = String(pick.value||'').replace('#','').toLowerCase();
        if(!/^[0-9a-f]{6}$/.test(hex)) return;
        var list = ovColorList(), i = ovColorIndex(hex);
        var c = i>=0 ? list[i] : {v:hex, t:'Your colour', css:'#'+hex};
        onPick(c, commit);
        paint(c);
      }
      pick.addEventListener('input',  function(){ fromWheel(false); });
      pick.addEventListener('change', function(){ fromWheel(true); });
    }
  }

  /* ── the name + colour card ────────────────────────────────────── */
  /* WHAT THIS CONFIG TAKES ON THE CORE (D133). The owner asked to see how
     much room a config uses instead of meeting a count of 32 or 16, so a
     Core's Overview says it under the colour, from the Core's own list row
     (or what a save would store, for a config it does not have yet). An EXO
     keeps configs as JSON on an SD card and has nothing to say here. */
  function ovSizeHTML(p){
    if(!(ZS.productId && ZS.productId()==='core') || !window.ZSROOM) return '';
    var sz = ZSROOM.configBytes(p.id);
    if(!(sz > 0)) return '';
    var full = ZS.live.full[p.id];
    var near = full ? ZSROOM.near(ZSROOM.room(full)) : [];
    /* D236 (owner, 2026-10-09: "all the text below the dot ... it's self
       explanatory"): the size line left this card - the Configs list still
       says what each config takes - and only a near-full warning chip stays */
    return near.length ? note(near.map(function(s){ return esc(s); }).join(' '), 'warn') : '';
  }
  /* D263: the card's keys wear plain line glyphs (D259's flat look) */
  var OV_GLYPH = (function(){
    function svg(d){
      return '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" '+
        'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'+d+'</svg>';
    }
    return {
      dup: svg('<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>'+
               '<path d="M14 11v6M11 14h6"/>'),
      copy: svg('<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>'),
      paste: svg('<path d="M9 4h6v3H9z"/><path d="M15 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/>'+
                 '<path d="M12 11v6M9 14l3 3 3-3"/>'),
      more: svg('<circle cx="6" cy="12" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/>'+
                '<circle cx="18" cy="12" r="1.3" fill="currentColor"/>')
    };
  })();
  function ovIdCardHTML(p){
    var cur = ovColorCurrent(p);
    var full = ZS.live.full[p.id];
    var desc = (full && full.description) || '';
    var open = !!OV_MORE_OPEN[p.id];
    return '<div class="grp-card ovid" id="ov-idcard">'+
      '<h2 class="ovid-name" id="ov-name">'+esc(p.name)+'</h2>'+
      /* D263: the description is SEEN - here, under the name */
      '<p class="ovid-desc" id="ov-desc"'+(desc ? '' : ' hidden')+'>'+esc(desc)+'</p>'+
      '<div class="ovid-rule" aria-hidden="true"></div>'+
      colCarHTML('ov-colcar', cur)+
      /* D236: no words under the dot; its name rides the carousel's label */
      ovSizeHTML(p)+
      '<div class="ovid-acts">'+
        '<button type="button" class="ovact" id="ov-dup" aria-label="Duplicate this config">'+
          '<b aria-hidden="true">'+OV_GLYPH.dup+'</b>Duplicate</button>'+
        '<button type="button" class="ovact" id="id-copy" aria-label="Copy this config, to paste or share">'+
          '<b aria-hidden="true">'+OV_GLYPH.copy+'</b>Copy</button>'+
        '<button type="button" class="ovact" id="id-paste" aria-label="Paste a config you copied, as a new config">'+
          '<b aria-hidden="true">'+OV_GLYPH.paste+'</b>Paste</button>'+
        '<button type="button" class="ovact" id="ov-more" aria-expanded="'+(open?'true':'false')+'" '+
          'aria-controls="ov-morepanel" aria-label="More — name, description, light, delete">'+
          '<b aria-hidden="true">'+OV_GLYPH.more+'</b>More</button>'+
      '</div>'+
      '<div class="ovmorepanel" id="ov-morepanel"'+(open ? '' : ' hidden')+'>'+(open ? ovMoreHTML(p, full) : '')+'</div>'+
    '</div>';
  }

  /* ── Game Settings ─────────────────────────────────────────────── */
  function ovGameCardHTML(p, full){
    var gameNow = ovGameOf(p, full);
    /* THE GAME IDENTITY — chosen once, a one-way latch the BOARD enforces
       (schema v9, ProfileStore._store_unlocked). A read-only stat row, never
       a disabled control: the text IS the affordance. `default` never
       latches (it can never be deleted, so under the delete-and-recreate
       rule it must never be permanently branded) and says why. */
    var gameStat = gameNow
      ? '<div class="stat"><span>Game</span><b>'+esc(gameNow)+
        ' <span aria-hidden="true">🔒</span></b></div>'
      : '<div class="stat"><span>Game</span><b>'+
        (p.id==='default' ? 'None' : 'None — general config')+'</b></div>';
    var gameTail = gameNow
      ? note('Locked to <b>'+esc(gameNow)+'</b> for life. Another game? — create a new '+
