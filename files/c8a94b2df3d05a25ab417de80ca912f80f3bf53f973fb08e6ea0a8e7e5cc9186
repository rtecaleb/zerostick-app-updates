        seg('Update rate', RATE_LABELS, lit, false, B('output.rateHz', 1, {t:'str', map:RATE_MAP}))+
        '<button type="button" class="arr" data-d="1" aria-label="faster update rate"'+(lit>=RATE_LABELS.length-1?' disabled':'')+'>›</button>'+
      '</div>'+
