  /* a pasted or duplicated document becomes a NEW config on the board: a
     fresh id and name, so it can never overwrite one you already have */
  function ovImportDoc(obj, verb){
    if(ZS.live.online===false){ ZS.toast('Board offline — this needs the board'); return; }
    if(!obj || typeof obj!=='object' || Array.isArray(obj)){
      ZS.toast('That is not a ZeroStick config — copy one with ⧉ Copy config'); return;
    }
    obj.name = (obj.name ? obj.name : 'Imported config');
    /* A FRESH ID, MADE HERE. The board's create() validates `id` and refuses
       a document without one (profiles/schema.py: "id must be 1-64 chars"),
       so the old Paste path — which deleted the id and hoped — was refused
       by every real board. The wizard's own recipe: a slug of the name plus
       four random characters, so a copy can never overwrite its original. */
    obj.id = (String(obj.name).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,24)||'config')
             +'-'+Math.random().toString(36).slice(2,6);
    /* the photo lives on the board under the OLD id; a new config starts
       with the mark, never a picture that is not there */
    delete obj.artwork;
    /* M9 (audit 2026-10-10): the same create path the wizard takes
       (ZS.createProfileDoc): a Core takes the bytes by id, an EXO the JSON
       POST. A POST /profiles on a Core was refused every time. A Core's
       save has already said the adapter's own sentence on a refusal. */
    var core = !!(ZS.productId && ZS.productId()==='core');
    var create = ZS.createProfileDoc ? ZS.createProfileDoc(obj) : ZS.api('/profiles','POST',obj);
    create.then(function(j){
      j = j || {ok:false};
      if(!j.ok){
        if(!core) ZS.toast('Board refused: '+(j.error||(j.errors&&j.errors[0])||'invalid config'));
        return;
      }
      ZS.toast((verb||'Imported')+' "'+obj.name+'"');
      var re = ZS.reloadProfiles ? ZS.reloadProfiles() : null;
      if(!re) ZS.refreshStatus();
    });
  }
  /* Duplicate: the SAME path Paste config takes — the config's own full
     document, POSTed as a new one with a fresh id and "(copy)" on the name.
     No Configs-screen duplicate existed to reuse; this is the import path. */
  function ovDuplicate(p){
    var full = ZS.live.full[p.id];
    if(ZS.live.online===false || !full){ ZS.toast('Board offline — duplicating needs the board'); return; }
    var obj = JSON.parse(JSON.stringify(full));
    obj.name = (p.name||obj.name||'Config')+' (copy)';
    ovImportDoc(obj, 'Duplicated as');
  }
