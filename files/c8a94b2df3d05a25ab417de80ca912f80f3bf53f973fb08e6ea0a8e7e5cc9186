       document-wide, so nothing more to wire */
  }
  /* D340 (owner, 2026-10-14: "pull Mouse DPI and refresh rate out of
     Connection Method, idk why it's hidden in there"): the Update Rate and
     Mouse DPI cards sit on the Device page itself, under the name-and-colour
     card and over Connection Method. Same writers, same ids, same "?"s; this
     wires them where the panel used to. */
  function ovWireRateDpi(root, p){
    /* the rate arrows step the bound seg; the seg's own click does the write */
    var rc = root.querySelector('#ov-ratecar');
    if(rc){
      var seg = rc.querySelector('.seg2');
      var btns = seg ? [].slice.call(seg.querySelectorAll('button')) : [];
      function litIndex(){
        for(var i=0;i<btns.length;i++) if(btns[i].classList.contains('on')) return i;
        return -1;
      }
      function paintArrows(){
        var i = litIndex();
        rc.querySelectorAll('.arr').forEach(function(a){
          var d = a.getAttribute('data-d')==='1' ? 1 : -1;
          a.disabled = (i<0) ? false : (i+d<0 || i+d>=btns.length);
        });
      }
      rc.querySelectorAll('.arr').forEach(function(a){
        a.addEventListener('click', function(){
          var i = litIndex(), d = a.getAttribute('data-d')==='1' ? 1 : -1;
          var nx = i<0 ? 1 : i+d;
          if(nx<0 || nx>=btns.length) return;
          btns[nx].click();
