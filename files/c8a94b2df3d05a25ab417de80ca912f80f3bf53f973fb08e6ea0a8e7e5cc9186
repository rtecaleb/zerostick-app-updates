    }
    /* D289: Mouse DPI. A preset is taken at once, a typed number when the
       field is let go (not at every key: 3, 32, 320 are not what was
       meant); both through ZS_DPI.saveTo, the Aim page's own writer. */
    if(window.ZS_DPI && root.querySelector('#ov-dpicard')){
      ZS_DPI.wirePicker(root, 'ov-dpi', function(v, how){
        if(!v || how === 'typing') return;
        ZS_DPI.saveTo(p.id, v);
