  /* ── the colour carousel's write — the same recipe R.lighting's push()
     uses for a solid colour: the profile's lighting block (brightness and
     speed kept), the list mark, the offline fallback, and the pad itself
     when this is the config that is running ─────────────────────── */
  function ovSetColor(p, c, quiet){
    var col = c.v;
    function setLighting(f){
      var lg = f.lighting || {};
      f.lighting = { mode:'solid', color:col,
                     brightness: Math.round(typeof lg.brightness==='number' ? lg.brightness : 100),
                     speed: Math.round(typeof lg.speed==='number' ? lg.speed : 20) };
    }
    var hasDoc = ZS.live.online!==false && !!ZS.live.full[p.id];
    /* THE CACHED DOCUMENT MOVES FIRST, or the mark does not follow: the list
       mark is RE-DERIVED from the cached board document on every home draw
       (profileColor(): the document's lighting.color wins over the stored
       fallback), so ZS.saveProfiles() at the foot of this function would
       put the OLD colour straight back on p.color.
       M5 (audit 2026-10-10): it moves through the staged write (D257),
       which applies the change to a COPY and swaps it in at once. It used to
       be changed in place first, so the copy "exit without saving" goes back
       to already held the new colour, and the app and the board disagreed
       after a discard. Only the old autosave mode (ZS_AUTOSAVE, where there
       is no discard) still needs the cache moved by hand, because its write
       is 600 ms away. */
    if(hasDoc){
      if(window.ZS_AUTOSAVE) setLighting(ZS.live.full[p.id]);
      ZS.putProfileDebounced(p.id, setLighting);
    }
    /* The stored fallback is for when there is no document to carry the
       colour (offline), and for the shipped blue, which profileColor()
       reads as "never chosen" and would otherwise swap for a palette mark.
       Written with a document too, it outlived a discard. */
    if(!hasDoc || String(col).toLowerCase()==='0080ff'){
      ZS.store.vals['lightbarMode|'+p.id] = 'solid';
      ZS.store.vals['lightbar|'+p.id] = col;
      ZS.store.vals['pcolor|'+p.id] = '#'+col.toLowerCase();
      ZS.persistStore();
    }
    p.color = '#'+col.toLowerCase();
    var later = (hasDoc && !window.ZS_AUTOSAVE) ? ' — press Save to keep it' : '';
    if(hasDoc){
      /* the pad shows it at once where the adapter has a live preview (a
         Core since D262: POST /lightbar, until Save; "exit without saving"
         sends {revert:true}, shell/06-core-configs.js discardUnsaved) */
      if(p.id===ZS.activeId && !(ZS.productHides && ZS.productHides('lightbarPreview'))){
        var lg0 = (ZS.live.full[p.id].lighting)||{};
        ZS.api('/lightbar','POST',{ mode:'solid', color:col,
          brightness: Math.round(typeof lg0.brightness==='number' ? lg0.brightness : 100),
          speed: Math.round(typeof lg0.speed==='number' ? lg0.speed : 20), enabled:true })
          .then(function(j){ if(!quiet) ZS.toast(j && j.ok ? 'Colour → '+c.t+later : ((j && j.error) || 'Board did not take it')); })
          ['catch'](function(){ if(!quiet) ZS.toast('Saved on this device'); });
      } else if(!quiet) {
        ZS.toast('Colour → '+c.t+later);
      }
    } else if(!quiet) {
      ZS.toast('Colour → '+c.t+' — saved on this device, your board is offline');
    }
    ZS.saveProfiles();     /* HOME and the list mark follow */
  }

  /* the kill switch is drawn only where the adapter has the route (M8) */
  function killShown(){ return !(ZS.productHides && ZS.productHides('killSwitch')); }
  R.overview = function(p){
    var st = ZS.live.status;
    var live = ZS.live.online!==false && st;
    var full = ZS.live.full[p.id];
    var killOn = live ? st.outputEnabled!==false : true;
    var running = live && p.id===ZS.activeId;   /* the board runs one config at a time */

    /* ADVANCED — closed by default, and the rarely touched: the controller
       picture, the sending switch, the PC-only output identity, pairing. */
    var hAdv =
      sh('Your controller')+
      '<div class="vizbox" style="text-align:center">'+padArt(p)+
        '<div style="color:var(--muted);font-size:12px;margin-top:2px">'+
          (running ? '<span style="color:var(--green)">●</span> live — press something and watch'
                   : live ? 'not the config running right now' : 'preview')+
          ' · '+esc(ZS.CON[p.platform])+'</div></div>'+
      /* THE KILL SWITCH — its state still rides four channels — the knob
         travels, .sw.on carries the accessibility tree, the sub-label says
         which state is which, and the rail goes SOLID RED the moment inputs
         stop (zs-fixes.css § KILL SWITCH). Owner, D84: "remove the 'adapter
         is sending inputs' option to advanced, deep into settings, because
         it's rare anyone would ever want that off, they would just unplug
         it." Same binding, same words. */
      /* D237: the manual override for what you play with, Auto by default.
         Still the input type's only home (screen-map §12); the essay rides
         its "?" */
      inputSegHTML(p, '', true)+
      sh('Sending to the console')+
      /* M8 (audit 2026-10-10): a Core has no POST /output/enabled, so the
         switch flipped back with "Board refused" on the product that
         ships. A control that cannot stop anything is worse than none in
         an emergency: on a Core the row says the one thing that does. */
      (killShown()
        ? '<div class="grp-card killcard">'+
            '<div id="ov-kill">'+toggleFld('Adapter is sending inputs', killOn,
              live?'turn this off and ZeroStick stops pressing anything, instantly'
                  :'your board is offline, so nothing is being sent either way', true)+'</div>'+
          '</div>'
        : note('To stop every input at once, <b>unplug the cable to the console</b>.'))+
      /* PC ONLY, AND NOWHERE ELSE. On a PS5 or Xbox config this door is not
         greyed and not empty-stated — the string is never built. */
      (p.platform==='pc'
        ? door('pcout', 'What the game sees',
               'What the game sees', 'XInput, DualSense or DS4 — change what Windows sees',
               'cast')
        : '')+
      door('pairing', 'Connected controllers', 'Controllers & pairing',
           'the pads your board can see, and a refresh', 'plug');

    var h =
      ovBannerHTML(p, full)+
      ovIdCardHTML(p)+
      /* D431: the player's in-game settings for this game (AI Scripts asks
         for them first; here they can always be changed) */
      (window.ZSGAMESET ? ZSGAMESET.deviceCardHTML(p) : '')+
      /* D236: Game Settings is gone from Device for now (owner); the
         function stays for the day it comes back */
      /* D340: the update rate and (mouse configs) Mouse DPI, out of the
         Connection panel, under the colour and over Connection Method */
      ovRateHTML(p)+ovDpiHTML(p)+
      ovConnCardHTML(p, full)+
      (live ? warnNotes(st) : '')+
      acc(accHint('Advanced','your controller, the sending switch, and the rarely touched'),
          'sliders', hAdv, !!OV_ADV_OPEN[p.id], 'ov-adv', true);

    return { html: h, after: function(root){
      var ns = root.dataset.ns;
      /* the input selector is wired by CLASS and by data-v, never by reading
         its buttons' words */
      wireInputSeg(root, p);
      if(window.ZSGAMESET) ZSGAMESET.wire(root, p, function(){ ZS.openDetail({id:'overview', lab:'Device'}, p); });

      /* the banner: the way to set the game */
      var ban = root.querySelector('#ov-banner');
      if(ban) ban.addEventListener('click', function(){
        var fullB = ZS.live.full[p.id];
        var game = ovGameOf(p, fullB);
        if(!game && p.id!=='default' && !isScratchConfig(p, fullB)){ openGameAdopt(p); return; }
        ZS.openDetail({ id:'game', lab:'Match Your Game' }, p);
      });
      var phb = root.querySelector('#id-photo');
      if(phb && ZS.openPhotoSheet) phb.addEventListener('click', function(){
        ZS.openPhotoSheet(p, function(){
          ZS.renderHome();
          ZS.openDetail({id:'overview', lab:'Device'}, p);   /* redraw the banner */
        });
      });
      /* the one-time game adopt — gameless configs only (the button is not
         rendered on a locked config or on `default`) */
      var adoptBtn = root.querySelector('#ov-adopt');
      if(adoptBtn) adoptBtn.addEventListener('click', function(){ openGameAdopt(p); });

      /* the colour carousel (colCarHTML / wireColCar, shared with the
         wizard since D120). Here a pick WRITES the stored config: the
         arrows commit with a toast; the wheel previews on the pad as it
         moves ('input', no toast) and commits on 'change'. */
      var cc = root.querySelector('#ov-colcar');
      if(cc) wireColCar(cc, ovColorCurrent(p), function(c, commit){
        ovSetColor(p, c, !commit);
        var nm = root.querySelector('#ov-colname');
        if(nm) nm.textContent = c.t+' · the mark in your list, and the light on your pad';
        var bn = root.querySelector('#ov-banner');
        if(bn) bn.style.setProperty('--cfg', p.color);
      });
      var dup = root.querySelector('#ov-dup');
      if(dup) dup.addEventListener('click', function(){ ovDuplicate(p); });
      var more = root.querySelector('#ov-more');
      if(more) more.addEventListener('click', function(){ ovToggleMore(p); });
      ovWireShare(root, p);
      /* More was open before this repaint: wire what it holds */
      var mp = root.querySelector('#ov-morepanel');
      if(mp && !mp.hasAttribute('hidden')) ovWireMore(mp, p);

      /* D340: Update Rate and Mouse DPI, on the page */
      ovWireRateDpi(root, p);
      if(live && p.id===ZS.activeId){
        liveOutput(function(data){
          var el = root.querySelector('#rate-live');
          if(el && screenLive(ns)) ratePaint(el, (data && data.metrics) || null, rateOf(ZS.live.full[p.id]));
        });
      }

      /* the Connection panel */
      var box = root.querySelector('#ov-connbox');
      if(box) box.addEventListener('click', function(){ ovOpenConnPanel(p, box); });

      /* the Advanced fold remembers itself across redraws */
      var adv = root.querySelector('.acc[data-key="ov-adv"]');
      if(adv){
        var ah = adv.querySelector('.ah');
        if(ah) ah.addEventListener('click', function(){
          OV_ADV_OPEN[p.id] = adv.classList.contains('open');
        });
      }
      /* kill switch — scoped so it never grabs another toggle */
      var ksw = root.querySelector('#ov-kill .sw');
      if(ksw && live){
        ksw.addEventListener('click', function(){
          var want = ksw.classList.contains('on');
          ZS.api('/output/enabled','POST',{enabled:want}).then(function(j){
            if(j.ok){ ZS.toast(want?'Sending to the console is on':'Sending to the console is off');   /* never "passthrough": that is Passthrough Mode's name now */ ZS.refreshStatus(); }
            else { ksw.classList.toggle('on'); ZS.toast('Board refused: '+(j.error||'')); }
          });
        });
      } else if(ksw){
        ksw.addEventListener('click', function(){
          ksw.classList.toggle('on');
          ZS.toast('Board offline — the kill switch needs the board');
        });
      }
      /* doors to the screens this one's copy names (Match Your Game, Aim
         Speed Match, What the game sees, Pairing) — each keeps its own ns */
      wireDoors(root, p);
      /* live board extras */
      if(live){
        if(p.id===ZS.activeId) livePad(root);
        if(ovPollTimer) clearInterval(ovPollTimer);   /* never stack on revisit */
        var iv=setInterval(function(){
          if(!screenLive(ns)){ clearInterval(iv); if(ovPollTimer===iv) ovPollTimer=null; return; }
          /* The update rate's truth line (D340: on the page now):
             /output/live already carries the loop metrics, so the honest
             "delivering N Hz" costs no extra request. Only for the config
             actually running. */
          if(p.id===ZS.activeId){
            liveOutput(function(data){
              var el = root.querySelector('#rate-live');
              if(el && screenLive(ns))
                ratePaint(el, (data && data.metrics) || null, rateOf(ZS.live.full[p.id]));
            });
          }
        }, 2000);
        ovPollTimer = iv;
      }
      /* the panel comes back after a redraw it caused itself (a PSN pick,
         the way to the Add-account screen). Global Settings' door to the
         update rate (OV_TAB 'Advanced') lands on the page's own Update Rate
         card now (D340), scrolled into view. */
      /* D375: the Aim page's read-only Mouse DPI line ('Dpi') lands on the
         Mouse DPI card the same way */
      var reopen = OV_REOPEN_CONN, toRate = OV_TAB==='Advanced', toDpi = OV_TAB==='Dpi';
      OV_REOPEN_CONN = false; OV_TAB = 'Now';
      if(reopen){
        var w = document.getElementById('sheetwrap');
        if(!(w && w.classList.contains('open'))) ovOpenConnPanel(p, box);
      } else if(toRate || toDpi){
        var rcard = root.querySelector(toDpi ? '#ov-dpicard' : '#ov-ratecard');
        if(rcard && rcard.scrollIntoView) setTimeout(function(){
          try{ rcard.scrollIntoView({ block:'start', behavior:'auto' }); }catch(e){ rcard.scrollIntoView(); }
        }, 0);
      }
    }};
  };

  /* Global Settings > Performance opens Overview on its Advanced pane
     (22-global.js), and the Aim page's Mouse DPI line on 'Dpi' (D375).
     OV_TAB is this file's own; this is the one way in. */
  function ovSetTab(t){ OV_TAB = t; }

  /* what the other screen files use from this one */
  SEC.PLAY_PRESENTS = PLAY_PRESENTS;
  SEC.colCarHTML = colCarHTML;
  SEC.colCarName = colCarName;
  SEC.ovColorList = ovColorList;
  SEC.ovSetTab = ovSetTab;
  SEC.wireColCar = wireColCar;
});
