    if(plat==='ps5' && beNow !== 'pico' && RP_ROW >= 0 && !playHidden(RP_ROW) && !playSoon(RP_ROW)){
      var rpHealth = (live && ps5On)
        ? (out.healthy ? '<b class="ok">● Streaming link healthy</b>'
