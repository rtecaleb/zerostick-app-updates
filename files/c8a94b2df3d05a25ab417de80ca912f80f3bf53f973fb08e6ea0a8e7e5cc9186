          ? '<div class="ovplay-desc ovplay-notrec" id="ov-notrec"><b>'+esc(PLAY_FROM[idx].notRec)+'</b></div>'
          : '')+
        helpHTML('ov-playfrom', 'Play from', PLAY_WHY[idx])+
      '</div>';

    /* D286: a row this adapter can only SET UP (PS5 Remote Play on a Core).
       The carousel shows it without changing the config, and this block is
