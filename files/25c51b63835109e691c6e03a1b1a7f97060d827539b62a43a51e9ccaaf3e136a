/* shell/15b-game-settings.js — "Set exactly these in the game" (D693, D697).
 *
 * A measured translator (Curve Lab on the PC, Measure this game on the Core,
 * a pack's measured model) is right only at the in-game settings it was
 * measured at: the owner measures each game once at HIS preset (a look
 * sensitivity, an in-game dead zone, a response curve), and every player has
 * to copy them or the mouse turns the wrong amount. The list rides in
 * mouseTranslation.resolvedAimModel.gameSettings (zs-aim-model.js resolve).
 *
 * D697 (owner, 2026-11-13): on a MOUSE & KEYBOARD translation config those
 * settings are REQUIRED, not suggestions. The sheet lists them as "Set
 * exactly these in the game" with one confirm, "I've set these", and a
 * required "Your in-game FOV" number: FOV is the player's own choice, but
 * the game's turn rate follows it (zs-aim-model fov law), so the app has to
 * know it. The creator's own FOV row is not in the required list; it is
 * shown as "Made at FOV n" only.
 *
 * WHERE IT IS KEPT. Both go in the CONFIG (its normal save, ZS.putProfile,
 * the D674 patch save), so they survive a reload and reach every app:
 *   gameSettings[ZSAIMMODEL.PLAYER_FOV_KEY]  the player's FOV (a number)
 *   gameSettings[CONFIRM_KEY]                {fp, at}: the required list the
 *                                            player confirmed, by fingerprint
 * The fingerprint is the translator's numbers and settings with the FOV
 * scaling taken out (requiredFp), so changing only your FOV keeps the
 * confirmation, and a NEW measurement (Curve Lab writing another model or
 * other settings) asks again. Saving the FOV also re-points the translator's
 * turn rates at it (ZSAIMMODEL.applyPlayerFov), so the Core gets them
 * already scaled.
 *
 * WHEN. Picking a config (ZS.setActive) or opening one (openEditor) shows
 * the sheet while it is not confirmed ("Not now" quiets that for this
 * session); HOME carries a small amber "!" chip (D70, ZS.warnHTML) that
 * opens it again (homeHTML / wireHome, from 09-home.js). A controller-only
 * config, a Native Mouse & Keyboard config (no translation) and the
 * standard translator never see either. The D693 "Don't show again" is
 * gone: a required setting cannot be dismissed, only confirmed.
 *
 * CONTROLLER FIRST: focus lands on the FOV box while it is empty (else on
 * "I've set these"); the d-pad's up/down (arrow keys) walks the controls,
 * left/right on the FOV box changes it by 1, A (Enter) confirms, B (Escape)
 * is the sheet's own close.
 *
 * PART OF THE APP SHELL (classic script, see 12-sheets.js's header): it
 * only defines window.ZSMEASUREDSET; the calls come after the page has loaded.
 */
(function(){
  var quiet = {};            /* config id -> required fingerprint, "Not now" this session */
  var CONFIRM_KEY = 'requiredSet';
  var FOV_DEFAULT = { min: 60, max: 120, step: 1, int: true, dflt: null };
  var FOV_ROW = /^\s*(field of view|fov)\b/i;

  function AM(){ return window.ZSAIMMODEL || null; }
  function fovKey(){ return (AM() && AM().PLAYER_FOV_KEY) || 'playerFov'; }
  function fullOf(id){ return (window.ZS && ZS.live && ZS.live.full) ? ZS.live.full[id] : null; }

  function measuredDoc(full){
    var r = full && full.mouseTranslation && full.mouseTranslation.resolvedAimModel;
    if(!r || typeof r !== 'object' || r.generic === true) return null;
    var gs = Array.isArray(r.gameSettings) ? r.gameSettings.filter(function(g){
      return g && typeof g.setting === 'string' && g.setting && typeof g.value === 'string';
    }) : [];
    return gs.length ? { model: r, rows: gs } : null;
  }
  function measured(p){ return measuredDoc(fullOf(p.id)); }
  /* the translator's fingerprint: any change to its numbers or its settings
     is a new measurement (djb2 over its JSON) */
  function fingerprint(r){
    var s = JSON.stringify(r), h = 5381, i;
    for(i = 0; i < s.length; i++){ h = ((h << 5) + h + s.charCodeAt(i)) | 0; }
    return (h >>> 0).toString(16);
  }
  /* D697: the same, with the player's FOV scaling taken out (the turn rates
     put back to what was measured), so a new FOV is not a new measurement */
  function requiredFp(r){
    var c = JSON.parse(JSON.stringify(r));
    if(c.fov && typeof c.fov === 'object'){
      var b = c.fov.base;
      if(b && typeof b === 'object') ['hip', 'ads'].forEach(function(n){
        if(c[n] && b[n]){ c[n].vx = b[n].vx; c[n].vy = b[n].vy; }
      });
      delete c.fov.playerFov;
    }
    return fingerprint(canon(c));
  }
  /* keys sorted all the way down: the Core's stored copy (its SOURCE
     sidecar) comes back with its keys in another order, and the same
     measurement must give the same fingerprint after a reload */
  function canon(v){
    if(Array.isArray(v)) return v.map(canon);
    if(!v || typeof v !== 'object') return v;
    var o = {};
    Object.keys(v).sort().forEach(function(k){ o[k] = canon(v[k]); });
    return o;
  }
  /* the creator's rows split: what must match, and the FOV row (info) */
  function splitRows(rows){
    var req = [], fov = null;
    rows.forEach(function(g){ if(FOV_ROW.test(g.setting)){ if(!fov) fov = g; } else req.push(g); });
    return { required: req, fovRow: fov };
  }
  function creatorFov(m){
    var f = m.model.fov;
    if(f && typeof f.measuredAt === 'number') return f.measuredAt;
    var row = splitRows(m.rows).fovRow, n = row ? parseFloat(row.value) : NaN;
    return isFinite(n) ? n : null;
  }
  /* the FOV box's range: the game's own form when it has a Field of View,
     else 60 to 120 */
  function fovRange(full){
    var out = { min: FOV_DEFAULT.min, max: FOV_DEFAULT.max, step: 1, int: true, dflt: null };
    try{
      var nr = window.ZSNAMEREADER, sc = window.ZSGAMESCHEMA;
      var pk = (nr && nr.packOf) ? nr.packOf(full) : null;
      var g = (pk && sc && sc.forPack) ? sc.forPack(pk) : null;
      var fl = g && g.ctl && Array.isArray(g.ctl.fields) ? g.ctl.fields.filter(function(f){ return f && f.k === 'fov'; })[0] : null;
      if(fl){
        if(typeof fl.min === 'number') out.min = fl.min;
        if(typeof fl.max === 'number') out.max = fl.max;
        if(typeof fl.step === 'number' && fl.step > 0) out.step = fl.step;
        out.int = fl.int !== false;
        if(typeof fl.dflt === 'number') out.dflt = fl.dflt;
      }
    }catch(e){}
    return out;
  }
  function playerFov(full){
    var v = full && full.gameSettings ? full.gameSettings[fovKey()] : null;
    return (typeof v === 'number' && isFinite(v)) ? v : null;
  }
  /* is this config one the owner's rule covers? {p, full, m} or null */
  function subject(id){
    if(!window.ZS || !ZS.prof) return null;
    var p = ZS.prof(id);
    if(!p || (ZS.inputShows && !ZS.inputShows(p.input, 'mouse'))) return null;
    var full = fullOf(id);
    if(!full || full.nativeKbm === true) return null;        /* D470: nothing is translated */
    var m = measuredDoc(full);
    return m ? { p: p, full: full, m: m } : null;
  }
  function confirmedDoc(full, m){
    var c = full && full.gameSettings ? full.gameSettings[CONFIRM_KEY] : null;
    return !!(c && typeof c === 'object' && c.fp === requiredFp(m.model)) && playerFov(full) !== null;
  }
  /* true while config `id` must still be confirmed (HOME's chip) */
  function needs(id){
    var s = subject(id);
    return !!s && !confirmedDoc(s.full, s.m);
  }
  function rowsHTML(rows){
    return rows.map(function(g){
      return '<div class="stat"><span>'+esc(g.setting)+'</span><b>'+esc(g.value)+'</b></div>';
    }).join('');
  }
  function help(id, label, text){
    return (window.ZS && ZS.helpHTML) ? ZS.helpHTML(id, label, text)
      : '<div class="note">'+text+'</div>';
  }
  function css(){
    if(document.getElementById('zs-gsreq-css')) return;
    var s = document.createElement('style');
    s.id = 'zs-gsreq-css';
    s.textContent =
      '.gsreq-tag{display:inline-block;margin:0 0 6px;padding:2px 9px;border-radius:999px;'+
        'border:1.5px solid var(--amber);color:var(--amber);font-size:11.5px;font-weight:800;letter-spacing:.06em}'+
      '.gsfov{margin-top:12px}'+
      '.gsfov .flab{font-weight:700;margin-bottom:2px}'+
      '.gsfov .xsub{margin:0 0 8px}'+
      '.gsfov-row{display:flex;align-items:center;gap:8px}'+
      '.gsfov-row button{flex:none;width:48px;height:48px;border-radius:12px;border:1px solid var(--line);'+
        'background:var(--panel);color:var(--text);font-size:22px;font-weight:700;font-family:inherit;cursor:pointer}'+
      '.gsfov-row input{flex:1;min-width:0;height:48px;border-radius:12px;border:1.5px solid var(--line);'+
        'background:var(--panel);color:var(--text);font-size:20px;font-weight:700;text-align:center;font-family:inherit;'+
        '-moz-appearance:textfield;appearance:textfield}'+
      /* the − / + buttons are the stepper: no second, tiny one in the box */
      '.gsfov-row input::-webkit-outer-spin-button,.gsfov-row input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}'+
      '.gsfov-row input:focus{outline:none;border-color:var(--accent)}'+
      '.gsfov-row input.bad{border-color:var(--amber)}'+
      '.hs-req{display:flex;justify-content:center;margin:6px 16px 0;text-align:left}'+
      '.hs-req .whfold{white-space:normal;overflow:visible;text-overflow:clip}'+
      '.hs-req .wh{margin:0}'+
      '.hs-req .wh.open{max-width:340px}'+
      '.hs-req .whfold .btn{margin-top:8px;width:100%}';
    (document.head || document.documentElement).appendChild(s);
  }

  /* Open the sheet for config `id` (from the chip, or maybe()). */
  function open(id, opener){
    var s = subject(id);
    if(!s) return false;
    var w = document.getElementById('sheetwrap');
    if(!w) return false;
    css();
    var m = s.m, full = s.full, sp = splitRows(m.rows), cf = creatorFov(m);
    var rg = fovRange(full), have = playerFov(full), fp = requiredFp(m.model);
    var K = fovKey();
    var body = sheetOpen('Set exactly these in the game',
      '<div class="gsreq-tag">REQUIRED</div>'+
      '<div class="xsub" id="gs-say" style="margin:0 0 8px">This config’s mouse aim only works with these exact in-game settings.</div>'+
      '<div id="gs-rows">'+rowsHTML(sp.required)+'</div>'+
      help('gs-req-why', 'Why these must match',
        'Set these in the game, or mouse movement may be off. '+
        'This config’s mouse aim was measured with the game at exactly these settings. '+
        'A different sensitivity, deadzone or curve makes every turn the wrong size. '+
        'For '+esc(trNameOf(m.model))+'. They are also under Translation, Game translator.')+
      '<div class="gsfov">'+
        '<label class="flab" for="gs-fov">Your in-game FOV</label>'+
        '<div class="xsub" id="gs-fovsub">'+(cf !== null ? 'Made at FOV '+esc(String(cf))+'. ' : '')+
          'Yours can differ: enter it ('+rg.min+' to '+rg.max+').</div>'+
        '<div class="gsfov-row">'+
          '<button type="button" id="gs-fovdn" aria-label="Lower FOV">−</button>'+
          '<input id="gs-fov" type="number" inputmode="numeric" min="'+rg.min+'" max="'+rg.max+'" step="'+rg.step+'"'+
            ' value="'+(have !== null ? esc(String(have)) : '')+'" placeholder="FOV" aria-describedby="gs-fovsub">'+
          '<button type="button" id="gs-fovup" aria-label="Raise FOV">+</button>'+
        '</div>'+
        help('gs-fov-why', 'Why your FOV is needed',
          'FOV changes how fast the game turns for the same stick push. '+
          'For example, Modern Warfare 4 at FOV 100 turns about 31% slower than at 120. '+
          'The app scales your mouse to the FOV you enter, so it must match the game exactly. '+
          'Which FOV you play at is your choice; the settings above are not.')+
      '</div>'+
      '<div class="note warn" id="gs-err" role="alert" hidden></div>'+
      '<button class="btn primary" id="gs-ok" style="margin-top:12px">I’ve set these</button>'+
      '<button class="btn ghost" id="gs-later" style="margin-top:10px">Not now</button>', null, opener);
    var inp = body.querySelector('#gs-fov'), ok = body.querySelector('#gs-ok'), later = body.querySelector('#gs-later');
    var err = body.querySelector('#gs-err');
    function say(t){
      if(!err) return;
      if(t){ err.textContent = t; err.removeAttribute('hidden'); }
      else { err.textContent = ''; err.setAttribute('hidden', ''); }
    }
    function read(){
      var v = parseFloat(String(inp.value).replace(',', '.'));
      if(!isFinite(v) || v < rg.min || v > rg.max) return null;
      return rg.int ? Math.round(v) : v;
    }
    function nudge(d){
      var v = parseFloat(inp.value);
      if(!isFinite(v)) v = rg.dflt !== null ? rg.dflt : (cf !== null ? cf : Math.round((rg.min + rg.max) / 2));
      else v += d * rg.step;
      v = Math.max(rg.min, Math.min(rg.max, v));
      inp.value = String(rg.int ? Math.round(v) : v);
      inp.classList.remove('bad'); say('');
    }
    body.querySelector('#gs-fovdn').addEventListener('click', function(){ nudge(-1); });
    body.querySelector('#gs-fovup').addEventListener('click', function(){ nudge(1); });
    inp.addEventListener('input', function(){ inp.classList.remove('bad'); say(''); });
    var saving = false;
    function confirm(){
      if(saving) return;
      var v = read();
      if(v === null){
        inp.classList.add('bad');
        say('Enter the FOV you use in the game ('+rg.min+' to '+rg.max+') first.');
        try{ inp.focus(); }catch(e){}
        return;
      }
      saving = true; ok.disabled = true; ok.textContent = 'Saving…';
      var at = new Date().toISOString().slice(0, 10);
      var put = (ZS.putProfile ? ZS.putProfile(id, function(d){
        var gs = (d.gameSettings && typeof d.gameSettings === 'object') ? d.gameSettings : {};
        gs[K] = v;
        gs[CONFIRM_KEY] = { fp: fp, at: at };
        d.gameSettings = gs;
        /* the translator's turn rates follow the FOV (D697) */
        var rm = d.mouseTranslation && d.mouseTranslation.resolvedAimModel;
        if(rm && AM() && AM().applyPlayerFov) AM().applyPlayerFov(rm, v);
      }) : Promise.resolve({ ok: false, error: 'no save path' }));
      put.then(function(j){
        saving = false; ok.disabled = false; ok.textContent = 'I’ve set these';
        if(j && j.ok){
          sheetClose();
          if(typeof renderHome === 'function') try{ renderHome(); }catch(e){}
          if(ZS.toast) ZS.toast('Saved: your FOV is '+v);
        } else {
          say('Not saved: '+String((j && (j.error || (j.errors && j.errors[0]))) || 'the Core did not take it')+'. Try again.');
        }
      }, function(){
        saving = false; ok.disabled = false; ok.textContent = 'I’ve set these';
        say('Not saved. Try again.');
      });
    }
    ok.addEventListener('click', confirm);
    later.addEventListener('click', function(){ quiet[id] = fp; sheetClose(); });
    /* controller-first: up/down walks the controls (the "?" chips, the FOV
       box, the two buttons), left/right on the FOV box changes it, A (Enter)
       on the box confirms */
    body.addEventListener('keydown', function(e){
      var t = e.target;
      if(t === inp && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')){
        e.preventDefault(); nudge(e.key === 'ArrowLeft' ? -1 : 1); return;
      }
      if(t === inp && e.key === 'Enter'){ e.preventDefault(); confirm(); return; }
      if(e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      var list = Array.prototype.filter.call(body.querySelectorAll('[data-qh], #gs-fov, #gs-ok, #gs-later'),
        function(x){ return !x.disabled; });
      var i = list.indexOf(document.activeElement);
      e.preventDefault();
      var n = i < 0 ? 0 : Math.max(0, Math.min(list.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)));
      try{ list[n].focus(); }catch(x){}
    });
    try{ (have === null ? inp : ok).focus(); }catch(e){}
    return true;
  }
  /* Show it for config `id` when it should be shown; true when it was. */
  function maybe(id){
    var s = subject(id);
    if(!s || confirmedDoc(s.full, s.m)) return false;
    if(quiet[id] === requiredFp(s.m.model)) return false;
    var w = document.getElementById('sheetwrap');
    if(!w || w.classList.contains('open')) return false;    /* never over another sheet */
    return open(id);
  }
  /* HOME's chip (D70 pattern): '' when nothing is owed */
  function homeHTML(id){
    if(!needs(id)) return '';
    css();
    var t = 'This config needs your in-game settings set exactly, and your FOV.'+
      '<button type="button" class="btn primary" data-gsreq="1">Show the settings</button>';
    var chip = (window.ZS && ZS.warnHTML) ? ZS.warnHTML(t, 'gsreq-'+id)
      : '<div class="note warn">'+t+'</div>';
    return '<div class="hs-req" id="hsreq">'+chip+'</div>';
  }
  function wireHome(root, id){
    var b = root && root.querySelector ? root.querySelector('[data-gsreq]') : null;
    if(b) b.addEventListener('click', function(){ open(id, b); });
  }
  function trNameOf(r){
    var n = String(r.name || 'this game’s translator');
    return (AM() && AM().displayName) ? AM().displayName(n) : n;
  }
  window.ZSMEASUREDSET = { maybe: maybe, open: open, needs: needs, homeHTML: homeHTML, wireHome: wireHome,
    fingerprint: fingerprint, requiredFp: requiredFp, rowsHTML: rowsHTML, splitRows: splitRows,
    CONFIRM_KEY: CONFIRM_KEY };
})();
