        var po = scaleStick(nOr(rc.side, 0) / 100, nOr(rc.down, 0) / 100, from, to, { ads: true });
        rc.side = Math.max(-100, Math.min(100, Math.round(po.x * 100)));
        rc.down = Math.max(0, Math.min(100, Math.round(po.y * 100)));
        if (po.clipped) { res.clipped = true; }
      } else {
