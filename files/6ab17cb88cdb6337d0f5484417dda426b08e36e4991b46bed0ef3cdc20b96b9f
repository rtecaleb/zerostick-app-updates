            good(all[id].gameSettings)) { mine = all[id].gameSettings; break; }
      }
    }
    if (!mine) {
      doc.gameSettingsFrom = doc.gameSettings;
      delete doc.gameSettings;
      res.waiting = true;
      return res;
    }
    if (differ(doc.gameSettings, mine)) {
      (Array.isArray(doc.accessibilityActions) ? doc.accessibilityActions : []).forEach(function (a) {
        var r = fitAction(a, doc.gameSettings, mine);
        if (r.scaled) { res.scaled++; }
        if (r.clipped) { res.clipped = true; }
      });
    }
