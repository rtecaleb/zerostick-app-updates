        if (nd > 0) { s.angle = ((Math.round(Math.atan2(o.y, o.x) * 180 / Math.PI) % 360) + 360) % 360; }
        s.dist = Math.min(1, r2(nd));
        if (o.clipped) { res.clipped = true; }
        res.scaled = true;
      } else if (s.k === 'move') {
        s.dx = r2(nOr(s.dx, 0) * fx);
        s.dy = r2(nOr(s.dy, 0) * fy);
        res.scaled = true;
      }
    });
    var rc = a.recoil;
    if (rc && typeof rc === 'object' && !Array.isArray(rc)) {
