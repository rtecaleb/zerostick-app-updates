  /* ── D432: scaling a script from its maker's settings to the player's ──

     Owner, 2026-10-22: "scale the scripts correctly depending on people's
     profiles, because deadzones change how sensitivity feels overall (the
     min and max) and obviously sensitivity ... if someone pastes a Recoil
     Workshop pattern, we just adjust the x and y to match our game".

     THE LINEAR MODEL, honestly labelled: the game ignores the stick inside
     its radial deadzone (dz), calls it fully pushed at the outer one (mx),
     and in between turns at sens x (ads when aiming) x the push, in a
     straight line. A game's MEASURED curve (its aim model) replaces this
     later; until then this is the best a pair of numbers can say.

     Units: x, y are a stick output, -1..1 on each axis (the length is the
     push, 1 = the edge). Only the direction's axes matter, so +y up or +y
     down both work. Pure functions, no DOM. */
  function nOr(v, d) { var n = Number(v); return isFinite(n) ? n : d; }
  function zones(gs) {
    var dz = Math.max(0, nOr(gs.deadzone, 0)) / 100;
    var mx = nOr(gs.deadzoneMax, 100) / 100;
    if (!(mx > dz)) { mx = Math.max(dz + 0.01, 1); }
    return { dz: dz, mx: mx };
  }
  /* turn per unit of effective push on one axis */
  function gain(gs, axis, ads) {
    return nOr(axis === 'y' ? gs.sensY : gs.sensX, 0) * (ads ? nOr(gs.ads, 1) : 1);
  }
  /* the numbers that change a push (the curve name does not, yet) */
  function same(a, b) {
    return ['sensX', 'sensY', 'ads', 'deadzone'].every(function (k) { return nOr(a[k], NaN) === nOr(b[k], NaN); }) &&
      nOr(a.deadzoneMax, 100) === nOr(b.deadzoneMax, 100);
  }
  /* true when going from one set to the other changes anything */
  function differ(from, to) { return good(from) && good(to) && !same(from, to); }

  /* the turn ratio on one axis, deadzones left out: what a mouse count (the
     Recoil Lab's move steps, which the player's own translator turns into a
     push past THEIR deadzone) has to be multiplied by */
  function scaleFactor(from, to, axis, ads) {
    if (!good(from) || !good(to)) { return 1; }
    var gt = gain(to, axis, ads);
    return gt > 0 ? gain(from, axis, ads) / gt : 1;
  }

  function scaleStick(x, y, from, to, opts) {
    x = nOr(x, 0); y = nOr(y, 0);
    var ads = !!(opts && opts.ads);
    if (!good(from) || !good(to) || same(from, to)) { return { x: x, y: y, clipped: false }; }
    var m = Math.sqrt(x * x + y * y);
    if (m === 0) { return { x: 0, y: 0, clipped: false }; }
    var f = zones(from), t = zones(to);
    /* inside the maker's deadzone it did nothing; it stays nothing */
    if (m <= f.dz) {
      var k = f.dz > 0 ? t.dz / f.dz : 0;
      return { x: x * k, y: y * k, clipped: false };
    }
    var eff = Math.min(1, (m - f.dz) / (f.mx - f.dz));
    var gxT = gain(to, 'x', ads), gyT = gain(to, 'y', ads);
    var ex = eff * x / m * gain(from, 'x', ads), ey = eff * y / m * gain(from, 'y', ads);
    /* the speed this needs, in the player's effective push */
    var clipped = false;
    if (ex !== 0) { if (gxT > 0) { ex /= gxT; } else { clipped = true; ex = ex > 0 ? 1 : -1; } }
    if (ey !== 0) { if (gyT > 0) { ey /= gyT; } else { clipped = true; ey = ey > 0 ? 1 : -1; } }
    var e = Math.sqrt(ex * ex + ey * ey);
    if (e === 0) { return { x: 0, y: 0, clipped: clipped }; }
    if (e > 1 + 1e-9) { clipped = true; }
    var m2 = t.dz + Math.min(1, e) * (t.mx - t.dz);
    if (m2 > 1) { m2 = 1; clipped = true; }
    return { x: ex / e * m2, y: ey / e * m2, clipped: clipped };
  }

  function r2(v) { return Math.round(v * 100) / 100; }
  function copy(o) { return JSON.parse(JSON.stringify(o)); }
  /* a Script that fires (a Recoil Lab one) is played aiming down sights */
  function isRecoil(a) { return !!(a && (a.fromTemplate === 'recoil-workshop' || (a.recoil && typeof a.recoil === 'object'))); }

  /* Scale an app-model Script (smart-actions normAction's shape: steps
     {k:'stick', stick, angle, dist} and {k:'move', dx, dy}, and a Recoil
     Lab `recoil` record) IN PLACE from `from` to `to`, then stamp it with
     `to` so it is never scaled twice. Only the aim stick turns the camera;
     the left stick walks, and is left alone. Answers {scaled, clipped}. */
