  /* "my own game" (D133 scratch) has no ready-made scripts to scale */
  function scratch(doc) {
    var packs = root.ZSPACKS;
    return !!(packs && ((typeof packs.isScratch === 'function' && packs.isScratch(doc)) ||
      /* NBA 2K has Auto green, not AI Scripts (D406) */
      (typeof packs.isNba2k === 'function' && packs.isNba2k(doc))));
