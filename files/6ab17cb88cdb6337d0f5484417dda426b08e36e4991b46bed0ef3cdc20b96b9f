    { k: 'ads', lab: 'Aim (ADS) sensitivity', say: 'While aiming down sights', min: 0, need: true },
    { k: 'deadzone', lab: 'Deadzone min', say: 'The aim stick’s inner deadzone', min: 0, need: true },
    /* owner, 2026-10-22: "deadzones change how sensitivity feels overall,
       the min and max": the outer deadzone, where the game calls the stick
       fully pushed. Most games have none, so a blank is 100. */
