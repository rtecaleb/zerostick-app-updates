/* sections/22-global.js — Global Settings: the room about the box.
 *
 * R.global and its tabs (General, Performance, Access, and Developer in a dev
 * build only, zs-build.js): the theme
 * (D185), Passthrough Mode's shortcuts (navBlock, /navigate/settings), the device
 * strip, credits, the developer tools (calibration packs from 06-velocity-cal.js).
 *
 * Screens (window.RENDERERS):  R.global
 * Core / board routes:        /logs, /navigate/active, /navigate/settings, /service/restart,
 *                             /settings/tournament, /settings/slotkeys (D346, D348),
 *                             /settings/menufeedback (D352),
 *                             /vision/snapshot, and (Developer, a dev Core only) /vision/patch/<n>
 * Tests:                      test-theme.js, test-settings-icons.js, test-core-mode.js
 *
 * ONE OF THE APP'S SCREEN FILES (2026-10-02: phone-sections.js, split into
 * one file per screen). phone-sections.js is the loader and explains the
 * rules: the files run in order inside ZS_SECTIONS.run(), and share names
 * only through the lists at the top and the bottom of each file.
 */
ZS_SECTIONS.add('global', function (SEC) {
  /* from the files before this one */
  var acc = SEC.acc, addbtn = SEC.addbtn, armConfirm = SEC.armConfirm, btn = SEC.btn,
      card = SEC.card, esc = SEC.esc, helpHTML = SEC.helpHTML, ico = SEC.ico,
      note = SEC.note, picCreditsHTML = SEC.picCreditsHTML, R = SEC.R, seg = SEC.seg,
      sh = SEC.sh, srcGly = SEC.srcGly, srcNameOf = SEC.srcNameOf,
      toggleFld = SEC.toggleFld, warnNotes = SEC.warnNotes, wireRebind = SEC.wireRebind,
      ZS = SEC.ZS, openCalPacks = SEC.openCalPacks, openSavePack = SEC.openSavePack,
      ovSetTab = SEC.ovSetTab, copyText = SEC.copyText, fld = SEC.fld;

  /* ── Global Settings (tabbed) ─────────────────────────────────── */
  /* There is no DEV.version any more. It was a hard-coded '0.4.1' presented on
     two tabs as "Firmware — ZeroStick 0.4.1" while the board itself reported
     0.1.0, and the .bin flasher below it invented a new version number out of
     the filename after a 2.6-second fake progress bar. The only real version in
     this product is the one the agent reports, so that is the only one shown. */
  var G_TAB = 'General';
  /* DEVELOPER MODE (owner, 2026-10-02): the Developer tab exists only in a
     dev build (zs-build.js: the owner's builds always, customer builds
     never). A customer build keeps what a customer needs from it - copy
     diagnostics, the artwork licences, factory reset - on General. */
  function devBuild(){ return !!(window.ZS_BUILD && window.ZS_BUILD.dev === true); }
  if(window.ZS) ZS.devBuild = devBuild;
  /* DEVELOPER MODE (owner, 2026-10-14): the Debug box's 2200 sets it on this
     device; it unlocks the screens that are COMING SOON for everyone else */
  if(window.ZS) ZS.devMode = function(){
    try{ return localStorage.getItem('zs-dev-mode') === '1'; }catch(e){ return false; }
  };
  /* D398 (owner, 2026-10-16: "remove the 'teach the Core this gun' stuff"):
     gun training (Teach the Core this gun, the trained line, the picture
     talk) is hidden from everyone, developer mode included, unless THIS
     switch is on: Global Settings > Developer > Show gun training tools.
     Developer builds only (a release build never has it), off by default,
     kept on this device. auto-actions.js asks it. */
  var GUN_TRAINING_KEY = 'zs-gun-training';
  if(window.ZS) ZS.gunTraining = function(){
    if(!devBuild()) return false;
    try{ return localStorage.getItem(GUN_TRAINING_KEY) === '1'; }catch(e){ return false; }
  };
  /* the owner's easter egg (2026-10-13), a combo so nobody finds it by
     accident. In EVERY build, store builds included (owner, 2026-10-14: "I
     want the easter egg to be there in launch software and products, but I
     just don't want anyone to find it but me unless they somehow randomly
     figure that out"): open Global Settings, then tap General
     once, Performance exactly 10 times, then General exactly 8 times, with
     nothing else in between, and a little card opens. Any other tap starts it
     over. One listener on the page (capture phase), so redraws don't matter. */
  if(!window.__zsEgg) (function(){
    window.__zsEgg = true;
    var COMBO = ['General'];
    var i;
    for(i = 0; i < 10; i++) COMBO.push('Performance');
    for(i = 0; i < 8; i++) COMBO.push('General');
    var armed = false, pos = 0;
    function show(){
      if(!ZS.sheetOpen) return;
      ZS.sheetOpen('\u2764', '<div class="egg-amelia" style="position:relative;text-align:center;padding:6px 4px 34px">'+
        '<img class="egg-photo" src="brand/egg-amelia.jpg" width="900" height="599" alt="Caleb and Amelia" style="display:block;width:100%;height:auto;border-radius:14px;margin:0 0 18px">'+
        '<div style="font-size:40px;line-height:1" aria-hidden="true">\u2764\uFE0F</div>'+
        '<div style="font-size:24px;font-weight:800;margin-top:14px">I Love Amelia Barton</div>'+
        '<div style="font-size:18px;margin-top:6px;color:var(--muted)">9/22/?</div>'+
        '<div class="egg-made" style="position:absolute;left:12px;bottom:8px;font-size:11px;color:var(--muted)">10.12.2026</div></div>');
    }
    document.addEventListener('click', function(e){
      var t = e.target && e.target.closest ? e.target : null;
      if(!t){ armed = false; pos = 0; return; }
      /* step 0: opening Global Settings arms it */
      if(t.closest('[data-more="global"]')){ armed = true; pos = 0; return; }
      var tab = t.closest('.subtabs button[data-g]');
      var name = tab ? tab.getAttribute('data-g') : null;
      if(!armed || name !== COMBO[pos]){ armed = false; pos = 0; return; }
      pos++;
      if(pos === COMBO.length){ armed = false; pos = 0; setTimeout(show, 350); }
    }, true);
  }());
  /* THE CORE'S HALF (D223): a Core built as a release image says
     "devMode":false in /status and has none of its developer-only routes
     (firmware components/zs_api/parts/dev.c), so even a dev build of this app
     hides the Developer tools that need them. Absent (an EXO, or a Core from
     before D223, whose images all had those routes) counts as on. */
  function coreDevMode(){
    var st = ZS.live && ZS.live.status;
    return !(st && st.product === 'core' && st.devMode === false);
  }
  if(window.ZS) ZS.coreDevMode = coreDevMode;
  function isCore(){ return !!(ZS.productId && ZS.productId() === 'core'); }
  /* Core developer tools: only what a dev Core serves. A new one that calls
     a developer-only route goes HERE (docs/CODE-STRUCTURE.md) - e.g. the
     capture chip's firmware tools once /capture/fw/... exists. */
  function coreDevHTML(){
    if(!isCore()) return '';
    if(!coreDevMode()){
      return sh('Core developer tools')+
        note('This Core runs a release firmware (developer mode off), so it has no '+
             'developer routes and their tools are hidden. Flash a developer image '+
             'to use them.');
    }
    var sim = !!(ZS.simMnk && ZS.simMnk.on());
    return sh('Core developer tools')+
      btn((sim ? '☑' : '☐')+' Pretend a mouse and keyboard are plugged in', null, 'g-simmnk')+
      /* D285: the explanation is the "?" */
      helpHTML('g-simmnk', 'Pretend a mouse and keyboard are plugged in',
           'Shows the mouse and keyboard tabs and settings as if both were plugged into the Core. '+
           'Changes still save to the real config. The app reloads when you switch it.')+
      btn('▦ What each watched area sees (32×16)', null, 'g-patches')+
      '<div id="g-patchesout" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px"></div>';
  }
  /* The Debug box's commands (owner, 2026-10-13). Keys are compared with
     spaces removed and lower-cased. A command here is a client-side treat or
     a debug helper: anything that changes the Core goes through the Core's
     own developer routes, never a secret string in the app, because anyone
     can read this file. */
  function eggCard(){
    if(!ZS.sheetOpen) return;
    ZS.sheetOpen('\u2764', '<div class="egg-amelia" style="position:relative;text-align:center;padding:6px 4px 34px">'+
      '<img class="egg-photo" src="brand/egg-amelia.jpg" width="900" height="599" alt="Caleb and Amelia" style="display:block;width:100%;height:auto;border-radius:14px;margin:0 0 18px">'+
        '<div style="font-size:40px;line-height:1" aria-hidden="true">\u2764\uFE0F</div>'+
      '<div style="font-size:24px;font-weight:800;margin-top:14px">I Love Amelia Barton</div>'+
      '<div style="font-size:18px;margin-top:6px;color:var(--muted)">9/22/?</div>'+
        '<div class="egg-made" style="position:absolute;left:12px;bottom:8px;font-size:11px;color:var(--muted)">10.12.2026</div></div>');
  }
  var DEBUG_CMDS = {
    '01/10/2008': function(){ eggCard(); return ''; },
    'help': function(){ return 'Commands are secret. Ask the ZeroStick team.'; },
    /* owner, 2026-10-14: developer mode opens what is locked behind COMING
       SOON (Legacy Devices). Typed again, it turns off. Kept on this device. */
    '2200': function(){
      var on = !(ZS.devMode && ZS.devMode());
      try{ if(on) localStorage.setItem('zs-dev-mode', '1'); else localStorage.removeItem('zs-dev-mode'); }catch(e){}
      return on ? 'Developer mode is on.' : 'Developer mode is off.';
    }
  };
  function runDebug(raw){
    var k = String(raw || '').replace(/\s+/g, '').toLowerCase();
    if(!k) return '';
    var fn = DEBUG_CMDS[k];
    return fn ? fn() : 'Unknown command.';
  }
  function gTabs(){ return devBuild() ? ['General','Performance','Access','Developer']
                                      : ['General','Performance','Access']; }
  /* what a customer needs from the Developer tab, on General when there is
     no Developer tab */
  function supportHTML(){
    return sh('Support')+
      btn('⧉ Copy diagnostics — version, config and log', null, 'g-diag')+
      (window.ZSART && typeof ZSART.creditsHTML === 'function'
        ? sh('Credits') + acc('Artwork and licences', 'info', ZSART.creditsHTML() + picCreditsHTML(), false)
        : '')+
      sh('Danger zone', 'danger')+
      btn('Factory reset — erase phone-app data','danger','g-freset');
  }

  /* D272: SETTINGS > LEGAL. The app's legal documents (zs-legal.js, made
     from legal/app/ by tools/gen-legal.js) open in the app, offline. On
     General in every build: a customer needs them as much as the owner.
     No "?" here (D236/D260 are for settings; a document is not one). */
  function legalHTML(){
    if(!window.ZSLEGAL) return '';
    return sh('Legal')+
      btn('Terms, privacy and licences', null, 'g-legal')+
      '<p class="gnavd" id="g-legal-said">'+ZSLEGAL.agreedLine()+'</p>'+
      /* 2026-10-23 (owner): the company that makes ZeroStick, with its mark */
      '<div class="g-maker" style="display:flex;align-items:center;gap:12px;margin:14px 2px 4px">'+
        '<img src="brand/rte-logo-white.png" alt="" width="54" height="25" style="display:block">'+
        '<span style="font-size:12.5px;line-height:1.4;color:var(--muted)">ZeroStick is made by<br>'+
        '<b style="color:var(--text);font-weight:650">Reliable Trend Enterprises LLC</b></span></div>';
  }

  /* navBlock() — an eight-control "Passthrough Mode" panel — was removed once as a
     faithful copy of a XIM feature the board had no trace of: every control
     saved to localStorage and the copy asserted behaviour ("the LED breathes
     white while it's on") for an LED that is not wired.

     It is back, and this time the engine is behind it: mapping/navigate.py,
     engine._set_navigate_active, GET/POST /navigate. Two controls, not eight,
     because two is what the agent actually implements. Everything drawn here
     reads from status.navigateMode and writes to the board. */

  var NAV_NAMES = {
    KEY_LEFTBRACE:'[', KEY_RIGHTBRACE:']',
    BTN_SELECT:'View', BTN_START:'Menu',
    BTN_THUMBL:'L3', BTN_THUMBR:'R3',
    BTN_MODE:'Guide', BTN_SOUTH:'A', BTN_EAST:'B', BTN_WEST:'X', BTN_NORTH:'Y'
  };
  /* One naming function for both the summary line and the rows, so a shortcut
     never reads two different ways on the same screen. NAV_NAMES wins because
     srcNameOf spells the bracket keys "Leftbrace"/"Rightbrace" — correct, and
     not what is printed on the key. */
  function navKeyName(code, p){
    if(NAV_NAMES[code]) return NAV_NAMES[code];
    var n = srcNameOf(code, p);
    if(n) return n;
    return String(code||'').replace(/^KEY_/,'').replace(/^BTN_/,'').toLowerCase();
  }
  function navComboText(combos, p){
    if(!combos || !combos.length) return 'no shortcut set';
    return combos.map(function(c){
      return c.map(function(x){ return navKeyName(x, p); }).join(' + ');
    }).join('  ·  ');
  }

  function navBlock(st, live){
    var nm = (live && st && st.navigateMode) || {};
    var active = !!nm.active;
    var armed  = nm.enabled !== false;
    var combos = nm.combos || [];
    var custom = nm.usingDefaultCombos === false;
    /* Friendly names come from the ACTIVE config's device family, the same
       source R.global's rebind rows already use — this screen has no config
       of its own. */
    var ap = ZS.prof(ZS.activeId);
    function comboWords(c){
      return c.map(function(code){ return navKeyName(code, ap); }).join(' + ');
    }

    /* THE FLAGSHIP ACCESSIBILITY ESCAPE HATCH WAS A 44px GREY SWITCH.
       Passthrough Mode is the way OUT of a config that has remapped you away
       from the console's own menus — the single most consequential control in
       Global Settings — and it was a toggle in a row, identical in weight to
       "Shortcut buttons" underneath it and to "High contrast" on the next
       tab. General measured 3.5% chromatic with no solid fill anywhere above
       the fold; this is the one obvious first move on the tab, so it takes
       the solid ion key and says the verb.

       ONE CONTROL, NOT TWO: the switch is REPLACED, not supplemented — a
       state that can be changed from two places on the same card is how a
       tremor turns one press into a no-op. The state stays in words (and in
       green when it is live), so nothing is carried by colour alone, and
       #g-nav is still the wrapper every caller and test knows. */
    var navVerb = active ? 'Turn Passthrough Mode off' : 'Turn on Passthrough Mode';
    /* D159: NATIVE. On a Core with a keyboard or mouse plugged in, Navigate
       hands them to the console as they are (the Pico becomes a plain USB
       keyboard + mouse for a moment); with only a controller, the controller
       plays with no config. nm.native is absent on older firmware, and then
       the words are the old ones. The state is always in words. */
    var nat = nm.native || null;
    var natWords = {
      on:        'on — Native: your keyboard and mouse go straight to the console',
      switching: 'on — switching to Native keyboard + mouse…',
      pad:       'on — Native: your controller plays with no config',
      refused:   'on — plain menu controls (this Pico needs the Native update)'
    };
    var navSay  = live ? (active ? ((nat && natWords[nat.state]) || 'on — plain menu controls')
                                 : 'off — your config is running')
                       : 'board offline — this needs the board';
    var h = sh('Passthrough Mode')+
      card('<div id="g-nav">'+
           '<div class="gnavh"><b>Passthrough Mode</b>'+
             '<span class="gnavs'+(active?' live':'')+'">'+esc(navSay)+'</span></div>'+
           /* 30 WORDS BEFORE THE BUTTON, of which the middle 14 were a key
              map. What you need in front of the button is what the button
              does; which key lands on which is reference you go looking for,
              and "your config is not changed" is the reassurance you want
              available before you press an unfamiliar button — both are the
              chip's job, and both are in it. */
           (nat ? '<p class="gnavd">Native: your own keyboard, mouse or controller go to '+
                    'the console as if plugged straight in, with no config, until you turn it off.</p>'
                : '<p class="gnavd">Swaps your controls to a plain set for menus, until '+
                    'you turn it off.</p>')+
           helpHTML('g-navmap', 'Passthrough Mode',
             (nat ? 'With a <b>keyboard or mouse</b> plugged into the Core, they reach the '+
                    'console or PC <b>exactly as they are</b> (the adapter re-connects as a '+
                    'keyboard + mouse for about a second, on the way in and out). With only a '+
                    '<b>controller</b>, it plays with no config. Consoles take a keyboard in '+
                    'their menus; a mouse mostly on a PC. Your shortcut to leave is never typed. '
                  : 'It puts <b>the d-pad on WASD and the arrow keys, Enter to confirm and '+
                    'Esc to go back</b>. ')+
             'Your config is not changed — everything comes back '+
             'exactly as it was when you turn it off.')+
           btn(navVerb, 'primary', 'g-nav-go')+
           '</div>'+
           '<div id="g-navarm">'+toggleFld('Shortcut buttons', armed,
             live ? (combos.length ? 'on — '+esc(navComboText(combos, ap))
                                   : 'on — but no shortcut is set')
                  : 'board offline', true)+'</div>');

    h += sh('Your shortcuts');
    if(!live){
      h += note('<b>Board offline.</b> Shortcuts live on the board, so they cannot be listed or changed until it is reachable.','warn');
      return h;
    }
    if(!combos.length){
      h += note('None set.')+
        helpHTML('g-navnone', 'Your shortcuts',
          'None set — the switch above is the only way in and out. Add one below and it goes straight to your board.');
    } else {
      h += card(combos.map(function(c, i){
        var words = comboWords(c);
        /* P5: one glyph per key, thin + between them, the words kept after.
           srcGly draws keycaps for keys, the mouse for clicks and the pad's
           own family for buttons — never ZSG.chip, which prints its own label
           and would double the words. ONE aria-hidden wrapper hides the whole
           strip, so the row announces exactly the words it always did. */
        var art = '', k;
        for(k=0;k<c.length;k++){
          if(k) art += '<span style="color:var(--muted);font-size:11px;margin:0 3px">+</span>';
          art += srcGly(navKeyName(c[k], ap), c[k]);
        }
        /* ── …AND THE SAME RULE THE BUTTONS LIST USES ────────────────────
           Reviewer, 2026-08-28. srcGly draws a real symbol for a face button
           but its own LETTERS for a keycap, a stick click or a number — so
           three of the four default shortcuts printed themselves twice, side
           by side, 4px apart:

             [ + ]   “[ + ]”   ✕
             L3 + R3 “L3 + R3” ✕
             1 + 3   “1 + 3”   ✕

           Only "View + Menu" differed, because those two ARE symbols. Same
           call as inputRowHTML's sameWord(): compare what the strip actually
           spells to the words beside it and drop the picture when it is the
           caption. The words stay — they are the half a screen reader reads,
           and the half the remove button quotes. */
        var spelled = art.replace(/<[^>]*>/g, '').replace(/\s+/g, '');
        if(spelled && spelled === String(words).replace(/\s+/g, '')) art = '';
        if(art) art = '<span class="gly-deco" aria-hidden="true" style="margin-right:8px">'+art+'</span>';
        return '<div class="lrow" data-i="'+i+'">'+
          '<span class="src">'+art+esc(words)+'</span>'+
          '<span class="rt"><button class="ib danger nav-del" data-i="'+i+'" '+
            'aria-label="remove shortcut '+esc(words)+'">✕</button></span></div>';
      }).join(''));
    }
    h += addbtn('Add a shortcut','nav-add');
    if(custom) h += btn('Restore the default shortcuts', 'danger', 'nav-reset');
    /* the closing paragraph of a list becomes the chip at the foot of it:
       "press them together" is what a shortcut list already implies, and the
       two facts worth keeping — that it toggles rather than holds, and that
       your accommodations survive it — are exactly what somebody scrolls
       back down here to check. */
    h += helpHTML('g-navcombo', 'Using a shortcut',
              'Press its buttons together to turn Passthrough Mode on, and press them '+
              'again to turn it off. <b>Your accommodations stay on either way.</b>');
    return h;
  }

  /* ── ZEN STUDIO PARITY ON THE CORE (D346, D348) ─────────────────────
     Two device-wide switches a Cronus Zen player looks for, both OFF by
     default and both kept on the Core (firmware parts/zen.c):
       Tournament Mode   scripts, Smart Actions (macros, turbo, saved
                         recoil), AI actions and injected moves all stop;
                         remaps, sticks and aim stay. POST /settings/tournament.
       Controller shortcut for configs (Zen's "Remote Slot Change"): hold
                         the console's home button and press Share / View
                         (or L3 / LS) to go to the next config.
                         POST /settings/slotkeys.
       Script menu feedback (D352): with no phone or PC showing a script's
                         screen, the controller's light and a buzz say its
                         mod menu opened (L2/LT + Options/Menu), moved and
                         closed. POST /settings/menufeedback.
     Drawn only for a Core whose /status carries them (an older Core or an
     EXO says nothing and gets nothing). The words say the state, never the
     colour alone; the explanation is behind the "?" (D236, D285). */
  var ZEN_CHORDS = ['guide_share', 'guide_l3'];
  var ZEN_CHORD_WORDS = ['Home + Share / View', 'Home + L3'];
  function zenBlock(st, live){
    if(!st || (typeof st.tournament !== 'boolean' && !st.slotKeys &&
               typeof st.menuFeedback !== 'boolean')) return '';
    var h = '';
    if(typeof st.tournament === 'boolean'){
      var tOn = !!st.tournament;
      h += sh('Tournament Mode')+
        card('<div id="g-tourn">'+
          toggleFld('Tournament Mode', tOn,
            live ? (tOn ? 'on — scripts, Smart Actions and AI are off'
                        : 'off — everything you set up runs')
                 : 'board offline', true)+
          helpHTML('g-tourn', 'Tournament Mode',
            'For events and honest play: one switch turns off <b>GPC scripts, Smart Actions '+
            '(macros, turbo, saved recoil patterns), AI and screen actions</b> and anything '+
            'that moves the aim for you. <b>Your remaps, sticks, aim settings and '+
            'accommodations stay exactly as they are.</b> It is saved on the Core, and HOME '+
            'shows a Tournament badge while it is on.')+
          '</div>');
    }
    if(st.slotKeys){
      var sk = st.slotKeys;
      var ci = Math.max(0, ZEN_CHORDS.indexOf(sk.chord));
      h += sh('Change config from your controller')+
        card('<div id="g-slotkeys">'+
          toggleFld('Controller shortcut', !!sk.on,
            live ? (sk.on ? 'on — '+ZEN_CHORD_WORDS[ci]+' goes to your next config'
                          : 'off — configs change from the app only')
                 : 'board offline', true)+
          seg('Shortcut', ZEN_CHORD_WORDS, ci, true, null,
            'hold the console button, then press the second one')+
          helpHTML('g-slotkeys', 'Controller shortcut',
            'Like a Cronus Zen’s Remote Slot Change. <b>Hold the console’s home button</b> '+
            '(PS, Xbox or Home) <b>and press Share</b> (Create, View or Minus) — or L3 — '+
            'and the Core goes to your <b>next config</b>, wrapping round after the last. '+
            'The second button is kept from the console, so Share does not also take a '+
            'screenshot. Scripts can read the setting with get_ctrlbutton().')+
          '</div>');
    }
    if(typeof st.menuFeedback === 'boolean'){
      var mOn = !!st.menuFeedback;
      h += sh('Script menus without a screen')+
        card('<div id="g-menufx">'+
          toggleFld('Menu light and buzz', mOn,
            live ? (mOn ? 'on — your controller answers a script’s menu'
                        : 'off — script menus show in the app only')
                 : 'board offline', true)+
          helpHTML('g-menufx', 'Menu light and buzz',
            'Most Zen scripts open their own menu with <b>L2 + Options</b> (LT + Menu) and draw '+
            'it on a small screen. Your Core has no screen of its own, so the app’s HOME shows '+
            'it while a script uses it. <b>When neither the app nor EXO Studio is showing it</b>, '+
            'this lets your controller tell you instead: the light goes <b>white</b> and buzzes '+
            'once when the menu opens, <b>ticks</b> each time a press changes the menu, and '+
            'buzzes <b>twice</b> when you close it. A press that changed nothing stays silent. '+
            'The script still gets every press. Off by default, so L2 + Options in a game never '+
            'surprises you; rumble set to Off keeps the buzz away and leaves the light.')+
          '</div>');
    }
    return '<div id="g-zen">'+h+'</div>';
  }

  /* ══ GLOBAL SETTINGS: THE ROOM ABOUT THE BOX ═══════════════════════
     Measured 2026-08-18 on the running app at 375×812, all four tabs:
       General 3.5% chromatic · Performance 2.1% · Access 2.6% · Developer
       2.5%, and on three of the four the MOST PROMINENT PAINTED ELEMENT was
       div.phead — the back button. Performance does not scroll, so 2.1% was
       the whole screen. Not one of the four had a solid primary above the
       fold, and two of them got LESS colourful across the previous pass.

     THE HUE IS NOT THE FIX, AND CANNOT BE. Global already carries
     data-tint="global" (phone.html openDetail → zs-kit.css §17), and its tint
     is --steel #b9c6d8 — an ink-grade neutral, deliberately, because this
     screen is about the HARDWARE and hardware is not one of the five config
     rooms. Painting steel on more things buys ~0% chroma by construction. So
     Global's identity has to be STRUCTURAL, and it is three things this
     stylesheet gives it, on all four tabs:
       · a device strip — the box's name, its link and its version, in steel,
         at the top of every tab. It is the one thing that says "you are in
         the settings for the ADAPTER, not for a config", and it replaces the
         Device card General had and the Version card Developer had, so it is
         consolidation rather than another row.
       · a steel rail down the left of every group card, so the room has an
         edge the eye can follow the way the tinted rooms have a hue.
       · one solid primary per tab, above the fold — see each tab below.
     Injected from here rather than added to a stylesheet the sibling lanes
     own, the same way smart-actions.js carries its own screen's CSS. */
  function injectGlobalCSS(){
    if(document.getElementById('zs-global-css')) return;
    var s = document.createElement('style');
