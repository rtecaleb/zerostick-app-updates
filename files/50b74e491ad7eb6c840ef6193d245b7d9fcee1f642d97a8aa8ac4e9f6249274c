             builds them from the label's own text node, so these strings are
             the rows' keys by construction and wire() restores them on the
             next render. Then applyAccess, then repaint, so the rows show
             what just happened rather than the state before it. */
          function setEase(on){
            var v = ZS.store.vals;
            v['global/global|Text size'] = on ? 'Large' : 'Default';
            v['global/global|High contrast'] = on ? '1' : '0';
            v['global/global|Bigger touch targets'] = on ? '1' : '0';
            ZS.persistStore();
            ZS.applyAccess();
            ZS.toast(on ? 'Bigger writing, stronger borders, bigger controls'
                        : 'Back to the normal size');
            if(G_TAB==='Access') setTimeout(render, 0);
          }
          var eOn = root.querySelector('#g-ease');
          if(eOn) eOn.addEventListener('click', function(){ setEase(true); });
          var eOff = root.querySelector('#g-ease-off');
          if(eOff) eOff.addEventListener('click', function(){ setEase(false); });
          var a11y = root.querySelector('#g-a11y-stmt');
          if(a11y) a11y.addEventListener('click', function(){ ZSLEGAL.openDoc('accessibility'); });
          /* D481: Setup video / Replay tips / Turn tips off */
          if(window.ZSTIPS) ZSTIPS.wireSettings(root, function(){ if(G_TAB==='Access') setTimeout(render, 0); });
        }
        if(G_TAB==='Performance'){
          /* the door to the one write home (screen-map §7): deep-link to
             Overview's Advanced pane — OV_TAB is the module var the pager
             reads, so setting it before openDetail lands the user on the
             right pane, the existing deep-link idiom. Guarded: with no
             active profile object there is nowhere to go, so say so. */
          var goRate = root.querySelector('#g-rate-go');
          if(goRate) goRate.addEventListener('click', function(){
            var pp = ZS.prof(ZS.activeId);
            if(!pp){ ZS.toast('No active config to open'); return; }
            ovSetTab('Advanced');
            ZS.openDetail({id:'overview', lab:'Device'}, pp);
          });
        }
        if(G_TAB==='General'){
          var lg=root.querySelector('#g-legal');
          if(lg) lg.addEventListener('click', function(){ ZSLEGAL.openList(); });
          var rs=root.querySelector('#g-restart');
          if(rs){
            if(ZS.live.online!==false && ZS.live.status){
              armConfirm(rs, function(){
                ZS.api('/service/restart','POST',{}).then(function(j){
                  ZS.toast(j.ok?'Board agent restarting…':'Board refused: '+(j.error||''));
                });
              });
            } else rs.addEventListener('click', function(){ ZS.toast('Board offline'); });
          }
          /* Passthrough Mode. Both switches are nosave:true, so wire()'s flip()
             has already toggled the class by the time these run — `want` is
             the post-flip state, and a refusal toggles it back. Same shape as
             the PS5 master switch and the kill switch. */
          var liveNav = ZS.live.online!==false && ZS.live.status;
          /* The switch became a solid primary key (navBlock). It is NOT a
             nosave toggle any more, so nothing has pre-flipped a class by the
             time this runs: `want` is read from the board's own state and the
             screen repaints from the board's answer, which is one fewer place
             the UI can disagree with the adapter. */
          var ngo = root.querySelector('#g-nav-go');
          var asw = root.querySelector('#g-navarm .sw');
          /* D195: redraw AFTER the new /status has landed. It used to ask
             for one and redraw 120 ms later from the copy it already had,
