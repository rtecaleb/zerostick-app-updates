            var nmNow = (ZS.navLive && ZS.navLive()) ||
                        (ZS.live.status && ZS.live.status.navigateMode) || {};
            var want = !nmNow.active;
            ngo.disabled = true;
            ZS.api('/navigate/active','POST',{active:want}).then(function(j){
              ngo.disabled = false;
              if(j.ok){
                /* the reply IS the Core's state (zs_api.c navigate_ok):
                   believe it, not the request */
                var d = j.data;
                if(d && typeof d.active === 'boolean'){
                  if(ZS.navSet) ZS.navSet(d);
