          function configText(){
            if(jp) return jp.textContent;
            var fullAp = ZS.live.full[ZS.activeId];
            return (liveDev && fullAp)
              ? JSON.stringify(fullAp, null, 2)
              : JSON.stringify({ schema:2, active:ZS.prof(ZS.activeId), savedSettings:Object.keys(ZS.store.vals).length }, null, 2);
          }
          var lc=root.querySelector('#g-lcopy'); if(lc) lc.addEventListener('click', function(){
            copyText((lp&&lp.textContent)||'', 'Logs copied');
          });
          /* One paste with everything a bug report needs. Reads the two <pre>
             elements the accordions already fill, so there is no second
             source of truth and a closed accordion is not an empty report —
             the JSON is written on render and the log fetch lands into the
             node whether or not it is on screen. */
          var gt=root.querySelector('#g-guntrain'); if(gt) gt.addEventListener('click', function(){
            var on = !(ZS.gunTraining && ZS.gunTraining());
            try{ if(on) localStorage.setItem(GUN_TRAINING_KEY, '1'); else localStorage.removeItem(GUN_TRAINING_KEY); }catch(e){}
            ZS.toast(on ? 'Gun training tools shown' : 'Gun training tools hidden');
            render();
          });
          var sm=root.querySelector('#g-simmnk'); if(sm) sm.addEventListener('click', function(){
            var k = (ZS.simMnk && ZS.simMnk.key) || 'zs-sim-mnk';
            try{ localStorage.setItem(k, (ZS.simMnk && ZS.simMnk.on()) ? '0' : '1'); }catch(e){}
            location.reload();
          });
          var dg=root.querySelector('#g-diag'); if(dg) dg.addEventListener('click', function(){
            /* the version is read HERE, not closed over from globalTabHTML —
               that `agentV` is a local of the markup builder and threw
               ReferenceError on every press (caught by emulate-app.js). It is
               also the honest read: the agent may have answered, or stopped
               answering, since the screen was drawn. */
            var stDiag = ZS.live.status;
            var vDiag = (ZS.live.online!==false && stDiag && stDiag.version) || null;
            var txt = 'ZeroStick EXO diagnostics\n'+
              'when: '+new Date().toISOString()+'\n'+
              'board agent: '+(vDiag || 'offline — unknown')+'\n'+
              'app: '+(navigator.userAgent||'')+' ('+(devBuild()?'developer':'release')+' build)\n'+
              (stDiag && stDiag.product === 'core'
                ? 'core firmware: '+(stDiag.devMode === false ? 'release' : 'developer')+' image\n' : '')+
              '\n── active config ──\n'+(configText()||'(none)')+'\n\n'+
              '── agent log ──\n'+((lp&&lp.textContent)||logText||'(none)')+'\n';
            copyText(txt, 'Diagnostics copied — paste them into your report');
          });
          /* Opens in every state, like the calibration button on Overview: the
             screen itself says the board is away and refuses, which is more
             use than a control that does nothing when you press it. */
          var cpb=root.querySelector('#g-calpacks');
          if(cpb) cpb.addEventListener('click', openCalPacks);
          var spb=root.querySelector('#g-savepack');
          if(spb) spb.addEventListener('click', openSavePack);
          /* Twelve frames over ~1.4 s, kept on the BOARD rather than sent to
             the phone: they are for whoever is debugging the detector. The
             row under the key says what happened, including the honest
             cases (picture off, no HDMI input, a Core that keeps none). */
          var snb=root.querySelector('#g-snap');
          if(snb) snb.addEventListener('click', function(){
            var said = root.querySelector('#g-snapsaid');
            snb.disabled = true; snb.textContent = 'Keeping…';
            if(said) said.textContent = 'hold the shot now — keeping 12 frames';
            ZS.api('/vision/snapshot', 'POST', {count:12, width:1280})
              .then(function(j){
                if(said) said.textContent = (j && j.ok)
                  ? (j.message || 'kept them')
                  : ('nothing to keep — ' + ((j && j.error) || 'no picture'));
              })
              .catch(function(){ if(said) said.textContent = 'could not reach the adapter'; })
              .then(function(){ snb.disabled = false; snb.textContent = 'Keep these frames — a 12-frame burst on the board'; });
          });
          /* GET /vision/patch/<n> (a dev Core only, D223): the Core's own
             32x16 grey picture of each watched area, the pixels a taught
             picture is matched against */
          var pab=root.querySelector('#g-patches');
          if(pab) pab.addEventListener('click', function(){
            var out = root.querySelector('#g-patchesout');
            if(!out) return;
            out.textContent = 'reading…';
            var got = [], left = 4;
            function done(){
              if(--left > 0) return;
              out.innerHTML = '';
              got.sort(function(a, b){ return a.area - b.area; });
              if(!got.length){ out.textContent = 'no watched area has been read yet'; return; }
              got.forEach(function(d){
                var cv = document.createElement('canvas'), w = d.w|0, h = d.h|0;
                cv.width = w; cv.height = h;
                cv.style.cssText = 'width:'+(w*4)+'px;height:'+(h*4)+'px;image-rendering:pixelated;'+
                  'border:1px solid var(--line);border-radius:6px';
                cv.setAttribute('aria-label', 'watched area '+d.area);
                try{
                  var bin = atob(d.b64), ctx = cv.getContext('2d'), im = ctx.createImageData(w, h), k;
                  for(k = 0; k < w*h && k < bin.length; k++){
                    var g = bin.charCodeAt(k);
                    im.data[k*4] = im.data[k*4+1] = im.data[k*4+2] = g; im.data[k*4+3] = 255;
                  }
                  ctx.putImageData(im, 0, 0);
                }catch(e){}
                var fig = document.createElement('div');
                fig.style.cssText = 'font-size:12px;color:var(--muted);text-align:center';
                fig.appendChild(cv);
                fig.appendChild(document.createElement('br'));
                fig.appendChild(document.createTextNode('area '+d.area+' · read '+d.seq));
                out.appendChild(fig);
              });
            }
            [0,1,2,3].forEach(function(n){
              ZS.api('/vision/patch/'+n).then(function(j){
                if(j && j.ok && j.data && j.data.b64) got.push(j.data);
              }).catch(function(){}).then(done);
            });
          });
          var rs2=root.querySelector('#g-restart2');
          if(rs2){
            if(liveDev) armConfirm(rs2, function(){
              ZS.api('/service/restart','POST',{}).then(function(j){
                ZS.toast(j.ok?'Board agent restarting…':'Board refused: '+(j.error||''));
              });
            });
            /* m12: offline there is nothing to restart, and saying "(mock)"
               told the player something happened */
            else rs2.addEventListener('click', function(){ ZS.toast('Board offline \u2014 there is nothing to restart'); });
          }
          var fr=root.querySelector('#g-freset');
          if(fr) armConfirm(fr, function(){
            /* m12 (audit 2026-10-10): EVERY key this app keeps, not only the
               config list: the last-seen line, the last gun, the pad family,
               the curve clipboard and the mouse-rate choice outlived the
               "erase". Two are kept on purpose: zs-device (which page this
               is, devices.js: "never rename") and zs-zsp-rev (the save
               counter a Core has already seen; going back to 1 would make a
               new save look older than the stored one). D271 adds a third:
               zs-exo-dev, the developer unlock (devices.js devUnlock) - a
               reset must not shut the owner out of the app he is resetting;
               More > Lock developer access is the way to drop it. D272 adds
               a fourth: zs-legal, the person's agreement to the Terms and
               the Privacy Policy (legal/app/WIRING.md: a reset is not a
               withdrawal). */
            try{
              var keep = { 'zs-device':1, 'zs-zsp-rev':1, 'zs-exo-dev':1, 'zs-legal':1 }, gone = [], k, i;
              for(i = 0; i < localStorage.length; i++){
                k = localStorage.key(i);
                if(k && /^zs[-.]/.test(k) && !keep[k]) gone.push(k);
              }
              gone.forEach(function(x){ localStorage.removeItem(x); });
            }catch(e){}
            /* D272: the config pictures too (IndexedDB, zs-photos.js), as the
               Privacy Policy says. The Calibration Dongle's own keys
               (zsdongle:*) are NOT this app's to erase: the two apps share
               no storage (D264), so the dongle screens keep theirs. */
            var photosGone = (window.ZSPHOTOS && ZSPHOTOS.clearAll) ? ZSPHOTOS.clearAll() : null;
            ZS.toast('Factory reset — reloading…');
            Promise.resolve(photosGone).then(function(){ setTimeout(function(){ location.reload(); }, 900); });
          });
        }
      }
      render();
    }};
  };
});
