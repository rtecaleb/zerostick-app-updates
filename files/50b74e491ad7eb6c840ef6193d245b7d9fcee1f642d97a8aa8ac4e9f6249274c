      /* the device strip */
      '#dbody[data-tint="global"] .gdev{display:flex;align-items:center;gap:11px;',
      'padding:12px 14px;margin:10px 0 4px;border:1px solid var(--line);',
      'border-left:3px solid var(--tint,#b9c6d8);border-radius:var(--r-card);',
      'background:var(--panel)}',
      '#dbody[data-tint="global"] .gdev .gdi{flex:none;display:flex;align-items:center;',
      'justify-content:center;width:34px;height:34px;border-radius:var(--r-chip);',
      'background:var(--tint-wash,rgba(185,198,216,.13));',
      'border:1px solid var(--tint-edge,rgba(185,198,216,.46));color:var(--tint,#b9c6d8)}',
      '#dbody[data-tint="global"] .gdev .gdi svg{width:18px;height:18px}',
      '#dbody[data-tint="global"] .gdev .gdi.gdpic{width:56px;height:56px;padding:0;overflow:hidden;',
      'border-radius:12px;border-color:var(--line);background:none}',
      '#dbody[data-tint="global"] .gdev .gdi.gdpic img{display:block;width:100%;height:100%;object-fit:cover}',
      '#dbody[data-tint="global"] .gdev .gdt{flex:1;min-width:0}',
      '#dbody[data-tint="global"] .gdev .gdn{display:block;font-size:14px;font-weight:700;',
      'color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}',
      '#dbody[data-tint="global"] .gdev .gds{display:block;font-size:12px;color:var(--muted);margin-top:2px}',
      '#dbody[data-tint="global"] .gdev .gdv{flex:none;font-size:11px;font-weight:700;',
      'font-variant-numeric:tabular-nums;color:var(--tint,#b9c6d8);',
      'border:1px solid var(--tint-edge,rgba(185,198,216,.46));border-radius:999px;padding:3px 9px}',
      /* THE ROOM'S EDGE ON EVERY GROUP CARD — except a card of list rows,
         which is the same exclusion zs-fixes.css §16 already reasoned out:
         the rows carry their own state on that exact 3px column, and both
         drawn at once hides every row's state behind one unbroken bar. */
      '#dbody[data-tint="global"] .grp-card:not(:has(> .lrow))',
      '{border-left:3px solid var(--tint,#b9c6d8)}',
      /* .grp-card has NO padding of its own in this app — its children carry
         it — so every block this file puts straight inside one has to. */
      '#dbody[data-tint="global"] .grp-card > .gnavh,',
      '#dbody[data-tint="global"] .grp-card > .gnavd,',
      '#dbody[data-tint="global"] .grp-card > .gpair,',
      '#dbody[data-tint="global"] .grp-card > .btn,',
      '#dbody[data-tint="global"] #g-rate,',
      '#dbody[data-tint="global"] #g-nav{padding-left:15px;padding-right:15px}',
      '#dbody[data-tint="global"] #g-nav{padding-top:14px;padding-bottom:15px}',
      '#dbody[data-tint="global"] .grp-card > .gnavh:first-child{padding-top:14px}',
      '#dbody[data-tint="global"] .grp-card > .gpair:last-child{padding-bottom:15px}',
      '#dbody[data-tint="global"] #g-rate{padding-top:14px;padding-bottom:15px}',
      '#dbody[data-tint="global"] #g-rate > .flab{font-size:15px;font-weight:700;color:var(--text)}',
      /* Passthrough Mode's own card: state in words, action as a solid key */
      '#dbody[data-tint="global"] .gnavh{display:flex;align-items:baseline;gap:8px;',
      'flex-wrap:wrap;margin-bottom:3px}',
      '#dbody[data-tint="global"] .gnavh b{font-size:15px;font-weight:700;color:var(--text)}',
      '#dbody[data-tint="global"] .gnavs{font-size:12.5px;color:var(--muted)}',
      '#dbody[data-tint="global"] .gnavs.live{color:var(--green)}',
      '#dbody[data-tint="global"] .gnavd{font-size:12.5px;color:var(--muted);',
      'line-height:1.5;margin:0 0 12px}',
      /* the output-rate keys */
      '#dbody[data-tint="global"] .gkeys{display:flex;gap:8px;margin-top:10px}',
      '#dbody[data-tint="global"] .gkey{flex:1 1 0;min-width:0;min-height:62px;padding:8px 2px;',
      'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;',
      'border:1px solid var(--btn-2-edge);border-radius:var(--r-ctl);',
      'background-color:var(--btn-2-bg);color:var(--btn-2-ink);font-family:inherit;',
      'font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;cursor:pointer}',
      '#dbody[data-tint="global"] .gkey i{font-style:normal;font-size:9.5px;font-weight:700;',
      'letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}',
      /* SOLID ION FOR "THIS IS THE ONE RUNNING". Not a new meaning: the
         wizard's current step (.wzpip.now, zs-fixes.css) and the tapper row
         (.lrow.tapper.go) already paint --btn-1-bg/--btn-1-ink for exactly
         this. It is also a control you press, so the ladder's "solid ion = do
         the thing" is intact. The word NOW under the number carries the same
         fact without colour. */
      '#dbody[data-tint="global"] .gkey.now{background-color:var(--btn-1-bg,#2fd9ce);',
      'background-image:linear-gradient(180deg,#3ee3d8 0%,#2fd9ce 52%,#26c4ba 100%);',
      'border-color:#3ee3d8;color:var(--btn-1-ink,#04120f);',
      'box-shadow:inset 0 1px 0 rgba(255,255,255,.42),0 3px 0 var(--btn-1-wall,#135e5a)}',
      '#dbody[data-tint="global"] .gkey.now i{color:var(--btn-1-ink,#04120f);opacity:.8}',
      '#dbody[data-tint="global"] .gkey:active{filter:none;box-shadow:inset 0 2px 5px rgba(0,0,0,.3)}',
      'body.a11y-big #dbody[data-tint="global"] .gkey{min-height:60px;font-size:16px}',
      /* the Access one-tap pair */
      '#dbody[data-tint="global"] .gpair{display:flex;gap:8px;margin-top:10px}',
      '#dbody[data-tint="global"] .gpair .btn{margin-top:0}',
      '#dbody[data-tint="global"] .gpair .btn.pri{flex:2 1 0}',
      '#dbody[data-tint="global"] .gpair .btn.sec{flex:1 1 0}',
      /* the contrast modes flatten the ion cap the same way §14 does app-wide */
      '@media (prefers-contrast: more){#dbody[data-tint="global"] .gkey.now{',
      'background-image:none;border:2px solid var(--text)}}',
      'body.a11y-contrast #dbody[data-tint="global"] .gkey.now{',
      'background-image:none;border:2px solid var(--text)}'
    ].join('');
    document.head.appendChild(s);
  }

  /* THE ROOM'S SIGNATURE, ON ALL FOUR TABS. One strip, three facts: which box
     this is, whether it is answering, and what it is running. General used to
     carry two of them in a Device card and Developer repeated the third in a
     Version card; this is those two cards, once, at the top, where "am I
     talking to my adapter" is the question every one of these tabs starts
     with. Never colour alone — the ● / ○ and the words say the same thing. */
  function gdevHTML(){
    var st = ZS.live.status;
    var live = ZS.live.online!==false && st;
    /* the product's name and board from the gate (phone.html PRODUCTS):
       "ZeroStick EXO · Radxa Cubie A7S" as always on an A7S, "ZeroStick
       Core · ESP32-P4" once /status says core */
    var name = ZS.productName ? ZS.productName() : 'ZeroStick EXO';
    var board = ZS.productBoard ? ZS.productBoard() : 'Radxa Cubie A7S';
    return '<div class="gdev">'+
      /* the real EXO render (the Device row's and HOME's), not a chip glyph
         (owner, 2026-10-10: "you still have the placeholder images") */
      '<span class="gdi gdpic" aria-hidden="true"><img src="brand/zs-exo-device.jpg" width="56" height="56" alt=""></span>'+
      '<span class="gdt"><b class="gdn">'+esc(name)+'</b>'+
      /* no board name until the board itself has said which it is (never the
         product gate's A7S default, 2026-10-13) */
      '<span class="gds">'+(live ? esc(board)+' · ' : '')+(live
        ? '<span class="ok">● connected</span>'
        : '<span style="color:var(--amber)">○ board offline</span>')+'</span></span>'+
      (live && st.version ? '<span class="gdv">'+esc(st.version)+'</span>' : '')+
      '</div>';
  }

  function globalTabHTML(tab){
    if(tab==='General'){
      var stG = ZS.live.status;
      var liveG = ZS.live.online!==false && stG;
      /* PASSTHROUGH MODE FIRST (2026-08-14). It is the flagship accessibility
         escape hatch — the way out of a config that remapped you away from
         the console's own menus — and it sat below the theme picker. The
         theme can wait; being unable to leave a menu cannot. Order only:
         every control keeps its label and the global namespace. */
      return gdevHTML()+
        /* Passthrough Mode's card and shortcuts, in its yellow (zs-flat.css §10) */
        '<div class="gnavzone">'+navBlock(stG, liveG)+'</div>'+
        /* D346 / D348: Tournament Mode and the controller's config shortcut */
        zenBlock(stG, liveG)+
        /* THE DEVICE CARD IS GONE FROM HERE and its two facts are in the strip
           at the top of every tab — the board's name and the agent it is
           running. It was the same two rows Developer's Version card carried,
           at the bottom of a 1512px screen. */
        /* A NOTE ABOUT A BUTTON THAT DOES NOT EXIST. "There is no update
           button yet — ZeroStick has no updater to run" is a developer's
           note-to-self shipped to a user: it names a feature, says it is
           missing, and asks them to do nothing about it. Nobody looking at
           this screen was wondering. */
        legalHTML()+
        btn('Restart adapter','caution','g-restart')+
        (devBuild() ? '' : supportHTML());
    }
    if(tab==='Performance'){
      var st = ZS.live.status; var live = ZS.live.online!==false && st;
      var af = ZS.live.full[ZS.activeId];
      var rateNow = (af && af.output && af.output.rateHz) || 250;
      /* Four "Input polling" selectors and a "Low-latency mode" switch were
         removed. Input rate is a property of the USB device itself — the board
         reads through evdev, which delivers events as they ARRIVE, so there is
         no rate for this app to set; and the engine loop has no buffer for a
         low-latency mode to skip. All five wrote to localStorage and were read
         by nothing. Output rate is real and stays. */
      /* THE ONE THING YOU CAN DO ON THIS TAB, AS A THING YOU PRESS.
         Performance is the least colourful screen in the app and it does not
         scroll, so what you see IS the screen: 2.1% chromatic pixels, no
         solid fill anywhere, and the loudest painted element was the back
         header. Its only setting was a native <select> — a 26px grey pill
         that says nothing until you open it, on a phone, in a product for
         people with limited hand control.

         It is now four keys with the live one solid. That is not a new
         meaning for ion: .wzpip.now and .lrow.tapper.go already paint
         --btn-1-bg / --btn-1-ink for "the one you are on", and these are
         controls you press, so "solid ion = do the thing" holds too. The
         word NOW under the number is the second channel.

         HONEST FINDING, RECORDED HERE RATHER THAN INVENTED AROUND:
         Performance has no action of its own beyond this. It is a readout
         plus one setting — and that setting is a property of the CONFIG,
         which is why the same four rates also live on Overview (where
         test-rate-selector.js pins them). This screen mirrors it; Overview
         owns it. #g-rate stays the wrapper id test-game-lock.js looks for. */
      /* THE WRITE CONTROL LEFT THIS TAB (screen-map §7 / FLAG-a #2). The
         rate is config state ({bind: output.rateHz}), so the config editor
         owns the write — Device ▸ Update Rate (D340) — and a second set of write buttons here was
         the two-homes bug this redesign exists to kill. This tab keeps the
         honest READ (what the active config runs at right now) and a door.
         #g-rate stays the wrapper id test-game-lock.js looks for. */
      return gdevHTML()+
        sh('Output')+
        card('<div id="g-rate"><div class="flab">Output rate</div>'+
          '<div class="gnavh" style="margin-top:8px"><b>'+rateNow+' Hz</b>'+
            '<span class="gnavs'+(live?' live':'')+'">'+
            (live?'the active config, live from the board':'from the stored config — board offline')+
            '</span></div>'+
          helpHTML('g-rate', 'Output rate', 'A property of the <b>config</b>, not the device — change it on '+
            '<b>Device ▸ Update Rate</b>. Consoles cap this: <b>PS5 and Xbox read at 250 Hz</b>.')+
          /* D340: the rate is its own card on Device, no longer inside the
             Connection Method panel; the door scrolls to it */
          btn('Change it on Device', null, 'g-rate-go')+'</div>')+
        sh('Live')+
        /* THREE BIG NUMBERS, NOT THREE MORE ROWS. Measured, this was the
           least colourful screen in the app (meanChroma 11.5) and 42.7% of
           it was one flat colour — and it does not scroll, so that WAS the
           whole screen. These three readouts are the only live thing on it
           and they were 13px values on the right-hand edge of three
           identical rows. At 26px tabular they are legible from a metre
           away, they fill the dead half of the pane with the one thing on it
           that changes, and the labels are unchanged so nothing that reads
           this screen reads differently. tabular-nums is not optional on a
           counter that moves every tick — see docs/DESIGN.md. */
        (live
          ? '<div class="grp-card bigstats">'+
              /* THE NUMBERS STAY, THE ENGINEER'S WORDS GO. "ENGINE TICKS",
                 "BACKEND SENDS" and "AGENT UPTIME" name three internals —
                 the engine loop, the output backend and the agent process —
                 none of which this app has ever asked a user to know about.
                 Same three values, said as what they are. */
              '<div class="bigstat"><b>'+Number(st.tickSeq||0).toLocaleString()+'</b><span>Reads of your controls</span></div>'+
              '<div class="bigstat"><b>'+Number((st.outputBackend&&st.outputBackend.stats&&st.outputBackend.stats.sends)||0).toLocaleString()+'</b><span>Updates to the console</span></div>'+
              '<div class="bigstat"><b>'+Math.round((st.uptimeS||0)/60)+'<i> min</i></b><span>Running for</span></div>'+
            '</div>'
          : card('<div class="stat"><span>Board</span><b style="color:var(--amber)">offline — live stats unavailable</b></div>'))+
        /* THE BOARD'S OWN COMPLAINTS BELONG ON THE PERFORMANCE SCREEN. This
           is the tab you open when something feels wrong, and the adapter has
           been saying what is wrong the whole time — warnNotes() is the same
           renderer Overview uses, so the words are identical in both places
           and there is no second source. It also fills the foot with the one
           thing that is genuinely worth putting there: nothing when the board
           is happy, which is a screen honestly saying "all clear". */
        (live ? warnNotes(st) : '');
    }
    if(tab==='Access'){
      /* THE ONE-TAP ACCOMMODATION. This tab measured 2.6% chromatic with no
         solid fill anywhere and it GOT LESS COLOURFUL over the previous pass
         — five identical grey rows on the screen whose entire subject is
         making this app usable. The person who needs all of them needs them
         at once, and asking someone who cannot read the screen to find and
         flip four separate switches to be able to read the screen is the
         defect. This is not a new setting: it writes the same three the rows
         below own, through the same store, and the rows repaint showing it.
           Reduce motion is deliberately NOT in either preset — it answers a
         vestibular need, not a "make it easier to see" one, and folding it
         in would turn one person's accommodation into another's surprise. */
      var v = ZS.store.vals;
      var easedOn = v['global/global|Text size']==='Large' &&
                    v['global/global|High contrast']==='1' &&
                    v['global/global|Bigger touch targets']==='1';
      return gdevHTML()+
        note('ZeroStick is <b>accessibility-first</b> — these apply everywhere, instantly, and they stick.')+
        sh('One tap')+
        card('<div class="gnavh"><b>Easiest to use</b>'+
          '<span class="gnavs'+(easedOn?' live':'')+'">'+
          (easedOn?'on — bigger writing, stronger borders, bigger controls'
                 :'off — this app is at its normal size')+'</span></div>'+
          helpHTML('g-eased', 'Easiest to use', 'Sets bigger writing, high contrast and bigger touch targets '+
          'together. Every one of them is still its own switch below.')+
          /* ONE CONTROL, NOT A STATE SAID THREE TIMES. This was a status line
             ("off — this app is at its normal size"), a paragraph, and then
             TWO buttons of which the second repeated the status word for
             word: "Normal size". Worse, whichever half matched the current
             state was a control that did nothing. The turn-it-off button now
             appears only when there is something to turn off, so the card
             offers exactly one thing to press and it always does something. */
          '<div class="gpair">'+
            (easedOn
              ? '<button class="btn sec" id="g-ease-off">Put it back to normal</button>'
              : '<button class="btn primary pri" id="g-ease">Make everything easier to see</button>')+
          '</div>')+
        sh('Ease of access')+
        card(seg('Text size', ['Default','Large','XL'], 0, false, null,
            'bigger writing on every screen of this app')+
          toggleFld('High contrast', false, 'brighter text and stronger borders')+
          toggleFld('Reduce motion', false, 'no slide or fade animations')+
          toggleFld('Bigger touch targets', false, 'larger switches, steppers and buttons')+
          seg('Hold-repeat speed', ['Fast','Normal','Slow'], 1, false, null,
            'how fast a held − / + button keeps stepping'))+
        /* D272: the Accessibility statement, from Ease of Access too */
        (window.ZSLEGAL ? sh('Accessibility statement')+
          btn('Our accessibility statement', null, 'g-a11y-stmt') : '')+
        helpHTML('g-holdrep', 'Hold-repeat',
          '<b>Hold-repeat</b>: press-and-hold any − / + button to keep stepping — it speeds up '+
          'as you hold. Tap a stepper’s number to type it directly.')+
        /* owner, 2026-10-10: "appearance, units and help should be in Access":
           moved here from General. Every control keeps its label, so what it
           stored (global/global|Theme, |Show real units, |Show help buttons)
           is unchanged */
        sh('Appearance')+
        /* D444 (owner, 2026-10-23): the app is dark only, so there is no
           Theme choice; OLED black is the one appearance switch */
        card(toggleFld('OLED black', false, 'true black — easier on the eyes at night, kinder to an OLED battery'))+
        /* D189: XIM's numbers, for players who think in them. Off by default:
           the default screens never show a unit (D164). On, the Aim page's
           Speed also shows (and takes) cm per 360, Smart Action pushes show
           the turn they make in deg/s, and calibration already speaks deg/s.
           A per-device preference, so it lives in the app's own store
           (global/global|Show real units), not in a config. */
        sh('Units')+
        card(toggleFld('Show real units', false, 'also show cm/360 for Speed and °/s for Script aim steps'))+
        /* D236 (owner, 2026-10-09): explanations live behind a little "?"
           beside their setting; this hides every "?" for a player who knows
           the app. ON by default (global/global|Show help buttons). */
        sh('Help')+
        card(toggleFld('Show help buttons', true, 'the little ? beside a setting that explains it')+
          /* D481: the setup video again, Replay tips, Turn tips off/on
             (onboarding/boot.js; the words are onboarding-text.js) */
          (window.ZSTIPS ? ZSTIPS.settingsHTML() : ''));
    }
    /* Developer */
    var stD = ZS.live.status;
    var agentV = (ZS.live.online!==false && stD && stD.version) ? stD.version : null;
    /* The whole firmware block that stood here — "Installed ZeroStick 0.4.1",
       an Update-channel Stable/Beta/Dev selector, "⤒ Update from .bin file" and
       "⚡ Flash firmware" — was removed. The flasher ran a 2.6-second timer that
       animated a progress bar through "Verifying image… / Writing… /
       Rebooting…", then set the displayed version to whatever number it could
       regex out of the FILENAME. Nothing was ever read, verified or written.
       Shipping a real one needs a signed image, a verification step and an A/B
       slot on the SD card; docs/STATUS.md says so. */
    return gdevHTML()+
      note('For developers and testers. Everything here is device-level — configs are never touched.','warn')+
      /* THE DEBUG BOX (owner, 2026-10-13): a command line for secret and
         debug commands. Developer builds only (this whole tab is). Commands
         live in DEBUG_CMDS; nothing typed here is sent anywhere. */
      sh('Debug')+
      '<div class="dbgbox" style="display:flex;flex-direction:column;gap:10px;align-items:stretch">'+
        '<input id="g-dbg" type="text" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false" '+
          'placeholder="Type a command" aria-label="Debug command" style="width:100%;box-sizing:border-box;min-height:56px;font-size:18px;padding:12px 14px;border-radius:12px">'+
        '<button type="button" class="btn primary" id="g-dbg-run" style="width:100%;min-height:48px;font-size:16px">Run</button></div>'+
      '<p class="gnavd" id="g-dbg-out" role="status" aria-live="polite"></p>'+
      /* D398: gun training, off unless the owner asks for it */
      sh('AI Scripts')+
      btn(((ZS.gunTraining && ZS.gunTraining()) ? '☑' : '☐')+' Show gun training tools', null, 'g-guntrain')+
      helpHTML('g-guntrain', 'Show gun training tools',
           'Shows <b>Teach the Core this gun</b> (and operator, legend or mode), the trained line and the '+
           'picture notes on AI Scripts pages. Off, those pages show only the gun, its rarity and its '+
           'Scripts. Kept on this device; never in a release build.')+
      /* THE ONE OBVIOUS FIRST MOVE ON A DEVELOPER TAB, ABOVE THE FOLD.
         What anyone actually opens this screen to do is take the state
         somewhere else — into a bug report, a message, a paste. Both halves
         already existed and both were grey keys buried inside two closed
         accordions: ⧉ Copy JSON and ⧉ Copy logs. One key takes the version,
         the config and the log together, which is the thing that gets asked
         for every single time. The two individual copies stay where they
         are for anyone who wants just one. */
      btn('⧉ Copy diagnostics — version, config and log', 'primary', 'g-diag')+
      /* the Version card is GONE: the device strip above carries the agent
         version on every tab, and this repeated it a third time. */
      sh('Inspect')+
      acc('Raw config JSON'+(agentV?' (live)':''),'code',
        '<pre id="g-json" style="background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:11px;line-height:1.5;overflow-x:auto;color:var(--muted)"></pre>'+
        btn('⧉ Copy JSON',null,'g-jcopy'), false)+
      acc('Agent log'+(agentV?' (live)':''),'eye',
        '<pre id="g-logs" style="background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:11px;line-height:1.6;overflow-x:auto;color:var(--muted)">'+
        (agentV?'loading…':'[offline] board unreachable — no live log')+'</pre>'+
        btn('⧉ Copy logs',null,'g-lcopy'), false)+
      /* the what-a-pack-is paragraph moved to the velocity screen's "?" —
         the single calibration home (screen-map §7/§8); the button keeps
         the manager for developers. M10 (audit 2026-10-10): packs are the
         A7S agent's (/calibration/packs), so a Core draws no button that
         could only answer 501. */
      ((ZS.productHides && ZS.productHides('calPacks')) ? '' :
        sh('Calibration packs')+
        btn('◎ Calibration packs', null, 'g-calpacks'))+
      /* D115: the way the owner makes a game pack, from a config he tuned */
      sh('Game packs')+
      btn('⤓ Save this config as a game pack', null, 'g-savepack')+
      /* KEEP THESE FRAMES (moved here from Screen Assist's picture card by
         D223: it was always "for whoever is debugging the detector"). An EXO
         keeps a 12-frame burst on the board; a Core keeps none and says so. */
      sh('Screen Assist')+
      btn('Keep these frames — a 12-frame burst on the board', null, 'g-snap')+
      '<div id="g-snapsaid" style="color:var(--muted);font-size:12px;line-height:1.5;margin-top:6px"></div>'+
      coreDevHTML()+
      /* THE LICENCE, ACTUALLY VISIBLE. The controller drawings on Overview are
         the_al's, MIT, and MIT asks that the notice travel with the copy — a
         notice that exists only as an unused API satisfies nobody. ZSART owns
         the text so the art and its credit can never drift apart; this is the
         one call that puts it in front of a human. Accordion-closed because a
         permission notice is reference, not reading matter, and NOT optional
         to remove — see the THIRD-PARTY NOTICE at the top of controller-art.js. */
      (window.ZSART && typeof ZSART.creditsHTML === 'function'
        ? sh('Credits') + acc('Artwork and licences', 'info', ZSART.creditsHTML() + picCreditsHTML(), false)
        : '')+
      /* THE TWO MOST DESTRUCTIVE CONTROLS IN THE PRODUCT, AND MEASURED
         ACROSS 41 FRAMES THERE WAS 0.00% RED BETWEEN THEM. Restart was a
         plain grey key; Factory reset was tagged .btn.danger in the DOM and
         PAINTED #28313f, and the group header's tick was teal — the same
         teal as "Inspect" three rows up. Now the header is red, the reset is
         the solid destructive fill, and Restart takes the CAUTION face
         because it is serious and REVERSIBLE: it drops your link for a few
         seconds and hands it back. Three ranks, three faces. */
      sh('Danger zone', 'danger')+
      btn(agentV?'Restart board agent':'Restart adapter','caution','g-restart2')+
      btn('Factory reset — erase phone-app data','danger','g-freset');
  }

  R.global = function(){
    injectGlobalCSS();
    return { html:'', after: function(root){
      function render(){
        if(gTabs().indexOf(G_TAB) < 0) G_TAB = 'General';
        var h = '<div class="subtabs">'+gTabs().map(function(t){
          return '<button data-g="'+t+'"'+(t===G_TAB?' class="on"':'')+'>'+t+'</button>'; }).join('')+'</div>';
        h += globalTabHTML(G_TAB);
