          function navRefresh(){
            var p = ZS.refreshStatus();
            var redraw = function(){ if(G_TAB==='General') render(); };
            if(p && p.then) p.then(redraw, redraw); else setTimeout(redraw, 120);
          }
          if(ngo && liveNav) ngo.addEventListener('click', function(){
