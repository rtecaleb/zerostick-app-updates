          var apG = ZS.prof(ZS.activeId);
          function navCombos(){
            var s = ZS.live.status && ZS.live.status.navigateMode;
            return ((s && s.combos) || []).map(function(c){ return c.slice(); });
          }
          function navSaveCombos(next, say){
            ZS.api('/navigate/settings','POST',{combos:next}).then(function(j){
              if(j.ok){ ZS.toast(say); navRefresh(); }
              else ZS.toast('Board refused: '+(j.error||''));
            });
          }
          function navWords(c){
            return c.map(function(x){ return navKeyName(x, apG); }).join(' + ');
          }

          root.querySelectorAll('.nav-del').forEach(function(delEl){
            delEl.addEventListener('click', function(){
              if(!liveNav){ ZS.toast('Board offline'); return; }
              var i = +delEl.dataset.i;
              var cur = navCombos();
              if(!cur[i]) return;
