                                : 'Passthrough Mode off — your config is back');
                }
                navRefresh();
              } else ZS.toast('Board refused: '+(j.error||''), {ms:6000});
            });
          });
          else if(ngo) ngo.addEventListener('click', function(){
            ZS.toast('Board offline — Passthrough Mode lives on the board');
          });
          if(asw && liveNav) asw.addEventListener('click', function(){
            var want = asw.classList.contains('on');
            ZS.api('/navigate/settings','POST',{enabled:want}).then(function(j){
              if(j.ok){
                ZS.toast(want ? 'Shortcut buttons on'
