          var navAdd = root.querySelector('#nav-add');
          if(navAdd) navAdd.addEventListener('click', function(){
            if(!liveNav){ ZS.toast('Board offline — shortcuts live on the board'); return; }
            /* kind only decides which grid the sheet offers as a TAP fallback.
               Press-to-bind is armed either way and detects whatever you
               actually press, so a mixed keyboard+pad shortcut still works. */
            ZS.pickList({title:'What do you want to press?', items:[
              {name:'Keyboard or mouse', sub:'any two keys, or a mouse button', value:'source-mnk'},
              {name:'Controller', sub:'any two buttons on your pad', value:'source-pad'}
            ]}).then(function(kind){
              if(!kind) return;
              ZS.pickButton({kind:kind, p:apG, capture:true,
                             title:'Press the FIRST button'}).then(function(a){
                if(!a || !a.source) return;
                ZS.pickButton({kind:kind, p:apG, capture:true,
                               title:'…and now the SECOND button'}).then(function(b){
                  if(!b || !b.source) return;
                  if(b.source === a.source){
                    ZS.toast('Pick two different buttons — one cannot be both halves'); return;
                  }
                  var pair = [a.source, b.source];
                  var cur = navCombos();
                  var key = pair.slice().sort().join('|');
                  var dup = cur.some(function(c){
                    return c.slice().sort().join('|') === key;
                  });
                  if(dup){ ZS.toast(navWords(pair)+' is already a shortcut'); return; }
                  cur.push(pair);
                  navSaveCombos(cur, navWords(pair)+' added');
                });
              });
            });
          });

          /* D346 / D348: both switches are nosave toggles, so wire()'s flip()
             has already moved the class: `want` is the post-flip state, the
             screen repaints from the Core's answer, and a refusal (or no
             board) puts the switch back. */
          function zenRefresh(){
            var p = ZS.refreshStatus();
            var redraw = function(){ if(G_TAB==='General') render(); if(ZS.renderHome) ZS.renderHome(); };
            if(p && p.then) p.then(redraw, redraw); else setTimeout(redraw, 120);
          }
          function zenPost(path, body, sw, said){
            if(!liveNav){
              if(sw) sw.classList.toggle('on');
              ZS.toast('Board offline — this setting lives on the Core');
              setTimeout(function(){ if(G_TAB==='General') render(); }, 0);
              return;
            }
            ZS.api(path, 'POST', body).then(function(j){
              if(j && j.ok){ ZS.toast(said(j.data || {})); zenRefresh(); }
              else {
                if(sw) sw.classList.toggle('on');
                ZS.toast('Board refused: '+((j && j.error) || ''), {ms:6000});
                zenRefresh();
              }
            });
          }
          var tsw = root.querySelector('#g-tourn .sw');
          if(tsw) tsw.addEventListener('click', function(){
            var want = tsw.classList.contains('on');
            zenPost('/settings/tournament', {on:want}, tsw, function(d){
              return d.on ? 'Tournament Mode on — scripts and Smart Actions are off'
                          : 'Tournament Mode off — everything runs again';
            });
          });
          var ksw = root.querySelector('#g-slotkeys .sw');
          if(ksw) ksw.addEventListener('click', function(){
            var want = ksw.classList.contains('on');
            zenPost('/settings/slotkeys', {on:want}, ksw, function(d){
              var i = Math.max(0, ZEN_CHORDS.indexOf(d.chord));
              return d.on ? 'Controller shortcut on — '+ZEN_CHORD_WORDS[i]
                          : 'Controller shortcut off';
            });
          });
          var msw = root.querySelector('#g-menufx .sw');
          if(msw) msw.addEventListener('click', function(){
            var want = msw.classList.contains('on');
            zenPost('/settings/menufeedback', {on:want}, msw, function(d){
              return d.on ? 'Menu light and buzz on' : 'Menu light and buzz off';
            });
          });
          root.querySelectorAll('#g-slotkeys .seg2 button').forEach(function(b, i){
            b.addEventListener('click', function(){
              if(!ZEN_CHORDS[i]) return;
              zenPost('/settings/slotkeys', {chord:ZEN_CHORDS[i]}, null, function(d){
                var k = Math.max(0, ZEN_CHORDS.indexOf(d.chord));
                return 'Shortcut: '+ZEN_CHORD_WORDS[k];
              });
            });
          });

          var navReset = root.querySelector('#nav-reset');
          if(navReset) navReset.addEventListener('click', function(){
            if(!liveNav){ ZS.toast('Board offline'); return; }
            ZS.api('/navigate/settings','POST',{combos:null}).then(function(j){
              if(j.ok){ ZS.toast('Default shortcuts restored'); navRefresh(); }
              else ZS.toast('Board refused: '+(j.error||''));
            });
          });
        }
        if(G_TAB==='Developer'){
          var dbg=root.querySelector('#g-dbg'), dbgRun=root.querySelector('#g-dbg-run'),
              dbgOut=root.querySelector('#g-dbg-out');
          var go=function(){ if(!dbg) return; var said=runDebug(dbg.value);
            if(dbgOut) dbgOut.textContent=said; dbg.value=''; };
          if(dbgRun) dbgRun.addEventListener('click', go);
          if(dbg) dbg.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); go(); } });
        }
        if(G_TAB==='Developer' || (!devBuild() && G_TAB==='General')){
          var jc=root.querySelector('#g-jcopy');
          var jp=root.querySelector('#g-json');
          var liveDev = ZS.live.online!==false && ZS.live.status;
          if(jp){
            var fullAp = ZS.live.full[ZS.activeId];
            jp.textContent = (liveDev && fullAp)
              ? JSON.stringify(fullAp, null, 2)
              : JSON.stringify({ schema:2, active:ZS.prof(ZS.activeId), savedSettings:Object.keys(ZS.store.vals).length }, null, 2);
          }
          if(jc) jc.addEventListener('click', function(){
            copyText(jp.textContent, 'JSON copied');
          });
          var lp=root.querySelector('#g-logs');
          /* the log for Copy diagnostics too, which a release build shows on
             General with no <pre> to read it back from (D223) */
          var logText = null;
          if(liveDev && (lp || root.querySelector('#g-diag'))){
            ZS.api('/logs?limit=60').then(function(j){
              if(!j.ok || !Array.isArray(j.data)){ logText='[error] could not fetch the log'; }
              else logText = j.data.map(function(l){
                return (l.level? '['+l.level+'] ' : '') + (l.msg||l.message||JSON.stringify(l));
              }).join('\n') || '(log is empty)';
              if(lp) lp.textContent = logText;
            });
          }
          /* the active config as the Raw config JSON accordion shows it,
