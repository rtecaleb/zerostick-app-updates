/* zs-live-update.js - live updates for the ZeroStick phone app (D423).
 *
 * The phone app is these web files inside a native shell (Capacitor). New
 * web files reach every phone without an App Store / Play review: the shell
 * carries @capgo/capacitor-updater in MANUAL mode (no Capgo servers, stats
 * off), and this file does the checking against our own static host,
 * GitHub Pages (rtecaleb/zerostick-app-updates), published by
 * tools/publish-update.js. This file belongs to the app SHELL (zerostick-app),
 * not to the EXO or dongle screens: they only load it, natively, as
 * /zs-live-update.js (the bundle root).
 *
 *   <BASE>stable.json / beta.json   {version, minBuild, manifest, force}
 *   <BASE>v/<version>.json          [{file_name, file_hash, download_url}]
 *   <BASE>files/<sha256>            each file, stored once by its content
 *
 * Only files a phone does not already have are fetched (the plugin compares
 * hashes with the shipped app and its cache). A downloaded version is applied
 * the next time the app goes to the background or restarts, never under a
 * finger. notifyAppReady() below is the health check: a version whose pages
 * never get this far is rolled back by the plugin after 10 s, and the version
 * that failed is never fetched again on this phone.
 *
 * The version the running files are is /zs-bundle-version.json, written by
 * the publisher, so a fresh store install is never "updated" backwards.
 * Developer mode (2200) puts the phone on the beta channel.
 * The exe and every browser skip all of it (no native Capacitor).
 * ES5 (DESIGN.md).
 */
(function () {
  var C = window.Capacitor;
  if (!C || !C.isNativePlatform || !C.isNativePlatform()) return;
  var U = C.Plugins && C.Plugins.CapacitorUpdater;
  if (!U) return;
  var BASE = 'https://rtecaleb.github.io/zerostick-app-updates/';
  var BAD_KEY = 'zsapp:update-bad';

  try { U.notifyAppReady(); } catch (e) {}

  function store(k, v) {
    try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) {}
    return null;
  }
  function channel() { return store('zs-dev-mode') === '1' ? 'beta' : 'stable'; }
  function parts(v) {
    return String(v || '0').split(/[.+-]/).map(function (n) { return parseInt(n, 10) || 0; });
  }
  function cmp(a, b) {
    var x = parts(a), y = parts(b), i;
    for (i = 0; i < Math.max(x.length, y.length); i++) {
      if ((x[i] || 0) !== (y[i] || 0)) return (x[i] || 0) < (y[i] || 0) ? -1 : 1;
    }
    return 0;
  }
  function getJSON(url) {
    return fetch(url, { cache: 'no-store' }).then(function (r) {
      if (!r.ok) throw new Error(url + ' ' + r.status);
      return r.json();
    });
  }
  function nativeBuild() {
    var A = C.Plugins.App;
    if (!A || !A.getInfo) return Promise.resolve(0);
    return A.getInfo().then(function (i) { return parseInt(i.build, 10) || 0; }, function () { return 0; });
  }
  function bad() { return (store(BAD_KEY) || '').split(',').filter(function (s) { return !!s; }); }

  function check() {
    var mine, build;
    return Promise.all([
      getJSON('/zs-bundle-version.json').then(function (j) { return j.version; }, function () { return '0'; }),
      nativeBuild(),
      U.getFailedUpdate ? U.getFailedUpdate().catch(function () { return null; }) : null
    ]).then(function (r) {
      mine = r[0]; build = r[1];
      var failed = r[2] && r[2].bundle && r[2].bundle.version;
      if (failed && bad().indexOf(failed) < 0) store(BAD_KEY, bad().concat([failed]).slice(-10).join(','));
      return getJSON(BASE + channel() + '.json');
    }).then(function (ch) {
      if (!ch || !ch.version || !ch.manifest) return null;
      var need = ch.minBuild && typeof ch.minBuild === 'object'
        ? (ch.minBuild[C.getPlatform ? C.getPlatform() : ''] || 0) : (ch.minBuild || 0);
      if (build && build < need) return null;
      if (bad().indexOf(ch.version) >= 0) return null;
      var newer = cmp(ch.version, mine) > 0;
      if (!newer && !(ch.force && cmp(ch.version, mine) !== 0)) return null;
      return getJSON(BASE + ch.manifest).then(function (list) {
        var manifest = list.map(function (f) {
          return { file_name: f.file_name, file_hash: f.file_hash, download_url: BASE + f.download_url };
        });
        return U.download({ url: BASE + ch.manifest, version: ch.version, manifest: manifest });
      }).then(function (b) { return U.next({ id: b.id }); });
    });
  }

  /* after the page has settled, so it never competes with Bluetooth at start */
  setTimeout(function () {
    if (window.__zsLiveUpdateRan) return;
    window.__zsLiveUpdateRan = true;
    check().catch(function (e) { try { console.warn('live update:', e && e.message); } catch (x) {} });
  }, 4000);
})();
