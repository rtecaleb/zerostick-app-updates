    if (W.tr.pic && W.tr.pic.url && typeof fetch === 'function' && typeof FileReader !== 'undefined') {
      fetch(W.tr.pic.url).then(function (r) { return r.blob(); }).then(function (b) {
        var fr = new FileReader();
        fr.onload = function () { done(String(fr.result || '')); };
        fr.onerror = function () { done(''); };
        fr.readAsDataURL(b);
      })['catch'](function () { done(''); });
    } else done('');
  }
  function download(name, blobOrText, type) {
    try {
      var b = typeof blobOrText === 'string' ? new Blob([blobOrText], { type: type || 'application/json' }) : blobOrText;
      var a = document.createElement('a');
      a.href = URL.createObjectURL(b);
      a.download = name;
      document.body.appendChild(a);
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 2000);
    } catch (e) { /* the textarea still has it */ }
  }

  /* ══ the wiring ═════════════════════════════════════════════════════ */

  function startTrain(W) {
    W.method = 'train';
    W.tr = trainDefaults(W);
    W.ads = true;
    W.checked = true;
    W.kept = [];
    W.page = 'tspot';
    W.spot = null;
    W.spotId = '';
    W.spotFov = null;
    if (!W.opened) { W.openSession(); return; }
    arm(W);
  }
  function useSpot(W, s) {
    W.spot = s;
    W.spotId = s ? s.id : '';
    W.spotFov = s && s.fov ? { hip: num(s.fov.hip, 103), ads: num(s.fov.ads, num(s.fov.hip, 70)) } : null;
    /* a spot is made aiming down sights (its Script then runs only while
       aiming); no spot leaves the player's own choice alone */
    if (s) W.ads = s.ads !== false;
    else if (W.adsBefore != null) W.ads = W.adsBefore;
  }
  function readTrainInputs(W, el) {
    ['name', 'where', 'say'].forEach(function (f) {
      var i = el.querySelector('#rs-t' + f);
      if (i) W.tr[f] = String(i.value || '').slice(0, f === 'say' ? 160 : 64);
    });
  }

  function wire(W, el) {
    css();
    function on(id, fn) {
      var b = el.querySelector('#' + id);
      if (b) b.addEventListener('click', function (e) { if (!b.disabled) fn(e, b); });
    }
    el.querySelectorAll('[data-rsi]').forEach(function (b) {
      b.addEventListener('click', function () { useSpot(W, W.spots[+b.getAttribute('data-rsi')]); W.paint(); });
    });
    on('rs-anywall', function () {
      W.fromMode = true;
      W.err = '';
      anyWall(W);
    });
    /* D419: the sensitivity check */
    on('rs-sens', function () { sensStart(W); });
    on('rs-sensstop', function () { sensStop(W); });
    on('rs-train', function () { startTrain(W); });
    on('rs-onspot', function () {
      W.kept = [];
      if (!W.opened) { W.openSession(); return; }
      W.page = 'rate';
      W.paint();
    });
    /* step A */
    on('rs-measure', function () { measureStart(W); });
    on('rs-stop', function () { measureStop(W); });
    /* training */
    on('rs-tback', function () {
      stopPoll(W);
      api('/recoil/auto', 'POST', { op: 'stop' });
      begin(W);
    });
    on('rs-tcap', function () {
      readTrainInputs(W, el);
      var a = W.auto || {};
      if (!a.thumb) return;
      W.tr.ref = a.thumb;
      W.tr.texture = num(a.texture, 0);
      V().shoot(W, function () {
        /* the picture for players: kept apart from the wall's picture */
        W.tr.pic = W.shot;
        W.shot = null;
        stopPoll(W);
        api('/recoil/auto', 'POST', { op: 'stop' });
        W.auto = null;
        W.wall = null;
        W.ed = null;
        W.page = 'watch';
      });
    });
    on('rs-tnext', function () {
      var tr = W.tr, rep = W.wall || {}, v = W.verdict || {};
      if (!tr.wallLo) tr.wallLo = wallLoFrom(rep) || 0;
      tr.hint = v.state === 'ok' ? 'The line was traced cleanly: the wall’s numbers are ready to save.'
        : v.state === 'unsure' ? 'The line was not sure (' + (v.words || '') + '). Fire again, or check the wall floor.'
        : '';
      W.page = 'tsave';
      W.paint();
    });
    on('rs-tagain', function () {
      V().dropShot(W);
      W.ed = null;
      W.wall = null;
      W.verdict = null;
      W.page = 'watch';
      W.paint();
    });
    on('rs-tsave', function () { devSave(W); });
    on('rs-tjson', function () {
      if (W.saved) download(packIdOf(W.p) + '-' + W.saved.id + '.spot.json', JSON.stringify(W.saved, null, 2) + '\n');
    });
    on('rs-tpic', function () {
      var u = W.tr && W.tr.pic && W.tr.pic.url;
      if (!u || !W.saved || typeof fetch !== 'function') return;
      fetch(u).then(function (r) { return r.blob(); }).then(function (b) { download(W.saved.picture, b); });
    });
    on('rs-ttry', function () {
      stopPoll(W);
      W.method = 'spot';
      W.spots = spotsFor(W.p);
      useSpot(W, W.spots.filter(function (s) { return s.local && s.id === W.saved.id; })[0] || W.spots[0]);
      W.kept = [];
      W.page = 'spot';
      W.paint();
    });
    if (W.page === 'tsave') {
      el.addEventListener('zsstep', function (e) {
        var t = e.target, f = t && t.getAttribute ? t.getAttribute('data-f') : '';
        if (!f || f.charAt(0) !== 't' || !W.tr) return;
        W.tr[f.slice(1)] = num(parseFloat(t.textContent), W.tr[f.slice(1)]);
      });
    }
    if (W.page === 'tspot') {
      ['name', 'where', 'say'].forEach(function (f) {
        var i = el.querySelector('#rs-t' + f);
        if (i) i.addEventListener('input', function () { readTrainInputs(W, el); });
      });
    }
  }

  /* recoil-workshop.js: the session is open; training arms the Core for
     the view (true = handled here) */
  function opened(W) {
    if (W.method === 'train') { arm(W); return true; }
    return false;
  }
  /* the mode page's Automatic: a game with spots goes to its spot */
  function begin(W) {
    /* the game's catalog, so the gun the reader sees out can be named */
    if (window.ZSAUTO && typeof ZSAUTO.loadCatalog === 'function') ZSAUTO.loadCatalog(packIdOf(W.p));
    W.spots = spotsFor(W.p);
    if (W.adsBefore == null) W.adsBefore = !!W.ads;
    W.fromMode = true;
    W.err = '';
    if (!W.spots.length) {
      anyWall(W);
      return;
    }
    W.method = 'spot';
    useSpot(W, W.spots[0]);
    W.page = 'spot';
    W.paint();
  }
  /* D419: no trained spot: the same Automatic, at any flat wall, aimed in */
  function anyWall(W) {
    W.method = 'auto';
    useSpot(W, null);
    W.ads = true;
    W.page = 'check';
    W.paint();
  }
  /* a page entered by Back: the training view armed again */
  function enter(W, page) {
    stopPoll(W);
    if (page === 'spot') { W.auto = null; return; }
    if (page === 'tspot' && W.opened) {
      V().dropShot(W);
      W.ed = null;
      arm(W);
    }
  }
  function teardown(W) {
    stopPoll(W);
    stopMeasPoll(W);
    stopSensPoll(W);
    if ((W.auto && running(W.auto)) || (W.meas && running(W.meas)) || (W.sensRun && running(W.sensRun)) ||
        (W.auto && W.auto.state === 'checking')) {
      api('/recoil/auto', 'POST', { op: 'stop' });
    }
  }

  window.ZS_RECOIL_SPOTS = {
    pageSpot: pageSpot, pageTspot: pageTspot, pageTsave: pageTsave,
    measureHTML: measureHTML, measureRunHTML: measureRunHTML, running: running,
    sensHTML: sensHTML, sensRunHTML: sensRunHTML, devHTML: devHTML,
    wire: wire, opened: opened, begin: begin, enter: enter, teardown: teardown,
    spotsFor: spotsFor, devTools: devTools, target: target, css: css,
    /* D425: a game whose pack says its recoil is random (no pattern to trace) */
    randomRecoil: function (p) { var pk = packOf(p); return !!(pk && pk.recoilPattern === 'random'); },
    gameName: gameName,
    /* D426: the Lab's Automatic has been set up for this game */
    autoReady: function (p) { var pk = packOf(p); return !!(pk && pk.recoilAuto === true); },
    /* the tests pin these */
    _gunOut: gunOut, _armBody: armBody, _measureBody: measureBody, _measuredWords: measuredWords, _reloadOf: reloadOf,
    _grownBox: grownBox, _wallLoFrom: wallLoFrom, _DEV_KEY: DEV_KEY
  };
})();
