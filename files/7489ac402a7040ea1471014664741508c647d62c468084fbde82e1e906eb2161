     carries its builds' reserve; a 2K26 arrow config does not */
  function buildsFor(doc) {
    if (!doc || !isObj(doc.autoGreen) || doc.autoGreen.meterStyle === 'arrow') { return null; }
    return { seed: FACTORY_SEED };
  }
  var KINDS = ['early', 'perfect', 'late'];
  var KIND_WORD = { early: 'Early', perfect: 'Perfect', late: 'Late' };
  var STRATEGY_MAP = { Auto: 'auto', Meter: 'meter', Press: 'press' };

  /* the words, in one place (the tests read COPY) */
  var SUB = 'Lets go of shoot in the green';
  var OLD_FW = 'This Core’s firmware doesn’t have Auto green yet.';
  var WHAT_HELP = '<b>Shoot as usual.</b> Hold shoot and your Core lets go for you when the shot meter ' +
    'reaches the green. ' +
    '<b>You stay in charge.</b> It only ever lets go of a button you are holding; it never presses one. ' +
    'Let go yourself and your release wins, at once. ' +
    '<b>It needs the game’s picture.</b> Your Core watches the meter through its capture, so the console ' +
    'has to be connected through it. ' +
    /* D477: the Core learns from 2K's own word, which 2K27 shows only with Shot Feedback on */
    '<b>NBA 2K27: turn on Shot Feedback.</b> In the game’s settings set Shot Feedback to All Shots, with ' +
    'Timing on. Your Core learns your timing from 2K’s own word after each shot (Early, Late, Excellent).';
  var NUDGE_HELP = '<b>Fine-tune: your shots land a little early?</b> Slide toward Later. ' +
    '<b>A little late?</b> Slide toward Sooner. ' +
    'Each step is 2 ms. Your Core learns your timing from every shot by itself, so you rarely need ' +
    'this; leave it at 0 unless your shots keep missing the same way. ' +
    '<b>Your delay</b> is how long your TV and capture take to show a frame. Your Core lets go that ' +
    'much sooner to make up for it, and works it out by itself when this is 0. Set it by hand in ' +
    'steps of 5 ms only to override that, or tap Measure my delay and your Core times it for you.';
  /* D458: the zero-setup words */
  var LEARNING = 'Learning your timing', READY = 'Ready', RELEARN = 'Your setup changed, re-learning';
  var JUST_SHOOT = 'just shoot normally';
  var NUDGE_NOTE = 'Rarely needed: your Core learns your timing by itself. Leave it at 0.';
  var DELAY_NOTE = 'Leave it at 0 and your Core works it out. Set it only to override what it learned.';
  var INTRO_TITLE = 'Auto green is on';
  var INTRO_STEPS = ['Go to the gym, or start a game.', 'Hold shoot (%) as usual.',
