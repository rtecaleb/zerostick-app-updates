  function onScreen() { return !!ROOT && $('ag-room') === ROOT && detailOpen(); }
  function api(path, method, body) {
    if (!ZS.api) { return Promise.resolve({ ok: false, error: 'no answer' }); }
    return ZS.api(path, method, body).then(function (j) { return j || { ok: false, error: 'no answer' }; },
      function (e) { return { ok: false, error: String((e && e.message) || e || 'no answer') }; });
  }
  /* the Core answers {ok:true, data:{...}}; a bare object is taken as-is */
  function dataOf(j) {
    if (!j || j.ok === false) { return null; }
    return (j.data !== undefined && j.data !== null) ? j.data : j;
  }
  function noRoute(j) {
    return /not found|no such|unknown route|not implemented|\b404\b|\b501\b/i.test(String((j && j.error) || ''));
  }
