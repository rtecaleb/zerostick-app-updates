  /* ═══════════════════════════════════ HOME's Auto green card (D475) ══ */
  /* An NBA 2K config has no AI Scripts, so HOME's weapon card slot shows
     this instead (shell/09-home.js paintHomeGun): the logo, ON / OFF, and
     one status line from the same GET /shot the room reads. HOME asks the
     Core only while the card is on screen (HOME showing, an NBA 2K config
     playing, the Core online, the room closed), every HOME_POLL_MS; nothing
     else ever starts this poll (zero cost when unused). */
  var HOME_POLL_MS = 3000;
  var HP = { pid: '', of: '', timer: null, busy: false, status: null, noRoute: false };
  function homeShowing() {
    if (typeof document !== 'undefined' && document.hidden) { return false; }
