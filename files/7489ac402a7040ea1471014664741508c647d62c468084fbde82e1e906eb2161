      paint();
      S.timer = setTimeout(function () { poll(gen); }, 1500);
      return;
    }
    api('/shot').then(function (j) {
      if (gen !== S.gen) { return; }
      var d = dataOf(j);
      if (d) { S.status = d; S.err = ''; S.noRoute = false; HP.status = d; HP.of = S.pid; HP.noRoute = false; buildsFetch(); }
      else { S.noRoute = noRoute(j); S.err = String((j && j.error) || ''); }
      paint();
