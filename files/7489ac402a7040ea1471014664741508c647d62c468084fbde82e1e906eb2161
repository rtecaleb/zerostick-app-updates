  /* the room's hue, sampled from the logo's neon (median #2df63c, lifted a
     touch): zs-fixes.css "D475" holds the same value */
  var HUE = '#36f55a';

  /* ═══════════ D478: THE FACTORY SEED - the owner's numbers, ONE PLACE ═══════════
     Every NEW 2K27 config starts Auto green from these instead of the
     population prior (200 +- 60 ms), so shot 1 already lets go where the
     owner's setup does; each player's Core then adapts within a few shots.
     A config that sets its own delay / nudge, or one already learned, ignores
     them. They ride in the config's builds section (0x0071, gen 0), so a live
     app update changes them without a firmware flash.
     WHERE THEY CAME FROM (2026-10-26): the owner's Core, GET /shot learn
     (D:\zs-scratch\shot-now.txt): delayMs 187, jitterMs 22.5, sigmaMs 5.2,
     biasMs -12, 46 shots - learned while the arrowhead grader called late
     shots short (D477), so D read ~35-65 ms low; the owner then set nudge
     -40 live, i.e. "let go 40 ms sooner". So delayMs = 187 + 40 = 227 (the
     population calibration said 230-240, D457). sigmaMs 30 (not his 5.2:
     a new player's rig is not his, so it must still move fast); bias 0 (his
     -12 came from the bad grader). No per-speed shape was measured yet:
     mapMs all 0.
     TO REFRESH from the owner's Core (after D477 is live and he has played
     ~50 graded shots): python firmware/lite-p4/tools/shot_tool.py status
     (or GET /shot) -> learn.delayMs, learn.jitterMs; GET /shot/builds ->
     builds.slots[active].speeds[].ms for mapMs (9 bins, 1.8 .. 2.6). Put
     them here, run test-auto-green.js, ship the app. */
  var FACTORY_SEED = { delayMs: 227, sigmaMs: 30, jitterMs: 22.5, biasMs: 0,
    mapMs: [0, 0, 0, 0, 0, 0, 0, 0, 0] };
  var BUILD_NEED = 25;
