       on     the switch as the config has it (the Core's own `on` when it says)
       name   the big line; status the small one */
  function homeCard(block, st, off, oldFw) {
    var on = !!(block && block.enabled);
    if (!off && isObj(st) && typeof st.on === 'boolean') { on = st.on; }
    var lr = isObj(st) ? st.learn : null, ls = isObj(lr) && typeof lr.state === 'string' ? lr.state : '';
    var c = countOf(lr), shots = c ? c.n + ' of ' + c.of + ' shots' : '';
    if (off) { return { state: 'offline', on: on, name: 'Unavailable', status: '' }; }
    if (oldFw) { return { state: 'off', on: on, name: 'Needs a firmware update', status: OLD_FW }; }
    if (!on || ls === 'off' || ls === 'passive') {
      return { state: 'off', on: false, name: 'Turned off',
        status: ls === 'passive' && shots ? 'Learning your timing while off: ' + shots : 'Tap to turn it on' };
    }
    if (!isObj(st)) { return { state: 'looking', on: true, name: 'Checking…', status: 'Asking your Core' }; }
    if (st.picture === false) {
      return { state: 'warn', on: true, name: 'No game picture', status: 'Connect your console through your Core' };
    }
    if (ls === 'learning') {
      return { state: 'looking', on: true, name: LEARNING, status: (shots ? shots + ' · ' : '') + JUST_SHOOT };
    }
    if (ls === 'relearning') {
      return { state: 'looking', on: true, name: 'Re-learning your timing',
        status: 'Your setup changed' + (shots ? ' · ' + shots : '') };
    }
    if (ls === 'ready') {
      var w = readyWords(lr).replace(/^Ready(: | - )?/, '');
