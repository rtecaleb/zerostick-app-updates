    if (!near(a.deadzone, b.deadzone) || !near(a.vx, b.vx) || !near(a.vy, b.vy)) { return false; }
    var pa = Array.isArray(a.points) ? a.points : [], pb = Array.isArray(b.points) ? b.points : [];
    if (pa.length !== pb.length) { return false; }
    for (var i = 0; i < pa.length; i++) {
      if (!near(pa[i][0], pb[i][0]) || !near(pa[i][1], pb[i][1])) { return false; }
