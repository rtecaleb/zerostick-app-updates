/* zs-aim-model.js - the game translator model, format "zs-aim-model/1" (D164).
 *
 * XIM's Smart Translator idea, written down as data: what a console GAME does
 * with a stick (its dead zone, its response curve, its turn rate per axis,
 * its turn ramp, its input dampening) and which in-game settings those
 * numbers assume. The Core's mouse translator INVERTS this model, so a mouse
 * moved at some speed turns the camera at that speed (degrees per count), not
 * through a generic linear guess.
 *
 * The format is documented, field by field, in docs/AIM-MODEL.md, and it is
 * VERSIONED: `format` is "zs-aim-model/1". A later calibration tool (the
 * capture-card sweep) writes the same shape with `needsCalibration: false`
 * and its own `sources` line, so nothing here has to change for it.
 * "zs-aim-model/2" (D187) is /1 plus how the game combines the two stick
 * axes, which Calibrate measures: a "mixed" dead zone (`deadzoneAxial`) and
 * `axes` {combine, corner}. resolve() then adds an `axes` object per mode,
 * which the encoder writes as the AIMAXES section (0x0028).
 *
 * Where a model lives: a game pack's `aimModel` (game-packs/<id>.json). What
 * the device receives: resolve() turns one into the encoder's
 * mouseTranslation.resolvedAimModel (zs-profile-encode.js reads it verbatim
 * into the AIMMODEL and AIMTIME sections). No model = generic(): the
 * profile's own game dead zone, a straight response, 300 deg/s both ways.
 *
 * Pure functions, no DOM: tools/test-aim-model.js runs this file in Node.
 */
(function (root) {
  'use strict';

  var FORMAT = 'zs-aim-model/1';
