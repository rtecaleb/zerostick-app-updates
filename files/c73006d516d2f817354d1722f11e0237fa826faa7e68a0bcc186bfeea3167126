      format: model.format,
      translator: model.id,
      name: model.name,
      needsCalibration: model.needsCalibration,
      generic: false,
      use_cm: cm > 0,
      hip: resolvedMode(merged(model, 'hip'), v2, fam),
      ads: resolvedMode(merged(model, 'ads'), v2, fam)
