    ['hip', 'ads'].forEach(function (name) {
      var raw = model[name];
      if (!isObj(raw)) { say(name + ' is missing.'); return; }
      Object.keys(raw).forEach(function (k) {
        if (MODE_KEYS.indexOf(k) < 0) { say(name + ' has a field this app does not know, "' + k + '".'); }
      });
      if (raw.inherit !== undefined && !(name === 'ads' && raw.inherit === 'hip')) {
        say(name + '.inherit may only be "hip", on ads.');
      }
      var m = merged(model, name);
      if (!inRange(m.deadzone, 0, 0.5)) { say(name + '.deadzone must be 0 to 0.5 of the stick.'); }
      if (m.deadzoneShape === 'mixed' && !v2) {
        if (raw.deadzoneShape === 'mixed') {
          say(name + '.deadzoneShape "mixed" needs format "' + FORMAT2 + '".');
        }
      } else if (m.deadzoneShape !== undefined && !SHAPES[m.deadzoneShape] && m.deadzoneShape !== 'mixed') {
        say(name + '.deadzoneShape must be "radial" or "axial"' + (v2 ? ' or "mixed".' : '.'));
      }
      /* D187: the measured axis law, /2 only. Asked of the mode as WRITTEN,
         so an ads that inherits hip is not told twice. */
      if (!v2) {
        ['deadzoneAxial', 'axes'].forEach(function (k) {
          if (raw[k] !== undefined) { say(name + '.' + k + ' needs format "' + FORMAT2 + '".'); }
        });
      } else {
        if (m.deadzoneShape === 'mixed' &&
            !(inRange(m.deadzoneAxial, 0, 0.5) && isNum(m.deadzone) && m.deadzoneAxial < m.deadzone)) {
          say(name + '.deadzoneAxial must be 0 to 0.5 and smaller than deadzone (a "mixed" zone needs it).');
        }
        if (m.axes !== undefined && (!isObj(m.axes) || COMBINES.indexOf(m.axes.combine) < 0 ||
            CORNERS.indexOf(m.axes.corner) < 0)) {
          say(name + '.axes must be {"combine": "radial" | "perAxis", "corner": "clamp" | "square"}.');
        }
      }
      var c = m.curve;
      if (!isObj(c) || ['linear', 'power', 'points'].indexOf(c.type) < 0) {
        say(name + '.curve must be {"type": "linear" | "power" | "points"}.');
      } else if (c.type === 'power' && !inRange(c.exp, 0.1, 5)) {
        say(name + '.curve.exp must be 0.1 to 5.');
      } else if (c.type === 'points') {
        var pts = c.points, ok = Array.isArray(pts) && pts.length >= 1 && pts.length <= 16;
        for (var i = 0; ok && i < pts.length; i++) {
          ok = Array.isArray(pts[i]) && inRange(pts[i][0], 0, 1) && inRange(pts[i][1], 0, 1) &&
            (i === 0 || (pts[i][0] > pts[i - 1][0] && pts[i][1] > pts[i - 1][1]));
        }
        if (!ok) { say(name + '.curve.points must be 1 to 16 [stick, turn] pairs, 0 to 1, both rising.'); }
      }
      var t = m.turnRate;
      if (!isObj(t) || !inRange(t.yaw, 10, 4000) || !inRange(t.pitch, 10, 4000)) {
        say(name + '.turnRate must be {"yaw": deg/s, "pitch": deg/s}, 10 to 4000 each.');
      }
      if (raw.turnRateByConsole !== undefined) {
        var bc = raw.turnRateByConsole;
        if (!isObj(bc) || !Object.keys(bc).length || Object.keys(bc).some(function (f) {
          return CONSOLE_FAMILIES.indexOf(f) < 0 || !isObj(bc[f]) ||
            !inRange(bc[f].yaw, 10, 4000) || !inRange(bc[f].pitch, 10, 4000);
        })) {
          say(name + '.turnRateByConsole must be {"playstation" and/or "xbox": {"yaw", "pitch"}}, 10 to 4000 deg/s each.');
        }
      }
      if (m.ramp !== undefined && m.ramp !== null) {
        var r = m.ramp;
        if (!isObj(r) || !inRange(r.threshold, 0.5, 1) || !inRange(r.delayMs, 0, 1000) ||
            !inRange(r.riseMs, 0, 2000) || !inRange(r.gain, 1, 4)) {
          say(name + '.ramp must be null or {threshold 0.5-1, delayMs 0-1000, riseMs 0-2000, gain 1-4}.');
        }
      }
      if (m.dampingMs !== undefined && !inRange(m.dampingMs, 0, 200)) {
        say(name + '.dampingMs must be 0 to 200.');
