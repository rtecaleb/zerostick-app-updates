      return [{ key: 'default', label: 'Default', setting: null, aimModel: pack.aimModel }];
    }
    return vs;
  }
  /* the variant a config runs (by its numbers), or null */
  function activeVariant(pack, mt, platform) {
    var vs = variantsOf(pack);
    for (var i = 0; i < vs.length; i++) {
      if (isActive(vs[i].aimModel, mt, platform)) { return vs[i]; }
    }
