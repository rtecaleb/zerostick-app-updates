    var m = isObj(model[name]) ? model[name] : {};
    if (name === 'ads' && m.inherit === 'hip' && isObj(model.hip)) {
      var out = {}, k;
      for (k in model.hip) { if (Object.prototype.hasOwnProperty.call(model.hip, k)) { out[k] = model.hip[k]; } }
      for (k in m) { if (k !== 'inherit' && Object.prototype.hasOwnProperty.call(m, k)) { out[k] = m[k]; } }
      /* D394: an ads with its own turnRate never borrows hip's per-console
