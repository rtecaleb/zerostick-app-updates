    return isObj(r) && r.generic !== true && isObj(r.hip) && isObj(r.ads) &&
      isNum(r.hip.vx) && isNum(r.hip.vy) && r.hip.vx > 0 && r.hip.vy > 0 &&
      isNum(r.ads.vx) && isNum(r.ads.vy) && r.ads.vx > 0 && r.ads.vy > 0;
  }
