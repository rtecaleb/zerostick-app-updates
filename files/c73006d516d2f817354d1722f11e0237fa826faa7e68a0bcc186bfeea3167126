    return { id: 'generic', name: 'Any game', needsCalibration: true, turn: GENERIC_TURN };
  }

  /* Is this config running this model (by id and version of the numbers)? */
  /* Is this config running this model? Compared on the NUMBERS that steer
     the translator (dead zone, turn rates, curve points), with a small
     tolerance, not on the whole stored object: a field added to the resolved
     shape later (or a float re-printed) must not make the app offer "Use the
     ... translator" for the one already running (owner's screenshot,
     2026-10-01). */
