  var CORNERS = ['clamp', 'square'];
  /* D394: `turnRateByConsole` {playstation, xbox} per mode (a game whose
     turn speed differs by a few % between the two, as XIM's data lists it)
     and `sights` [{name, adsScale}] at the top (each sight's aiming speed as
     a share of the reference sight's, for the app to show; the Core cannot
     know which sight is up, so it is never sent). Both optional, /1 and /2. */
  var MODE_KEYS = ['inherit', 'deadzone', 'deadzoneShape', 'deadzoneAxial', 'axes', 'curve', 'turnRate',
    'turnRateByConsole', 'ramp', 'dampingMs', 'accel'];
  var TOP_KEYS = ['format', 'id', 'name', 'needsCalibration', 'sources', 'gameSettings',
    'stickHz', 'hip', 'ads', 'sights'];
  var CONSOLE_FAMILIES = ['playstation', 'xbox'];
  /* the config's console (its `platform`) -> the turnRateByConsole key */
  function consoleFamily(platform) {
    var p = String(platform || '').toLowerCase();
    if (p === 'ps5' || p === 'ps4' || p === 'playstation') { return 'playstation'; }
    if (p === 'xbox' || p === 'xbox-series' || p === 'xboxone') { return 'xbox'; }
    return '';
  }

  function isObj(v) { return !!v && typeof v === 'object' && !Array.isArray(v); }
  function isNum(v) { return typeof v === 'number' && isFinite(v); }
  function inRange(v, lo, hi) { return isNum(v) && v >= lo && v <= hi; }

  /* One mode with `inherit: "hip"` resolved against the hip mode. */
