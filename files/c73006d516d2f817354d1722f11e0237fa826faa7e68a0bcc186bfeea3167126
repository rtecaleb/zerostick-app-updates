     `axes` {combine: radial | perAxis, corner: clamp | square}, which
     Calibrate measures from diagonal bursts. Packs keep writing /1. */
  var FORMAT2 = 'zs-aim-model/2';
  var FORMATS = [FORMAT, FORMAT2];
  var GENERIC_TURN = 300;       /* game_model.GENERIC_MAX_TURN_SPEED */
