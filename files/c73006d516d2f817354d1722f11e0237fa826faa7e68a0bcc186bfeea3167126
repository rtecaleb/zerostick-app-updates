  /* Every problem with a model, one plain sentence each; [] = usable. */
  function validate(model, where) {
    var out = [];
    var at = where || 'aimModel';
    function say(t) { out.push(at + ': ' + t); }
    if (!isObj(model)) { say('is not an object.'); return out; }
    Object.keys(model).forEach(function (k) {
      if (TOP_KEYS.indexOf(k) < 0) { say('has a field this app does not know, "' + k + '" (docs/AIM-MODEL.md).'); }
    });
    if (FORMATS.indexOf(model.format) < 0) { say('format must be "' + FORMAT + '" or "' + FORMAT2 + '".'); }
    var v2 = model.format === FORMAT2;
    if (typeof model.id !== 'string' || !model.id) { say('id must be a name like "cod-bo2".'); }
    if (typeof model.name !== 'string' || !model.name) { say('name must say which game and version it describes.'); }
    if (typeof model.needsCalibration !== 'boolean') { say('needsCalibration must be true or false.'); }
    if (!Array.isArray(model.sources) || !model.sources.length ||
        model.sources.some(function (s) { return !isObj(s) || typeof s.what !== 'string' || !s.what; })) {
      say('sources must list where each number came from ({"what": ..., "url": ...}).');
    }
    if (model.gameSettings !== undefined && (!Array.isArray(model.gameSettings) ||
        model.gameSettings.some(function (g) {
          return !isObj(g) || typeof g.setting !== 'string' || typeof g.value !== 'string';
        }))) {
      say('gameSettings must be a list of {"setting": ..., "value": ...}.');
